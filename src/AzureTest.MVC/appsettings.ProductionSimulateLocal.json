{
  "Dashboard": {
    "ReservedSlugs": [
      "Home",
      "Auth",
      "Account",
      "Resume",
      "Expense",
      "Debt",
      "Task",
      "Calendar",
      "Habit",
      "Ticket",
      "Dashboard",
      "Health",
      "Hangfire",
      "User",
      "Role",
      "Company",
      "ResumeFile",
      "Component",
      "UserPreference",
      "RawComponent",
      "SampleData",
      "DebtPerson",
      "ExpenseCategory",
      "Event","SampleNote", "JobCrawler","IdeaTracker","Permission","HouseCrawler","FileExplorer"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
      "HealthChecks.UI": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SimulateSetting": {
    "DropDatabasesOnShutdown": false,
    "DropNoSqlOnShutdown": true,
    "DropRedisCacheOnShutdown": true,
    "AddSeedUser": true,
    "AddSeedCompany": true,
    "AddSeedDebtPerson": true,
    "AddSeedExpenseCategory": true,
    "AddSeedUserPreference": true,
    "AddSeedResume": true,
    "AddSeedResumeStatusLog": true,
    "AddSeedExpense": true,
    "AddSeedDebt": true,
    "AddSeedTaskItem": true,
    "AddSeedEvent": true,
    "AddSeedHabitTracker": true,
    "AddSeedHabitLog": true,
    "AddSeedTicket": true,
    "AddSeedTicketMessage": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ResumeTrackerDb.psl;Username=postgres;Password=postgres",
    "MongoDb": "mongodb://localhost:27017/AzureTestDb-psl",
    "Redis": "localhost:6379"
  },
  "MongoDb": {
    "DatabaseName": "AzureTestDb-psl"
  },
  "SeqUrl": "http://localhost:3100",
  "Jwt": {
    "Issuer": "AzureTest",
    "Audience": "AzureTest",
    "Key": "SuperSecretKeyForJwtAuthenticationInProductionSimulateLocal!!123456",
    "ExpirySeconds": 3600,
    "ExpirationSeconds": 3600,
    "RefreshTokenExpirationMinutes": 1440
  },
  "IdentitySettings": {
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 6,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "AllowedForNewUsers": true,
      "DefaultLockoutTimeSpanMinutes": 5,
      "MaxFailedAccessAttempts": 5
    },
    "User": {
      "AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@+",
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedEmail": false,
      "RequireConfirmedPhoneNumber": false
    }
  },
  "DatabaseSettings": {
    "MongoDb": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "AzureTestDbLocalSim"
    }
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "AzureTest API Health",
        "Uri": "/health"
      }
    ],
    "EvaluationTimeInSeconds": 3600,
    "MinimumSecondsBetweenFailureNotifications": 3600
  },
  "FeatureManagement": {
    "EnableUserAccessToDashboardSlugs": false,
    "EnableSerilog": true,
    "EnableHealthCheck": false,
    "EnableHealthCheckUI": true,
    "EnableHealthChecksSql": true,
    "EnableHealthChecksCosmos": false,
    "EnableHealthChecksBlob": false,
    "EnableHealthCheckMonitor": false,
    "EnableHangfire": false,
    "EnableRabbitMQ": false,
    "EnableQuartz": false,
    "EnableOpenTelemetry": true,
    "EnableAspNetCoreInstrumentation": true,
    "EnableRuntimeInstrumentation": false,
    "EnableProcessInstrumentation": false,
    "EnableBlobStorage": false,
    "EnableAzureMonitorOpenTelemetry": false,
    "UseJWT": false,
    "UseSeq": false
  }
}