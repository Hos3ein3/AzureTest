
@model IEnumerable<AzureTest.Domain.Documents.Gym.TrainingCourse>
@{
    ViewData["Title"] = "Gym Courses";
    string search = ViewBag.Search as string ?? "";
    string sort = ViewBag.Sort as string ?? "Name";
    string dir = ViewBag.Dir as string ?? "asc";
    int pageNo = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string GetSortLink(string sortBy, string label)
    {
        var isCurrentSort = (sort == sortBy);
        var nextDir = isCurrentSort && dir == "asc" ? "desc" : "asc";
        var icon = isCurrentSort ? (dir == "desc" ? "fa-sort-down text-brand-600" : "fa-sort-up text-brand-600") : "fa-sort text-slate-300";
        var url = $"?search={search}&sort={sortBy}&dir={nextDir}";
        
        return $@"<a href=""{url}"" class=""group inline-flex items-center hover:text-slate-700 transition-colors"">{label} <i class=""fa-solid {icon} ml-1""></i></a>";
    }

    string GetPageUrl(int p)
    {
        return $"?search={search}&sort={sort}&dir={dir}&page={p}";
    }
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800 ">Gym Courses</h1>
    
    <div class="flex items-center space-x-4">
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Course
        </a>
    </div>
</div>

<div class="mb-6 bg-white  p-5 rounded-xl shadow-sm border border-slate-100 ">
    <form method="get" class="flex flex-col md:flex-row gap-4 items-end">
        <input type="hidden" name="sort" value="@sort" />
        <input type="hidden" name="dir" value="@dir" />
        
        <div class="flex-1 w-full">
            <label class="block text-sm font-medium text-slate-700  mb-1">Search Courses</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                </div>
                <input name="search" type="text" value="@search" placeholder="Search by course name..." class="block w-full pl-10 pr-3 py-2 border border-slate-300  rounded-lg leading-5 bg-white dark:bg-slate-700  placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" />
            </div>
        </div>
        
        <div class="flex gap-2 w-full md:w-auto">
            <button type="submit" class="inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-slate-800 hover:bg-slate-900 shadow-sm transition-colors w-full md:w-auto">
                Filter
            </button>
            @if(!string.IsNullOrEmpty(search)) {
                <a asp-action="Index" class="inline-flex justify-center items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors w-full md:w-auto">
                    Clear
                </a>
            }
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="bg-white  rounded-xl shadow-sm border border-slate-100  p-12 text-center">
        <div class="w-16 h-16 bg-slate-100 dark:bg-slate-700 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-list text-2xl text-slate-400"></i>
        </div>
        <h3 class="text-lg font-medium text-slate-900  mb-1">No courses found</h3>
        <p class="text-slate-500 mb-6">Get started by creating your first course or adjust your filters.</p>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Course
        </a>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                <div class="p-6 flex-1">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-lg font-bold text-slate-900 line-clamp-1" title="@item.Name">@item.Name</h3>
                        <span class="bg-slate-50 text-slate-600 border border-slate-200 text-xs font-bold px-2.5 py-1 rounded-full whitespace-nowrap">
                            @(item.Weeks?.Count ?? 0) Weeks
                        </span>
                    </div>
                    
                    <p class="text-sm text-slate-600 mb-4 line-clamp-2" title="@item.Description">
                        @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                    </p>
                    
                    <div class="flex flex-wrap gap-1.5 mt-auto">
                        @if(item.Tags != null && item.Tags.Any()) {
                            foreach(var tag in item.Tags.Take(4)) {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">@tag</span>
                            }
                            if(item.Tags.Count > 4) {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200">+@(item.Tags.Count - 4)</span>
                            }
                        }
                    </div>
                </div>
                <div class="bg-slate-50 px-6 py-3 border-t border-slate-100 flex justify-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
                        <i class="fa-solid fa-pen-to-square mr-1.5 text-brand-600"></i> Edit Course
                    </a>
                </div>
            </div>
        }
    </div>
    
    <div>

        @if (totalPages > 1)
        {
            <div class="bg-white  px-4 py-3 border-t border-slate-200  sm:px-6 flex items-center justify-between">
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-slate-700 ">
                            Page <span class="font-medium">@pageNo</span> of <span class="font-medium">@totalPages</span>
                        </p>
                    </div>
                    <div>
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            @{
                                var prevDisabled = pageNo <= 1 ? "pointer-events-none text-slate-300 dark:text-slate-600" : "text-slate-500 hover:bg-slate-50 ";
                                var nextDisabled = pageNo >= totalPages ? "pointer-events-none text-slate-300 dark:text-slate-600" : "text-slate-500 hover:bg-slate-50 ";
                            }
                            <a href="@GetPageUrl(pageNo - 1)" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300  bg-white  text-sm font-medium @prevDisabled transition-colors">
                                <span class="sr-only">Previous</span>
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                            
                            @{
                                int window = 2;
                                int startPage = Math.Max(1, pageNo - window);
                                int endPage = Math.Min(totalPages, pageNo + window);
                                
                                for (int i = startPage; i <= endPage; i++)
                                {
                                    if (i == pageNo)
                                    {
                                        <span class="relative inline-flex items-center px-4 py-2 border border-brand-500 bg-brand-50 text-sm font-medium text-brand-600 z-10">
                                            @i
                                        </span>
                                    }
                                    else
                                    {
                                        <a href="@GetPageUrl(i)" class="relative inline-flex items-center px-4 py-2 border border-slate-300  bg-white  text-sm font-medium text-slate-700  hover:bg-slate-50  transition-colors">
                                            @i
                                        </a>
                                    }
                                }
                            }

                            <a href="@GetPageUrl(pageNo + 1)" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300  bg-white  text-sm font-medium @nextDisabled transition-colors">
                                <span class="sr-only">Next</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
        }
    </div>
}
