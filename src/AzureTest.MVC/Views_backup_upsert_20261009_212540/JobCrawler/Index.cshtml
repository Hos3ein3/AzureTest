@{
    ViewData["Title"] = "Job Crawler";
}

<div class="flex flex-col lg:flex-row h-[calc(100vh-5rem)] overflow-hidden relative">

    <!-- LEFT PANEL: Search and Results -->
    <div class="w-full lg:w-2/5 xl:w-1/3 flex flex-col border-r border-slate-200 bg-slate-50 overflow-hidden relative z-10">
        
        <!-- Header & Form -->
        <div class="p-4 bg-white border-b border-slate-200 shadow-sm z-10">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-spider text-brand-600 text-lg"></i>
                    <h1 class="text-xl font-bold text-slate-800">Crawler</h1>
                </div>
                <button type="button" onclick="openHistoryModal()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded border border-slate-200 font-medium transition">
                    <i class="fa-solid fa-clock-rotate-left mr-1"></i> History
                </button>
            </div>
            
            <form id="crawlerForm" class="space-y-3">
                <div>
                    <input type="text" id="position" name="Position" class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-500" placeholder="Position / Title..." required />
                </div>
                <div>
                    <input type="text" id="location" name="Location" class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-500" placeholder="Location..." />
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <select id="datePosted" name="DatePosted" class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-500">
                        <option value="any">Any Time</option>
                        <option value="today">Today</option>
                        <option value="yesterday">From Yesterday</option>
                        <option value="week">Past Week</option>
                        <option value="month">Past Month</option>
                    </select>
                    <select id="source" name="Source" class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-brand-500">
                        <option value="All">All Sources</option>
                        <option value="LinkedIn">LinkedIn</option>
                        <option value="Indeed">Indeed</option>
                        <option value="Glassdoor">Glassdoor</option>
                        <option value="Remotive">Remotive API</option>
                    </select>
                </div>
                <button type="submit" id="crawlBtn" class="w-full py-1.5 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-magnifying-glass"></i> Deep Search
                </button>
            </form>
        </div>

        <!-- Results List -->
        <div class="flex-1 overflow-y-auto p-4 relative" id="resultsScroll">
            <div id="loadingIndicator" class="hidden absolute inset-0 bg-white/80 flex flex-col items-center justify-center z-20">
                <i class="fa-solid fa-circle-notch fa-spin text-3xl text-brand-500 mb-2"></i>
                <span class="text-sm font-medium text-slate-600">Crawling job boards & APIs...</span>
            </div>
            <div id="resultInfo" class="text-xs font-semibold text-slate-500 uppercase tracking-wider hidden mb-2 flex justify-between items-center">
                <span>Results <span id="resultCount"></span></span>
            </div>
            <!-- We will append cards here -->
            <div id="jobCards" class="space-y-3">
                <div class="text-sm text-slate-400 text-center mt-10">Run a search to see jobs.</div>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL: Embedded Browser (Tabs + iFrames) -->
    <div class="flex-1 flex flex-col bg-slate-200 overflow-hidden relative z-0">
        
        <!-- Tab Bar -->
        <div class="bg-slate-300 h-10 flex items-end px-2 gap-1 overflow-x-auto whitespace-nowrap scrollbar-hide pt-2 shadow-inner" id="tabBar">
            <div id="emptyStateTab" class="px-4 py-1.5 bg-slate-100 text-slate-400 rounded-t-lg text-sm font-medium shadow-sm border border-b-0 border-slate-200 flex items-center gap-2">
                <i class="fa-brands fa-chrome"></i> Internal Browser
            </div>
        </div>

        <!-- iFrame Container -->
        <div class="flex-1 bg-white relative" id="iframeContainer">
            <div id="emptyStateFrame" class="absolute inset-0 flex flex-col items-center justify-center text-slate-400">
                <i class="fa-brands fa-chrome text-6xl mb-4 opacity-20"></i>
                <p class="font-medium text-lg">No Tabs Open</p>
                <p class="text-sm mt-1">Click "Open in Tab" on any job to view it here.</p>
                <p class="text-xs mt-4 text-amber-600 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200">
                    <i class="fa-solid fa-circle-info"></i> Note: Some sites block embedded iframes. Use the external link button if needed.
                </p>
            </div>
        </div>
    </div>

    <!-- History Modal -->
    <div id="historyModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col max-h-[80vh]">
            <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                <h3 class="font-bold text-slate-800"><i class="fa-solid fa-clock-rotate-left text-brand-600 mr-2"></i> Search History</h3>
                <button onclick="closeHistoryModal()" class="text-slate-400 hover:text-slate-700 transition"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="p-4 overflow-y-auto flex-1 bg-slate-50 space-y-2" id="historyList">
                <div class="text-center text-sm text-slate-400 py-4">Loading history...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const state = { tabs: [], activeTabId: null, tabCounter: 0 };
        const form = document.getElementById('crawlerForm');
        const btn = document.getElementById('crawlBtn');
        const loading = document.getElementById('loadingIndicator');
        const jobCards = document.getElementById('jobCards');
        const resultInfo = document.getElementById('resultInfo');
        const resultCount = document.getElementById('resultCount');
        const tabBar = document.getElementById('tabBar');
        const iframeContainer = document.getElementById('iframeContainer');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Searching...';
            loading.classList.remove('hidden');
            jobCards.innerHTML = '';
            
            const requestData = {
                Position: document.getElementById('position').value,
                Location: document.getElementById('location').value,
                DatePosted: document.getElementById('datePosted').value,
                Source: document.getElementById('source').value
            };

            try {
                const response = await fetch('/JobCrawler/Crawl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestData)
                });
                const json = await response.json();
                loading.classList.add('hidden');
                
                if (json.success && json.data) {
                    resultInfo.classList.remove('hidden');
                    resultCount.textContent = `(${json.data.length})`;
                    
                    // Render jobs one by one (staggered animation)
                    let i = 0;
                    function renderNextCard() {
                        if (i >= json.data.length) return;
                        
                        const job = json.data[i];
                        const card = document.createElement('div');
                        card.className = 'bg-white p-3 rounded-lg border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 transform scale-95 opacity-0 group';
                        
                        let color = 'slate'; let icon = 'fa-briefcase';
                        if (job.source.includes('LinkedIn')) { color = 'blue'; icon = 'fa-linkedin'; }
                        else if (job.source.includes('Indeed')) { color = 'indigo'; icon = 'fa-info'; }
                        else if (job.source.includes('Remotive')) { color = 'emerald'; icon = 'fa-rss'; }

                        card.innerHTML = `
                            <div class="flex justify-between items-start mb-1.5 pr-20">
                                <h4 class="font-bold text-slate-800 text-sm leading-tight">${job.title}</h4>
                            </div>
                            <span class="absolute top-3 right-3 text-[10px] font-bold text-${color}-700 bg-${color}-50 border border-${color}-200 px-1.5 py-0.5 rounded flex items-center gap-1">
                                <i class="fa-brands ${icon}"></i> ${job.source}
                            </span>
                            <div class="text-xs text-slate-500 mb-2 space-y-0.5">
                                <div class="font-medium text-slate-700">${job.company}</div>
                                <div><i class="fa-solid fa-location-dot w-3 opacity-50"></i> ${job.location}</div>
                            </div>
                            <div class="flex gap-2 mt-2">
                                <button type="button" class="flex-1 open-tab-btn py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded transition" data-url="${job.url}" data-title="${job.company}">
                                    <i class="fa-solid fa-plus mr-1"></i> Open in Tab
                                </button>
                                <a href="${job.url}" target="_blank" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded transition flex items-center justify-center" title="Open in External Browser">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </div>
                        `;
                        jobCards.appendChild(card);
                        
                        // Trigger reflow & animate in
                        requestAnimationFrame(() => {
                            card.classList.remove('scale-95', 'opacity-0');
                            card.classList.add('scale-100', 'opacity-100');
                        });

                        card.querySelector('.open-tab-btn').addEventListener('click', function() {
                            openTab(this.getAttribute('data-url'), this.getAttribute('data-title'));
                        });

                        i++;
                        setTimeout(renderNextCard, 50); // Staggered rendering delay
                    }
                    renderNextCard();
                }
            } catch (err) {
                loading.classList.add('hidden');
                jobCards.innerHTML = '<div class="text-red-500 text-sm p-4 text-center">Failed to fetch results.</div>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> Deep Search';
            }
        });

        // Tab System Logic
        function openTab(url, title) {
            document.getElementById('emptyStateTab').style.display = 'none';
            document.getElementById('emptyStateFrame').style.display = 'none';
            state.tabCounter++;
            const tabId = 'tab_' + state.tabCounter;
            const shortTitle = title.length > 15 ? title.substring(0, 15) + '...' : title;
            const tabEl = document.createElement('div');
            tabEl.id = `nav_${tabId}`;
            tabEl.className = 'px-3 py-1.5 min-w-[120px] max-w-[200px] flex items-center justify-between rounded-t-lg text-xs font-medium cursor-pointer border border-b-0 border-slate-300 transition-colors select-none';
            tabEl.innerHTML = `
                <div class="truncate flex items-center gap-1.5" title="${title}">
                    <i class="fa-solid fa-globe text-slate-400"></i>
                    <span>${shortTitle}</span>
                </div>
                <div class="close-tab-btn ml-2 p-0.5 rounded hover:bg-slate-300 hover:text-red-600 transition text-slate-500">
                    <i class="fa-solid fa-xmark"></i>
                </div>
            `;
            tabEl.addEventListener('click', (e) => { if(!e.target.closest('.close-tab-btn')) activateTab(tabId); });
            tabEl.querySelector('.close-tab-btn').addEventListener('click', (e) => { e.stopPropagation(); closeTab(tabId); });
            tabBar.appendChild(tabEl);

            const iframeEl = document.createElement('iframe');
            iframeEl.id = `frame_${tabId}`;
            iframeEl.src = url;
            iframeEl.className = 'w-full h-full border-0 absolute inset-0 bg-white';
            iframeContainer.appendChild(iframeEl);

            state.tabs.push(tabId);
            activateTab(tabId);
        }

        function activateTab(tabId) {
            state.activeTabId = tabId;
            state.tabs.forEach(id => {
                const nav = document.getElementById(`nav_${id}`);
                const frame = document.getElementById(`frame_${id}`);
                if(id === tabId) {
                    nav.classList.replace('bg-slate-200', 'bg-white');
                    nav.classList.add('bg-white', 'text-brand-700');
                    nav.classList.remove('text-slate-600', 'hover:bg-slate-100');
                    frame.style.display = 'block';
                    frame.style.zIndex = '10';
                } else {
                    nav.classList.replace('bg-white', 'bg-slate-200');
                    nav.classList.add('bg-slate-200', 'text-slate-600', 'hover:bg-slate-100');
                    nav.classList.remove('text-brand-700');
                    frame.style.display = 'none';
                    frame.style.zIndex = '0';
                }
            });
        }

        function closeTab(tabId) {
            document.getElementById(`nav_${tabId}`).remove();
            document.getElementById(`frame_${tabId}`).remove();
            const index = state.tabs.indexOf(tabId);
            if (index > -1) state.tabs.splice(index, 1);
            if (state.tabs.length > 0) {
                if (state.activeTabId === tabId) activateTab(state.tabs[Math.max(0, index - 1)]);
            } else {
                state.activeTabId = null;
                document.getElementById('emptyStateTab').style.display = 'flex';
                document.getElementById('emptyStateFrame').style.display = 'flex';
            }
        }

        // History Modal Logic
        async function openHistoryModal() {
            document.getElementById('historyModal').classList.remove('hidden');
            const list = document.getElementById('historyList');
            list.innerHTML = '<div class="text-center text-sm text-slate-400 py-4"><i class="fa-solid fa-circle-notch fa-spin"></i> Loading...</div>';
            
            try {
                const res = await fetch('/JobCrawler/GetHistory');
                const json = await res.json();
                if(json.success && json.data.length > 0) {
                    list.innerHTML = '';
                    json.data.forEach(h => {
                        const date = new Date(h.searchDate).toLocaleString();
                        const el = document.createElement('div');
                        el.className = 'bg-white p-3 rounded border border-slate-200 hover:border-brand-300 hover:shadow-sm cursor-pointer transition';
                        el.innerHTML = `
                            <div class="flex justify-between items-start">
                                <div class="font-medium text-brand-700 text-sm">${h.position} <span class="text-slate-500 font-normal">in ${h.location || 'Remote'}</span></div>
                                <span class="text-xs text-slate-400">${date}</span>
                            </div>
                            <div class="text-xs text-slate-500 mt-1">Source: ${h.source} | Date: ${h.datePosted || 'Any'}</div>
                        `;
                        el.addEventListener('click', () => {
                            document.getElementById('position').value = h.position;
                            document.getElementById('location').value = h.location;
                            document.getElementById('source').value = h.source;
                            document.getElementById('datePosted').value = h.datePosted;
                            closeHistoryModal();
                            btn.click(); // auto-search
                        });
                        list.appendChild(el);
                    });
                } else {
                    list.innerHTML = '<div class="text-center text-sm text-slate-400 py-4">No history found.</div>';
                }
            } catch {
                list.innerHTML = '<div class="text-center text-sm text-red-400 py-4">Failed to load history.</div>';
            }
        }
        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }
    </script>
}
