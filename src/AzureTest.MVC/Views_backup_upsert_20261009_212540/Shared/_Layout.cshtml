                            Cancel
                        </button>
                        <button type="submit" id="savePrefModalBtn" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 transition-colors disabled:opacity-50">
                            <span id="savePrefBtnSpinner" class="hidden mr-2"><i class="fa-solid fa-spinner fa-spin"></i></span>
                            <span id="savePrefBtnText">Save Preferences</span>
