                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Global Page Loader and Setting Modal Scripts -->
    <script>
        // Global Page Loader handling
        (function () {
            const loader = document.getElementById('globalPageLoader');
            if (!loader) return;

            function showLoader() {
                loader.style.display = 'flex';
                requestAnimationFrame(() => {
                    loader.classList.remove('opacity-0', 'pointer-events-none');
                    loader.classList.add('opacity-100');
                    loader.removeAttribute('aria-hidden');
                });
            }

            function hideLoader() {
                loader.classList.remove('opacity-100');
                loader.classList.add('opacity-0', 'pointer-events-none');
                loader.setAttribute('aria-hidden', 'true');
                setTimeout(() => {
                    if (loader.classList.contains('opacity-0')) {
                        loader.style.display = 'none';
                    }
                }, 250);
            }

            window.addEventListener('beforeunload', function () {
                showLoader();
            });

            window.addEventListener('pageshow', function () {
                hideLoader();
            });

            document.getElementById('cancelPageLoadBtn')?.addEventListener('click', function(e) {
                e.preventDefault();
                window.stop(); // Stops the HTTP request, triggering the CancellationToken on the server
                hideLoader();
            });
        })();

        // Setting Gear & User Preference Modal Logic
        (function () {
            const gearBtn = document.getElementById('settingGear');
            const modal = document.getElementById('userPreferenceModal');
            const backdrop = document.getElementById('prefModalBackdrop');
            const dialog = document.getElementById('prefModalDialog');
            const closeBtn = document.getElementById('closePrefModalBtn');
            const cancelBtn = document.getElementById('cancelPrefModalBtn');
            const form = document.getElementById('userPreferenceForm');
            const loadingIndicator = document.getElementById('prefModalLoading');
            const fieldsContainer = document.getElementById('prefModalFields');
            const alertBox = document.getElementById('prefModalAlert');
            const languageSelect = document.getElementById('prefLanguage');
            const themeColorSelect = document.getElementById('prefThemeColor');
            const saveBtn = document.getElementById('savePrefModalBtn');
            const saveSpinner = document.getElementById('savePrefBtnSpinner');
            const saveText = document.getElementById('savePrefBtnText');

            if (!gearBtn || !modal) return;

            function showAlert(msg, isSuccess) {
                alertBox.textContent = msg;
                alertBox.className = isSuccess 
                    ? 'p-3 rounded-lg text-xs font-medium flex items-center space-x-2 bg-emerald-50 text-emerald-700 border border-emerald-200'
                    : 'p-3 rounded-lg text-xs font-medium flex items-center space-x-2 bg-rose-50 text-rose-700 border border-rose-200';
                alertBox.classList.remove('hidden');
            }

            function hideAlert() {
                alertBox.classList.add('hidden');
                alertBox.textContent = '';
            }

            function openModal() {
                hideAlert();
                modal.classList.remove('hidden');
                requestAnimationFrame(() => {
                    backdrop.classList.remove('opacity-0');
                    dialog.classList.remove('opacity-0', 'scale-95');
                    dialog.classList.add('opacity-100', 'scale-100');
                });
                fetchPreferences();
            }

            function closeModal() {
                backdrop.classList.add('opacity-0');
                dialog.classList.remove('opacity-100', 'scale-100');
                dialog.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }

            async function fetchPreferences() {
                loadingIndicator.classList.remove('hidden');
                fieldsContainer.classList.add('hidden');
                saveBtn.disabled = true;

                try {
                    const response = await fetch('/UserPreference/Get', {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (response.ok) {
                        const data = await response.json();
                        if (data.language && languageSelect) {
                            languageSelect.value = data.language;
                        }
                        if (data.themeColor && themeColorSelect) {
                            themeColorSelect.value = data.themeColor;
                            document.documentElement.setAttribute('data-theme', data.themeColor);
                        }
                        
                        const currencySelect = document.getElementById('prefCurrency');
                        if (data.currency && currencySelect) {
                            currencySelect.value = data.currency;
                        }
                        
                        const dashSelect = document.getElementById('prefDashboard');
                        if (dashSelect && data.dashboards) {
                            dashSelect.innerHTML = '<option value="">Standard View (Default)</option>';
                            data.dashboards.forEach(d => {
                                const opt = document.createElement('option');
                                opt.value = d.slug;
                                opt.textContent = d.name;
                                dashSelect.appendChild(opt);
                            });
                            
                            if (data.preferredDashboard) {
                                dashSelect.value = data.preferredDashboard;
                            }
                        }
                        
                    } else {
                        showAlert('Failed to load user preferences.', false);
                    }
                } catch (err) {
                    console.error('Error fetching preferences:', err);
                    showAlert('An unexpected error occurred while loading preferences.', false);
                } finally {
                    loadingIndicator.classList.add('hidden');
                    fieldsContainer.classList.remove('hidden');
                    saveBtn.disabled = false;
                }
            }

            async function savePreferences(e) {
                e.preventDefault();
                hideAlert();
                saveBtn.disabled = true;
                saveSpinner.classList.remove('hidden');
                saveText.textContent = 'Saving...';

                const selectedTheme = themeColorSelect.value;
                const payload = {
                    language: languageSelect.value,
                    themeColor: selectedTheme
                };

                try {
                    const response = await fetch('/UserPreference/Update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        document.documentElement.setAttribute('data-theme', selectedTheme);
                        showAlert('Preferences updated successfully!', true);
                        setTimeout(() => {
                            closeModal();
                        }, 900);
                    } else {
                        showAlert('Failed to save preferences. Please try again.', false);
                    }
                } catch (err) {
                    console.error('Error saving preferences:', err);
                    showAlert('Error updating preferences.', false);
                } finally {
                    saveBtn.disabled = false;
                    saveSpinner.classList.add('hidden');
                    saveText.textContent = 'Save Preferences';
                }
            }

            gearBtn.addEventListener('click', function (e) {
                e.preventDefault();
                openModal();
            });

            if (closeBtn) closeBtn.addEventListener('click', closeModal);
            if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
            if (backdrop) backdrop.addEventListener('click', closeModal);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                    closeModal();
                }
            });

            if (form) {
                form.addEventListener('submit', savePreferences);
            }
        })();
    </script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Sidebar logic moved to _Sidebar.cshtml
    });
</script>


    <!-- PWA Service WorkPaer Registration -->
