                    <div class="flex items-center space-x-2.5">
                        <div class="w-8 h-8 rounded-lg bg-brand-500/20 text-brand-400 flex items-center justify-center">
                            <i class="fa-solid fa-sliders text-sm"></i>
                        </div>
                        <div>
