                        </div>

                        <!-- Theme Color -->
                        <div>
                            <label for="prefThemeColor" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                <i class="fa-solid fa-palette mr-1.5 text-brand-600"></i> Theme Accent Color
                            </label>
                            <select id="prefThemeColor" name="themeColor" class="block w-full rounded-lg border-slate-300 dark:border-slate-700 text-sm py-2 px-3 focus:border-brand-500 focus:ring-brand-500 border bg-white dark:bg-slate-800 dark:text-slate-100">
                                <option value="slate">Slate (Classic Neutral)</option>
                                <option value="ocean">Ocean Blue (Corporate Tech)</option>
                                <option value="emerald">Emerald (Fresh Green)</option>
                                <option value="violet">Violet (Modern Purple)</option>
                                <option value="rose">Rose (Warm Ruby)</option>
                            </select>
                        </div>

                        <!-- Currency -->
                        <div>
                            <label for="prefCurrency" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
