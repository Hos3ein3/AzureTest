        <div class="min-h-full flex items-center justify-center p-4 text-center sm:p-0">
            <div id="prefModalDialog" class="relative bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-lg w-full scale-95 opacity-0 border border-slate-100">
                <!-- Modal Header -->
