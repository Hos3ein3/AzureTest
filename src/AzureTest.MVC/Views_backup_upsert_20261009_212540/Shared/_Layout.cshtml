                            <label for="prefDashboard" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                <i class="fa-solid fa-chart-line mr-1.5 text-brand-600"></i> Default Dashboard
                            </label>
                            <select id="prefDashboard" name="preferredDashboard" class="block w-full rounded-lg border-slate-300 text-sm py-2 px-3 focus:border-brand-500 focus:ring-brand-500 border bg-white">
