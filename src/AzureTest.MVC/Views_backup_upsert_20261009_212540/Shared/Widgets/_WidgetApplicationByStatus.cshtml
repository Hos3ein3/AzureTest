@model AzureTest.MVC.Models.HomeDashboardViewModel

<!-- Status Distribution Pie Chart -->
<div class="col-span-1 lg:col-span-4">
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
            <h5 class="text-lg font-semibold text-slate-800 m-0">Applications by Status</h5>
            <i class="fa-solid fa-chart-pie text-slate-400"></i>
        </div>
        <div class="p-6 flex-1 relative min-h-[300px] w-full">
            <canvas id="statusChart"></canvas>
        </div>
    </div>
</div>
