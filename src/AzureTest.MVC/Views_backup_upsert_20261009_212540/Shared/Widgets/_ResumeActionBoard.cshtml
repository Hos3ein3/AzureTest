@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
<div class="h-full w-full bg-white rounded-xl shadow-sm ring-1 ring-slate-200 p-5">
    <h3 class="text-sm font-semibold text-slate-800 mb-4">Quick Actions</h3>
    <div class="grid grid-cols-2 gap-3 h-[calc(100%-2.5rem)]">
        <a href="@(string.IsNullOrEmpty(Model.JobLink) ? "#" : Model.JobLink)" target="_blank" 
           class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:border-brand-500 hover:bg-brand-50 transition-all text-center @(string.IsNullOrEmpty(Model.JobLink) ? "opacity-50 cursor-not-allowed pointer-events-none" : "")">
            <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center mb-2 text-slate-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <span class="text-xs font-medium text-slate-700">Job Posting</span>
        </a>
        <a href="@(string.IsNullOrEmpty(Model.ChatUrl) ? "#" : Model.ChatUrl)" target="_blank" 
           class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:border-indigo-500 hover:bg-indigo-50 transition-all text-center @(string.IsNullOrEmpty(Model.ChatUrl) ? "opacity-50 cursor-not-allowed pointer-events-none" : "")">
            <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center mb-2 text-slate-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            </div>
            <span class="text-xs font-medium text-slate-700">AI Chat</span>
        </a>
    </div>
</div>
