@model AzureTest.Contracts.DTOs.Pages.PageDto
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Title;
    var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var userId = !string.IsNullOrEmpty(userIdString) ? Guid.Parse(userIdString) : Guid.Empty;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header/Banner -->
    @if(!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="w-full h-72 md:h-96 rounded-2xl overflow-hidden shadow-md mb-10 relative bg-slate-100">
            <img src="@Model.ImagePath" alt="@Model.Title" class="w-full h-full object-cover">
        </div>
    }
    
    <div class="mb-10 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">@Model.Title</h1>
        <div class="flex items-center justify-center gap-4 text-sm text-slate-500">
            <span class="flex items-center"><i class="fa-regular fa-calendar mr-1.5"></i> Published</span>
            <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
            <span class="flex items-center"><i class="fa-regular fa-clock mr-1.5"></i> @(Model.Comments?.Count ?? 0) Comments</span>
        </div>
    </div>
    
    <!-- Content -->
    <article class="prose prose-slate prose-lg max-w-none mb-16 mx-auto">
        @Html.Raw(Model.Content)
    </article>
    
    <!-- Interactions -->
    <div class="flex items-center justify-center gap-6 mb-16 py-8 border-t border-b border-slate-100">
        <form method="post" action="@Url.Action("ToggleLike", new { id = Model.Id })">
            <button type="submit" class="group flex flex-col items-center gap-2 transition-transform hover:scale-110">
                <div class="w-14 h-14 rounded-full flex items-center justify-center shadow-sm transition-colors @(Model.LikedBy.Contains(userId) ? "bg-brand-500 text-white" : "bg-slate-50 text-slate-400 border border-slate-200 group-hover:border-brand-500 group-hover:text-brand-500")">
                    <i class="fa-solid fa-thumbs-up text-xl"></i>
                </div>
                <span class="text-sm font-semibold @(Model.LikedBy.Contains(userId) ? "text-brand-600" : "text-slate-500")">@Model.LikedBy.Count Likes</span>
            </button>
        </form>
        <form method="post" action="@Url.Action("ToggleDislike", new { id = Model.Id })">
            <button type="submit" class="group flex flex-col items-center gap-2 transition-transform hover:scale-110">
                <div class="w-14 h-14 rounded-full flex items-center justify-center shadow-sm transition-colors @(Model.DislikedBy.Contains(userId) ? "bg-red-500 text-white" : "bg-slate-50 text-slate-400 border border-slate-200 group-hover:border-red-500 group-hover:text-red-500")">
                    <i class="fa-solid fa-thumbs-down text-xl"></i>
                </div>
                <span class="text-sm font-semibold @(Model.DislikedBy.Contains(userId) ? "text-red-600" : "text-slate-500")">@Model.DislikedBy.Count Dislikes</span>
            </button>
        </form>
    </div>

    <!-- Comments Section -->
    <section>
        <h3 class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-2">
            Discussion <span class="bg-brand-100 text-brand-700 text-sm py-0.5 px-2.5 rounded-full">@Model.Comments.Count</span>
        </h3>
        
        <form method="post" action="@Url.Action("AddComment", new { id = Model.Id })" class="mb-12 flex gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100 shadow-sm focus-within:border-brand-300 focus-within:ring-1 focus-within:ring-brand-300 transition-all">
            <div class="w-10 h-10 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center font-bold flex-shrink-0">
                <i class="fa-regular fa-user"></i>
            </div>
            <input type="text" name="content" required placeholder="Share your thoughts..." class="flex-1 bg-transparent border-none px-2 py-2 text-slate-800 focus:outline-none focus:ring-0">
            <button type="submit" class="bg-slate-800 text-white px-6 py-2 rounded-lg hover:bg-slate-900 font-medium shadow-sm transition-colors">Post</button>
        </form>
        
        <div class="space-y-6">
            @foreach(var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
            {
                <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center text-xs font-bold uppercase">
                                @(c.UserName.Substring(0, 1))
                            </div>
                            <span class="font-bold text-slate-800">@c.UserName</span>
                        </div>
                        <span class="text-xs font-medium text-slate-400 bg-slate-50 px-2 py-1 rounded-md border border-slate-100">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <p class="text-slate-600 leading-relaxed pl-11">@c.Content</p>
                    
                    @if(!string.IsNullOrEmpty(c.AdminReply))
                    {
                        <div class="ml-11 mt-5 bg-blue-50/50 p-4 rounded-lg border border-blue-100">
                            <div class="flex items-center gap-2 mb-2">
                                <i class="fa-solid fa-shield-halved text-blue-500"></i>
                                <span class="text-xs font-bold text-blue-800 uppercase tracking-wider">Admin Reply</span>
                                <span class="text-xs text-blue-400 ml-auto">@c.AdminReplyAt?.ToString("MMM dd, HH:mm")</span>
                            </div>
                            <p class="text-slate-700 text-sm">@c.AdminReply</p>
                        </div>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <form method="post" action="@Url.Action("AnswerComment", new { id = Model.Id, commentId = c.Id })" class="mt-5 ml-11 flex gap-2">
                            <input type="text" name="reply" placeholder="Reply as admin..." class="flex-1 text-sm bg-slate-50 border border-slate-200 rounded-lg px-4 py-2 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
                            <button type="submit" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700 shadow-sm transition-colors">Reply</button>
                        </form>
                    }
                </div>
            }
        </div>
    </section>
</div>
