@using AzureTest.Contracts.DTOs.IdeaTracker
@using AzureTest.Domain.Documents
@using AzureTest.Domain.Enums
@model IdeaDto
@{
    ViewData["Title"] = Model.Title;
    var subPages = ViewBag.SubPages as List<IdeaDto> ?? new List<IdeaDto>();
}

<div class="bg-white min-h-[calc(100vh-4rem)] flex flex-col relative">
    
    <!-- Cover Banner -->
    <div class="h-64 md:h-80 w-full relative shrink-0" style="@(string.IsNullOrEmpty(Model.CoverImage) && !string.IsNullOrEmpty(Model.ThemeColor) ? $"background: linear-gradient(135deg, {Model.ThemeColor} 0%, rgba(0,0,0,0.3) 100%); background-color: {Model.ThemeColor};" : "")">
        @if (!string.IsNullOrEmpty(Model.CoverImage))
        {
            <img src="@Model.CoverImage" alt="Cover" class="w-full h-full object-cover" />
        }
        
        <!-- Actions Overlay -->
        <div class="absolute top-4 right-4 flex gap-2">
            <a asp-action="Index" class="px-3 py-1.5 bg-white/90 hover:bg-white text-slate-800 rounded shadow-sm text-sm font-medium transition backdrop-blur-sm">
                <i class="fa-solid fa-home"></i> Workspace
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-3 py-1.5 bg-white/90 hover:bg-white text-slate-800 rounded shadow-sm text-sm font-medium transition backdrop-blur-sm">
                <i class="fa-solid fa-pen mr-1"></i> Edit Page
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this idea?');" class="inline">
                <button type="submit" class="px-3 py-1.5 bg-rose-500/90 hover:bg-rose-600 text-white rounded shadow-sm text-sm font-medium transition backdrop-blur-sm">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </form>
        </div>
    </div>

    <div class="flex-1 flex max-w-7xl mx-auto w-full px-6 lg:px-8 pb-20 relative">
        
        <!-- Main Content Area -->
        <div class="flex-1 max-w-4xl pt-1">
            <!-- Floating Big Icon -->
            <div class="-mt-16 mb-6 relative z-10">
                <div class="w-32 h-32 bg-white rounded-2xl shadow-lg border border-slate-100 flex items-center justify-center text-6xl">
                    <i class="@Model.Icon text-slate-700"></i>
                </div>
            </div>

            <!-- Header Info -->
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">@Model.Title</h1>
            
            <div class="flex flex-wrap gap-x-6 gap-y-3 mb-10 pb-6 border-b border-slate-100">
                <div class="flex items-center text-sm">
                    <span class="text-slate-400 w-24">Status</span>
                    <span class="font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">@(((IdeaStatus)Model.Status).ToString())</span>
                </div>
                <div class="flex items-center text-sm">
                    <span class="text-slate-400 w-24">Priority</span>
                    <span class="font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">@(((IdeaPriority)Model.Priority).ToString())</span>
                </div>
                <div class="flex items-center text-sm">
                    <span class="text-slate-400 w-24">Created</span>
                    <span class="font-medium text-slate-700">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>

            <!-- Editor.js ReadOnly Container -->
            <div id="content-container" class="prose prose-slate prose-img:rounded-xl prose-img:shadow-sm max-w-none">@Html.Raw(Model.Content)</div>

            <!-- Document Pages Section -->
            <div class="mt-16 pt-8 border-t border-slate-200">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-regular fa-file-lines text-brand-500"></i> Document Pages
                    </h3>
                    <a asp-controller="IdeaPage" asp-action="Create" asp-route-ideaId="@Model.Id" class="text-sm font-medium text-brand-600 hover:bg-brand-50 px-3 py-1.5 rounded-lg transition">
                        <i class="fa-solid fa-plus mr-1"></i> Add Page
                    </a>
                </div>
                
                @{ var ideaPages = ViewBag.Pages as List<IdeaPageDto> ?? new List<IdeaPageDto>(); }
                @if (ideaPages.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach(var pageDto in ideaPages)
                        {
                            <div class="flex items-center p-3 rounded-lg border border-slate-200 hover:border-brand-300 hover:shadow-md transition bg-slate-50 group">
                                <div class="w-10 h-10 rounded bg-white shadow-sm flex items-center justify-center text-lg mr-3 shrink-0">
                                    <i class="fa-regular fa-file text-slate-600 group-hover:text-brand-500 transition-colors"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <a asp-controller="IdeaPage" asp-action="Details" asp-route-id="@pageDto.Id" class="font-bold text-slate-900 truncate hover:text-brand-600 block">@pageDto.Title</a>
                                </div>
                                <div class="ml-2 flex gap-2">
                                    <a asp-controller="IdeaPage" asp-action="Edit" asp-route-id="@pageDto.Id" class="text-slate-400 hover:text-brand-600"><i class="fa-solid fa-pen"></i></a>
                                    <form asp-controller="IdeaPage" asp-action="Delete" asp-route-id="@pageDto.Id" asp-route-ideaId="@Model.Id" method="post" onsubmit="return confirm('Delete this page?');" class="inline">
                                        <button type="submit" class="text-slate-400 hover:text-rose-600"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-slate-500 italic bg-slate-50 p-4 rounded-lg border border-dashed border-slate-300 text-center">No document pages attached to this idea yet.</p>
                }
            </div>
        
<!-- Sub-Pages Section -->
            <div class="mt-16 pt-8 border-t border-slate-200">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-regular fa-folder-open text-brand-500"></i> Sub-Ideas
                    </h3>
                    <a asp-action="Create" asp-route-parentId="@Model.Id" class="text-sm font-medium text-brand-600 hover:bg-brand-50 px-3 py-1.5 rounded-lg transition">
                        <i class="fa-solid fa-plus mr-1"></i> Add Sub-Idea
                    </a>
                </div>
                
                @if (subPages.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach(var subPage in subPages)
                        {
                            <a asp-action="Details" asp-route-id="@subPage.Id" class="flex items-center p-3 rounded-lg border border-slate-200 hover:border-brand-300 hover:shadow-md transition bg-slate-50 group">
                                <div class="w-10 h-10 rounded bg-white shadow-sm flex items-center justify-center text-lg mr-3 shrink-0">
                                    <i class="@subPage.Icon text-slate-600 group-hover:text-brand-500 transition-colors"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-bold text-slate-900 truncate">@subPage.Title</h4>
                                    <p class="text-xs text-slate-500 truncate">@(((IdeaStatus)subPage.Status).ToString())</p>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-slate-500 italic bg-slate-50 p-4 rounded-lg border border-dashed border-slate-300 text-center">No sub-ideas attached to this idea yet.</p>
                }
            </div>

            </div>

        <!-- Sticky Table of Contents (Right Sidebar) -->
        <div class="hidden xl:block w-64 shrink-0 pl-10 pt-10">
            <div class="sticky top-8">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Table of Contents</h4>
                <nav id="toc-container" class="space-y-1 text-sm text-slate-600 border-l-2 border-slate-100 pl-3">
                    <!-- JS will populate this -->
                </nav>
            </div>
        </div>

    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            buildTableOfContents();

            function buildTableOfContents() {
                const tocContainer = document.getElementById('toc-container');
                const contentContainer = document.getElementById('content-container');
                const headers = contentContainer.querySelectorAll('h1, h2, h3, h4');
                
                if (headers.length === 0) {
                    tocContainer.innerHTML = '<p class="text-xs text-slate-400 italic">No headings found.</p>';
                    return;
                }

                headers.forEach((header, index) => {
                    // Create an anchor id if it doesn't have one
                    if (!header.id) {
                        const anchorId = 'heading-' + index;
                        header.id = anchorId;
                    }

                    const a = document.createElement('a');
                    a.href = '#' + header.id;
                    a.textContent = header.textContent;
                    a.className = 'block py-1 hover:text-brand-600 transition-colors truncate toc-item';
                    
                    // Indent based on heading level
                    const level = parseInt(header.tagName.substring(1));
                    if (level === 3) a.classList.add('ml-3');
                    if (level === 4) a.classList.add('ml-6');

                    tocContainer.appendChild(a);
                });
            }
        });
    </script>
}
