@model AzureTest.Contracts.DTOs.Resumes.ResumeDto

<div class="h-full w-full p-4 bg-white flex flex-col justify-between">
    <div>
        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Resume Analytics A</h3>
        <p class="text-xl font-bold text-slate-800">@Model.PositionTitle</p>
        <p class="text-sm text-slate-500">Status: <span class="font-medium text-brand-600">@Model.Status</span></p>
    </div>
    
    <div class="grid grid-cols-2 gap-4 mt-4">
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <p class="text-xs text-slate-500">ATS Score</p>
            <p class="text-2xl font-bold @(Model.AtsScore > 70 ? "text-green-600" : "text-amber-600")">@(Model.AtsScore ?? 0)%</p>
        </div>
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <p class="text-xs text-slate-500">Source</p>
            <p class="text-lg font-bold text-blue-600">@Model.Source</p>
        </div>
    </div>
</div>
