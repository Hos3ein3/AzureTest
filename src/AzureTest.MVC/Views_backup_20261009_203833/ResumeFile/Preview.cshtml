@{
    ViewData["Title"] = "Preview: " + ViewBag.FileName;
}

<div class="mb-4 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Document Preview</h1>
    <a href="javascript:history.back()" class="text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-md font-medium">
        <i class="fa-solid fa-arrow-left mr-2"></i> Back
    </a>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200" style="height: 75vh;">
    @if (ViewBag.FileName.ToString().EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
    {
        <iframe src="@ViewBag.FileUrl" class="w-full h-full border-0"></iframe>
    }
    else if (ViewBag.FileName.ToString().EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || 
             ViewBag.FileName.ToString().EndsWith(".png", StringComparison.OrdinalIgnoreCase) || 
             ViewBag.FileName.ToString().EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase))
    {
        <div class="w-full h-full flex items-center justify-center bg-gray-50 overflow-auto p-4">
            <img src="@ViewBag.FileUrl" alt="@ViewBag.FileName" class="max-w-full max-h-full object-contain shadow-sm border border-gray-300" />
        </div>
    }
    else
    {
        <div class="w-full h-full flex flex-col items-center justify-center bg-gray-50 text-gray-500">
            <i class="fa-solid fa-file-lines text-6xl mb-4 text-gray-300"></i>
            <p class="text-lg">Preview not available for this file type.</p>
            <a href="@ViewBag.FileUrl" download class="mt-4 text-brand-600 hover:underline">Download instead</a>
        </div>
    }
</div>
