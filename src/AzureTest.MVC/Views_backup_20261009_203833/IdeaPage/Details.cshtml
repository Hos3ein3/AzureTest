@model AzureTest.Contracts.DTOs.IdeaTracker.IdeaPageDto
@using AzureTest.Contracts.DTOs.IdeaTracker
@{
    ViewData["Title"] = Model.Title;
    var idea = ViewBag.Idea as IdeaDto;
    var pages = ViewBag.Pages as List<IdeaPageDto> ?? new List<IdeaPageDto>();
    var sections = ViewBag.Sections as List<IdeaSectionDto> ?? new List<IdeaSectionDto>();
}

<!-- GridStack CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/gridstack.js/9.2.2/gridstack.min.css" rel="stylesheet" />

<div class="flex h-[calc(100vh-4rem)] -mx-4 sm:-mx-6 lg:-mx-8">
    <!-- Left Sidebar: Book Reference Navigation -->
    <div class="w-64 shrink-0 bg-slate-50 border-r border-slate-200 overflow-y-auto">
        <div class="p-4 border-b border-slate-200 bg-white sticky top-0 z-10">
            <a asp-controller="IdeaTracker" asp-action="Details" asp-route-id="@Model.IdeaId" class="text-sm font-medium text-slate-500 hover:text-brand-600 flex items-center mb-2 transition-colors">
                <i class="fa-solid fa-arrow-left mr-1"></i> Back to Idea
            </a>
            <h2 class="font-bold text-slate-900 truncate" title="@idea?.Title">
                <i class="fa-solid fa-book-open text-brand-500 mr-1"></i> @(idea?.Title ?? "Idea")
            </h2>
        </div>
        
        <div class="p-3 space-y-1">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 px-2">Pages</h3>
            @foreach(var p in pages)
            {
                var isActive = p.Id == Model.Id;
                <a asp-action="Details" asp-route-id="@p.Id" class="block px-3 py-2 rounded-lg text-sm transition-colors @(isActive ? "bg-brand-50 text-brand-700 font-medium border border-brand-100" : "text-slate-600 hover:bg-slate-200 hover:text-slate-900")">
                    <div class="flex items-center">
                        <i class="fa-regular @(isActive ? "fa-folder-open text-brand-500" : "fa-folder text-slate-400") mr-2"></i>
                        <span class="truncate">@p.Title</span>
                    </div>
                </a>
                
                @if(isActive && sections.Any())
                {
                    <div class="ml-6 mt-1 mb-2 space-y-1 border-l border-slate-200 pl-2">
                        @foreach(var s in sections.OrderBy(x => x.OrderIndex))
                        {
                            <a href="#section-@s.Id" class="block px-2 py-1 text-xs text-slate-500 hover:text-brand-600 hover:bg-slate-100 rounded transition-colors truncate">
                                @s.Title
                            </a>
                        }
                    </div>
                }
            }
            
            <a asp-action="Create" asp-route-ideaId="@Model.IdeaId" class="block px-3 py-2 mt-4 rounded-lg text-sm text-slate-500 border border-dashed border-slate-300 hover:border-brand-400 hover:text-brand-600 hover:bg-brand-50 transition-colors text-center">
                <i class="fa-solid fa-plus mr-1"></i> Add Page
            </a>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 overflow-y-auto bg-slate-100 relative scroll-smooth">
        
        <div class="mx-auto py-10 px-6 sm:px-10 lg:px-12">
            <!-- Page Header -->
            <div class="mb-8 bg-white p-8 rounded-xl shadow-sm border border-slate-200 relative group">
                <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">@Model.Title</h1>
                <div class="mt-2 text-sm text-slate-500 flex items-center gap-4">
                    <span><i class="fa-regular fa-clock mr-1"></i> @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                
                <!-- Action bar (visible on hover) -->
                <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity bg-slate-50 p-1 rounded-lg border border-slate-200 shadow-sm flex items-center gap-1">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="p-2 text-slate-500 hover:text-brand-600 hover:bg-brand-100 rounded" title="Edit Page">
                        <i class="fa-solid fa-pen"></i>
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-ideaId="@Model.IdeaId" method="post" onsubmit="return confirm('Delete this entire page?');" class="inline">
                        <button type="submit" class="p-2 text-slate-500 hover:text-rose-600 hover:bg-rose-100 rounded" title="Delete Page">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
                
                @if(!string.IsNullOrWhiteSpace(Model.Content))
                {
                    <div class="prose prose-slate prose-img:rounded-xl mt-6 max-w-none border-t border-slate-100 pt-6">
                        @Html.Raw(Model.Content)
                    </div>
                }
            </div>

            <!-- Sections Area (GridStack) -->
            <div>
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-2xl font-bold text-slate-900">Blocks & Elements</h2>
                    <a asp-controller="IdeaSection" asp-action="Create" asp-route-ideaPageId="@Model.Id" class="text-sm font-medium bg-brand-600 text-white hover:bg-brand-700 shadow-sm px-4 py-2 rounded-lg transition-colors border border-brand-700">
                        <i class="fa-solid fa-plus mr-1"></i> Add Element
                    </a>
                </div>

                @if(!sections.Any())
                {
                    <div class="text-center py-12 px-4 border-2 border-dashed border-slate-300 rounded-xl bg-white shadow-sm">
                        <i class="fa-solid fa-shapes text-4xl text-slate-300 mb-3 block"></i>
                        <h3 class="text-lg font-bold text-slate-700">Canvas is empty</h3>
                        <p class="text-sm text-slate-500 mt-1 mb-4">Add movable text blocks, widgets, and elements.</p>
                    </div>
                }
                else
                {
                    <div class="grid-stack">
                        @foreach(var s in sections)
                        {
                            <div class="grid-stack-item" gs-id="@s.Id" gs-x="@(s.X)" gs-y="@(s.Y)" gs-w="@(s.Width)" gs-h="@(s.Height)">
                                <div class="grid-stack-item-content bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col group/item">
                                    <div class="grid-stack-item-header flex items-center justify-between px-3 py-2 border-b border-slate-100 bg-slate-50 cursor-move">
                                        <h3 class="text-sm font-bold text-slate-700 truncate"><i class="fa-solid fa-grip-vertical text-slate-300 mr-2"></i>@s.Title</h3>
                                        <div class="opacity-0 group-hover/item:opacity-100 transition-opacity flex gap-1">
                                            <a asp-controller="IdeaSection" asp-action="Edit" asp-route-id="@s.Id" class="text-slate-400 hover:text-brand-600 p-1" title="Edit"><i class="fa-solid fa-pen text-xs"></i></a>
                                            <form asp-controller="IdeaSection" asp-action="Delete" asp-route-id="@s.Id" asp-route-ideaPageId="@Model.Id" method="post" onsubmit="return confirm('Delete?');" class="inline">
                                                <button type="submit" class="text-slate-400 hover:text-rose-600 p-1" title="Delete"><i class="fa-solid fa-trash text-xs"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="flex-1 p-4 overflow-y-auto prose prose-sm max-w-none">
                                        @Html.Raw(s.Content)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gridstack.js/9.2.2/gridstack-all.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var grid = GridStack.init({
                margin: 10,
                cellHeight: 80,
                handle: '.grid-stack-item-header'
            });

            grid.on('change', function(event, items) {
                items.forEach(function(item) {
                    var dto = {
                        Id: item.id,
                        X: item.x,
                        Y: item.y,
                        Width: item.w,
                        Height: item.h
                    };
                    
                    fetch('/IdeaSection/UpdateLayout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(dto)
                    }).catch(err => console.error(err));
                });
            });
        });
    </script>
}
