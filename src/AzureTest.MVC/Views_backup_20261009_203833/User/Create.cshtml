@model AzureTest.MVC.ViewModels.Users.UserCreateViewModel
@{
    ViewData["Title"] = "Add New User";
}

<div class="flex items-center mb-6">
    <a asp-action="Index" class="text-slate-400 hover:text-brand-600 mr-4 transition-colors">
        <i class="fa-solid fa-arrow-left text-xl"></i>
    </a>
    <h1 class="text-2xl font-bold text-slate-800">Add New User</h1>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-3xl">
    <form asp-action="Create" method="post" class="p-6 md:p-8">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-6 bg-red-50 p-4 rounded-lg"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label asp-for="FirstName" class="block text-sm font-medium text-slate-700 mb-2">First Name <span class="text-red-500">*</span></label>
                <input asp-for="FirstName" class="block w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500" placeholder="e.g. John" />
                <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-medium text-slate-700 mb-2">Last Name <span class="text-red-500">*</span></label>
                <input asp-for="LastName" class="block w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500" placeholder="e.g. Doe" />
                <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-2">Email Address <span class="text-red-500">*</span></label>
            <input asp-for="Email" class="block w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500" placeholder="e.g. john@example.com" />
            <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-2">Initial Password <span class="text-red-500">*</span></label>
                <input asp-for="Password" type="password" class="block w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500" />
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-2">Confirm Password <span class="text-red-500">*</span></label>
                <input asp-for="ConfirmPassword" type="password" class="block w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="mb-8">
            <label class="block text-sm font-medium text-slate-700 mb-2">Assign Roles</label>
            <p class="text-xs text-slate-500 mb-3">Select the permissions this user should have in the system.</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                @foreach (var role in Model.AvailableRoles)
                {
                    <label class="flex items-center p-3 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-50 transition-colors">
                        <input type="checkbox" name="SelectedRoles" value="@role.Value" class="h-4 w-4 text-brand-600 focus:ring-brand-500 border-gray-300 rounded">
                        <span class="ml-3 text-sm text-slate-700 font-medium">@role.Text</span>
                    </label>
                }
                
                @if (!Model.AvailableRoles.Any())
                {
                    <p class="text-sm text-amber-600 bg-amber-50 p-3 rounded-lg col-span-2">No roles available in the system. <a asp-controller="Role" asp-action="Create" class="font-bold hover:underline">Create a role</a> first.</p>
                }
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-6 border-t border-slate-100">
            <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">Cancel</a>
            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-brand-600 border border-transparent rounded-lg hover:bg-brand-700 transition-colors shadow-sm flex items-center">
                <i class="fa-solid fa-check mr-2"></i> Create User
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
