@model AzureTest.Contracts.DTOs.SampleNotes.CreateSampleNoteDto
@using AzureTest.Domain.Enums
@using AzureTest.MVC.Extensions
@{
    ViewData["Title"] = "Create Note";
}

<div class="p-6 max-w-2xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
            <i class="fa-solid fa-arrow-left text-lg"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Create Note</h1>
            <p class="text-sm text-slate-500">All fields are validated by <code>IValidationService</code> + FluentValidation</p>
        </div>
    </div>

    <!-- Validation Summary — populated by Result.ToFormResult() via AddToModelState() -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="px-4 py-3 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-sm font-semibold text-red-700 mb-1"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Please fix the following errors:</p>
            <div asp-validation-summary="All" class="text-sm text-red-600 space-y-0.5"></div>
        </div>
    }

    <!-- Form -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Title -->
            <div>
                <label asp-for="Title" class="block text-sm font-medium text-slate-700 mb-1">Title <span class="text-red-500">*</span></label>
                <input asp-for="Title" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
                       placeholder="Enter note title..." />
                <span asp-validation-for="Title" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Content -->
            <div>
                <label asp-for="Content" class="block text-sm font-medium text-slate-700 mb-1">Content <span class="text-red-500">*</span></label>
                <textarea asp-for="Content" rows="6"
                          class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-y"
                          placeholder="Write your note content here..."></textarea>
                <span asp-validation-for="Content" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Category + Priority row -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Category" class="block text-sm font-medium text-slate-700 mb-1">Category</label>
                    <select asp-for="Category" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                        @foreach (var item in EnumExtensions.ToSelectList<NoteCategory>())
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <span asp-validation-for="Category" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Priority" class="block text-sm font-medium text-slate-700 mb-1">Priority <span class="text-slate-400">(1–5)</span></label>
                    <input asp-for="Priority" type="number" min="1" max="5"
                           class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    <span asp-validation-for="Priority" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- IsPinned -->
            <div class="flex items-center gap-2">
                <input asp-for="IsPinned" type="checkbox" class="w-4 h-4 text-brand-500 rounded border-slate-300" />
                <label asp-for="IsPinned" class="text-sm text-slate-700">Pin this note to the top</label>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-2 border-t border-slate-100">
                <button type="submit" class="px-5 py-2 bg-brand-500 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors shadow-sm">
                    <i class="fa-solid fa-floppy-disk mr-1.5"></i> Create Note
                </button>
                <a asp-action="Index" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg text-sm hover:bg-slate-50 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
