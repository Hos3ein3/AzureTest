@{
    ViewData["Title"] = "Access Denied";
}

<div class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="mb-8 relative inline-block">
        <div class="absolute inset-0 bg-rose-100 blur-xl rounded-full opacity-50"></div>
        <i class="fa-solid fa-shield-halved text-6xl text-rose-500 relative z-10"></i>
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">403</h1>
    <h2 class="text-2xl font-bold text-slate-700 mb-2">Access Denied</h2>
    <p class="text-slate-500 mb-8 max-w-md">You do not have the required permissions to view this page or perform this action. If you believe this is an error, please contact your administrator.</p>
    <div class="flex items-center justify-center gap-x-6">
        <a href="/" class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 transition-colors">
            <i class="fa-solid fa-house mr-2"></i> Return Home
        </a>
    </div>
</div>
