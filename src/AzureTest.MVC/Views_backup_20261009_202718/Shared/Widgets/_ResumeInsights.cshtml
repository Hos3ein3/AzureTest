@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
@{
    var daysSinceApplied = (int)(DateTime.UtcNow - Model.CreatedOn).TotalDays;
    var urgencyColor = daysSinceApplied > 30 ? "text-red-600" : daysSinceApplied > 14 ? "text-amber-600" : "text-emerald-600";
}
<div class="h-full w-full bg-slate-900 rounded-xl shadow-lg p-5 text-white">
    <h3 class="text-sm font-medium text-slate-400 mb-5">Analytics Insights</h3>
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-xs text-slate-500 mb-1">Time in Pipeline</p>
                <p class="text-2xl font-bold @urgencyColor">@daysSinceApplied <span class="text-sm font-normal text-slate-400">days</span></p>
            </div>
            <div class="h-12 w-12 rounded-full bg-slate-800 flex items-center justify-center border border-slate-700">
                <svg class="h-6 w-6 @urgencyColor" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        
        <div class="flex items-center justify-between border-t border-slate-800 pt-5">
            <div>
                <p class="text-xs text-slate-500 mb-1">Match Potential</p>
                <p class="text-2xl font-bold text-white">@(Model.AtsScore?.ToString() ?? "N/A")<span class="text-sm font-normal text-slate-400">%</span></p>
            </div>
            <div class="h-12 w-12 rounded-full bg-slate-800 flex items-center justify-center border border-slate-700">
                <svg class="h-6 w-6 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            </div>
        </div>
    </div>
</div>
