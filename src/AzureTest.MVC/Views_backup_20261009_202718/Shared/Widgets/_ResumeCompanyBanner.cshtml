@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
<div class="h-full w-full relative overflow-hidden rounded-xl shadow-md group">
    <!-- Abstract Background Pattern -->
    <div class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-600"></div>
    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-white/10 blur-2xl"></div>
    <div class="absolute -left-10 -bottom-10 h-32 w-32 rounded-full bg-black/10 blur-2xl"></div>
    
    <div class="relative h-full p-5 flex flex-col justify-end text-white">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-white/20 text-white backdrop-blur-sm w-max mb-3 uppercase tracking-widest border border-white/20">
            Target Company
        </span>
        <h2 class="text-2xl font-black tracking-tight drop-shadow-md mb-1">
            @(Model.CompanyName ?? "Confidential")
        </h2>
        <div class="flex items-center justify-between mt-1">
            <p class="text-sm font-medium text-emerald-50 drop-shadow-sm truncate pr-4">@Model.PositionTitle</p>
            <div class="h-8 w-8 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shrink-0 group-hover:bg-white/30 transition-colors">
                <svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
        </div>
    </div>
</div>
