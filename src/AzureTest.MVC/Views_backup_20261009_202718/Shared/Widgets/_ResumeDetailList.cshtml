@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
<div class="h-full w-full bg-white rounded-xl shadow-sm ring-1 ring-slate-200 overflow-y-auto">
    <div class="px-4 py-3 border-b border-slate-100 bg-slate-50 sticky top-0">
        <h3 class="text-sm font-semibold text-slate-800">Application Details</h3>
    </div>
    <div class="p-4 space-y-4">
        <div>
            <span class="block text-xs font-medium text-slate-500">Position</span>
            <span class="block text-sm text-slate-900 font-medium">@Model.PositionTitle</span>
        </div>
        <div>
            <span class="block text-xs font-medium text-slate-500">Company</span>
            <span class="block text-sm text-slate-900">@(Model.CompanyName ?? "Unspecified")</span>
        </div>
        <div>
            <span class="block text-xs font-medium text-slate-500">Location</span>
            <span class="block text-sm text-slate-900">@(string.IsNullOrEmpty(Model.Location) ? "Unspecified" : Model.Location)</span>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <span class="block text-xs font-medium text-slate-500">Source</span>
                <span class="block text-sm text-slate-900">@Model.Source.ToString()</span>
            </div>
            <div>
                <span class="block text-xs font-medium text-slate-500">Status</span>
                <span class="block text-sm text-slate-900">@Model.Status.ToString()</span>
            </div>
        </div>
    </div>
</div>
