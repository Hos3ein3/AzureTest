@model AzureTest.Contracts.DTOs.Companies.ICompanyFormDto

<div class="space-y-6">
    <div>
        <label asp-for="CompanyName" class="block text-sm font-medium text-slate-700 mb-1">Company Name <span class="text-red-500">*</span></label>
        <input asp-for="CompanyName" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="e.g. Acme Corp" />
        <span asp-validation-for="CompanyName" class="text-red-500 text-xs mt-1 block"></span>
    </div>
                
    <div>
        <label asp-for="Location" class="block text-sm font-medium text-slate-700 mb-1">Company Location</label>
        <input asp-for="Location" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="e.g. Amsterdam, NL" />
        <span asp-validation-for="Location" class="text-red-500 text-xs mt-1 block"></span>
    </div>
                
    <div>
        <label asp-for="KvkNumber" class="block text-sm font-medium text-slate-700 mb-1">KVK Number</label>
        <input asp-for="KvkNumber" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="e.g. 12345678" />
        <span asp-validation-for="KvkNumber" class="text-red-500 text-xs mt-1 block"></span>
    </div>
                
    <div class="relative flex items-start pt-2">
        <div class="flex h-5 items-center">
            <input asp-for="IsINDMember" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        </div>
        <div class="ml-3 text-sm">
            <label asp-for="IsINDMember" class="font-medium text-slate-700">Is IND Recognized Sponsor</label>
            <p class="text-slate-500 text-xs">Check this if the company is listed on the IND public register.</p>
        </div>
    </div>
</div>