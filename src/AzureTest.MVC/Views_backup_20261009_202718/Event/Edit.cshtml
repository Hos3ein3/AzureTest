@model AzureTest.Application.Events.Commands.UpdateEventCommand
@{
    ViewData["Title"] = "Edit Event";
}

<nav aria-label="breadcrumb" class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li><a asp-action="Index" class="hover:text-brand-600">Events</a></li>
        <li><i class="fa-solid fa-chevron-right text-xs"></i></li>
        <li class="font-medium text-slate-800" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="max-w-2xl bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <h5 class="text-sm font-semibold text-slate-800 m-0">Edit Event</h5>
    </div>
    <div class="p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Title <span class="text-red-500">*</span></label>
                <input asp-for="Title" required class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" />
                <span asp-validation-for="Title" class="text-red-500 text-xs"></span>
            </div>
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
                <textarea asp-for="Description" rows="3" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border"></textarea>
                <span asp-validation-for="Description" class="text-red-500 text-xs"></span>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Start Date <span class="text-red-500">*</span></label>
                    <input asp-for="StartDate" type="datetime-local" required class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" />
                    <span asp-validation-for="StartDate" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">End Date <span class="text-red-500">*</span></label>
                    <input asp-for="EndDate" type="datetime-local" required class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" />
                    <span asp-validation-for="EndDate" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div class="mb-4 flex items-center">
                <input asp-for="IsAllDay" type="checkbox" class="rounded border-slate-300 text-brand-600 shadow-sm focus:border-brand-500 focus:ring-brand-500 h-4 w-4" />
                <label class="ml-2 block text-sm font-medium text-slate-700">All Day Event</label>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-slate-700 mb-1">Color</label>
                <input asp-for="Color" type="color" class="h-10 w-20 rounded border border-slate-300 p-1" />
                <span asp-validation-for="Color" class="text-red-500 text-xs"></span>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="inline-flex justify-center rounded-lg border border-transparent bg-brand-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                    Update Event
                </button>
                <a asp-action="Index" class="inline-flex justify-center rounded-lg border border-slate-300 bg-white py-2 px-4 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
