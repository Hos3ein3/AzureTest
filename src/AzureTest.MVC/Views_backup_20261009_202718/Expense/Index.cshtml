@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Expenses.ExpenseDto>
@{
    ViewData["Title"] = "My Expenses";
    var filters = ViewBag.Filters as AzureTest.Contracts.DTOs.Expenses.GetAllExpensesFilters;
    
    string GetSortLink(string sortBy, string label)
    {
        var isCurrentSort = filters?.SortBy?.Equals(sortBy, StringComparison.OrdinalIgnoreCase) ?? (sortBy == "Date");
        var desc = isCurrentSort ? !(filters?.SortDescending ?? true) : false;
        var icon = isCurrentSort ? (filters?.SortDescending ?? true ? "fa-sort-down text-brand-600" : "fa-sort-up text-brand-600") : "fa-sort text-slate-300";
        var url = $"?PageNumber=1&PageSize={filters?.PageSize}&SearchTerm={filters?.SearchTerm}&SortBy={sortBy}&SortDescending={desc}";
        
        return $@"<a href=""{url}"" class=""group inline-flex items-center hover:text-slate-700 transition-colors"">{label} <i class=""fa-solid {icon} ml-1""></i></a>";
    }

    string GetPageUrl(int pageNumber)
    {
        return $"?PageNumber={pageNumber}&PageSize={filters?.PageSize}&SearchTerm={filters?.SearchTerm}&SortBy={filters?.SortBy}&SortDescending={filters?.SortDescending}";
    }
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800">My Expenses</h1>
    
    <div class="flex items-center space-x-4">
        <a asp-action="Analytics" class="inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg border border-slate-300 shadow-sm transition-colors">
            <i class="fa-solid fa-chart-pie mr-2 text-brand-500"></i> Analytics
        </a>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add New
        </a>
    </div>
</div>

<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-800">Filter Expenses</h3>
    </div>
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Search</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@filters?.SearchTerm" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" placeholder="Description..." />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Page Size</label>
                <select name="PageSize" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm rounded-lg">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (filters?.PageSize == size || (filters == null && size == 10))
                        {
                            <option value="@size" selected>@size items</option>
                        }
                        else
                        {
                            <option value="@size">@size items</option>
                        }
                    }
                </select>
            </div>
            
            <div class="flex items-end space-x-2 md:col-span-2">
                <button type="submit" class="inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-slate-800 hover:bg-slate-900 focus:outline-none transition-colors">
                    <i class="fa-solid fa-filter mr-2"></i> Apply
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none transition-colors" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200 flex items-start" role="alert">
        <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 mr-3"></i>
        <div class="flex-1">
            <p class="text-sm text-emerald-800 font-medium">@TempData["Success"]</p>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 focus:outline-none" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-12 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 mb-4">
            <i class="fa-solid fa-receipt text-2xl text-slate-400"></i>
        </div>
        <h3 class="text-lg font-medium text-slate-900 mb-1">No expenses found</h3>
        <p class="text-slate-500 mb-6">Get started by adding your first expense or adjust your filters.</p>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Expense
        </a>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("Date", "Date"))</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Description</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Category</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("Amount", "Amount"))</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200">
                    @foreach (var expense in Model.Items)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @expense.Date.ToString("MMM d, yyyy")
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-slate-900">@expense.Description</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @(string.IsNullOrWhiteSpace(expense.CategoryName) ? "—" : expense.CategoryName)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium text-slate-900">
                                @expense.Amount.ToString("C")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a asp-action="Edit" asp-route-id="@expense.Id" class="text-slate-600 hover:text-slate-900 mx-2" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@expense.Id" class="text-red-500 hover:text-red-700 ml-2" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="bg-white px-4 py-3 border-t border-slate-200 sm:px-6 flex items-center justify-between">
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-700">
                        Showing <span class="font-medium">@(((Model.PageNumber - 1) * Model.PageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span>
                        of <span class="font-medium">@Model.TotalCount</span> results
                    </p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                        @{
                            var prevDisabled = !Model.HasPreviousPage ? "pointer-events-none text-slate-300" : "text-slate-500 hover:bg-slate-50";
                            var nextDisabled = !Model.HasNextPage ? "pointer-events-none text-slate-300" : "text-slate-500 hover:bg-slate-50";
                        }
                        <a href="@GetPageUrl(Model.PageNumber - 1)" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium @prevDisabled">
                            <span class="sr-only">Previous</span>
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                        
                        @{
                            int window = 2; // Show 2 pages on each side of the current page
                            int startPage = Math.Max(1, Model.PageNumber - window);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + window);
                            
                            if (startPage > 1)
                            {
                                <a href="@GetPageUrl(1)" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">1</a>
                                if (startPage > 2)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700">...</span>
                                }
                            }
                            
                            for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == Model.PageNumber)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-brand-500 bg-brand-50 text-sm font-medium text-brand-600 z-10">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@GetPageUrl(i)" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">
                                        @i
                                    </a>
                                }
                            }
                            
                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700">...</span>
                                }
                                <a href="@GetPageUrl(Model.TotalPages)" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">@Model.TotalPages</a>
                            }
                        }

                        <a href="@GetPageUrl(Model.PageNumber + 1)" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium @nextDisabled">
                            <span class="sr-only">Next</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
}
