@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Debts.DebtDto, AzureTest.Contracts.DTOs.Debts.GetAllDebtsFilters>
@{
    ViewData["Title"] = "Debts";
    var filters = ViewBag.Filters as AzureTest.Contracts.DTOs.Debts.GetAllDebtsFilters ?? new();
    var debtPersons = ViewBag.DebtPersons as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var users = ViewBag.Users as IReadOnlyList<AzureTest.Contracts.DTOs.Users.UserListDto>;
    bool isAdmin = ViewBag.IsAdmin == true;
    var selectedUserIds = filters.UserIds ?? new List<Guid>();
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-brand-500/10 text-brand-600 flex items-center justify-center text-base">
                <i class="fa-solid fa-hand-holding-dollar"></i>
            </span>
            Debts Management
        </h1>
        <p class="text-sm text-slate-500 mt-1">Track financial loans, borrowings, counterparties, and settlement statuses.</p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-action="Analytics" class="inline-flex items-center px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-chart-pie mr-2 text-brand-600"></i> Analytics
        </a>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add New
        </a>
    </div>
</div>

<!-- Redesigned Filter Panel -->
<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-200/80">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-filter text-brand-500"></i> Filter & Search Debts
        </h3>
        <span class="text-xs text-slate-400">@Model.TotalCount total results</span>
    </div>
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
            <!-- Search -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Search Keyword</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@filters.SearchTerm" class="block w-full pl-9 pr-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500" placeholder="Description or Person..." />
                </div>
            </div>

            <!-- Person Dropdown -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Counterparty (Person)</label>
                <select name="DebtPersonId" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                    <option value="">-- All Persons --</option>
                    @foreach (var person in debtPersons)
                    {
                        var isSel = filters.DebtPersonId?.ToString() == person.Value;
                        <!option value="@person.Value" @(isSel ? "selected" : "")>@person.Text</!option>
                    }
                </select>
            </div>

            <!-- Status Dropdown -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Settlement Status</label>
                <select name="IsDone" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                    <option value="">-- All Statuses --</option>
                    <!option value="false" @(filters.IsDone == false ? "selected" : "")>Pending / Active</!option>
                    <!option value="true" @(filters.IsDone == true ? "selected" : "")>Settled / Done</!option>
                </select>
            </div>

            <!-- Sort By -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Sort By</label>
                <div class="grid grid-cols-2 gap-2">
                    <select name="SortBy" class="block w-full px-2 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                        <!option value="DateOfBorrow" @(string.Equals(filters.SortBy, "DateOfBorrow", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Borrow Date</!option>
                        <!option value="Amount" @(string.Equals(filters.SortBy, "Amount", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Amount</!option>
                        <!option value="DebtPersonName" @(string.Equals(filters.SortBy, "DebtPersonName", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Person</!option>
                        <!option value="DateOfReturn" @(string.Equals(filters.SortBy, "DateOfReturn", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Return Date</!option>
                        <!option value="CreatedOn" @(string.Equals(filters.SortBy, "CreatedOn", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Created On</!option>
                    </select>
                    <select name="SortDescending" class="block w-full px-2 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                        <!option value="true" @(filters.SortDescending ? "selected" : "")>Desc</!option>
                        <!option value="false" @(!filters.SortDescending ? "selected" : "")>Asc</!option>
                    </select>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
            <!-- CreatedOn From -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Created From</label>
                <input name="CreatedOnFrom" type="date" value="@(filters.CreatedOnFrom?.ToString("yyyy-MM-dd"))" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>

            <!-- CreatedOn To -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Created To</label>
                <input name="CreatedOnTo" type="date" value="@(filters.CreatedOnTo?.ToString("yyyy-MM-dd"))" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>

            <!-- Min Amount -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Min Amount</label>
                <input name="MinAmount" type="number" step="0.01" value="@filters.MinAmount" placeholder="0.00" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>

            <!-- Max Amount -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Max Amount</label>
                <input name="MaxAmount" type="number" step="0.01" value="@filters.MaxAmount" placeholder="Max" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>
        </div>

        @if (isAdmin && users != null && users.Any())
        {
            <div class="mb-4 pt-3 border-t border-slate-100">
                <label class="block text-xs font-semibold text-slate-600 mb-1">Filter by Users (Admin Multi-Select)</label>
                <div class="flex flex-wrap gap-2 max-h-24 overflow-y-auto p-2 bg-slate-50 rounded-lg border border-slate-200">
                    @foreach (var u in users)
                    {
                        var isChecked = selectedUserIds.Contains(u.Id);
                        <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer @(isChecked ? "bg-brand-100 text-brand-800 border border-brand-300" : "bg-white text-slate-700 border border-slate-200")">
                            <input type="checkbox" name="UserIds" value="@u.Id" @(isChecked ? "checked" : "") class="rounded text-brand-600 focus:ring-brand-500" />
                            <span>@u.FullName</span>
                        </label>
                    }
                </div>
            </div>
        }

        <div class="flex items-center justify-between pt-3 border-t border-slate-100">
            <div class="text-xs text-slate-500">
                Page @Model.PageNumber of @Math.Max(1, Model.TotalPages)
            </div>
            <div class="flex items-center gap-2">
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors shadow-sm">
                    <i class="fa-solid fa-rotate-left mr-1.5"></i> Reset
                </a>
                <button type="submit" class="inline-flex items-center px-5 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-brand-600 hover:bg-brand-700 transition-colors">
                    <i class="fa-solid fa-filter mr-1.5"></i> Apply Filters
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Debts Table -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-slate-500 uppercase text-xs font-semibold">
                <tr>
                    <th scope="col" class="px-6 py-3.5 text-left">Person</th>
                    <th scope="col" class="px-6 py-3.5 text-right">Amount</th>
                    <th scope="col" class="px-6 py-3.5 text-left">Borrow Date</th>
                    <th scope="col" class="px-6 py-3.5 text-left">Promised / Return</th>
                    <th scope="col" class="px-6 py-3.5 text-center">Status</th>
                    <th scope="col" class="px-6 py-3.5 text-left">Description</th>
                    <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-100">
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var isOverdue = !item.IsDone && item.PromissedReturnDate.HasValue && item.PromissedReturnDate.Value.Date < DateTime.Today;
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap font-semibold text-slate-900">
                                @item.DebtPersonName
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right font-bold text-slate-800">
                                @item.Amount.ToString("C")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                @item.DateOfBorrow.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                @if (item.IsDone)
                                {
                                    <span class="text-emerald-600 font-medium">
                                        <i class="fa-solid fa-check mr-1"></i> Returned: @(item.DateOfReturn?.ToString("MMM dd, yyyy") ?? "-")
                                    </span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="text-rose-600 font-semibold">
                                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> Due: @(item.PromissedReturnDate?.ToString("MMM dd, yyyy") ?? "-")
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Due: @(item.PromissedReturnDate?.ToString("MMM dd, yyyy") ?? "-")
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (item.IsDone)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                        Settled
                                    </span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                                        Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                                        Pending
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-slate-500 truncate max-w-xs">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-800 mx-1.5" title="Details">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-amber-600 hover:text-amber-800 mx-1.5" title="Edit">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this debt?');">
                                    <button type="submit" class="text-rose-600 hover:text-rose-800 mx-1.5 bg-transparent border-0 cursor-pointer p-0" title="Delete">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="px-6 py-12 text-center text-slate-500">
                            <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3 block"></i>
                            <p class="font-medium text-slate-700">No debts found matching your criteria.</p>
                            <p class="text-xs text-slate-400 mt-1">Try adjusting your filters or record a new debt.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <div class="bg-white px-4 py-3 border-t border-slate-200 sm:px-6 flex items-center justify-between">
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-700">
                        Showing Page <span class="font-medium">@Model.PageNumber</span> of <span class="font-medium">@Model.TotalPages</span>
                        (<span class="font-medium">@Model.TotalCount</span> total items)
                    </p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                        @{
                            var prevDisabled = !Model.HasPreviousPage ? "pointer-events-none text-slate-300" : "text-slate-500 hover:bg-slate-50";
                            var nextDisabled = !Model.HasNextPage ? "pointer-events-none text-slate-300" : "text-slate-500 hover:bg-slate-50";
                        }
                        <a asp-action="Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@filters.SearchTerm" asp-route-DebtPersonId="@filters.DebtPersonId" asp-route-IsDone="@filters.IsDone" asp-route-SortBy="@filters.SortBy" asp-route-SortDescending="@filters.SortDescending" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium @prevDisabled">
                            <span class="sr-only">Previous</span>
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageNumber)
                            {
                                <span class="relative inline-flex items-center px-4 py-2 border border-brand-500 bg-brand-50 text-sm font-bold text-brand-600 z-10">@i</span>
                            }
                            else if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <a asp-action="Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@filters.SearchTerm" asp-route-DebtPersonId="@filters.DebtPersonId" asp-route-IsDone="@filters.IsDone" asp-route-SortBy="@filters.SortBy" asp-route-SortDescending="@filters.SortDescending" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">@i</a>
                            }
                        }

                        <a asp-action="Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@filters.SearchTerm" asp-route-DebtPersonId="@filters.DebtPersonId" asp-route-IsDone="@filters.IsDone" asp-route-SortBy="@filters.SortBy" asp-route-SortDescending="@filters.SortDescending" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium @nextDisabled">
                            <span class="sr-only">Next</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>
