@model System.Collections.Generic.IReadOnlyList<AzureTest.Contracts.DTOs.Debts.DebtDto>
@{
    ViewData["Title"] = "Debts";
}

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Debts</h1>
        <p class="text-sm text-slate-500 mt-1">Manage your debts and track who owes you or whom you owe.</p>
    </div>
    <div class="flex items-center gap-4">
        <form asp-action="Index" method="get" class="flex gap-2">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" placeholder="Search..." class="rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm py-2 px-3">
            <button type="submit" class="bg-slate-100 border border-slate-300 rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-200">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </form>
        <a asp-action="Create" class="inline-flex items-center justify-center rounded-lg border border-transparent bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Debt
        </a>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="DebtPersonName" asp-route-dir="@(ViewBag.CurrentSort == "DebtPersonName" && ViewBag.CurrentDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.CurrentSearch">Person</a>
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="Amount" asp-route-dir="@(ViewBag.CurrentSort == "Amount" && ViewBag.CurrentDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.CurrentSearch">Amount</a>
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="DateOfBorrow" asp-route-dir="@(ViewBag.CurrentSort == "DateOfBorrow" && ViewBag.CurrentDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.CurrentSearch">Date of Borrow</a>
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="DateOfReturn" asp-route-dir="@(ViewBag.CurrentSort == "DateOfReturn" && ViewBag.CurrentDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.CurrentSearch">Date of Return</a>
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="Description" asp-route-dir="@(ViewBag.CurrentSort == "Description" && ViewBag.CurrentDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.CurrentSearch">Description</a>
                    </th>
                    <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">
                                @item.DebtPersonName
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @item.Amount.ToString("C")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @item.DateOfBorrow.ToShortDateString()
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @(item.DateOfReturn?.ToShortDateString() ?? "-")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 truncate max-w-xs">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this debt?');">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-900 mx-1"><i class="fa-regular fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-amber-600 hover:text-amber-900 mx-1"><i class="fa-regular fa-pen-to-square"></i></a>
                                    <button type="submit" class="text-red-600 hover:text-red-900 mx-1 bg-transparent border-0 cursor-pointer p-0"><i class="fa-regular fa-trash-can"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-slate-500 text-sm">
                            <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3 block"></i>
                            <p>No debts found. Create one to get started.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (ViewBag.TotalPages > 1)
    {
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
            <span class="text-sm text-slate-500">
                Page @ViewBag.CurrentPage of @ViewBag.TotalPages
            </span>
            <div class="flex gap-1">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-sort="@ViewBag.CurrentSort" asp-route-dir="@ViewBag.CurrentDir" asp-route-search="@ViewBag.CurrentSearch" class="px-3 py-1 border border-slate-300 rounded text-sm hover:bg-slate-100">Previous</a>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-sort="@ViewBag.CurrentSort" asp-route-dir="@ViewBag.CurrentDir" asp-route-search="@ViewBag.CurrentSearch" class="px-3 py-1 border border-slate-300 rounded text-sm hover:bg-slate-100">Next</a>
                }
            </div>
        </div>
    }
</div>
