@model AzureTest.Contracts.DTOs.Debts.DebtAnalyticsDto
@{
    ViewData["Title"] = "Debt Analytics";
    var users = ViewBag.Users as IReadOnlyList<AzureTest.Contracts.DTOs.Users.UserListDto>;
    var selectedUserIds = ViewBag.SelectedUserIds as List<Guid> ?? new List<Guid>();
    bool isAdmin = ViewBag.IsAdmin == true;
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="flex items-center space-x-2 text-sm text-slate-500">
                <li><a asp-action="Index" class="hover:text-brand-600 transition-colors">Debts</a></li>
                <li><i class="fa-solid fa-chevron-right text-xs text-slate-400"></i></li>
                <li class="font-medium text-slate-800" aria-current="page">Analytics</li>
            </ol>
        </nav>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center text-xl">
                <i class="fa-solid fa-chart-pie"></i>
            </span>
            Debt Analytics & Financial Insights
        </h1>
        <p class="text-slate-500 text-sm mt-1">Detailed breakdown of debts, counterparty analysis, status distribution, and recovery trends.</p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 shadow-sm transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Back to Debts
        </a>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> New Debt
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 mb-8">
    <form asp-action="Analytics" method="get" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
        <div class="md:col-span-3">
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">From Date</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="md:col-span-3">
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">To Date</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        @if (isAdmin && users != null && users.Any())
        {
            <div class="md:col-span-4">
                <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Filter by Users (Admin)</label>
                <select name="userIds" multiple class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 h-10">
                    @foreach (var u in users)
                    {
                        var isSel = selectedUserIds.Contains(u.Id);
                        <!option value="@u.Id" @(isSel ? "selected" : "")>@u.FullName (@u.Email)</!option>
                    }
                </select>
            </div>
        }
        <div class="md:col-span-2 flex items-center gap-2">
            <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
                <i class="fa-solid fa-filter mr-1.5"></i> Apply
            </button>
            <a asp-action="Analytics" class="inline-flex justify-center items-center px-3 py-2 border border-slate-300 rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors shadow-sm" title="Clear Filters">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </div>
    </form>
</div>

<!-- KPI Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 mb-8">
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Borrowed</span>
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <i class="fa-solid fa-hand-holding-dollar"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-slate-900 mb-1">@Model.TotalBorrowed.ToString("C")</div>
        <p class="text-xs text-slate-500">Across @Model.TotalDebtsCount total transactions</p>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Settled</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-emerald-600 mb-1">@Model.TotalReturned.ToString("C")</div>
        <p class="text-xs text-emerald-600 font-medium">@Model.SettledDebtsCount settled debts</p>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Outstanding Balance</span>
            <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-amber-600 mb-1">@Model.TotalOutstanding.ToString("C")</div>
        <p class="text-xs text-slate-500">@Model.PendingDebtsCount pending recovery</p>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Profit</span>
            <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-purple-600 mb-1">@Model.TotalProfit.ToString("C")</div>
        <p class="text-xs text-purple-600 font-medium">Yield / earnings</p>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Overdue Debts</span>
            <div class="w-9 h-9 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>
        <div class="text-2xl font-black text-rose-600 mb-1">@Model.OverdueDebtsAmount.ToString("C")</div>
        <p class="text-xs text-rose-600 font-medium">@Model.OverdueDebtsCount overdue items</p>
    </div>
</div>

<!-- Charts Section -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Top Persons Bar Chart -->
    <div class="lg:col-span-8 bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="font-bold text-slate-800 text-base">Debts by Person</h3>
                <p class="text-xs text-slate-500">Top counterparties sorted by outstanding amount</p>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-600 rounded-lg">Top 10 Persons</span>
        </div>
        <div class="h-72">
            <canvas id="personChart"></canvas>
        </div>
    </div>

    <!-- Status Distribution Doughnut -->
    <div class="lg:col-span-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
        <div class="mb-5">
            <h3 class="font-bold text-slate-800 text-base">Status Breakdown</h3>
            <p class="text-xs text-slate-500">Ratio of settled vs active vs overdue</p>
        </div>
        <div class="h-60 relative flex items-center justify-center">
            <canvas id="statusChart"></canvas>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-4 pt-3 border-t border-slate-100 text-center">
            <div>
                <span class="text-xs text-slate-400 block">Settled</span>
                <span class="text-sm font-bold text-emerald-600">@Model.SettledDebtsCount</span>
            </div>
            <div>
                <span class="text-xs text-slate-400 block">Active</span>
                <span class="text-sm font-bold text-blue-600">@(Model.PendingDebtsCount - Model.OverdueDebtsCount)</span>
            </div>
            <div>
                <span class="text-xs text-slate-400 block">Overdue</span>
                <span class="text-sm font-bold text-rose-600">@Model.OverdueDebtsCount</span>
            </div>
        </div>
    </div>
</div>

<!-- Monthly Timeline Chart -->
@if (Model.MonthlyTrend.Any())
{
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 mb-8">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="font-bold text-slate-800 text-base">Monthly Cash Flow & Return Trends</h3>
                <p class="text-xs text-slate-500">Volume borrowed versus recovered by month</p>
            </div>
        </div>
        <div class="h-64">
            <canvas id="monthlyChart"></canvas>
        </div>
    </div>
}

<!-- Detailed Breakdown Grouped By Person -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center justify-between">
        <div>
            <h3 class="font-bold text-slate-800 text-base">Counterparty Breakdown</h3>
            <p class="text-xs text-slate-500">Complete summary grouped by each individual debtor or creditor</p>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 bg-brand-50 text-brand-700 rounded-lg">@Model.PersonBreakdown.Count Counterparties</span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 uppercase text-xs font-semibold border-b border-slate-200">
                <tr>
                    <th class="px-6 py-3.5">Person</th>
                    <th class="px-6 py-3.5 text-right">Total Borrowed</th>
                    <th class="px-6 py-3.5 text-right">Settled</th>
                    <th class="px-6 py-3.5 text-right">Outstanding</th>
                    <th class="px-6 py-3.5 text-right">Profit</th>
                    <th class="px-6 py-3.5 text-center">Settlement %</th>
                    <th class="px-6 py-3.5 text-center">Status</th>
                    <th class="px-6 py-3.5 text-right">Last Activity</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
                @if (Model.PersonBreakdown.Any())
                {
                    foreach (var p in Model.PersonBreakdown)
                    {
                        var pct = p.TotalBorrowed > 0 ? (int)Math.Round((double)p.TotalReturned / (double)p.TotalBorrowed * 100) : 0;
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4 font-semibold text-slate-900 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 font-bold text-xs flex items-center justify-center">
                                    @(string.IsNullOrWhiteSpace(p.PersonName) ? "?" : p.PersonName.Substring(0, 1).ToUpper())
                                </div>
                                <span>@p.PersonName</span>
                            </td>
                            <td class="px-6 py-4 text-right font-medium text-slate-800">@p.TotalBorrowed.ToString("C")</td>
                            <td class="px-6 py-4 text-right font-medium text-emerald-600">@p.TotalReturned.ToString("C")</td>
                            <td class="px-6 py-4 text-right font-bold @(p.TotalOutstanding > 0 ? "text-amber-600" : "text-slate-400")">
                                @p.TotalOutstanding.ToString("C")
                            </td>
                            <td class="px-6 py-4 text-right font-medium text-purple-600">@p.TotalProfit.ToString("C")</td>
                            <td class="px-6 py-4 text-center">
                                <div class="w-24 mx-auto bg-slate-100 rounded-full h-2 overflow-hidden mb-1">
                                    <div class="bg-emerald-500 h-2 rounded-full" style="width: @pct%"></div>
                                </div>
                                <span class="text-xs font-semibold text-slate-500">@pct%</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (p.OverdueCount > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-700">
                                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> @p.OverdueCount Overdue
                                    </span>
                                }
                                else if (p.PendingCount > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
                                        <i class="fa-solid fa-hourglass-start mr-1"></i> @p.PendingCount Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
                                        <i class="fa-solid fa-check mr-1"></i> All Settled
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right text-xs text-slate-500">
                                @(p.LastBorrowDate?.ToString("MMM dd, yyyy") ?? "-")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-slate-400">
                            <i class="fa-solid fa-receipt text-3xl mb-2 block text-slate-300"></i>
                            No debts recorded yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Overdue Debts Alert List -->
@if (Model.OverdueDebts.Any())
{
    <div class="bg-rose-50/70 border border-rose-200 rounded-2xl p-6 mb-8">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-rose-800 flex items-center gap-2">
                <i class="fa-solid fa-bell text-rose-600"></i>
                Attention Required: Overdue Debts (@Model.OverdueDebts.Count)
            </h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var debt in Model.OverdueDebts)
            {
                <div class="bg-white rounded-xl p-4 border border-rose-200/80 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <span class="font-bold text-slate-900 text-sm">@debt.DebtPersonName</span>
                            <span class="text-sm font-black text-rose-600">@debt.Amount.ToString("C")</span>
                        </div>
                        <p class="text-xs text-slate-500 mb-2 truncate">@(string.IsNullOrWhiteSpace(debt.Description) ? "No description" : debt.Description)</p>
                    </div>
                    <div class="flex justify-between items-center pt-2 border-t border-slate-100 text-xs">
                        <span class="text-rose-600 font-semibold">
                            Due: @(debt.PromissedReturnDate?.ToString("MMM dd, yyyy") ?? "-")
                        </span>
                        <a asp-action="Details" asp-route-id="@debt.Id" class="text-brand-600 hover:text-brand-700 font-medium">View</a>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Person Breakdown Chart
            const personLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PersonBreakdown.Take(10).Select(p => p.PersonName)));
            const personBorrowed = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PersonBreakdown.Take(10).Select(p => p.TotalBorrowed)));
            const personOutstanding = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PersonBreakdown.Take(10).Select(p => p.TotalOutstanding)));

            const ctxPerson = document.getElementById('personChart')?.getContext('2d');
            if (ctxPerson) {
                new Chart(ctxPerson, {
                    type: 'bar',
                    data: {
                        labels: personLabels,
                        datasets: [
                            {
                                label: 'Outstanding Balance',
                                data: personOutstanding,
                                backgroundColor: '#f59e0b',
                                borderRadius: 6
                            },
                            {
                                label: 'Total Borrowed',
                                data: personBorrowed,
                                backgroundColor: '#94a3b8',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            x: { grid: { color: '#f1f5f9' } },
                            y: { grid: { display: false } }
                        }
                    }
                });
            }

            // Status Breakdown Donut
            const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Select(s => s.Status)));
            const statusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Select(s => s.Count)));
            const ctxStatus = document.getElementById('statusChart')?.getContext('2d');
            if (ctxStatus && statusCounts.length > 0) {
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusCounts,
                            backgroundColor: ['#10b981', '#3b82f6', '#f43f5e'],
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        },
                        cutout: '65%'
                    }
                });
            }

            // Monthly Trend Chart
            const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.MonthLabel)));
            const monthBorrowed = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.BorrowedAmount)));
            const monthReturned = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.ReturnedAmount)));

            const ctxMonthly = document.getElementById('monthlyChart')?.getContext('2d');
            if (ctxMonthly && monthLabels.length > 0) {
                new Chart(ctxMonthly, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            {
                                label: 'Borrowed / Lent',
                                data: monthBorrowed,
                                backgroundColor: '#3b82f6',
                                borderRadius: 6
                            },
                            {
                                label: 'Settled / Recovered',
                                data: monthReturned,
                                backgroundColor: '#10b981',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: { grid: { color: '#f1f5f9' } }
                        }
                    }
                });
            }
        });
    </script>
}
