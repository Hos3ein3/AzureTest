@model AzureTest.Application.FootballFantasy.Commands.CreatePlayerMatchStatCommand
@{
    ViewData["Title"] = "Record Match Stats";
    var players = ViewBag.Players as List<AzureTest.Contracts.DTOs.FootballFantasy.PlayerDto>;
    var teams = ViewBag.Teams as List<AzureTest.Contracts.DTOs.FootballFantasy.TeamDto>;
    var fixtures = ViewBag.Fixtures as List<AzureTest.Contracts.DTOs.FootballFantasy.FixtureDto>;
}

<div class="max-w-3xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Match Stats</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">New</span>
    </div>
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Record Player Match Performance</h1>
</div>

<div class="max-w-3xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label asp-for="FixtureId" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Fixture</label>
                <select asp-for="FixtureId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required>
                    <option value="">Select Fixture</option>
                    @if (fixtures != null)
                    {
                        foreach (var f in fixtures)
                        {
                            <option value="@f.Id">@f.HomeTeamName vs @f.AwayTeamName (@f.KickoffAt.ToString("MM/dd"))</option>
                        }
                    }
                </select>
                <span asp-validation-for="FixtureId" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="PlayerId" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Player</label>
                <select asp-for="PlayerId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required>
                    <option value="">Select Player</option>
                    @if (players != null)
                    {
                        foreach (var p in players)
                        {
                            <option value="@p.Id">@p.DisplayName (@p.Position)</option>
                        }
                    }
                </select>
                <span asp-validation-for="PlayerId" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="TeamId" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Team</label>
                <select asp-for="TeamId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required>
                    <option value="">Select Team</option>
                    @if (teams != null)
                    {
                        foreach (var t in teams)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="TeamId" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-3 border-t border-slate-100 dark:border-slate-700">
            <div>
                <label asp-for="MinutesPlayed" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Minutes</label>
                <input asp-for="MinutesPlayed" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
            </div>
            <div>
                <label asp-for="Goals" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Goals</label>
                <input asp-for="Goals" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="Assists" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Assists</label>
                <input asp-for="Assists" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="YellowCards" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Yellow Cards</label>
                <input asp-for="YellowCards" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div>
                <label asp-for="RedCards" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Red Cards</label>
                <input asp-for="RedCards" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="OwnGoals" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Own Goals</label>
                <input asp-for="OwnGoals" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="PenaltiesSaved" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Pen Saved</label>
                <input asp-for="PenaltiesSaved" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="PenaltiesMissed" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Pen Missed</label>
                <input asp-for="PenaltiesMissed" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
        </div>

        <div class="flex items-center space-x-6 pt-3">
            <div class="flex items-center space-x-2">
                <input type="checkbox" asp-for="CleanSheet" id="CleanSheet" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                <label for="CleanSheet" class="text-sm font-medium text-slate-700 dark:text-slate-300">Clean Sheet</label>
            </div>
            <div class="flex items-center space-x-2">
                <input type="checkbox" asp-for="IsStarter" id="IsStarter" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                <label for="IsStarter" class="text-sm font-medium text-slate-700 dark:text-slate-300">Match Starter</label>
            </div>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-700">
            <a asp-action="Index" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-800">Cancel</a>
            <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm">Save Match Stats</button>
        </div>
    </form>
</div>
