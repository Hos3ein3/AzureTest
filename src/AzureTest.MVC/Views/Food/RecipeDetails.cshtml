@model AzureTest.Contracts.DTOs.Food.RecipeDto
@{
    ViewData["Title"] = Model.Name;
    var scaling = ViewBag.Scaling as AzureTest.Contracts.DTOs.Food.ChefScalingResultDto;
    double currentServings = (double)(ViewBag.SelectedServings ?? Model.Servings);

    // Pick scaled or original values
    var ingredients = scaling != null ? scaling.ScaledIngredients : Model.Ingredients;
    double totalCalories = scaling != null ? scaling.ScaledCalories : Model.TotalCalories;
    double totalProtein = scaling != null ? scaling.ScaledProtein : Model.TotalProtein;
    double totalCarbs = scaling != null ? scaling.ScaledCarbs : Model.TotalCarbs;
    double totalFat = scaling != null ? scaling.ScaledFat : Model.TotalFat;
    double rawWeight = scaling != null ? scaling.ScaledRawWeightGrams : Model.RawWeightGrams;
    double cookedWeight = scaling != null ? scaling.ScaledCookedWeightGrams : Model.CookedWeightGrams;

    double perServingCal = currentServings > 0 ? Math.Round(totalCalories / currentServings, 1) : totalCalories;
    double perServingPro = currentServings > 0 ? Math.Round(totalProtein / currentServings, 1) : totalProtein;
    double perServingCarb = currentServings > 0 ? Math.Round(totalCarbs / currentServings, 1) : totalCarbs;
    double perServingFat = currentServings > 0 ? Math.Round(totalFat / currentServings, 1) : totalFat;
    double perServingWeight = currentServings > 0 ? Math.Round(cookedWeight / currentServings, 1) : cookedWeight;

    var diffBadge = Model.Difficulty switch
    {
        AzureTest.Domain.Documents.Food.Enums.RecipeDifficulty.Easy => "bg-emerald-100 text-emerald-800",
        AzureTest.Domain.Documents.Food.Enums.RecipeDifficulty.Medium => "bg-amber-100 text-amber-800",
        AzureTest.Domain.Documents.Food.Enums.RecipeDifficulty.Hard => "bg-rose-100 text-rose-800",
        _ => "bg-purple-100 text-purple-800"
    };
    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Food & Nutrition", Url.Action("Index")),
        new("Recipes", Url.Action("Recipes")),
        new(Model.Name, IsActive: true)
    };
}

<div class="mb-4">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
</div>

<!-- Top Header Navigation -->
<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <a href="@Url.Action("Recipes")" class="p-2.5 rounded-xl border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors shadow-2xs">
            <i class="fa-solid fa-arrow-left text-xs"></i>
        </a>
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-3xs font-bold @diffBadge">@Model.Difficulty</span>
                <span class="text-xs font-semibold text-slate-500">@Model.Category</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">@Model.Name</h1>
        </div>
    </div>

    <!-- Quick Action Bar -->
    <div class="flex flex-wrap items-center gap-2">
        <form asp-action="AddRecipeToShoppingList" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="recipeId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <button type="submit" class="inline-flex items-center px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 shadow-2xs transition-colors">
                <i class="fa-solid fa-cart-plus mr-1.5 text-slate-400"></i> All Ingredients to List
            </button>
        </form>

        <form asp-action="AddMissingRecipeIngredients" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="recipeId" value="@Model.Id" />
            <input type="hidden" name="servings" value="@Model.Servings" />
            <button type="submit" class="inline-flex items-center px-3.5 py-2.5 rounded-xl border border-brand-200 bg-brand-50 hover:bg-brand-100 text-xs font-semibold text-brand-700 shadow-2xs transition-colors" title="Check pantry stock and add only missing ingredients">
                <i class="fa-solid fa-cart-shopping mr-1.5 text-brand-600"></i> Add Missing Only
            </button>
        </form>

        <button type="button" onclick="openLogModalFromRecipe()" class="inline-flex items-center px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-1.5"></i> Log to Today's Diary
        </button>

        <a href="@Url.Action("EditRecipe", new { id = Model.Id })" class="p-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-600 transition-colors shadow-2xs" title="Edit Recipe">
            <i class="fa-regular fa-pen-to-square"></i>
        </a>
    </div>
</div>

<!-- Chef Scaling Bar -->
<div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 rounded-2xl p-4 sm:p-5 mb-8 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold shadow-xs">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div>
                <h3 class="text-sm font-bold text-amber-950">Chef Batch Scaling Multiplier</h3>
                <p class="text-xs text-amber-800/80">Dynamically adjust servings. All ingredient quantities and macros scale automatically.</p>
            </div>
        </div>

        <!-- Serving Multiplier Buttons & Input -->
        <div class="flex items-center gap-2">
            <a href="@Url.Action("RecipeDetails", new { id = Model.Id, servings = 0.5 * Model.Servings })" class="px-3 py-1.5 rounded-lg border border-amber-300 bg-white text-xs font-bold text-amber-900 hover:bg-amber-100/50 transition-colors @(currentServings == 0.5 * Model.Servings ? "ring-2 ring-amber-500 bg-amber-100" : "")">
                0.5x
            </a>
            <a href="@Url.Action("RecipeDetails", new { id = Model.Id, servings = Model.Servings })" class="px-3 py-1.5 rounded-lg border border-amber-300 bg-white text-xs font-bold text-amber-900 hover:bg-amber-100/50 transition-colors @(currentServings == Model.Servings ? "ring-2 ring-amber-500 bg-amber-100" : "")">
                1x (@Model.Servings)
            </a>
            <a href="@Url.Action("RecipeDetails", new { id = Model.Id, servings = 2.0 * Model.Servings })" class="px-3 py-1.5 rounded-lg border border-amber-300 bg-white text-xs font-bold text-amber-900 hover:bg-amber-100/50 transition-colors @(currentServings == 2.0 * Model.Servings ? "ring-2 ring-amber-500 bg-amber-100" : "")">
                2x
            </a>
            <a href="@Url.Action("RecipeDetails", new { id = Model.Id, servings = 4.0 * Model.Servings })" class="px-3 py-1.5 rounded-lg border border-amber-300 bg-white text-xs font-bold text-amber-900 hover:bg-amber-100/50 transition-colors @(currentServings == 4.0 * Model.Servings ? "ring-2 ring-amber-500 bg-amber-100" : "")">
                4x
            </a>

            <form asp-action="RecipeDetails" method="get" class="flex items-center ml-2">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="number" step="0.5" min="0.5" max="100" name="servings" value="@currentServings" class="w-16 px-2 py-1.5 text-center text-xs font-bold rounded-l-lg border border-amber-300 bg-white text-slate-800 focus:outline-none focus:ring-1 focus:ring-amber-500" />
                <button type="submit" class="px-2.5 py-1.5 text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white rounded-r-lg shadow-2xs transition-colors">
                    Scale
                </button>
            </form>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    <!-- Left Column: Ingredients & Steps -->
    <div class="lg:col-span-8 space-y-8">
        <!-- Ingredients Section -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-slate-800 text-base">Ingredients List</h3>
                    <p class="text-xs text-slate-500">Scaled for @currentServings @(currentServings == 1 ? "serving" : "servings")</p>
                </div>
                <span class="text-xs font-bold text-slate-500">@ingredients.Count items</span>
            </div>

            <div class="divide-y divide-slate-100">
                @foreach (var ing in ingredients)
                {
                    <div class="p-4 flex items-start justify-between gap-4 hover:bg-slate-50/60 transition-colors">
                        <div>
                            <span class="font-bold text-slate-900 text-sm">@ing.IngredientName</span>
                            @if (!string.IsNullOrWhiteSpace(ing.Notes))
                            {
                                <span class="text-xs text-slate-500 italic block">Note: @ing.Notes</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ing.SubstitutionNote))
                            {
                                <span class="inline-flex items-center text-3xs font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded mt-1">
                                    <i class="fa-solid fa-shuffle mr-1"></i> Sub: @ing.SubstitutionNote
                                </span>
                            }
                        </div>

                        <div class="text-right">
                            <span class="font-mono font-black text-slate-900 text-sm">@ing.Quantity @ing.Unit</span>
                            <span class="block text-3xs text-slate-400 font-mono">(@ing.ComputedGrams g &bull; @ing.Calories kcal)</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Cooking Steps with Interactive Timers -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-slate-800 text-base">Step-by-Step Cooking Instructions</h3>
                    <p class="text-xs text-slate-500">Includes active step timers and chef culinary tips</p>
                </div>
                <span class="text-xs font-bold text-slate-500">@Model.Steps.Count steps</span>
            </div>

            <div class="p-6 space-y-6">
                @if (Model.Steps.Any())
                {
                    foreach (var step in Model.Steps.OrderBy(s => s.StepNumber))
                    {
                        <div class="flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-brand-50 text-brand-600 border border-brand-200 flex-shrink-0 flex items-center justify-center font-bold text-sm">
                                @step.StepNumber
                            </div>

                            <div class="flex-1 space-y-2">
                                <p class="text-sm text-slate-800 font-medium leading-relaxed">@step.Instruction</p>

                                @if (!string.IsNullOrWhiteSpace(step.ChefTip))
                                {
                                    <div class="p-3 rounded-xl bg-amber-50/80 border border-amber-200 text-xs text-amber-900 flex items-start gap-2">
                                        <i class="fa-solid fa-lightbulb text-amber-500 mt-0.5"></i>
                                        <div><strong class="font-bold">Chef Tip:</strong> @step.ChefTip</div>
                                    </div>
                                }

                                @if (step.TimerMinutes.HasValue && step.TimerMinutes.Value > 0)
                                {
                                    <div class="inline-flex items-center gap-3 p-2 rounded-xl bg-slate-100/80 border border-slate-200" id="timerBox-@step.StepNumber">
                                        <div class="text-xs font-mono font-bold text-slate-700" id="timerDisplay-@step.StepNumber">
                                            @step.TimerMinutes:00
                                        </div>
                                        <button type="button" onclick="startTimer(@step.StepNumber, @step.TimerMinutes.Value * 60)" id="btnStart-@step.StepNumber" class="px-2.5 py-1 text-2xs font-bold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors">
                                            <i class="fa-solid fa-play mr-1"></i> Start
                                        </button>
                                        <button type="button" onclick="pauseTimer(@step.StepNumber)" id="btnPause-@step.StepNumber" class="hidden px-2.5 py-1 text-2xs font-bold rounded-lg bg-amber-600 text-white hover:bg-amber-700 transition-colors">
                                            <i class="fa-solid fa-pause mr-1"></i> Pause
                                        </button>
                                        <button type="button" onclick="resetTimer(@step.StepNumber, @step.TimerMinutes.Value * 60)" class="px-2 py-1 text-2xs font-semibold text-slate-600 hover:text-slate-800">
                                            Reset
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400">No steps listed for this recipe.</p>
                }
            </div>
        </div>

        <!-- Cooking Physics & Estimation Limits Card -->
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-6 sm:p-7 shadow-sm">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-white/10 text-brand-400 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-flask-vial"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-white">Culinary Science & Cooking Yield</h3>
                    <p class="text-xs text-slate-400">Understanding raw vs. cooked nutritional dynamics</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5 text-center">
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <span class="block text-3xs uppercase font-bold text-slate-400">Raw Weight (Ingredients)</span>
                    <span class="text-lg font-black text-white font-mono">@rawWeight g</span>
                </div>
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <span class="block text-3xs uppercase font-bold text-slate-400">Yield Factor</span>
                    <span class="text-lg font-black text-brand-400 font-mono">x@Model.CookingYieldFactor</span>
                </div>
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <span class="block text-3xs uppercase font-bold text-slate-400">Cooked Finished Weight</span>
                    <span class="text-lg font-black text-white font-mono">@cookedWeight g</span>
                </div>
            </div>

            <div class="space-y-2 text-xs text-slate-300 leading-relaxed">
                <p>
                    <strong class="text-white">Water Loss vs Water Gain:</strong> Cooking does not alter the fundamental calorie or protein content of raw meat; instead, moisture evaporates (yield factor ~0.75), concentrating the protein and calories per 100 grams of cooked meat. Conversely, dry pasta and grains absorb water (yield factor ~2.2), diluting the nutrition per 100 grams of cooked grain.
                </p>
                <p>
                    <strong class="text-white">Oil Absorption:</strong> When sautéing or pan-frying, a portion of the cooking oil remains in the pan or is blotted away. Our model counts 100% of ingredient oil unless modified.
                </p>
                <p class="text-slate-400 text-2xs italic pt-2 border-t border-white/10">
                    <strong class="text-slate-300">Estimation Boundaries:</strong> Nutritional numbers represent scientifically backed approximations. Biological variation in agricultural produce, meat fat trimming, cooking duration, lid retention, and plate residuals mean actual consumption may vary by approximately &plusmn;5-10%.
                </p>
            </div>
        </div>
    </div>

    <!-- Right Column: Nutritional Breakdown Cards -->
    <div class="lg:col-span-4 space-y-6">
        <!-- Nutrition Per Serving Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Nutritional Facts</span>
            <h3 class="text-xl font-black text-slate-900 mt-1">Per Serving</h3>
            <p class="text-xs text-slate-400 mb-6">Based on @perServingWeight g cooked portion</p>

            <div class="space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <span class="text-sm font-bold text-slate-700">Calories</span>
                    <span class="text-2xl font-black text-slate-900 font-mono">@perServingCal kcal</span>
                </div>

                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
                        <span class="text-xs font-semibold text-slate-700">Protein</span>
                    </div>
                    <span class="text-sm font-black text-slate-900 font-mono">@perServingPro g</span>
                </div>

                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <span class="text-xs font-semibold text-slate-700">Carbohydrates</span>
                    </div>
                    <span class="text-sm font-black text-slate-900 font-mono">@perServingCarb g</span>
                </div>

                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                        <span class="text-xs font-semibold text-slate-700">Fat</span>
                    </div>
                    <span class="text-sm font-black text-slate-900 font-mono">@perServingFat g</span>
                </div>

                <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                    <span class="text-xs text-slate-500 pl-4.5">Dietary Fiber</span>
                    <span class="text-xs font-bold text-slate-700 font-mono">@Model.PerServingFiber.ToString("0.#") g</span>
                </div>
            </div>
        </div>

        <!-- Nutrition Per 100g Cooked Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Cooked Density</span>
            <h3 class="text-lg font-black text-slate-900 mt-1">Per 100g Cooked</h3>
            <p class="text-xs text-slate-400 mb-4">Standardized measure for meal prep scale</p>

            <div class="grid grid-cols-2 gap-3 text-center">
                <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                    <span class="block text-3xs uppercase font-bold text-slate-400">Calories</span>
                    <span class="text-base font-black text-slate-900 font-mono">@Model.Per100gCookedCalories</span>
                </div>
                <div class="p-3 rounded-xl bg-blue-50/70 border border-blue-100">
                    <span class="block text-3xs uppercase font-bold text-blue-600">Protein</span>
                    <span class="text-base font-black text-blue-700 font-mono">@Model.Per100gCookedProtein g</span>
                </div>
                <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-100">
                    <span class="block text-3xs uppercase font-bold text-amber-600">Carbs</span>
                    <span class="text-base font-black text-amber-700 font-mono">@Model.Per100gCookedCarbs g</span>
                </div>
                <div class="p-3 rounded-xl bg-rose-50/70 border border-rose-100">
                    <span class="block text-3xs uppercase font-bold text-rose-600">Fat</span>
                    <span class="text-base font-black text-rose-700 font-mono">@Model.Per100gCookedFat g</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Log to Diary from Recipe -->
<div id="recipeLogModal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl relative">
        <button type="button" onclick="closeRecipeLogModal()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>

        <h3 class="text-xl font-black text-slate-900 mb-1">Log @Model.Name</h3>
        <p class="text-xs text-slate-500 mb-4">Choose date, meal type, and servings portion.</p>

        <form asp-action="LogItem" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IsRecipe" value="true" />
            <input type="hidden" name="ReferenceId" value="@Model.Id" />
            <input type="hidden" name="Unit" value="serving" />

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Date</label>
                <input type="date" name="Date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Meal Occasion</label>
                <select name="MealType" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                    @foreach (AzureTest.Domain.Documents.Food.Enums.MealType mt in Enum.GetValues(typeof(AzureTest.Domain.Documents.Food.Enums.MealType)))
                    {
                        <option value="@mt">@mt</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Servings Consumed</label>
                <input type="number" step="0.25" min="0.1" name="Quantity" value="1" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
            </div>

            <div class="pt-3 flex items-center justify-end gap-3">
                <button type="button" onclick="closeRecipeLogModal()" class="px-4 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white shadow-sm">Save to Diary</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openLogModalFromRecipe() {
        document.getElementById('recipeLogModal').classList.remove('hidden');
    }
    function closeRecipeLogModal() {
        document.getElementById('recipeLogModal').classList.add('hidden');
    }

    // Step Timers
    const activeTimers = {};

    function startTimer(stepNum, totalSeconds) {
        if (!activeTimers[stepNum]) {
            activeTimers[stepNum] = { remaining: totalSeconds, interval: null };
        }

        document.getElementById('btnStart-' + stepNum).classList.add('hidden');
        document.getElementById('btnPause-' + stepNum).classList.remove('hidden');

        activeTimers[stepNum].interval = setInterval(function () {
            activeTimers[stepNum].remaining--;
            const rem = activeTimers[stepNum].remaining;
            if (rem <= 0) {
                clearInterval(activeTimers[stepNum].interval);
                document.getElementById('timerDisplay-' + stepNum).innerText = "DONE!";
                document.getElementById('timerBox-' + stepNum).classList.add('bg-emerald-100', 'border-emerald-300');
                document.getElementById('btnPause-' + stepNum).classList.add('hidden');
                document.getElementById('btnStart-' + stepNum).classList.remove('hidden');
                alert("Step " + stepNum + " timer is complete!");
            } else {
                const m = Math.floor(rem / 60);
                const s = rem % 60;
                document.getElementById('timerDisplay-' + stepNum).innerText = m + ":" + (s < 10 ? "0" : "") + s;
            }
        }, 1000);
    }

    function pauseTimer(stepNum) {
        if (activeTimers[stepNum] && activeTimers[stepNum].interval) {
            clearInterval(activeTimers[stepNum].interval);
            document.getElementById('btnPause-' + stepNum).classList.add('hidden');
            document.getElementById('btnStart-' + stepNum).classList.remove('hidden');
        }
    }

    function resetTimer(stepNum, totalSeconds) {
        if (activeTimers[stepNum] && activeTimers[stepNum].interval) {
            clearInterval(activeTimers[stepNum].interval);
        }
        activeTimers[stepNum] = { remaining: totalSeconds, interval: null };
        const m = Math.floor(totalSeconds / 60);
        const s = totalSeconds % 60;
        document.getElementById('timerDisplay-' + stepNum).innerText = m + ":" + (s < 10 ? "0" : "") + s;
        document.getElementById('btnPause-' + stepNum).classList.add('hidden');
        document.getElementById('btnStart-' + stepNum).classList.remove('hidden');
        document.getElementById('timerBox-' + stepNum).classList.remove('bg-emerald-100', 'border-emerald-300');
    }
</script>
}
