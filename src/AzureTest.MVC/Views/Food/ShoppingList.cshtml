@using AzureTest.Contracts.DTOs.Common
@using AzureTest.Contracts.DTOs.Food
@using AzureTest.Domain.Documents.Food.Enums
@model ShoppingListGroupedDto
@{
    ViewData["Title"] = "Smart Shopping List";
    var filter = ViewBag.Filter as ShoppingListFilter ?? new ShoppingListFilter();
    var ingredients = ViewBag.IngredientsList as List<IngredientDto> ?? new List<IngredientDto>();
}

<div class="space-y-6">
    <!-- Breadcrumbs & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-400 mb-1">
                <a asp-action="Index" class="hover:text-brand-600 transition-colors">Food & Nutrition</a>
                <i class="fa-solid fa-chevron-right text-3xs"></i>
                <a asp-action="Stock" class="hover:text-brand-600 transition-colors">Pantry & Stock</a>
                <i class="fa-solid fa-chevron-right text-3xs"></i>
                <span class="text-slate-600 font-semibold">Shopping List</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                <i class="fa-solid fa-cart-shopping text-brand-600"></i>
                Smart Grocery Shopping List
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Aisle-organized shopping list auto-generated from low pantry stock and upcoming meal plans.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="openAutoGenerateModal()" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-brand-200 bg-brand-50 text-xs font-semibold text-brand-700 hover:bg-brand-100 transition-colors shadow-2xs">
                <i class="fa-solid fa-wand-magic-sparkles text-brand-600"></i>
                Auto-Generate List
            </button>
            <button type="button" onclick="openFinishShoppingModal()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 text-xs font-semibold text-white hover:bg-emerald-700 shadow-sm transition-colors @(Model != null && (Model.InCartCount > 0 || Model.BoughtCount > 0) ? "" : "opacity-60")">
                <i class="fa-solid fa-check-double"></i>
                Finish Shopping (@(Model?.InCartCount + Model?.BoughtCount ?? 0))
            </button>
            <button type="button" onclick="openAddShoppingModal()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 text-xs font-semibold text-white hover:bg-brand-700 shadow-sm transition-colors">
                <i class="fa-solid fa-plus"></i>
                Add Item
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center gap-3 text-emerald-800 text-xs font-medium">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-3.5 bg-rose-50 border border-rose-200 rounded-xl flex items-center gap-3 text-rose-800 text-xs font-medium">
            <i class="fa-solid fa-circle-exclamation text-rose-600"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Real-Time Multi-User Sync Banner -->
    <div class="bg-white rounded-2xl border border-slate-100 p-4 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="relative flex items-center justify-center">
                <span class="relative flex h-3.5 w-3.5">
                    <span id="syncPulse" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span id="syncDot" class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500"></span>
                </span>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-black text-slate-800">Multi-User Real-Time Sync</span>
                    <span id="syncStatusBadge" class="text-3xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">Live & Connected</span>
                    <span class="text-3xs text-slate-400">Registered Users</span>
                </div>
                <p class="text-2xs text-slate-400 mt-0.5">Checked items, additions, and edits sync instantly across all active registered users on this shopping list.</p>
            </div>
        </div>

        <!-- Active Registered Users Presence Bar -->
        <div class="flex items-center gap-2">
            <span class="text-2xs font-semibold text-slate-400 mr-1"><i class="fa-solid fa-users text-3xs mr-1"></i>Online:</span>
            <div id="activeUsersContainer" class="flex items-center gap-1.5 flex-wrap">
                <span class="text-2xs font-semibold px-2.5 py-1 rounded-xl bg-brand-50 text-brand-700 border border-brand-200">
                    <i class="fa-solid fa-user text-3xs mr-1"></i> You
                </span>
            </div>
        </div>
    </div>

    <!-- Floating Live Toast Notifications Container -->
    <div id="shoppingToastContainer" class="fixed top-20 right-6 z-50 flex flex-col gap-2 pointer-events-none max-w-sm"></div>

    <!-- KPI Summary Cards -->
    @if (Model != null)
    {
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3.5">
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-slate-400 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Total Items</span>
                    <i class="fa-solid fa-list-check text-slate-300"></i>
                </div>
                <div id="kpi-total-items" class="text-2xl font-black text-slate-900">@Model.TotalItems</div>
                <span class="text-3xs text-slate-400">Total items on list</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-brand-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">To Buy</span>
                    <i class="fa-solid fa-bag-shopping"></i>
                </div>
                <div id="kpi-to-buy-count" class="text-2xl font-black text-brand-600">@Model.ToBuyCount</div>
                <span class="text-3xs text-slate-400">Still needed</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-amber-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">In Cart</span>
                    <i class="fa-solid fa-cart-shopping"></i>
                </div>
                <div id="kpi-in-cart-count" class="text-2xl font-black text-amber-600">@Model.InCartCount</div>
                <span class="text-3xs text-slate-400">Checked in store</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-emerald-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Bought</span>
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div id="kpi-bought-count" class="text-2xl font-black text-emerald-600">@Model.BoughtCount</div>
                <span class="text-3xs text-slate-400">Ready to stock</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-slate-400 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Est. Cost</span>
                    <i class="fa-solid fa-tag text-slate-300"></i>
                </div>
                <div class="text-2xl font-black text-slate-900">$@Model.EstimatedTotalCost.ToString("N2")</div>
                <span class="text-3xs text-slate-400">Estimated shopping trip</span>
            </div>
        </div>
    }

    <!-- Store Section Filter Tabs -->
    <div class="bg-white p-3 rounded-2xl border border-slate-100 shadow-2xs">
        <div class="flex flex-wrap items-center gap-1.5 overflow-x-auto">
            <a asp-action="ShoppingList" asp-route-storeSection="" asp-route-status="@filter.Status" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-colors @(!filter.StoreSection.HasValue ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                <i class="fa-solid fa-border-all mr-1"></i> All Aisles
            </a>
            @foreach (StoreSection sec in Enum.GetValues(typeof(StoreSection)))
            {
                var iconClass = sec switch
                {
                    StoreSection.Produce => "fa-carrot text-emerald-500",
                    StoreSection.MeatAndSeafood => "fa-drumstick-bite text-rose-500",
                    StoreSection.DairyAndEggs => "fa-egg text-amber-500",
                    StoreSection.Bakery => "fa-bread-slice text-amber-600",
                    StoreSection.PantryAndDryGoods => "fa-box-archive text-indigo-500",
                    StoreSection.Frozen => "fa-snowflake text-blue-500",
                    StoreSection.SpicesAndOils => "fa-pepper-hot text-purple-500",
                    StoreSection.Beverages => "fa-bottle-water text-cyan-500",
                    StoreSection.Snacks => "fa-cookie-bite text-orange-500",
                    _ => "fa-cart-shopping text-slate-400"
                };

                <a asp-action="ShoppingList" asp-route-storeSection="@sec" asp-route-status="@filter.Status" class="px-3 py-1.5 rounded-xl text-xs font-bold transition-colors @(filter.StoreSection == sec ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    <i class="fa-solid @iconClass mr-1"></i> @sec
                </a>
            }
        </div>
    </div>

    <!-- Grouped Sections List -->
    @if (Model != null && Model.Sections.Any())
    {
        <div class="space-y-6">
            @foreach (var group in Model.Sections)
            {
                var sectionTitle = group.Key.ToString();
                var sectionIcon = group.Key switch
                {
                    StoreSection.Produce => "fa-carrot text-emerald-500",
                    StoreSection.MeatAndSeafood => "fa-drumstick-bite text-rose-500",
                    StoreSection.DairyAndEggs => "fa-egg text-amber-500",
                    StoreSection.Bakery => "fa-bread-slice text-amber-600",
                    StoreSection.PantryAndDryGoods => "fa-box-archive text-indigo-500",
                    StoreSection.Frozen => "fa-snowflake text-blue-500",
                    StoreSection.SpicesAndOils => "fa-pepper-hot text-purple-500",
                    StoreSection.Beverages => "fa-bottle-water text-cyan-500",
                    StoreSection.Snacks => "fa-cookie-bite text-orange-500",
                    _ => "fa-cart-shopping text-slate-400"
                };

                <div class="bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden">
                    <div class="py-3 px-5 bg-slate-50/80 border-b border-slate-100 flex items-center justify-between">
                        <h2 class="text-xs font-black text-slate-800 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid @sectionIcon"></i>
                            @sectionTitle
                        </h2>
                        <span class="text-3xs font-bold px-2 py-0.5 rounded-full bg-slate-200 text-slate-600">
                            @group.Value.Count items
                        </span>
                    </div>

                    <div class="divide-y divide-slate-100">
                        @foreach (var item in group.Value)
                        {
                            var isChecked = item.Status == ShoppingItemStatus.InCart || item.Status == ShoppingItemStatus.Bought;
                            var nextStatus = item.Status switch
                            {
                                ShoppingItemStatus.ToBuy => ShoppingItemStatus.InCart,
                                ShoppingItemStatus.InCart => ShoppingItemStatus.Bought,
                                ShoppingItemStatus.Bought => ShoppingItemStatus.ToBuy,
                                _ => ShoppingItemStatus.ToBuy
                            };

                            <div id="shopping-item-@item.Id" data-item-id="@item.Id" data-status="@item.Status" data-name="@item.Name"
                                 class="shopping-item-row p-3.5 sm:px-5 flex items-center justify-between gap-3 hover:bg-slate-50/60 transition-all duration-300 @(isChecked ? "bg-slate-50/40" : "")">
                                <div class="flex items-center gap-3 min-w-0">
                                    <!-- Interactive Checkbox Status Button -->
                                    <button type="button" onclick="toggleStatusAjax('@item.Id', '@nextStatus', '@item.Name')" 
                                            class="status-toggle-btn w-6 h-6 rounded-lg border flex items-center justify-center transition-all cursor-pointer @(item.Status == ShoppingItemStatus.Bought ? "bg-emerald-600 border-emerald-600 text-white" : item.Status == ShoppingItemStatus.InCart ? "bg-amber-500 border-amber-500 text-white" : "border-slate-300 text-transparent hover:border-brand-500")">
                                        <i class="status-icon fa-solid @(item.Status == ShoppingItemStatus.Bought ? "fa-check-double text-2xs" : "fa-check text-2xs")"></i>
                                    </button>

                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="item-name-text font-bold text-xs @(isChecked ? "line-through text-slate-400" : "text-slate-900")">
                                                @item.Name
                                            </span>
                                            
                                            <!-- Source Badge -->
                                            @{
                                                var sourceBadge = item.Source switch
                                                {
                                                    ShoppingItemSource.LowStockParLevel => "bg-amber-50 text-amber-700 border-amber-200",
                                                    ShoppingItemSource.MealPlan => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                                    ShoppingItemSource.RecipeMissing => "bg-blue-50 text-blue-700 border-blue-200",
                                                    _ => "bg-slate-50 text-slate-600 border-slate-200"
                                                };
                                            }
                                            <span class="text-3xs font-semibold px-1.5 py-0.5 rounded-md border @sourceBadge">
                                                @item.Source
                                            </span>

                                            <!-- Multi-User Sync Attribution Badge -->
                                            @if (!string.IsNullOrWhiteSpace(item.LastModifiedByUserName))
                                            {
                                                <span class="item-user-tag text-3xs text-slate-400 flex items-center gap-1">
                                                    <i class="fa-solid fa-user-pen text-3xs text-slate-300"></i> @item.LastModifiedByUserName
                                                </span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(item.CreatedByUserName))
                                            {
                                                <span class="item-user-tag text-3xs text-slate-400 flex items-center gap-1">
                                                    <i class="fa-solid fa-user-plus text-3xs text-slate-300"></i> @item.CreatedByUserName
                                                </span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <p class="text-3xs text-slate-400 mt-0.5 truncate">@item.Notes</p>
                                        }
                                    </div>
                                </div>

                                <div class="flex items-center gap-4 shrink-0">
                                    <div class="text-right">
                                        <div class="font-mono font-bold text-xs text-slate-800">
                                            @item.Quantity @item.Unit
                                        </div>
                                        @if (item.EstimatedCost.HasValue)
                                        {
                                            <div class="text-3xs text-slate-400 font-mono">
                                                ~$@item.EstimatedCost.Value.ToString("N2")
                                            </div>
                                        }
                                    </div>

                                    <!-- Delete Item -->
                                    <form asp-action="RemoveShoppingItem" method="post" class="inline" onsubmit="return confirm('Remove @item.Name from shopping list?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors bg-transparent border-0 cursor-pointer" title="Delete">
                                            <i class="fa-solid fa-trash-can text-2xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center shadow-2xs">
            <i class="fa-solid fa-basket-shopping text-4xl text-slate-300 mb-3 block"></i>
            <h3 class="text-base font-bold text-slate-800">Your shopping list is clear!</h3>
            <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">Click "Auto-Generate List" to detect low pantry items and meal plan requirements automatically, or add items manually.</p>
            <div class="mt-4 flex items-center justify-center gap-2">
                <button type="button" onclick="openAutoGenerateModal()" class="px-4 py-2 rounded-xl bg-brand-600 text-xs font-semibold text-white hover:bg-brand-700 shadow-sm transition-colors">
                    <i class="fa-solid fa-wand-magic-sparkles mr-1.5"></i> Auto-Generate List
                </button>
            </div>
        </div>
    }
</div>

<!-- ======================== MODALS ======================== -->

<!-- Add Shopping Item Modal -->
<div id="addShoppingModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-plus text-brand-600"></i> Add Grocery Item
            </h3>
            <button type="button" onclick="closeAddShoppingModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form asp-action="AddShoppingItem" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Pick Ingredient or Type Custom Item</label>
                <select id="shoppingIngredientSelect" onchange="onShoppingIngredientPick(this)" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 mb-2">
                    <option value="">-- Or choose from catalog --</option>
                    @foreach (var ing in ingredients.OrderBy(i => i.Name))
                    {
                        <option value="@ing.Id" data-name="@ing.Name" data-unit="@ing.DefaultUnit" data-cost="@ing.ApproximateCostPer100g">@ing.Name (@ing.Category)</option>
                    }
                </select>
                <input type="text" id="shoppingItemName" name="Name" placeholder="Item name (e.g. Greek Yogurt, Apples)" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                <input type="hidden" id="shoppingIngredientId" name="IngredientId" value="" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Quantity</label>
                    <input type="number" step="any" min="0.01" id="shoppingQuantity" name="Quantity" value="1" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Unit</label>
                    <input type="text" id="shoppingUnit" name="Unit" value="piece" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Store Section (Aisle)</label>
                    <select name="StoreSection" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        @foreach (StoreSection sec in Enum.GetValues(typeof(StoreSection)))
                        {
                            <option value="@sec">@sec</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Target Stock Location</label>
                    <select name="TargetLocation" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        @foreach (StockLocation loc in Enum.GetValues(typeof(StockLocation)))
                        {
                            <option value="@loc">@loc</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Estimated Cost ($)</label>
                    <input type="number" step="0.01" min="0" name="EstimatedCost" placeholder="Optional" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Notes</label>
                    <input type="text" name="Notes" placeholder="e.g. organic, brand preference" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-800 block">Share with Household</span>
                    <span class="text-3xs text-slate-500">Allow other registered users to see and update this item in real time</span>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="IsShared" value="true" checked class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-600"></div>
                </label>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeAddShoppingModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white">Add to List</button>
            </div>
        </form>
    </div>
</div>

<!-- Auto-Generate Modal -->
<div id="autoGenerateModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-brand-600"></i> Smart Auto-Generate
            </h3>
            <button type="button" onclick="closeAutoGenerateModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-action="AutoGenerateShoppingList" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="space-y-3">
                <div class="p-3.5 bg-amber-50/70 border border-amber-200 rounded-2xl flex items-center justify-between">
                    <div>
                        <span class="text-xs font-bold text-amber-900 block">Low Stock Items</span>
                        <span class="text-3xs text-amber-700">Add items below reorder par level or depleted staples</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="IncludeLowStock" value="true" checked class="sr-only peer" />
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600"></div>
                    </label>
                </div>

                <div class="p-3.5 bg-indigo-50/70 border border-indigo-200 rounded-2xl flex items-center justify-between">
                    <div>
                        <span class="text-xs font-bold text-indigo-900 block">Weekly Meal Plan</span>
                        <span class="text-3xs text-indigo-700">Calculate ingredients needed for scheduled meals minus current stock</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" name="IncludeMealPlan" value="true" checked class="sr-only peer" />
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                </div>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeAutoGenerateModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white">Generate Items</button>
            </div>
        </form>
    </div>
</div>

<!-- Finish Shopping Modal -->
<div id="finishShoppingModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-emerald-600 flex items-center gap-2">
                <i class="fa-solid fa-check-double"></i> Complete Shopping Trip
            </h3>
            <button type="button" onclick="closeFinishShoppingModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-action="FinishShopping" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <p class="text-xs text-slate-600">
                This will move all checked items (In-Cart and Bought) directly into your physical <strong>Pantry & Stock</strong> and record purchase movements in the ledger.
            </p>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Batch Code (Optional)</label>
                <input type="text" name="CustomBatchCode" placeholder="e.g. Costco-Weekly-@DateTime.UtcNow.ToString("MMdd")" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>

            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-800 block">Include Items "In Cart"</span>
                    <span class="text-2xs text-slate-500">Treat checked in-cart items as bought</span>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="IncludeInCartItems" value="true" checked class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                </label>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeFinishShoppingModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs font-semibold text-white">Stock Bought Items</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openAddShoppingModal() {
        document.getElementById('addShoppingModal').classList.remove('hidden');
    }
    function closeAddShoppingModal() {
        document.getElementById('addShoppingModal').classList.add('hidden');
    }

    function openAutoGenerateModal() {
        document.getElementById('autoGenerateModal').classList.remove('hidden');
    }
    function closeAutoGenerateModal() {
        document.getElementById('autoGenerateModal').classList.add('hidden');
    }

    function openFinishShoppingModal() {
        document.getElementById('finishShoppingModal').classList.remove('hidden');
    }
    function closeFinishShoppingModal() {
        document.getElementById('finishShoppingModal').classList.add('hidden');
    }

    function onShoppingIngredientPick(select) {
        var opt = select.options[select.selectedIndex];
        if (opt.value) {
            document.getElementById('shoppingIngredientId').value = opt.value;
            document.getElementById('shoppingItemName').value = opt.dataset.name || '';
            document.getElementById('shoppingUnit').value = opt.dataset.unit || 'g';
        } else {
            document.getElementById('shoppingIngredientId').value = '';
        }
    }

    function showShoppingToast(title, message, iconClass = 'fa-circle-info text-brand-600') {
        const container = document.getElementById('shoppingToastContainer');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = 'pointer-events-auto bg-white/95 backdrop-blur-sm border border-slate-200 shadow-lg rounded-2xl p-3.5 flex items-start gap-3 transition-all duration-300 transform translate-y-2 opacity-0 text-xs';
        toast.innerHTML = `
            <div class="mt-0.5"><i class="fa-solid ${iconClass} text-sm"></i></div>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-800">${title}</p>
                <p class="text-slate-500 text-2xs mt-0.5">${message}</p>
            </div>
            <button type="button" class="text-slate-400 hover:text-slate-600 ml-1 p-0.5 bg-transparent border-0 cursor-pointer" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark text-2xs"></i>
            </button>
        `;

        container.appendChild(toast);
        // Animate in
        requestAnimationFrame(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
        });

        // Auto remove after 4.5 seconds
        setTimeout(() => {
            toast.classList.add('opacity-0', '-translate-y-2');
            setTimeout(() => toast.remove(), 300);
        }, 4500);
    }

    function applyItemStatusUI(rowEl, newStatus, modifiedBy = null) {
        if (!rowEl) return;
        const btn = rowEl.querySelector('.status-toggle-btn');
        const icon = rowEl.querySelector('.status-icon');
        const text = rowEl.querySelector('.item-name-text');
        const userTag = rowEl.querySelector('.item-user-tag');

        rowEl.dataset.status = newStatus;

        let nextStatus = 'ToBuy';
        if (newStatus === 'ToBuy') {
            nextStatus = 'InCart';
            if (btn) {
                btn.className = 'status-toggle-btn w-6 h-6 rounded-lg border flex items-center justify-center transition-all cursor-pointer border-slate-300 text-transparent hover:border-brand-500';
            }
            if (icon) {
                icon.className = 'status-icon fa-solid fa-check text-2xs';
            }
            if (text) {
                text.classList.remove('line-through', 'text-slate-400');
                text.classList.add('text-slate-900');
            }
            rowEl.classList.remove('bg-slate-50/40');
        } else if (newStatus === 'InCart') {
            nextStatus = 'Bought';
            if (btn) {
                btn.className = 'status-toggle-btn w-6 h-6 rounded-lg border flex items-center justify-center transition-all cursor-pointer bg-amber-500 border-amber-500 text-white';
            }
            if (icon) {
                icon.className = 'status-icon fa-solid fa-check text-2xs';
            }
            if (text) {
                text.classList.add('line-through', 'text-slate-400');
                text.classList.remove('text-slate-900');
            }
            rowEl.classList.add('bg-slate-50/40');
        } else if (newStatus === 'Bought') {
            nextStatus = 'ToBuy';
            if (btn) {
                btn.className = 'status-toggle-btn w-6 h-6 rounded-lg border flex items-center justify-center transition-all cursor-pointer bg-emerald-600 border-emerald-600 text-white';
            }
            if (icon) {
                icon.className = 'status-icon fa-solid fa-check-double text-2xs';
            }
            if (text) {
                text.classList.add('line-through', 'text-slate-400');
                text.classList.remove('text-slate-900');
            }
            rowEl.classList.add('bg-slate-50/40');
        }

        if (btn) {
            btn.setAttribute('onclick', `toggleStatusAjax('${rowEl.dataset.itemId}', '${nextStatus}', '${rowEl.dataset.name}')`);
        }

        if (modifiedBy && userTag) {
            userTag.innerHTML = `<i class="fa-solid fa-user-pen text-3xs text-slate-300"></i> ${modifiedBy}`;
        }
    }

    function recalculateKpis() {
        const rows = document.querySelectorAll('.shopping-item-row');
        let total = rows.length;
        let toBuy = 0;
        let inCart = 0;
        let bought = 0;

        rows.forEach(r => {
            const s = r.dataset.status;
            if (s === 'ToBuy') toBuy++;
            else if (s === 'InCart') inCart++;
            else if (s === 'Bought') bought++;
        });

        const totalEl = document.getElementById('kpi-total-items');
        const toBuyEl = document.getElementById('kpi-to-buy-count');
        const inCartEl = document.getElementById('kpi-in-cart-count');
        const boughtEl = document.getElementById('kpi-bought-count');

        if (totalEl) totalEl.innerText = total;
        if (toBuyEl) toBuyEl.innerText = toBuy;
        if (inCartEl) inCartEl.innerText = inCart;
        if (boughtEl) boughtEl.innerText = bought;
    }

    async function toggleStatusAjax(id, newStatus, itemName) {
        const row = document.getElementById('shopping-item-' + id);
        const oldStatus = row ? row.dataset.status : 'ToBuy';

        // Optimistic UI update
        if (row) {
            applyItemStatusUI(row, newStatus);
            recalculateKpis();
        }

        try {
            const formData = new FormData();
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            formData.append('__RequestVerificationToken', token);
            formData.append('Id', id);
            formData.append('Status', newStatus);

            const response = await fetch('@Url.Action("SetShoppingItemStatus")', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                // Revert on failure
                if (row) {
                    applyItemStatusUI(row, oldStatus);
                    recalculateKpis();
                }
                showShoppingToast('Status Update Failed', 'Could not sync status change with server.', 'fa-circle-xmark text-rose-500');
            }
        } catch (err) {
            console.error('Failed to update status', err);
            if (row) {
                applyItemStatusUI(row, oldStatus);
                recalculateKpis();
            }
            showShoppingToast('Connection Issue', 'Failed to reach server. Please try again.', 'fa-triangle-exclamation text-amber-500');
        }
    }

    // ======================== SIGNALR REAL-TIME SYNC ========================
    const shoppingHub = new signalR.HubConnectionBuilder()
        .withUrl("/shoppingListHub")
        .withAutomaticReconnect([0, 2000, 5000, 10000])
        .build();

    shoppingHub.on("ActiveUsersUpdated", function (users) {
        const container = document.getElementById('activeUsersContainer');
        if (!container || !users) return;

        let html = '';
        users.forEach(u => {
            html += `<span class="text-2xs font-semibold px-2.5 py-1 rounded-xl bg-brand-50 text-brand-700 border border-brand-200 flex items-center gap-1.5 shadow-2xs">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                        <i class="fa-solid fa-user text-3xs"></i> ${u.userName}
                     </span>`;
        });
        container.innerHTML = html;
    });

    shoppingHub.on("ItemStatusChanged", function (data) {
        const row = document.getElementById('shopping-item-' + data.itemId);
        if (row) {
            applyItemStatusUI(row, data.status, data.userName);
            recalculateKpis();
            const friendlyStatus = data.status === 'InCart' ? 'marked In Cart' : data.status === 'Bought' ? 'marked as Bought' : 'moved back To Buy';
            showShoppingToast('Item Checked Off', `${data.userName} ${friendlyStatus}: "${data.itemName || row.dataset.name || 'item'}"`, 'fa-cart-shopping text-brand-600');
        } else {
            showShoppingToast('Shopping Update', `${data.userName} updated an item on the shopping list.`, 'fa-circle-check text-emerald-600');
        }
    });

    shoppingHub.on("ItemAdded", function (data) {
        showShoppingToast('New Item Added', `${data.userName} added "${data.name}" (${data.quantity} ${data.unit}) to ${data.section}.`, 'fa-plus-circle text-emerald-600');
        setTimeout(() => window.location.reload(), 1500);
    });

    shoppingHub.on("ItemRemoved", function (data) {
        const row = document.getElementById('shopping-item-' + data.itemId);
        if (row) {
            row.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                row.remove();
                recalculateKpis();
            }, 300);
        }
        showShoppingToast('Item Removed', `${data.userName} removed an item from the list.`, 'fa-trash-can text-slate-500');
    });

    shoppingHub.on("ShoppingFinished", function (data) {
        showShoppingToast('Shopping Complete!', `${data.userName} stocked ${data.count} items into the pantry. Refreshing list...`, 'fa-check-double text-emerald-600');
        setTimeout(() => window.location.reload(), 2000);
    });

    shoppingHub.on("ShoppingListRefreshed", function (data) {
        showShoppingToast('List Auto-Updated', `${data.userName} refreshed shopping items (${data.count} updated).`, 'fa-wand-magic-sparkles text-brand-600');
        setTimeout(() => window.location.reload(), 1500);
    });

    shoppingHub.onreconnecting(() => {
        const badge = document.getElementById('syncStatusBadge');
        const dot = document.getElementById('syncDot');
        const pulse = document.getElementById('syncPulse');
        if (badge) { badge.innerText = 'Reconnecting...'; badge.className = 'text-3xs font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-700'; }
        if (dot) { dot.className = 'relative inline-flex rounded-full h-3.5 w-3.5 bg-amber-500'; }
        if (pulse) { pulse.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75'; }
    });

    shoppingHub.onreconnected(() => {
        const badge = document.getElementById('syncStatusBadge');
        const dot = document.getElementById('syncDot');
        const pulse = document.getElementById('syncPulse');
        if (badge) { badge.innerText = 'Live & Connected'; badge.className = 'text-3xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700'; }
        if (dot) { dot.className = 'relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500'; }
        if (pulse) { pulse.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75'; }
        showShoppingToast('Live Sync Restored', 'Reconnected to real-time grocery sync.', 'fa-wifi text-emerald-600');
    });

    shoppingHub.start().then(() => {
        console.log("Connected to ShoppingListHub successfully.");
    }).catch(err => {
        console.warn("SignalR connection failed:", err);
        const badge = document.getElementById('syncStatusBadge');
        if (badge) { badge.innerText = 'Offline Sync'; badge.className = 'text-3xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600'; }
    });
</script>
}
