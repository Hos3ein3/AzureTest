@model AzureTest.Domain.Documents.Gym.Training
@using AzureTest.Domain.Enums
@{
    ViewData["Title"] = "Edit Training";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Gym Admin", "/GymAdmin"),
        new("Trainings", Url.Action("Index")),
        new($"Edit: {Model.Name}", IsActive: true)
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel(
        $"Edit Training: {Model.Name}",
        "Update exercise movement details, repetition structure, equipments, or calorie estimates.",
        "fa-solid fa-pen-to-square",
        breadcrumbs: breadcrumbs
    );
}

<div class="max-w-4xl mx-auto">
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <form method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 md:p-8 space-y-6">
            <div asp-validation-summary="All" class="text-rose-600 text-xs bg-rose-50 border border-rose-200 p-3 rounded-xl hidden:empty"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    <label asp-for="Name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Exercise Name <span class="text-rose-500">*</span></label>
                    <input asp-for="Name" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" required />
                    <span asp-validation-for="Name" class="text-rose-500 text-2xs mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Description & Execution Instructions</label>
                    <textarea asp-for="Description" id="Description"></textarea>
                    <span asp-validation-for="Description" class="text-rose-500 text-2xs mt-1 block"></span>
                </div>

                <div class="md:col-span-1">
                    <label asp-for="Type" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Exercise Type</label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<TrainingType>()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"></select>
                </div>

                <div class="md:col-span-1">
                    <label asp-for="BaseCaloriesBurn" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Base Calories Burn (kcal)</label>
                    <input asp-for="BaseCaloriesBurn" type="number" step="0.1" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                    <span asp-validation-for="BaseCaloriesBurn" class="text-rose-500 text-2xs mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="MediaUrl" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Media URL (e.g. YouTube video or animation demonstration)</label>
                    <div class="relative">
                        <i class="fa-solid fa-link absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input asp-for="MediaUrl" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                    </div>
                    <span asp-validation-for="MediaUrl" class="text-rose-500 text-2xs mt-1 block"></span>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Required Equipments</label>
                    <input name="EquipmentsStr" id="EquipmentsStr" class="w-full border-slate-200 rounded-xl" placeholder="e.g. Dumbbell, Barbell, Bench" value="@(Model?.Equipments != null ? string.Join(",", Model.Equipments) : "")" />
                    <p class="text-2xs text-slate-400 mt-1">Type equipment names and press Enter to tag them.</p>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-check"></i>
                    <span>Save Changes</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            tinymce.init({
                selector: '#Description',
                plugins: 'lists link image preview searchreplace wordcount code',
                toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code',
                height: 260,
                promotion: false,
                branding: false,
                setup: function(editor) {
                    editor.on('change', function() {
                        editor.save();
                    });
                }
            });
        });
    </script>

    <link href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            var input = document.querySelector('#EquipmentsStr');
            if (input) {
                new Tagify(input);
            }
        });
    </script>
}
