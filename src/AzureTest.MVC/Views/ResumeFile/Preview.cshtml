@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Preview: " + ViewBag.FileName;
}

<partial name="UiComponents/_Breadcrumb" model='new List<BreadcrumbItem> { new BreadcrumbItem("Resume Files", Url.Action("Index", "ResumeFile")), new BreadcrumbItem("Preview", active: true) }' />

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs shrink-0">
            <i class="fa-solid fa-file-pdf"></i>
        </div>
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                Document Preview
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">@ViewBag.FileName</p>
        </div>
    </div>
    
    <div class="flex items-center gap-2.5">
        <a href="javascript:history.back()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-arrow-left text-2xs"></i>
            <span>Back</span>
        </a>
    </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden" style="height: 75vh;">
    @if (ViewBag.FileName?.ToString()?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true)
    {
        <iframe src="@ViewBag.FileUrl" class="w-full h-full border-0"></iframe>
    }
    else if (ViewBag.FileName?.ToString()?.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) == true || 
             ViewBag.FileName?.ToString()?.EndsWith(".png", StringComparison.OrdinalIgnoreCase) == true || 
             ViewBag.FileName?.ToString()?.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) == true)
    {
        <div class="w-full h-full flex items-center justify-center bg-slate-50 overflow-auto p-4">
            <img src="@ViewBag.FileUrl" alt="@ViewBag.FileName" class="max-w-full max-h-full object-contain rounded-xl shadow-2xs border border-slate-200" />
        </div>
    }
    else
    {
        <div class="w-full h-full flex flex-col items-center justify-center bg-slate-50 text-slate-500 p-8">
            <i class="fa-solid fa-file-lines text-5xl mb-3 text-slate-300"></i>
            <p class="text-sm font-semibold text-slate-700">Preview not available for this file type</p>
            <a href="@ViewBag.FileUrl" download class="mt-3 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm transition-colors">
                <i class="fa-solid fa-download text-2xs"></i>
                <span>Download file</span>
            </a>
        </div>
    }
</div>
