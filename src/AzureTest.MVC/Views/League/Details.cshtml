@model AzureTest.Contracts.DTOs.FootballFantasy.LeagueDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="max-w-3xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Leagues</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">@Model.Name</span>
    </div>
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center space-x-3">
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" class="w-8 h-8 object-contain" alt="@Model.Name" />
            }
            <span>@Model.Name</span>
            @if (!string.IsNullOrWhiteSpace(Model.ShortName))
            {
                <span class="text-sm font-mono bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded text-brand-600">@Model.ShortName</span>
            }
        </h1>
        <div class="space-x-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm">Edit</a>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg">Back to List</a>
        </div>
    </div>
</div>

<div class="max-w-3xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <dl class="grid grid-cols-2 gap-4">
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Competition Type</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@Model.Type</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Tier Level</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@Model.Level</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Country / Confederation</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@(Model.CountryName ?? Model.Continent ?? "Global")</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Status</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @(Model.IsActive ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-800")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </dd>
        </div>
    </dl>
</div>
