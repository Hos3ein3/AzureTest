@model AzureTest.Domain.Documents.ExpenseCategory

<div class="space-y-6">
            <div>
                <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1">Name <span class="text-red-500">*</span></label>
                <input asp-for="Name" class="block w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors bg-slate-50 focus:bg-white text-slate-900" placeholder="e.g. Groceries, Rent, Utilities" required />
                <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>
