@model AzureTest.Application.FootballFantasy.Commands.CreateCountryCommand
@{
    ViewData["Title"] = "Add Country";
}

<div class="max-w-2xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Countries</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">New</span>
    </div>
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Add Country</h1>
</div>

<div class="max-w-2xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Name" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Country Name</label>
            <input asp-for="Name" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
            <span asp-validation-for="Name" class="text-xs text-rose-500"></span>
        </div>

        <div>
            <label asp-for="Code" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">ISO Code (2-3 chars)</label>
            <input asp-for="Code" class="w-full text-sm font-mono uppercase rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
            <span asp-validation-for="Code" class="text-xs text-rose-500"></span>
        </div>

        <div>
            <label asp-for="Continent" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Continent</label>
            <select asp-for="Continent" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3">
                <option value="Europe">Europe</option>
                <option value="South America">South America</option>
                <option value="North America">North America</option>
                <option value="Africa">Africa</option>
                <option value="Asia">Asia</option>
                <option value="Oceania">Oceania</option>
            </select>
            <span asp-validation-for="Continent" class="text-xs text-rose-500"></span>
        </div>

        <div>
            <label asp-for="FlagUrl" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Flag Image URL</label>
            <input asp-for="FlagUrl" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" placeholder="https://..." />
            <span asp-validation-for="FlagUrl" class="text-xs text-rose-500"></span>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-700">
            <a asp-action="Index" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-800">Cancel</a>
            <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm">Save Country</button>
        </div>
    </form>
</div>
