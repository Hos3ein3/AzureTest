@model AzureTest.Domain.Documents.Gym.TrainingCourse
@using AzureTest.Domain.Documents.Gym
@{
    var availableTrainings = ViewBag.Trainings as List<Training> ?? new List<Training>();
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs p-6 md:p-8 mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-6 gap-6">
        <div class="sm:col-span-3">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Course Name <span class="text-rose-500">*</span></label>
            <input id="courseName" type="text" placeholder="e.g. 12-Week Hypertrophy Mastery" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
        </div>

        <div class="sm:col-span-3">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Tags & Categories</label>
            <div class="flex flex-wrap items-center gap-2 border border-slate-200 p-2 rounded-xl bg-white focus-within:ring-2 focus-within:ring-brand-500 min-h-[42px]">
                <div id="tagsContainer" class="flex flex-wrap gap-1.5"></div>
                <input id="tagInput" type="text" onkeydown="handleTagInput(event)" class="outline-none border-none focus:ring-0 p-1 text-xs flex-grow min-w-[120px] bg-transparent" placeholder="Type tag and press Enter" />
            </div>
        </div>

        <div class="sm:col-span-3">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Cover Image URL</label>
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <i class="fa-solid fa-image absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input id="imagePath" type="text" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" placeholder="https://..." />
                </div>
                <label class="cursor-pointer bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-700 flex items-center shadow-2xs whitespace-nowrap transition-colors">
                    <i class="fa-solid fa-folder-open mr-1.5 text-slate-500"></i> Browse
                    <input type="file" class="hidden" accept="image/*" onchange="uploadMedia(this, 'imagePath')" />
                </label>
            </div>
        </div>

        <div class="sm:col-span-3">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Preview Video URL (Hover Play)</label>
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <i class="fa-solid fa-video absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input id="videoPath" type="text" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" placeholder="https://..." />
                </div>
                <label class="cursor-pointer bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-700 flex items-center shadow-2xs whitespace-nowrap transition-colors">
                    <i class="fa-solid fa-folder-open mr-1.5 text-slate-500"></i> Browse
                    <input type="file" class="hidden" accept="video/*" onchange="uploadMedia(this, 'videoPath')" />
                </label>
            </div>
        </div>

        <div class="sm:col-span-6">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Detailed Course Description</label>
            <textarea id="courseDescription" rows="5" class="w-full p-3.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" placeholder="Write comprehensive syllabus information, target audience, and expectations..."></textarea>
        </div>
    </div>
</div>

<div class="mb-4 flex justify-between items-center bg-white rounded-2xl border border-slate-200/80 p-4 shadow-2xs">
    <div>
        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-calendar-days text-brand-600"></i> Course Schedule
        </h3>
        <p class="text-2xs text-slate-400 mt-0.5">Organize course syllabus into structured weeks and daily exercise splits.</p>
    </div>
    <button type="button" onclick="addWeek()" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-brand-50 hover:bg-brand-100 text-brand-700 border border-brand-200 rounded-xl text-xs font-semibold shadow-2xs transition-colors">
        <i class="fa-solid fa-plus text-3xs"></i> Add Week
    </button>
</div>

<div id="weeksContainer" class="space-y-6"></div>
