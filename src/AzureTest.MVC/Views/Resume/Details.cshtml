@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
@{
    ViewData["Title"] = Model.PositionTitle;
}

<nav aria-label="breadcrumb" class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li>
            <a asp-action="Index" class="hover:text-brand-600 transition-colors">Resumes</a>
        </li>
        <li>
            <i class="fa-solid fa-chevron-right text-xs mx-1"></i>
        </li>
        <li class="font-medium text-slate-800" aria-current="page">@Model.PositionTitle</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200 flex items-start" role="alert">
        <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 mr-3"></i>
        <div class="flex-1">
            <p class="text-sm text-emerald-800 font-medium">@TempData["Success"]</p>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 focus:outline-none" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-200 flex items-start" role="alert">
        <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5 mr-3"></i>
        <div class="flex-1">
            <p class="text-sm text-red-800 font-medium">@TempData["Error"]</p>
        </div>
        <button type="button" class="text-red-500 hover:text-red-700 focus:outline-none" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-slate-800 m-0">@Model.PositionTitle</h5>
        <div class="flex space-x-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center px-3 py-1.5 border border-brand-200 text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-lg text-sm font-medium transition-colors">
                <i class="fa-solid fa-pen-to-square mr-1.5"></i> Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center px-3 py-1.5 border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 rounded-lg text-sm font-medium transition-colors">
                <i class="fa-solid fa-trash mr-1.5"></i> Delete
            </a>
        </div>
    </div>
    <div class="p-6">
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-6">
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Location</dt>
                <dd class="mt-1 text-sm text-slate-900">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Source</dt>
                <dd class="mt-1">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                        @Model.Source
                    </span>
                </dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Status</dt>
                <dd class="mt-1">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-100 text-brand-800">
                        @Model.Status
                    </span>
                </dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Job Link</dt>
                <dd class="mt-1 text-sm text-slate-900">
                    @if (string.IsNullOrWhiteSpace(Model.JobLink))
                    {
                        <span class="text-slate-400">—</span>
                    }
                    else
                    {
                        <a href="@Model.JobLink" target="_blank" class="text-brand-600 hover:text-brand-500 truncate block">
                            @Model.JobLink <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-xs"></i>
                        </a>
                    }
                </dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Applied On</dt>
                <dd class="mt-1 text-sm text-slate-900">@Model.CreatedOn.ToString("MMMM d, yyyy HH:mm")</dd>
            </div>
            @if (Model.ModifiedOn.HasValue)
            {
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-slate-500">Last Modified</dt>
                    <dd class="mt-1 text-sm text-slate-900">@Model.ModifiedOn.Value.ToString("MMMM d, yyyy HH:mm")</dd>
                </div>
            }
            
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Chat Url</dt>
                <dd class="mt-1 text-sm text-slate-900">
                    @if (string.IsNullOrWhiteSpace(Model.ChatUrl))
                    {
                        <span class="text-slate-400">—</span>
                    }
                    else
                    {
                        <a href="@Model.ChatUrl" target="_blank" class="text-brand-600 hover:text-brand-500 truncate block">
                            @Model.ChatUrl <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-xs"></i>
                        </a>
                    }
                </dd>
            </div>
            <div class="sm:col-span-3">
                <dt class="text-sm font-medium text-slate-500">Description</dt>
                <dd class="mt-1 text-sm text-slate-900 bg-slate-50 p-4 rounded-lg border border-slate-100 prose prose-sm max-w-none">
                    @if(string.IsNullOrWhiteSpace(Model.Description)) { <text>—</text> } else { @Html.Raw(Model.Description) }
                </dd>
            </div>
            <div class="sm:col-span-3">
                <dt class="text-sm font-medium text-slate-500">Notes</dt>
                <dd class="mt-1 text-sm text-slate-900 bg-yellow-50/50 p-4 rounded-lg border border-yellow-100 prose prose-sm max-w-none">
                    @if(string.IsNullOrWhiteSpace(Model.Note)) { <text>—</text> } else { @Html.Raw(Model.Note) }
                </dd>
            </div>
        </dl>
    </div>
</div>

@{
    var company = ViewBag.Company as AzureTest.Domain.Documents.Company;
}

@if (company != null)
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <h6 class="text-lg font-semibold text-slate-800 m-0"><i class="fa-regular fa-building text-brand-500 mr-2"></i>Company Details</h6>
        </div>
        <div class="p-6">
            <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-6">
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-slate-500">Company Name</dt>
                    <dd class="mt-1 text-sm font-semibold text-slate-900">@company.CompanyName</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-slate-500">IND Sponsor</dt>
                    <dd class="mt-1">
                        @if (company.IsINDMember)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                <i class="fa-solid fa-check mr-1"></i> Yes
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                                No
                            </span>
                        }
                    </dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-slate-500">Location</dt>
                    <dd class="mt-1 text-sm text-slate-900">@(string.IsNullOrWhiteSpace(company.Location) ? "—" : company.Location)</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-slate-500">KVK Number</dt>
                    <dd class="mt-1 text-sm text-slate-900">@(string.IsNullOrWhiteSpace(company.KvkNumber) ? "—" : company.KvkNumber)</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(company.LinkedinURL))
                {
                    <div class="sm:col-span-1 lg:col-span-2">
                        <dt class="text-sm font-medium text-slate-500">LinkedIn</dt>
                        <dd class="mt-1 text-sm text-slate-900">
                            <a href="@company.LinkedinURL" target="_blank" class="text-brand-600 hover:text-brand-500 truncate block">
                                <i class="fa-brands fa-linkedin text-blue-600 mr-1"></i> LinkedIn Profile <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-xs"></i>
                            </a>
                        </dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(company.IndeedUrl))
                {
                    <div class="sm:col-span-1 lg:col-span-2">
                        <dt class="text-sm font-medium text-slate-500">Indeed</dt>
                        <dd class="mt-1 text-sm text-slate-900">
                            <a href="@company.IndeedUrl" target="_blank" class="text-brand-600 hover:text-brand-500 truncate block">
                                Indeed Profile <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-xs"></i>
                            </a>
                        </dd>
                    </div>
                }
            </dl>
        </div>
    </div>
}

@{
    var files = ViewBag.Files as AzureTest.Contracts.DTOs.Resumes.ResumeFilesDto;
}

@if (files is not null && (files.HasCv || files.HasCoverLetter))
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <h6 class="text-lg font-semibold text-slate-800 m-0">Attachments</h6>
        </div>
        <div class="p-6">
            @if (files.HasCv)
            {
                <div class="mb-6">
                    <div class="flex justify-between items-center mb-3">
                        <strong class="text-slate-800 font-medium"><i class="fa-solid fa-file-pdf text-red-500 mr-2"></i>Curriculum Vitae (CV)</strong>
                        <div class="flex space-x-2">
                            <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv" })" class="inline-flex items-center px-3 py-1.5 border border-brand-200 text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-lg text-xs font-medium transition-colors" target="_blank">
                                <i class="fa-solid fa-download mr-1.5"></i> Download
                            </a>
                            <form id="delete-cv-form" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cv" asp-route-returnUrl="@Context.Request.Path" method="post" class="inline">
                                <button type="button" onclick="openDeleteModal('delete-cv-form', 'CV')" class="inline-flex items-center px-3 py-1.5 border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 rounded-lg text-xs font-medium transition-colors">
                                    <i class="fa-solid fa-trash mr-1.5"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-3">@files.CvName</p>
                    <div class="border border-slate-200 rounded-lg overflow-hidden h-[500px] bg-slate-100">
                        <embed src="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv", inline = true })" type="application/pdf" width="100%" height="100%" />
                    </div>
                </div>
            }

            @if (files.HasCv && files.HasCoverLetter)
            {
                <hr class="my-6 border-slate-200" />
            }

            @if (files.HasCoverLetter)
            {
                <div>
                    <div class="flex justify-between items-center mb-3">
                        <strong class="text-slate-800 font-medium"><i class="fa-solid fa-file-word text-blue-500 mr-2"></i>Cover Letter</strong>
                        <div class="flex space-x-2">
                            <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl" })" class="inline-flex items-center px-3 py-1.5 border border-brand-200 text-brand-600 bg-brand-50 hover:bg-brand-100 rounded-lg text-xs font-medium transition-colors" target="_blank">
                                <i class="fa-solid fa-download mr-1.5"></i> Download
                            </a>
                            <form id="delete-cl-form" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cl" asp-route-returnUrl="@Context.Request.Path" method="post" class="inline">
                                <button type="button" onclick="openDeleteModal('delete-cl-form', 'Cover Letter')" class="inline-flex items-center px-3 py-1.5 border border-red-200 text-red-600 bg-red-50 hover:bg-red-100 rounded-lg text-xs font-medium transition-colors">
                                    <i class="fa-solid fa-trash mr-1.5"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                    <p class="text-slate-500 text-xs mb-3">@files.CoverLetterName</p>
                    <div class="border border-slate-200 rounded-lg overflow-hidden h-[500px] bg-slate-100">
                        <embed src="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl", inline = true })" type="application/pdf" width="100%" height="100%" />
                    </div>
                </div>
            }
        </div>
    </div>
}

@{
    var statusLogs = ViewBag.StatusLogs as System.Collections.Generic.IReadOnlyList<AzureTest.Contracts.DTOs.Resumes.StatusLogDto>;
}

@if (statusLogs != null && statusLogs.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <h6 class="text-lg font-semibold text-slate-800 m-0"><i class="fa-solid fa-clock-rotate-left text-brand-500 mr-2"></i>Status History</h6>
        </div>
        <div class="p-0">
            <ul class="divide-y divide-slate-100">
                @foreach (var log in statusLogs)
                {
                    <li class="p-6 hover:bg-slate-50 transition-colors">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                            <div class="flex items-center text-sm font-medium">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-slate-100 text-slate-700">@log.OldStatus</span>
                                <i class="fa-solid fa-arrow-right mx-2 text-slate-400 text-xs"></i>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-brand-100 text-brand-800">@log.NewStatus</span>
                            </div>
                            <div class="text-xs text-slate-500 mt-2 sm:mt-0">
                                <i class="fa-regular fa-calendar mr-1"></i> @log.Date.ToLocalTime().ToString("MMM d, yyyy HH:mm")
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(log.Note))
                        {
                            <div class="mt-3 text-sm text-slate-600 bg-white border border-slate-200 rounded-lg p-3 italic">
                                "@log.Note"
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

