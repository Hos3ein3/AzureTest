@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
@{
    ViewData["Title"] = Model.PositionTitle;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Resumes</a></li>
        <li class="breadcrumb-item active">@Model.PositionTitle</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Model.PositionTitle</h5>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary me-2">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Delete</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</dd>

            <dt class="col-sm-3">Source</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Source</span></dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">@Model.Status</span></dd>

            <dt class="col-sm-3">Job Link</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.JobLink))
                {
                    <span class="text-muted">—</span>
                }
                else
                {
                    <a href="@Model.JobLink" target="_blank">@Model.JobLink <i class="bi bi-box-arrow-up-right"></i></a>
                }
            </dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note)</dd>

            <dt class="col-sm-3">Applied On</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToString("MMMM d, yyyy HH:mm")</dd>

            @if (Model.ModifiedOn.HasValue)
            {
                <dt class="col-sm-3">Last Modified</dt>
                <dd class="col-sm-9">@Model.ModifiedOn.Value.ToString("MMMM d, yyyy HH:mm")</dd>
            }
        </dl>
    </div>
</div>

@{
    var files = ViewBag.Files as AzureTest.Contracts.DTOs.Resumes.ResumeFilesDto;
}

@if (files is not null && (files.HasCv || files.HasCoverLetter))
{
    <div class="card shadow-sm mb-4">
        <div class="card-header"><h6 class="mb-0">Attachments</h6></div>
        <div class="card-body">
            @if (files.HasCv)
            {
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Curriculum Vitae (CV)</strong>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv" })" class="btn btn-sm btn-outline-primary" target="_blank">
                                <i class="bi bi-download"></i> Download
                            </a>
                            <form asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cv" asp-route-returnUrl="@Context.Request.Path" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this CV?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">@files.CvName</p>
                    <div class="border rounded" style="height: 500px; overflow: hidden;">
                        <embed src="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv" })" type="application/pdf" width="100%" height="100%" />
                    </div>
                </div>
            }

            @if (files.HasCv && files.HasCoverLetter)
            {
                <hr class="my-4" />
            }

            @if (files.HasCoverLetter)
            {
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Cover Letter</strong>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl" })" class="btn btn-sm btn-outline-primary" target="_blank">
                                <i class="bi bi-download"></i> Download
                            </a>
                            <form asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cl" asp-route-returnUrl="@Context.Request.Path" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Cover Letter?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                    <p class="text-muted small mb-2">@files.CoverLetterName</p>
                    <div class="border rounded" style="height: 500px; overflow: hidden;">
                        <embed src="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl" })" type="application/pdf" width="100%" height="100%" />
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header"><h6 class="mb-0">Update Status</h6></div>
    <div class="card-body">
        <form asp-action="UpdateStatus" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">New Status</label>
                    <select name="Status" class="form-select">
                        @foreach (var status in Enum.GetValues<AzureTest.Domain.Enums.ResumeStatus>())
                        {
                            <option value="@((int)status)" selected="@(status == Model.Status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </div>
        </form>
    </div>
</div>
