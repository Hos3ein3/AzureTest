@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Resumes.ResumeDto>
@{
    ViewData["Title"] = "My Resumes";
    var filters = ViewBag.Filters as AzureTest.Application.Resumes.Queries.GetAllResumes.GetAllResumesFilters;
    
    string GetSortLink(string sortBy, string label)
    {
        var isCurrentSort = filters?.SortBy?.Equals(sortBy, StringComparison.OrdinalIgnoreCase) ?? (sortBy == "CreatedOn");
        var desc = isCurrentSort ? !(filters?.SortDescending ?? true) : false;
        var icon = isCurrentSort ? (filters?.SortDescending ?? true ? "fa-sort-down text-brand-600" : "fa-sort-up text-brand-600") : "fa-sort text-slate-300";
        var url = $"?PageNumber=1&PageSize={filters?.PageSize}&SearchTerm={filters?.SearchTerm}&Location={filters?.Location}&Source={filters?.Source}&Status={filters?.Status}&AppliedDate={filters?.AppliedDate?.ToString("yyyy-MM-dd")}&SortBy={sortBy}&SortDescending={desc}";
        
        return $@"<a href=""{url}"" class=""group inline-flex items-center hover:text-slate-700 transition-colors"">{label} <i class=""fa-solid {icon} ml-1""></i></a>";
    }

    string GetPageUrl(int pageNumber)
    {
        return $"?PageNumber={pageNumber}&PageSize={filters?.PageSize}&SearchTerm={filters?.SearchTerm}&Location={filters?.Location}&Source={filters?.Source}&Status={filters?.Status}&AppliedDate={filters?.AppliedDate?.ToString("yyyy-MM-dd")}&SortBy={filters?.SortBy}&SortDescending={filters?.SortDescending}";
    }
}

@using AzureTest.MVC.Models

<partial name="UiComponents/_Breadcrumb" model='new List<BreadcrumbItem> { new BreadcrumbItem("Home", "/"), new BreadcrumbItem("Resumes", active: true) }' />

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs shrink-0">
            <i class="fa-solid fa-file-invoice"></i>
        </div>
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                My Resumes
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Manage job applications, statuses, match rates, and resumes</p>
        </div>
    </div>
    
    <div class="flex items-center gap-3">
        <div class="inline-flex bg-slate-100 p-1 rounded-xl border border-slate-200">
            <span class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white text-slate-900 shadow-2xs border border-slate-200/60 cursor-default flex items-center gap-1.5">
                <i class="fa-solid fa-list text-2xs"></i>
                <span>List</span>
            </span>
            <a asp-action="Kanban" class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition-colors flex items-center gap-1.5">
                <i class="fa-solid fa-border-all text-2xs"></i>
                <span>Board</span>
            </a>
        </div>
        
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-colors">
            <i class="fa-solid fa-plus text-2xs"></i>
            <span>Add Application</span>
        </a>
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-800">Filter Resumes</h3>
    </div>
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Search</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@filters?.SearchTerm" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" placeholder="Title, description..." />
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Location</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-location-dot text-slate-400"></i>
                    </div>
                    <input name="Location" type="text" value="@filters?.Location" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" placeholder="Location..." />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
                <select name="Status" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm rounded-lg">
                    <option value="">All Statuses</option>
                    @foreach (var status in Enum.GetValues(typeof(AzureTest.Domain.Enums.ResumeStatus)).Cast<AzureTest.Domain.Enums.ResumeStatus>())
                    {
                        if (filters?.Status == status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Source</label>
                <select name="Source" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm rounded-lg">
                    <option value="">All Sources</option>
                    @foreach (var source in Enum.GetValues(typeof(AzureTest.Domain.Enums.ResumeSource)).Cast<AzureTest.Domain.Enums.ResumeSource>())
                    {
                        if (filters?.Source == source)
                        {
                            <option value="@source" selected>@source</option>
                        }
                        else
                        {
                            <option value="@source">@source</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Applied Date</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-regular fa-calendar text-slate-400"></i>
                    </div>
                    <input name="AppliedDate" type="date" value="@filters?.AppliedDate?.ToString("yyyy-MM-dd")" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Page Size</label>
                <select name="PageSize" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm rounded-lg">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (filters?.PageSize == size || (filters == null && size == 10))
                        {
                            <option value="@size" selected>@size items</option>
                        }
                        else
                        {
                            <option value="@size">@size items</option>
                        }
                    }
                </select>
            </div>
            
            <div class="flex items-end space-x-2">
                <button type="submit" class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-slate-800 hover:bg-slate-900 focus:outline-none transition-colors">
                    <i class="fa-solid fa-filter mr-2"></i> Apply
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none transition-colors" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200 flex items-start" role="alert">
        <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 mr-3"></i>
        <div class="flex-1">
            <p class="text-sm text-emerald-800 font-medium">@TempData["Success"]</p>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 focus:outline-none" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-12 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 mb-4">
            <i class="fa-solid fa-inbox text-2xl text-slate-400"></i>
        </div>
        <h3 class="text-lg font-medium text-slate-900 mb-1">No resumes found</h3>
        <p class="text-slate-500 mb-6">Get started by creating your first resume entry or adjust your filters.</p>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Resume
        </a>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden flex flex-col">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("Position", "Position"))</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("Location", "Location"))</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("Source", "Source"))</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("Status", "Status"))</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">ATS</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Html.Raw(GetSortLink("CreatedOn", "Applied On"))</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200">
                    @foreach (var resume in Model.Items)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center break-words font-medium text-slate-900">
                                    @resume.PositionTitle
                                    @if (!string.IsNullOrWhiteSpace(resume.ChatUrl))
                                    {
                                        <a href="@resume.ChatUrl" target="_blank" class="ml-2 text-slate-400 hover:text-brand-600" title="Chat URL">
                                            <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500">
                                @(string.IsNullOrWhiteSpace(resume.Location) ? "—" : resume.Location)
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                                    @resume.Source
                                </span>
                                @if (!string.IsNullOrWhiteSpace(resume.JobLink))
                                {
                                    <a href="@resume.JobLink" target="_blank" class="ml-2 text-slate-400 hover:text-brand-600" title="Job Link">
                                        <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                                    </a>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <select class="status-dropdown text-sm font-medium rounded-full px-3 py-1 border-0 focus:ring-2 focus:ring-brand-500 shadow-sm appearance-none cursor-pointer pr-8 bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" 
                                            style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23ffffff%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E');"
                                            data-id="@resume.Id">
                                        @foreach (var status in Enum.GetValues(typeof(AzureTest.Domain.Enums.ResumeStatus)).Cast<AzureTest.Domain.Enums.ResumeStatus>())
                                        {
                                            if (resume.Status == status)
                                            {
                                                <option value="@status" selected>@status</option>
                                            }
                                            else
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        }
                                    </select>
                                    <span class="status-indicator ml-2 text-emerald-500 text-sm hidden" id="indicator-@resume.Id">
                                        <i class="fa-solid fa-check"></i>
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @if (resume.AtsScore.HasValue)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @(resume.AtsScore >= 80 ? "bg-emerald-100 text-emerald-800" : resume.AtsScore >= 50 ? "bg-yellow-100 text-yellow-800" : "bg-red-100 text-red-800")">
                                        @resume.AtsScore
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-300">—</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                                @resume.CreatedOn.ToLocalTime().ToString("MMM d, yyyy")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a asp-action="Details" asp-route-id="@resume.Id" class="text-brand-600 hover:text-brand-900 mx-2" title="Details">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@resume.Id" class="text-slate-600 hover:text-slate-900 mx-2" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@resume.Id" class="text-red-500 hover:text-red-700 ml-2" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @{
            var pagination = new PaginationModel
            {
                CurrentPage = Model.PageNumber,
                PageSize = Model.PageSize,
                TotalItems = Model.TotalCount,
                TotalPages = Model.TotalPages,
                PageUrlFactory = p => GetPageUrl(p)
            };
        }
        <partial name="UiComponents/_Pagination" model="pagination" />
    </div>
}

@section Scripts {
    <!-- Status Change Modal -->
    <div id="statusModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-slate-500 bg-opacity-75 transition-opacity"></div>
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                    <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                        <h3 class="text-base font-semibold leading-6 text-slate-900 mb-2">Change Status</h3>
                        <p class="text-sm text-slate-500 mb-4">Add an optional note about this status change.</p>
                        <textarea id="statusNote" rows="3" class="w-full rounded-md border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm border p-3" placeholder="Interview details, feedback, etc..."></textarea>
                    </div>
                    <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                        <button type="button" id="confirmStatusBtn" class="inline-flex w-full justify-center rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 sm:ml-3 sm:w-auto">Save</button>
                        <button type="button" onclick="closeStatusModal()" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function updateSelectColor(select) {
            // Remove previous color classes
            select.classList.remove('bg-red-500', 'bg-emerald-500', 'bg-amber-500', 'bg-blue-500', 'bg-sky-500', 'bg-slate-500', 'bg-slate-400', 'bg-orange-400', 'bg-stone-500', 'bg-zinc-600', 'text-white');
            select.classList.add('text-white');
            
            switch(select.value) {
                case 'WantToApply': select.classList.add('bg-slate-400'); break;
                case 'Applied': select.classList.add('bg-blue-500'); break;
                case 'PhoneScreen': select.classList.add('bg-sky-500'); break;
                case 'Interview': select.classList.add('bg-amber-500'); break;
                case 'Offer': select.classList.add('bg-emerald-500'); break;
                case 'OnHold': select.classList.add('bg-orange-400'); break;
                case 'Rejected': select.classList.add('bg-red-500'); break;
                case 'Withdraw': select.classList.add('bg-stone-500'); break;
                case 'Ghosted': select.classList.add('bg-zinc-600'); break;
                default: select.classList.add('bg-slate-500'); break;
            }
        }

        let pendingStatusChange = null;

        function closeStatusModal() {
            if (pendingStatusChange) {
                // Revert dropdown to old value
                pendingStatusChange.selectElement.value = pendingStatusChange.oldStatus;
                updateSelectColor(pendingStatusChange.selectElement);
            }
            pendingStatusChange = null;
            document.getElementById('statusNote').value = '';
            document.getElementById('statusModal').classList.add('hidden');
        }

        document.getElementById('confirmStatusBtn').addEventListener('click', function() {
            if (!pendingStatusChange) return;

            const note = document.getElementById('statusNote').value;
            const { selectElement, resumeId, newStatus, oldStatus, token, indicator } = pendingStatusChange;
            
            // clear pending right away so cancel doesn't trigger revert
            pendingStatusChange = null;
            document.getElementById('statusModal').classList.add('hidden');
            document.getElementById('statusNote').value = '';
            
            selectElement.disabled = true;

            fetch('@Url.Action("UpdateStatus", "Resume")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    'Id': resumeId,
                    'Status': newStatus,
                    'Note': note,
                    '__RequestVerificationToken': token
                })
            })
            .then(r => r.json())
            .then(data => {
                selectElement.disabled = false;
                if(data.success) {
                    selectElement.setAttribute('data-old-value', newStatus);
                    updateSelectColor(selectElement);
                    indicator.classList.remove('hidden');
                    setTimeout(() => indicator.classList.add('hidden'), 2000);
                } else {
                    alert('Failed to update status: ' + (data.message || 'Unknown error'));
                    // revert
                    selectElement.value = oldStatus;
                    updateSelectColor(selectElement);
                }
            })
            .catch(err => {
                selectElement.disabled = false;
                alert('An error occurred while updating the status.');
                // revert
                selectElement.value = oldStatus;
                updateSelectColor(selectElement);
            });
        });

        document.querySelectorAll('.status-dropdown').forEach(dd => {
            updateSelectColor(dd);
            
            dd.addEventListener('focus', function() {
                if (!this.getAttribute('data-old-value')) {
                    this.setAttribute('data-old-value', this.value);
                }
            });

            dd.addEventListener('change', function() {
                var selectElement = this;
                var oldStatus = selectElement.getAttribute('data-old-value') || selectElement.value;
                var resumeId = selectElement.getAttribute('data-id');
                var newStatus = selectElement.value;
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
                var indicator = document.getElementById('indicator-' + resumeId);
                
                pendingStatusChange = { selectElement, resumeId, newStatus, oldStatus, token, indicator };
                
                // Set to new color immediately for visual feedback, will revert if cancelled
                updateSelectColor(selectElement);
                
                document.getElementById('statusModal').classList.remove('hidden');
                document.getElementById('statusNote').focus();
            });
        });
    </script>
}
