@model IReadOnlyList<AzureTest.Contracts.DTOs.Resumes.ResumeDto>
@{
    ViewData["Title"] = "My Resumes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">My Resumes</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add New
    </a>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4 d-block mb-3"></i>
        <p>No resumes yet. <a asp-action="Create">Add your first one!</a></p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Position</th>
                    <th>Location</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Applied On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resume in Model)
                {
                    <tr>
                        <td>
                            <strong>@resume.PositionTitle</strong>
                            @if (!string.IsNullOrWhiteSpace(resume.JobLink))
                            {
                                <a href="@resume.JobLink" target="_blank" class="ms-1 text-muted small">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(resume.Location) ? "—" : resume.Location)</td>
                        <td><span class="badge bg-secondary">@resume.Source</span></td>
                        <td>
                            <select class="form-select form-select-sm status-dropdown" data-id="@resume.Id" style="width: 140px; display: inline-block;">
                                @foreach (var status in Enum.GetValues(typeof(AzureTest.Domain.Enums.ResumeStatus)).Cast<AzureTest.Domain.Enums.ResumeStatus>())
                                {
                                    if (resume.Status == status)
                                    {
                                        <option value="@status" selected>@status</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@status</option>
                                    }
                                }
                            </select>
                            <span class="status-indicator ms-2 text-success" id="indicator-@resume.Id" style="display:none;">
                                <i class="bi bi-check-circle"></i>
                            </span>
                        </td>
                        <td>@resume.CreatedOn.ToLocalTime().ToString("MMM d, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        function updateSelectColor(select) {
            select.classList.remove('bg-primary', 'bg-warning', 'bg-success', 'bg-danger', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');
            switch(select.value) {
                case 'Rejected': select.classList.add('bg-danger', 'text-white'); break;
                case 'Offer': select.classList.add('bg-success', 'text-white'); break;
                case 'Interviewing': select.classList.add('bg-warning', 'text-dark'); break;
                case 'Applied': select.classList.add('bg-primary', 'text-white'); break;
                case 'Screening': select.classList.add('bg-info', 'text-dark'); break;
                default: select.classList.add('bg-secondary', 'text-white'); break;
            }
        }

        document.querySelectorAll('.status-dropdown').forEach(dd => {
            updateSelectColor(dd);
            dd.addEventListener('change', function() {
                var selectElement = this;
                var resumeId = selectElement.getAttribute('data-id');
                var newStatus = selectElement.value;
                var token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
                var indicator = document.getElementById('indicator-' + resumeId);
                
                selectElement.disabled = true;

                fetch('@Url.Action("UpdateStatus", "Resume")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({
                        'Id': resumeId,
                        'Status': newStatus,
                        '__RequestVerificationToken': token
                    })
                })
                .then(r => r.json())
                .then(data => {
                    selectElement.disabled = false;
                    if(data.success) {
                        updateSelectColor(selectElement);
                        indicator.style.display = 'inline-block';
                        setTimeout(() => indicator.style.display = 'none', 2000);
                    } else {
                        alert('Failed to update status: ' + (data.message || 'Unknown error'));
                        // Reload to revert color on failure
                        location.reload();
                    }
                })
                .catch(err => {
                    selectElement.disabled = false;
                    alert('An error occurred while updating the status.');
                    location.reload();
                });
            });
        });
    </script>
}
