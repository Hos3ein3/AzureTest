@model AzureTest.Contracts.DTOs.Resumes.CreateResumeDto
@{
    ViewData["Title"] = "Add Resume";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Resumes</a></li>
        <li class="breadcrumb-item active">Add New</li>
    </ol>
</nav>

<div class="card shadow-sm" style="max-width: 700px;">
    <div class="card-header"><h5 class="mb-0">Add New Resume</h5></div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <partial name="_ResumeFormPartial" />
            
            <hr class="my-4" />
            <h6 class="mb-3">Attachments</h6>
            
            <div class="mb-3">
                <label for="cvFile" class="form-label">Upload CV</label>
                <input type="file" class="form-control" id="cvFile" name="cvFile" />
            </div>

            <div class="mb-4">
                <label for="clFile" class="form-label">Upload Cover Letter</label>
                <input type="file" class="form-control" id="clFile" name="clFile" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
