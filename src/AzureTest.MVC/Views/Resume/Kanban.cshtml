@model IEnumerable<AzureTest.Contracts.DTOs.Resumes.ResumeDto>
@{
    ViewData["Title"] = "Kanban Board";
    var statuses = Enum.GetValues<AzureTest.Domain.Enums.ResumeStatus>();
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800">My Resumes</h1>
    
    <div class="flex items-center space-x-4">
        <div class="inline-flex bg-slate-100 p-1 rounded-lg border border-slate-200">
            <a asp-action="Index" class="px-3 py-1.5 text-sm font-medium rounded-md text-slate-600 hover:text-slate-900 transition-colors">
                <i class="fa-solid fa-list mr-1.5"></i> List
            </a>
            <span class="px-3 py-1.5 text-sm font-medium rounded-md bg-white text-slate-900 shadow-sm border border-slate-200 cursor-default">
                <i class="fa-solid fa-border-all mr-1.5"></i> Board
            </span>
        </div>
        
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add New
        </a>
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="flex space-x-6 overflow-x-auto pb-4 pt-2" style="min-height: calc(100vh - 200px);">
    @foreach (var status in statuses)
    {
        string headerBg = status switch
        {
            AzureTest.Domain.Enums.ResumeStatus.WantToApply => "bg-slate-400",
            AzureTest.Domain.Enums.ResumeStatus.Applied => "bg-blue-500",
            AzureTest.Domain.Enums.ResumeStatus.PhoneScreen => "bg-sky-500",
            AzureTest.Domain.Enums.ResumeStatus.Interview => "bg-amber-500",
            AzureTest.Domain.Enums.ResumeStatus.Offer => "bg-emerald-500",
            AzureTest.Domain.Enums.ResumeStatus.OnHold => "bg-orange-400",
            AzureTest.Domain.Enums.ResumeStatus.Rejected => "bg-red-500",
            AzureTest.Domain.Enums.ResumeStatus.Withdraw => "bg-stone-500",
            AzureTest.Domain.Enums.ResumeStatus.Ghosted => "bg-zinc-600",
            _ => "bg-slate-500"
        };

        var itemsInStatus = Model.Where(r => r.Status == status).OrderByDescending(r => r.CreatedOn).ToList();
        
        <div class="flex-shrink-0 w-80 flex flex-col bg-slate-50/50 rounded-xl border border-slate-200">
            <!-- Column Header -->
            <div class="px-4 py-3 border-b border-slate-200 flex justify-between items-center rounded-t-xl bg-slate-100">
                <div class="flex items-center space-x-2">
                    <span class="w-3 h-3 rounded-full @headerBg"></span>
                    <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wide">@status</h3>
                </div>
                <span class="text-xs font-semibold text-slate-500 bg-slate-200 px-2 py-0.5 rounded-full" id="count-@status">@itemsInStatus.Count</span>
            </div>
            
            <!-- Column Body / Sortable Container -->
            <div class="flex-1 p-3 overflow-y-auto kanban-column" data-status="@((int)status)" id="col-@status">
                @foreach(var resume in itemsInStatus)
                {
                    <!-- Card -->
                    <div class="bg-white p-4 mb-3 rounded-lg shadow-sm border border-slate-200 cursor-grab hover:shadow-md transition-shadow group" data-id="@resume.Id">
                        <div class="flex justify-between items-start mb-2">
                            <h4 class="text-sm font-semibold text-slate-800 leading-tight">
                                <a asp-action="Details" asp-route-id="@resume.Id" class="hover:text-brand-600 transition-colors">@resume.PositionTitle</a>
                            </h4>
                            <div class="opacity-0 group-hover:opacity-100 transition-opacity flex space-x-1">
                                <a asp-action="Edit" asp-route-id="@resume.Id" class="text-slate-400 hover:text-brand-600" title="Edit">
                                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                                </a>
                            </div>
                        </div>
                        
                        <div class="text-xs text-slate-500 space-y-1">
                            @if(!string.IsNullOrWhiteSpace(resume.Location))
                            {
                                <div class="flex items-center">
                                    <i class="fa-solid fa-location-dot w-4 text-center text-slate-400"></i>
                                    <span>@resume.Location</span>
                                </div>
                            }
                            <div class="flex items-center">
                                <i class="fa-regular fa-calendar w-4 text-center text-slate-400"></i>
                                <span>Applied: @resume.CreatedOn.ToLocalTime().ToString("MMM d")</span>
                            </div>
                            <div class="flex items-center mt-2 pt-2 border-t border-slate-100">
                                <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600 uppercase tracking-wide">@resume.Source</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const columns = document.querySelectorAll('.kanban-column');
            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

            columns.forEach(column => {
                new Sortable(column, {
                    group: 'kanban', // set both lists to same group
                    animation: 150,
                    ghostClass: 'opacity-50', // Class name for the drop placeholder
                    dragClass: 'shadow-lg',
                    onEnd: function (evt) {
                        const itemEl = evt.item;  // dragged HTMLElement
                        const toList = evt.to;    // target list
                        const fromList = evt.from;// previous list

                        if (toList === fromList) {
                            return; // No status change
                        }

                        const resumeId = itemEl.getAttribute('data-id');
                        const newStatus = toList.getAttribute('data-status');
                        
                        // Update counts
                        const toStatusName = toList.id.replace('col-', '');
                        const fromStatusName = fromList.id.replace('col-', '');
                        const toCountEl = document.getElementById('count-' + toStatusName);
                        const fromCountEl = document.getElementById('count-' + fromStatusName);
                        
                        if(toCountEl) toCountEl.innerText = parseInt(toCountEl.innerText) + 1;
                        if(fromCountEl) fromCountEl.innerText = parseInt(fromCountEl.innerText) - 1;

                        // Call AJAX
                        fetch('@Url.Action("UpdateStatus", "Resume")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: new URLSearchParams({
                                'Id': resumeId,
                                'Status': newStatus,
                                '__RequestVerificationToken': token
                            })
                        })
                        .then(r => r.json())
                        .then(data => {
                            if(!data.success) {
                                alert('Failed to update status: ' + (data.message || 'Unknown error'));
                                location.reload();
                            }
                        })
                        .catch(err => {
                            alert('An error occurred while updating the status.');
                            location.reload();
                        });
                    }
                });
            });
        });
    </script>
}
