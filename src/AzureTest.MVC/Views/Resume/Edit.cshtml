@model AzureTest.Contracts.DTOs.Resumes.UpdateResumeDto
@{
    ViewData["Title"] = "Edit Resume";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Resumes</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.PositionTitle</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<div class="card shadow-sm" style="max-width: 700px;">
    <div class="card-header"><h5 class="mb-0">Edit Resume</h5></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <partial name="_ResumeFormPartial" />
            
            <hr class="my-4" />
            <h6 class="mb-3">Update Attachments</h6>

            @{
                var files = ViewBag.Files as AzureTest.Contracts.DTOs.Resumes.ResumeFilesDto;
            }

            @if (files is not null && (files.HasCv || files.HasCoverLetter))
            {
                <div class="alert alert-light border mb-4">
                    <strong>Current Attachments:</strong>
                    <ul class="mb-0 mt-2">
                        @if (files.HasCv)
                        {
                            <li class="mb-1">
                                CV: <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv" })" target="_blank">@files.CvName</a>
                                <button type="submit" form="deleteCvForm" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="return confirm('Delete this CV?');">Remove</button>
                            </li>
                        }
                        @if (files.HasCoverLetter)
                        {
                            <li>
                                Cover Letter: <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl" })" target="_blank">@files.CoverLetterName</a>
                                <button type="submit" form="deleteClForm" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="return confirm('Delete this Cover Letter?');">Remove</button>
                            </li>
                        }
                    </ul>
                </div>
            }

            <p class="text-muted small">Uploading new files will overwrite any existing files for this resume.</p>
            
            <div class="mb-3">
                <label for="cvFile" class="form-label">Upload New CV</label>
                <input type="file" class="form-control" id="cvFile" name="cvFile" />
            </div>

            <div class="mb-4">
                <label for="clFile" class="form-label">Upload New Cover Letter</label>
                <input type="file" class="form-control" id="clFile" name="clFile" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function () {
        const toggleBtn = document.getElementById('toggleNewCompany');
        const newPanel  = document.getElementById('newCompanyPanel');
        const selectEl  = document.getElementById('companySelect');
        const newInput  = document.getElementById('newCompanyInput');
        const acList    = document.getElementById('companyAutocomplete');

        // Toggle the "new company" panel
        toggleBtn.addEventListener('click', () => {
            const isVisible = newPanel.style.display !== 'none';
            if (isVisible) {
                newPanel.style.display = 'none';
                newInput.value = '';
                // Re-enable the select so its value is submitted
                selectEl.disabled = false;
            } else {
                newPanel.style.display = 'block';
                // Clear and disable the select so CompanyId is not submitted
                selectEl.value = '';
                selectEl.disabled = true;
                newInput.focus();
            }
        });

        // When the user picks from the dropdown, hide the new panel
        selectEl.addEventListener('change', () => {
            if (selectEl.value) {
                newPanel.style.display = 'none';
                newInput.value = '';
                selectEl.disabled = false;
            }
        });

        // Autocomplete: search existing companies as the user types
        let debounceTimer;
        newInput.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            const term = newInput.value.trim();
            if (term.length < 1) { acList.style.display = 'none'; return; }

            debounceTimer = setTimeout(async () => {
                const res  = await fetch(`/Resume/SearchCompanies?term=${encodeURIComponent(term)}`);
                const data = await res.json();

                acList.innerHTML = '';
                if (data.length === 0) { acList.style.display = 'none'; return; }

                data.forEach(c => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'list-group-item list-group-item-action';
                    item.textContent = c.name;
                    item.addEventListener('click', () => {
                        // User picked an existing company from autocomplete
                        selectEl.value = c.id;
                        selectEl.disabled = false;
                        newInput.value = '';
                        newPanel.style.display = 'none';
                        acList.style.display = 'none';
                    });
                    acList.appendChild(item);
                });
                acList.style.display = 'block';
            }, 300);
        });

        // Hide autocomplete when clicking outside
        document.addEventListener('click', (e) => {
            if (!acList.contains(e.target) && e.target !== newInput) {
                acList.style.display = 'none';
            }
        });
    })();
</script>
}

@if (ViewBag.Files != null)
{
    <form id="deleteCvForm" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cv" asp-route-returnUrl="@Context.Request.Path" method="post" style="display:none;"></form>
    <form id="deleteClForm" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cl" asp-route-returnUrl="@Context.Request.Path" method="post" style="display:none;"></form>
}
