@model AzureTest.Contracts.DTOs.Resumes.UpdateResumeDto
@{
    ViewData["Title"] = "Edit Resume";
}

<nav aria-label="breadcrumb" class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li>
            <a asp-action="Index" class="hover:text-brand-600 transition-colors">Resumes</a>
        </li>
        <li>
            <i class="fa-solid fa-chevron-right text-xs mx-1"></i>
        </li>
        <li>
            <a asp-action="Details" asp-route-id="@Model.Id" class="hover:text-brand-600 transition-colors">@Model.PositionTitle</a>
        </li>
        <li>
            <i class="fa-solid fa-chevron-right text-xs mx-1"></i>
        </li>
        <li class="font-medium text-slate-800" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="max-w-3xl">
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
            <h5 class="text-lg font-semibold text-slate-800 m-0">Edit Resume</h5>
        </div>
        <div class="p-6 md:p-8">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                
                <partial name="_ResumeFormPartial" />
                
                <div class="relative py-6">
                    <div class="absolute inset-0 flex items-center" aria-hidden="true">
                        <div class="w-full border-t border-slate-200"></div>
                    </div>
                    <div class="relative flex justify-start">
                        <span class="pr-3 bg-white text-sm font-medium text-slate-500">Update Attachments</span>
                    </div>
                </div>

                @{
                    var files = ViewBag.Files as AzureTest.Contracts.DTOs.Resumes.ResumeFilesDto;
                }

                @if (files is not null && (files.HasCv || files.HasCoverLetter))
                {
                    <div class="mb-6 bg-slate-50 border border-slate-200 rounded-lg p-4">
                        <h6 class="text-sm font-semibold text-slate-700 mb-3">Current Attachments:</h6>
                        <ul class="space-y-2">
                            @if (files.HasCv)
                            {
                                <li class="flex items-center text-sm">
                                    <span class="font-medium text-slate-600 w-24">CV:</span>
                                    <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv" })" target="_blank" class="text-brand-600 hover:text-brand-800 mr-4 flex-1 truncate">
                                        <i class="fa-solid fa-file-pdf mr-1"></i> @files.CvName
                                    </a>
                                    <button type="submit" form="deleteCvForm" class="text-red-500 hover:text-red-700 text-xs font-medium uppercase tracking-wide" onclick="return confirm('Delete this CV?');">
                                        Remove
                                    </button>
                                </li>
                            }
                            @if (files.HasCoverLetter)
                            {
                                <li class="flex items-center text-sm">
                                    <span class="font-medium text-slate-600 w-24">Cover Letter:</span>
                                    <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl" })" target="_blank" class="text-brand-600 hover:text-brand-800 mr-4 flex-1 truncate">
                                        <i class="fa-solid fa-file-word mr-1"></i> @files.CoverLetterName
                                    </a>
                                    <button type="submit" form="deleteClForm" class="text-red-500 hover:text-red-700 text-xs font-medium uppercase tracking-wide" onclick="return confirm('Delete this Cover Letter?');">
                                        Remove
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <p class="text-xs text-slate-500 mb-4"><i class="fa-solid fa-circle-info mr-1"></i> Uploading new files will overwrite any existing files for this resume.</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div>
                        <label for="cvFile" class="block text-sm font-medium text-slate-700 mb-1">Upload New CV</label>
                        <input type="file" id="cvFile" name="cvFile" 
                               class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100" />
                    </div>
                    <div>
                        <label for="clFile" class="block text-sm font-medium text-slate-700 mb-1">Upload New Cover Letter</label>
                        <input type="file" id="clFile" name="clFile" 
                               class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100" />
                    </div>
                </div>

                <div class="flex items-center space-x-4 pt-4 border-t border-slate-100">
                    <button type="submit" class="inline-flex justify-center rounded-lg border border-transparent bg-brand-600 py-2 px-6 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                        Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex justify-center rounded-lg border border-slate-300 bg-white py-2 px-6 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@if (ViewBag.Files != null)
{
    <form id="deleteCvForm" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cv" asp-route-returnUrl="@Context.Request.Path" method="post" style="display:none;"></form>
    <form id="deleteClForm" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cl" asp-route-returnUrl="@Context.Request.Path" method="post" style="display:none;"></form>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectEl = document.getElementById('companySelect');
        let tsInstance = null;
        
        if (selectEl) {
            tsInstance = new TomSelect(selectEl, {
                create: false,
                sortField: { field: "text", direction: "asc" }
            });
        }

        const toggleBtn = document.getElementById('toggleNewCompany');
        const newPanel  = document.getElementById('newCompanyPanel');
        const newInput  = document.getElementById('newCompanyInput');
        const acList    = document.getElementById('companyAutocomplete');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                const isVisible = newPanel.style.display !== 'none';
                if (isVisible) {
                    newPanel.style.display = 'none';
                    newInput.value = '';
                    if (tsInstance) tsInstance.enable();
                } else {
                    newPanel.style.display = 'block';
                    if (tsInstance) {
                        tsInstance.clear();
                        tsInstance.disable();
                    }
                    newInput.focus();
                }
            });
        }

        if (tsInstance) {
            tsInstance.on('change', function(value) {
                if (value) {
                    newPanel.style.display = 'none';
                    newInput.value = '';
                }
            });
        }

        let debounceTimer;
        if (newInput) {
            newInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                const term = newInput.value.trim();
                if (term.length < 1) { acList.style.display = 'none'; return; }

                debounceTimer = setTimeout(async () => {
                    const res  = await fetch(`/Resume/SearchCompanies?term=${encodeURIComponent(term)}`);
                    const data = await res.json();

                    acList.innerHTML = '';
                    if (data.length === 0) { acList.style.display = 'none'; return; }

                    data.forEach(c => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-brand-600 focus:outline-none focus:bg-slate-50';
                        item.textContent = c.name;
                        item.addEventListener('click', () => {
                            if (tsInstance) {
                                tsInstance.enable();
                                tsInstance.setValue(c.id);
                            }
                            newInput.value = '';
                            newPanel.style.display = 'none';
                            acList.style.display = 'none';
                        });
                        acList.appendChild(item);
                    });
                    acList.style.display = 'block';
                }, 300);
            });
        }

        document.addEventListener('click', (e) => {
            if (acList && !acList.contains(e.target) && e.target !== newInput) {
                acList.style.display = 'none';
            }
        });
    });
    </script>
}
