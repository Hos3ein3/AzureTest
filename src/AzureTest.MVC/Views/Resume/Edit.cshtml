@model AzureTest.Contracts.DTOs.Resumes.UpdateResumeDto
@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Edit Resume";
    var files = ViewBag.Files as AzureTest.Contracts.DTOs.Resumes.ResumeFilesDto;

    var pageHeader = new PageHeaderModel
    {
        Title = "Edit Resume",
        Subtitle = "Update job application details, company association, and PDF documents",
        Icon = "fa-solid fa-pen-to-square",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Resumes", Url.Action("Index", "Resume")),
            new BreadcrumbItem(Model.PositionTitle, Url.Action("Details", "Resume", new { id = Model.Id })),
            new BreadcrumbItem("Edit", active: true)
        }
    };
}

<partial name="UiComponents/_PageHeader" model="pageHeader" />

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    
    <!-- Form Column -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden h-fit">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-800 m-0 flex items-center gap-2">
                <i class="fa-solid fa-briefcase text-brand-600"></i>
                Edit Application
            </h2>
        </div>
        <div class="p-6">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                
                <partial name="_ResumeFormPartial" />
                
                <div class="relative py-4 my-2">
                    <div class="absolute inset-0 flex items-center" aria-hidden="true">
                        <div class="w-full border-t border-slate-200"></div>
                    </div>
                    <div class="relative flex justify-start">
                        <span class="pr-3 bg-white text-2xs font-semibold text-slate-500 uppercase tracking-wider">Update Attachments</span>
                    </div>
                </div>

                @if (files is not null && (files.HasCv || files.HasCoverLetter))
                {
                    <div class="mb-4 bg-slate-50/70 border border-slate-200/80 rounded-xl p-4 shadow-2xs">
                        <h3 class="text-2xs font-semibold uppercase tracking-wider text-slate-500 mb-2.5">Current Attachments</h3>
                        <ul class="space-y-2">
                            @if (files.HasCv)
                            {
                                <li class="flex items-center text-xs">
                                    <span class="font-semibold text-slate-600 w-24">CV:</span>
                                    <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv" })" target="_blank" class="text-brand-600 hover:text-brand-800 mr-4 flex-1 truncate font-medium">
                                        <i class="fa-solid fa-file-pdf mr-1 text-rose-500"></i> @files.CvName
                                    </a>
                                    <button type="submit" form="deleteCvForm" class="text-rose-600 hover:text-rose-800 text-2xs font-bold uppercase tracking-wider" onclick="return confirm('Delete this CV?');">
                                        Remove
                                    </button>
                                </li>
                            }
                            @if (files.HasCoverLetter)
                            {
                                <li class="flex items-center text-xs">
                                    <span class="font-semibold text-slate-600 w-24">Cover Letter:</span>
                                    <a href="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl" })" target="_blank" class="text-brand-600 hover:text-brand-800 mr-4 flex-1 truncate font-medium">
                                        <i class="fa-solid fa-file-word mr-1 text-blue-500"></i> @files.CoverLetterName
                                    </a>
                                    <button type="submit" form="deleteClForm" class="text-rose-600 hover:text-rose-800 text-2xs font-bold uppercase tracking-wider" onclick="return confirm('Delete this Cover Letter?');">
                                        Remove
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <p class="text-2xs text-slate-500 mb-4 flex items-center gap-1.5">
                    <i class="fa-solid fa-circle-info text-brand-500"></i>
                    Uploading new files will replace existing files for this resume.
                </p>
                
                <div class="grid grid-cols-1 gap-4 mb-6">
                    <div>
                        <label for="cvFile" class="block text-xs font-semibold text-slate-700 mb-1.5">Upload New CV (PDF)</label>
                        <input type="file" id="cvFile" name="cvFile" accept=".pdf"
                               class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer" />
                    </div>
                    <div>
                        <label for="clFile" class="block text-xs font-semibold text-slate-700 mb-1.5">Upload New Cover Letter</label>
                        <input type="file" id="clFile" name="clFile" 
                               class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer" />
                    </div>
                </div>

                <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm transition-colors">
                        <i class="fa-solid fa-floppy-disk text-2xs"></i>
                        <span>Save Changes</span>
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors">
                        <span>Cancel</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <!-- Preview Column -->
    <div class="hidden lg:flex flex-col gap-4 sticky top-6" style="height: calc(100vh - 120px);">
        
        <!-- CV Preview -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden flex-1 flex flex-col">
            <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <h3 class="text-xs font-bold text-slate-800 m-0 flex items-center gap-2">
                    <i class="fa-solid fa-file-pdf text-rose-500"></i> CV Preview
                </h3>
            </div>
            <div class="w-full flex-1 p-0 flex items-center justify-center bg-slate-50 relative">
                @if (files != null && files.HasCv && files.CvName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true)
                {
                    <embed id="pdfPreview" class="w-full h-full absolute inset-0" src="@Url.Action("DownloadFile", new { id = Model.Id, type = "cv", inline = true })" type="application/pdf" />
                    <div id="noPreviewMsg" class="hidden text-slate-400 text-center p-6">
                        <i class="fa-regular fa-file-pdf text-3xl mb-2 block"></i>
                        <p class="text-xs">Select a CV (PDF)</p>
                    </div>
                }
                else
                {
                    <embed id="pdfPreview" class="hidden w-full h-full absolute inset-0" src="" type="application/pdf" />
                    <div id="noPreviewMsg" class="text-slate-400 text-center p-6">
                        <i class="fa-regular fa-file-pdf text-3xl mb-2 block"></i>
                        <p class="text-xs">Select a CV (PDF)</p>
                    </div>
                }
            </div>
        </div>
        
        <!-- Cover Letter Preview -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden flex-1 flex flex-col">
            <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <h3 class="text-xs font-bold text-slate-800 m-0 flex items-center gap-2">
                    <i class="fa-solid fa-file-lines text-brand-500"></i> Cover Letter Preview
                </h3>
            </div>
            <div class="w-full flex-1 p-0 flex items-center justify-center bg-slate-50 relative">
                @if (files != null && files.HasCoverLetter && files.CoverLetterName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true)
                {
                    <embed id="pdfPreview2" class="w-full h-full absolute inset-0" src="@Url.Action("DownloadFile", new { id = Model.Id, type = "cl", inline = true })" type="application/pdf" />
                    <div id="noPreviewMsg2" class="hidden text-slate-400 text-center p-6">
                        <i class="fa-regular fa-file-pdf text-3xl mb-2 block"></i>
                        <p class="text-xs">Select a CL (PDF)</p>
                    </div>
                }
                else
                {
                    <embed id="pdfPreview2" class="hidden w-full h-full absolute inset-0" src="" type="application/pdf" />
                    <div id="noPreviewMsg2" class="text-slate-400 text-center p-6">
                        <i class="fa-regular fa-file-pdf text-3xl mb-2 block"></i>
                        <p class="text-xs">Select a CL (PDF)</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@if (files != null)
{
    <form id="deleteCvForm" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cv" asp-route-returnUrl="@Context.Request.Path" method="post" style="display:none;"></form>
    <form id="deleteClForm" asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-type="cl" asp-route-returnUrl="@Context.Request.Path" method="post" style="display:none;"></form>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- Initialize CKEditor ---
        ClassicEditor
            .create(document.querySelector('#Description'))
            .catch(error => { console.error(error); });

        ClassicEditor
            .create(document.querySelector('#Note'))
            .catch(error => { console.error(error); });

        // --- Local PDF Preview ---
        const cvFileInput = document.getElementById('cvFile');
        const clFileInput = document.getElementById('clFile');
        const pdfPreview = document.getElementById('pdfPreview');
        const pdfPreview2 = document.getElementById('pdfPreview2');
        const noPreviewMsg = document.getElementById('noPreviewMsg');
        const noPreviewMsg2 = document.getElementById('noPreviewMsg2');

        cvFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file && file.type === 'application/pdf') {
                const fileURL = URL.createObjectURL(file);
                pdfPreview.src = fileURL;
                pdfPreview.classList.remove('hidden');
                noPreviewMsg.classList.add('hidden');
            } else {
                pdfPreview.src = "";
                pdfPreview.classList.add('hidden');
                noPreviewMsg.classList.remove('hidden');
            }
        });

        clFileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file && file.type === 'application/pdf') {
                const fileURL = URL.createObjectURL(file);
                pdfPreview2.src = fileURL;
                pdfPreview2.classList.remove('hidden');
                noPreviewMsg2.classList.add('hidden');
            } else {
                pdfPreview2.src = "";
                pdfPreview2.classList.add('hidden');
                noPreviewMsg2.classList.remove('hidden');
            }
        });

        // --- TomSelect & Company Search logic ---
        const selectEl = document.getElementById('companySelect');
        let tsInstance = null;
        
        if (selectEl) {
            tsInstance = new TomSelect(selectEl, {
                create: false,
                sortField: { field: "text", direction: "asc" }
            });
        }

        const toggleBtn = document.getElementById('toggleNewCompany');
        const newPanel  = document.getElementById('newCompanyPanel');
        const newInput  = document.getElementById('newCompanyInput');
        const acList    = document.getElementById('companyAutocomplete');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                const isVisible = newPanel.style.display !== 'none';
                if (isVisible) {
                    newPanel.style.display = 'none';
                    newInput.value = '';
                    if (tsInstance) tsInstance.enable();
                } else {
                    newPanel.style.display = 'block';
                    if (tsInstance) {
                        tsInstance.clear();
                        tsInstance.disable();
                    }
                    newInput.focus();
                }
            });
        }

        if (tsInstance) {
            tsInstance.on('change', function(value) {
                if (value) {
                    newPanel.style.display = 'none';
                    newInput.value = '';
                }
            });
        }

        let debounceTimer;
        if (newInput) {
            newInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                const term = newInput.value.trim();
                if (term.length < 1) { acList.style.display = 'none'; return; }

                debounceTimer = setTimeout(async () => {
                    const res  = await fetch(`/Resume/SearchCompanies?term=${encodeURIComponent(term)}`);
                    const data = await res.json();

                    acList.innerHTML = '';
                    if (data.length === 0) { acList.style.display = 'none'; return; }

                    data.forEach(c => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'w-full text-left px-4 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-brand-600 focus:outline-none focus:bg-slate-50';
                        item.textContent = c.name;
                        item.addEventListener('click', () => {
                            if (tsInstance) {
                                tsInstance.enable();
                                tsInstance.setValue(c.id);
                            }
                            newInput.value = '';
                            newPanel.style.display = 'none';
                            acList.style.display = 'none';
                        });
                        acList.appendChild(item);
                    });
                    acList.display = 'block';
                }, 300);
            });
        }

        document.addEventListener('click', (e) => {
            if (acList && !acList.contains(e.target) && e.target !== newInput) {
                acList.style.display = 'none';
            }
        });
    });
    </script>
}
