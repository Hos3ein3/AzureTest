@model AzureTest.Contracts.DTOs.Resumes.IResumeFormDto
@* Shared form fields for Create and Edit Resume views.
   Both CreateResumeDto and UpdateResumeDto implement IResumeFormDto,
   so the parent view can pass either model and asp-for will resolve correctly.
   The parent view owns the <form> tag — this partial only renders the fields.
*@

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="PositionTitle" class="form-label">
            Position Title <span class="text-danger">*</span>
        </label>
        <input asp-for="PositionTitle" class="form-control" placeholder="e.g. Senior Software Engineer" />
        <span asp-validation-for="PositionTitle" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="CreatedOn" class="form-label">Date Applied</label>
        <input asp-for="CreatedOn" class="form-control" type="date" />
        <span asp-validation-for="CreatedOn" class="text-danger small"></span>
    </div>
</div>

@* Company Field *@
<div class="mb-3">
    <label class="form-label">Company</label>

    <div class="input-group">
        <select id="companySelect" name="CompanyId" class="form-select">
            <option value="">— Select existing company —</option>
            @if (ViewBag.Companies != null)
            {
                foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Companies)
                {
                    <option value="@item.Value"
                            selected="@(Model.CompanyId?.ToString() == item.Value)">
                        @item.Text
                    </option>
                }
            }
        </select>
        <button type="button" class="btn btn-outline-secondary" id="toggleNewCompany" title="Add new company">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>

    <div id="newCompanyPanel" class="mt-2" style="display:none;">
        <input type="text" id="newCompanyInput" name="NewCompanyName" class="form-control"
               placeholder="Type new company name..." autocomplete="off" />
        <div id="companyAutocomplete" class="list-group position-absolute z-3 w-100" style="display:none; max-height:200px; overflow-y:auto;"></div>
        <div class="form-text text-muted">
            <i class="bi bi-info-circle"></i>
            If this company already exists it will be linked automatically; otherwise a new one will be created.
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Source" class="form-label">Source</label>
        <select asp-for="Source" class="form-select"
                asp-items="Html.GetEnumSelectList<AzureTest.Domain.Enums.ResumeSource>()">
        </select>
        <span asp-validation-for="Source" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" class="form-select"
                asp-items="Html.GetEnumSelectList<AzureTest.Domain.Enums.ResumeStatus>()">
        </select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Location" class="form-label">Location</label>
    <input asp-for="Location" class="form-control" placeholder="e.g. Remote, New York, NY" />
    <span asp-validation-for="Location" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="JobLink" class="form-label">Job Link</label>
    <input asp-for="JobLink" class="form-control" type="url" placeholder="https://..." />
    <span asp-validation-for="JobLink" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="ChatUrl" class="form-label">Chat Link</label>
    <input asp-for="ChatUrl" class="form-control" type="url" placeholder="https://..." />
    <span asp-validation-for="ChatUrl" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Description</label>
    <textarea asp-for="Description" class="form-control" rows="4"
              placeholder="Job description or notes about the role..."></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mb-4">
    <label asp-for="Note" class="form-label">Personal Notes</label>
    <textarea asp-for="Note" class="form-control" rows="3"
              placeholder="Your thoughts, contact details, etc."></textarea>
    <span asp-validation-for="Note" class="text-danger small"></span>
</div>

@section Scripts {

}
