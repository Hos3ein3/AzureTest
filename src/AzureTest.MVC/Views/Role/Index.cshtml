@model AzureTest.MVC.ViewModels.Roles.RoleListViewModel
@{
    ViewData["Title"] = "Roles & Permissions";
}

<!-- Breadcrumb Component -->
<partial name="UiComponents/_Breadcrumb" model='new List<AzureTest.MVC.Models.BreadcrumbItem> {
    new("Administration", null, "fa-solid fa-shield-halved"),
    new("Roles & Permissions", null, null, IsActive: true)
}' />

<!-- Page Header Component -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs shrink-0">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                    Roles & Permissions
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-100 text-brand-700">@Model.Roles.Count roles</span>
                </h1>
                <p class="text-xs text-slate-500 mt-0.5">Manage system roles, security clearance hierarchy, and granular endpoint access.</p>
            </div>
        </div>
    </div>
    <div class="flex items-center gap-2.5">
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm transition-colors">
            <i class="fa-solid fa-plus text-2xs"></i> Add Role
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-between" role="alert">
        <div class="flex items-center gap-2.5">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span class="text-xs font-semibold text-emerald-900">@TempData["Success"]</span>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 text-xs" onclick="this.parentElement.remove();">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<!-- Table Component -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
        <div>
            <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Configured Roles</h3>
            <p class="text-2xs text-slate-400 mt-0.5">System security roles and their associated permission profiles</p>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-700 border-collapse">
            <thead class="bg-slate-50 text-2xs uppercase tracking-wider text-slate-500 border-b border-slate-200 select-none">
                <tr>
                    <th class="px-5 py-3.5 font-bold">Role Name</th>
                    <th class="px-5 py-3.5 font-bold">Role ID</th>
                    <th class="px-5 py-3.5 text-right font-bold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model.Roles.Any())
                {
                    foreach (var role in Model.Roles)
                    {
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="px-5 py-3.5 font-bold text-slate-900 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center text-xs">
                                    <i class="fa-solid fa-shield"></i>
                                </div>
                                <span>@role.Name</span>
                            </td>
                            <td class="px-5 py-3.5 text-slate-500">
                                <span class="font-mono text-xs bg-slate-100 px-2 py-1 rounded-lg border border-slate-200">@role.Id</span>
                            </td>
                            <td class="px-5 py-3.5 text-right space-x-1">
                                <a asp-controller="Permission" asp-action="RolePermissions" asp-route-roleName="@role.Name" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-brand-50 hover:border-brand-200 text-slate-700 hover:text-brand-600 font-semibold transition-colors shadow-2xs">
                                    <i class="fa-solid fa-key text-2xs"></i>
                                    <span>Permissions</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="p-0">
                            <partial name="UiComponents/_EmptyState" model='new AzureTest.MVC.Models.EmptyStateModel("No Roles Defined", "Get started by adding your first security role.", "fa-solid fa-shield-halved", "Add Role", Url.Action("Create"))' />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
