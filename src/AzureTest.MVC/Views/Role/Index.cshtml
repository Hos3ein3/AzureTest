@model AzureTest.MVC.ViewModels.Roles.RoleListViewModel
@{
    ViewData["Title"] = "Roles & Permissions";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Roles & Permissions</h1>
    
    <div class="flex items-center space-x-4">
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Role
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200 flex items-start" role="alert">
        <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 mr-3"></i>
        <div class="flex-1">
            <p class="text-sm text-emerald-800 font-medium">@TempData["Success"]</p>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 focus:outline-none" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-4xl">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Role Name</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">ID</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @foreach (var role in Model.Roles)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <i class="fa-solid fa-shield-halved text-slate-400 mr-3"></i>
                                <span class="text-sm font-medium text-slate-900">@role.Name</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                            <span class="font-mono text-xs bg-slate-100 px-2 py-1 rounded">@role.Id</span>
                        </td>
                    </tr>
                }
                
                @if (!Model.Roles.Any())
                {
                    <tr>
                        <td colspan="2" class="px-6 py-10 text-center text-slate-500">
                            No roles defined in the system.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
