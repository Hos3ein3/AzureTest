@model AzureTest.Contracts.DTOs.Companies.CompanyDto
@{
    ViewData["Title"] = "Delete Company";
}

<h1 class="text-danger">Delete Company</h1>
<h3>Are you sure you want to delete this company?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-3">Company Name</dt>
    <dd class="col-sm-9">@Model.CompanyName</dd>

    <dt class="col-sm-3">KVK Number</dt>
    <dd class="col-sm-9">@Model.KvkNumber</dd>

    <dt class="col-sm-3">IND Member</dt>
    <dd class="col-sm-9">
        @if (Model.IsINDMember)
        {
            <span class="badge bg-success">Yes</span>
        }
        else
        {
            <span class="badge bg-secondary">No</span>
        }
    </dd>
</dl>

<form asp-action="Delete" method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
