@model IEnumerable<AzureTest.Contracts.DTOs.Habits.HabitTrackerDto>
@{
    ViewData["Title"] = "Habit Tracker";
}

<nav aria-label="breadcrumb" class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li class="font-medium text-slate-800" aria-current="page">Habits</li>
    </ol>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Habits List -->
    <div class="lg:col-span-2 space-y-6">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-8 text-center text-slate-500">
                <i class="fa-solid fa-seedling text-4xl mb-3 text-brand-400 block"></i>
                <p class="font-medium text-slate-700">No habits tracked yet.</p>
                <p class="text-sm text-slate-400 mt-1">Start building good routines today with the form on the right!</p>
            </div>
        }
        
        @foreach(var h in Model)
        {
            var isDone = h.IsCompletedToday;
            var todayStr = DateTime.UtcNow.ToString("yyyy-MM-dd");

            <div class="bg-white rounded-xl shadow-sm border @(isDone ? "border-emerald-200 bg-emerald-50/20" : "border-slate-100") p-6 relative transition-all">
                
                <div class="flex justify-between items-start gap-4">
                    <div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@h.Id" class="text-lg font-semibold text-slate-800 hover:text-brand-600 transition-colors">
                                @h.Name
                            </a>
                            
                            <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-medium">
                                @h.Type
                            </span>

                            @if (h.Target.HasValue)
                            {
                                <span class="text-xs px-2 py-0.5 rounded-full @(h.Direction == AzureTest.Domain.Enums.HabitDirection.AtLeast ? "bg-blue-50 text-blue-700" : "bg-amber-50 text-amber-700")">
                                    @(h.Direction == AzureTest.Domain.Enums.HabitDirection.AtLeast ? "≥ At least" : "≤ At most") @h.Target
                                </span>
                            }

                            @if (h.CurrentStreak > 0)
                            {
                                <span class="inline-flex items-center text-xs font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full" title="Current streak: @h.CurrentStreak days">
                                    <i class="fa-solid fa-fire text-amber-500 mr-1"></i> @h.CurrentStreak streak
                                </span>
                            }

                            @if (h.LongestStreak > 0)
                            {
                                <span class="inline-flex items-center text-xs font-medium text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full" title="Longest streak: @h.LongestStreak days">
                                    <i class="fa-solid fa-trophy text-indigo-500 mr-1"></i> Best: @h.LongestStreak
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(h.Description))
                        {
                            <p class="text-sm text-slate-500 mt-1">@h.Description</p>
                        }
                    </div>

                    <div class="flex items-center gap-2">
                        <a asp-action="Details" asp-route-id="@h.Id" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-brand-50 hover:text-brand-600 font-medium text-slate-600 transition-colors flex items-center gap-1" title="View details and analytics">
                            <i class="fa-solid fa-chart-line"></i> Details
                        </a>
                        <button type="button" onclick="openEditHabitModal({ id: '@h.Id', name: '@Html.Raw(h.Name.Replace("'", "\\'"))', description: '@Html.Raw((h.Description ?? "").Replace("'", "\\'").Replace("\r", "").Replace("\n", "\\n"))', type: '@h.Type', direction: '@h.Direction', frequency: '@h.Frequency', target: '@(h.Target?.ToString() ?? "")', typeConfig: '@Html.Raw((h.TypeConfig ?? "").Replace("'", "\\'"))', isPrivate: @(h.IsPrivate ? "true" : "false"), isArchived: @(h.IsArchived ? "true" : "false") })" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-50 hover:text-blue-600 font-medium text-slate-600 transition-colors flex items-center gap-1" title="Edit Habit">
                            <i class="fa-solid fa-pen-to-square"></i> Edit
                        </button>
                        <button type="button" onclick="openDeleteHabitModal('@h.Id', '@Html.Raw(h.Name.Replace("'", "\\'"))')" class="text-slate-400 hover:text-rose-500 transition-colors p-1" title="Delete Habit">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>

                <!-- Type-Specific Today Log Section -->
                <div class="mt-4 pt-4 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Log Today (@DateTime.UtcNow.ToString("MMM dd"))</p>
                        @if (isDone)
                        {
                            <span class="text-xs font-medium text-emerald-600 flex items-center gap-1">
                                <i class="fa-solid fa-circle-check"></i> Goal Achieved!
                            </span>
                        }
                    </div>

                    @* 1. BOOLEAN *@
                    @if (h.Type == AzureTest.Domain.Enums.HabitType.Boolean)
                    {
                        <form asp-action="Log" method="post" class="flex items-center gap-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <input type="hidden" name="booleanValue" value="@(isDone ? "false" : "true")" />
                            
                            <button type="submit" class="flex items-center justify-center w-10 h-10 rounded-full @(isDone ? "bg-emerald-500 text-white shadow-md shadow-emerald-200" : "bg-slate-100 text-slate-400 hover:bg-brand-50 hover:text-brand-600") transition-all">
                                <i class="fa-solid fa-check text-base"></i>
                            </button>
                            <span class="text-sm font-medium @(isDone ? "text-emerald-700" : "text-slate-500")">
                                @(isDone ? "Completed Today! (Click to undo)" : "Mark as completed")
                            </span>
                        </form>
                    }
                    @* 2. COUNTER *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Counter)
                    {
                        <div class="flex items-center gap-4 flex-wrap">
                            <div class="flex items-center gap-2">
                                <form asp-action="Log" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@h.Id" />
                                    <input type="hidden" name="numericValue" value="1" />
                                    <button type="submit" class="px-4 py-2 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700 transition-colors shadow-sm inline-flex items-center gap-2">
                                        <i class="fa-solid fa-plus"></i> +1 Click
                                    </button>
                                </form>

                                @if (h.TodayNumericValue > 0)
                                {
                                    <form asp-action="Undo" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <button type="submit" class="px-3 py-2 bg-slate-100 text-slate-600 text-sm font-medium rounded-lg hover:bg-rose-50 hover:text-rose-600 transition-colors inline-flex items-center gap-1.5" title="Undo latest click">
                                            <i class="fa-solid fa-rotate-left"></i> Undo
                                        </button>
                                    </form>
                                }
                            </div>

                            <div class="text-sm text-slate-600">
                                Count today: <strong class="text-slate-800 text-base">@h.TodayNumericValue</strong>
                                @if (h.Target.HasValue && h.Target.Value > 0)
                                {
                                    <span class="text-slate-400">/ @h.Target.Value</span>
                                }
                            </div>
                        </div>
                    }
                    @* 3. QUANTITY *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Quantity)
                    {
                        <form asp-action="Log" method="post" class="flex items-center gap-3 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <div class="flex items-center gap-2">
                                <input type="number" step="any" name="numericValue" value="@(h.TodayNumericValue > 0 ? h.TodayNumericValue : "")" placeholder="0" class="w-28 rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border" />
                                @if (h.Target.HasValue)
                                {
                                    <span class="text-sm text-slate-500">/ @h.Target.Value @(!string.IsNullOrEmpty(h.TypeConfig) ? h.TypeConfig : "")</span>
                                }
                                else if (!string.IsNullOrEmpty(h.TypeConfig))
                                {
                                    <span class="text-sm text-slate-500">@h.TypeConfig</span>
                                }
                            </div>
                            <input type="text" name="notes" placeholder="Notes (optional)" class="flex-1 min-w-[150px] rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border" />
                            <button type="submit" class="px-4 py-2 bg-slate-800 text-white text-sm font-medium rounded-lg hover:bg-slate-700 transition-colors">Save</button>
                        </form>
                    }
                    @* 4. DURATION *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Duration)
                    {
                        <form asp-action="Log" method="post" class="flex items-center gap-3 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <div class="flex items-center gap-2">
                                <input type="number" step="1" name="numericValue" value="@(h.TodayNumericValue > 0 ? h.TodayNumericValue : "")" placeholder="Seconds" class="w-28 rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border" />
                                <span class="text-sm text-slate-500">sec @(h.Target.HasValue ? $"(Target: {h.Target.Value}s)" : "")</span>
                            </div>
                            <input type="text" name="notes" placeholder="Notes (optional)" class="flex-1 min-w-[150px] rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border" />
                            <button type="submit" class="px-4 py-2 bg-slate-800 text-white text-sm font-medium rounded-lg hover:bg-slate-700 transition-colors">Save</button>
                        </form>
                    }
                    @* 5. RATING *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Rating)
                    {
                        <form asp-action="Log" method="post" class="flex items-center gap-3 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <div class="flex items-center gap-1.5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var activeStar = h.TodayNumericValue >= i;
                                    <button type="submit" name="numericValue" value="@i" class="w-8 h-8 rounded-lg border @(activeStar ? "bg-amber-400 border-amber-400 text-white shadow-sm" : "bg-slate-50 border-slate-200 text-slate-400 hover:bg-amber-50 hover:text-amber-500") flex items-center justify-center font-bold text-sm transition-colors">
                                        @i
                                    </button>
                                }
                            </div>
                            @if (h.Target.HasValue)
                            {
                                <span class="text-sm text-slate-500">Target: @h.Target.Value <i class="fa-solid fa-star text-amber-400"></i></span>
                            }
                        </form>
                    }
                    @* 6. TIME OF DAY *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.TimeOfDay)
                    {
                        <form asp-action="Log" method="post" class="flex items-center gap-3 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <input type="time" name="value" value="@h.TodayValue" class="rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border" />
                            <input type="text" name="notes" placeholder="Notes (optional)" class="flex-1 min-w-[150px] rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border" />
                            <button type="submit" class="px-4 py-2 bg-slate-800 text-white text-sm font-medium rounded-lg hover:bg-slate-700 transition-colors">Save Time</button>
                        </form>
                    }
                    @* 7. CHECKLIST *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Checklist)
                    {
                        var checklistItems = (!string.IsNullOrWhiteSpace(h.TypeConfig) ? h.TypeConfig.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) : new[] { "Sub-item 1", "Sub-item 2" });
                        var checkedItems = (h.TodayValue ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                        <form asp-action="Log" method="post" class="space-y-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                @foreach (var item in checklistItems)
                                {
                                    var isItemChecked = checkedItems.Contains(item);
                                    <label class="flex items-center gap-2 p-2 rounded-lg border border-slate-200 bg-slate-50/50 hover:bg-slate-100 cursor-pointer text-sm text-slate-700">
                                        <input type="checkbox" name="checklist_item" value="@item" @(isItemChecked ? "checked" : "") onchange="updateChecklist(this)" class="rounded text-brand-600 focus:ring-brand-500" />
                                        <span>@item</span>
                                    </label>
                                }
                            </div>
                            <input type="hidden" name="value" id="checklist-val-@h.Id" value="@h.TodayValue" />
                            <button type="submit" class="px-4 py-1.5 bg-slate-800 text-white text-xs font-medium rounded-lg hover:bg-slate-700 transition-colors">Save Checklist</button>
                        </form>
                    }
                    @* 8. QUIT / ABSTINENCE *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Quit)
                    {
                        <div class="flex items-center justify-between flex-wrap gap-4">
                            <div class="flex items-center gap-2">
                                <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-lg font-semibold text-sm flex items-center gap-1.5">
                                    <i class="fa-solid fa-shield-halved text-emerald-600"></i> @h.TodayValue
                                </span>
                            </div>

                            <form asp-action="Log" method="post" onsubmit="return confirm('Record a relapse? Your streak will reset.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@h.Id" />
                                <input type="hidden" name="value" value="relapse" />
                                <input type="hidden" name="numericValue" value="1" />
                                <button type="submit" class="px-3 py-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 text-xs font-semibold rounded-lg transition-colors">
                                    Log Relapse (Reset)
                                </button>
                            </form>
                        </div>
                    }
                    @* 9. CHOICE *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Choice)
                    {
                        var options = (!string.IsNullOrWhiteSpace(h.TypeConfig) ? h.TypeConfig.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) : new[] { "Option A", "Option B", "Option C" });

                        <form asp-action="Log" method="post" class="flex items-center gap-2 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            @foreach (var opt in options)
                            {
                                var isOptSelected = h.TodayValue == opt;
                                <button type="submit" name="value" value="@opt" class="px-3 py-1.5 rounded-lg text-xs font-medium border @(isOptSelected ? "bg-brand-600 border-brand-600 text-white" : "bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100") transition-colors">
                                    @opt
                                </button>
                            }
                        </form>
                    }
                    @* 10. TEXT / NOTE *@
                    else if (h.Type == AzureTest.Domain.Enums.HabitType.Text)
                    {
                        <form asp-action="Log" method="post" class="space-y-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@h.Id" />
                            <textarea name="value" rows="2" placeholder="Write today's reflection or notes..." class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border">@h.TodayValue</textarea>
                            <button type="submit" class="px-4 py-1.5 bg-slate-800 text-white text-xs font-medium rounded-lg hover:bg-slate-700 transition-colors">Save Note</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Create Habit Form -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden sticky top-6">
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <h5 class="text-sm font-semibold text-slate-800 m-0"><i class="fa-solid fa-plus mr-2 text-brand-500"></i> New Habit</h5>
            </div>
            <div class="p-6">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Habit Name <span class="text-rose-500">*</span></label>
                        <input type="text" name="name" id="habitName" required class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="e.g. Read 10 pages, Meditate, Drink Water" />
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
                        <textarea name="description" id="habitDescription" rows="2" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="Why is this habit important to you?"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Tracking Type <span class="text-rose-500">*</span></label>
                        <select name="type" id="habitType" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" onchange="onHabitTypeChanged(this.value)">
                            <option value="Boolean">Boolean (Yes/No)</option>
                            <option value="Counter">Counter (+1 per click, undo)</option>
                            <option value="Quantity">Quantity (number + unit)</option>
                            <option value="Numeric">Numeric</option>
                            <option value="Duration">Duration (timer, seconds)</option>
                            <option value="Rating">Rating/scale (min-max)</option>
                            <option value="TimeOfDay">Time of day (e.g. wake up)</option>
                            <option value="Checklist">Checklist (sub-items)</option>
                            <option value="Quit">Quit / abstinence</option>
                            <option value="Choice">Choice (single option)</option>
                            <option value="Text">Text / note</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Direction</label>
                            <select name="direction" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border">
                                <option value="AtLeast">At least (≥)</option>
                                <option value="AtMost">At most (≤)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Frequency</label>
                            <select name="frequency" id="habitFrequency" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-3 py-2 border">
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly">Monthly</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Target / Goal <span class="text-xs text-slate-400 font-normal">(Optional)</span></label>
                        <input type="number" step="any" name="target" id="habitGoal" placeholder="Optional target (e.g. 1)" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" />
                    </div>

                    <div class="mb-4" id="configContainer">
                        <label class="block text-sm font-medium text-slate-700 mb-1" id="configLabel">Type-Specific Config</label>
                        <input type="text" name="typeConfig" id="typeConfig" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="e.g. Unit (ml, km), or options (comma-separated)" />
                    </div>

                    <div class="mb-6 flex items-center gap-2">
                        <input type="checkbox" name="isPrivate" id="isPrivate" value="true" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                        <label for="isPrivate" class="text-sm text-slate-600 cursor-pointer">Private Habit (only visible to you)</label>
                    </div>
                    
                    <button type="submit" data-habit="create-btn" class="w-full inline-flex justify-center items-center rounded-lg border border-transparent bg-brand-600 py-2.5 px-4 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                        Add Habit
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Habit Confirmation Modal -->
<div id="deleteHabitModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600 sm:mx-0 sm:h-10 sm:w-10">
                            <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                            <h3 class="text-base font-bold text-slate-900" id="modal-title">Delete Habit</h3>
                            <div class="mt-2">
                                <p class="text-sm text-slate-500">Are you sure you want to permanently delete <strong id="deleteHabitName" class="text-slate-800"></strong>? All logged history and calculated streaks will also be deleted.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2">
                    <form id="deleteHabitForm" asp-action="Delete" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="deleteHabitId" value="" />
                        <button type="submit" class="inline-flex w-full justify-center rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500 sm:w-auto transition-colors">
                            Delete Habit
                        </button>
                    </form>
                    <button type="button" onclick="closeDeleteHabitModal()" class="mt-3 inline-flex w-full justify-center rounded-xl bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto transition-colors">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Habit Modal -->
<div id="editHabitModal" class="relative z-50 hidden" aria-labelledby="edit-modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                    <h3 class="text-base font-bold text-slate-900" id="edit-modal-title"><i class="fa-solid fa-pen-to-square text-brand-600 mr-2"></i> Edit Habit</h3>
                    <button type="button" onclick="closeEditHabitModal()" class="text-slate-400 hover:text-slate-600 p-1">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <form asp-action="Edit" method="post" class="p-6 space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="editHabitId" />

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Habit Name <span class="text-rose-500">*</span></label>
                        <input type="text" name="name" id="editHabitName" required class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-4 py-2 border" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Description</label>
                        <textarea name="description" id="editHabitDescription" rows="2" class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-4 py-2 border"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tracking Type</label>
                            <select name="type" id="editHabitType" class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-3 py-2 border">
                                <option value="Boolean">Boolean (Yes/No)</option>
                                <option value="Counter">Counter (+1 per click, undo)</option>
                                <option value="Quantity">Quantity (number + unit)</option>
                                <option value="Numeric">Numeric</option>
                                <option value="Duration">Duration (timer, seconds)</option>
                                <option value="Rating">Rating/scale (min-max)</option>
                                <option value="TimeOfDay">Time of day (e.g. wake up)</option>
                                <option value="Checklist">Checklist (sub-items)</option>
                                <option value="Quit">Quit / abstinence</option>
                                <option value="Choice">Choice (single option)</option>
                                <option value="Text">Text / note</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Direction</label>
                            <select name="direction" id="editHabitDirection" class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-3 py-2 border">
                                <option value="AtLeast">At least (≥)</option>
                                <option value="AtMost">At most (≤)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Frequency</label>
                            <select name="frequency" id="editHabitFrequency" class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-3 py-2 border">
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Monthly">Monthly</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Target / Goal <span class="text-xs text-slate-400 font-normal">(Optional)</span></label>
                            <input type="number" step="any" name="target" id="editHabitTarget" placeholder="e.g. 5 (leave blank if none)" class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-3 py-2 border" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Type-Specific Config</label>
                        <input type="text" name="typeConfig" id="editHabitTypeConfig" class="w-full rounded-xl border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm px-4 py-2 border" placeholder="e.g. Unit (ml, km) or options" />
                    </div>

                    <div class="flex items-center gap-6 pt-2">
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" name="isPrivate" id="editHabitIsPrivate" value="true" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                            <span>Private Habit</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" name="isArchived" id="editHabitIsArchived" value="true" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                            <span>Archived</span>
                        </label>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
                        <button type="button" onclick="closeEditHabitModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                            Cancel
                        </button>
                        <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function onHabitTypeChanged(type) {
        const configLabel = document.getElementById('configLabel');
        const configInput = document.getElementById('typeConfig');
        const goalInput = document.getElementById('habitGoal');

        if (type === 'Quantity' || type === 'Numeric') {
            configLabel.textContent = 'Unit (e.g. ml, km, pages)';
            configInput.placeholder = 'e.g. ml, km, pages';
            if (!goalInput.value) goalInput.value = '10';
        } else if (type === 'Duration') {
            configLabel.textContent = 'Unit / Preset';
            configInput.placeholder = 'e.g. seconds, minutes';
            if (!goalInput.value) goalInput.value = '1800';
        } else if (type === 'Rating') {
            configLabel.textContent = 'Scale Range (min-max)';
            configInput.placeholder = 'e.g. 1-5';
            goalInput.value = '4';
        } else if (type === 'Checklist') {
            configLabel.textContent = 'Sub-items (comma separated)';
            configInput.placeholder = 'e.g. Floss, Brush teeth, Mouthwash';
            goalInput.value = '3';
        } else if (type === 'Choice') {
            configLabel.textContent = 'Choice Options (comma separated)';
            configInput.placeholder = 'e.g. Great, Neutral, Poor';
            goalInput.value = '1';
        } else if (type === 'Counter') {
            configLabel.textContent = 'Step Size / Daily Limit (optional)';
            configInput.placeholder = 'e.g. step=1, limit=10';
            goalInput.value = '5';
        } else if (type === 'Quit') {
            configLabel.textContent = 'Quit Target Description';
            configInput.placeholder = 'e.g. Smoke-free, Caffeine-free';
            goalInput.value = '';
        } else {
            configLabel.textContent = 'Type-Specific Config (optional)';
            configInput.placeholder = '';
            goalInput.value = '';
        }
    }

    function updateChecklist(checkbox) {
        const form = checkbox.closest('form');
        const checkboxes = form.querySelectorAll('input[type="checkbox"]:checked');
        const checkedValues = Array.from(checkboxes).map(cb => cb.value).join(',');
        const hiddenInput = form.querySelector('input[name="value"]');
        if (hiddenInput) {
            hiddenInput.value = checkedValues;
        }
    }

    function openDeleteHabitModal(id, name) {
        document.getElementById('deleteHabitId').value = id;
        document.getElementById('deleteHabitName').textContent = name;
        document.getElementById('deleteHabitModal').classList.remove('hidden');
    }

    function closeDeleteHabitModal() {
        document.getElementById('deleteHabitModal').classList.add('hidden');
    }

    function openEditHabitModal(habit) {
        document.getElementById('editHabitId').value = habit.id;
        document.getElementById('editHabitName').value = habit.name;
        document.getElementById('editHabitDescription').value = habit.description || '';
        document.getElementById('editHabitType').value = habit.type;
        document.getElementById('editHabitDirection').value = habit.direction;
        document.getElementById('editHabitFrequency').value = habit.frequency;
        document.getElementById('editHabitTarget').value = habit.target || '';
        document.getElementById('editHabitTypeConfig').value = habit.typeConfig || '';
        document.getElementById('editHabitIsPrivate').checked = habit.isPrivate;
        document.getElementById('editHabitIsArchived').checked = habit.isArchived;
        document.getElementById('editHabitModal').classList.remove('hidden');
    }

    function closeEditHabitModal() {
        document.getElementById('editHabitModal').classList.add('hidden');
    }
</script>
