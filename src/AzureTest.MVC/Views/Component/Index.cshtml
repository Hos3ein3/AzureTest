@using AzureTest.MVC.Models
@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Dashboards.UnifiedComponentDto>
@{
    ViewData["Title"] = "Dashboard Components";
    var categories = ViewBag.AllCategories as List<string> ?? new List<string>();

    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Dashboard Builder", Url.Action("Manage", "Dashboard"), "fa-solid fa-layer-group"),
        new BreadcrumbItem("Components", null, "fa-solid fa-puzzle-piece", true)
    };

    var headerModel = new PageHeaderModel(
        "Dashboard Components",
        "Manage standard and raw dynamic components available in the dashboard builder.",
        "fa-solid fa-puzzle-piece",
        new HeaderAction("Add Component", "javascript:openAddModal()", "fa-solid fa-plus", "primary")
    );
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-7xl space-y-6">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-3 shadow-xs">
            <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
            <span class="text-sm font-semibold">@TempData["Success"]</span>
        </div>
    }

    <!-- Search / Filter Card -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <form asp-action="Index" method="get">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                <div class="md:col-span-4">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Search</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>
                        <input name="search" type="text" value="@ViewBag.CurrentSearch"
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400"
                               placeholder="Search components by name..." />
                    </div>
                </div>

                <div class="md:col-span-3">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Category</label>
                    <select name="category"
                            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            var selected = ViewBag.Category == cat ? "selected" : null;
                            <option value="@cat" selected="@selected">@cat</option>
                        }
                    </select>
                </div>

                <div class="md:col-span-3">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Type</label>
                    <select name="type"
                            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800">
                        <option value="">All Types</option>
                        <option value="Standard" selected="@(ViewBag.CurrentType == "Standard" ? "selected" : null)">Standard View</option>
                        <option value="RawHtml" selected="@(ViewBag.CurrentType == "RawHtml" ? "selected" : null)">Raw HTML</option>
                        <option value="JsonConfig" selected="@(ViewBag.CurrentType == "JsonConfig" ? "selected" : null)">JSON Config</option>
                    </select>
                </div>

                <div class="md:col-span-2 flex items-center gap-2">
                    <button type="submit"
                            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-200">
                        <i class="fa-solid fa-filter"></i> Filter
                    </button>
                    <a asp-action="Index"
                       class="inline-flex items-center justify-center p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-800 rounded-xl transition-all"
                       title="Clear Filters">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-slate-50/80 border-b border-slate-200 text-slate-500 text-xs font-semibold uppercase tracking-wider">
                    <tr>
                        <th scope="col" class="px-6 py-4">
                            <a asp-action="Index" asp-route-sort="Name" asp-route-dir="@(ViewBag.CurrentSort == "Name" && ViewBag.CurrentDir == "asc" ? "desc" : "asc")" asp-route-search="@ViewBag.CurrentSearch" asp-route-category="@ViewBag.Category" asp-route-type="@ViewBag.CurrentType"
                               class="group inline-flex items-center gap-1.5 hover:text-slate-800">
                                <span>Component</span>
                                <span class="rounded bg-slate-200/80 text-slate-700 px-1 py-0.5 text-[10px]">
                                    <i class="fa-solid fa-sort"></i>
                                </span>
                            </a>
                        </th>
                        <th scope="col" class="px-6 py-4">Type</th>
                        <th scope="col" class="px-6 py-4">Category</th>
                        <th scope="col" class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/70 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-slate-900">@item.Name</div>
                                    <div class="text-xs text-slate-500 line-clamp-1">@item.Description</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.Type == "Standard")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <i class="fa-solid fa-shapes text-[10px]"></i> Standard View
                                        </span>
                                    }
                                    else if (item.Type == "RawHtml")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                                            <i class="fa-solid fa-code text-[10px]"></i> Raw HTML
                                        </span>
                                    }
                                    else if (item.Type == "JsonConfig")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full bg-purple-50 text-purple-700 border border-purple-200">
                                            <i class="fa-solid fa-chart-simple text-[10px]"></i> JSON Config
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-100 text-slate-700">
                                            @item.Type
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-600 font-medium">
                                    @(string.IsNullOrEmpty(item.Category) ? "General" : item.Category)
                                </td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    @if (item.IsRaw)
                                    {
                                        <a asp-controller="RawComponent" asp-action="Edit" asp-route-id="@item.Id"
                                           class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-amber-700 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 rounded-lg transition" title="Edit">
                                            <i class="fa-solid fa-pen text-[10px]"></i> Edit
                                        </a>
                                        <form asp-controller="RawComponent" asp-action="Duplicate" asp-route-id="@item.Id" method="post" class="inline">
                                            <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 rounded-lg transition" title="Duplicate">
                                                <i class="fa-solid fa-copy text-[10px]"></i> Clone
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Component" asp-action="Edit" asp-route-id="@item.Id"
                                           class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-amber-700 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 rounded-lg transition" title="Edit">
                                            <i class="fa-solid fa-pen text-[10px]"></i> Edit
                                        </a>
                                        @if (item.Type != "Standard")
                                        {
                                            <form asp-controller="Component" asp-action="Duplicate" asp-route-id="@item.Id" method="post" class="inline">
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 rounded-lg transition" title="Duplicate">
                                                    <i class="fa-solid fa-copy text-[10px]"></i> Clone
                                                </button>
                                            </form>
                                        }
                                    }
                                    <button type="button" onclick="openDeleteModal('@item.Id', @item.IsRaw.ToString().ToLower())"
                                            class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition" title="Delete">
                                        <i class="fa-solid fa-trash text-[10px]"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-500">
                                <i class="fa-solid fa-puzzle-piece text-3xl text-slate-300 mb-2 block"></i>
                                <p class="text-sm font-semibold text-slate-800">No components found</p>
                                <p class="text-xs text-slate-400 mt-1">Try adjusting your search criteria or register a new component.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            var paginationModel = new PaginationModel(
                (int)ViewBag.CurrentPage,
                (int)ViewBag.TotalPages,
                Model.PageSize,
                Model.TotalCount,
                p => Url.Action("Index", new { page = p, sort = ViewBag.CurrentSort, dir = ViewBag.CurrentDir, search = ViewBag.CurrentSearch, category = ViewBag.Category, type = ViewBag.CurrentType }) ?? $"#page={p}"
            );
            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                <partial name="UiComponents/_Pagination" model="paginationModel" />
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:w-full sm:max-w-lg p-6 sm:p-8 space-y-6">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0 text-xl">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900" id="modal-title">Delete Component</h3>
                        <p class="text-xs text-slate-500 mt-1">Are you sure you want to delete this component? It will be permanently removed from all user dashboards.</p>
                    </div>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeDeleteModal()" class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition">Cancel</button>
                    <button type="button" id="confirmDeleteBtn" class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-sm transition">Delete Component</button>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="delete-modal-form" method="post">
    @Html.AntiForgeryToken()
</form>

<!-- Add Modal -->
<div id="addModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4 text-center">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:w-full sm:max-w-lg p-6 sm:p-8 space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-900">New Component Type</h3>
                            <p class="text-xs text-slate-400">Select how this component should be created.</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeAddModal()" class="text-slate-400 hover:text-slate-600">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <div class="space-y-3">
                    <a href="/Component/Create" class="block p-4 border border-slate-200/80 rounded-2xl hover:border-brand-500 hover:bg-brand-50/30 transition group">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-sm text-slate-900 group-hover:text-brand-600">Standard View Component</span>
                            <i class="fa-solid fa-shapes text-slate-400 group-hover:text-brand-600"></i>
                        </div>
                        <p class="text-xs text-slate-500 mt-1">Requires an existing Razor Partial View in the codebase.</p>
                    </a>

                    <a href="/RawComponent/Create?type=RawHtml" class="block p-4 border border-slate-200/80 rounded-2xl hover:border-brand-500 hover:bg-brand-50/30 transition group">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-sm text-slate-900 group-hover:text-brand-600">Raw HTML / JS Widget</span>
                            <i class="fa-solid fa-code text-blue-500"></i>
                        </div>
                        <p class="text-xs text-slate-500 mt-1">Embed custom HTML, styles, and JavaScript directly.</p>
                    </a>

                    <a href="/RawComponent/Create?type=JsonConfig" class="block p-4 border border-slate-200/80 rounded-2xl hover:border-brand-500 hover:bg-brand-50/30 transition group">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-sm text-slate-900 group-hover:text-brand-600">JSON Configured Widget</span>
                            <i class="fa-solid fa-chart-simple text-purple-500"></i>
                        </div>
                        <p class="text-xs text-slate-500 mt-1">Supply JSON data and schema configuration for charts and metrics.</p>
                    </a>
                </div>

                <div class="flex justify-end pt-2">
                    <button type="button" onclick="closeAddModal()" class="px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        function openDeleteModal(id, isRaw = false) {
            if (isRaw) {
                document.getElementById('delete-modal-form').action = '/RawComponent/Delete/' + id;
            } else {
                document.getElementById('delete-modal-form').action = '/Component/Delete/' + id;
            }
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            document.getElementById('delete-modal-form').submit();
        });
    </script>
}
