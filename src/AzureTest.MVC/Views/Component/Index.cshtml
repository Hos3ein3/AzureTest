@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Domain.Documents.DashboardComponent>
@{
    ViewData["Title"] = "Manage Components";
    
    string GetSortLink(string sortBy, string label)
    {
        var currentSort = ViewBag.SortBy as string;
        var sortDesc = ViewBag.SortDescending as bool? ?? false;
        
        var isCurrentSort = currentSort?.Equals(sortBy, StringComparison.OrdinalIgnoreCase) ?? (sortBy == "Name");
        var desc = isCurrentSort ? !sortDesc : false;
        var icon = isCurrentSort ? (sortDesc ? "fa-sort-down text-brand-600" : "fa-sort-up text-brand-600") : "fa-sort text-slate-300";
        var url = $"?PageNumber=1&PageSize={Model.PageSize}&SearchTerm={ViewBag.SearchTerm}&Category={ViewBag.Category}&SortBy={sortBy}&SortDescending={desc}";
        
        return $@"<a href=""{url}"" class=""group inline-flex items-center hover:text-slate-700 transition-colors"">{label} <i class=""fa-solid {icon} ml-1""></i></a>";
    }

    string GetPageUrl(int pageNumber)
    {
        return $"?PageNumber={pageNumber}&PageSize={Model.PageSize}&SearchTerm={ViewBag.SearchTerm}&Category={ViewBag.Category}&SortBy={ViewBag.SortBy}&SortDescending={ViewBag.SortDescending}";
    }
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Dashboard Components</h1>
        <p class="text-sm text-slate-500">Manage available widgets for the dashboard builder.</p>
    </div>
    <button type="button" onclick="openAddModal()" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors">
        <i class="fa-solid fa-plus mr-2"></i> Add Component
    </button>
</div>

<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-800">Filter Components</h3>
    </div>
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Search</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@ViewBag.SearchTerm" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" placeholder="Name, View..." />
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Category</label>
                <input name="Category" type="text" value="@ViewBag.Category" class="block w-full pl-3 pr-3 py-2 text-base border border-slate-300 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm rounded-lg" placeholder="e.g. Analytics" />
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Page Size</label>
                <select name="PageSize" class="block w-full pl-3 pr-10 py-2 text-base border border-slate-300 focus:outline-none focus:ring-brand-500 focus:border-brand-500 sm:text-sm rounded-lg">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size" selected>@size items</option>
                        }
                        else
                        {
                            <option value="@size">@size items</option>
                        }
                    }
                </select>
            </div>
            
            <div class="flex items-end space-x-2">
                <button type="submit" class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-slate-800 hover:bg-slate-900 focus:outline-none transition-colors">
                    <i class="fa-solid fa-filter mr-2"></i> Apply
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 focus:outline-none transition-colors" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 p-4 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 text-sm font-medium flex items-center justify-between">
        <div><i class="fa-solid fa-circle-check mr-2"></i> @TempData["Success"]</div>
        <button type="button" onclick="this.parentElement.style.display='none';" class="text-emerald-500 hover:text-emerald-700 focus:outline-none">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<div class="bg-white shadow-sm ring-1 ring-slate-200 rounded-xl overflow-hidden flex flex-col">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase sm:pl-6">@Html.Raw(GetSortLink("Name", "Name"))</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">@Html.Raw(GetSortLink("Category", "Category"))</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">@Html.Raw(GetSortLink("PartialViewName", "Partial View"))</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Size (W x H)</th>
                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-xs font-semibold text-slate-500 uppercase">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
                @foreach (var item in Model.Items)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6 flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath" class="h-8 w-12 object-contain bg-slate-100 rounded border border-slate-200" />
                            }
                            else
                            {
                                <div class="h-8 w-12 flex items-center justify-center bg-slate-100 rounded border border-slate-200 text-slate-400">
                                    <i class="fa-solid fa-image text-xs"></i>
                                </div>
                            }
                            <span>@item.Name</span>
                        </td>
                        <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                            @item.Category
                        </td>
                        <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                            <code class="text-xs bg-slate-100 text-slate-600 px-1 py-0.5 rounded">@item.PartialViewName</code>
                        </td>
                        <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                            @item.DefaultWidth x @item.DefaultHeight
                        </td>
                        <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                            <div class="flex justify-end gap-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-slate-600 hover:text-brand-600" title="Edit Component">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button type="button" onclick="openDeleteModal('@item.Id')" class="text-red-500 hover:text-red-700" title="Delete Component">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-slate-500">
                            No components found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="bg-white px-4 py-3 border-t border-slate-200 sm:px-6 flex items-center justify-between">
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-700">
                        Showing <span class="font-medium">@(((Model.PageNumber - 1) * Model.PageSize) + 1)</span>
                        to <span class="font-medium">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span>
                        of <span class="font-medium">@Model.TotalCount</span> results
                    </p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                        @{
                            var prevDisabled = !Model.HasPreviousPage ? "pointer-events-none text-slate-300" : "text-slate-500 hover:bg-slate-50";
                            var nextDisabled = !Model.HasNextPage ? "pointer-events-none text-slate-300" : "text-slate-500 hover:bg-slate-50";
                        }
                        <a href="@GetPageUrl(Model.PageNumber - 1)" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-slate-300 bg-white text-sm font-medium @prevDisabled">
                            <span class="sr-only">Previous</span>
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                        
                        @{
                            int window = 2; // Show 2 pages on each side of the current page
                            int startPage = Math.Max(1, Model.PageNumber - window);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + window);
                            
                            if (startPage > 1)
                            {
                                <a href="@GetPageUrl(1)" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">1</a>
                                if (startPage > 2)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700">...</span>
                                }
                            }
                            
                            for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == Model.PageNumber)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-brand-500 bg-brand-50 text-sm font-medium text-brand-600 z-10">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@GetPageUrl(i)" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">
                                        @i
                                    </a>
                                }
                            }
                            
                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700">...</span>
                                }
                                <a href="@GetPageUrl(Model.TotalPages)" class="relative inline-flex items-center px-4 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">@Model.TotalPages</a>
                            }
                        }

                        <a href="@GetPageUrl(Model.PageNumber + 1)" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-slate-300 bg-white text-sm font-medium @nextDisabled">
                            <span class="sr-only">Next</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

@{
    var rawComponents = ViewBag.RawComponents as IReadOnlyList<AzureTest.Domain.Documents.DashboardRawComponent>;
}
@if (rawComponents != null && rawComponents.Any())
{
    <div class="mt-8 mb-6 flex justify-between items-center">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Dynamic Components</h2>
            <p class="text-sm text-slate-500">Manage raw HTML/JS and JSON configurations.</p>
        </div>
    </div>
    
    <div class="bg-white shadow-sm ring-1 ring-slate-200 rounded-xl overflow-hidden flex flex-col mb-8">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold text-slate-500 uppercase sm:pl-6">Name</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Type</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase">Category</th>
                        <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-right text-xs font-semibold text-slate-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    @foreach (var item in rawComponents)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-slate-900 sm:pl-6">
                                @item.Name
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                @if (item.Type == "RawHtml")
                                {
                                    <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">HTML/JS</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">JSON Config</span>
                                }
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                @item.Category
                            </td>
                            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                <div class="flex justify-end gap-3">
                                    <a asp-controller="RawComponent" asp-action="Edit" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-900" title="Edit Component">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" onclick="openDeleteModal('@item.Id', true)" class="text-red-500 hover:text-red-700" title="Delete Component">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Delete Modal -->
<div id="deleteModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-500 bg-opacity-75 transition-opacity"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                            <i class="fa-solid fa-triangle-exclamation text-red-600"></i>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                            <h3 class="text-base font-semibold leading-6 text-slate-900" id="modal-title">Delete Component</h3>
                            <div class="mt-2">
                                <p class="text-sm text-slate-500">Are you sure you want to permanently delete this component? It will be removed from all users' dashboards.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                    <button type="button" id="confirmDeleteBtn" class="inline-flex w-full justify-center rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto">Delete</button>
                    <button type="button" onclick="closeDeleteModal()" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="delete-modal-form" method="post">
    @Html.AntiForgeryToken()
</form>

<div id="addModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-500 bg-opacity-75 transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 sm:mx-0 sm:h-10 sm:w-10">
                            <i class="fa-solid fa-plus text-brand-600"></i>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                            <h3 class="text-base font-semibold leading-6 text-slate-900" id="modal-title">What type of component do you want to create?</h3>
                            <div class="mt-4 space-y-3">
                                <a href="/Component/Create" class="block w-full text-left px-4 py-3 border border-slate-200 rounded-lg hover:bg-slate-50 hover:border-brand-300 transition-colors">
                                    <p class="font-medium text-slate-900">Standard View Component</p>
                                    <p class="text-xs text-slate-500 mt-1">Requires a developer to create a CHTML Partial View in the codebase.</p>
                                </a>
                                <a href="/RawComponent/Create?type=RawHtml" class="block w-full text-left px-4 py-3 border border-slate-200 rounded-lg hover:bg-slate-50 hover:border-brand-300 transition-colors">
                                    <p class="font-medium text-slate-900">Raw HTML/JS Widget</p>
                                    <p class="text-xs text-slate-500 mt-1">Inject custom HTML and JavaScript securely.</p>
                                </a>
                                <a href="/RawComponent/Create?type=JsonConfig" class="block w-full text-left px-4 py-3 border border-slate-200 rounded-lg hover:bg-slate-50 hover:border-brand-300 transition-colors">
                                    <p class="font-medium text-slate-900">JSON Config Widget</p>
                                    <p class="text-xs text-slate-500 mt-1">Provide a JSON configuration to render dynamic charts via API.</p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                    <button type="button" onclick="closeAddModal()" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        function openDeleteModal(id, isRaw = false) {
            if (isRaw) {
                document.getElementById('delete-modal-form').action = '/RawComponent/Delete/' + id;
            } else {
                document.getElementById('delete-modal-form').action = '/Component/Delete/' + id;
            }
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            document.getElementById('delete-modal-form').submit();
        });
    </script>
}
