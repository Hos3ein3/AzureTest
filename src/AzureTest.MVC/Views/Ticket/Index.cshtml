@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Tickets.TicketDto, AzureTest.Contracts.DTOs.Tickets.GetAllTicketsFilters>
@{
    ViewData["Title"] = "Tickets";
    bool isAdmin = ViewBag.IsAdmin == true;
    string? currentStatus = ViewBag.Status as string;
    string? currentPriority = ViewBag.Priority as string;
    string? currentSortBy = ViewBag.SortBy as string ?? "date";
    string? currentSortOrder = ViewBag.SortOrder as string ?? "desc";
    int pageSize = ViewBag.PageSize is int ps ? ps : 10;

    string GetSortUrl(string field)
    {
        string newOrder = (currentSortBy == field && currentSortOrder == "asc") ? "desc" : "asc";
        return $"?page=1&pageSize={pageSize}&status={currentStatus}&priority={currentPriority}&sortBy={field}&sortOrder={newOrder}";
    }

    string GetSortIcon(string field)
    {
        if (currentSortBy == field)
        {
            return currentSortOrder == "asc" ? "fa-solid fa-arrow-up-short-wide text-brand-600 ml-1" : "fa-solid fa-arrow-down-wide-short text-brand-600 ml-1";
        }
        return "fa-solid fa-sort text-slate-300 ml-1 hover:text-slate-500";
    }

    string BuildPageUrl(int targetPage)
    {
        return $"?page={targetPage}&pageSize={pageSize}&status={currentStatus}&priority={currentPriority}&sortBy={currentSortBy}&sortOrder={currentSortOrder}";
    }
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Support Tickets</h1>
    @if (!isAdmin)
    {
        <div class="flex items-center space-x-4">
            <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
                <i class="fa-solid fa-plus mr-2"></i> Open New Ticket
            </a>
        </div>
    }
</div>

<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-800">Filter Tickets</h3>
    </div>
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Search</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@(ViewBag.Filters?.SearchTerm)" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg leading-5 bg-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500 sm:text-sm" placeholder="Subject or content..." />
                </div>
            </div>
            <!-- Status Filter -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
                <select name="status" class="block w-full px-3 py-2 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetNames<AzureTest.Domain.Enums.TicketStatus>())
                    {
                        if (string.Equals(currentStatus, s, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>

            <!-- Priority Filter -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Priority</label>
                <select name="priority" class="block w-full px-3 py-2 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                    <option value="">All Priorities</option>
                    @foreach (var p in Enum.GetNames<AzureTest.Domain.Enums.TicketPriority>())
                    {
                        if (string.Equals(currentPriority, p, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Sort By</label>
                <select name="sortBy" class="block w-full px-3 py-2 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                    @if (currentSortBy == "date") { <option value="date" selected>Date Opened</option> } else { <option value="date">Date Opened</option> }
                    @if (currentSortBy == "subject") { <option value="subject" selected>Subject</option> } else { <option value="subject">Subject</option> }
                    @if (currentSortBy == "priority") { <option value="priority" selected>Priority</option> } else { <option value="priority">Priority</option> }
                    @if (currentSortBy == "status") { <option value="status" selected>Status</option> } else { <option value="status">Status</option> }
                </select>
            </div>

            <!-- Sort Direction & Page Size -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Order & Size</label>
                <div class="grid grid-cols-2 gap-2">
                    <select name="sortOrder" class="block w-full px-2 py-2 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                        @if (currentSortOrder == "desc")
                        {
                            <option value="desc" selected>Desc</option>
                            <option value="asc">Asc</option>
                        }
                        else
                        {
                            <option value="asc" selected>Asc</option>
                            <option value="desc">Desc</option>
                        }
                    </select>
                    <select name="pageSize" class="block w-full px-2 py-2 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                        @foreach (var size in new[] { 10, 25, 50 })
                        {
                            if (pageSize == size)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-end space-x-2">
                <button type="submit" class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-slate-800 hover:bg-slate-900 transition-colors">
                    <i class="fa-solid fa-filter mr-2"></i> Filter
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center px-3.5 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors" title="Reset Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Main Table Card -->
<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-slate-800 m-0">@(isAdmin ? "All Support Tickets" : "Your Tickets")</h5>
        <span class="text-xs text-slate-500">Total: <strong class="text-slate-700 font-semibold">@Model.TotalCount</strong> ticket@(Model.TotalCount == 1 ? "" : "s")</span>
    </div>
    
    @if (!Model.Items.Any())
    {
        <div class="p-12 text-center text-slate-500">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-4">
                <i class="fa-solid fa-ticket text-3xl text-slate-400"></i>
            </div>
            <h3 class="text-base font-semibold text-slate-800 mb-1">No tickets found</h3>
            <p class="text-sm text-slate-500">Try adjusting your filters or open a new support ticket.</p>
            @if (!string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(currentPriority))
            {
                <div class="mt-4">
                    <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-brand-600 hover:text-brand-700">
                        <i class="fa-solid fa-xmark mr-1.5"></i> Clear all filters
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-slate-600">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50/50 border-b border-slate-100">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-medium">
                            <a href="@GetSortUrl("subject")" class="inline-flex items-center hover:text-slate-900 transition-colors">
                                Subject <i class="@GetSortIcon("subject")"></i>
                            </a>
                        </th>
                        <th scope="col" class="px-6 py-3 font-medium">
                            <a href="@GetSortUrl("priority")" class="inline-flex items-center hover:text-slate-900 transition-colors">
                                Priority <i class="@GetSortIcon("priority")"></i>
                            </a>
                        </th>
                        <th scope="col" class="px-6 py-3 font-medium">
                            <a href="@GetSortUrl("status")" class="inline-flex items-center hover:text-slate-900 transition-colors">
                                Status <i class="@GetSortIcon("status")"></i>
                            </a>
                        </th>
                        <th scope="col" class="px-6 py-3 font-medium">
                            <a href="@GetSortUrl("date")" class="inline-flex items-center hover:text-slate-900 transition-colors">
                                Date Opened <i class="@GetSortIcon("date")"></i>
                            </a>
                        </th>
                        <th scope="col" class="px-6 py-3 font-medium text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var t in Model.Items)
                    {
                        var unread = !isAdmin && t.Messages.Any(m => m.UserId != t.UserId && !m.IsReadByCreator);
                        
                        <tr class="bg-white hover:bg-slate-50/70 transition-colors @(unread ? "bg-brand-50/30" : "")">
                            <td class="px-6 py-4 font-medium text-slate-800 whitespace-nowrap flex items-center">
                                @if (unread)
                                {
                                    <span class="w-2.5 h-2.5 rounded-full bg-brand-500 mr-2.5 animate-pulse" title="Unread Messages"></span>
                                }
                                <a asp-action="Details" asp-route-id="@t.Id" class="hover:text-brand-600 transition-colors">
                                    @t.Subject
                                </a>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full 
                                    @(t.Priority == AzureTest.Domain.Enums.TicketPriority.Low ? "bg-slate-100 text-slate-700" :
                                      t.Priority == AzureTest.Domain.Enums.TicketPriority.Medium ? "bg-blue-100 text-blue-700" :
                                      t.Priority == AzureTest.Domain.Enums.TicketPriority.High ? "bg-orange-100 text-orange-700" :
                                      "bg-red-100 text-red-700")">
                                    <i class="fa-solid fa-circle text-[8px] mr-1 opacity-70"></i>@t.Priority
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full 
                                    @(t.Status == AzureTest.Domain.Enums.TicketStatus.Closed ? "bg-slate-100 text-slate-600" :
                                      t.Status == AzureTest.Domain.Enums.TicketStatus.Answered ? "bg-brand-100 text-brand-700" :
                                      t.Status == AzureTest.Domain.Enums.TicketStatus.InProgress ? "bg-indigo-100 text-indigo-700" :
                                      "bg-emerald-100 text-emerald-700")">
                                    @t.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                @t.CreatedOn.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right">
                                <a asp-action="Details" asp-route-id="@t.Id" class="inline-flex items-center text-brand-600 hover:text-brand-800 font-medium">
                                    View <i class="fa-solid fa-chevron-right text-xs ml-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="bg-white px-6 py-4 border-t border-slate-100 flex items-center justify-between">
            <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-600">
                        Showing <span class="font-semibold text-slate-800">@(((Model.PageNumber - 1) * Model.PageSize) + 1)</span>
                        to <span class="font-semibold text-slate-800">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span>
                        of <span class="font-semibold text-slate-800">@Model.TotalCount</span> results
                    </p>
                </div>
                <div>
                    <nav class="relative z-0 inline-flex rounded-lg shadow-sm -space-x-px" aria-label="Pagination">
                        @{
                            var prevDisabled = !Model.HasPreviousPage ? "pointer-events-none text-slate-300 bg-slate-50" : "text-slate-600 hover:bg-slate-50 bg-white";
                            var nextDisabled = !Model.HasNextPage ? "pointer-events-none text-slate-300 bg-slate-50" : "text-slate-600 hover:bg-slate-50 bg-white";
                        }
                        
                        <!-- Previous Page -->
                        <a href="@BuildPageUrl(Model.PageNumber - 1)" class="relative inline-flex items-center px-3 py-2 rounded-l-lg border border-slate-300 text-sm font-medium @prevDisabled" title="Previous Page">
                            <span class="sr-only">Previous</span>
                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </a>

                        @{
                            int window = 2;
                            int startPage = Math.Max(1, Model.PageNumber - window);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + window);

                            if (startPage > 1)
                            {
                                <a href="@BuildPageUrl(1)" class="relative inline-flex items-center px-3.5 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">1</a>
                                if (startPage > 2)
                                {
                                    <span class="relative inline-flex items-center px-3 py-2 border border-slate-300 bg-slate-50 text-sm font-medium text-slate-400">...</span>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == Model.PageNumber)
                                {
                                    <span class="relative inline-flex items-center px-3.5 py-2 border border-brand-500 bg-brand-50 text-sm font-semibold text-brand-600 z-10">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@BuildPageUrl(i)" class="relative inline-flex items-center px-3.5 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">
                                        @i
                                    </a>
                                }
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="relative inline-flex items-center px-3 py-2 border border-slate-300 bg-slate-50 text-sm font-medium text-slate-400">...</span>
                                }
                                <a href="@BuildPageUrl(Model.TotalPages)" class="relative inline-flex items-center px-3.5 py-2 border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50">@Model.TotalPages</a>
                            }
                        }

                        <!-- Next Page -->
                        <a href="@BuildPageUrl(Model.PageNumber + 1)" class="relative inline-flex items-center px-3 py-2 rounded-r-lg border border-slate-300 text-sm font-medium @nextDisabled" title="Next Page">
                            <span class="sr-only">Next</span>
                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>
