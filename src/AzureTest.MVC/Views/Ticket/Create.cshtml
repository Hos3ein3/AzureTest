@using AzureTest.MVC.Models
@using AzureTest.Domain.Enums
@{
    ViewData["Title"] = "Open Ticket";
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Support Tickets", Url.Action("Index"), "fa-solid fa-headset"),
        new BreadcrumbItem("Open Ticket", null, "fa-solid fa-plus", true)
    };

    var headerModel = new PageHeaderModel(
        "Open Support Ticket",
        "Describe your inquiry or problem. Our support team will assist you shortly.",
        "fa-solid fa-headset",
        new HeaderAction("Back to Tickets", Url.Action("Index"), "fa-solid fa-arrow-left", "secondary")
    );
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-4xl space-y-6">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="md:col-span-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Subject <span class="text-rose-500">*</span></label>
                    <input type="text" name="subject" required
                           class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-semibold text-slate-800 placeholder:text-slate-400"
                           placeholder="Brief summary of the issue or inquiry..." />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Priority</label>
                    <select name="priority"
                            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-semibold text-slate-800">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                        <option value="Urgent">Urgent</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Description <span class="text-rose-500">*</span></label>
                <div class="border border-slate-200 rounded-2xl shadow-sm overflow-hidden bg-white">
                    <textarea id="contentEditor" name="content" rows="6" class="w-full border-none focus:ring-0"></textarea>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl transition">
                    Cancel
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition">
                    <i class="fa-solid fa-paper-plane"></i> Submit Ticket
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            ClassicEditor
                .create(document.querySelector('#contentEditor'))
                .catch(error => { console.error(error); });
        });
    </script>
}
