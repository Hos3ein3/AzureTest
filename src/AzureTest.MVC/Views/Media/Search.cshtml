@using AzureTest.Contracts.DTOs.Media
@using AzureTest.Domain.Media.Enums
@using AzureTest.MVC.Models
@model IReadOnlyList<TmdbSearchResultDto>

@{
    ViewData["Title"] = "Search TMDb";
    string searchQuery = ViewBag.SearchQuery ?? string.Empty;
    string searchType = ViewBag.SearchType ?? "all";

    var headerModel = new PageHeaderModel(
        Title: "Search TMDb",
        Subtitle: "Search millions of movies, series, anime, and creative talent.",
        Icon: "fa-solid fa-magnifying-glass",
        Badge: !string.IsNullOrWhiteSpace(searchQuery) ? $"{Model.Count} Results" : "Live Search",
        ActionText: "Explore Discover",
        ActionUrl: Url.Action("Discover", "Media"),
        ActionIcon: "fa-solid fa-compass"
    );



    string ProfileUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";
}

<div class="space-y-6">
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <!-- Search Input Form -->
    <form method="get" asp-action="Search" class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-3">
        <div class="flex items-center gap-2">
            <div class="relative flex-1">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="q" value="@searchQuery" placeholder="Search by title, director, or actor name..." autofocus
                       class="w-full pl-9 pr-3 py-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
            </div>
            <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5 shadow-2xs">
                <i class="fa-solid fa-magnifying-glass text-2xs"></i>
                <span>Search</span>
            </button>
        </div>

        <!-- Filter Tabs -->
        <div class="flex items-center gap-2 text-xs">
            <span class="text-slate-400 font-medium">Filter:</span>
            <label class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl cursor-pointer transition-colors @(searchType == "all" ? "bg-slate-900 text-white font-semibold" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                <input type="radio" name="searchType" value="all" onchange="this.form.submit()" class="hidden" checked="@(searchType == "all")" />
                <span>All</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl cursor-pointer transition-colors @(searchType == "titles" ? "bg-slate-900 text-white font-semibold" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                <input type="radio" name="searchType" value="titles" onchange="this.form.submit()" class="hidden" checked="@(searchType == "titles")" />
                <span>Movies & Series</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl cursor-pointer transition-colors @(searchType == "people" ? "bg-slate-900 text-white font-semibold" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                <input type="radio" name="searchType" value="people" onchange="this.form.submit()" class="hidden" checked="@(searchType == "people")" />
                <span>Actors & Directors</span>
            </label>
        </div>
    </form>

    <!-- Results Display -->
    @if (string.IsNullOrWhiteSpace(searchQuery))
    {
        var emptyModel = new EmptyStateModel(
            Title: "Start Searching",
            Description: "Type any movie name, TV show, anime, or favorite actor into the search box above.",
            Icon: "fa-solid fa-magnifying-glass"
        );
        <partial name="UiComponents/_EmptyState" model="emptyModel" />
    }
    else if (!Model.Any())
    {
        var emptyModel = new EmptyStateModel(
            Title: "No Results Found",
            Description: $"We could not find anything matching '{searchQuery}'. Try another keyword or check spelling.",
            Icon: "fa-solid fa-face-frown-open",
            ActionText: "Discover Popular Instead",
            ActionUrl: Url.Action("Discover", "Media")
        );
        <partial name="UiComponents/_EmptyState" model="emptyModel" />
    }
    else
    {
        var people = Model.Where(m => m.IsPerson).ToList();
        var titles = Model.Where(m => !m.IsPerson).ToList();

        @if (people.Any())
        {
            <div class="space-y-3">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-users"></i>
                    </span>
                    <h3 class="text-sm font-bold text-slate-900">People (@people.Count)</h3>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                    @foreach (var person in people)
                    {
                        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden p-3 flex flex-col items-center text-center shadow-2xs hover:shadow-md transition-all group">
                            <img src="@ProfileUrl(person.PosterPath)" alt="@person.Title"
                                 class="w-20 h-20 rounded-full object-cover mb-2 border-2 border-slate-100 group-hover:scale-105 transition-transform" />
                            <a asp-action="PersonDetails" asp-route-id="@person.Id" class="text-xs font-bold text-slate-900 hover:text-brand-600 line-clamp-1 transition-colors">
                                @person.Title
                            </a>
                            <span class="text-3xs text-slate-400 mb-3">@(person.Department ?? "Acting")</span>

                            <div class="w-full flex items-center gap-1.5 mt-auto">
                                <a asp-action="PersonDetails" asp-route-id="@person.Id"
                                   class="flex-1 py-1 px-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-3xs font-semibold text-center transition-colors">
                                    Filmography
                                </a>
                                <form asp-action="FollowPerson" asp-controller="Media" method="post" class="flex-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="TmdbPersonId" value="@person.Id" />
                                    <input type="hidden" name="Name" value="@person.Title" />
                                    <input type="hidden" name="Department" value="@(person.Department ?? "Acting")" />
                                    <input type="hidden" name="ProfilePath" value="@person.PosterPath" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="w-full py-1 px-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-3xs font-semibold transition-colors" title="Follow this person">
                                        <i class="fa-solid fa-heart mr-1"></i> Follow
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (titles.Any())
        {
            <div class="space-y-3">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-film"></i>
                    </span>
                    <h3 class="text-sm font-bold text-slate-900">Movies, Series & Anime (@titles.Count)</h3>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                    @foreach (var title in titles)
                    {
                        @await Html.PartialAsync("_DiscoverCard", (title, Context.Request.Path + Context.Request.QueryString))
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Reusable Quick Add Modal -->
<div id="quickAddModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeQuickAddModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl p-6 space-y-5 border border-slate-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center">
                        <i class="fa-solid fa-plus text-base"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900">Add to Watchlist</h3>
                        <p id="modalItemTitle" class="text-xs text-slate-500 truncate max-w-[220px]">Title</p>
                    </div>
                </div>
                <button type="button" onclick="closeQuickAddModal()" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form asp-action="Add" asp-controller="Media" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalTmdbId" name="TmdbId" value="" />
                <input type="hidden" id="modalType" name="Type" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Choose Status</label>
                    <select name="InitialStatus" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">
                        <option value="@WatchStatus.PlanToWatch" selected>Want to Watch (Wishlist)</option>
                        <option value="@WatchStatus.Watching">Currently Watching</option>
                        <option value="@WatchStatus.Completed">Finished</option>
                        <option value="@WatchStatus.Dropped">Stopped</option>
                    </select>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeQuickAddModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-semibold transition-colors shadow-2xs">
                        <i class="fa-solid fa-check mr-1.5 text-2xs"></i> Save to Watchlist
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openQuickAddModal(id, type, title) {
        document.getElementById('modalTmdbId').value = id;
        document.getElementById('modalType').value = type;
        document.getElementById('modalItemTitle').innerText = title;
        document.getElementById('quickAddModal').classList.remove('hidden');
    }

    function closeQuickAddModal() {
        document.getElementById('quickAddModal').classList.add('hidden');
    }
</script>
