@using AzureTest.Contracts.DTOs.Media
@using AzureTest.Domain.Media.Enums
@using AzureTest.MVC.Models
@model FollowedPersonDto

@{
    ViewData["Title"] = Model.Name;
    var isFollowed = Model.Id != Guid.Empty;

    string ProfileUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";

    string PosterUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=400&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";

    var breadcrumbs = new List<BreadcrumbItem>
    {
        new("Media", Url.Action("Index", "Media")),
        new("Actors & Directors", Url.Action("People", "Media")),
        new(Model.Name, null, IsActive: true)
    };
}

<div class="space-y-8">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />

    <!-- Profile Hero Card -->
    <div class="bg-white rounded-3xl p-6 md:p-8 border border-slate-200 shadow-2xs flex flex-col md:flex-row gap-6 items-start">
        <img src="@ProfileUrl(Model.ProfilePath)" alt="@Model.Name"
             class="w-36 h-36 md:w-48 md:h-48 rounded-2xl object-cover border-2 border-slate-100 shadow-md mx-auto md:mx-0 flex-shrink-0" />

        <div class="flex-1 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">@Model.Name</h1>
                        <span class="px-2.5 py-1 rounded-xl text-xs font-bold uppercase bg-purple-50 text-purple-600 border border-purple-100">
                            @Model.KnownForDepartment
                        </span>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mt-1">
                        @if (Model.Birthday.HasValue)
                        {
                            <span>
                                <i class="fa-regular fa-cake-candles mr-1 text-slate-400"></i>
                                Born @Model.Birthday.Value.ToString("MMM dd, yyyy")
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PlaceOfBirth))
                        {
                            <span>
                                <i class="fa-solid fa-location-dot mr-1 text-slate-400"></i>
                                @Model.PlaceOfBirth
                            </span>
                        }
                    </div>
                </div>

                <!-- Follow / Unfollow Form -->
                <div>
                    @if (isFollowed)
                    {
                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1.5 rounded-xl bg-purple-50 text-purple-700 text-xs font-bold flex items-center gap-1.5 border border-purple-200">
                                <i class="fa-solid fa-check text-2xs"></i> Following
                            </span>
                            <form asp-action="UnfollowPerson" asp-controller="Media" method="post" onsubmit="return confirm('Stop following @Model.Name?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="FollowedPersonId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 text-xs font-semibold transition-colors">
                                    Unfollow
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form asp-action="FollowPerson" asp-controller="Media" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TmdbPersonId" value="@Model.TmdbPersonId" />
                            <input type="hidden" name="Name" value="@Model.Name" />
                            <input type="hidden" name="Department" value="@Model.KnownForDepartment" />
                            <input type="hidden" name="ProfilePath" value="@Model.ProfilePath" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                                <i class="fa-solid fa-heart mr-1"></i> Follow @Model.Name
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- Filmography Completion Banner -->
            <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-slate-800 flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-check text-emerald-600 text-xs"></i>
                        <span>Your Filmography Progress</span>
                    </span>
                    <span class="font-bold text-brand-600">
                        @Model.WatchedCount of @Model.TotalCreditsCount watched (@Model.ProgressPercentage%)
                    </span>
                </div>
                <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
                    <div class="h-full bg-brand-600 rounded-full transition-all duration-500" style="width: @(Model.ProgressPercentage)%"></div>
                </div>
            </div>

            <!-- Biography -->
            @if (!string.IsNullOrWhiteSpace(Model.Biography))
            {
                <div class="text-xs text-slate-600 leading-relaxed max-w-3xl">
                    <p class="line-clamp-4 hover:line-clamp-none transition-all">@Model.Biography</p>
                </div>
            }
        </div>
    </div>

    <!-- Upcoming Projects Alert -->
    @if (Model.UpcomingProjects.Any())
    {
        <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-5 space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center text-sm shadow-2xs">
                    <i class="fa-solid fa-bell animate-bounce"></i>
                </span>
                <div>
                    <h3 class="text-sm font-bold text-amber-950">New & Upcoming Projects (@Model.UpcomingProjects.Count)</h3>
                    <p class="text-xs text-amber-800">Add these upcoming movies or series to your wishlist.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-1">
                @foreach (var proj in Model.UpcomingProjects)
                {
                    <div class="bg-white/80 backdrop-blur-xs p-3 rounded-xl border border-amber-200/60 flex items-center gap-3">
                        <img src="@PosterUrl(proj.PosterPath)" alt="@proj.Title" class="w-12 h-16 rounded-lg object-cover flex-shrink-0" />
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-slate-900 truncate">@proj.Title</h4>
                            <p class="text-3xs text-slate-500 truncate">Role: @(proj.CharacterOrJob ?? "Cast")</p>
                            <p class="text-3xs font-semibold text-amber-700 mt-1">
                                <i class="fa-regular fa-calendar mr-1"></i>@(proj.ReleaseDate?.ToString("MMM yyyy") ?? "Release Date TBA")
                            </p>
                        </div>
                        <form asp-action="Add" asp-controller="Media" method="post" class="flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TmdbId" value="@proj.Id" />
                            <input type="hidden" name="Type" value="@proj.Type" />
                            <input type="hidden" name="Title" value="@proj.Title" />
                            <input type="hidden" name="PosterPath" value="@proj.PosterPath" />
                            <input type="hidden" name="Status" value="@WatchStatus.PlanToWatch" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-3xs font-bold transition-colors" title="Add to Wishlist">
                                <i class="fa-solid fa-bookmark mr-1"></i> Wishlist
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Full Filmography Section -->
    <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-film"></i>
                </span>
                <div>
                    <h3 class="text-base font-bold text-slate-900">Complete Filmography</h3>
                    <p class="text-xs text-slate-500">All movies, series, and appearances ordered by release date.</p>
                </div>
            </div>

            <!-- Quick Filter Pill Buttons (JavaScript based) -->
            <div class="flex items-center gap-1.5 text-xs font-semibold">
                <button type="button" onclick="filterCredits('all')" class="credit-filter px-3 py-1.5 rounded-xl bg-slate-900 text-white transition-colors" data-filter="all">
                    All (@Model.Filmography.Count)
                </button>
                <button type="button" onclick="filterCredits('watched')" class="credit-filter px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors" data-filter="watched">
                    Watched (@Model.WatchedCount)
                </button>
                <button type="button" onclick="filterCredits('unwatched')" class="credit-filter px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors" data-filter="unwatched">
                    Unwatched (@(Model.TotalCreditsCount - Model.WatchedCount))
                </button>
            </div>
        </div>

        <!-- Credits Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="creditsGrid">
            @foreach (var credit in Model.Filmography)
            {
                <div class="credit-card group relative bg-white rounded-2xl border @(credit.IsWatched ? "border-emerald-300 ring-2 ring-emerald-500/20" : "border-slate-200") overflow-hidden shadow-2xs hover:shadow-md transition-all flex flex-col justify-between"
                     data-watched="@credit.IsWatched.ToString().ToLower()">
                    <div class="relative aspect-2/3 bg-slate-900 overflow-hidden">
                        <img src="@PosterUrl(credit.PosterPath)" alt="@credit.Title"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             loading="lazy" />

                        <!-- Top Badges -->
                        <div class="absolute top-2 left-2 flex flex-col gap-1">
                            @if (credit.IsWatched)
                            {
                                <span class="px-2 py-0.5 rounded-lg text-3xs font-bold bg-emerald-600 text-white flex items-center gap-1 shadow-xs">
                                    <i class="fa-solid fa-check text-3xs"></i> Watched
                                </span>
                            }
                        </div>

                        @if (credit.VoteAverage.HasValue && credit.VoteAverage > 0)
                        {
                            <div class="absolute top-2 right-2 px-1.5 py-0.5 rounded-lg bg-slate-900/80 backdrop-blur-xs text-amber-400 text-3xs font-bold flex items-center gap-1">
                                <i class="fa-solid fa-star text-3xs"></i>
                                <span>@credit.VoteAverage.Value.ToString("0.0")</span>
                            </div>
                        }

                        <!-- Overlay on Hover -->
                        <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-2.5 gap-1.5">
                            <a asp-action="Details" asp-controller="Media" asp-route-id="@credit.Id" asp-route-type="@credit.Type"
                               class="w-full py-1.5 rounded-xl bg-white text-slate-900 text-3xs font-bold text-center hover:bg-slate-100 transition-colors">
                                <i class="fa-solid fa-circle-info mr-1"></i> Details
                            </a>
                            @if (!credit.IsWatched)
                            {
                                <form asp-action="Add" asp-controller="Media" method="post" class="w-full">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="TmdbId" value="@credit.Id" />
                                    <input type="hidden" name="Type" value="@credit.Type" />
                                    <input type="hidden" name="Title" value="@credit.Title" />
                                    <input type="hidden" name="PosterPath" value="@credit.PosterPath" />
                                    <input type="hidden" name="Status" value="@WatchStatus.PlanToWatch" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="w-full py-1.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-3xs font-bold transition-colors">
                                        <i class="fa-solid fa-plus mr-1"></i> Add
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="p-2.5 flex-1 flex flex-col justify-between">
                        <div>
                            <a asp-action="Details" asp-controller="Media" asp-route-id="@credit.Id" asp-route-type="@credit.Type"
                               class="text-xs font-bold text-slate-900 hover:text-brand-600 line-clamp-1 transition-colors" title="@credit.Title">
                                @credit.Title
                            </a>
                            <p class="text-3xs text-slate-400 line-clamp-1 mt-0.5">@(credit.CharacterOrJob ?? "Cast")</p>
                        </div>
                        <div class="flex items-center justify-between text-3xs text-slate-400 mt-2 pt-1 border-t border-slate-100">
                            <span>@(credit.ReleaseDate?.Year.ToString() ?? "TBA")</span>
                            <span class="uppercase font-semibold">@credit.Type</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function filterCredits(filter) {
        document.querySelectorAll('.credit-filter').forEach(btn => {
            if (btn.dataset.filter === filter) {
                btn.className = 'credit-filter px-3 py-1.5 rounded-xl bg-slate-900 text-white transition-colors';
            } else {
                btn.className = 'credit-filter px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors';
            }
        });

        const cards = document.querySelectorAll('.credit-card');
        cards.forEach(card => {
            const isWatched = card.dataset.watched === 'true';
            if (filter === 'all') {
                card.style.display = 'flex';
            } else if (filter === 'watched') {
                card.style.display = isWatched ? 'flex' : 'none';
            } else if (filter === 'unwatched') {
                card.style.display = !isWatched ? 'flex' : 'none';
            }
        });
    }
</script>
