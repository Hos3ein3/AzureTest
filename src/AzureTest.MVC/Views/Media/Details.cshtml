@using AzureTest.Contracts.DTOs.Media
@using AzureTest.Domain.Media.Enums
@using AzureTest.MVC.Models
@model TmdbTitleDetailsDto

@{
    ViewData["Title"] = Model.Title;

    var isTracked = Model.UserWatchItem != null;
    var userItem = Model.UserWatchItem;

    string PosterUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=500&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";

    string BackdropUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1518791841217-8f162f1e1131?auto=format&fit=crop&w=1400&q=80"
        : $"https://image.tmdb.org/t/p/w1280{path}";

    string ProviderLogoUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? ""
        : $"https://image.tmdb.org/t/p/w92{path}";

    string Slugify(string? title) => string.IsNullOrWhiteSpace(title)
        ? "title"
        : System.Text.RegularExpressions.Regex.Replace(title.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');

    string StatusBadgeClass(WatchStatus status) => status switch
    {
        WatchStatus.Watching => "bg-blue-600 text-white shadow-2xs",
        WatchStatus.PlanToWatch => "bg-amber-600 text-white shadow-2xs",
        WatchStatus.Completed => "bg-emerald-600 text-white shadow-2xs",
        WatchStatus.Dropped => "bg-rose-600 text-white shadow-2xs",
        _ => "bg-slate-600 text-white"
    };

    string StatusName(WatchStatus status) => status switch
    {
        WatchStatus.Watching => "Currently Watching",
        WatchStatus.PlanToWatch => "Want to Watch (Wishlist)",
        WatchStatus.Completed => "Finished",
        WatchStatus.Dropped => "Stopped",
        _ => status.ToString()
    };

    var slug = Slugify(Model.Title);
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new("Media", Url.Action("Index", "Media")),
        new("Discover", Url.Action("Discover", "Media")),
        new(Model.Title, null, IsActive: true)
    };

    var validSeasons = Model.Seasons?.Where(s => s.SeasonNumber > 0).OrderBy(s => s.SeasonNumber).ToList() ?? new List<TvSeasonSummaryDto>();
    var totalEpisodesCount = validSeasons.Sum(s => s.EpisodeCount);
    var initialSeasonNumber = userItem?.CurrentSeason > 0 && validSeasons.Any(s => s.SeasonNumber == userItem.CurrentSeason)
        ? userItem.CurrentSeason
        : (validSeasons.FirstOrDefault()?.SeasonNumber ?? 1);
}

<div class="space-y-8">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />

    <!-- Hero Backdrop & Overview Card -->
    <div class="relative bg-slate-900 rounded-3xl overflow-hidden shadow-xl text-white">
        <!-- Backdrop Image with Gradient Overlay -->
        <div class="absolute inset-0 z-0">
            <img src="@BackdropUrl(Model.BackdropPath)" alt="@Model.Title" class="w-full h-full object-cover opacity-25" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/30"></div>
        </div>

        <div class="relative z-10 p-6 md:p-10 flex flex-col md:flex-row gap-8 items-start">
            <!-- Poster -->
            <div class="w-48 md:w-60 flex-shrink-0 mx-auto md:mx-0">
                <img src="@PosterUrl(Model.PosterPath)" alt="@Model.Title"
                     class="w-full rounded-2xl shadow-2xl border-2 border-white/10 aspect-2/3 object-cover" />
            </div>

            <!-- Header Content -->
            <div class="flex-1 space-y-4">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="px-3 py-1 rounded-xl text-xs font-bold uppercase tracking-wider bg-brand-600 text-white shadow-2xs">
                        @Model.Type
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.Status))
                    {
                        var statusColor = Model.Status.Contains("Canceled", StringComparison.OrdinalIgnoreCase) ? "bg-rose-500/20 text-rose-300 border border-rose-500/30" :
                                          Model.Status.Contains("Ended", StringComparison.OrdinalIgnoreCase) ? "bg-slate-500/20 text-slate-300 border border-slate-500/30" :
                                          "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
                        <span class="px-3 py-1 rounded-xl text-xs font-bold @statusColor">
                            @Model.Status
                        </span>
                    }

                    @if (Model.ReleaseDate.HasValue)
                    {
                        <span class="text-xs text-slate-300 font-medium">
                            <i class="fa-regular fa-calendar mr-1"></i> @Model.ReleaseDate.Value.ToString("MMM yyyy")
                        </span>
                    }

                    @if (Model.RuntimeMinutes.HasValue && Model.RuntimeMinutes > 0)
                    {
                        <span class="text-xs text-slate-300 font-medium">
                            <i class="fa-regular fa-clock mr-1"></i> @Model.RuntimeMinutes mins
                        </span>
                    }

                    @if (validSeasons.Any())
                    {
                        <span class="text-xs text-slate-300 font-medium">
                            <i class="fa-solid fa-layer-group mr-1"></i> @validSeasons.Count Seasons (@totalEpisodesCount Ep)
                        </span>
                    }
                </div>

                <div>
                    <h1 class="text-2xl md:text-4xl font-black text-white tracking-tight">@Model.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.OriginalTitle) && Model.OriginalTitle != Model.Title)
                    {
                        <p class="text-sm text-slate-400 italic">Original: @Model.OriginalTitle</p>
                    }
                </div>

                <!-- Rating & Genres -->
                <div class="flex flex-wrap items-center gap-4 text-xs">
                    @if (Model.VoteAverage.HasValue && Model.VoteAverage > 0)
                    {
                        <div class="flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-500/20 border border-amber-500/30 text-amber-300 font-bold">
                            <i class="fa-solid fa-star text-amber-400"></i>
                            <span>@Model.VoteAverage.Value.ToString("0.0")</span>
                            <span class="text-amber-400/60 font-normal">(@Model.VoteCount votes)</span>
                        </div>
                    }

                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var genre in Model.Genres)
                        {
                            <span class="px-2.5 py-1 rounded-lg bg-white/10 text-slate-300 text-xs font-medium">
                                @genre
                            </span>
                        }
                    </div>
                </div>

                <!-- Synopsis -->
                @if (!string.IsNullOrWhiteSpace(Model.Overview))
                {
                    <p class="text-slate-300 text-xs md:text-sm leading-relaxed max-w-3xl">
                        @Model.Overview
                    </p>
                }

                <!-- Track Status & Action Section -->
                <div class="pt-4 border-t border-white/10">
                    @if (isTracked && userItem != null)
                    {
                        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 space-y-3">
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                                    <span class="px-3 py-1.5 rounded-xl text-xs font-bold @StatusBadgeClass(userItem.Status)">
                                        <i class="fa-solid fa-check-circle mr-1"></i> @StatusName(userItem.Status)
                                    </span>

                                    @if (Model.Type != MediaType.Movie)
                                    {
                                        <span class="text-xs text-white font-medium" id="headerProgressLabel">
                                            Season @userItem.CurrentSeason • Episode @userItem.CurrentEpisode
                                        </span>
                                        @if (userItem.Status == WatchStatus.Completed)
                                        {
                                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-3xs font-semibold flex items-center gap-1">
                                                <i class="fa-solid fa-circle-check text-2xs"></i> All Episodes Watched
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 rounded-lg bg-brand-500/20 text-brand-300 border border-brand-500/30 text-3xs font-semibold max-w-full break-words">
                                                Next: @userItem.NextEpisodeLabel
                                            </span>
                                        }
                                    }

                                    @if (userItem.WatchedDate.HasValue)
                                    {
                                        <span class="text-xs text-slate-300 flex items-center gap-1">
                                            <i class="fa-regular fa-calendar-check text-brand-400"></i>
                                            Watched: @userItem.WatchedDate.Value.ToString("MMM yyyy")
                                        </span>
                                    }

                                    @if (userItem.RewatchCount > 0)
                                    {
                                        <span class="text-xs text-purple-300 flex items-center gap-1 bg-purple-500/20 border border-purple-500/30 px-2.5 py-1 rounded-lg font-semibold">
                                            <i class="fa-solid fa-rotate-right text-purple-400"></i>
                                            Rewatched @(userItem.RewatchCount)x
                                        </span>
                                    }

                                    @if (userItem.LastWatchedAt.HasValue && userItem.LastWatchedAt != userItem.WatchedDate)
                                    {
                                        <span class="text-xs text-slate-300 flex items-center gap-1">
                                            <i class="fa-regular fa-clock text-slate-400"></i>
                                            Last: @userItem.LastWatchedAt.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                </div>

                                <div class="flex items-center gap-2">
                                    @if (userItem.UserRating.HasValue)
                                    {
                                        <span class="px-3 py-1.5 rounded-xl bg-amber-500/20 text-amber-300 font-bold text-xs flex items-center gap-1">
                                            <i class="fa-solid fa-star text-amber-400 text-2xs"></i> My Score: @userItem.UserRating/10
                                        </span>
                                    }
                                    <button type="button" onclick="openQuickAddModal('@Model.Id', '@Model.Type', '@Html.Raw(Model.Title.Replace("'", "\\\'"))', '@Model.PosterPath')" class="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold transition-colors flex items-center gap-1.5 shadow-2xs" title="Add to Custom Playlist">
                                        <i class="fa-solid fa-folder-plus text-2xs"></i>
                                        <span>Add to Playlist</span>
                                    </button>
                                    <button type="button" onclick="openRateModal()" class="px-3 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-semibold transition-colors flex items-center gap-1.5">
                                        <i class="fa-solid fa-pen text-2xs"></i>
                                        <span>Rate & Date</span>
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(userItem.UserReview))
                            {
                                <div class="p-3 bg-black/20 rounded-xl text-xs text-slate-200 italic border-l-2 border-brand-500">
                                    "@userItem.UserReview"
                                </div>
                            }

                            <!-- Progress & Status Management -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-white/10">
                                @if (Model.Type != MediaType.Movie)
                                {
                                    <!-- Progress Update Form -->
                                    <form asp-action="UpdateProgress" asp-controller="Media" method="post" class="flex flex-wrap items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="WatchItemId" value="@userItem.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                                        <div class="flex items-center gap-1.5 text-xs text-slate-300">
                                            <span>S:</span>
                                            <input type="number" id="currentSeasonInput" name="Season" value="@userItem.CurrentSeason" min="0" max="99" class="w-14 px-2 py-1 rounded-lg bg-white/10 border border-white/20 text-white text-xs focus:outline-none" />
                                            <span>E:</span>
                                            <input type="number" id="currentEpisodeInput" name="Episode" value="@userItem.CurrentEpisode" min="0" max="999" class="w-16 px-2 py-1 rounded-lg bg-white/10 border border-white/20 text-white text-xs focus:outline-none" />
                                        </div>
                                        <button type="submit" class="px-3 py-1 bg-white/20 hover:bg-white/30 rounded-lg text-xs font-semibold transition-colors">
                                            Save Ep
                                        </button>
                                    </form>
                                }

                                <!-- Change Status & Actions Form -->
                                <div class="flex flex-wrap items-center justify-start sm:justify-end gap-2">
                                    @if (userItem.Status == WatchStatus.PlanToWatch)
                                    {
                                        <button type="button" onclick="openWatchedModal('@Model.Id', '@Html.Raw(Model.Title.Replace("'", "\\\'"))', '@Model.Type', @(validSeasons.Count), @totalEpisodesCount)"
                                                class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold transition-colors flex items-center gap-1 shadow-2xs">
                                            <i class="fa-solid fa-check text-2xs"></i>
                                            <span>I Watched This</span>
                                        </button>
                                    }
                                    else if (userItem.Status == WatchStatus.Completed)
                                    {
                                        <button type="button" onclick="openRewatchModal('@userItem.Id', '@Html.Raw(Model.Title.Replace("'", "\\\'"))', '@Model.Type', @userItem.RewatchCount)"
                                                class="px-3 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-semibold transition-colors flex items-center gap-1 shadow-2xs">
                                            <i class="fa-solid fa-rotate-right text-2xs"></i>
                                            <span>Rewatch @(userItem.RewatchCount > 0 ? $"({userItem.RewatchCount + 1}x)" : "")</span>
                                        </button>
                                        @if (userItem.RewatchCount > 0)
                                        {
                                            <form asp-action="UndoRewatch" asp-controller="Media" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="watchItemId" value="@userItem.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="px-2.5 py-1 bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1 shadow-2xs" title="Undo latest repeat viewing">
                                                    <i class="fa-solid fa-rotate-left text-2xs"></i>
                                                    <span>Undo Rewatch</span>
                                                </button>
                                            </form>
                                        }
                                    }

                                    <form asp-action="ChangeStatus" asp-controller="Media" method="post" class="flex items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="WatchItemId" value="@userItem.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                                        <select name="NewStatus" onchange="this.form.submit()" class="px-3 py-1 rounded-lg bg-slate-800 border border-white/20 text-white text-xs focus:outline-none">
                                            <option value="@WatchStatus.PlanToWatch" selected="@(userItem.Status == WatchStatus.PlanToWatch)">Wishlist</option>
                                            <option value="@WatchStatus.Watching" selected="@(userItem.Status == WatchStatus.Watching)">Watching</option>
                                            <option value="@WatchStatus.Completed" selected="@(userItem.Status == WatchStatus.Completed)">Finished</option>
                                            <option value="@WatchStatus.Dropped" selected="@(userItem.Status == WatchStatus.Dropped)">Stopped</option>
                                        </select>

                                        <!-- Delete from watchlist button with modal trigger -->
                                        <button type="button" onclick="openDeleteDetailsModal()" class="p-1.5 text-slate-400 hover:text-rose-400 transition-colors" title="Remove from Watchlist">
                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Quick Add Buttons -->
                        <div class="flex flex-wrap items-center gap-2.5">
                            <form asp-action="Add" asp-controller="Media" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TmdbId" value="@Model.Id" />
                                <input type="hidden" name="Type" value="@Model.Type" />
                                <input type="hidden" name="Title" value="@Model.Title" />
                                <input type="hidden" name="PosterPath" value="@Model.PosterPath" />
                                <input type="hidden" name="Status" value="@WatchStatus.PlanToWatch" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                                    <i class="fa-solid fa-bookmark text-2xs"></i> Add to Wishlist
                                </button>
                            </form>

                            <form asp-action="Add" asp-controller="Media" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TmdbId" value="@Model.Id" />
                                <input type="hidden" name="Type" value="@Model.Type" />
                                <input type="hidden" name="Title" value="@Model.Title" />
                                <input type="hidden" name="PosterPath" value="@Model.PosterPath" />
                                <input type="hidden" name="Status" value="@WatchStatus.Watching" />
                                <input type="hidden" name="CurrentSeason" value="1" />
                                <input type="hidden" name="CurrentEpisode" value="1" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                                    <i class="fa-solid fa-play text-2xs"></i> Start Watching
                                </button>
                            </form>

                            <!-- Direct Mark as Watched / Completed with Date -->
                            <button type="button" onclick="openWatchedModal('@Model.Id', '@Model.Title', '@Model.Type', @(validSeasons.Count), @totalEpisodesCount)"
                                    class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                                <i class="fa-solid fa-check text-2xs"></i>
                                <span>I Watched This (Add Date)</span>
                            </button>

                            <!-- Add to Custom Playlist button -->
                            <button type="button" onclick="openQuickAddModal('@Model.Id', '@Model.Type', '@Html.Raw(Model.Title.Replace("'", "\\\'"))', '@Model.PosterPath')"
                                    class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5" title="Add to Custom Playlist">
                                <i class="fa-solid fa-folder-plus text-2xs"></i>
                                <span>Add to Playlist</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Seasons & Episodes Section (For TV Series & Anime) -->
    @if (validSeasons.Any())
    {
        <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-2xs space-y-6" id="seasonsSection">
            <!-- Header & Action Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-700">
                <div class="flex items-center gap-3">
                    <span class="w-10 h-10 rounded-2xl bg-purple-50 dark:bg-purple-900/40 text-purple-600 dark:text-purple-300 flex items-center justify-center text-base">
                        <i class="fa-solid fa-layer-group"></i>
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white">Seasons & Episodes</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Select a season to view all episodes and track your watching progress.</p>
                    </div>
                </div>

                <!-- Whole Anime / Series Action Button -->
                <div class="flex items-center gap-2">
                    <button type="button" onclick="openWatchedModal('@Model.Id', '@Model.Title', '@Model.Type', @(validSeasons.Count), @totalEpisodesCount)"
                            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                        <i class="fa-solid fa-check-double text-2xs"></i>
                        <span>Mark Entire @(Model.Type == MediaType.Anime ? "Anime" : "Series") Watched</span>
                    </button>
                </div>
            </div>

            <!-- Season Selector Pill Tabs -->
            <div class="flex flex-wrap items-center gap-2" id="seasonTabs">
                @foreach (var s in validSeasons)
                {
                    var isCurrentActiveSeason = s.SeasonNumber == initialSeasonNumber;
                    var isSeasonWatched = userItem != null && (userItem.CurrentSeason > s.SeasonNumber || (userItem.CurrentSeason == s.SeasonNumber && userItem.CurrentEpisode >= s.EpisodeCount) || userItem.Status == WatchStatus.Completed);

                    <button type="button" onclick="selectSeason(@s.SeasonNumber)"
                            id="seasonTab-@s.SeasonNumber"
                            data-season="@s.SeasonNumber"
                            data-episodes="@s.EpisodeCount"
                            data-name="@s.Name"
                            data-overview="@(s.Overview ?? "")"
                            data-airdate="@(s.AirDate?.ToString("MMM yyyy") ?? "")"
                            data-watched="@(isSeasonWatched ? "true" : "false")"
                            class="season-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @(isCurrentActiveSeason ? "bg-slate-900 dark:bg-brand-600 text-white shadow-2xs" : "bg-slate-100 dark:bg-slate-700/80 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-650")">
                        <span>@s.Name</span>
                        <span class="px-2 py-0.5 rounded-lg text-3xs font-semibold @(isCurrentActiveSeason ? "bg-white/20 text-white" : "bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-300")">
                            @s.EpisodeCount Ep
                        </span>
                        @if (isSeasonWatched)
                        {
                            <i class="fa-solid fa-circle-check text-emerald-400 text-xs"></i>
                        }
                    </button>
                }
            </div>

            <!-- Active Season Details Banner -->
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-750 border border-slate-200 dark:border-slate-700 flex flex-col md:flex-row md:items-start justify-between gap-4">
                <div class="space-y-1.5 flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 id="activeSeasonTitle" class="text-sm font-bold text-slate-900 dark:text-white">Season 1</h3>
                        <span id="activeSeasonAirDate" class="text-3xs text-slate-400 font-medium"></span>
                    </div>
                    <p id="activeSeasonSubtitle" class="text-xs text-slate-500 dark:text-slate-400">Episodes list</p>
                    <p id="activeSeasonOverview" class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3 hidden"></p>
                </div>

                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    <button type="button" id="markSeasonWatchedBtn" onclick="markCurrentSeasonWatched()"
                            class="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                        <i class="fa-solid fa-check text-2xs"></i>
                        <span id="markSeasonWatchedBtnText">Mark Season Watched</span>
                    </button>

                    <button type="button" id="rewatchSeasonBtn" onclick="openSeasonRewatchModal()"
                            class="px-3.5 py-1.5 rounded-xl bg-purple-100 hover:bg-purple-200 dark:bg-purple-900/50 dark:hover:bg-purple-800 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800 text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5 hidden"
                            title="Log a rewatch of this season">
                        <i class="fa-solid fa-rotate-right text-2xs"></i>
                        <span>Re-watch Season</span>
                    </button>

                    <button type="button" id="markSeasonUnwatchedBtn" onclick="markCurrentSeasonUnwatched()"
                            class="px-3.5 py-1.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800 text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5 hidden">
                        <i class="fa-solid fa-rotate-left text-2xs"></i>
                        <span>Mark Season Unwatched</span>
                    </button>
                </div>
            </div>

            <!-- Episodes Grid Container -->
            <div id="episodesContainer" class="space-y-3">
                <div class="flex items-center justify-center py-12 text-slate-400">
                    <i class="fa-solid fa-circle-notch fa-spin text-2xl mr-3 text-brand-600"></i>
                    <span class="text-xs font-semibold">Loading episodes...</span>
                </div>
            </div>
        </div>
    }

    <!-- Where to Watch Streaming Providers -->
    @if (Model.WatchProviders != null && (Model.WatchProviders.Flatrate.Any() || Model.WatchProviders.Rent.Any() || Model.WatchProviders.Buy.Any()))
    {
        <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-xl bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-tv"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Where to Watch</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Streaming availability powered by JustWatch via TMDb.</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.WatchProviders.Link))
                {
                    <a href="@Model.WatchProviders.Link" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline flex items-center gap-1">
                        View on JustWatch <i class="fa-solid fa-arrow-up-right-from-square text-2xs"></i>
                    </a>
                }
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                @if (Model.WatchProviders.Flatrate.Any())
                {
                    <div class="space-y-2">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-play text-blue-500 text-2xs"></i> Stream / Subscription
                        </span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var p in Model.WatchProviders.Flatrate)
                            {
                                <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600" title="@p.ProviderName">
                                    @if (!string.IsNullOrWhiteSpace(p.LogoPath))
                                    {
                                        <img src="@ProviderLogoUrl(p.LogoPath)" alt="@p.ProviderName" class="w-6 h-6 rounded-md object-cover" />
                                    }
                                    <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">@p.ProviderName</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.WatchProviders.Rent.Any())
                {
                    <div class="space-y-2">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-tag text-amber-500 text-2xs"></i> Rent
                        </span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var p in Model.WatchProviders.Rent)
                            {
                                <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600" title="@p.ProviderName">
                                    @if (!string.IsNullOrWhiteSpace(p.LogoPath))
                                    {
                                        <img src="@ProviderLogoUrl(p.LogoPath)" alt="@p.ProviderName" class="w-6 h-6 rounded-md object-cover" />
                                    }
                                    <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">@p.ProviderName</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.WatchProviders.Buy.Any())
                {
                    <div class="space-y-2">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-cart-shopping text-emerald-500 text-2xs"></i> Buy
                        </span>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var p in Model.WatchProviders.Buy)
                            {
                                <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600" title="@p.ProviderName">
                                    @if (!string.IsNullOrWhiteSpace(p.LogoPath))
                                    {
                                        <img src="@ProviderLogoUrl(p.LogoPath)" alt="@p.ProviderName" class="w-6 h-6 rounded-md object-cover" />
                                    }
                                    <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">@p.ProviderName</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Trailer Embed -->
    @if (!string.IsNullOrWhiteSpace(Model.TrailerYouTubeKey))
    {
        <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-2xs space-y-3">
            <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-rose-50 dark:bg-rose-900/40 text-rose-600 dark:text-rose-300 flex items-center justify-center text-sm">
                    <i class="fa-brands fa-youtube"></i>
                </span>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">Official Trailer</h3>
            </div>
            <div class="aspect-video w-full rounded-2xl overflow-hidden bg-black shadow-inner">
                <iframe src="https://www.youtube.com/embed/@Model.TrailerYouTubeKey"
                        title="@Model.Title Trailer"
                        class="w-full h-full border-0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
            </div>
        </div>
    }

    <!-- Cast Members Grid -->
    @if (Model.Cast.Any())
    {
        <div class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-xl bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-300 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-users"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">Top Cast</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Click any actor or creator to view their filmography.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                @foreach (var actor in Model.Cast.Take(12))
                {
                    var actorSlug = Slugify(actor.Name);
                    <a asp-action="PersonDetails" asp-controller="Media" asp-route-id="@actor.PersonId" asp-route-slug="@actorSlug"
                       class="group p-2.5 rounded-xl bg-slate-50 dark:bg-slate-700/60 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-600 text-center transition-all flex flex-col items-center">
                        <img src="@PosterUrl(actor.ProfilePath)" alt="@actor.Name"
                             class="w-16 h-16 rounded-full object-cover mb-2 border border-slate-200 dark:border-slate-600 group-hover:scale-105 transition-transform" />
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 line-clamp-1 transition-colors">@actor.Name</h4>
                        <p class="text-3xs text-slate-500 dark:text-slate-400 line-clamp-1">@actor.Character</p>
                    </a>
                }
            </div>
        </div>
    }

    <!-- Similar Titles Suggestions -->
    @if (Model.SimilarTitles.Any())
    {
        <div class="space-y-4">
            <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-sparkles"></i>
                </span>
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Titles Similar to This</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Recommended based on genres, cast, and audience tastes.</p>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
                @foreach (var item in Model.SimilarTitles.Take(6))
                {
                    @await Html.PartialAsync("_DiscoverCard", item)
                }
            </div>
        </div>
    }
</div>

<!-- Comprehensive "Mark as Watched" & Date Preset Modal -->
<div id="watchedModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeWatchedModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-lg bg-white dark:bg-slate-800 rounded-3xl shadow-2xl p-6 md:p-8 space-y-6 border border-slate-100 dark:border-slate-700">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-300 flex items-center justify-center">
                        <i class="fa-solid fa-calendar-check text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">Track as Watched</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@Model.Title</p>
                    </div>
                </div>
                <button type="button" onclick="closeWatchedModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form asp-action="Add" asp-controller="Media" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TmdbId" value="@Model.Id" />
                <input type="hidden" name="Type" value="@Model.Type" />
                <input type="hidden" name="Title" value="@Model.Title" />
                <input type="hidden" name="PosterPath" value="@Model.PosterPath" />
                <input type="hidden" name="Status" value="@WatchStatus.Completed" />
                <input type="hidden" id="modalTotalSeasons" name="TotalSeasons" value="@validSeasons.Count" />
                <input type="hidden" id="modalTotalEpisodes" name="TotalEpisodes" value="@totalEpisodesCount" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <!-- Scope Selection (For Series / Anime) -->
                @if (validSeasons.Any())
                {
                    <div class="space-y-1.5">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">What Did You Watch?</label>
                        <select id="modalScope" name="CurrentSeason" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">
                            <option value="@validSeasons.Count" selected>Entire Series / All @validSeasons.Count Seasons (@totalEpisodesCount Ep)</option>
                            @foreach (var s in validSeasons)
                            {
                                <option value="@s.SeasonNumber">Up to Season @s.SeasonNumber (@s.Name)</option>
                            }
                        </select>
                        <input type="hidden" id="modalScopeEpisode" name="CurrentEpisode" value="@totalEpisodesCount" />
                    </div>
                }

                <!-- Watched Date with One-Click Presets -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">When Did You Watch It?</label>
                        <span class="text-3xs text-slate-400">Select preset or pick date</span>
                    </div>

                    <!-- Preset Chips -->
                    <div class="flex flex-wrap gap-2 text-xs">
                        <button type="button" onclick="setWatchedDatePreset(0, this)" class="date-preset-btn px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-650 transition-colors">
                            Today
                        </button>
                        <button type="button" onclick="setWatchedDatePreset(1, this)" class="date-preset-btn px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-650 transition-colors">
                            1 year ago
                        </button>
                        <button type="button" onclick="setWatchedDatePreset(2, this)" class="date-preset-btn px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-650 transition-colors">
                            2 years ago
                        </button>
                        <button type="button" onclick="setWatchedDatePreset(3, this)" class="date-preset-btn px-3 py-1 rounded-xl bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 border border-brand-300 dark:border-brand-700 font-bold transition-colors">
                            3 years ago
                        </button>
                        <button type="button" onclick="setWatchedDatePreset(5, this)" class="date-preset-btn px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-650 transition-colors">
                            5 years ago
                        </button>
                    </div>

                    <input type="date" id="watchedModalDateInput" name="WatchedDate"
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                </div>

                <!-- Rating Score -->
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Your Rating (Optional)</label>
                    <select name="UserRating" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">
                        <option value="">No Score</option>
                        <option value="10">10 / 10 - Masterpiece</option>
                        <option value="9">9 / 10 - Great</option>
                        <option value="8">8 / 10 - Very Good</option>
                        <option value="7">7 / 10 - Good</option>
                        <option value="6">6 / 10 - Fine</option>
                        <option value="5">5 / 10 - Average</option>
                        <option value="4">4 / 10 - Bad</option>
                        <option value="3">3 / 10 - Very Bad</option>
                    </select>
                </div>

                <!-- Short Review -->
                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Short Review or Memories (Optional)</label>
                    <textarea name="UserReview" rows="2" placeholder="Loved the plot twists, unforgettable music..."
                              class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"></textarea>
                </div>

                <div class="flex items-center justify-end gap-2.5 pt-2">
                    <button type="button" onclick="closeWatchedModal()" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                        <i class="fa-solid fa-check"></i>
                        <span>Save as Watched</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Rate and Review Modal -->
@if (isTracked && userItem != null)
{
    <div id="rateModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeRateModal()"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-md bg-white dark:bg-slate-800 rounded-3xl shadow-2xl p-6 md:p-8 space-y-5 border border-slate-100 dark:border-slate-700">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-900/40 text-amber-600 dark:text-amber-300 flex items-center justify-center">
                            <i class="fa-solid fa-star text-base"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Rate & Review</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 truncate max-w-[220px]">@Model.Title</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeRateModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <form asp-action="Rate" asp-controller="Media" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="WatchItemId" value="@userItem.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                    <!-- Rating Score (1 to 10) -->
                    <div class="space-y-1.5">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Your Score (1 to 10)</label>
                        <select name="Rating" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">
                            <option value="">No Score</option>
                            @for (int score = 10; score >= 1; score--)
                            {
                                <option value="@score" selected="@(userItem.UserRating == score)">@score / 10 @(score >= 9 ? "Masterpiece" : score >= 7 ? "Good" : score >= 5 ? "Average" : "Poor")</option>
                            }
                        </select>
                    </div>

                    <!-- Short Review -->
                    <div class="space-y-1.5">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Short Review</label>
                        <textarea name="Review" rows="3" placeholder="What did you think of the story, acting, animation..."
                                  class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">@userItem.UserReview</textarea>
                    </div>

                    <!-- Watched Date with presets -->
                    <div class="space-y-1.5">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Date Watched</label>
                        <input type="date" id="rateModalDateInput" name="WatchedDate" value="@(userItem.WatchedDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))"
                               class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>

                    <div class="flex items-center justify-end gap-2 pt-2">
                        <button type="button" onclick="closeRateModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-semibold transition-colors shadow-2xs">
                            <i class="fa-solid fa-check mr-1.5 text-2xs"></i> Save Review
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteDetailsModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-sm w-full p-6 shadow-xl border border-slate-200 dark:border-slate-700 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="font-bold text-slate-900 dark:text-white text-sm flex items-center gap-2">
                    <i class="fa-solid fa-trash-can text-rose-500"></i>
                    <span>Remove from Watchlist</span>
                </h3>
                <button type="button" onclick="closeDeleteDetailsModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                Are you sure you want to remove <span class="font-semibold text-slate-900 dark:text-white">@Model.Title</span> from your watchlist?
            </p>

            <form asp-action="Delete" asp-controller="Media" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WatchItemId" value="@userItem.Id" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Media")" />

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeDeleteDetailsModal()" class="px-3.5 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 font-semibold transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 text-xs rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold shadow-2xs transition-colors">
                        Remove
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<!-- Episode Details Modal -->
<div id="episodeDetailsModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeEpisodeDetailsModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-lg bg-white dark:bg-slate-800 rounded-3xl shadow-2xl overflow-hidden border border-slate-100 dark:border-slate-700">
            <!-- Episode Image Banner -->
            <div class="relative aspect-video w-full bg-slate-900">
                <img id="epModalImg" src="" alt="Episode Still" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                <button type="button" onclick="closeEpisodeDetailsModal()" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
                <div class="absolute bottom-3 left-4 right-4 text-white">
                    <span id="epModalBadge" class="px-2 py-0.5 rounded-md bg-brand-600 font-mono text-3xs font-bold uppercase tracking-wider"></span>
                    <h3 id="epModalTitle" class="text-base font-bold text-white mt-1 leading-snug"></h3>
                </div>
            </div>

            <!-- Details Content -->
            <div class="p-6 space-y-4">
                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
                    <span id="epModalAirDate" class="flex items-center gap-1.5"><i class="fa-regular fa-calendar text-2xs"></i> <span></span></span>
                    <span id="epModalRating" class="flex items-center gap-1 text-amber-500 font-bold"><i class="fa-solid fa-star text-2xs"></i> <span></span></span>
                </div>

                <div class="space-y-1">
                    <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200">Synopsis</h4>
                    <p id="epModalOverview" class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed max-h-48 overflow-y-auto pr-1"></p>
                </div>

                <div class="flex items-center justify-between pt-3 border-t border-slate-200 dark:border-slate-700">
                    <div id="epModalStatusText" class="text-xs font-semibold"></div>
                    <div class="flex items-center gap-2" id="epModalActions"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Rewatch Modal -->
<div id="rewatchModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeRewatchModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white dark:bg-slate-800 rounded-3xl shadow-2xl p-6 md:p-8 space-y-5 border border-slate-100 dark:border-slate-700">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-purple-50 dark:bg-purple-900/40 text-purple-600 dark:text-purple-300 flex items-center justify-center">
                        <i class="fa-solid fa-rotate-right text-base"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white" id="rewatchModalTitle">Rewatch Title</h3>
                        <p id="rewatchModalSubtitle" class="text-xs text-slate-500 dark:text-slate-400">Log a repeat watch</p>
                    </div>
                </div>
                <button type="button" onclick="closeRewatchModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed" id="rewatchModalDescription">
                Watched this title again? Updating your rewatch count includes repeat watch time in your total hours and stats without losing your original completed date.
            </p>

            <form asp-action="Rewatch" asp-controller="Media" method="post" id="rewatchForm" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rewatchWatchItemId" name="watchItemId" value="" />
                <input type="hidden" id="rewatchScope" name="scope" value="EntireTitle" />
                <input type="hidden" id="rewatchTargetSeason" name="targetSeason" value="" />
                <input type="hidden" id="rewatchTargetEpisode" name="targetEpisode" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <div class="space-y-2">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Choose Rewatch Action:</label>
                    <div class="space-y-2">
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-750 cursor-pointer transition-colors">
                            <input type="radio" name="restartWatching" id="rewatchOptLog" value="false" checked class="mt-0.5 text-purple-600 focus:ring-purple-500" />
                            <div class="space-y-0.5">
                                <span class="text-xs font-bold text-slate-900 dark:text-white block" id="rewatchOptLogLabel">Log Finished Repeat (+1 count)</span>
                                <span class="text-3xs text-slate-500 dark:text-slate-400 block" id="rewatchOptLogDesc">I already finished rewatching this. Add full duration to stats and keep status as Finished.</span>
                            </div>
                        </label>

                        <label id="rewatchOptRestartWrapper" class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-750 cursor-pointer transition-colors">
                            <input type="radio" name="restartWatching" id="rewatchOptRestart" value="true" class="mt-0.5 text-purple-600 focus:ring-purple-500" />
                            <div class="space-y-0.5">
                                <span class="text-xs font-bold text-slate-900 dark:text-white block" id="rewatchOptRestartLabel">Start Watching Again From Ep 1</span>
                                <span class="text-3xs text-slate-500 dark:text-slate-400 block" id="rewatchOptRestartDesc">Reset current progress to Season 1 Episode 1 and change status back to Watching.</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <div id="undoRewatchSection">
                        @if (userItem != null && (userItem.RewatchCount > 0 || userItem.Status == WatchStatus.Watching))
                        {
                            <button type="button" onclick="submitUndoRewatch()" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 dark:hover:bg-rose-900/40 text-rose-600 dark:text-rose-300 text-xs font-bold transition-colors flex items-center gap-1.5">
                                <i class="fa-solid fa-rotate-left text-2xs"></i>
                                <span>Undo Re-watch</span>
                            </button>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="closeRewatchModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl transition-colors">
                            Cancel
                        </button>
                        <button type="submit" class="px-5 py-2.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                            <i class="fa-solid fa-rotate-right text-2xs"></i>
                            <span>Confirm Rewatch</span>
                        </button>
                    </div>
                </div>
            </form>
            @if (userItem != null)
            {
                <form id="directUndoRewatchForm" asp-action="UndoRewatch" asp-controller="Media" method="post" class="hidden">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="watchItemId" value="@userItem.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                </form>
            }
        </div>
    </div>
</div>

<partial name="_QuickAddModal" />

<script>
    const mediaId = @Model.Id;
    const mediaType = @((int)Model.Type);
    const mediaTitle = "@Html.Raw(Model.Title.Replace("\"", "\\\""))";
    const mediaPoster = "@Html.Raw(Model.PosterPath ?? "")";
    const userWatchItemId = "@(userItem?.Id.ToString() ?? "")";
    const userRewatchCount = @(userItem?.RewatchCount ?? 0);
    const userWatchedDate = "@(userItem?.WatchedDate?.ToString("MMM dd, yyyy") ?? "")";
    const userLastWatchedDate = "@(userItem?.LastWatchedAt?.ToString("MMM dd, yyyy") ?? "")";
    let userCurrentSeason = @(userItem?.CurrentSeason ?? 0);
    let userCurrentEpisode = @(userItem?.CurrentEpisode ?? 0);
    let userWatchStatus = @(userItem != null ? (int)userItem.Status : -1);
    const isCompleted = userWatchStatus === @((int)WatchStatus.Completed);
    let activeSeasonNumber = @initialSeasonNumber;
    const episodesCache = {};

    function selectSeason(seasonNumber) {
        activeSeasonNumber = seasonNumber;
        document.querySelectorAll('.season-tab-btn').forEach(btn => {
            const sn = parseInt(btn.dataset.season);
            if (sn === seasonNumber) {
                btn.className = 'season-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-slate-900 dark:bg-brand-600 text-white shadow-2xs';
            } else {
                btn.className = 'season-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-slate-100 dark:bg-slate-700/80 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-650';
            }
        });

        const activeTab = document.getElementById(`seasonTab-${seasonNumber}`);
        const seasonName = activeTab ? activeTab.dataset.name : `Season ${seasonNumber}`;
        const epCount = activeTab ? activeTab.dataset.episodes : '';
        const overview = activeTab ? activeTab.dataset.overview : '';
        const airdate = activeTab ? activeTab.dataset.airdate : '';
        const isSeasonWatched = activeTab ? activeTab.dataset.watched === 'true' : false;

        document.getElementById('activeSeasonTitle').innerText = seasonName;
        document.getElementById('activeSeasonSubtitle').innerText = `${epCount} episodes in this season${isSeasonWatched && userRewatchCount > 0 ? ` • Rewatches: ${userRewatchCount}x` : ''}`;
        
        const airDateEl = document.getElementById('activeSeasonAirDate');
        if (airDateEl) {
            airDateEl.innerText = airdate ? `• Released ${airdate}` : '';
        }

        const overviewEl = document.getElementById('activeSeasonOverview');
        if (overviewEl) {
            if (overview && overview.trim().length > 0) {
                overviewEl.innerText = overview;
                overviewEl.classList.remove('hidden');
            } else {
                overviewEl.classList.add('hidden');
            }
        }

        const unwatchedBtn = document.getElementById('markSeasonUnwatchedBtn');
        const watchedBtn = document.getElementById('markSeasonWatchedBtn');
        const watchedBtnText = document.getElementById('markSeasonWatchedBtnText');
        const rewatchSeasonBtn = document.getElementById('rewatchSeasonBtn');

        if (isSeasonWatched) {
            if (unwatchedBtn) unwatchedBtn.classList.remove('hidden');
            if (rewatchSeasonBtn) rewatchSeasonBtn.classList.remove('hidden');
            if (watchedBtnText) watchedBtnText.innerText = `Season Watched`;
            if (watchedBtn) watchedBtn.className = 'px-3.5 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5 opacity-80';
        } else {
            if (unwatchedBtn) unwatchedBtn.classList.add('hidden');
            if (rewatchSeasonBtn) rewatchSeasonBtn.classList.add('hidden');
            if (watchedBtnText) watchedBtnText.innerText = `Mark ${seasonName} Watched`;
            if (watchedBtn) watchedBtn.className = 'px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5';
        }

        loadSeasonEpisodes(seasonNumber);
    }

    function loadSeasonEpisodes(seasonNumber) {
        const container = document.getElementById('episodesContainer');
        if (!container) return;

        if (episodesCache[seasonNumber]) {
            renderEpisodes(episodesCache[seasonNumber], seasonNumber);
            return;
        }

        container.innerHTML = `
            <div class="flex items-center justify-center py-12 text-slate-400">
                <i class="fa-solid fa-circle-notch fa-spin text-2xl mr-3 text-brand-600"></i>
                <span class="text-xs font-semibold">Loading Season ${seasonNumber} episodes...</span>
            </div>
        `;

        fetch(`/Media/SeasonEpisodes?id=${mediaId}&seasonNumber=${seasonNumber}`)
            .then(res => res.json())
            .then(data => {
                episodesCache[seasonNumber] = data || [];
                renderEpisodes(episodesCache[seasonNumber], seasonNumber);
            })
            .catch(err => {
                container.innerHTML = `
                    <div class="p-6 text-center text-rose-500 text-xs">
                        Failed to load episodes. <button onclick="loadSeasonEpisodes(${seasonNumber})" class="underline font-bold ml-1">Retry</button>
                    </div>
                `;
            });
    }

    function renderEpisodes(episodes, seasonNumber) {
        const container = document.getElementById('episodesContainer');
        if (!episodes || episodes.length === 0) {
            container.innerHTML = `<div class="p-6 text-center text-slate-400 text-xs">No episode information found for this season.</div>`;
            return;
        }

        let html = '<div class="space-y-2.5">';
        episodes.forEach(ep => {
            const isWatched = isCompleted || (userCurrentSeason > seasonNumber) || (userCurrentSeason === seasonNumber && userCurrentEpisode >= ep.episodeNumber);
            const stillUrl = ep.stillPath
                ? `https://image.tmdb.org/t/p/w300${ep.stillPath}`
                : 'https://images.unsplash.com/photo-1518791841217-8f162f1e1131?auto=format&fit=crop&w=300&q=80';

            const airDateStr = ep.airDate ? new Date(ep.airDate).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '';

            html += `
                <div class="p-3.5 rounded-2xl border ${isWatched ? 'bg-emerald-50/40 dark:bg-emerald-950/20 border-emerald-200 dark:border-emerald-800/50' : 'bg-slate-50 dark:bg-slate-750 border-slate-200 dark:border-slate-700'} flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all">
                    <div class="flex items-start gap-3.5 flex-1 min-w-0 cursor-pointer group" onclick="showEpisodeDetailsModal(${seasonNumber}, ${ep.episodeNumber})">
                        <div class="w-20 sm:w-28 aspect-video rounded-xl overflow-hidden bg-slate-200 dark:bg-slate-700 flex-shrink-0 relative group-hover:ring-2 group-hover:ring-brand-500 transition-all">
                            <img src="${stillUrl}" alt="${ep.name}" class="w-full h-full object-cover" loading="lazy" />
                            <span class="absolute bottom-1 left-1 px-1.5 py-0.5 rounded bg-slate-900/80 text-white font-mono text-3xs font-bold">
                                E${ep.episodeNumber}
                            </span>
                        </div>
                        <div class="flex-1 min-w-0 space-y-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <h4 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors truncate">
                                    ${ep.episodeNumber}. ${ep.name || `Episode ${ep.episodeNumber}`}
                                </h4>
                                ${ep.voteAverage ? `<span class="px-1.5 py-0.5 rounded text-3xs font-bold bg-amber-500/15 text-amber-500 flex items-center gap-1"><i class="fa-solid fa-star text-3xs"></i> ${ep.voteAverage.toFixed(1)}</span>` : ''}
                                ${airDateStr ? `<span class="text-3xs text-slate-400">${airDateStr}</span>` : ''}
                            </div>
                            <p class="text-3xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                                ${ep.overview || 'No synopsis provided. Click for details.'}
                            </p>
                            ${isWatched ? `
                                <div class="flex flex-wrap items-center gap-2 pt-1 text-3xs font-semibold">
                                    <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                                        <i class="fa-solid fa-circle-check text-3xs"></i> Watched ${userWatchedDate ? 'on ' + userWatchedDate : ''}
                                    </span>
                                    ${userRewatchCount > 0 ? `
                                        <span class="px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 font-bold text-3xs flex items-center gap-1">
                                            <i class="fa-solid fa-rotate-right text-3xs"></i> Rewatched ${userRewatchCount}x
                                        </span>
                                    ` : ''}
                                </div>
                            ` : ''}
                        </div>
                    </div>

                    <div class="flex-shrink-0 flex items-center gap-2 justify-end">
                        <button type="button" onclick="showEpisodeDetailsModal(${seasonNumber}, ${ep.episodeNumber})"
                                class="p-2 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" title="View episode details">
                            <i class="fa-solid fa-circle-info text-sm"></i>
                        </button>
                        ${isWatched
                            ? `<button type="button" onclick="openEpisodeRewatchModal(${seasonNumber}, ${ep.episodeNumber}, '${(ep.name || '').replace(/'/g, "\\'")}')"
                                       class="px-2.5 py-1.5 rounded-xl bg-purple-100 hover:bg-purple-200 dark:bg-purple-900/50 dark:hover:bg-purple-800 text-purple-700 dark:text-purple-300 text-xs font-bold flex items-center gap-1 transition-colors shadow-2xs" title="Log a rewatch of this episode">
                                   <i class="fa-solid fa-rotate-right text-2xs"></i>
                                   <span>Re-watch</span>
                               </button>
                               <button type="button" onclick="markSingleEpisodeUnwatched(${seasonNumber}, ${ep.episodeNumber})"
                                       class="px-3 py-1.5 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 hover:bg-rose-100 hover:text-rose-700 dark:hover:bg-rose-950/40 dark:hover:text-rose-300 text-xs font-bold flex items-center gap-1.5 transition-colors group" title="Click to undo / mark unwatched">
                                 <i class="fa-solid fa-check text-2xs group-hover:hidden"></i>
                                 <i class="fa-solid fa-rotate-left text-2xs hidden group-hover:inline"></i>
                                 <span class="group-hover:hidden">Watched</span>
                                 <span class="hidden group-hover:inline">Undo</span>
                               </button>`
                            : `<button type="button" onclick="markSingleEpisodeWatched(${seasonNumber}, ${ep.episodeNumber})"
                                       class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-700 hover:bg-emerald-600 hover:text-white dark:hover:bg-emerald-600 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 text-xs font-semibold transition-all shadow-2xs flex items-center gap-1.5">
                                 <i class="fa-solid fa-check text-2xs"></i> Mark Watched
                               </button>`
                        }
                    </div>
                </div>
            `;
        });
        html += '</div>';
        container.innerHTML = html;
    }

    function showEpisodeDetailsModal(seasonNumber, episodeNumber) {
        const episodes = episodesCache[seasonNumber] || [];
        const ep = episodes.find(e => e.episodeNumber === episodeNumber);
        if (!ep) return;

        const isWatched = isCompleted || (userCurrentSeason > seasonNumber) || (userCurrentSeason === seasonNumber && userCurrentEpisode >= ep.episodeNumber);
        const stillUrl = ep.stillPath
            ? `https://image.tmdb.org/t/p/w780${ep.stillPath}`
            : 'https://images.unsplash.com/photo-1518791841217-8f162f1e1131?auto=format&fit=crop&w=780&q=80';

        document.getElementById('epModalImg').src = stillUrl;
        document.getElementById('epModalBadge').innerText = `Season ${seasonNumber} • Episode ${ep.episodeNumber}`;
        document.getElementById('epModalTitle').innerText = ep.name || `Episode ${ep.episodeNumber}`;

        const airDateStr = ep.airDate ? new Date(ep.airDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) : 'Unknown air date';
        document.getElementById('epModalAirDate').querySelector('span').innerText = airDateStr;

        const ratingEl = document.getElementById('epModalRating');
        if (ep.voteAverage) {
            ratingEl.querySelector('span').innerText = `${ep.voteAverage.toFixed(1)} / 10 TMDb`;
            ratingEl.classList.remove('hidden');
        } else {
            ratingEl.classList.add('hidden');
        }

        document.getElementById('epModalOverview').innerText = ep.overview && ep.overview.trim().length > 0 
            ? ep.overview 
            : 'No detailed synopsis available for this episode.';

        const statusEl = document.getElementById('epModalStatusText');
        const actionsEl = document.getElementById('epModalActions');

        if (isWatched) {
            statusEl.innerHTML = `
                <div class="space-y-0.5 text-left">
                    <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-bold text-xs">
                        <i class="fa-solid fa-circle-check"></i> Watched
                    </span>
                    <div class="text-3xs text-slate-400 space-y-0.5">
                        ${userWatchedDate ? `<div><i class="fa-regular fa-calendar-check mr-1"></i>Watched: ${userWatchedDate}</div>` : ''}
                        ${userRewatchCount > 0 ? `<div><i class="fa-solid fa-rotate-right mr-1 text-purple-400"></i>Rewatches: ${userRewatchCount}x</div>` : ''}
                        ${userLastWatchedDate ? `<div><i class="fa-regular fa-clock mr-1"></i>Last viewed: ${userLastWatchedDate}</div>` : ''}
                    </div>
                </div>
            `;
            actionsEl.innerHTML = `
                <button type="button" onclick="closeEpisodeDetailsModal(); openEpisodeRewatchModal(${seasonNumber}, ${ep.episodeNumber}, '${(ep.name || '').replace(/'/g, "\\'")}');"
                        class="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-right text-2xs"></i> Re-watch
                </button>
                <button type="button" onclick="closeEpisodeDetailsModal(); markSingleEpisodeUnwatched(${seasonNumber}, ${ep.episodeNumber});"
                        class="px-3.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300 text-xs font-bold transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-rotate-left text-2xs"></i> Mark Unwatched
                </button>
            `;
        } else {
            statusEl.innerHTML = `<span class="text-slate-400">Not watched yet</span>`;
            actionsEl.innerHTML = `
                <button type="button" onclick="closeEpisodeDetailsModal(); markSingleEpisodeWatched(${seasonNumber}, ${ep.episodeNumber});"
                        class="px-4 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5">
                    <i class="fa-solid fa-check text-2xs"></i> Mark Watched
                </button>
            `;
        }

        document.getElementById('episodeDetailsModal').classList.remove('hidden');
    }

    function closeEpisodeDetailsModal() {
        document.getElementById('episodeDetailsModal').classList.add('hidden');
    }

    function markSingleEpisodeWatched(season, episode) {
        const formData = new FormData();
        formData.append('TmdbId', mediaId);
        formData.append('Type', mediaType);
        formData.append('Title', mediaTitle);
        formData.append('PosterPath', mediaPoster);
        formData.append('CurrentSeason', season);
        formData.append('CurrentEpisode', episode);
        formData.append('TotalSeasons', @validSeasons.Count);
        formData.append('TotalEpisodes', @totalEpisodesCount);
        formData.append('Status', '@WatchStatus.Watching');
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Media/Add', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                userCurrentSeason = season;
                userCurrentEpisode = episode;
                if (episodesCache[season]) {
                    renderEpisodes(episodesCache[season], season);
                }
                window.location.reload();
            } else {
                alert(data.message || 'Failed to update progress.');
            }
        })
        .catch(() => window.location.reload());
    }

    function markSingleEpisodeUnwatched(season, episode) {
        let targetSeason = season;
        let targetEpisode = episode - 1;
        let targetStatus = '@WatchStatus.Watching';

        if (targetEpisode <= 0) {
            if (season > 1) {
                targetSeason = season - 1;
                const prevTab = document.getElementById(`seasonTab-${targetSeason}`);
                targetEpisode = prevTab ? parseInt(prevTab.dataset.episodes) : 1;
            } else {
                targetSeason = 1;
                targetEpisode = 0;
                targetStatus = '@WatchStatus.PlanToWatch';
            }
        }

        const formData = new FormData();
        formData.append('TmdbId', mediaId);
        formData.append('Type', mediaType);
        formData.append('Title', mediaTitle);
        formData.append('PosterPath', mediaPoster);
        formData.append('CurrentSeason', targetSeason);
        formData.append('CurrentEpisode', targetEpisode);
        formData.append('TotalSeasons', @validSeasons.Count);
        formData.append('TotalEpisodes', @totalEpisodesCount);
        formData.append('Status', targetStatus);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Media/Add', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            window.location.reload();
        })
        .catch(() => window.location.reload());
    }

    function markCurrentSeasonWatched() {
        const activeTab = document.getElementById(`seasonTab-${activeSeasonNumber}`);
        const totalEpInSeason = activeTab ? parseInt(activeTab.dataset.episodes) : 1;
        const totalSeasons = @validSeasons.Count;
        const isLastSeason = activeSeasonNumber >= totalSeasons;

        const formData = new FormData();
        formData.append('TmdbId', mediaId);
        formData.append('Type', mediaType);
        formData.append('Title', mediaTitle);
        formData.append('PosterPath', mediaPoster);
        formData.append('CurrentSeason', activeSeasonNumber);
        formData.append('CurrentEpisode', totalEpInSeason);
        formData.append('TotalSeasons', totalSeasons);
        formData.append('TotalEpisodes', @totalEpisodesCount);
        formData.append('Status', isLastSeason ? '@WatchStatus.Completed' : '@WatchStatus.Watching');
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Media/Add', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            window.location.reload();
        })
        .catch(() => window.location.reload());
    }

    function markCurrentSeasonUnwatched() {
        let targetSeason = activeSeasonNumber - 1;
        let targetEpisode = 0;
        let targetStatus = '@WatchStatus.Watching';

        if (targetSeason >= 1) {
            const prevTab = document.getElementById(`seasonTab-${targetSeason}`);
            targetEpisode = prevTab ? parseInt(prevTab.dataset.episodes) : 1;
        } else {
            targetSeason = 1;
            targetEpisode = 0;
            targetStatus = '@WatchStatus.PlanToWatch';
        }

        const formData = new FormData();
        formData.append('TmdbId', mediaId);
        formData.append('Type', mediaType);
        formData.append('Title', mediaTitle);
        formData.append('PosterPath', mediaPoster);
        formData.append('CurrentSeason', targetSeason);
        formData.append('CurrentEpisode', targetEpisode);
        formData.append('TotalSeasons', @validSeasons.Count);
        formData.append('TotalEpisodes', @totalEpisodesCount);
        formData.append('Status', targetStatus);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        fetch('/Media/Add', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            window.location.reload();
        })
        .catch(() => window.location.reload());
    }

    function openRewatchModal(watchItemId, title, type, rewatchCount) {
        document.getElementById('rewatchWatchItemId').value = watchItemId;
        document.getElementById('rewatchScope').value = 'EntireTitle';
        document.getElementById('rewatchTargetSeason').value = '';
        document.getElementById('rewatchTargetEpisode').value = '';
        document.getElementById('rewatchModalTitle').innerText = 'Rewatch Entire Title';
        document.getElementById('rewatchModalSubtitle').innerText = `${title} • Watched ${rewatchCount > 0 ? rewatchCount + 1 + 'x' : '1x'}`;
        document.getElementById('rewatchOptLogLabel').innerText = 'Log Finished Repeat (+1 count)';
        document.getElementById('rewatchOptLogDesc').innerText = 'I finished rewatching this title. Add to stats and keep status as Finished.';
        
        const restartWrapper = document.getElementById('rewatchOptRestartWrapper');
        if (type == 1) { // Movie
            restartWrapper.classList.add('hidden');
        } else {
            restartWrapper.classList.remove('hidden');
            document.getElementById('rewatchOptRestartLabel').innerText = 'Start Watching Again From Ep 1';
            document.getElementById('rewatchOptRestartDesc').innerText = 'Reset current progress to Season 1 Episode 1 and change status back to Watching.';
        }
        
        document.getElementById('rewatchOptLog').checked = true;
        document.getElementById('rewatchModal').classList.remove('hidden');
    }

    function closeRewatchModal() {
        document.getElementById('rewatchModal').classList.add('hidden');
    }

    function openSeasonRewatchModal() {
        if (!userWatchItemId) {
            openWatchedModal(mediaId, mediaTitle, mediaType, @(validSeasons.Count), @totalEpisodesCount);
            return;
        }
        document.getElementById('rewatchWatchItemId').value = userWatchItemId;
        document.getElementById('rewatchScope').value = 'Season';
        document.getElementById('rewatchTargetSeason').value = activeSeasonNumber;
        document.getElementById('rewatchTargetEpisode').value = '';
        document.getElementById('rewatchModalTitle').innerText = `Rewatch Season ${activeSeasonNumber}`;
        document.getElementById('rewatchModalSubtitle').innerText = `${mediaTitle} - Season ${activeSeasonNumber}`;
        
        document.getElementById('rewatchOptLogLabel').innerText = `Log Season ${activeSeasonNumber} Repeat (+1 count)`;
        document.getElementById('rewatchOptLogDesc').innerText = `Record that you rewatched Season ${activeSeasonNumber} without changing other seasons.`;
        
        const restartWrapper = document.getElementById('rewatchOptRestartWrapper');
        restartWrapper.classList.remove('hidden');
        document.getElementById('rewatchOptRestartLabel').innerText = `Start Watching from Season ${activeSeasonNumber} Ep 1`;
        document.getElementById('rewatchOptRestartDesc').innerText = `Set progress to Season ${activeSeasonNumber} Episode 1 and status to Watching without resetting earlier seasons.`;
        
        document.getElementById('rewatchOptLog').checked = true;
        document.getElementById('rewatchModal').classList.remove('hidden');
    }

    function openEpisodeRewatchModal(seasonNumber, episodeNumber, epTitle) {
        if (!userWatchItemId) {
            openWatchedModal(mediaId, mediaTitle, mediaType, @(validSeasons.Count), @totalEpisodesCount);
            return;
        }
        document.getElementById('rewatchWatchItemId').value = userWatchItemId;
        document.getElementById('rewatchScope').value = 'Episode';
        document.getElementById('rewatchTargetSeason').value = seasonNumber;
        document.getElementById('rewatchTargetEpisode').value = episodeNumber;
        
        const epLabel = epTitle ? `S${seasonNumber}E${episodeNumber}: ${epTitle}` : `Season ${seasonNumber} Episode ${episodeNumber}`;
        document.getElementById('rewatchModalTitle').innerText = `Rewatch Episode`;
        document.getElementById('rewatchModalSubtitle').innerText = `${mediaTitle} - ${epLabel}`;
        
        document.getElementById('rewatchOptLogLabel').innerText = `Log Episode Repeat (+1 count)`;
        document.getElementById('rewatchOptLogDesc').innerText = `Record that you rewatched ${epLabel}.`;
        
        const restartWrapper = document.getElementById('rewatchOptRestartWrapper');
        restartWrapper.classList.remove('hidden');
        document.getElementById('rewatchOptRestartLabel').innerText = `Start Watching from S${seasonNumber}E${episodeNumber}`;
        document.getElementById('rewatchOptRestartDesc').innerText = `Set current progress to Season ${seasonNumber} Episode ${episodeNumber} and status to Watching.`;
        
        document.getElementById('rewatchOptLog').checked = true;
        document.getElementById('rewatchModal').classList.remove('hidden');
    }

    function submitUndoRewatch() {
        const form = document.getElementById('directUndoRewatchForm');
        if (form) {
            form.submit();
        }
    }

    function openWatchedModal(tmdbId, title, type, totalSeasons, totalEpisodes) {
        setWatchedDatePreset(3); // Default to 3 years ago preset as requested by user
        document.getElementById('watchedModal').classList.remove('hidden');
    }

    function closeWatchedModal() {
        document.getElementById('watchedModal').classList.add('hidden');
    }

    function setWatchedDatePreset(yearsAgo, btnElement) {
        const d = new Date();
        d.setFullYear(d.getFullYear() - yearsAgo);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const dateStr = `${yyyy}-${mm}-${dd}`;

        const input = document.getElementById('watchedModalDateInput');
        if (input) input.value = dateStr;

        document.querySelectorAll('.date-preset-btn').forEach(b => {
            b.className = 'date-preset-btn px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-650 transition-colors';
        });

        if (btnElement) {
            btnElement.className = 'date-preset-btn px-3 py-1 rounded-xl bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 border border-brand-300 dark:border-brand-700 font-bold transition-colors';
        }
    }

    function openRateModal() {
        const modal = document.getElementById('rateModal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeRateModal() {
        const modal = document.getElementById('rateModal');
        if (modal) modal.classList.add('hidden');
    }

    function openDeleteDetailsModal() {
        const modal = document.getElementById('deleteDetailsModal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeDeleteDetailsModal() {
        const modal = document.getElementById('deleteDetailsModal');
        if (modal) modal.classList.add('hidden');
    }

    // Auto load initial season on DOM ready
    document.addEventListener("DOMContentLoaded", function() {
        if (@validSeasons.Count > 0) {
            selectSeason(@initialSeasonNumber);
        }
    });
</script>
