@using System.Collections.Generic
@using System.Linq
@using AzureTest.Contracts.DTOs.Media
@using AzureTest.Domain.Media.Enums
@model TmdbSearchResultDto

@{
    var item = Model;
    var userWatchItems = ViewBag.UserWatchItems as Dictionary<(int TmdbId, MediaType Type), WatchItemDto>;

    WatchItemDto? userWatchItem = null;
    if (userWatchItems != null)
    {
        if (!userWatchItems.TryGetValue((item.Id, item.Type), out userWatchItem))
        {
            userWatchItem = userWatchItems.Values.FirstOrDefault(w => w.TmdbId == item.Id);
        }
    }

    string PosterUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=400&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";

    string Slugify(string? title) => string.IsNullOrWhiteSpace(title) 
        ? "title" 
        : System.Text.RegularExpressions.Regex.Replace(title.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');

    string TypeBadgeClass(MediaType type) => type switch
    {
        MediaType.Movie => "bg-blue-600/95 text-white shadow-2xs",
        MediaType.TvSeries => "bg-purple-600/95 text-white shadow-2xs",
        MediaType.Anime => "bg-rose-600/95 text-white shadow-2xs",
        _ => "bg-slate-700/95 text-white shadow-2xs"
    };

    string TypeName(MediaType type) => type switch
    {
        MediaType.Movie => "Movie",
        MediaType.TvSeries => "Series",
        MediaType.Anime => "Anime",
        _ => "Media"
    };

    var slug = Slugify(item.Title);
}

<div class="group relative flex flex-col bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-2xs hover:shadow-md transition-all">
    <!-- Poster with overlay -->
    <div class="relative aspect-2/3 bg-slate-900 overflow-hidden">
        <img src="@PosterUrl(item.PosterPath)" alt="@item.Title"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
             loading="lazy" />

        <!-- Top Badges -->
        <div class="absolute top-2 left-2 flex flex-col gap-1 items-start">
            <span class="px-2 py-0.5 rounded-lg text-3xs font-bold uppercase tracking-wider backdrop-blur-xs @TypeBadgeClass(item.Type)">
                @TypeName(item.Type)
            </span>

            @if (userWatchItem != null)
            {
                switch (userWatchItem.Status)
                {
                    case WatchStatus.Completed:
                        <span class="px-2 py-0.5 rounded-lg text-3xs font-bold backdrop-blur-xs bg-emerald-600/95 text-white shadow-2xs flex items-center gap-1">
                            <i class="fa-solid fa-check text-3xs"></i> Finished
                        </span>
                        break;
                    case WatchStatus.Watching:
                        <span class="px-2 py-0.5 rounded-lg text-3xs font-bold backdrop-blur-xs bg-blue-600/95 text-white shadow-2xs flex items-center gap-1">
                            <i class="fa-solid fa-play text-3xs"></i>
                            @(!userWatchItem.IsMovie && (userWatchItem.CurrentSeason > 0 || userWatchItem.CurrentEpisode > 0)
                                ? $"S{userWatchItem.CurrentSeason}:E{userWatchItem.CurrentEpisode}"
                                : "Watching")
                        </span>
                        break;
                    case WatchStatus.PlanToWatch:
                        <span class="px-2 py-0.5 rounded-lg text-3xs font-bold backdrop-blur-xs bg-amber-600/95 text-white shadow-2xs flex items-center gap-1">
                            <i class="fa-solid fa-bookmark text-3xs"></i> Wishlist
                        </span>
                        break;
                    case WatchStatus.Dropped:
                        <span class="px-2 py-0.5 rounded-lg text-3xs font-bold backdrop-blur-xs bg-rose-600/95 text-white shadow-2xs flex items-center gap-1">
                            <i class="fa-solid fa-circle-stop text-3xs"></i> Stopped
                        </span>
                        break;
                }
            }
        </div>

        @if (item.VoteAverage.HasValue && item.VoteAverage > 0)
        {
            <div class="absolute top-2 right-2 px-2 py-0.5 rounded-lg bg-slate-950/80 backdrop-blur-xs text-amber-400 border border-slate-700/50 text-3xs font-bold flex items-center gap-1">
                <i class="fa-solid fa-star text-3xs"></i>
                <span>@item.VoteAverage.Value.ToString("0.0")</span>
            </div>
        }

        <!-- Quick Action Overlay on Hover -->
        <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-3 gap-2">
            <a asp-action="Details" asp-controller="Media" asp-route-id="@item.Id" asp-route-slug="@slug" asp-route-type="@item.Type"
               class="w-full py-2 rounded-xl bg-white/95 hover:bg-white text-slate-900 dark:bg-slate-800/95 dark:hover:bg-slate-700 dark:text-white dark:border dark:border-slate-600 text-xs font-bold text-center transition-all shadow-sm flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-circle-info text-brand-600 dark:text-brand-400"></i>
                <span>Details</span>
            </a>
            <button type="button"
                    onclick="openQuickAddModal('@item.Id', '@item.Type', '@Html.Raw(item.Title.Replace("'", "\\\'"))', '@(item.PosterPath ?? "")')"
                    class="w-full py-2 rounded-xl @(userWatchItem != null ? "bg-slate-800 hover:bg-slate-700 text-white" : "bg-brand-600 hover:bg-brand-700 text-white") text-xs font-bold transition-colors shadow-sm flex items-center justify-center gap-1.5">
                <i class="fa-solid @(userWatchItem != null ? "fa-pen-to-square" : "fa-plus") text-xs"></i>
                <span>@(userWatchItem != null ? "Update" : "Add")</span>
            </button>
        </div>
    </div>

    <!-- Info -->
    <div class="p-3 flex-1 flex flex-col justify-between">
        <a asp-action="Details" asp-controller="Media" asp-route-id="@item.Id" asp-route-slug="@slug" asp-route-type="@item.Type"
           class="text-xs font-bold text-slate-900 dark:text-white hover:text-brand-600 dark:hover:text-brand-400 line-clamp-1 transition-colors" title="@item.Title">
            @item.Title
        </a>
        <div class="flex items-center justify-between text-3xs text-slate-500 dark:text-slate-400 mt-1.5">
            <span>@(item.ReleaseDate?.Year.ToString() ?? "TBA")</span>
            @if (item.VoteAverage.HasValue && item.VoteAverage > 0)
            {
                <span class="text-amber-500 font-semibold flex items-center gap-1">
                    <i class="fa-solid fa-star text-3xs"></i> @item.VoteAverage.Value.ToString("0.0")
                </span>
            }
        </div>
    </div>
</div>
