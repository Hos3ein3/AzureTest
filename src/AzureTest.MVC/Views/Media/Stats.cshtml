@using AzureTest.Contracts.DTOs.Media
@using AzureTest.MVC.Models
@model MediaStatsDto

@{
    ViewData["Title"] = "Watch Statistics";

    var headerModel = new PageHeaderModel(
        Title: "Media Analytics & Statistics",
        Subtitle: "Comprehensive insights into your watch time, preferred genres, top talent, and ratings.",
        Icon: "fa-solid fa-chart-simple",
        Badge: $"{Model.TotalEstimatedHoursWatched} Hours Watched",
        ActionText: "Back to Watchlist",
        ActionUrl: Url.Action("Index", "Media"),
        ActionIcon: "fa-solid fa-film"
    );
}

<div class="space-y-8">
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <!-- Top KPI Stat Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Total Hours -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Total Watch Time</span>
                <span class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-clock"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-slate-900 tracking-tight">
                @Model.TotalEstimatedHoursWatched <span class="text-xs font-semibold text-slate-400">hours</span>
            </div>
            <p class="text-3xs text-slate-400">~@Model.TotalEstimatedMinutesWatched minutes logged</p>
        </div>

        <!-- Episodes Watched -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Episodes Watched</span>
                <span class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-tv"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-slate-900 tracking-tight">
                @Model.TotalEpisodesWatched
            </div>
            <p class="text-3xs text-slate-400">Across series and anime</p>
        </div>

        <!-- Titles Finished -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Titles Finished</span>
                <span class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-circle-check"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-slate-900 tracking-tight">
                @Model.TotalItemsWatched
            </div>
            <p class="text-3xs text-slate-400">@Model.TotalMoviesWatched movies, @Model.TotalSeriesWatched series, @Model.TotalAnimeWatched anime</p>
        </div>

        <!-- Average Rating -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Average Rating</span>
                <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-star"></i>
                </span>
            </div>
            <div class="text-2xl font-black text-slate-900 tracking-tight">
                @(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "—") <span class="text-xs font-semibold text-slate-400">/ 10</span>
            </div>
            <p class="text-3xs text-slate-400">From your rated titles</p>
        </div>
    </div>

    <!-- Media Type & Watch Status Split -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Type Breakdown -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-layer-group"></i>
                    </span>
                    <h3 class="text-sm font-bold text-slate-900">Media Type Breakdown</h3>
                </div>
            </div>

            <div class="space-y-3">
                @foreach (var type in Model.TypeBreakdown)
                {
                    var icon = type.MediaType switch
                    {
                        "Movie" => "fa-solid fa-film text-blue-500",
                        "TvSeries" => "fa-solid fa-tv text-purple-500",
                        "Anime" => "fa-solid fa-dragon text-rose-500",
                        _ => "fa-solid fa-photo-film text-slate-500"
                    };

                    <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <i class="@icon text-sm"></i>
                            <div>
                                <h4 class="text-xs font-bold text-slate-900">@type.MediaType</h4>
                                <p class="text-3xs text-slate-400">@type.HoursWatched hours spent</p>
                            </div>
                        </div>
                        <span class="text-xs font-black text-slate-800">
                            @type.Count titles
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- Status Breakdown -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-chart-pie"></i>
                    </span>
                    <h3 class="text-sm font-bold text-slate-900">Watch Status Distribution</h3>
                </div>
            </div>

            <div class="space-y-3">
                @foreach (var stat in Model.StatusBreakdown)
                {
                    <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <span class="w-3 h-3 rounded-full" style="background-color: @stat.ColorHex;"></span>
                            <h4 class="text-xs font-bold text-slate-900">@stat.Status</h4>
                        </div>
                        <span class="text-xs font-black text-slate-800">
                            @stat.Count titles
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Favorite Genres -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-5">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-tags"></i>
                </span>
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Favorite Genres</h3>
                    <p class="text-xs text-slate-500">Genres you watch most often.</p>
                </div>
            </div>
        </div>

        @if (!Model.TopGenres.Any())
        {
            <p class="text-xs text-slate-400 italic">No genres logged yet. Start watching titles to populate genre analytics.</p>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var genre in Model.TopGenres.Take(8))
                {
                    <div class="space-y-1">
                        <div class="flex items-center justify-between text-xs font-semibold">
                            <span class="text-slate-800">@genre.Genre</span>
                            <span class="text-slate-500">@genre.Count titles (@genre.Percentage%)</span>
                        </div>
                        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-brand-600 rounded-full" style="width: @(genre.Percentage)%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Top Actors and Directors -->
    @if (Model.TopActors.Any())
    {
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-star"></i>
                    </span>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Favorite Actors & Talent</h3>
                        <p class="text-xs text-slate-500">People whose movies and shows you've watched most.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                @foreach (var actor in Model.TopActors.Take(8))
                {
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center text-xs font-bold flex-shrink-0">
                            @actor.Name.Substring(0, 1)
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-slate-900 truncate">@actor.Name</h4>
                            <p class="text-3xs text-slate-400">@actor.WatchedCount watched</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Rating Distribution (1 to 10) -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-2xs space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                    <i class="fa-solid fa-chart-column"></i>
                </span>
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Your Ratings Distribution</h3>
                    <p class="text-xs text-slate-500">Scores given from 1 (poor) to 10 (masterpiece).</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-10 gap-2 items-end h-36 pt-6 px-2">
            @{
                var maxRatingCount = Model.RatingDistribution.Values.Any() ? Math.Max(1, Model.RatingDistribution.Values.Max()) : 1;
            }
            @for (int score = 1; score <= 10; score++)
            {
                var count = Model.RatingDistribution.TryGetValue(score, out var c) ? c : 0;
                var heightPercent = (int)Math.Round((count / (double)maxRatingCount) * 100);

                <div class="flex flex-col items-center gap-1 h-full justify-end group">
                    <span class="text-3xs font-semibold text-slate-500 group-hover:text-brand-600">@count</span>
                    <div class="w-full bg-slate-100 group-hover:bg-amber-400 rounded-t-lg transition-all"
                         style="height: @(Math.Max(6, heightPercent))%;"></div>
                    <span class="text-2xs font-bold text-slate-700 mt-1">@score★</span>
                </div>
            }
        </div>
    </div>
</div>
