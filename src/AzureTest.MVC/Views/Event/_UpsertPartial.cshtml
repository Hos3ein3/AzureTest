@model AzureTest.Application.Events.Commands.IEventFormModel

<div class="space-y-4">
    <div>
        <label asp-for="Title" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Event Title <span class="text-rose-500">*</span>
        </label>
        <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-heading"></i>
            </span>
            <input asp-for="Title" required class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="e.g. Sprint Planning, Doctor Appointment" />
        </div>
        <span asp-validation-for="Title" class="text-rose-600 text-2xs mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Description" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Description
        </label>
        <textarea asp-for="Description" rows="3" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="Agenda, location, or notes..."></textarea>
        <span asp-validation-for="Description" class="text-rose-600 text-2xs mt-1 block"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label asp-for="StartDate" class="block text-xs font-semibold text-slate-700 mb-1.5">
                Start Date & Time <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                    <i class="fa-solid fa-calendar"></i>
                </span>
                <input asp-for="StartDate" type="datetime-local" required class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" />
            </div>
            <span asp-validation-for="StartDate" class="text-rose-600 text-2xs mt-1 block"></span>
        </div>
        <div>
            <label asp-for="EndDate" class="block text-xs font-semibold text-slate-700 mb-1.5">
                End Date & Time <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                    <i class="fa-solid fa-calendar-check"></i>
                </span>
                <input asp-for="EndDate" type="datetime-local" required class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" />
            </div>
            <span asp-validation-for="EndDate" class="text-rose-600 text-2xs mt-1 block"></span>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
        <div class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50/50">
            <input asp-for="IsAllDay" type="checkbox" class="w-4 h-4 rounded text-brand-600 border-slate-300 focus:ring-brand-500" />
            <label asp-for="IsAllDay" class="text-xs font-semibold text-slate-700 cursor-pointer">All Day Event</label>
        </div>

        <div>
            <label asp-for="Color" class="block text-xs font-semibold text-slate-700 mb-1.5">Highlight Color</label>
            <div class="flex items-center gap-3">
                <input asp-for="Color" type="color" class="h-10 w-16 rounded-xl border border-slate-300 p-1 cursor-pointer bg-white" value="#3b82f6" />
                <span class="text-2xs text-slate-500">Badge color on calendar & timeline</span>
            </div>
            <span asp-validation-for="Color" class="text-rose-600 text-2xs mt-1 block"></span>
        </div>
    </div>
</div>
