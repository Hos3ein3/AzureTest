@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Events.EventDto>
@{
    ViewData["Title"] = "Events";
}

<nav aria-label="breadcrumb" class="mb-6 flex justify-between items-center">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li class="font-medium text-slate-800" aria-current="page">Events</li>
    </ol>
    <a asp-action="Create" class="inline-flex justify-center rounded-lg border border-transparent bg-brand-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-brand-700 transition-colors">
        <i class="fa-solid fa-plus mr-2 mt-1"></i> Create New Event
    </a>
</nav>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h5 class="text-sm font-semibold text-slate-800 m-0"><i class="fa-regular fa-calendar-days mr-2 text-brand-500"></i> Events List</h5>
        <form asp-action="Index" method="get" class="flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search events..." class="rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-1 border" />
            <button type="submit" class="bg-slate-100 text-slate-600 px-3 py-1 rounded-lg border border-slate-200 hover:bg-slate-200 text-sm">Search</button>
            <a asp-action="Index" class="bg-slate-100 text-slate-600 px-3 py-1 rounded-lg border border-slate-200 hover:bg-slate-200 text-sm">Clear</a>
        </form>
    </div>
    
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="hover:text-brand-600">Title <i class="fa-solid fa-sort ml-1"></i></a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="hover:text-brand-600">Start Date <i class="fa-solid fa-sort ml-1"></i></a>
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">End Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">All Day</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-500">
                            No events found.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                @if (!string.IsNullOrEmpty(item.Color))
                                {
                                    <div class="w-3 h-3 rounded-full mr-3" style="background-color: @item.Color"></div>
                                }
                                else
                                {
                                    <div class="w-3 h-3 rounded-full mr-3 bg-brand-500"></div>
                                }
                                <div class="text-sm font-medium text-slate-900">@item.Title</div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                            @item.StartDate.ToString("g")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                            @item.EndDate.ToString("g")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                            @(item.IsAllDay ? "Yes" : "No")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-900 mr-3">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-slate-600 hover:text-slate-900 mr-3">Details</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                <button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<div class="flex items-center justify-between">
    <div class="text-sm text-slate-700">
        Showing page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)
    </div>
    <div class="flex gap-2">
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm hover:bg-slate-50">Previous</a>
        }
        else
        {
            <span class="bg-slate-100 border border-slate-200 text-slate-400 px-4 py-2 rounded-lg text-sm cursor-not-allowed">Previous</span>
        }

        @if (Model.HasNextPage)
        {
            <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm hover:bg-slate-50">Next</a>
        }
        else
        {
            <span class="bg-slate-100 border border-slate-200 text-slate-400 px-4 py-2 rounded-lg text-sm cursor-not-allowed">Next</span>
        }
    </div>
</div>
