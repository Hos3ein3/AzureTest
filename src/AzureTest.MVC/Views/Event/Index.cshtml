@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Events.EventDto, AzureTest.Contracts.DTOs.Events.GetAllEventsFilters>
@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Events";
    var pageHeader = new PageHeaderModel
    {
        Title = "Events",
        Subtitle = "Manage appointments, deadlines, and timeline events",
        Icon = "fa-solid fa-calendar-days",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", "/"),
            new BreadcrumbItem("Events", active: true)
        },
        ActionText = "New Event",
        ActionUrl = Url.Action("Create", "Event"),
        ActionIcon = "fa-solid fa-plus"
    };

    var pagination = new PaginationModel
    {
        CurrentPage = Model.PageNumber,
        PageSize = Model.PageSize,
        TotalItems = Model.TotalCount,
        PageUrlFactory = p => Url.Action("Index", new { pageNumber = p, sortOrder = ViewData["CurrentSort"], searchString = ViewData["CurrentFilter"] })!
    };
}

<partial name="UiComponents/_PageHeader" model="pageHeader" />

<!-- Search/Filter Bar -->
<div class="mb-6 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs">
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
            <div class="md:col-span-3">
                <label class="block text-2xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Search Events</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input name="searchString" type="text" value="@ViewData["CurrentFilter"]" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="Search events by title..." />
                </div>
            </div>
            
            <div class="md:col-span-3 flex items-end justify-start gap-2">
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm transition-colors">
                    <i class="fa-solid fa-filter text-2xs"></i>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-xs font-semibold transition-colors" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>Reset</span>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden mb-6">
    @if (!Model.Items.Any())
    {
        <partial name="UiComponents/_EmptyState" model='new EmptyStateModel("No events found", "You haven&#39;t created any events yet or no events match your search.", "fa-solid fa-calendar-xmark", "Create Event", Url.Action("Create", "Event"))' />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50/75 text-slate-500 font-semibold border-b border-slate-200/80 uppercase tracking-wider text-2xs">
                    <tr>
                        <th class="px-5 py-3.5">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="inline-flex items-center gap-1.5 hover:text-brand-600 transition-colors">
                                <span>Title</span>
                                <i class="fa-solid fa-sort text-3xs"></i>
                            </a>
                        </th>
                        <th class="px-5 py-3.5">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="inline-flex items-center gap-1.5 hover:text-brand-600 transition-colors">
                                <span>Start Date</span>
                                <i class="fa-solid fa-sort text-3xs"></i>
                            </a>
                        </th>
                        <th class="px-5 py-3.5">End Date</th>
                        <th class="px-5 py-3.5">All Day</th>
                        <th class="px-5 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.Color))
                                    {
                                        <span class="w-2.5 h-2.5 rounded-full inline-block shrink-0 shadow-2xs" style="background-color: @item.Color"></span>
                                    }
                                    else
                                    {
                                        <span class="w-2.5 h-2.5 rounded-full inline-block bg-brand-500 shrink-0 shadow-2xs"></span>
                                    }
                                    <span class="font-semibold text-slate-900">@item.Title</span>
                                </div>
                            </td>
                            <td class="px-5 py-3.5 text-slate-600">@item.StartDate.ToString("g")</td>
                            <td class="px-5 py-3.5 text-slate-600">@item.EndDate.ToString("g")</td>
                            <td class="px-5 py-3.5">
                                @if (item.IsAllDay)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200/60 px-2 py-0.5 text-3xs font-semibold text-blue-700">
                                        <i class="fa-solid fa-check"></i> Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-3xs font-medium">No</span>
                                }
                            </td>
                            <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="w-7 h-7 rounded-lg text-slate-500 hover:text-brand-600 hover:bg-brand-50 flex items-center justify-center transition-colors" title="Details">
                                        <i class="fa-solid fa-eye text-xs"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="w-7 h-7 rounded-lg text-slate-500 hover:text-brand-600 hover:bg-brand-50 flex items-center justify-center transition-colors" title="Edit">
                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        <button type="submit" class="w-7 h-7 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors" title="Delete">
                                            <i class="fa-solid fa-trash text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="UiComponents/_Pagination" model="pagination" />
    }
</div>
