@model AzureTest.MVC.ViewModels.Tenants.TenantManagementViewModel
@{
    ViewData["Title"] = "Tenant Management";

    string GetPageUrl(int pageNumber)
    {
        return $"?PageNumber={pageNumber}&PageSize={Model.PageSize}&SearchTerm={Model.SearchTerm}";
    }
}

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Tenant Management</h1>
        <p class="text-sm text-slate-500 mt-1">Switch active tenant workspace for administrative oversight, debugging, and auditing.</p>
    </div>

    <div class="flex items-center gap-3">
        @if (Model.IsMultiTenancyEnabled)
        {
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <i class="fa-solid fa-circle-check mr-1.5 text-emerald-500"></i> Multi-Tenancy Active
            </span>
        }
        else
        {
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                <i class="fa-solid fa-triangle-exclamation mr-1.5 text-amber-500"></i> Multi-Tenancy Disabled
            </span>
        }

        <form asp-action="TriggerBackfillJob" method="post" class="inline" onsubmit="return confirm('Enqueue background job to sync TenantId = UserId for legacy records across PostgreSQL and MongoDB?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="inline-flex items-center px-3.5 py-1.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors" title="Sync legacy records">
                <i class="fa-solid fa-bolt mr-1.5 text-amber-400"></i> Run Backfill Job
            </button>
        </form>

        <a href="/hangfire" target="_blank" class="inline-flex items-center px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg border border-slate-300 transition-colors" title="Open Hangfire Dashboard">
            <i class="fa-solid fa-server mr-1.5 text-brand-600"></i> Job Monitor
        </a>

        @if (Model.IsAdminImpersonating)
        {
            <form asp-action="ResetTenant" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors">
                    <i class="fa-solid fa-arrow-rotate-left mr-1.5"></i> Exit Impersonation
                </button>
            </form>
        }
    </div>
</div>

@if (!Model.IsMultiTenancyEnabled)
{
    <div class="mb-6 p-4 rounded-xl bg-amber-50 border border-amber-200 flex items-start" role="alert">
        <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 mr-3 text-lg"></i>
        <div class="flex-1 text-sm text-amber-800">
            <h4 class="font-semibold mb-1">Multi-Tenancy is Disabled</h4>
            <p>
                Multi-tenancy isolation is turned off in the system configuration (<code class="bg-amber-100 text-amber-900 px-1 py-0.5 rounded text-xs">FeatureManagement:EnableMultiTenancy</code> is <span class="font-bold">false</span>).
                All database queries and document operations bypass tenant isolation while this setting is disabled.
            </p>
        </div>
    </div>
}

<!-- Active Context Overview Card -->
<div class="mb-6 bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <div class="flex items-center space-x-2">
            <i class="fa-solid fa-building-user text-brand-600"></i>
            <h2 class="text-sm font-semibold text-slate-800 uppercase tracking-wider">Active Workspace Context</h2>
        </div>
        @if (Model.IsAdminImpersonating)
        {
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 border border-amber-300">
                <i class="fa-solid fa-user-secret mr-1"></i> Impersonating
            </span>
        }
        else
        {
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                <i class="fa-solid fa-shield-halved mr-1"></i> Personal Admin Workspace
            </span>
        }
    </div>
    <div class="p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="border-l-4 border-brand-500 pl-4 py-1">
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active Tenant ID</div>
                <div class="text-sm font-mono font-semibold text-slate-800 mt-1 break-all">
                    @(Model.CurrentTenantId != Guid.Empty ? Model.CurrentTenantId.ToString() : "Global / Bypass")
                </div>
                <div class="text-xs text-slate-500 mt-0.5">
                    Admin ID: <span class="font-mono">@Model.RealAdminUserId</span>
                </div>
            </div>

            <div class="border-l-4 @(Model.IsAdminImpersonating ? "border-amber-500" : "border-slate-300") pl-4 py-1">
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active Tenant Owner</div>
                <div class="text-sm font-semibold text-slate-800 mt-1">
                    @(string.IsNullOrWhiteSpace(Model.CurrentTenantName) ? "Default / Admin" : Model.CurrentTenantName)
                </div>
                <div class="text-xs text-slate-500 mt-0.5 truncate">
                    @(string.IsNullOrWhiteSpace(Model.CurrentTenantEmail) ? "System Root" : Model.CurrentTenantEmail)
                </div>
            </div>

            <div class="border-l-4 @(!Model.AllowImpersonationWrites ? "border-emerald-500" : "border-amber-500") pl-4 py-1">
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Impersonation Policy</div>
                <div class="text-sm font-semibold text-slate-800 mt-1 flex items-center gap-1.5">
                    @if (!Model.AllowImpersonationWrites)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300">
                            <i class="fa-solid fa-lock mr-1 text-xs"></i> Read-Only Enforced
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">
                            <i class="fa-solid fa-triangle-exclamation mr-1 text-xs"></i> Writes Allowed
                        </span>
                    }
                </div>
                <div class="text-xs text-slate-500 mt-0.5">
                    AllowImpersonationWrites: @(Model.AllowImpersonationWrites ? "true" : "false")
                </div>
            </div>

            <div class="border-l-4 border-slate-300 pl-4 py-1">
                <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Immutable Audit Log</div>
                <div class="text-sm font-semibold text-slate-800 mt-1 flex items-center gap-1.5">
                    @if (Model.ImmutableAuditLog)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-300">
                            <i class="fa-solid fa-shield-halved mr-1 text-xs"></i> Enabled
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                            <i class="fa-solid fa-clock mr-1 text-xs"></i> Planned / Inactive
                        </span>
                    }
                </div>
                <div class="text-xs text-slate-500 mt-0.5">
                    ImmutableAuditLog: @(Model.ImmutableAuditLog ? "true" : "false")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Impersonate Switcher Card -->
<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-200">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
            <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-user-secret text-indigo-600 text-base"></i> Impersonate Any Tenant
            </h3>
            <p class="text-xs text-slate-500 mt-1">Select a tenant from the dropdown below to instantly switch into their isolated workspace environment.</p>
        </div>
        
        <form asp-action="SwitchTenant" method="post" class="flex flex-wrap items-center gap-3">
            @Html.AntiForgeryToken()
            <div class="w-full sm:w-80">
                <select name="targetTenantId" asp-items="Model.AllTenantsList" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="">-- Choose Tenant to Impersonate --</option>
                </select>
            </div>
            <button type="submit" @(Model.IsMultiTenancyEnabled ? "" : "disabled") class="inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors">
                <i class="fa-solid fa-user-secret mr-1.5"></i> Impersonate Workspace
            </button>
            @if (Model.IsAdminImpersonating)
            {
                <form asp-action="ResetTenant" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center px-3.5 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors">
                        <i class="fa-solid fa-arrow-rotate-left mr-1.5"></i> Exit Impersonation
                    </button>
                </form>
            }
        </form>
    </div>
</div>

<!-- Filter / Search Bar -->
<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-200">
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Search Tenants</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@Model.SearchTerm" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg text-sm bg-white placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500" placeholder="Filter by Name, Email, Username..." />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Page Size</label>
                <select name="PageSize" class="block w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-1 focus:ring-brand-500 focus:border-brand-500">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size" selected>@size per page</option>
                        }
                        else
                        {
                            <option value="@size">@size per page</option>
                        }
                    }
                </select>
            </div>

            <div class="flex items-end space-x-2">
                <button type="submit" class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-slate-800 hover:bg-slate-900 transition-colors">
                    <i class="fa-solid fa-filter mr-2"></i> Filter
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition-colors" title="Reset Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@if (Model.TotalCount <= 1 && !Model.IsAdminImpersonating)
{
    <div class="mb-6 p-4 rounded-xl bg-blue-50 border border-blue-200 text-sm text-blue-900 flex items-start gap-3">
        <i class="fa-solid fa-circle-info text-blue-500 text-base mt-0.5"></i>
        <div class="flex-1">
            <span class="font-bold">Only 1 User Exists in Database:</span>
            Your account is currently the only user registered in the system. Because this is already your active workspace, there are no other tenants to switch to yet.
            To test tenant switching, simply create or register another user at <a asp-controller="User" asp-action="Create" class="font-bold underline text-indigo-700 hover:text-indigo-900">/User/Create</a> or <a href="/Auth/Register" class="font-bold underline text-indigo-700 hover:text-indigo-900">/Auth/Register</a>. Once created, the <strong>"Switch To"</strong> button will appear next to their name.
        </div>
    </div>
}

<!-- Tenants Table -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Tenant / User</th>
                    <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Email & Username</th>
                    <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Tenant Identifier</th>
                    <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Impersonate Workspace</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
                @if (Model.Tenants.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                            <i class="fa-solid fa-users-slash text-3xl text-slate-300 mb-2 block"></i>
                            No tenant workspaces found matching your query.
                        </td>
                    </tr>
                }
                @foreach (var tenant in Model.Tenants)
                {
                    <tr class="@(tenant.IsActiveTenant ? "bg-brand-50/40" : "hover:bg-slate-50/70") transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center space-x-3">
                                <div class="w-9 h-9 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-sm">
                                    @(string.IsNullOrWhiteSpace(tenant.FullName) ? "U" : tenant.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="text-sm font-semibold text-slate-900">
                                        @(string.IsNullOrWhiteSpace(tenant.FullName) ? "Unnamed User" : tenant.FullName)
                                    </div>
                                    @if (tenant.IsCurrentAdmin)
                                    {
                                        <span class="inline-flex items-center text-[11px] font-medium text-slate-500">
                                            <i class="fa-solid fa-crown text-amber-500 mr-1 text-[10px]"></i> Your Account
                                        </span>
                                    }
                                </div>
                            </div>
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-slate-700">@tenant.Email</div>
                            <div class="text-xs text-slate-400">@tenant.UserName</div>
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center space-x-2">
                                <code class="text-xs font-mono bg-slate-100 text-slate-700 px-2 py-1 rounded">@tenant.TenantId</code>
                                <button type="button" onclick="navigator.clipboard.writeText('@tenant.TenantId')" class="text-slate-400 hover:text-slate-600 text-xs" title="Copy Tenant ID">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-center">
                            @if (tenant.IsActiveTenant)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                    <i class="fa-solid fa-check mr-1 text-emerald-600"></i> Active Tenant
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-500">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            @if (tenant.IsActiveTenant)
                            {
                                @if (Model.IsAdminImpersonating)
                                {
                                    <div class="inline-flex items-center gap-2">
                                        <span class="inline-flex items-center px-3 py-1.5 bg-amber-100 text-amber-800 border border-amber-300 text-xs font-bold rounded-lg shadow-sm">
                                            <i class="fa-solid fa-user-secret mr-1.5"></i> Impersonating Now
                                        </span>
                                        <form asp-action="ResetTenant" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center px-2.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors" title="Exit Impersonation">
                                                <i class="fa-solid fa-arrow-rotate-left mr-1"></i> Exit
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold rounded-lg shadow-sm">
                                        <i class="fa-solid fa-circle-check mr-1.5 text-emerald-500"></i> Active Workspace
                                    </span>
                                }
                            }
                            else
                            {
                                <form asp-action="SwitchTenant" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="targetTenantId" value="@tenant.TenantId" />
                                    <button type="submit" @(Model.IsMultiTenancyEnabled ? "" : "disabled") class="inline-flex items-center px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow transition-colors" title="Impersonate @tenant.FullName">
                                        <i class="fa-solid fa-user-secret mr-1.5"></i> Impersonate
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
            <div class="text-sm text-slate-500">
                Showing <span class="font-medium">@((Model.PageNumber - 1) * Model.PageSize + 1)</span> to <span class="font-medium">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span> of <span class="font-medium">@Model.TotalCount</span> tenants
            </div>
            <div class="flex items-center space-x-2">
                @if (Model.HasPreviousPage)
                {
                    <a href="@GetPageUrl(Model.PageNumber - 1)" class="px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                        <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                    </a>
                }
                else
                {
                    <span class="px-3 py-1.5 bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-slate-400 cursor-not-allowed">
                        <i class="fa-solid fa-chevron-left mr-1"></i> Prev
                    </span>
                }

                <span class="text-sm text-slate-600 px-2 font-medium">Page @Model.PageNumber of @Model.TotalPages</span>

                @if (Model.HasNextPage)
                {
                    <a href="@GetPageUrl(Model.PageNumber + 1)" class="px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                        Next <i class="fa-solid fa-chevron-right ml-1"></i>
                    </a>
                }
                else
                {
                    <span class="px-3 py-1.5 bg-slate-100 border border-slate-200 rounded-lg text-sm font-medium text-slate-400 cursor-not-allowed">
                        Next <i class="fa-solid fa-chevron-right ml-1"></i>
                    </span>
                }
            </div>
        </div>
    }
</div>
