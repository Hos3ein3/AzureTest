@using AzureTest.Contracts.DTOs.IdeaTracker
@using AzureTest.Domain.Documents
@using AzureTest.Domain.Enums
@model UpdateIdeaDto
@{
    ViewData["Title"] = "Edit Idea";
}

<div class="max-w-5xl mx-auto py-10 px-6">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">Edit Idea</h1>
            <p class="text-slate-500 mt-1">Update properties for "@Model.Title".</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="text-brand-600 font-medium hover:underline"><i class="fa-solid fa-arrow-left mr-1"></i> Back to Page</a>
