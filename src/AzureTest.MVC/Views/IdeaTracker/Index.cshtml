@using AzureTest.Contracts.DTOs.IdeaTracker
@using AzureTest.Domain.Documents
@model List<IdeaDto>
@{
    ViewData["Title"] = "Idea Tracker";
}

<div class="px-6 py-8 mx-auto max-w-7xl">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-3">
                <i class="fa-solid fa-brain text-brand-600"></i> Idea Workspace
            </h1>
            <p class="text-slate-500 mt-1">Capture, organize, and track your brilliant ideas.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white transition-colors border border-transparent rounded-lg shadow-sm bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500">
            <i class="mr-2 fa-solid fa-plus"></i> New Idea
        </a>
    </div>

    <!-- Search/Filter Bar -->
    <div class="mb-6 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <form method="get" class="flex flex-wrap gap-4">
            <div class="flex-1 min-w-[250px] relative">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <i class="fa-solid fa-search text-slate-400"></i>
                </div>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search ideas..." class="w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500 text-sm">
            </div>
            <div class="w-48">
                <select name="status" onchange="this.form.submit()" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-brand-500 focus:border-brand-500 text-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<IdeaStatus>())
                    {
                        var selected = ViewBag.Status != null && (int)ViewBag.Status == (int)s ? "selected" : "";
                        <option value="@((int)s)" selected="@selected">@s</option>
                    }
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200 rounded-lg text-sm font-medium transition">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.Status != null)
            {
                <a asp-action="Index" class="px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg text-sm font-medium transition">Clear</a>
            }
        </form>
    </div>

    <!-- Notion-Style Grid -->
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 text-center bg-white border border-dashed rounded-xl border-slate-300">
            <div class="w-16 h-16 mb-4 text-brand-100 bg-brand-50 rounded-full flex items-center justify-center text-3xl">
                <i class="fa-regular fa-lightbulb text-brand-500"></i>
            </div>
            <h3 class="mb-1 text-lg font-medium text-slate-900">No Ideas Found</h3>
            <p class="text-sm text-slate-500 mb-4">You haven't captured any ideas matching this filter.</p>
            <a asp-action="Create" class="text-brand-600 font-medium hover:underline">Capture your first idea &rarr;</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var idea in Model)
            {
                <a asp-action="Details" asp-route-id="@idea.Id" class="group flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                    <!-- Cover Image -->
                    <div class="h-32 w-full bg-slate-100 relative @(string.IsNullOrEmpty(idea.CoverImage) ? $"bg-gradient-to-r from-{idea.ThemeColor}-400 to-{idea.ThemeColor}-600" : "")">
                        @if (!string.IsNullOrEmpty(idea.CoverImage))
                        {
                            <img src="@idea.CoverImage" alt="Cover" class="w-full h-full object-cover" />
                        }
                        
                        <!-- Floating Icon -->
                        <div class="absolute -bottom-6 left-4 w-12 h-12 bg-white rounded-lg shadow border border-slate-100 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                            <i class="@idea.Icon text-slate-700"></i>
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="p-5 pt-8 flex-1 flex flex-col">
                        <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors">@idea.Title</h3>
                        
                        <div class="mt-3 flex gap-2 flex-wrap mb-4">
                            @{
                                var statusColor = ((IdeaStatus)idea.Status) switch {
                                    IdeaStatus.Inbox => "slate",
                                    IdeaStatus.Refinement => "amber",
                                    IdeaStatus.InProgress => "blue",
                                    IdeaStatus.Completed => "emerald",
                                    IdeaStatus.Archived => "rose",
                                    _ => "slate"
                                };
                            }
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-@statusColor-100 text-@statusColor-800">
                                @(((IdeaStatus)idea.Status).ToString())
                            </span>
                            @foreach(var tag in idea.Tags.Take(3))
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600">@tag</span>
                            }
                        </div>
                        
                        <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                            <span>@idea.CreatedAt.ToString("MMM dd, yyyy")</span>
                            <span class="font-medium text-slate-400 group-hover:text-brand-500 transition-colors">Open <i class="fa-solid fa-arrow-right ml-1"></i></span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
