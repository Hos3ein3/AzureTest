@using AzureTest.Contracts.DTOs.IdeaTracker
@using AzureTest.Domain.Documents
@using AzureTest.Domain.Enums
@using AzureTest.MVC.Models
@model List<IdeaDto>
@{
    ViewData["Title"] = "Idea Tracker";
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Idea Tracker", null, "fa-solid fa-brain", true)
    };

    var headerModel = new PageHeaderModel(
        "Idea Workspace",
        "Capture, organize, brainstorm, and track your brilliant concepts.",
        "fa-solid fa-brain",
        new HeaderAction("New Idea", Url.Action("Create"), "fa-solid fa-plus", "primary")
    );
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-7xl space-y-6">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <!-- Filter Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
        <form method="get" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-5">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Search Ideas</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input name="search" type="text" value="@ViewBag.Search"
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400"
                           placeholder="Search by title, tags or content..." />
                </div>
            </div>

            <div class="md:col-span-4">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Status</label>
                <select name="status" onchange="this.form.submit()"
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<IdeaStatus>())
                    {
                        var selected = ViewBag.Status != null && (int)ViewBag.Status == (int)s ? "selected" : null;
                        <option value="@((int)s)" selected="@selected">@s</option>
                    }
                </select>
            </div>

            <div class="md:col-span-3 flex items-center gap-2">
                <button type="submit"
                        class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-200">
                    <i class="fa-solid fa-filter"></i>
                    <span>Apply Filter</span>
                </button>
                <a asp-action="Index"
                   class="inline-flex items-center justify-center p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-800 rounded-xl transition-all"
                   title="Reset filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Ideas Grid -->
    @if (!Model.Any())
    {
        var emptyModel = new EmptyStateModel(
            "No Ideas Found",
            "You haven't captured any ideas matching this filter yet.",
            "fa-regular fa-lightbulb",
            new HeaderAction("Capture First Idea", Url.Action("Create"), "fa-solid fa-plus", "primary")
        );
        <partial name="UiComponents/_EmptyState" model="emptyModel" />
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var idea in Model)
            {
                var statusColor = ((IdeaStatus)idea.Status) switch
                {
                    IdeaStatus.Inbox => "bg-slate-100 text-slate-700 border-slate-200",
                    IdeaStatus.Refinement => "bg-amber-50 text-amber-700 border-amber-200",
                    IdeaStatus.InProgress => "bg-blue-50 text-blue-700 border-blue-200",
                    IdeaStatus.Completed => "bg-emerald-50 text-emerald-700 border-emerald-200",
                    IdeaStatus.Archived => "bg-rose-50 text-rose-700 border-rose-200",
                    _ => "bg-slate-100 text-slate-700 border-slate-200"
                };

                <a asp-action="Details" asp-route-id="@idea.Id"
                   class="group flex flex-col bg-white border border-slate-200/80 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                    <!-- Cover Image / Gradient Header -->
                    <div class="h-36 w-full bg-slate-100 relative @(string.IsNullOrEmpty(idea.CoverImage) ? "bg-gradient-to-r from-brand-600 to-indigo-700" : "")">
                        @if (!string.IsNullOrEmpty(idea.CoverImage))
                        {
                            <img src="@idea.CoverImage" alt="Cover" class="w-full h-full object-cover" />
                        }

                        <!-- Floating Icon -->
                        <div class="absolute -bottom-5 left-5 w-12 h-12 bg-white rounded-xl shadow-md border border-slate-200/80 flex items-center justify-center text-xl group-hover:scale-110 transition-transform text-brand-600">
                            <i class="@(string.IsNullOrEmpty(idea.Icon) ? "fa-solid fa-lightbulb" : idea.Icon)"></i>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="p-5 pt-8 flex-1 flex flex-col">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-1">
                                @idea.Title
                            </h3>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold border @statusColor shrink-0">
                                @(((IdeaStatus)idea.Status).ToString())
                            </span>
                        </div>

                        @if (idea.Tags != null && idea.Tags.Any())
                        {
                            <div class="mt-3 flex gap-1.5 flex-wrap">
                                @foreach (var tag in idea.Tags.Take(3))
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-600">
                                        #@tag
                                    </span>
                                }
                            </div>
                        }

                        <div class="mt-auto pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                            <span class="inline-flex items-center gap-1.5">
                                <i class="fa-regular fa-calendar text-slate-400"></i>
                                @idea.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                            <span class="font-semibold text-brand-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                                Open <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
