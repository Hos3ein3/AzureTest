@model AzureTest.Application.FootballFantasy.Commands.JoinPredictClubCommand
@{
    ViewData["Title"] = "Join Predict Club";
    var club = ViewBag.Club as AzureTest.Contracts.DTOs.FootballFantasy.PredictClubDto;
}

<div class="max-w-md mx-auto my-8">
    <div class="bg-white dark:bg-slate-800 rounded-3xl border border-slate-200/80 dark:border-slate-700/80 shadow-lg p-6 sm:p-8 text-center">
        @if (!string.IsNullOrWhiteSpace(club?.LogoUrl))
        {
            <img src="@club.LogoUrl" alt="Logo" class="w-20 h-20 mx-auto mb-4 rounded-2xl object-contain bg-slate-50 border p-1" />
        }
        else
        {
            <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center font-black text-2xl">
                @(club?.Name != null ? club.Name.Substring(0, Math.Min(2, club.Name.Length)).ToUpper() : "PC")
            </div>
        }

        <h2 class="text-xl font-black text-slate-900 dark:text-slate-100">Join @(club?.Name ?? "Predict Club")</h2>
        <p class="text-xs text-slate-500 mt-1 mb-6">#@(club?.ClubTag ?? "") · @(club?.Visibility.ToString() ?? "") Club</p>

        <form asp-action="Join" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PredictClubId" />

            @if (club?.Visibility == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Private)
            {
                <div class="text-left">
                    <label asp-for="JoinCode" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase mb-1">Private Join Code</label>
                    <input asp-for="JoinCode" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono text-center tracking-widest font-bold" placeholder="ENTER CODE" required />
                    <span asp-validation-for="JoinCode" class="text-xs text-red-500"></span>
                </div>
            }

            <div class="pt-2">
                <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-md shadow-indigo-500/20 transition-all">
                    Confirm & Enter Club
                </button>
            </div>
        </form>
    </div>
</div>
