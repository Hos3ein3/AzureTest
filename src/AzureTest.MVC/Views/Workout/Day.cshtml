@model AzureTest.Domain.Documents.Gym.CourseDay
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    var userGymCourseId = ViewBag.UserGymCourseId;
    var weekNumber = ViewBag.WeekNumber;
    var allTrainingsList = ViewBag.Trainings as List<AzureTest.Domain.Documents.Gym.Training> ?? new();
    var allTrainingsMap = allTrainingsList.ToDictionary(x => x.Id, x => x);

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Workout", Url.Action("Index")),
        new("Course", Url.Action("MyCourse", new { id = userGymCourseId })),
        new($"{Model.Name} (Week {weekNumber})", IsActive: true)
    };
}

<div class="max-w-6xl mx-auto">
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
            <div class="flex items-center gap-3 mt-2">
                <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                        @Model.Name
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-200">Week @weekNumber</span>
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a href="@Url.Action("Session", new { userGymCourseId = userGymCourseId, dayId = Model.Id })" class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl shadow-2xs text-xs font-semibold transition-colors">
                <i class="fa-solid fa-play text-2xs"></i> Start Session
            </a>
            <a href="@Url.Action("MyCourse", new { id = userGymCourseId })" class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 rounded-xl text-xs font-semibold shadow-2xs transition-colors">
                <i class="fa-solid fa-arrow-left text-2xs"></i> Back
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/75 flex justify-between items-center">
            <div>
                <h3 class="text-sm font-bold text-slate-900 m-0 flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-brand-600"></i> Customize Workout Routine
                </h3>
                <p class="text-2xs text-slate-400 mt-0.5">Customize workout sections, adjust repetitions, weights, or exercise orders.</p>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="addSection()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-plus text-3xs"></i> Add Section
                </button>
                <button onclick="saveDay()" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-floppy-disk text-3xs"></i> Save Changes
                </button>
            </div>
        </div>
        <div class="p-6 md:p-8">
            <div id="dayEditor" class="space-y-8"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

    <script>
        let dayData = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
        const availableTrainings = @Html.Raw(JsonSerializer.Serialize(allTrainingsList, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
        const trainingsMap = @Html.Raw(JsonSerializer.Serialize(allTrainingsMap, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));

        function updateField(path, field, value) {
            let obj = dayData;
            let parts = path.split('.');
            for (let i = 0; i < parts.length; i++) {
                let match = parts[i].match(/(.+)\[(\d+)\]/);
                if (match) obj = obj[match[1]][match[2]];
                else obj = obj[parts[i]];
            }
            obj[field] = value;
            if(field === 'trainingId') renderDay(); // Re-render to update Sets vs Durations display based on Type
        }

        function addSection() { dayData.sections.push({ name: 'New Section', trainings: [] }); renderDay(); }
        
        function removeSection(s) {
            Swal.fire({
                title: 'Remove Section?',
                text: "Are you sure you want to delete this entire section?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    dayData.sections.splice(s, 1);
                    renderDay();
                }
            });
        }
        
        function moveSection(s, dir) {
            if (s+dir >= 0 && s+dir < dayData.sections.length) {
                let temp = dayData.sections[s]; dayData.sections[s] = dayData.sections[s+dir]; dayData.sections[s+dir] = temp;
                renderDay();
            }
        }
        
        function addTraining(s) { 
            dayData.sections[s].trainings.push({ trainingId: '', sets: 3, reps: 10, weight: 0, durationSeconds: 0, restSeconds: 60 }); 
            renderDay(); 
        }
        
        function duplicateSection(s) {
            let copy = JSON.parse(JSON.stringify(dayData.sections[s]));
            copy.name += " (Copy)";
            dayData.sections.splice(s + 1, 0, copy);
            renderDay();
        }

        function duplicateTraining(s, t) {
            let copy = JSON.parse(JSON.stringify(dayData.sections[s].trainings[t]));
            dayData.sections[s].trainings.splice(t + 1, 0, copy);
            renderDay();
        }

        function removeTraining(s, t) { 
            Swal.fire({
                title: 'Remove Exercise?',
                text: "Are you sure you want to remove this exercise?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, remove it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    dayData.sections[s].trainings.splice(t, 1); 
                    renderDay();
                }
            });
        }
        
        function moveTraining(s, t, dir) {
            if (t+dir >= 0 && t+dir < dayData.sections[s].trainings.length) {
                let temp = dayData.sections[s].trainings[t]; dayData.sections[s].trainings[t] = dayData.sections[s].trainings[t+dir]; dayData.sections[s].trainings[t+dir] = temp;
                renderDay();
            }
        }

        function renderDay() {
            const container = document.getElementById('dayEditor');
            let html = '';
            dayData.sections.forEach((section, sIdx) => {
                let secPath = `sections[${sIdx}]`;
                html += `
                    <div class="bg-slate-50/50 p-5 rounded-xl border border-slate-200 mb-6 shadow-sm">
                        <div class="flex justify-between items-center mb-5 pb-3 border-b border-slate-200">
                            <div class="flex items-center space-x-3 w-1/2">
                                <div class="flex flex-col">
                                    <button type="button" onclick="moveSection(${sIdx}, -1)" class="text-slate-400 hover:text-brand-600"><i class="fa-solid fa-chevron-up"></i></button>
                                    <button type="button" onclick="moveSection(${sIdx}, 1)" class="text-slate-400 hover:text-brand-600"><i class="fa-solid fa-chevron-down"></i></button>
                                </div>
                                <input type="text" value="${section.name}" oninput="updateField('${secPath}', 'name', this.value)" class="flex-1 border-none bg-transparent font-bold text-lg text-slate-800 focus:ring-0 px-0" placeholder="Section Name" />
                            </div>
                            <div class="flex gap-2">
                                <button type="button" onclick="addTraining(${sIdx})" class="px-3 py-1.5 bg-blue-50 text-blue-600 border border-blue-200 hover:bg-blue-100 transition-colors rounded-lg text-sm font-medium shadow-sm"><i class="fa-solid fa-plus mr-1"></i> Add Exercise</button>
                                <button type="button" onclick="duplicateSection(${sIdx})" class="px-3 py-1.5 bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition-colors rounded-lg text-sm font-medium shadow-sm" title="Duplicate"><i class="fa-solid fa-copy"></i></button>
                                <button type="button" onclick="removeSection(${sIdx})" class="px-3 py-1.5 bg-red-50 text-red-600 border border-red-200 hover:bg-red-100 transition-colors rounded-lg text-sm font-medium shadow-sm" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>
                `;

                if (section.trainings.length > 0) {
                    html += `
                        <div class="overflow-x-auto bg-white rounded-lg border border-slate-200 shadow-sm">
                            <table class="w-full text-left text-sm text-slate-700">
                                <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
                                    <tr>
                                        <th class="px-3 py-3 w-12 text-center">Ord</th>
                                        <th class="px-3 py-3 w-64">Exercise</th>
                                        <th class="px-3 py-3 w-20 text-center">Sets</th>
                                        <th class="px-3 py-3 w-20 text-center">Reps</th>
                                        <th class="px-3 py-3 w-24 text-center">Dur(s)</th>
                                        <th class="px-3 py-3 w-24 text-center">Wt(kg)</th>
                                        <th class="px-3 py-3 w-24 text-center">Rest(s)</th>
                                        <th class="px-3 py-3 w-24 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                    `;
                    section.trainings.forEach((tr, tIdx) => {
                        let trPath = `${secPath}.trainings[${tIdx}]`;
                        let options = availableTrainings.map(t => {
                            let eq = (t.equipments && t.equipments.length > 0) ? ` (${t.equipments.join(', ')})` : '';
                            return `<option value="${t.id}" ${t.id === tr.trainingId ? 'selected' : ''}>${t.name}${eq}</option>`;
                        }).join('');

                        let tObj = trainingsMap[tr.trainingId];
                        let isDuration = tObj && tObj.type === 1; // 1 = DurationAndRest

                        let detailsHtml = '';
                        if (tObj && tObj.id) {
                            let desc = tObj.description ? `<p class="text-xs text-slate-500 mt-2 italic">${tObj.description}</p>` : '';
                            let eq = (tObj.equipments && tObj.equipments.length > 0) ? `<div class="mt-2 flex flex-wrap gap-1">${tObj.equipments.map(e => `<span class="bg-slate-100 text-slate-600 text-[10px] uppercase font-bold px-1.5 py-0.5 rounded border border-slate-200">${e}</span>`).join('')}</div>` : '';
                            let mediaHtml = '';
                            if (tObj.mediaUrl) {
                                if (tObj.mediaUrl.includes('youtube.com') || tObj.mediaUrl.includes('youtu.be')) {
                                    let videoId = tObj.mediaUrl.split('v=')[1] || tObj.mediaUrl.split('youtu.be/')[1];
                                    if(videoId) videoId = videoId.split('&')[0];
                                    mediaHtml = `<div class="mt-2 aspect-video rounded overflow-hidden border border-slate-200"><iframe class="w-full h-full" src="https://www.youtube.com/embed/${videoId}" frameborder="0" allowfullscreen></iframe></div>`;
                                } else if (tObj.mediaUrl.match(/\.(jpeg|jpg|gif|png)$/i)) {
                                    mediaHtml = `<div class="mt-2"><img src="${tObj.mediaUrl}" class="rounded max-h-32 object-cover border border-slate-200" /></div>`;
                                } else {
                                    mediaHtml = `<div class="mt-2"><a href="${tObj.mediaUrl}" target="_blank" class="text-[10px] text-brand-600 font-bold uppercase"><i class="fa-solid fa-link"></i> View Media</a></div>`;
                                }
                            }
                            detailsHtml = `<div class="mt-2 bg-slate-50 p-2 rounded-lg border border-slate-100">` + desc + eq + mediaHtml + `</div>`;
                        }

                        
                        let setsHtml = isDuration ? `<span class="text-slate-300">-</span>` : `<input type="number" value="${tr.sets}" oninput="updateField('${trPath}', 'sets', parseInt(this.value)||0)" class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-slate-700 text-center focus:ring-brand-500 focus:border-brand-500" />`;
                        let repsHtml = isDuration ? `<span class="text-slate-300">-</span>` : `<input type="number" value="${tr.reps}" oninput="updateField('${trPath}', 'reps', parseInt(this.value)||0)" class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-slate-700 text-center focus:ring-brand-500 focus:border-brand-500" />`;
                        let durHtml = !isDuration ? `<span class="text-slate-300">-</span>` : `<input type="number" value="${tr.durationSeconds}" oninput="updateField('${trPath}', 'durationSeconds', parseInt(this.value)||0)" class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-slate-700 text-center focus:ring-brand-500 focus:border-brand-500" />`;

                        html += `
                            <tr class="hover:bg-slate-50 transition-colors group">
                                <td class="px-3 py-2 text-center whitespace-nowrap">
                                    <button type="button" onclick="moveTraining(${sIdx}, ${tIdx}, -1)" class="text-slate-400 hover:text-brand-600 p-0.5"><i class="fa-solid fa-chevron-up text-xs"></i></button>
                                    <button type="button" onclick="moveTraining(${sIdx}, ${tIdx}, 1)" class="text-slate-400 hover:text-brand-600 p-0.5"><i class="fa-solid fa-chevron-down text-xs"></i></button>
                                </td>
                                <td class="px-3 py-2">
                                    <select onchange="updateField('${trPath}', 'trainingId', this.value)" class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-slate-700 focus:outline-none focus:border-brand-500 searchable-select text-sm shadow-sm">
                                        <option value="">--Select Exercise--</option>
                                        ${options}
                                    </select>
                                    ${detailsHtml}
                                </td>
                                <td class="px-3 py-2 text-center align-middle">${setsHtml}</td>
                                <td class="px-3 py-2 text-center align-middle">${repsHtml}</td>
                                <td class="px-3 py-2 text-center align-middle">${durHtml}</td>
                                <td class="px-3 py-2 text-center align-middle"><input type="number" step="0.5" value="${tr.weight}" oninput="updateField('${trPath}', 'weight', parseFloat(this.value)||0)" class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-slate-700 text-center focus:ring-brand-500 focus:border-brand-500" /></td>
                                <td class="px-3 py-2 text-center align-middle"><input type="number" value="${tr.restSeconds}" oninput="updateField('${trPath}', 'restSeconds', parseInt(this.value)||0)" class="w-full bg-white border border-slate-300 rounded px-2 py-1.5 text-slate-700 text-center focus:ring-brand-500 focus:border-brand-500" /></td>
                                <td class="px-3 py-2 text-right whitespace-nowrap align-middle">
                                    <button type="button" onclick="duplicateTraining(${sIdx}, ${tIdx})" class="text-slate-400 hover:text-brand-500 mx-1 transition-colors" title="Duplicate"><i class="fa-solid fa-copy"></i></button>
                                    <button type="button" onclick="removeTraining(${sIdx}, ${tIdx})" class="text-slate-400 hover:text-red-500 mx-1 transition-colors" title="Remove"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        `;
                    });
                    html += `</tbody></table></div>`;
                } else {
                    html += `<div class="text-center py-6 bg-white rounded-lg border border-slate-200 border-dashed"><p class="text-slate-500 text-sm">No exercises in this section. Add one!</p></div>`;
                }
                html += `</div>`;
            });
            container.innerHTML = html;
        }

        function initSelects() {
            document.querySelectorAll('.searchable-select').forEach(el => {
                if(!el.tomselect) {
                    new TomSelect(el, { create: false, sortField: {field: "text", direction: "asc"} });
                }
            });
        }
        const originalRenderDay = renderDay;
        renderDay = function() {
            originalRenderDay();
            initSelects();
        };

        async function saveDay() {
            const payload = {
                userGymCourseId: '@userGymCourseId',
                weekNumber: parseInt('@weekNumber'),
                day: dayData
            };
            try {
                const response = await fetch('@Url.Action("UpdateDay")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if(result.success) {
                    Swal.fire({
                        title: 'Saved!',
                        text: 'Workout customized and saved successfully.',
                        icon: 'success',
                        confirmButtonColor: '#0ea5e9'
                    });
                } else {
                    Swal.fire('Error', result.message, 'error');
                }
            } catch(e) {
                Swal.fire('Error', 'Request failed', 'error');
            }
        }

        document.addEventListener('DOMContentLoaded', renderDay);
    </script>
}
