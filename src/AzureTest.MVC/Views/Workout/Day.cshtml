@model AzureTest.Domain.Documents.Gym.CourseDay
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    var userGymCourseId = ViewBag.UserGymCourseId;
    var weekNumber = ViewBag.WeekNumber;
    // We need all trainings to be able to add new ones.
    var allTrainings = ViewBag.Trainings as List<AzureTest.Domain.Documents.Gym.Training> ?? new List<AzureTest.Domain.Documents.Gym.Training>();
}

<div class="max-w-6xl mx-auto p-6">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-3xl font-bold text-white mb-2">@Model.Name <span class="text-lg text-slate-400 font-normal ml-2">Week @weekNumber</span></h2>
            <p class="text-slate-400">@Model.Description</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Session", new { userGymCourseId = userGymCourseId, dayId = Model.Id })" class="bg-brand-500 hover:bg-brand-600 text-white px-6 py-2 rounded-lg font-bold transition-colors">
                <i class="fa-solid fa-play mr-2"></i> Start Session
            </a>
            <a href="@Url.Action("MyCourse", new { id = userGymCourseId })" class="bg-slate-700 hover:bg-slate-600 text-white px-4 py-2 rounded-lg transition-colors">
                Back to Course
            </a>
        </div>
    </div>

    <div class="bg-slate-800 rounded-xl border border-slate-700 p-6 shadow-xl mb-6">
        <div class="flex justify-between items-center mb-6 border-b border-slate-700 pb-4">
            <h3 class="text-xl font-bold text-white">Customize Day Workout</h3>
            <div>
                <button onclick="addSection()" class="bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                    <i class="fa-solid fa-plus mr-1"></i> Add Section
                </button>
                <button onclick="saveDay()" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors ml-2">
                    <i class="fa-solid fa-save mr-1"></i> Save Changes
                </button>
            </div>
        </div>

        <div id="dayEditor" class="space-y-6"></div>
    </div>
</div>

@section Scripts {
    <script>
        let dayData = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
        const availableTrainings = @Html.Raw(JsonSerializer.Serialize(allTrainings, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));

        function updateField(path, field, value) {
            let obj = dayData;
            let parts = path.split('.');
            for (let i = 0; i < parts.length; i++) {
                let part = parts[i];
                let match = part.match(/(.+)\[(\d+)\]/);
                if (match) {
                    obj = obj[match[1]][match[2]];
                } else {
                    obj = obj[part];
                }
            }
            obj[field] = value;
        }

        // Section functions
        function addSection() {
            dayData.sections.push({ name: 'New Section', trainings: [] });
            renderDay();
        }
        function removeSection(sIdx) {
            if(confirm('Remove this section?')) {
                dayData.sections.splice(sIdx, 1);
                renderDay();
            }
        }
        function duplicateSection(sIdx) {
            dayData.sections.push(JSON.parse(JSON.stringify(dayData.sections[sIdx])));
            renderDay();
        }
        function moveSection(sIdx, dir) {
            if (sIdx + dir >= 0 && sIdx + dir < dayData.sections.length) {
                let temp = dayData.sections[sIdx];
                dayData.sections[sIdx] = dayData.sections[sIdx + dir];
                dayData.sections[sIdx + dir] = temp;
                renderDay();
            }
        }

        // Training functions
        function addTraining(sIdx) {
            dayData.sections[sIdx].trainings.push({ trainingId: '', sets: 3, reps: 10, weight: 0, durationSeconds: 0, restSeconds: 60 });
            renderDay();
        }
        function removeTraining(sIdx, tIdx) {
            dayData.sections[sIdx].trainings.splice(tIdx, 1);
            renderDay();
        }
        function duplicateTraining(sIdx, tIdx) {
            dayData.sections[sIdx].trainings.splice(tIdx+1, 0, JSON.parse(JSON.stringify(dayData.sections[sIdx].trainings[tIdx])));
            renderDay();
        }
        function moveTraining(sIdx, tIdx, dir) {
            if (tIdx + dir >= 0 && tIdx + dir < dayData.sections[sIdx].trainings.length) {
                let temp = dayData.sections[sIdx].trainings[tIdx];
                dayData.sections[sIdx].trainings[tIdx] = dayData.sections[sIdx].trainings[tIdx + dir];
                dayData.sections[sIdx].trainings[tIdx + dir] = temp;
                renderDay();
            }
        }

        function renderDay() {
            const container = document.getElementById('dayEditor');
            let html = '';
            dayData.sections.forEach((section, sIdx) => {
                let secPath = `sections[${sIdx}]`;
                html += `
                    <div class="bg-slate-900/50 p-4 rounded-lg border border-slate-700">
                        <div class="flex justify-between items-center mb-4">
                            <div class="flex items-center space-x-2">
                                <button type="button" onclick="moveSection(${sIdx}, -1)" class="text-slate-500 hover:text-white"><i class="fa-solid fa-arrow-up"></i></button>
                                <button type="button" onclick="moveSection(${sIdx}, 1)" class="text-slate-500 hover:text-white"><i class="fa-solid fa-arrow-down"></i></button>
                                <input type="text" value="${section.name}" oninput="updateField('${secPath}', 'name', this.value)" class="bg-slate-800 border border-slate-600 rounded px-3 py-1.5 text-white font-bold" placeholder="Section Name" />
                            </div>
                            <div class="flex gap-2">
                                <button type="button" onclick="addTraining(${sIdx})" class="px-3 py-1.5 bg-indigo-500/20 text-indigo-400 hover:bg-indigo-500 hover:text-white transition-colors rounded text-sm font-medium">Add Exercise</button>
                                <button type="button" onclick="duplicateSection(${sIdx})" class="px-3 py-1.5 bg-yellow-500/20 text-yellow-400 hover:bg-yellow-500 hover:text-white transition-colors rounded text-sm font-medium"><i class="fa-solid fa-copy"></i></button>
                                <button type="button" onclick="removeSection(${sIdx})" class="px-3 py-1.5 bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white transition-colors rounded text-sm font-medium"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </div>
                `;

                if (section.trainings.length > 0) {
                    html += `
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm text-slate-300">
                                <thead class="bg-slate-800 text-slate-400 text-xs uppercase font-semibold">
                                    <tr>
                                        <th class="px-3 py-2 w-12">Ord</th>
                                        <th class="px-3 py-2">Exercise</th>
                                        <th class="px-3 py-2 w-20 text-center">Sets</th>
                                        <th class="px-3 py-2 w-20 text-center">Reps</th>
                                        <th class="px-3 py-2 w-20 text-center">Wt(kg)</th>
                                        <th class="px-3 py-2 w-20 text-center">Dur(s)</th>
                                        <th class="px-3 py-2 w-20 text-center">Rest(s)</th>
                                        <th class="px-3 py-2 w-24 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-700/50">
                    `;
                    section.trainings.forEach((tr, tIdx) => {
                        let trPath = `${secPath}.trainings[${tIdx}]`;
                        let options = availableTrainings.map(t => {
                            let eq = (t.equipments && t.equipments.length > 0) ? ` (${t.equipments.join(', ')})` : '';
                            return `<option value="${t.id}" ${t.id === tr.trainingId ? 'selected' : ''}>${t.name}${eq}</option>`;
                        }).join('');

                        html += `
                            <tr class="hover:bg-slate-800/50 transition-colors">
                                <td class="px-3 py-2 text-center whitespace-nowrap">
                                    <button type="button" onclick="moveTraining(${sIdx}, ${tIdx}, -1)" class="text-slate-500 hover:text-white p-0.5"><i class="fa-solid fa-chevron-up text-xs"></i></button>
                                    <button type="button" onclick="moveTraining(${sIdx}, ${tIdx}, 1)" class="text-slate-500 hover:text-white p-0.5"><i class="fa-solid fa-chevron-down text-xs"></i></button>
                                </td>
                                <td class="px-3 py-2"><select onchange="updateField('${trPath}', 'trainingId', this.value)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1.5 text-slate-300 focus:outline-none focus:border-brand-500 searchable-select"><option value="">--Select--</option>${options}</select></td>
                                <td class="px-3 py-2"><input type="number" value="${tr.sets}" oninput="updateField('${trPath}', 'sets', parseInt(this.value)||0)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1.5 text-slate-300 text-center" /></td>
                                <td class="px-3 py-2"><input type="number" value="${tr.reps}" oninput="updateField('${trPath}', 'reps', parseInt(this.value)||0)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1.5 text-slate-300 text-center" /></td>
                                <td class="px-3 py-2"><input type="number" step="0.5" value="${tr.weight}" oninput="updateField('${trPath}', 'weight', parseFloat(this.value)||0)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1.5 text-slate-300 text-center" /></td>
                                <td class="px-3 py-2"><input type="number" value="${tr.durationSeconds}" oninput="updateField('${trPath}', 'durationSeconds', parseInt(this.value)||0)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1.5 text-slate-300 text-center" /></td>
                                <td class="px-3 py-2"><input type="number" value="${tr.restSeconds}" oninput="updateField('${trPath}', 'restSeconds', parseInt(this.value)||0)" class="w-full bg-slate-900 border border-slate-700 rounded px-2 py-1.5 text-slate-300 text-center" /></td>
                                <td class="px-3 py-2 text-right whitespace-nowrap">
                                    <button type="button" onclick="duplicateTraining(${sIdx}, ${tIdx})" class="text-yellow-500 hover:text-yellow-400 mx-1"><i class="fa-solid fa-copy"></i></button>
                                    <button type="button" onclick="removeTraining(${sIdx}, ${tIdx})" class="text-red-500 hover:text-red-400 mx-1"><i class="fa-solid fa-trash"></i></button>
                                </td>
                            </tr>
                        `;
                    });
                    html += `</tbody></table></div>`;
                }
                html += `</div>`;
            });
            container.innerHTML = html;
        }

        function initSelects() {
            document.querySelectorAll('.searchable-select').forEach(el => {
                if(!el.tomselect) {
                    new TomSelect(el, { create: false, sortField: {field: "text", direction: "asc"} });
                }
            });
        }
        const originalRenderDay = renderDay;
        renderDay = function() {
            originalRenderDay();
            initSelects();
        };

        async function saveDay() {
            const payload = {
                userGymCourseId: '@userGymCourseId',
                weekNumber: parseInt('@weekNumber'),
                day: dayData
            };
            try {
                const response = await fetch('@Url.Action("UpdateDay")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if(result.success) {
                    alert('Workout customized and saved successfully!');
                } else {
                    alert('Error: ' + result.message);
                }
            } catch(e) {
                alert('Request failed');
            }
        }

        document.addEventListener('DOMContentLoaded', renderDay);
    </script>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
}
