@{
    ViewData["Title"] = "Workout Dashboard";
    var availableCourses = ViewBag.AvailableCourses as List<AzureTest.Domain.Documents.Gym.TrainingCourse> ?? new();
    var userGymCourses = ViewBag.UserGymCourses as List<AzureTest.Domain.Documents.Gym.UserGymCourse> ?? new();

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Workout", Url.Action("Index"), IsActive: true)
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel(
        "Workout Dashboard",
        "Track your training progress, log sessions, view body metrics analytics, and discover new workout courses.",
        "fa-solid fa-dumbbell",
        breadcrumbs: breadcrumbs
    );

    var emptyCourses = new AzureTest.MVC.Models.EmptyStateModel(
        "No Active Courses",
        "You haven't registered for any training courses yet. Browse the available catalog below to enroll and begin your program!",
        "fa-solid fa-dumbbell"
    );
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<!-- Quick Action Shortcuts Bar -->
<div class="flex flex-wrap items-center justify-between gap-3 mb-8 p-4 bg-white rounded-2xl border border-slate-200/80 shadow-2xs">
    <div class="flex flex-wrap items-center gap-2">
        <a href="@Url.Action("Analytics")#weight-history-section" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-weight-scale text-sky-600"></i> Weight Log & BMI History
        </a>
        <a href="@Url.Action("Analytics")" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-brand-50 hover:bg-brand-100 text-brand-700 border border-brand-200 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-chart-line text-brand-600"></i> Analytics & Graphs
        </a>
        <a href="@Url.Action("History")" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-clock-rotate-left text-slate-500"></i> Exercise Logs
        </a>
    </div>

    <div class="text-2xs text-slate-400 font-mono">
        Active Enrollments: <strong class="text-slate-700">@userGymCourses.Count</strong>
    </div>
</div>

<!-- My Active Courses -->
<div class="mb-10">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-fire text-amber-500"></i> My Active Courses
        </h2>
        <span class="text-xs font-semibold text-slate-400">@userGymCourses.Count enrolled</span>
    </div>
    
    @if (userGymCourses.Any()) {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var uc in userGymCourses) {
                <div class="bg-white border border-slate-200/80 rounded-2xl shadow-2xs hover:shadow-md transition-shadow p-6 flex flex-col h-full">
                    <div class="flex-grow">
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <h3 class="text-base font-bold text-slate-900">@uc.Name</h3>
                            <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-3xs font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                                Active
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
                            <i class="fa-regular fa-calendar-check text-slate-400"></i> Started on @uc.RegisteredAt.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                    <div class="mt-4 pt-4 border-t border-slate-100">
                        <a href="@Url.Action("MyCourse", new { id = uc.Id })" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
                            <i class="fa-solid fa-play text-2xs"></i> Continue Training
                        </a>
                    </div>
                </div>
            }
        </div>
    } else {
        <partial name="UiComponents/_EmptyState" model="emptyCourses" />
    }
</div>

<!-- Discover Catalog -->
<div>
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-compass text-blue-500"></i> Discover Available Courses
        </h2>
        <span class="text-xs font-semibold text-slate-400">@availableCourses.Count programs</span>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var c in availableCourses) {
            bool isRegistered = userGymCourses.Any(uc => uc.OriginalCourseId == c.Id);
            <div class="bg-white border border-slate-200/80 rounded-2xl shadow-2xs hover:shadow-md transition-shadow p-6 flex flex-col h-full relative overflow-hidden">
                @if (isRegistered) {
                    <div class="absolute top-0 right-0 bg-emerald-600 text-white text-3xs font-bold px-3 py-1 rounded-bl-xl uppercase tracking-wider">
                        Enrolled
                    </div>
                }
                
                <div class="flex-grow">
                    @if (!string.IsNullOrEmpty(c.ImagePath) || !string.IsNullOrEmpty(c.VideoPath))
                    {
                        <div class="w-full h-44 mb-4 relative overflow-hidden rounded-xl bg-slate-100 group border border-slate-100">
                            @if (!string.IsNullOrEmpty(c.VideoPath))
                            {
                                <video src="@c.VideoPath" class="absolute inset-0 w-full h-full object-cover hidden group-hover:block" loop muted playsinline onmouseover="this.play()" onmouseout="this.pause(); this.currentTime = 0;"></video>
                            }
                            @if (!string.IsNullOrEmpty(c.ImagePath))
                            {
                                <img src="@c.ImagePath" class="absolute inset-0 w-full h-full object-cover group-hover:hidden" alt="@c.Name" />
                            }
                        </div>
                    }

                    <h3 class="text-base font-bold text-slate-900 mb-1.5 pr-8">@c.Name</h3>
                    <p class="text-xs text-slate-500 mb-4 line-clamp-3">@Html.Raw(c.Description)</p>
                    
                    <div class="flex flex-wrap gap-1.5 mb-4">
                        @foreach(var tag in c.Tags ?? new List<string>()) {
                            <span class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 text-2xs rounded-lg font-medium">#@tag</span>
                        }
                    </div>
                </div>
                
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
                    <div class="text-xs font-semibold text-slate-500 flex items-center gap-1.5">
                        <i class="fa-solid fa-layer-group text-slate-400"></i> @(c.Weeks?.Count ?? 0) Weeks
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <a href="@Url.Action("Details", new { id = c.Id })" class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 text-xs font-semibold transition-colors">
                            Details
                        </a>
                        @if (!isRegistered) {
                            <form method="post" action="@Url.Action("Register", new { courseId = c.Id })" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors flex items-center gap-1.5">
                                    <i class="fa-solid fa-bolt text-3xs"></i> Enroll
                                </button>
                            </form>
                        } else {
                            <span class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-400 text-xs font-semibold cursor-not-allowed">
                                Enrolled
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
