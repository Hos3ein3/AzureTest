@model AzureTest.Domain.Documents.Gym.TrainingCourse
@{
    ViewData["Title"] = "Course Details - " + Model.Name;
    var allTrainings = ViewBag.Trainings as Dictionary<Guid, AzureTest.Domain.Documents.Gym.Training> ?? new();
    
    // Calculate distinct equipments needed
    var allEquipments = new HashSet<string>();
    foreach(var week in Model.Weeks) {
        foreach(var day in week.Days) {
            foreach(var sec in day.Sections) {
                foreach(var tr in sec.Trainings) {
                    if (allTrainings.TryGetValue(tr.TrainingId, out var trainingDef) && trainingDef.Equipments != null) {
                        foreach(var eq in trainingDef.Equipments) {
                            allEquipments.Add(eq);
                        }
                    }
                }
            }
        }
    }
}

<div class="max-w-5xl mx-auto p-6">
    <div class="mb-6">
        <a href="@Url.Action("Index")" class="text-slate-400 hover:text-white transition-colors flex items-center gap-2 mb-4 inline-flex">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="bg-slate-800 rounded-xl border border-slate-700 p-8 shadow-xl mb-8">
        <div class="flex justify-between items-start mb-6 border-b border-slate-700 pb-6">
            <div>
                <h1 class="text-4xl font-bold text-white mb-3">@Model.Name</h1>
                <div class="prose prose-invert max-w-none text-slate-300">
                    @Html.Raw(Model.Description)
                </div>
                
                @if(Model.Tags != null && Model.Tags.Any()) {
                    <div class="mt-6 flex flex-wrap gap-2">
                        @foreach(var t in Model.Tags) {
                            <span class="bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-3 py-1 rounded-full text-xs font-bold uppercase">@t</span>
                        }
                    </div>
                }
            </div>
            <div class="ml-6 flex-shrink-0">
                <form method="post" action="@Url.Action("Enroll", new { id = Model.Id })">
                    <button type="submit" class="bg-brand-500 hover:bg-brand-600 text-white px-8 py-3 rounded-xl font-bold text-lg shadow-lg shadow-brand-500/20 transition-transform hover:scale-105">
                        Enroll Now
                    </button>
                </form>
            </div>
        </div>

        <div class="mb-8">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2"><i class="fa-solid fa-dumbbell text-slate-400"></i> Required Equipments</h3>
            @if(allEquipments.Any()) {
                <div class="flex flex-wrap gap-2">
                    @foreach(var eq in allEquipments.OrderBy(e => e)) {
                        <span class="bg-slate-700 text-slate-300 px-3 py-1.5 rounded-lg text-sm border border-slate-600">@eq</span>
                    }
                </div>
            } else {
                <p class="text-slate-500 italic">No specific equipments required, or uses bodyweight only.</p>
            }
        </div>

        <div>
            <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2"><i class="fa-solid fa-calendar-week text-slate-400"></i> Course Plan (@Model.Weeks.Count Weeks)</h3>
            <div class="space-y-4">
                @foreach(var week in Model.Weeks.OrderBy(w => w.WeekNumber)) {
                    <div class="border border-slate-700 rounded-lg overflow-hidden" x-data="{ expanded: false }">
                        <button @@click="expanded = !expanded" class="w-full flex justify-between items-center bg-slate-900/50 hover:bg-slate-700 px-6 py-4 transition-colors">
                            <h4 class="text-lg font-bold text-white m-0">Week @week.WeekNumber</h4>
                            <i class="fa-solid fa-chevron-down text-slate-400 transition-transform" :class="expanded ? 'rotate-180' : ''"></i>
                        </button>
                        <div x-show="expanded" x-collapse class="bg-slate-800 border-t border-slate-700 p-6">
                            @if(!week.Days.Any()) {
                                <p class="text-slate-500 italic">No days configured.</p>
                            }
                            <div class="space-y-6">
                                @foreach(var day in week.Days) {
                                    <div>
                                        <h5 class="text-brand-400 font-bold text-lg mb-1">@day.Name</h5>
                                        @if(!string.IsNullOrWhiteSpace(day.Description)) {
                                            <p class="text-slate-400 text-sm mb-3">@day.Description</p>
                                        }
                                        <div class="pl-4 border-l-2 border-slate-700 space-y-4 mt-3">
                                            @foreach(var sec in day.Sections) {
                                                <div>
                                                    <h6 class="text-white font-semibold text-sm mb-2 uppercase tracking-wider">@sec.Name</h6>
                                                    <div class="flex flex-wrap gap-2">
                                                        @foreach(var tr in sec.Trainings) {
                                                            if(allTrainings.TryGetValue(tr.TrainingId, out var tDef)) {
                                                                <span class="bg-slate-900 text-slate-300 text-xs px-2 py-1 rounded border border-slate-700" title="@tr.Sets Sets x @tr.Reps Reps">
                                                                    @tDef.Name
                                                                </span>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
