@model AzureTest.Contracts.DTOs.Gym.WorkoutAnalyticsDto
@{
    ViewData["Title"] = "Workout & Weight Analytics";
    var defaultHeight = Model.CurrentHeightCm ?? 175;

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Workout", Url.Action("Index")),
        new("Analytics & Weight Tracker", IsActive: true)
    };
}

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
            <div class="flex items-center gap-3 mt-2">
                <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight">
                        Workout Analytics & Weight Tracker
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">Monitor workout performance, weight progression over time, BMI tracking, and body composition.</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2.5">
            <a asp-action="History" class="inline-flex items-center gap-2 px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 shadow-2xs transition-colors">
                <i class="fa-solid fa-clock-rotate-left text-slate-400 text-2xs"></i> Workout Logs
            </a>
            <button type="button" onclick="openWeightModal()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl shadow-2xs transition-colors">
                <i class="fa-solid fa-weight-scale text-2xs"></i> Log Weight
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-600"></i>
                <span>@TempData["Error"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-600 hover:text-rose-800">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
        <!-- Current Weight -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Weight</span>
                <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center">
                    <i class="fa-solid fa-weight-scale"></i>
                </div>
            </div>
            <div class="text-2xl font-black text-slate-900 mb-1">
                @(Model.CurrentWeightKg.HasValue ? $"{Model.CurrentWeightKg.Value:0.#} kg" : "--")
            </div>
            <p class="text-xs text-slate-500">
                @if (Model.WeightChangeKg.HasValue)
                {
                    var isLoss = Model.WeightChangeKg < 0;
                    <span class="font-bold @(isLoss ? "text-emerald-600" : "text-amber-600")">
                        @(isLoss ? "" : "+")@Model.WeightChangeKg.Value.ToString("0.#") kg
                    </span>
                    <span> vs start</span>
                }
                else
                {
                    <span>Baseline pending</span>
                }
            </p>
        </div>

        <!-- Current BMI -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">BMI</span>
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
            </div>
            <div class="text-2xl font-black text-purple-600 mb-1">
                @(Model.CurrentBmi.HasValue ? Model.CurrentBmi.Value.ToString("0.0") : "--")
            </div>
            <p class="text-xs truncate">
                @if (!string.IsNullOrEmpty(Model.CurrentBmiCategory))
                {
                    var catColor = Model.CurrentBmiCategory switch {
                        "Normal" => "text-emerald-600 font-semibold",
                        "Overweight" => "text-amber-600 font-semibold",
                        "Underweight" => "text-blue-600 font-semibold",
                        _ => "text-rose-600 font-semibold"
                    };
                    <span class="@catColor">@Model.CurrentBmiCategory</span>
                }
                else
                {
                    <span class="text-slate-400">Log height & weight</span>
                }
            </p>
        </div>

        <!-- Muscle % -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Muscle Mass</span>
                <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>
            </div>
            <div class="text-2xl font-black text-emerald-600 mb-1">
                @(Model.CurrentMusclePercent.HasValue ? $"{Model.CurrentMusclePercent.Value:0.0}%" : "--")
            </div>
            <p class="text-xs text-slate-500 truncate">
                @if (Model.MuscleChangePercent.HasValue)
                {
                    var mGain = Model.MuscleChangePercent >= 0;
                    <span class="font-bold @(mGain ? "text-emerald-600" : "text-rose-600")">
                        @(mGain ? "+" : "")@Model.MuscleChangePercent.Value.ToString("0.0")%
                    </span>
                    <span> vs start</span>
                }
                else if (Model.MuscleMassKg.HasValue)
                {
                    <span>@Model.MuscleMassKg.Value.ToString("0.#") kg mass</span>
                }
                else
                {
                    <span class="text-slate-400">Track muscle %</span>
                }
            </p>
        </div>

        <!-- Body Fat % -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Body Fat</span>
                <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i class="fa-solid fa-fire"></i>
                </div>
            </div>
            <div class="text-2xl font-black text-amber-600 mb-1">
                @(Model.CurrentFatPercent.HasValue ? $"{Model.CurrentFatPercent.Value:0.0}%" : "--")
            </div>
            <p class="text-xs text-slate-500 truncate">
                @if (Model.FatChangePercent.HasValue)
                {
                    var fLoss = Model.FatChangePercent < 0;
                    <span class="font-bold @(fLoss ? "text-emerald-600" : "text-amber-600")">
                        @(fLoss ? "" : "+")@Model.FatChangePercent.Value.ToString("0.0")%
                    </span>
                    <span> vs start</span>
                }
                else if (Model.FatMassKg.HasValue)
                {
                    <span>@Model.FatMassKg.Value.ToString("0.#") kg mass</span>
                }
                else
                {
                    <span class="text-slate-400">Track fat %</span>
                }
            </p>
        </div>

        <!-- Total Sessions -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Workouts</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i class="fa-solid fa-stopwatch"></i>
                </div>
            </div>
            <div class="text-2xl font-black text-slate-900 mb-1">@Model.TotalSessions</div>
            <p class="text-xs text-slate-500">@Model.TotalExercisesLogged logs</p>
        </div>

        <!-- Lifted Volume -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Volume</span>
                <div class="w-9 h-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                    <i class="fa-solid fa-trophy"></i>
                </div>
            </div>
            <div class="text-2xl font-black text-sky-600 mb-1">
                @(Model.TotalVolumeLiftedKg >= 1000 ? $"{(Model.TotalVolumeLiftedKg / 1000.0):0.0} t" : $"{Model.TotalVolumeLiftedKg:0.#} kg")
            </div>
            <p class="text-xs text-sky-600 font-medium">Accumulated load</p>
        </div>
    </div>

    <!-- Charts Row: Weight Progression & Workout Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
        <!-- Weight History Chart -->
        <div class="lg:col-span-7 bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="font-bold text-slate-800 text-base">Weight Progression & Trend</h3>
                    <p class="text-xs text-slate-500">Track your weight over time (kg)</p>
                </div>
                <button type="button" onclick="openWeightModal()" class="text-xs font-semibold text-brand-600 hover:text-brand-800 bg-brand-50 px-2.5 py-1 rounded-lg">
                    + Log New
                </button>
            </div>
            <div class="h-72">
                <canvas id="weightChart"></canvas>
            </div>
        </div>

        <!-- Workout Sessions by Month -->
        <div class="lg:col-span-5 bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80">
            <div class="mb-4">
                <h3 class="font-bold text-slate-800 text-base">Workout Frequency</h3>
                <p class="text-xs text-slate-500">Completed training sessions by month</p>
            </div>
            <div class="h-72">
                <canvas id="workoutFrequencyChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Body Composition & Donut Chart Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8 mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Advanced Biometrics</span>
                <h3 class="text-2xl font-black text-slate-900 tracking-tight mt-0.5 flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie text-brand-600"></i> Body Composition Analysis
                </h3>
                <p class="text-slate-500 text-xs sm:text-sm mt-1">Breakdown of muscle mass, body fat percentage, bone density, and lean tissue distribution.</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="openWeightModal()" class="inline-flex items-center px-3.5 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-semibold rounded-lg transition-colors border border-brand-200/70">
                    <i class="fa-solid fa-plus mr-1.5"></i> Update Composition
                </button>
            </div>
        </div>

        @if (Model.CurrentMusclePercent.HasValue || Model.CurrentFatPercent.HasValue || Model.CurrentBonePercent.HasValue)
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- Donut Chart -->
                <div class="lg:col-span-4 flex flex-col items-center justify-center p-4 bg-slate-50/70 rounded-2xl border border-slate-100">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Tissue Distribution</h4>
                    <div class="relative w-56 h-56 flex items-center justify-center">
                        <canvas id="bodyCompositionDonutChart"></canvas>
                        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                            <span class="text-2xs font-semibold text-slate-400 uppercase tracking-wider">Total</span>
                            <span class="text-2xl font-black text-slate-800">100%</span>
                            <span class="text-2xs text-slate-500 font-medium">@(Model.CurrentWeightKg.HasValue ? $"{Model.CurrentWeightKg.Value:0.0} kg" : "--")</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 w-full mt-4 text-xs">
                        <div class="flex items-center gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-100">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
                            <div class="truncate">
                                <span class="text-slate-500 block text-2xs">Muscle</span>
                                <span class="font-bold text-slate-800 font-mono">@(Model.CurrentMusclePercent?.ToString("0.0") ?? "--")%</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-100">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>
                            <div class="truncate">
                                <span class="text-slate-500 block text-2xs">Body Fat</span>
                                <span class="font-bold text-slate-800 font-mono">@(Model.CurrentFatPercent?.ToString("0.0") ?? "--")%</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-100">
                            <span class="w-2.5 h-2.5 rounded-full bg-sky-500 shrink-0"></span>
                            <div class="truncate">
                                <span class="text-slate-500 block text-2xs">Bone</span>
                                <span class="font-bold text-slate-800 font-mono">@(Model.CurrentBonePercent?.ToString("0.0") ?? "--")%</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-100">
                            <span class="w-2.5 h-2.5 rounded-full bg-slate-400 shrink-0"></span>
                            <div class="truncate">
                                <span class="text-slate-500 block text-2xs">Water & Other</span>
                                <span class="font-bold text-slate-800 font-mono">@(Model.CurrentOtherPercent?.ToString("0.0") ?? "--")%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detailed Analysis & Health Zones -->
                <div class="lg:col-span-4 space-y-4">
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wide">Lean vs Fat Mass</span>
                            <span class="text-xs font-mono font-bold text-slate-500">
                                @(Model.LeanMassKg.HasValue ? $"{Model.LeanMassKg.Value:0.0} kg lean" : "")
                            </span>
                        </div>
                        <div class="h-3 rounded-full bg-slate-200 overflow-hidden flex">
                            @{
                                var leanPct = (Model.CurrentWeightKg > 0 && Model.LeanMassKg.HasValue) ? (Model.LeanMassKg.Value / Model.CurrentWeightKg.Value * 100.0) : 75.0;
                                var fatPct = (Model.CurrentWeightKg > 0 && Model.FatMassKg.HasValue) ? (Model.FatMassKg.Value / Model.CurrentWeightKg.Value * 100.0) : 25.0;
                            }
                            <div class="bg-emerald-500 h-full" style="width: @leanPct%" title="Lean Mass: @Model.LeanMassKg kg"></div>
                            <div class="bg-amber-500 h-full" style="width: @fatPct%" title="Fat Mass: @Model.FatMassKg kg"></div>
                        </div>
                        <div class="flex justify-between items-center text-2xs text-slate-500 mt-2">
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Lean: <strong>@(Model.LeanMassKg?.ToString("0.0") ?? "--") kg</strong></span>
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Fat: <strong>@(Model.FatMassKg?.ToString("0.0") ?? "--") kg</strong></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                            <span class="text-2xs font-bold uppercase text-slate-400">Muscle / Fat Ratio</span>
                            <div class="text-xl font-black text-slate-900 mt-1 font-mono">
                                @if (Model.CurrentMusclePercent.HasValue && Model.CurrentFatPercent.HasValue && Model.CurrentFatPercent.Value > 0)
                                {
                                    @($"{(Model.CurrentMusclePercent.Value / Model.CurrentFatPercent.Value):0.00}")<span class="text-xs font-normal text-slate-500"> : 1</span>
                                }
                                else
                                {
                                    <span>--</span>
                                }
                            </div>
                            <p class="text-2xs text-slate-500 mt-0.5">Higher ratio denotes athletic build</p>
                        </div>
                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                            <span class="text-2xs font-bold uppercase text-slate-400">Body Fat Category</span>
                            <div class="text-sm font-bold text-slate-900 mt-1">
                                @if (Model.CurrentFatPercent.HasValue)
                                {
                                    var f = Model.CurrentFatPercent.Value;
                                    if (f < 6)
                                    {
                                        <span class="text-blue-600 font-bold">Essential Fat</span>
                                    }
                                    else if (f < 14)
                                    {
                                        <span class="text-emerald-600 font-bold">Athletes</span>
                                    }
                                    else if (f < 18)
                                    {
                                        <span class="text-emerald-600 font-bold">Fitness</span>
                                    }
                                    else if (f < 25)
                                    {
                                        <span class="text-amber-600 font-bold">Average</span>
                                    }
                                    else
                                    {
                                        <span class="text-rose-600 font-bold">High</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-400">Not set</span>
                                }
                            </div>
                            <p class="text-2xs text-slate-500 mt-0.5">Standard fitness benchmark</p>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-arrows-spin text-brand-600"></i>
                            <div>
                                <span class="font-bold text-slate-800">Recomposition:</span>
                                <span class="text-slate-500 ml-1">
                                    @if (Model.MuscleChangePercent.HasValue || Model.FatChangePercent.HasValue)
                                    {
                                        var mChange = Model.MuscleChangePercent ?? 0;
                                        var fChange = Model.FatChangePercent ?? 0;
                                        if (mChange >= 0 && fChange <= 0)
                                        {
                                            <span class="text-emerald-600 font-semibold">Gaining muscle, cutting fat</span>
                                        }
                                        else if (mChange >= 0)
                                        {
                                            <span class="text-brand-600 font-semibold">Muscle building phase</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-700 font-semibold">Fat loss phase</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>Initial baseline recorded</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Trend Chart: Muscle % vs Fat % over time -->
                <div class="lg:col-span-4 bg-slate-50/70 p-4 rounded-2xl border border-slate-100">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600">Composition Progression</h4>
                        <span class="text-2xs font-semibold text-slate-400">Muscle vs Fat %</span>
                    </div>
                    <div class="h-56">
                        <canvas id="bodyCompositionTrendChart"></canvas>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty state with guidance and preview donut -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center p-6 rounded-2xl bg-gradient-to-r from-slate-50 via-slate-50 to-brand-50/20 border border-slate-200/60">
                <div class="md:col-span-4 flex justify-center">
                    <div class="relative w-44 h-44 flex items-center justify-center opacity-85">
                        <canvas id="bodyCompositionPlaceholderChart"></canvas>
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
                            <i class="fa-solid fa-chart-pie text-brand-600 text-2xl mb-1"></i>
                            <span class="text-2xs font-bold text-slate-400 uppercase tracking-wider">Preview</span>
                        </div>
                    </div>
                </div>
                <div class="md:col-span-8">
                    <h4 class="text-lg font-bold text-slate-900 mb-1">Track Muscle, Fat, & Bone Percentages</h4>
                    <p class="text-sm text-slate-600 mb-4 leading-relaxed">
                        Log your body composition percentages from a bioimpedance scale, smart scale, or DEXA scan. Tracking composition alongside body weight unlocks accurate muscle gain, fat loss, and lean body mass metrics.
                    </p>
                    <div class="flex flex-wrap items-center gap-3">
                        <button type="button" onclick="openWeightModal()" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors">
                            <i class="fa-solid fa-plus mr-1.5"></i> Log First Body Composition
                        </button>
                        <span class="text-xs text-slate-400">Available whenever you click "Log Weight"</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Top Exercises Performance & Volume -->
    @if (Model.TopExercises.Any())
    {
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200/80 mb-8">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h3 class="font-bold text-slate-800 text-base">Top Exercises by Volume & Max Weight</h3>
                    <p class="text-xs text-slate-500">Breakdown of most performed movements and weight lifted</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var ex in Model.TopExercises.Take(4))
                {
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col justify-between">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Exercise</span>
                            <h4 class="font-bold text-slate-900 text-base mt-1 mb-2">@ex.TrainingName</h4>
                            <div class="text-xs text-slate-500 space-y-1">
                                <div><span class="text-slate-400">Sets × Reps:</span> <span class="font-semibold text-slate-700">@ex.TotalSets sets / @ex.TotalReps reps</span></div>
                                <div><span class="text-slate-400">Total Volume:</span> <span class="font-semibold text-slate-700">@ex.TotalVolume.ToString("N0") kg</span></div>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-t border-slate-200/60 flex items-center justify-between">
                            <span class="text-xs text-slate-500 font-medium">Max Weight:</span>
                            <span class="text-base font-black text-slate-900 font-mono">@ex.MaxWeight.ToString("0.#") kg</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Weight Tracker Log Table -->
    <div id="weight-history-section" class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden mb-8 scroll-mt-6">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center justify-between">
            <div>
                <h3 class="font-bold text-slate-800 text-base">Weight & BMI History</h3>
                <p class="text-xs text-slate-500">Every recorded measurement with automatic BMI calculations</p>
            </div>
            <button type="button" onclick="openWeightModal()" class="inline-flex items-center px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors">
                <i class="fa-solid fa-plus mr-1"></i> Add Entry
            </button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-slate-50 text-slate-500 uppercase text-xs font-semibold border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-3.5">Date</th>
                        <th class="px-6 py-3.5 text-right">Weight (kg)</th>
                        <th class="px-6 py-3.5 text-right">Height (cm)</th>
                        <th class="px-6 py-3.5 text-center">Calculated BMI</th>
                        <th class="px-6 py-3.5 text-center">Category</th>
                        <th class="px-6 py-3.5 text-center">Muscle %</th>
                        <th class="px-6 py-3.5 text-center">Fat %</th>
                        <th class="px-6 py-3.5 text-center">Bone %</th>
                        <th class="px-6 py-3.5 text-left">Notes</th>
                        <th class="px-6 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (Model.WeightLogs.Any())
                    {
                        foreach (var w in Model.WeightLogs)
                        {
                            var badgeClass = w.BmiCategory switch {
                                "Underweight" => "bg-blue-100 text-blue-800",
                                "Normal" => "bg-emerald-100 text-emerald-800",
                                "Overweight" => "bg-amber-100 text-amber-800",
                                _ => "bg-rose-100 text-rose-800"
                            };

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-6 py-4 font-semibold text-slate-900">
                                    @w.Date.ToString("MMM dd, yyyy")
                                </td>
                                <td class="px-6 py-4 text-right font-black text-slate-900 font-mono">
                                    @w.WeightKg.ToString("0.0") kg
                                </td>
                                <td class="px-6 py-4 text-right text-slate-600 font-mono">
                                    @w.HeightCm.ToString("0.#") cm
                                </td>
                                <td class="px-6 py-4 text-center font-bold text-slate-800 font-mono">
                                    @w.Bmi.ToString("0.0")
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @badgeClass">
                                        @w.BmiCategory
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center font-mono text-xs">
                                    @if (w.MusclePercent.HasValue)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                                            <i class="fa-solid fa-dumbbell mr-1 text-emerald-500 text-2xs"></i>@w.MusclePercent.Value.ToString("0.0")%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-center font-mono text-xs">
                                    @if (w.FatPercent.HasValue)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200/60">
                                            <i class="fa-solid fa-fire mr-1 text-amber-500 text-2xs"></i>@w.FatPercent.Value.ToString("0.0")%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-center font-mono text-xs">
                                    @if (w.BonePercent.HasValue)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200/60">
                                            <i class="fa-solid fa-bone mr-1 text-sky-500 text-2xs"></i>@w.BonePercent.Value.ToString("0.0")%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-500 max-w-xs truncate">
                                    @(string.IsNullOrWhiteSpace(w.Notes) ? "-" : w.Notes)
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <form asp-action="DeleteWeight" asp-route-id="@w.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this weight log?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-rose-600 hover:text-rose-800 p-1 bg-transparent border-0 cursor-pointer" title="Delete">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="px-6 py-12 text-center text-slate-400">
                                <i class="fa-solid fa-weight-scale text-4xl mb-3 block text-slate-300"></i>
                                <p class="font-medium text-slate-700">No weight records logged yet.</p>
                                <p class="text-xs text-slate-400 mt-1">Click "Log Weight" above to track your weight progress.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Free Interactive BMI Calculator -->
    <div class="bg-gradient-to-br from-white to-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm mb-8">
        <div class="mb-6">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Health & Fitness Tool</span>
            <h3 class="text-2xl font-black text-slate-900 tracking-tight mt-1 flex items-center gap-2">
                <i class="fa-solid fa-calculator text-brand-500"></i> Free Interactive BMI Calculator
            </h3>
            <p class="text-slate-500 text-sm mt-1">Enter your height and weight to calculate your Body Mass Index (BMI), visual health zone, and healthy weight recommendations.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Inputs -->
            <div class="lg:col-span-5 space-y-5">
                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-sm font-semibold text-slate-700">Height (cm)</label>
                        <span id="calcHeightDisplay" class="text-sm font-bold text-brand-600">@defaultHeight cm</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="range" id="calcHeightSlider" min="100" max="230" value="@defaultHeight" oninput="syncHeight(this.value)" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-brand-600" />
                        <input type="number" id="calcHeightNum" min="50" max="250" value="@defaultHeight" oninput="syncHeight(this.value)" class="w-20 px-2 py-1.5 border border-slate-300 rounded-lg text-sm text-center font-bold text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500" />
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-sm font-semibold text-slate-700">Weight (kg)</label>
                        <span id="calcWeightDisplay" class="text-sm font-bold text-brand-600">@(Model.CurrentWeightKg ?? 75) kg</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="range" id="calcWeightSlider" min="30" max="180" step="0.5" value="@(Model.CurrentWeightKg ?? 75)" oninput="syncWeight(this.value)" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-brand-600" />
                        <input type="number" id="calcWeightNum" min="20" max="300" step="0.5" value="@(Model.CurrentWeightKg ?? 75)" oninput="syncWeight(this.value)" class="w-20 px-2 py-1.5 border border-slate-300 rounded-lg text-sm text-center font-bold text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500" />
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-slate-100/70 border border-slate-200 text-xs text-slate-600 space-y-1">
                    <div><span class="font-semibold text-slate-800">Healthy Weight Range for this height:</span> <span id="healthyRangeText" class="font-bold text-emerald-700">56.7 - 76.3 kg</span></div>
                    <div><span class="font-semibold text-slate-800">Weight Adjustment:</span> <span id="weightDiffText" class="font-bold">Ideal range</span></div>
                </div>
            </div>

            <!-- Result Card -->
            <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <span class="text-xs uppercase font-bold text-slate-400">Your Calculated BMI</span>
                        <div class="text-5xl font-black text-slate-900 font-mono tracking-tight mt-1" id="calculatedBmiVal">24.5</div>
                    </div>
                    <div>
                        <span id="calculatedBmiBadge" class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-emerald-100 text-emerald-800">
                            Normal Weight
                        </span>
                    </div>
                </div>

                <!-- Visual Gauge / Color Spectrum -->
                <div class="mb-4">
                    <div class="relative h-4 rounded-full overflow-hidden flex mb-2 shadow-inner">
                        <div class="bg-blue-400 h-full" style="width: 25%" title="Underweight (<18.5)"></div>
                        <div class="bg-emerald-500 h-full" style="width: 30%" title="Normal (18.5-24.9)"></div>
                        <div class="bg-amber-400 h-full" style="width: 25%" title="Overweight (25-29.9)"></div>
                        <div class="bg-rose-500 h-full" style="width: 20%" title="Obese (>=30)"></div>
                    </div>
                    <!-- Indicator Pin -->
                    <div class="relative w-full h-4">
                        <div id="bmiPin" class="absolute -top-1 -ml-2 text-slate-800 transition-all duration-300" style="left: 45%;">
                            <i class="fa-solid fa-caret-up text-lg"></i>
                        </div>
                    </div>
                </div>

                <!-- Categories Legend Table -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs pt-3 border-t border-slate-100">
                    <div class="p-2 rounded-lg bg-blue-50/70 border border-blue-100">
                        <span class="text-blue-800 font-bold block">&lt; 18.5</span>
                        <span class="text-blue-600">Underweight</span>
                    </div>
                    <div class="p-2 rounded-lg bg-emerald-50/70 border border-emerald-100">
                        <span class="text-emerald-800 font-bold block">18.5 - 24.9</span>
                        <span class="text-emerald-600">Normal</span>
                    </div>
                    <div class="p-2 rounded-lg bg-amber-50/70 border border-amber-100">
                        <span class="text-amber-800 font-bold block">25.0 - 29.9</span>
                        <span class="text-amber-600">Overweight</span>
                    </div>
                    <div class="p-2 rounded-lg bg-rose-50/70 border border-rose-100">
                        <span class="text-rose-800 font-bold block">&ge; 30.0</span>
                        <span class="text-rose-600">Obese</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Log Weight -->
<div id="weightModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm overflow-y-auto p-3 sm:p-4 flex items-center justify-center min-h-screen" onclick="if (event.target === this) closeWeightModal()">
    <div class="relative bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-4 sm:p-6 shadow-2xl border border-slate-200 dark:border-slate-700 my-auto max-h-[92vh] flex flex-col">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700 mb-4 shrink-0">
            <h3 class="font-bold text-slate-900 dark:text-white text-base sm:text-lg flex items-center gap-2">
                <i class="fa-solid fa-weight-scale text-brand-600 dark:text-brand-400"></i> Record Weight Entry
            </h3>
            <button type="button" onclick="closeWeightModal()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form asp-action="LogWeight" method="post" class="flex-1 flex flex-col min-h-0">
            @Html.AntiForgeryToken()
            <div class="overflow-y-auto space-y-4 pr-1 -mr-1 flex-1">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Weight (kg) *</label>
                        <input type="number" step="0.1" name="WeightKg" required value="@(Model.CurrentWeightKg ?? 80)" class="w-full px-3 py-2 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-semibold" placeholder="e.g. 85.0" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Height (cm) *</label>
                        <input type="number" step="0.5" name="HeightCm" required value="@defaultHeight" class="w-full px-3 py-2 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-semibold" placeholder="e.g. 180" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Date *</label>
                    <input type="date" name="Date" required value="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full px-3 py-2 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>

                <!-- Body Composition (Optional) -->
                <div class="p-3.5 bg-slate-50 dark:bg-slate-750 rounded-xl border border-slate-200/70 dark:border-slate-700 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200 flex items-center gap-1.5">
                            <i class="fa-solid fa-chart-pie text-brand-600 dark:text-brand-400"></i> Body Composition (Optional)
                        </span>
                        <span class="text-3xs sm:text-2xs text-slate-400">Smart scale / DEXA</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        <div>
                            <label class="block text-2xs font-semibold text-slate-600 dark:text-slate-300 mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-dumbbell text-emerald-600 dark:text-emerald-400"></i> Muscle %
                            </label>
                            <input type="number" step="0.1" min="0" max="100" name="MusclePercent" value="@(Model.CurrentMusclePercent?.ToString("0.0"))" class="w-full px-3 py-2 sm:px-2 sm:py-1.5 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg text-sm sm:text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 font-semibold" placeholder="e.g. 42.5" />
                        </div>
                        <div>
                            <label class="block text-2xs font-semibold text-slate-600 dark:text-slate-300 mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-fire text-amber-500"></i> Fat %
                            </label>
                            <input type="number" step="0.1" min="0" max="100" name="FatPercent" value="@(Model.CurrentFatPercent?.ToString("0.0"))" class="w-full px-3 py-2 sm:px-2 sm:py-1.5 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg text-sm sm:text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 font-semibold" placeholder="e.g. 18.0" />
                        </div>
                        <div>
                            <label class="block text-2xs font-semibold text-slate-600 dark:text-slate-300 mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-bone text-sky-500"></i> Bone %
                            </label>
                            <input type="number" step="0.1" min="0" max="100" name="BonePercent" value="@(Model.CurrentBonePercent?.ToString("0.0"))" class="w-full px-3 py-2 sm:px-2 sm:py-1.5 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg text-sm sm:text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 font-semibold" placeholder="e.g. 14.5" />
                        </div>
                    </div>
                    <p class="text-3xs sm:text-2xs text-slate-400">Sum must be &le; 100%. Remainder accounts for body water & other fluids.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Notes (Optional)</label>
                    <textarea name="Notes" rows="2" class="w-full px-3 py-2 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="e.g. Morning fasting, post workout..."></textarea>
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700 flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 shrink-0">
                <button type="button" onclick="closeWeightModal()" class="w-full sm:w-auto px-4 py-2.5 border border-slate-300 dark:border-slate-600 rounded-xl text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors text-center">
                    Cancel
                </button>
                <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-xs sm:text-sm font-semibold rounded-xl shadow-2xs transition-colors text-center">
                    Save Record
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Modal helpers
        function openWeightModal() {
            document.getElementById('weightModal').classList.remove('hidden');
        }
        function closeWeightModal() {
            document.getElementById('weightModal').classList.add('hidden');
        }

        // Interactive Free BMI Calculator
        function syncHeight(val) {
            document.getElementById('calcHeightSlider').value = val;
            document.getElementById('calcHeightNum').value = val;
            document.getElementById('calcHeightDisplay').innerText = val + ' cm';
            recalculateBmi();
        }

        function syncWeight(val) {
            document.getElementById('calcWeightSlider').value = val;
            document.getElementById('calcWeightNum').value = val;
            document.getElementById('calcWeightDisplay').innerText = val + ' kg';
            recalculateBmi();
        }

        function recalculateBmi() {
            const h = parseFloat(document.getElementById('calcHeightNum').value);
            const w = parseFloat(document.getElementById('calcWeightNum').value);
            if (!h || !w || h <= 0) return;

            const hm = h / 100.0;
            const bmi = w / (hm * hm);
            const roundedBmi = bmi.toFixed(1);
            document.getElementById('calculatedBmiVal').innerText = roundedBmi;

            // Categories
            const badge = document.getElementById('calculatedBmiBadge');
            let category = "Normal Weight";
            let badgeClass = "bg-emerald-100 text-emerald-800";
            let pinPercent = 50;

            if (bmi < 18.5) {
                category = "Underweight";
                badgeClass = "bg-blue-100 text-blue-800";
                pinPercent = Math.max(2, (bmi / 18.5) * 25);
            } else if (bmi < 25) {
                category = "Normal Weight";
                badgeClass = "bg-emerald-100 text-emerald-800";
                pinPercent = 25 + ((bmi - 18.5) / 6.5) * 30;
            } else if (bmi < 30) {
                category = "Overweight";
                badgeClass = "bg-amber-100 text-amber-800";
                pinPercent = 55 + ((bmi - 25) / 5) * 25;
            } else {
                category = bmi >= 35 ? "Severe Obesity" : "Obese";
                badgeClass = "bg-rose-100 text-rose-800";
                pinPercent = Math.min(98, 80 + ((bmi - 30) / 10) * 20);
            }

            badge.className = "inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold " + badgeClass;
            badge.innerText = category;
            document.getElementById('bmiPin').style.left = pinPercent + '%';

            // Healthy Weight Range
            const minW = (18.5 * hm * hm).toFixed(1);
            const maxW = (24.9 * hm * hm).toFixed(1);
            document.getElementById('healthyRangeText').innerText = minW + ' - ' + maxW + ' kg';

            const diffText = document.getElementById('weightDiffText');
            if (w < minW) {
                const gain = (minW - w).toFixed(1);
                diffText.innerText = "Gain " + gain + " kg to reach Normal BMI";
                diffText.className = "font-bold text-blue-600";
            } else if (w > maxW) {
                const loss = (w - maxW).toFixed(1);
                diffText.innerText = "Lose " + loss + " kg to reach Normal BMI";
                diffText.className = "font-bold text-amber-600";
            } else {
                diffText.innerText = "Within healthy target range";
                diffText.className = "font-bold text-emerald-600";
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            recalculateBmi();

            // Weight Progression Chart
            @{
                var sortedWeightLogs = Model.WeightLogs.OrderBy(w => w.Date).ToList();
                var weightDates = sortedWeightLogs.Select(w => w.Date.ToString("MMM dd")).ToList();
                var weightVals = sortedWeightLogs.Select(w => w.WeightKg).ToList();
                var bmiVals = sortedWeightLogs.Select(w => w.Bmi).ToList();
            }

            const wDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weightDates));
            const wVals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weightVals));
            const bVals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bmiVals));

            const ctxWeight = document.getElementById('weightChart')?.getContext('2d');
            if (ctxWeight && wDates.length > 0) {
                new Chart(ctxWeight, {
                    type: 'line',
                    data: {
                        labels: wDates,
                        datasets: [
                            {
                                label: 'Weight (kg)',
                                data: wVals,
                                borderColor: '#0284c7',
                                backgroundColor: 'rgba(2, 132, 199, 0.1)',
                                fill: true,
                                tension: 0.3,
                                pointBackgroundColor: '#0284c7',
                                pointRadius: 5,
                                yAxisID: 'y'
                            },
                            {
                                label: 'BMI',
                                data: bVals,
                                borderColor: '#9333ea',
                                borderDash: [5, 5],
                                tension: 0.3,
                                pointBackgroundColor: '#9333ea',
                                pointRadius: 4,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: { legend: { position: 'top' } },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: { display: true, text: 'Weight (kg)' },
                                grid: { color: '#f1f5f9' }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: { display: true, text: 'BMI' },
                                grid: { display: false }
                            }
                        }
                    }
                });
            } else if (ctxWeight) {
                // Placeholder chart if empty
                new Chart(ctxWeight, {
                    type: 'line',
                    data: {
                        labels: ['Mar', 'May', 'Aug', 'Oct'],
                        datasets: [{
                            label: 'Sample Weight Trend (kg)',
                            data: [115, 105, 95, 85],
                            borderColor: '#cbd5e1',
                            borderDash: [4, 4],
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            title: { display: true, text: 'Sample Trend (Log your first weight above)' }
                        }
                    }
                });
            }

            // Workout Frequency Chart
            const fDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SessionTrend.Select(s => s.DateLabel)));
            const fCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SessionTrend.Select(s => s.SessionCount)));

            const ctxFreq = document.getElementById('workoutFrequencyChart')?.getContext('2d');
            if (ctxFreq && fDates.length > 0) {
                new Chart(ctxFreq, {
                    type: 'bar',
                    data: {
                        labels: fDates,
                        datasets: [{
                            label: 'Sessions',
                            data: fCounts,
                            backgroundColor: '#10b981',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f1f5f9' } }
                        }
                    }
                });
            }

            // Body Composition Charts Data
            @{
                var compLogs = Model.WeightLogs
                    .Where(w => w.MusclePercent.HasValue || w.FatPercent.HasValue || w.BonePercent.HasValue)
                    .OrderBy(w => w.Date)
                    .ToList();
                var compDates = compLogs.Select(w => w.Date.ToString("MMM dd")).ToList();
                var compMuscle = compLogs.Select(w => w.MusclePercent).ToList();
                var compFat = compLogs.Select(w => w.FatPercent).ToList();
                var compBone = compLogs.Select(w => w.BonePercent).ToList();
            }

            const compDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(compDates));
            const compMuscle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(compMuscle));
            const compFat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(compFat));
            const compBone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(compBone));

            // Body Composition Donut Chart
            const ctxDonut = document.getElementById('bodyCompositionDonutChart')?.getContext('2d');
            if (ctxDonut) {
                const muscleVal = @(Model.CurrentMusclePercent ?? 0);
                const fatVal = @(Model.CurrentFatPercent ?? 0);
                const boneVal = @(Model.CurrentBonePercent ?? 0);
                const otherVal = @(Model.CurrentOtherPercent ?? 0);

                new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: {
                        labels: ['Muscle', 'Body Fat', 'Bone', 'Water & Other'],
                        datasets: [{
                            data: [muscleVal, fatVal, boneVal, otherVal],
                            backgroundColor: ['#10b981', '#f59e0b', '#38bdf8', '#cbd5e1'],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ' ' + context.label + ': ' + context.raw + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Placeholder Donut Chart when empty
            const ctxPlaceholder = document.getElementById('bodyCompositionPlaceholderChart')?.getContext('2d');
            if (ctxPlaceholder) {
                new Chart(ctxPlaceholder, {
                    type: 'doughnut',
                    data: {
                        labels: ['Muscle (Sample)', 'Fat (Sample)', 'Bone (Sample)', 'Other (Sample)'],
                        datasets: [{
                            data: [42, 18, 14, 26],
                            backgroundColor: ['#a7f3d0', '#fde68a', '#bae6fd', '#e2e8f0'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { display: false },
                            tooltip: { enabled: false }
                        }
                    }
                });
            }

            // Body Composition Trend Chart
            const ctxCompTrend = document.getElementById('bodyCompositionTrendChart')?.getContext('2d');
            if (ctxCompTrend && compDates.length > 0) {
                new Chart(ctxCompTrend, {
                    type: 'line',
                    data: {
                        labels: compDates,
                        datasets: [
                            {
                                label: 'Muscle %',
                                data: compMuscle,
                                borderColor: '#10b981',
                                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                                fill: false,
                                tension: 0.3,
                                pointBackgroundColor: '#10b981',
                                pointRadius: 4
                            },
                            {
                                label: 'Fat %',
                                data: compFat,
                                borderColor: '#f59e0b',
                                backgroundColor: 'rgba(245, 158, 11, 0.1)',
                                fill: false,
                                tension: 0.3,
                                pointBackgroundColor: '#f59e0b',
                                pointRadius: 4
                            },
                            {
                                label: 'Bone %',
                                data: compBone,
                                borderColor: '#38bdf8',
                                backgroundColor: 'rgba(56, 189, 248, 0.1)',
                                fill: false,
                                borderDash: [4, 4],
                                tension: 0.3,
                                pointBackgroundColor: '#38bdf8',
                                pointRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } }
                        },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                title: { display: true, text: '%' },
                                grid: { color: '#f1f5f9' },
                                suggestedMin: 5,
                                suggestedMax: 50
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            } else if (ctxCompTrend) {
                new Chart(ctxCompTrend, {
                    type: 'line',
                    data: {
                        labels: ['Start', 'Target'],
                        datasets: [
                            {
                                label: 'Sample Muscle Trend',
                                data: [38, 43],
                                borderColor: '#a7f3d0',
                                borderDash: [4, 4],
                                fill: false
                            },
                            {
                                label: 'Sample Fat Trend',
                                data: [22, 16],
                                borderColor: '#fde68a',
                                borderDash: [4, 4],
                                fill: false
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', labels: { boxWidth: 10, font: { size: 10 } } },
                            title: { display: true, text: 'Log 2+ composition entries to track trend' }
                        }
                    }
                });
            }
        });
    </script>
}
