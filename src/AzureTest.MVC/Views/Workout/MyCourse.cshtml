@model AzureTest.Domain.Documents.Gym.UserGymCourse
@{
    ViewData["Title"] = Model.Name;
}

<div class="p-6 max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-8 border-b border-slate-700 pb-4">
        <h2 class="text-3xl font-bold text-white">@Model.Name</h2>
        <a href="@Url.Action("Index")" class="text-slate-400 hover:text-white transition-colors flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>

    @if (!Model.Weeks.Any()) {
        <p class="text-slate-400 italic">No weeks defined for this course.</p>
    }

    <div class="space-y-8">
        @foreach (var week in Model.Weeks.OrderBy(w => w.WeekNumber)) {
            <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden shadow-lg">
                <div class="bg-slate-900/80 px-6 py-4 border-b border-slate-700">
                    <h4 class="text-xl font-bold text-white m-0">Week @week.WeekNumber</h4>
                </div>
                <div class="divide-y divide-slate-700/50">
                    @if (!week.Days.Any()) {
                        <div class="px-6 py-4 text-slate-500 italic">No days in this week.</div>
                    }
                    @foreach (var day in week.Days) {
                        var isCompleted = Model.CompletedDayIds.Contains(day.Id);
                        <a href="@Url.Action("Day", new { userGymCourseId = Model.Id, week = week.WeekNumber, dayId = day.Id })" 
                           class="block px-6 py-5 hover:bg-slate-700/50 transition-colors group">
                            <div class="flex justify-between items-center">
                                <div>
                                    <h5 class="text-lg font-semibold text-brand-400 group-hover:text-brand-300 transition-colors mb-1">@day.Name</h5>
                                    @if(!string.IsNullOrWhiteSpace(day.Description)) {
                                        <p class="text-sm text-slate-400">@day.Description</p>
                                    }
                                </div>
                                <div>
                                    @if (isCompleted) {
                                        <span class="bg-green-500/20 text-green-400 border border-green-500/30 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider">Completed</span>
                                    } else {
                                        <span class="bg-brand-500/20 text-brand-400 border border-brand-500/30 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider group-hover:bg-brand-500 group-hover:text-white transition-all"><i class="fa-solid fa-play mr-1"></i> Start</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
