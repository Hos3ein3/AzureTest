@model AzureTest.Contracts.DTOs.SampleNotes.UpdateSampleNoteDto
@using AzureTest.Domain.Enums
@using AzureTest.MVC.Extensions
@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Edit Note";
    var pageHeader = new PageHeaderModel
    {
        Title = "Edit Note",
        Subtitle = "Changes validated by IValidationService & FluentValidation",
        Icon = "fa-solid fa-pen-to-square",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Sample Notes", Url.Action("Index", "SampleNote")),
            new BreadcrumbItem("Edit", active: true)
        }
    };
}

<partial name="UiComponents/_PageHeader" model="pageHeader" />

<!-- Validation Summary -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="max-w-2xl mb-6 px-4 py-3 bg-rose-50 border border-rose-200/80 rounded-xl text-xs text-rose-700 shadow-2xs">
        <p class="font-bold mb-1 flex items-center gap-1.5"><i class="fa-solid fa-triangle-exclamation"></i> Please fix the following errors:</p>
        <div asp-validation-summary="All" class="space-y-0.5"></div>
    </div>
}

<div class="max-w-2xl bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-800 m-0 flex items-center gap-2">
            <i class="fa-solid fa-pen text-brand-600"></i>
            Edit Note
        </h2>
    </div>
    
    <div class="p-6">
        <form asp-action="Edit" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <!-- Title -->
            <div>
                <label asp-for="Title" class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Title <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-heading"></i>
                    </span>
                    <input asp-for="Title" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white"
                           placeholder="Enter note title..." />
                </div>
                <span asp-validation-for="Title" class="text-rose-600 text-2xs mt-1 block"></span>
            </div>

            <!-- Content -->
            <div>
                <label asp-for="Content" class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Content <span class="text-rose-500">*</span>
                </label>
                <textarea asp-for="Content" rows="6"
                          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white resize-y"
                          placeholder="Write your note content here..."></textarea>
                <span asp-validation-for="Content" class="text-rose-600 text-2xs mt-1 block"></span>
            </div>

            <!-- Category + Priority row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Category" class="block text-xs font-semibold text-slate-700 mb-1.5">Category</label>
                    <select asp-for="Category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white">
                        @foreach (var item in EnumExtensions.ToSelectList<NoteCategory>(Model.Category))
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                    <span asp-validation-for="Category" class="text-rose-600 text-2xs mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Priority" class="block text-xs font-semibold text-slate-700 mb-1.5">Priority (1–5)</label>
                    <input asp-for="Priority" type="number" min="1" max="5"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" />
                    <span asp-validation-for="Priority" class="text-rose-600 text-2xs mt-1 block"></span>
                </div>
            </div>

            <!-- IsPinned -->
            <div class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50/50">
                <input asp-for="IsPinned" type="checkbox" class="w-4 h-4 text-brand-600 rounded border-slate-300 focus:ring-brand-500" />
                <label asp-for="IsPinned" class="text-xs font-semibold text-slate-700 cursor-pointer">Pin this note to the top</label>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm transition-colors">
                    <i class="fa-solid fa-floppy-disk text-2xs"></i>
                    <span>Save Changes</span>
                </button>
                <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors">
                    <span>Cancel</span>
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
