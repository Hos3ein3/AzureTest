@model List<AzureTest.Contracts.DTOs.SampleNotes.SampleNoteDto>
@using AzureTest.Domain.Enums
@using AzureTest.MVC.Extensions
@using AzureTest.Application.SampleNotes.Queries
@{
    ViewData["Title"] = "Sample Notes";
    var filter = ViewBag.Filter as SampleNoteFilter ?? new SampleNoteFilter();
}

<div class="p-6 space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold text-slate-800">Sample Notes</h1>
            <span class="px-2 py-0.5 text-xs font-semibold bg-yellow-100 text-yellow-700 rounded-full border border-yellow-300 flex items-center gap-1">
                <i class="fa-solid fa-flask"></i> Dev Playground
            </span>
        </div>
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus"></i> New Note
        </a>
    </div>

    <!-- Success Toast -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-2 px-4 py-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm">
            <i class="fa-solid fa-circle-check text-green-500"></i>
            @TempData["Success"]
        </div>
    }

    <!-- Validation errors (from Result.ToFormResult) -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- Filter Form -->
    <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
        <form method="get" class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-48">
                <label class="block text-xs font-medium text-slate-500 mb-1">Search</label>
                <input type="text" name="Search" value="@filter.Search"
                       placeholder="Title or content..."
                       class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>
            <div class="min-w-36">
                <label class="block text-xs font-medium text-slate-500 mb-1">Category</label>
                <select name="Category" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <option value="">All Categories</option>
                    @foreach (var item in EnumExtensions.ToSelectList<NoteCategory>(filter.Category))
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </div>
            <div class="flex items-center gap-2 pb-0.5">
                <input type="checkbox" name="IsPinned" value="true" id="isPinned" @(filter.IsPinned == true ? "checked" : "")
                       class="w-4 h-4 text-brand-500 rounded border-slate-300" />
                <label for="isPinned" class="text-sm text-slate-600">Pinned only</label>
            </div>
            <button type="submit" class="px-4 py-2 bg-slate-700 text-white rounded-lg text-sm hover:bg-slate-800 transition-colors">
                <i class="fa-solid fa-filter mr-1"></i> Filter
            </button>
            <a asp-action="Index" class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-lg text-sm hover:bg-slate-50 transition-colors">
                Clear
            </a>
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        @if (!Model.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                <i class="fa-solid fa-note-sticky text-5xl mb-3 opacity-30"></i>
                <p class="text-sm">No notes found. <a asp-action="Create" class="text-brand-500 hover:underline">Create one!</a></p>
            </div>
        }
        else
        {
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Title</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Category</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Priority</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Pinned</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-600">Created</th>
                        <th class="text-right px-4 py-3 font-medium text-slate-600">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var note in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3">
                                <div class="font-medium text-slate-800">@note.Title</div>
                                <div class="text-xs text-slate-400 truncate max-w-xs">@note.Content</div>
                            </td>
                            <td class="px-4 py-3">
                                @{
                                    var badgeClass = note.Category switch
                                    {
                                        NoteCategory.Urgent => "bg-red-100 text-red-700",
                                        NoteCategory.Work => "bg-blue-100 text-blue-700",
                                        NoteCategory.Personal => "bg-green-100 text-green-700",
                                        _ => "bg-slate-100 text-slate-600"
                                    };
                                }
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full @badgeClass">@note.Category</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="font-semibold text-slate-700 mr-1.5">@note.Priority</span>
                                <span class="inline-flex items-center gap-0.5">
                                    @for (int s = 0; s < note.Priority; s++)
                                    {
                                        <i class="fa-solid fa-star text-amber-400 text-xs"></i>
                                    }
                                    @for (int s = note.Priority; s < 5; s++)
                                    {
                                        <i class="fa-regular fa-star text-slate-300 text-xs"></i>
                                    }
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (note.IsPinned)
                                {
                                    <span class="text-yellow-500" title="Pinned"><i class="fa-solid fa-thumbtack"></i></span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-500 text-xs">@note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@note.Id"
                                       class="inline-flex items-center px-2.5 py-1.5 bg-slate-100 text-slate-700 rounded-md text-xs hover:bg-slate-200 transition-colors">
                                        <i class="fa-solid fa-pen-to-square mr-1"></i> Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@note.Id" method="post"
                                          onsubmit="return confirm('Delete \'@Html.Raw(note.Title.Replace("'", "\\'"))\'? This cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="inline-flex items-center px-2.5 py-1.5 bg-red-50 text-red-600 rounded-md text-xs hover:bg-red-100 transition-colors">
                                            <i class="fa-solid fa-trash mr-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Dev Info Box -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
        <p class="font-semibold mb-1"><i class="fa-solid fa-circle-info mr-1"></i> About this page</p>
        <p>This is a <strong>dev-only playground</strong> for testing <code class="bg-amber-100 px-1 rounded">IValidationService</code>, <code class="bg-amber-100 px-1 rounded">ResultExtensions</code>,  <code class="bg-amber-100 px-1 rounded">TempData with Toast Extension</code>, and <code class="bg-amber-100 px-1 rounded">EnumExtensions</code>.
        Notes are stored in memory + a flat file (<code class="bg-amber-100 px-1 rounded">sample_notes_data.csv</code>) — no database required.</p>
    </div>
</div>
