@model AzureTest.MVC.ViewModels.Permissions.RolePermissionsViewModel
@{
    ViewData["Title"] = $"Permissions for {Model.RoleName}";
    var groupedPermissions = Model.Permissions
        .GroupBy(p => new { Area = p.AreaName ?? "", Controller = p.ControllerName })
        .OrderBy(g => g.Key.Area)
        .ThenBy(g => g.Key.Controller)
        .ToList();

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Administration", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Roles", Url = "/Role/Index" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = $"Permissions: {Model.RoleName}", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = $"Role Permissions: {Model.RoleName}",
        Subtitle = "Configure which system endpoints and controller actions this role has authority to execute.",
        Icon = "fa-solid fa-user-shield",
        Badge = Model.RoleName,
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-between gap-3 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="text-xs font-semibold text-emerald-800">@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 text-xs" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<form asp-action="UpdateRolePermissions" method="post" id="rolePermissionsForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RoleName" />
    
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden mb-6">
        <!-- Control Bar -->
        <div class="p-4 border-b border-slate-200/80 bg-slate-50/70 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2.5 flex-1">
                <!-- Search Box (Title, Description, URL, Area, Controller, Action) -->
                <div class="relative flex-1 min-w-[260px] max-w-md">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="permissionSearch" 
                           class="w-full pl-9 pr-8 py-2 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" 
                           placeholder="Search title, description, or URL (e.g. /media/stats, delete)...">
                    <button type="button" id="clearSearchBtn" style="display:none;" 
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 text-xs" title="Clear Search">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>

                <!-- Checked / Unchecked State Filter Pills -->
                <div class="inline-flex p-1 bg-white rounded-xl border border-slate-200 shadow-2xs" id="statusFilterPills">
                    <button type="button" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-slate-900 text-white shadow-2xs" data-status="all">
                        All <span id="countAll" class="ml-1 px-1.5 py-0.2 rounded-md bg-white/20 text-3xs font-mono">0</span>
                    </button>
                    <button type="button" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900" data-status="checked">
                        <i class="fa-solid fa-circle-check text-emerald-500 mr-1 text-3xs"></i> Checked <span id="countChecked" class="ml-1 px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 text-3xs font-mono">0</span>
                    </button>
                    <button type="button" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900" data-status="unchecked">
                        <i class="fa-regular fa-circle text-slate-400 mr-1 text-3xs"></i> Unchecked <span id="countUnchecked" class="ml-1 px-1.5 py-0.2 rounded-md bg-slate-100 text-slate-700 text-3xs font-mono">0</span>
                    </button>
                </div>
            </div>

            <!-- Group Expansion & Save Actions -->
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" id="toggleAllGroupsBtn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-up-right-and-down-left-from-center text-3xs"></i> <span id="toggleAllGroupsText">Collapse All</span>
                </button>
                <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors shrink-0">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </div>

        <div class="p-6">
            @if (!groupedPermissions.Any())
            {
                <partial name="UiComponents/_EmptyState" model='new AzureTest.MVC.Models.EmptyStateModel { Title = "No Permissions Available", Description = "No synced endpoints found in the system catalog.", Icon = "fa-solid fa-shield-halved", ActionText = "Sync Endpoints", ActionUrl = "/Permission/Index" }' />
            }

            <!-- Empty State for Filter/Search Mismatch -->
            <div id="noFilterResults" style="display:none;" class="p-10 text-center bg-slate-50/60 rounded-2xl border border-dashed border-slate-200 mb-4">
                <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center mx-auto mb-3 text-base shadow-2xs">
                    <i class="fa-solid fa-filter-circle-xmark text-brand-600"></i>
                </div>
                <h4 class="text-xs font-bold text-slate-800">No matching permissions found</h4>
                <p class="text-2xs text-slate-500 mt-1 max-w-sm mx-auto">No endpoints match your current search query and checked/unchecked filter.</p>
                <button type="button" id="resetFiltersBtn" class="mt-3.5 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-colors shadow-2xs">
                    <i class="fa-solid fa-rotate-left text-3xs"></i> Reset Filters
                </button>
            </div>

            <div class="space-y-6" id="permissionGroupsContainer">
                @foreach (var group in groupedPermissions)
                {
                    var safeGroupSlug = (string.IsNullOrEmpty(group.Key.Area) ? "" : $"{group.Key.Area}-") + group.Key.Controller;
                    safeGroupSlug = System.Text.RegularExpressions.Regex.Replace(safeGroupSlug, @"[^a-zA-Z0-9_\-]", "_");

                    <div class="border border-slate-200/80 rounded-2xl overflow-hidden perm-group shadow-2xs" data-group-slug="@safeGroupSlug">
                        <div class="bg-slate-50/80 px-5 py-3.5 border-b border-slate-200/80 flex justify-between items-center cursor-pointer group-header select-none">
                            <h4 class="font-bold text-xs text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-chevron-down transition-transform duration-200 group-chevron text-slate-400 text-3xs"></i>
                                <span class="w-6 h-6 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-500 text-2xs">
                                    <i class="fa-solid fa-layer-group"></i>
                                </span>
                                <span>@group.Key.Controller Controller</span>
                                @if (!string.IsNullOrEmpty(group.Key.Area))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-3xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80">
                                        <i class="fa-solid fa-box text-3xs"></i> Area: @group.Key.Area
                                    </span>
                                }
                                <span class="group-count-badge inline-flex items-center px-2 py-0.5 rounded-full text-3xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                    0/@group.Count()
                                </span>
                            </h4>
                            <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-semibold text-brand-600 hover:text-brand-800" onclick="event.stopPropagation();">
                                <input type="checkbox" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300 transition-colors toggle-group" data-group="@safeGroupSlug" />
                                <span>Select All</span>
                            </label>
                        </div>
                        <div class="divide-y divide-slate-100 group-body bg-white">
                            @foreach (var perm in group)
                            {
                                var endpointUrl = (!string.IsNullOrWhiteSpace(perm.AreaName) ? $"/{perm.AreaName}" : "") + $"/{perm.ControllerName}/{perm.ActionName}";

                                <label class="px-5 py-3.5 flex items-start hover:bg-slate-50/70 transition-colors cursor-pointer perm-item"
                                       data-title="@(perm.DisplayName?.ToLowerInvariant() ?? "")"
                                       data-description="@(perm.Description?.ToLowerInvariant() ?? "")"
                                       data-url="@endpointUrl.ToLowerInvariant()"
                                       data-area="@(perm.AreaName?.ToLowerInvariant() ?? "")"
                                       data-controller="@perm.ControllerName.ToLowerInvariant()"
                                       data-action="@perm.ActionName.ToLowerInvariant()">
                                    <div class="flex-shrink-0 mr-3.5 mt-0.5">
                                        <input type="checkbox" name="selectedPermissions" value="@perm.PermissionId" checked="@perm.IsAssigned" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300 transition-colors perm-checkbox group-cb-@safeGroupSlug" />
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="text-xs font-bold text-slate-800">@perm.DisplayName</span>
                                            @if (!string.IsNullOrEmpty(perm.AreaName))
                                            {
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-3xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80">
                                                    @perm.AreaName
                                                </span>
                                            }
                                            @if (!perm.IsRestricted)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-3xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                                    <i class="fa-solid fa-lock-open text-3xs"></i> Unrestricted
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(perm.Description))
                                        {
                                            <div class="text-2xs text-slate-500 mt-0.5">@perm.Description</div>
                                        }
                                        <div class="text-3xs font-mono text-slate-400 mt-1 flex items-center gap-1.5 flex-wrap">
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-50 text-slate-600 border border-slate-200/70">
                                                <i class="fa-solid fa-link text-3xs text-slate-400"></i>
                                                <span class="text-brand-700 font-semibold">@endpointUrl</span>
                                            </span>
                                            <span class="text-slate-400">(@perm.ControllerName / @perm.ActionName)</span>
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Footer Bar -->
        <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="text-xs text-slate-500">
                Showing <strong class="text-slate-800 font-mono" id="footerVisibleCount">0</strong> of <strong class="text-slate-800 font-mono">@Model.Permissions.Count</strong> endpoints (<strong class="text-brand-700 font-mono" id="footerCheckedCount">0</strong> assigned)
            </div>
            <div class="flex items-center gap-2">
                <button type="button" id="scrollTopBtn" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-arrow-up"></i> Back to Top
                </button>
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        // State
        let currentStatusFilter = 'all'; // 'all' | 'checked' | 'unchecked'
        let allGroupsCollapsed = false;

        function updateCounts() {
            let totalAll = 0;
            let totalChecked = 0;
            let totalUnchecked = 0;
            let visibleCount = 0;

            const allItems = document.querySelectorAll('.perm-item');
            allItems.forEach(item => {
                totalAll++;
                const cb = item.querySelector('.perm-checkbox');
                if (cb && cb.checked) {
                    totalChecked++;
                } else {
                    totalUnchecked++;
                }
                if (item.style.display !== 'none') {
                    visibleCount++;
                }
            });

            const countAllEl = document.getElementById('countAll');
            const countCheckedEl = document.getElementById('countChecked');
            const countUncheckedEl = document.getElementById('countUnchecked');
            const footerVisibleCountEl = document.getElementById('footerVisibleCount');
            const footerCheckedCountEl = document.getElementById('footerCheckedCount');

            if (countAllEl) countAllEl.innerText = totalAll;
            if (countCheckedEl) countCheckedEl.innerText = totalChecked;
            if (countUncheckedEl) countUncheckedEl.innerText = totalUnchecked;
            if (footerVisibleCountEl) footerVisibleCountEl.innerText = visibleCount;
            if (footerCheckedCountEl) footerCheckedCountEl.innerText = totalChecked;

            // Update each group's check-all box & badge
            document.querySelectorAll('.perm-group').forEach(group => {
                const groupCbs = group.querySelectorAll('.perm-item .perm-checkbox');
                const checkedInGroup = Array.from(groupCbs).filter(cb => cb.checked).length;
                const totalInGroup = groupCbs.length;

                const countBadge = group.querySelector('.group-count-badge');
                if (countBadge) {
                    countBadge.innerText = `${checkedInGroup}/${totalInGroup}`;
                    if (checkedInGroup === totalInGroup && totalInGroup > 0) {
                        countBadge.className = 'group-count-badge inline-flex items-center px-2 py-0.5 rounded-full text-3xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
                    } else if (checkedInGroup > 0) {
                        countBadge.className = 'group-count-badge inline-flex items-center px-2 py-0.5 rounded-full text-3xs font-bold bg-brand-50 text-brand-700 border border-brand-200';
                    } else {
                        countBadge.className = 'group-count-badge inline-flex items-center px-2 py-0.5 rounded-full text-3xs font-bold bg-slate-100 text-slate-500 border border-slate-200';
                    }
                }

                const toggler = group.querySelector('.toggle-group');
                if (toggler) {
                    toggler.checked = checkedInGroup === totalInGroup && totalInGroup > 0;
                    toggler.indeterminate = checkedInGroup > 0 && checkedInGroup < totalInGroup;
                }
            });
        }

        function applyFilters() {
            const searchInput = document.getElementById('permissionSearch');
            const rawSearch = (searchInput ? searchInput.value : '').toLowerCase().trim();
            const searchTokens = rawSearch.split(/\s+/).filter(t => t.length > 0);
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) {
                clearBtn.style.display = rawSearch.length > 0 ? '' : 'none';
            }

            let anyGroupVisible = false;

            document.querySelectorAll('.perm-group').forEach(group => {
                let visibleInGroup = 0;
                const items = group.querySelectorAll('.perm-item');

                items.forEach(item => {
                    const cb = item.querySelector('.perm-checkbox');
                    const isChecked = cb && cb.checked;

                    // 1. Status filter (all, checked, unchecked)
                    let matchesStatus = true;
                    if (currentStatusFilter === 'checked') {
                        matchesStatus = isChecked;
                    } else if (currentStatusFilter === 'unchecked') {
                        matchesStatus = !isChecked;
                    }

                    // 2. Search filter across title, description, URL, controller, action, area
                    let matchesSearch = true;
                    if (searchTokens.length > 0) {
                        const title = item.dataset.title || '';
                        const desc = item.dataset.description || '';
                        const url = item.dataset.url || '';
                        const controller = item.dataset.controller || '';
                        const action = item.dataset.action || '';
                        const area = item.dataset.area || '';
                        const fullText = (title + ' ' + desc + ' ' + url + ' ' + controller + ' ' + action + ' ' + area).toLowerCase();

                        matchesSearch = searchTokens.every(token => {
                            const normalizedToken = token.startsWith('/') ? token : '/' + token;
                            return fullText.includes(token) || url.includes(token) || url.includes(normalizedToken);
                        });
                    }

                    if (matchesStatus && matchesSearch) {
                        item.style.display = '';
                        visibleInGroup++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                const body = group.querySelector('.group-body');
                const chevron = group.querySelector('.group-chevron');

                if (visibleInGroup > 0) {
                    group.style.display = '';
                    anyGroupVisible = true;
                    if (searchTokens.length > 0 || currentStatusFilter !== 'all') {
                        body.style.display = '';
                        if (chevron) chevron.classList.remove('-rotate-90');
                    }
                } else {
                    group.style.display = 'none';
                }
            });

            const noResultsEl = document.getElementById('noFilterResults');
            if (noResultsEl) {
                noResultsEl.style.display = anyGroupVisible ? 'none' : '';
            }

            updateCounts();
        }

        // Initialize Filter Buttons
        document.querySelectorAll('.status-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                currentStatusFilter = this.dataset.status;
                
                // Update active button styling
                document.querySelectorAll('.status-filter-btn').forEach(b => {
                    b.classList.remove('bg-slate-900', 'text-white', 'shadow-2xs');
                    b.classList.add('text-slate-600', 'hover:text-slate-900');
                    const badge = b.querySelector('span');
                    if (badge) {
                        if (b.dataset.status === 'checked') {
                            badge.className = 'ml-1 px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 text-3xs font-mono';
                        } else {
                            badge.className = 'ml-1 px-1.5 py-0.2 rounded-md bg-slate-100 text-slate-700 text-3xs font-mono';
                        }
                    }
                });

                this.classList.remove('text-slate-600', 'hover:text-slate-900');
                this.classList.add('bg-slate-900', 'text-white', 'shadow-2xs');
                const activeBadge = this.querySelector('span');
                if (activeBadge) {
                    activeBadge.className = 'ml-1 px-1.5 py-0.2 rounded-md bg-white/20 text-3xs font-mono';
                }

                applyFilters();
            });
        });

        // Search Input Listener
        const searchInput = document.getElementById('permissionSearch');
        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }

        // Clear Search Button
        const clearSearchBtn = document.getElementById('clearSearchBtn');
        if (clearSearchBtn) {
            clearSearchBtn.addEventListener('click', function() {
                if (searchInput) {
                    searchInput.value = '';
                    applyFilters();
                    searchInput.focus();
                }
            });
        }

        // Reset Filters Button
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');
        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', function() {
                if (searchInput) searchInput.value = '';
                const allBtn = document.querySelector('.status-filter-btn[data-status="all"]');
                if (allBtn) allBtn.click();
            });
        }

        // Toggle Group Checkboxes
        document.querySelectorAll('.toggle-group').forEach(toggler => {
            toggler.addEventListener('change', function() {
                const groupSlug = this.dataset.group;
                const isChecked = this.checked;
                // Only select checkboxes that belong to this group
                document.querySelectorAll('.group-cb-' + groupSlug).forEach(cb => {
                    cb.checked = isChecked;
                });
                updateCounts();
                if (currentStatusFilter !== 'all') {
                    applyFilters();
                }
            });
        });

        // Checkbox individual change
        document.querySelectorAll('.perm-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
                updateCounts();
                if (currentStatusFilter !== 'all') {
                    applyFilters();
                }
            });
        });

        // Collapsible groups
        document.querySelectorAll('.group-header').forEach(header => {
            header.addEventListener('click', function(e) {
                // If clicked on the toggle checkbox or its label, don't collapse
                if (e.target.closest('.toggle-group') || e.target.tagName === 'INPUT') return;

                const body = this.nextElementSibling;
                const chevron = this.querySelector('.group-chevron');
                if (body.style.display === 'none') {
                    body.style.display = '';
                    chevron.classList.remove('-rotate-90');
                } else {
                    body.style.display = 'none';
                    chevron.classList.add('-rotate-90');
                }
            });
        });

        // Toggle All Groups (Expand / Collapse)
        const toggleAllGroupsBtn = document.getElementById('toggleAllGroupsBtn');
        const toggleAllGroupsText = document.getElementById('toggleAllGroupsText');
        if (toggleAllGroupsBtn) {
            toggleAllGroupsBtn.addEventListener('click', function() {
                allGroupsCollapsed = !allGroupsCollapsed;
                document.querySelectorAll('.perm-group').forEach(group => {
                    const body = group.querySelector('.group-body');
                    const chevron = group.querySelector('.group-chevron');
                    if (body) {
                        body.style.display = allGroupsCollapsed ? 'none' : '';
                    }
                    if (chevron) {
                        if (allGroupsCollapsed) {
                            chevron.classList.add('-rotate-90');
                        } else {
                            chevron.classList.remove('-rotate-90');
                        }
                    }
                });
                if (toggleAllGroupsText) {
                    toggleAllGroupsText.innerText = allGroupsCollapsed ? 'Expand All' : 'Collapse All';
                }
            });
        }

        // Scroll to top
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        if (scrollTopBtn) {
            scrollTopBtn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // Initial counts on page load
        updateCounts();
    </script>
}
