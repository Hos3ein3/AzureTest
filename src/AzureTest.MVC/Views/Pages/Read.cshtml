@model AzureTest.Contracts.DTOs.Pages.PageDto
@using System.Security.Claims
@using AzureTest.MVC.Models
@{
    ViewData["Title"] = Model.Title;
    var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var userId = !string.IsNullOrEmpty(userIdString) ? Guid.Parse(userIdString) : Guid.Empty;

    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Pages", Url.Action("Index"), "fa-regular fa-file-lines"),
        new BreadcrumbItem(Model.Title, null, "fa-regular fa-file", true)
    };
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-4xl space-y-8">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />

    <!-- Header / Cover Image -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="w-full h-72 md:h-96 rounded-3xl overflow-hidden shadow-sm relative bg-slate-100 border border-slate-200/80">
            <img src="@Model.ImagePath" alt="@Model.Title" class="w-full h-full object-cover">
        </div>
    }

    <div class="text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">@Model.Title</h1>
        <div class="flex items-center justify-center gap-4 text-xs font-semibold text-slate-500">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 rounded-full">
                <i class="fa-regular fa-calendar text-slate-400"></i> Published
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 rounded-full">
                <i class="fa-regular fa-comments text-slate-400"></i> @(Model.Comments?.Count ?? 0) Comments
            </span>
        </div>
    </div>

    <!-- Content -->
    <article class="prose prose-slate prose-lg max-w-none bg-white p-6 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
        @Html.Raw(Model.Content)
    </article>

    <!-- Interactions -->
    <div class="flex items-center justify-center gap-6 py-6 bg-white rounded-2xl border border-slate-200/80 shadow-sm">
        <form method="post" action="@Url.Action("ToggleLike", new { id = Model.Id })">
            <button type="submit" class="group flex flex-col items-center gap-2 transition-transform hover:scale-105">
                <div class="w-12 h-12 rounded-2xl flex items-center justify-center shadow-sm transition-colors @(Model.LikedBy.Contains(userId) ? "bg-brand-600 text-white shadow-brand-500/20" : "bg-slate-50 text-slate-500 border border-slate-200 group-hover:border-brand-500 group-hover:text-brand-600")">
                    <i class="fa-solid fa-thumbs-up text-base"></i>
                </div>
                <span class="text-xs font-bold @(Model.LikedBy.Contains(userId) ? "text-brand-600" : "text-slate-600")">@Model.LikedBy.Count Likes</span>
            </button>
        </form>
        <form method="post" action="@Url.Action("ToggleDislike", new { id = Model.Id })">
            <button type="submit" class="group flex flex-col items-center gap-2 transition-transform hover:scale-105">
                <div class="w-12 h-12 rounded-2xl flex items-center justify-center shadow-sm transition-colors @(Model.DislikedBy.Contains(userId) ? "bg-rose-600 text-white shadow-rose-500/20" : "bg-slate-50 text-slate-500 border border-slate-200 group-hover:border-rose-500 group-hover:text-rose-600")">
                    <i class="fa-solid fa-thumbs-down text-base"></i>
                </div>
                <span class="text-xs font-bold @(Model.DislikedBy.Contains(userId) ? "text-rose-600" : "text-slate-600")">@Model.DislikedBy.Count Dislikes</span>
            </button>
        </form>
    </div>

    <!-- Comments Section -->
    <section class="space-y-6">
        <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <i class="fa-regular fa-comments text-brand-600"></i> Discussion
                <span class="bg-brand-50 text-brand-700 border border-brand-200 text-xs font-bold py-0.5 px-2.5 rounded-full">
                    @(Model.Comments?.Count ?? 0)
                </span>
            </h3>
        </div>

        <form method="post" action="@Url.Action("AddComment", new { id = Model.Id })"
              class="flex gap-3 bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm focus-within:ring-2 focus-within:ring-brand-500/20 focus-within:border-brand-500 transition-all">
            <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold shrink-0">
                <i class="fa-regular fa-user"></i>
            </div>
            <input type="text" name="content" required placeholder="Share your perspective..."
                   class="flex-1 bg-transparent border-none px-2 py-2 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-0">
            <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white px-5 py-2 rounded-xl text-xs font-semibold shadow-sm hover:shadow transition">
                Post Comment
            </button>
        </form>

        <div class="space-y-4">
            @if (Model.Comments != null && Model.Comments.Any())
            {
                @foreach (var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
                        <div class="flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center text-xs font-bold uppercase">
                                    @(c.UserName?.Length > 0 ? c.UserName.Substring(0, 1) : "U")
                                </div>
                                <span class="font-bold text-sm text-slate-900">@c.UserName</span>
                            </div>
                            <span class="text-xs font-semibold text-slate-400">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <p class="text-sm text-slate-700 leading-relaxed pl-11">@c.Content</p>

                        @if (!string.IsNullOrEmpty(c.AdminReply))
                        {
                            <div class="ml-11 bg-brand-50/60 p-4 rounded-xl border border-brand-100 space-y-1.5">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-shield-halved text-brand-600 text-xs"></i>
                                    <span class="text-xs font-bold text-brand-800 uppercase tracking-wider">Admin Response</span>
                                    <span class="text-[11px] text-slate-400 ml-auto">@c.AdminReplyAt?.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <p class="text-xs text-slate-700 leading-relaxed">@c.AdminReply</p>
                            </div>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <form method="post" action="@Url.Action("AnswerComment", new { id = Model.Id, commentId = c.Id })" class="mt-3 ml-11 flex gap-2">
                                <input type="text" name="reply" placeholder="Reply as administrator..."
                                       class="flex-1 text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
                                <button type="submit" class="bg-brand-600 text-white px-4 py-2 rounded-xl text-xs font-semibold hover:bg-brand-700 shadow-sm transition">
                                    Reply
                                </button>
                            </form>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8 rounded-2xl bg-white border border-slate-200/80 shadow-sm">
                    <i class="fa-regular fa-comment-dots text-3xl text-slate-300 mb-2 block"></i>
                    <p class="text-xs text-slate-500 font-medium">No comments yet. Start the conversation!</p>
                </div>
            }
        </div>
    </section>
</div>
