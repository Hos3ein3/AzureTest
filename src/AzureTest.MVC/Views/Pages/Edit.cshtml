@model AzureTest.Contracts.DTOs.Pages.UpdatePageDto
<div class="p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">Edit Page</h1>
    <div asp-validation-summary="All" class="text-red-500 mb-4 bg-red-500/10 p-4 rounded-lg"></div>
    <form method="post" class="space-y-4">
        <input type="hidden" asp-for="Id" />
        <div><label class="block text-sm font-medium mb-1">Title</label><input asp-for="Title" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white"></div>
        <div><label class="block text-sm font-medium mb-1">Slug</label><input asp-for="Slug" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white text-sm"></div>
        <div><label class="block text-sm font-medium mb-1">Image Path</label><input asp-for="ImagePath" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white text-sm"></div>
        <div><label class="block text-sm font-medium mb-1">Status</label>
            <select asp-for="Status" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white">
                <option value="Pending">Pending</option>
                <option value="Published">Published</option>
                <option value="Archived">Archived</option>
            </select>
        </div>
        <div><label class="block text-sm font-medium mb-1">Content</label><textarea asp-for="Content" class="tinymce w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white h-64"></textarea></div>
        <button type="submit" class="bg-brand-500 text-white px-6 py-2 rounded-lg hover:bg-brand-600">Save</button>
    </form>
</div>
@section Scripts {
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"></script>
    <script>tinymce.init({ selector: '.tinymce', skin: 'oxide-dark', content_css: 'dark' });</script>
}
