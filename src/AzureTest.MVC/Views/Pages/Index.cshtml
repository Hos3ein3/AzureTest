@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Pages.PageDto>

<div class="p-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Manage Pages</h1>
        <a href="@Url.Action("Create")" class="bg-brand-500 text-white px-4 py-2 rounded-lg hover:bg-brand-600 transition-colors">Create Page</a>
    </div>

    <form method="get" class="mb-6 flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="Search pages..." class="bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white flex-1 focus:outline-none focus:border-brand-500">
        <button type="submit" class="bg-slate-700 text-white px-4 py-2 rounded-lg hover:bg-slate-600">Search</button>
    </form>

    <div class="bg-slate-800 rounded-xl overflow-hidden border border-slate-700">
        <table class="w-full text-left text-sm text-slate-300">
            <thead class="bg-slate-900/50 text-xs uppercase font-semibold text-slate-400">
                <tr>
                    <th class="px-6 py-4">Title</th>
                    <th class="px-6 py-4">Slug</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-700/50">
                @foreach (var p in Model.Items)
                {
                    <tr class="hover:bg-slate-700/30 transition-colors">
                        <td class="px-6 py-4 font-medium text-white">@p.Title</td>
                        <td class="px-6 py-4 text-brand-400">@p.Slug</td>
                        <td class="px-6 py-4">
                            @if(p.Status == AzureTest.Domain.Enums.PageStatus.Published) { <span class="bg-green-500/20 text-green-400 px-2 py-1 rounded text-xs">Published</span> }
                            else { <span class="bg-yellow-500/20 text-yellow-400 px-2 py-1 rounded text-xs">@p.Status</span> }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <a href="@Url.Action("Read", new { slug = p.Slug })" class="text-blue-400 hover:text-blue-300 mr-3" target="_blank"><i class="fa-solid fa-eye"></i> View</a>
                            <a href="@Url.Action("Edit", new { id = p.Id })" class="text-brand-400 hover:text-brand-300 mr-3"><i class="fa-solid fa-pen"></i> Edit</a>
                            <form method="post" action="@Url.Action("Delete", new { id = p.Id })" class="inline" onsubmit="return confirm('Delete this page?');">
                                <button type="submit" class="text-red-400 hover:text-red-300"><i class="fa-solid fa-trash"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination could go here -->
</div>
