@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Pages.PageDto>
@{
    ViewData["Title"] = "Manage Pages";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Manage Pages</h1>
    <div class="flex items-center space-x-4">
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add New
        </a>
    </div>
</div>

<div class="mb-6 bg-white p-5 rounded-xl shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-800">Filter Pages</h3>
    </div>
    <form method="get" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search pages..." class="block w-full px-3 py-2 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <div>
            <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-transparent bg-slate-800 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2 transition-colors">
                Search
            </button>
            <a asp-action="Index" class="ml-2 inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                Clear
            </a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500">
                <tr>
                    <th scope="col" class="px-6 py-4 font-semibold">Title</th>
                    <th scope="col" class="px-6 py-4 font-semibold">Slug</th>
                    <th scope="col" class="px-6 py-4 font-semibold">Status</th>
                    <th scope="col" class="px-6 py-4 font-semibold text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var p in Model.Items)
                {
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-800">
                            @p.Title
                        </td>
                        <td class="px-6 py-4 text-slate-500 font-mono text-xs">
                            /Page/@p.Slug
                        </td>
                        <td class="px-6 py-4">
                            @if(p.Status == AzureTest.Domain.Enums.PageStatus.Published) { 
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-emerald-100 text-emerald-700">Published</span>
                            } else { 
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-amber-100 text-amber-700">@p.Status</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right space-x-3">
                            <a href="@Url.Action("Read", new { slug = p.Slug })" class="text-blue-600 hover:text-blue-800 font-medium" target="_blank">
                                View
                            </a>
                            <a href="@Url.Action("Edit", new { id = p.Id })" class="text-brand-600 hover:text-brand-800 font-medium">
                                Edit
                            </a>
                            <form method="post" action="@Url.Action("Delete", new { id = p.Id })" class="inline" onsubmit="return confirm('Delete this page?');">
                                <button type="submit" class="text-red-600 hover:text-red-800 font-medium">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-500">
                            <i class="fa-regular fa-file-lines text-4xl mb-3 text-slate-300 block"></i>
                            <p class="text-base font-medium text-slate-900">No pages found</p>
                            <p class="mt-1">Get started by creating a new page.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
