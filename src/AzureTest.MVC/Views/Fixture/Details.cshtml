@model AzureTest.Contracts.DTOs.FootballFantasy.FixtureDto
@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<div class="max-w-4xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Fixtures</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">Match Details</span>
    </div>
</div>

<!-- Scoreboard Banner -->
<div class="max-w-4xl mx-auto bg-gradient-to-r from-slate-900 to-slate-800 text-white p-8 rounded-3xl shadow-xl mb-6">
    <div class="text-center text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">
        @(Model.Round ?? "Matchday") &bull; @Model.KickoffAt.ToString("f") &bull; @(Model.Venue ?? "Venue TBD")
    </div>
    
    <div class="flex items-center justify-around py-4">
        <div class="text-center flex-1">
            @if (!string.IsNullOrWhiteSpace(Model.HomeTeamLogo))
            {
                <img src="@Model.HomeTeamLogo" class="w-16 h-16 mx-auto object-contain mb-2" alt="@Model.HomeTeamName" />
            }
            <div class="text-xl font-black">@Model.HomeTeamName</div>
            <div class="text-xs text-slate-400">Home</div>
        </div>

        <div class="text-center px-6">
            <div class="text-4xl font-black tracking-widest text-emerald-400">
                @(Model.HomeScore.HasValue ? Model.HomeScore.Value.ToString() : "-") : @(Model.AwayScore.HasValue ? Model.AwayScore.Value.ToString() : "-")
            </div>
            <span class="inline-flex mt-2 items-center px-3 py-1 rounded-full text-xs font-bold @(Model.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Finished ? "bg-slate-700 text-slate-300" : "bg-emerald-500/20 text-emerald-400 border border-emerald-500/40")">
                @Model.Status @(Model.Minute.HasValue ? $"({Model.Minute}')" : "")
            </span>
        </div>

        <div class="text-center flex-1">
            @if (!string.IsNullOrWhiteSpace(Model.AwayTeamLogo))
            {
                <img src="@Model.AwayTeamLogo" class="w-16 h-16 mx-auto object-contain mb-2" alt="@Model.AwayTeamName" />
            }
            <div class="text-xl font-black">@Model.AwayTeamName</div>
            <div class="text-xs text-slate-400">Away</div>
        </div>
    </div>
</div>

<!-- Score Update Panel -->
<div class="max-w-4xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Update Match Result & Score</h3>
    <form asp-action="UpdateScore" method="post" class="grid grid-cols-1 sm:grid-cols-4 gap-4 items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Home Score</label>
            <input type="number" name="HomeScore" value="@(Model.HomeScore ?? 0)" min="0" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Away Score</label>
            <input type="number" name="AwayScore" value="@(Model.AwayScore ?? 0)" min="0" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
        </div>

        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Status</label>
            <select name="Status" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3">
                <option value="1" selected="@(Model.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Scheduled)">Scheduled</option>
                <option value="2" selected="@(Model.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Live)">Live</option>
                <option value="4" selected="@(Model.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Finished)">Finished</option>
                <option value="5" selected="@(Model.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Postponed)">Postponed</option>
            </select>
        </div>

        <div>
            <button type="submit" class="w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg shadow-sm">Save Score</button>
        </div>
    </form>
</div>
