@model AzureTest.MVC.Models.EmptyStateModel

@if (Model != null)
{
    <div class="p-12 text-center bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-xl">
            <i class="@(string.IsNullOrWhiteSpace(Model.Icon) ? "fa-solid fa-inbox" : Model.Icon)"></i>
        </div>
        <h4 class="text-sm font-bold text-slate-800">@Model.Title</h4>
        <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
        {
            <div class="mt-4">
                <a href="@Model.ActionUrl" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white shadow-2xs transition-colors">
                    <i class="@(string.IsNullOrWhiteSpace(Model.ActionIcon) ? "fa-solid fa-plus" : Model.ActionIcon) text-2xs"></i>
                    <span>@Model.ActionText</span>
                </a>
            </div>
        }
    </div>
}
