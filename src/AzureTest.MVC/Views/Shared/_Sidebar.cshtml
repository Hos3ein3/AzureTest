                    <a asp-area="" asp-controller="Media" asp-action="Lists" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Media" && (currentAction == "Lists" || currentAction == "ListDetails") ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Playlists">
                        <i class="fa-solid fa-list-ul text-base"></i>
                    </a>
                    <a asp-area="" asp-controller="Media" asp-action="Stats" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Media" && currentAction == "Stats" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Watch Stats">
                        <i class="fa-solid fa-chart-simple text-base"></i>
                    </a>
                </div>

                <!-- Sub-Section: System -->
                <div id="subSection_system" class="floating-sub-content hidden flex items-center gap-1.5 flex-1 overflow-x-auto overflow-y-hidden scrollbar-hide">
                    @if (_CurrentUser.HasAccess("User/Index"))
                    {
                        <a asp-area="" asp-controller="User" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "User" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="User Management">
                            <i class="fa-solid fa-users text-base"></i>
                        </a>
                    }
                    @if (_CurrentUser.HasAccess("Role/Index"))
                    {
                        <a asp-area="" asp-controller="Role" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Role" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Roles & Permissions">
                            <i class="fa-solid fa-user-shield text-base"></i>
                        </a>
                    }
                    @if (_CurrentUser.HasAccess("IdentitySetting/Edit"))
                    {
                        <a asp-area="" asp-controller="IdentitySetting" asp-action="Edit" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "IdentitySetting" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Identity Setting">
                            <i class="fa-solid fa-gears text-base"></i>
                        </a>
                    }
                    @if (_CurrentUser.HasAccess("Permissions/Index"))
                    {
                        <a asp-area="" asp-controller="Permission" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Permission" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Permissions">
                            <i class="fa-solid fa-user-lock text-base"></i>
                        </a>
                    }
                    @if (_CurrentUser.HasAccess("FileExplorer/Index"))
                    {
                        <a asp-area="" asp-controller="FileExplorer" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "FileExplorer" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="File Explorer">
                            <i class="fa-solid fa-folder-tree text-base"></i>
                        </a>
                    }
                    @if (_CurrentUser.HasAccess("Component/Index"))
                    {
                        <a asp-area="" asp-controller="Component" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Component" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Components">
                            <i class="fa-solid fa-cubes text-base"></i>
                        </a>
                    }
                    <a asp-area="" asp-controller="Icon" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Icon" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Icon Gallery">
                        <i class="fa-solid fa-icons text-base"></i>
                    </a>
                    <a asp-area="" asp-controller="UiComponents" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "UiComponents" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="UI Components">
                        <i class="fa-solid fa-shapes text-base"></i>
                    </a>
                    <a asp-area="" asp-controller="AuditLog" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "AuditLog" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Audit Trail">
                        <i class="fa-solid fa-clock-rotate-left text-base"></i>
                    </a>
                    @if (_CurrentUser?.IsAdmin == true)
                    {
                        <a asp-area="" asp-controller="Tenant" asp-action="Index" class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center @(currentController == "Tenant" ? "bg-brand-500 text-white shadow-xs" : "text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800") transition-all" title="Tenant Management">
                            <i class="fa-solid fa-building-user text-base"></i>
                        </a>
                    }
                </div>

            </div>

            <!-- Tiny red scroll right indicator icon -->
            <button type="button" id="floatingSubScrollRightBtn" onclick="scrollActiveFloatingSub(80)"
                    class="hidden flex-shrink-0 text-red-500 hover:text-red-600 font-bold text-xs animate-pulse select-none px-1.5 py-1 focus:outline-none"
                    title="Scroll right" aria-label="Scroll right"><i class="fa-solid fa-angles-right"></i></button>
        </div>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.getElementById("sidebar");
        const desktopToggle = document.getElementById("sidebarToggleDesktop");
        const mobileMenuBtn = document.getElementById("mobileMenuBtn");
        const mobileCloseBtn = document.getElementById("sidebarToggleMobileClose");
        const mobileOverlay = document.getElementById("mobileSidebarOverlay");

        // Desktop Toggle Logic
        if (localStorage.getItem('sidebarCollapsed') === 'true' && window.innerWidth >= 768) {
            sidebar?.classList.add("collapsed");
        }

        desktopToggle?.addEventListener("click", function () {
            sidebar?.classList.toggle("collapsed");
            localStorage.setItem('sidebarCollapsed', sidebar?.classList.contains("collapsed"));
        });

        // Mobile / Tablet Drawer Toggle Logic
        function openMobileSidebar() {
            if (!sidebar || !mobileOverlay) return;
            sidebar.classList.remove("-translate-x-full");
            mobileOverlay.classList.remove("pointer-events-none");
            mobileOverlay.classList.add("active");
            setTimeout(() => mobileOverlay.classList.add("opacity-100"), 10);
        }

        function closeMobileSidebar() {
            if (!sidebar || !mobileOverlay) return;
            sidebar.classList.add("-translate-x-full");
            mobileOverlay.classList.remove("opacity-100");
            setTimeout(() => {
                mobileOverlay.classList.remove("active");
                mobileOverlay.classList.add("pointer-events-none");
            }, 300);
        }

        window.openMobileSidebar = openMobileSidebar;
        window.closeMobileSidebar = closeMobileSidebar;

        mobileMenuBtn?.addEventListener("click", openMobileSidebar);
        mobileCloseBtn?.addEventListener("click", closeMobileSidebar);
        mobileOverlay?.addEventListener("click", closeMobileSidebar);

        // Floating Bottom Navigation Interaction Logic
        window.scrollActiveFloatingSub = function (delta) {
            const activeSub = document.querySelector(".floating-sub-content:not(.hidden)");
            if (activeSub) {
                activeSub.scrollBy({ left: delta, behavior: "smooth" });
                setTimeout(() => updateFloatingSubScrollIndicators(activeSub), 200);
            }
        };

        function updateFloatingSubScrollIndicators(container) {
            const leftBtn = document.getElementById("floatingSubScrollLeftBtn");
            const rightBtn = document.getElementById("floatingSubScrollRightBtn");
            if (!container || !leftBtn || !rightBtn) return;
            const canLeft = container.scrollLeft > 4;
            const canRight = (container.scrollWidth - container.clientWidth - container.scrollLeft) > 4;
            leftBtn.classList.toggle("hidden", !canLeft);
            rightBtn.classList.toggle("hidden", !canRight);
        }
        window.updateFloatingSubScrollIndicators = updateFloatingSubScrollIndicators;

        window.openFloatingSection = function (sectionKey) {
            const mainNav = document.getElementById("floatingNavMain");
            const subNav = document.getElementById("floatingNavSub");
            if (!mainNav || !subNav) return;

            document.querySelectorAll(".floating-sub-content").forEach(el => el.classList.add("hidden"));
            const target = document.getElementById("subSection_" + sectionKey);
            if (target) {
                target.classList.remove("hidden");
            }

            mainNav.classList.remove("translate-y-0", "opacity-100");
            mainNav.classList.add("translate-y-20", "opacity-0", "pointer-events-none");

            setTimeout(() => {
                mainNav.classList.add("hidden");
                subNav.classList.remove("hidden");
                subNav.classList.add("flex");
                requestAnimationFrame(() => {
                    subNav.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
                    subNav.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
                    if (target) {
                        target.scrollLeft = 0;
                        updateFloatingSubScrollIndicators(target);
                        if (!target.dataset.scrollBound) {
                            target.addEventListener("scroll", () => updateFloatingSubScrollIndicators(target), { passive: true });
                            target.dataset.scrollBound = "true";
                        }
                    }
                });
            }, 120);
        };

        window.closeFloatingSubNav = function () {
            const mainNav = document.getElementById("floatingNavMain");
            const subNav = document.getElementById("floatingNavSub");
            if (!mainNav || !subNav) return;

            subNav.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
            subNav.classList.add("translate-y-20", "opacity-0", "pointer-events-none");

            setTimeout(() => {
                subNav.classList.add("hidden");
                subNav.classList.remove("flex");
                mainNav.classList.remove("hidden");
                requestAnimationFrame(() => {
                    mainNav.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
                    mainNav.classList.add("translate-y-0", "opacity-100");
                });
            }, 120);
        };

        // Scroll Hide/Show Behavior for Floating Nav
        let lastScrollY = 0;
        let isScrollTicking = false;

        function updateFloatingNavOnScroll(currentY) {
            const bottomNav = document.getElementById("floatingBottomNavWrapper");
            const topOmnibar = document.getElementById("floatingOmnibarWrapper");

            if (currentY <= 20) {
                bottomNav?.classList.remove("translate-y-28", "opacity-0", "pointer-events-none");
                topOmnibar?.classList.remove("-translate-y-20", "opacity-0", "pointer-events-none");
                lastScrollY = currentY;
                return;
            }

            const diff = currentY - lastScrollY;
            if (Math.abs(diff) < 8) return;

            if (diff > 0 && currentY > 50) {
                // Scrolling down -> bottom nav goes down and disappears, top omnibar search box goes up and disappears
                bottomNav?.classList.add("translate-y-28", "opacity-0", "pointer-events-none");
                topOmnibar?.classList.add("-translate-y-20", "opacity-0", "pointer-events-none");
            } else if (diff < 0) {
                // Scrolling up -> bottom nav comes up and appears, top omnibar search box comes down and appears
                bottomNav?.classList.remove("translate-y-28", "opacity-0", "pointer-events-none");
                topOmnibar?.classList.remove("-translate-y-20", "opacity-0", "pointer-events-none");
            }
            lastScrollY = currentY;
        }

        function triggerScrollCheck(y) {
            if (!isScrollTicking) {
                window.requestAnimationFrame(() => {
                    updateFloatingNavOnScroll(y);
                    isScrollTicking = false;
                });
                isScrollTicking = true;
            }
        }

        window.addEventListener("scroll", () => triggerScrollCheck(window.scrollY || window.pageYOffset || 0), { passive: true });
        const mainScrollEl = document.querySelector("main");
        if (mainScrollEl) {
            mainScrollEl.addEventListener("scroll", () => triggerScrollCheck(mainScrollEl.scrollTop || 0), { passive: true });
        }

        // Sidebar Quick Filter / Search
        const searchInput = document.getElementById("sidebarMenuSearch");
        const clearBtn = document.getElementById("sidebarSearchClear");
        const nav = document.querySelector("#sidebar nav");
        const navUl = nav?.querySelector("ul");

        let emptyMsg = document.getElementById("sidebarSearchEmpty");
        if (!emptyMsg && navUl) {
            emptyMsg = document.createElement("li");
            emptyMsg.id = "sidebarSearchEmpty";
            emptyMsg.className = "hidden px-4 py-8 text-center text-xs text-slate-400";
            emptyMsg.innerHTML = '<i class="fa-solid fa-magnifying-glass text-slate-300 text-base mb-2 block"></i>No matching menu items';
            navUl.appendChild(emptyMsg);
        }

        window.clearSidebarMenuSearch = function () {
            if (searchInput) {
                searchInput.value = "";
                filterMenu();
                searchInput.focus();
            }
        };

        function filterMenu() {
            if (!searchInput || !nav) return;
            const query = searchInput.value.trim().toLowerCase();

            if (clearBtn) {
                clearBtn.classList.toggle("hidden", query.length === 0);
            }

            const allSections = nav.querySelectorAll("ul > li");

            if (!query) {
                // Restore all items and sections
                allSections.forEach(sec => {
                    if (sec.id === "sidebarSearchEmpty") return;
                    sec.style.display = "";
                    sec.querySelectorAll("a.nav-item-link").forEach(a => a.style.display = "");
                });
                if (emptyMsg) emptyMsg.classList.add("hidden");
                return;
            }

            let anyVisible = false;

            allSections.forEach(sec => {
                if (sec.id === "sidebarSearchEmpty") return;

                const links = sec.querySelectorAll("a.nav-item-link");
                if (links.length === 0) {
                    sec.style.display = "none";
                    return;
                }

                let sectionHasMatch = false;
                links.forEach(link => {
                    const text = (link.textContent || "").toLowerCase();
                    const title = (link.getAttribute("data-title") || "").toLowerCase();
                    const matches = text.includes(query) || title.includes(query);

                    link.style.display = matches ? "" : "none";

                    // Handle dropdown parent (e.g. PagesMenu)
                    const dropdownParent = link.closest(".pages-dropdown-list");
                    if (dropdownParent && matches) {
                        dropdownParent.style.display = "";
                        dropdownParent.classList.remove("hidden");
                    }

                    if (matches) {
                        sectionHasMatch = true;
                        anyVisible = true;
                    }
                });

                sec.style.display = sectionHasMatch ? "" : "none";
            });

            if (emptyMsg) {
                emptyMsg.classList.toggle("hidden", anyVisible);
            }
        }

        searchInput?.addEventListener("input", filterMenu);
    });
</script>
