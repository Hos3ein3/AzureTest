<script>
    document.addEventListener("DOMContentLoaded", function() {
        const sidebar = document.getElementById("sidebar");
        const desktopToggle = document.getElementById("sidebarToggleDesktop");
        const mobileMenuBtn = document.getElementById("mobileMenuBtn");
        const mobileCloseBtn = document.getElementById("sidebarToggleMobileClose");
        const mobileOverlay = document.getElementById("mobileSidebarOverlay");

        // Desktop Toggle Logic
        if (localStorage.getItem('sidebarCollapsed') === 'true' && window.innerWidth >= 768) {
            sidebar.classList.add("collapsed");
        }

        desktopToggle?.addEventListener("click", function() {
            sidebar.classList.toggle("collapsed");
            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains("collapsed"));
        });

        // Mobile Toggle Logic
        function openMobileSidebar() {
            sidebar.classList.remove("-translate-x-full");
            mobileOverlay.classList.add("active");
            // small delay for opacity transition
            setTimeout(() => mobileOverlay.classList.add("opacity-100"), 10);
        }

        function closeMobileSidebar() {
            sidebar.classList.add("-translate-x-full");
            mobileOverlay.classList.remove("opacity-100");
            setTimeout(() => mobileOverlay.classList.remove("active"), 300);
        }

        mobileMenuBtn?.addEventListener("click", openMobileSidebar);
        mobileCloseBtn?.addEventListener("click", closeMobileSidebar);
        mobileOverlay?.addEventListener("click", closeMobileSidebar);

        // Sidebar Quick Filter / Search
        const searchInput = document.getElementById("sidebarMenuSearch");
        const clearBtn = document.getElementById("sidebarSearchClear");
        const nav = document.querySelector("#sidebar nav");
        const navUl = nav?.querySelector("ul");

        let emptyMsg = document.getElementById("sidebarSearchEmpty");
        if (!emptyMsg && navUl) {
            emptyMsg = document.createElement("li");
            emptyMsg.id = "sidebarSearchEmpty";
            emptyMsg.className = "hidden px-4 py-8 text-center text-xs text-slate-400";
            emptyMsg.innerHTML = '<i class="fa-solid fa-magnifying-glass text-slate-300 text-base mb-2 block"></i>No matching menu items';
            navUl.appendChild(emptyMsg);
        }

        window.clearSidebarMenuSearch = function() {
            if (searchInput) {
                searchInput.value = "";
                filterMenu();
                searchInput.focus();
            }
        };

        function filterMenu() {
            if (!searchInput || !nav) return;
            const query = searchInput.value.trim().toLowerCase();
            
            if (clearBtn) {
                clearBtn.classList.toggle("hidden", query.length === 0);
            }

            const allSections = nav.querySelectorAll("ul > li");

            if (!query) {
                // Restore all items and sections
                allSections.forEach(sec => {
                    if (sec.id === "sidebarSearchEmpty") return;
                    sec.style.display = "";
                    sec.querySelectorAll("a.nav-item-link").forEach(a => a.style.display = "");
                });
                if (emptyMsg) emptyMsg.classList.add("hidden");
                return;
            }

            let anyVisible = false;

            allSections.forEach(sec => {
                if (sec.id === "sidebarSearchEmpty") return;

                const links = sec.querySelectorAll("a.nav-item-link");
                if (links.length === 0) {
                    sec.style.display = "none";
                    return;
                }

                let sectionHasMatch = false;
                links.forEach(link => {
                    const text = (link.textContent || "").toLowerCase();
                    const title = (link.getAttribute("data-title") || "").toLowerCase();
                    const matches = text.includes(query) || title.includes(query);

                    link.style.display = matches ? "" : "none";

                    // Handle dropdown parent (e.g. PagesMenu)
                    const dropdownParent = link.closest(".pages-dropdown-list");
                    if (dropdownParent && matches) {
                        dropdownParent.style.display = "";
                        dropdownParent.classList.remove("hidden");
                    }

                    if (matches) {
                        sectionHasMatch = true;
                        anyVisible = true;
                    }
                });

                sec.style.display = sectionHasMatch ? "" : "none";
            });

            if (emptyMsg) {
                emptyMsg.classList.toggle("hidden", anyVisible);
            }
        }

        searchInput?.addEventListener("input", filterMenu);
    });
</script>
