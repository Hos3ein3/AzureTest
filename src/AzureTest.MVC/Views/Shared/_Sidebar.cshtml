@using AzureTest.Application.Interfaces.Services
@inject ICurrentUser _CurrentUser
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _HostEnv
@inject Microsoft.Extensions.Options.IOptions<AzureTest.Infrastructure.Configuration.InfrastructureFeatureOptions> _FeatureOptionsAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration _Configuration

@{
    var appVersion = _Configuration["AppVersion"] ?? _Configuration["Version"] ?? "V3.1";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();

    var isMobileFloating = _FeatureOptionsAccessor?.Value?.MobileFloatingNavigation ?? true;
    var isTabletFloating = _FeatureOptionsAccessor?.Value?.TabletFloatingNavigation ?? true;
    var enableFloatingNav = isMobileFloating || isTabletFloating;

    var overlayResponsiveClass = isTabletFloating ? "lg:hidden" : "md:hidden";
    var sidebarResponsiveClass = isTabletFloating
        ? "fixed lg:relative inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200 text-slate-800 flex flex-col shadow-2xl lg:shadow-none transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out h-full"
        : "fixed md:relative inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200 text-slate-800 flex flex-col shadow-2xl md:shadow-none transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out h-full";
    var closeBtnResponsiveClass = isTabletFloating ? "lg:hidden" : "md:hidden";
    var desktopToggleResponsiveClass = isTabletFloating ? "hidden lg:flex" : "hidden md:flex";

    string floatingNavBreakpointClass = "";
    if (isMobileFloating && isTabletFloating)
    {
        floatingNavBreakpointClass = "lg:hidden";
    }
    else if (isMobileFloating)
    {
        floatingNavBreakpointClass = "md:hidden";
    }
    else if (isTabletFloating)
    {
        floatingNavBreakpointClass = "hidden md:block lg:hidden";
    }
    else
    {
        floatingNavBreakpointClass = "hidden";
    }

    string GetActiveClasses(string controller)
    {
        return currentController == controller
            ? "bg-brand-50 text-brand-700"
            : "text-slate-600 hover:bg-slate-50 hover:text-slate-900";
    }

    string GetActiveIconClasses(string controller)
    {
        return currentController == controller
            ? "text-brand-600"
            : "text-slate-400 group-hover:text-slate-600";
    }
}



<!-- Mobile Sidebar Backdrop -->
<div id="mobileSidebarOverlay"
     class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 @overlayResponsiveClass transition-opacity opacity-0 pointer-events-none"></div>

<!-- Sidebar Container -->
<aside id="sidebar"
       class="@sidebarResponsiveClass">

