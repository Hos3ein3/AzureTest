            </div>
        </div>
        <button id="sidebarToggleDesktop"
                class="@desktopToggleResponsiveClass text-slate-400 hover:text-brand-600 transition-colors p-2 rounded-lg hover:bg-slate-50 focus:outline-none">
            <i class="fa-solid fa-bars"></i>
        </button>
        <button id="sidebarToggleMobileClose"
                class="@closeBtnResponsiveClass text-slate-400 hover:text-slate-600 transition-colors p-2 focus:outline-none">
