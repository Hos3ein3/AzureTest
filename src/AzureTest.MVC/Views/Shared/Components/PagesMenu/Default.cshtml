@model List<AzureTest.Contracts.DTOs.Pages.PageDto>

<div x-data="{ expanded: false }" class="pages-menu-container">
    <button @@click="expanded = !expanded" type="button" class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-colors text-slate-600 hover:bg-slate-50 hover:text-slate-900 group" data-title="Published Pages">
        <div class="flex items-center">
            <i class="fa-solid fa-file-lines w-6 text-center text-lg text-slate-400 group-hover:text-brand-600 transition-colors"></i>
            <span class="ml-2 font-medium sidebar-text whitespace-nowrap transition-all duration-300">Published Pages</span>
        </div>
        <i class="fa-solid fa-chevron-down text-2xs text-slate-400 transition-transform duration-200" :class="{'rotate-180': expanded}"></i>
    </button>
    <div x-show="expanded" x-collapse style="display: none;" class="pages-dropdown-list">
        <ul class="mt-1 space-y-1 pl-8 pr-2">
            @if(Model != null && Model.Any())
            {
                foreach(var pageItem in Model)
                {
                    <li>
                        <a href="@Url.Action("Read", "Pages", new { slug = pageItem.Slug })"
                           data-title="@pageItem.Title"
                           class="nav-item-link block px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors truncate"
                           title="@pageItem.Title">
                            <i class="fa-regular fa-file-lines mr-1.5 text-2xs text-slate-400"></i>@pageItem.Title
                        </a>
                    </li>
                }
            }
            else
            {
                <li>
                    <span class="block px-2.5 py-1.5 text-xs text-slate-400 italic">No published pages</span>
                </li>
            }
        </ul>
    </div>
</div>
