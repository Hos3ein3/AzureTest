@using AzureTest.Application.Interfaces.Services
@using AzureTest.Infrastructure.Services
@inject  ICurrentUser _CurrentUser
@inject  ITenantProvider _TenantProvider
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _HostEnv
@inject Microsoft.Extensions.Options.IOptions<AzureTest.Infrastructure.Configuration.InfrastructureFeatureOptions> _FeatureOptionsAccessor
@inject AzureTest.Application.Messaging.IQueryHandler<AzureTest.Application.UserPreferences.Queries.GetUserPreferenceQuery, AzureTest.Domain.Documents.UserPreference> _PrefQuery
@{
    bool isDarkMode = false;
    string userTheme = "slate";
    if (_CurrentUser != null && _CurrentUser.Id != Guid.Empty)
    {
        try {
            var pref = _PrefQuery.HandleAsync(new AzureTest.Application.UserPreferences.Queries.GetUserPreferenceQuery(_CurrentUser.Id), default).GetAwaiter().GetResult();
            isDarkMode = pref?.IsDarkMode ?? false;
            if (!string.IsNullOrWhiteSpace(pref?.ThemeColor))
            {
                userTheme = pref.ThemeColor.ToLowerInvariant();
            }
        } catch {}
    }

    var isMobileFloating = _FeatureOptionsAccessor?.Value?.MobileFloatingNavigation ?? true;
    var isTabletFloating = _FeatureOptionsAccessor?.Value?.TabletFloatingNavigation ?? true;
    var enableFloatingNav = isMobileFloating || isTabletFloating;
    var isImpersonating = _TenantProvider != null && _TenantProvider.IsAdminImpersonating;

    string floatingNavBreakpointClass = "";
    if (isMobileFloating && isTabletFloating)
    {
        floatingNavBreakpointClass = "flex lg:hidden";
    }
    else if (isMobileFloating)
    {
        floatingNavBreakpointClass = "flex md:hidden";
    }
    else if (isTabletFloating)
    {
        floatingNavBreakpointClass = "hidden md:flex lg:hidden";
    }
    else
    {
        floatingNavBreakpointClass = "hidden";
    }

    var headerVisibilityClass = enableFloatingNav
        ? (isTabletFloating ? "hidden lg:flex" : "hidden md:flex")
        : "flex";
}
<!DOCTYPE html>
<html lang="en" data-theme="@userTheme" class="h-full bg-gray-50 @(isDarkMode ? "dark" : "")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>@ViewData["Title"] - TrackerPro</title>
    
    <!-- Favicon and PWA -->
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0d9488">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="TrackerPro">
    <link rel="apple-touch-icon" href="/icon-192.png">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- TomSelect -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    
    <!-- Tailwind Config -->
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f0fdfa',
                100: '#ccfbf1',
                500: '#14b8a6',
                600: '#0d9488',
                900: '#134e4a',
              }
            }
          }
        }
      }
    </script>
    
    @await RenderSectionAsync("Styles", required: false)

    <!-- Custom Styles -->
    

</head>
<body class="h-full flex overflow-hidden text-gray-800 font-sans">
    
    <!-- Global Page Loader Overlay -->
    <div id="globalPageLoader" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none" style="display: none;" aria-hidden="true">
        <div class="flex flex-col items-center bg-white/95 rounded-2xl p-6 shadow-2xl border border-slate-100 max-w-xs text-center">
            <div class="relative w-12 h-12 mb-3">
                <div class="absolute inset-0 rounded-full border-4 border-slate-200"></div>
                <div class="absolute inset-0 rounded-full border-4 border-brand-500 border-t-transparent animate-spin"></div>
            </div>
            <span class="text-sm font-semibold text-slate-800">Loading...</span>
            <span class="text-xs text-slate-500 mt-1 mb-4">Please wait while the page loads</span>
            <button id="cancelPageLoadBtn" type="button" class="bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-4 py-1.5 rounded-lg text-sm font-bold transition-colors shadow-sm pointer-events-auto">
                <i class="fa-solid fa-xmark mr-1"></i> Cancel
            </button>
        </div>
    </div>

    <partial name="_Sidebar" />

    <!-- Main Content wrapper -->
    <div class="flex-1 flex flex-col h-full overflow-hidden relative">

        @if (enableFloatingNav)
        {
            <!-- Mobile & Tablet Floating Top-Left Sandwich Menu Button (Stick to top-left, orange background only in impersonation) -->
            <button type="button"
                    id="floatingSidebarToggleBtn"
                    onclick="window.openMobileSidebar ? window.openMobileSidebar() : document.getElementById('sidebar')?.classList.remove('-translate-x-full')"
                    class="@floatingNavBreakpointClass fixed top-3 left-3 z-50 w-10 h-10 rounded-xl @(isImpersonating ? "bg-amber-500 hover:bg-amber-600 text-white border border-amber-600 shadow-lg shadow-amber-500/40 animate-pulse" : "bg-white/95 dark:bg-slate-800/95 backdrop-blur-md text-slate-700 dark:text-slate-200 border border-slate-200/90 dark:border-slate-700 shadow-md hover:shadow-lg") flex items-center justify-center transition-all active:scale-95"
                    title="@(isImpersonating ? "Impersonation Active - Open Menu" : "Open Menu")" aria-label="Menu">
                <i class="fa-solid fa-bars text-lg"></i>
            </button>

            <!-- Mobile & Tablet Floating OmniBar Search Box (Floats between left burger and right controls) -->
            <div id="floatingOmnibarWrapper"
                 class="@floatingNavBreakpointClass fixed top-3 left-16 right-[108px] sm:right-[124px] max-w-sm z-40 transition-all duration-300 ease-out select-none transform translate-y-0 opacity-100">
                <button type="button"
                        onclick="toggleOmnibar()"
                        class="w-full h-10 px-3.5 rounded-xl bg-white/95 dark:bg-slate-800/95 backdrop-blur-md border border-slate-200/90 dark:border-slate-700 shadow-md hover:shadow-lg flex items-center gap-2 text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-all active:scale-[0.98] text-left"
                        title="Search tasks, ideas, events, and features (Omnibar)" aria-label="Search">
                    <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs shrink-0"></i>
                    <span class="truncate flex-1 font-medium text-slate-500 dark:text-slate-400">Search...</span>
                    <span class="hidden xs:inline-flex items-center text-[10px] text-slate-400 border border-slate-200 dark:border-slate-700 rounded px-1.5 py-0.5 bg-slate-50 dark:bg-slate-900 font-sans tracking-wider font-semibold">⌘K</span>
                </button>
            </div>

            <!-- Mobile & Tablet Floating Top-Right Controls (Notification + 3-Dot Actions Menu) -->
            <div class="@floatingNavBreakpointClass fixed top-3 right-3 z-50 flex items-center gap-2">
                <!-- Floating Notification Dropdown Container -->
                <div class="relative" id="floatingNotificationDropdownContainer">
                    <button type="button"
                            id="floatingNotificationBtn"
                            onclick="toggleFloatingNotificationDropdown(event)"
                            class="w-10 h-10 rounded-xl bg-white/95 dark:bg-slate-800/95 backdrop-blur-md text-slate-700 dark:text-slate-200 border border-slate-200/90 dark:border-slate-700 shadow-md hover:shadow-lg flex items-center justify-center transition-all relative active:scale-95"
                            title="Notifications" aria-label="Notifications">
                        <i class="fa-regular fa-bell text-base"></i>
                        <span id="floatingNotificationBadge" class="notification-badge-target absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold rounded-full h-4 min-w-[16px] px-1 flex items-center justify-center hidden">0</span>
                    </button>

                    <!-- Floating Notification Dropdown -->
                    <div id="floatingNotificationDropdown" class="hidden absolute right-0 mt-2 w-80 max-w-[calc(100vw-24px)] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-50 flex flex-col overflow-hidden">
                        <div class="p-3 bg-slate-50 dark:bg-slate-700/50 border-b border-slate-100 dark:border-slate-700 font-semibold text-sm text-slate-800 dark:text-slate-200 flex items-center justify-between">
                            <span class="flex items-center gap-1.5">
                                <i class="fa-solid fa-bell text-brand-600 text-xs"></i>
                                <span>Notifications</span>
                            </span>
                            <button type="button" onclick="markAllNotificationsAsRead()" class="text-3xs text-brand-600 dark:text-brand-400 hover:underline font-medium">
                                Mark all as read
                            </button>
                        </div>
                        <div id="floatingNotificationList" class="max-h-72 overflow-y-auto p-2 space-y-1">
                            <div class="text-xs text-slate-400 dark:text-slate-500 text-center py-6" id="floatingNoNotifications">
                                <i class="fa-regular fa-bell-slash text-base mb-1 block text-slate-300"></i>
                                No new notifications
                            </div>
                        </div>
                        <div class="p-2.5 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-3xs text-slate-400 bg-slate-50/50 dark:bg-slate-800/50">
                            <a href="/Notification" class="text-brand-600 dark:text-brand-400 hover:underline font-semibold inline-flex items-center gap-1">
                                <i class="fa-solid fa-list-check"></i>
                                <span>All Notifications</span>
                            </a>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="sendTestPushNotification()" class="text-slate-500 hover:text-brand-600 hover:underline inline-flex items-center gap-1">
                                    <i class="fa-solid fa-paper-plane"></i>
                                    <span>Test</span>
                                </button>
                                <button type="button" onclick="registerWebPushSubscription()" class="text-brand-600 hover:underline inline-flex items-center gap-1 font-medium">
                                    <i class="fa-solid fa-bell-ring"></i>
                                    <span>Sync Push</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Floating 3-Dot Actions Menu Container -->
                <div class="relative" id="mobileActionsDropdownContainer">
                    <button type="button"
                            id="mobileActionsBtn"
                            onclick="toggleMobileActionsDropdown(event)"
                            class="w-10 h-10 rounded-xl bg-white/95 dark:bg-slate-800/95 backdrop-blur-md text-slate-700 dark:text-slate-200 border border-slate-200/90 dark:border-slate-700 shadow-md hover:shadow-lg flex items-center justify-center transition-all active:scale-95"
                            title="Actions & Settings" aria-label="Actions">
                        <i class="fa-solid fa-ellipsis-vertical text-lg"></i>
                    </button>

                    <!-- Floating 3-Dot Dropdown Menu -->
                    <div id="mobileActionsDropdown" class="hidden absolute right-0 mt-2 w-56 max-w-[calc(100vw-24px)] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-50 py-2 divide-y divide-slate-100 dark:divide-slate-700/60 overflow-hidden text-sm">
                        <div class="px-4 py-2 flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(_CurrentUser.ProfileImage))
                            {
                                <img src="@_CurrentUser.ProfileImage" class="w-8 h-8 rounded-full object-cover border border-slate-200 shrink-0" />
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-user text-2xl text-slate-400 shrink-0"></i>
                            }
                            <div class="truncate">
                                <p class="font-semibold text-slate-800 dark:text-slate-200 text-xs truncate">@(_CurrentUser?.FullName ?? "User")</p>
                                <p class="text-[11px] text-slate-400 truncate">@(_CurrentUser?.Email ?? "")</p>
                            </div>
                        </div>
                        <div class="py-1">
                            <a asp-area="" asp-action="Index" asp-controller="Profile" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60">
                                <i class="fa-solid fa-user mr-3 w-4 text-center text-slate-400"></i> Profile
                            </a>
                            <button type="button" onclick="document.getElementById('settingGear')?.click(); closeMobileActionsDropdown();" class="w-full flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60 text-left">
                                <i class="fa-solid fa-gear mr-3 w-4 text-center text-slate-400"></i> Preferences & Theme
                            </button>
                            <button type="button" onclick="toggleGlobalDarkMode()" class="w-full flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60 text-left">
                                <i class="fa-solid @(isDarkMode ? "fa-sun" : "fa-moon") mr-3 w-4 text-center text-slate-400"></i> Toggle Dark/Light
                            </button>
                            <button type="button" onclick="triggerPwaInstall(); closeMobileActionsDropdown();" class="w-full flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60 text-left">
                                <i class="fa-solid fa-mobile-screen-button mr-3 w-4 text-center text-slate-400"></i> Install Mobile App
                            </button>
                            <a asp-area="" asp-action="Manage" asp-controller="Dashboard" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60">
                                <i class="fab fa-windows mr-3 w-4 text-center text-slate-400"></i> Dashboards
                            </a>
                            <a asp-area="" asp-action="Index2" asp-controller="Pages" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60">
                                <i class="fa-solid fa-book-bookmark mr-3 w-4 text-center text-slate-400"></i> Explore Articles & Docs
                            </a>
                            @if (_CurrentUser?.IsAdmin == true && _TenantProvider != null && _TenantProvider.IsMultiTenancyEnabled)
                            {
                                <a asp-area="" asp-action="Index" asp-controller="Tenant" class="flex items-center px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60">
                                    <i class="fa-solid fa-building-user mr-3 w-4 text-center text-indigo-500"></i> Tenants (@(_TenantProvider.IsAdminImpersonating ? "Impersonating" : "Manage"))
                                </a>
                            }
                        </div>
                        <div class="py-1">
                            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="w-full">
                                <button type="submit" class="w-full flex items-center px-4 py-2 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 text-left">
                                    <i class="fa-solid fa-arrow-right-from-bracket mr-3 w-4 text-center text-red-500"></i> Logout
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Top Navbar -->
        <header class="h-16 bg-white shadow-sm @headerVisibilityClass items-center justify-between px-6 z-10">
            <!-- Mobile Menu Button (hidden on md or lg) -->
            <button id="mobileMenuBtn" class="@(isTabletFloating ? "lg:hidden" : "md:hidden") text-slate-500 hover:text-slate-700 focus:outline-none">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
            
            <div class="hidden md:flex items-center text-sm text-slate-500">
                <i class="fa-solid fa-house mr-2"></i>
                <span class="mx-2">/</span>
                <span class="font-medium text-slate-700">@ViewData["Title"]</span>
            </div>
            
            <div class="flex items-center space-x-4">
                @if (_CurrentUser?.IsAdmin == true && _TenantProvider != null && _TenantProvider.IsAdminImpersonating)
                {
                    <!-- Prominent Tenant Impersonation Warning Pill (Before Omnibar) -->
                    <div class="flex items-center bg-amber-500 text-white rounded-lg shadow-sm border border-amber-600 pl-3 pr-1.5 py-1 text-xs gap-2 animate-pulse" title="Active Tenant: @_TenantProvider.CurrentTenantId">
                        <i class="fa-solid fa-user-secret text-sm text-amber-100"></i>
                        <div class="flex flex-col text-left leading-tight max-w-[130px] sm:max-w-[200px]">
                            <span class="text-[9px] font-extrabold uppercase tracking-wider text-amber-100">Impersonating</span>
                            <span class="font-bold truncate text-white">@(!string.IsNullOrWhiteSpace(_TenantProvider.ImpersonatedTenantName) ? _TenantProvider.ImpersonatedTenantName : _TenantProvider.CurrentTenantId.ToString())</span>
                        </div>
                        <a asp-area="" asp-controller="Tenant" asp-action="Index" class="ml-1 px-1.5 py-0.5 rounded bg-amber-600 hover:bg-amber-700 text-white font-semibold text-[11px] transition-colors" title="Switch to another tenant">
                            <i class="fa-solid fa-users-gear"></i>
                        </a>
                        <form asp-area="" asp-controller="Tenant" asp-action="ResetTenant" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="w-5 h-5 rounded bg-amber-700 hover:bg-amber-800 text-white flex items-center justify-center transition-colors" title="Exit Impersonation (Return to your own workspace)">
                                <i class="fa-solid fa-xmark text-xs"></i>
                            </button>
                        </form>
                    </div>
                }

                <button onclick="toggleOmnibar()" class="hidden md:flex items-center space-x-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-3 py-1.5 rounded-lg text-sm text-slate-400 hover:text-slate-500 hover:border-slate-300 transition-colors shadow-sm w-48 focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span class="flex-1 text-left">Search...</span>
                    <span class="text-xs border border-slate-200 dark:border-slate-700 rounded px-1.5 py-0.5 bg-slate-50 dark:bg-slate-900 font-sans tracking-widest">⌘K</span>
                </button>
                
                <div class="hidden sm:block text-sm font-medium text-slate-500">
                    <i class="fa-regular fa-calendar mr-1.5"></i>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </div>
                <!-- Notification Bell -->
                <div class="relative" id="notificationDropdownContainer">
                    <button id="notificationBtn" onclick="document.getElementById('notificationDropdown').classList.toggle('hidden')" class="text-slate-400 hover:text-brand-500 transition-colors relative" title="Notifications">
                        <i class="fa-regular fa-bell text-lg"></i>
                        <span id="notificationBadge" class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] rounded-full h-4 w-4 flex items-center justify-center hidden">0</span>
                    </button>
                    <!-- Dropdown -->
                    <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-50 flex flex-col">
                        <div class="p-3 border-b border-slate-100 dark:border-slate-700 font-semibold text-slate-700 dark:text-slate-200 flex items-center justify-between">
                            <span class="flex items-center gap-2">
                                <i class="fa-solid fa-bell text-brand-600 text-xs"></i>
                                <span>Notifications</span>
                            </span>
                            <button type="button" onclick="markAllNotificationsAsRead()" class="text-3xs text-brand-600 hover:text-brand-700 font-medium hover:underline">
                                Mark all as read
                            </button>
                        </div>
                        <div id="notificationList" class="max-h-80 overflow-y-auto p-2 space-y-1 divide-y divide-slate-50 dark:divide-slate-700/50">
                            <div class="text-sm text-slate-500 dark:text-slate-400 text-center py-6" id="noNotifications">No new notifications</div>
                        </div>
                        <div class="p-2.5 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-3xs text-slate-400 bg-slate-50/50 dark:bg-slate-800/50 rounded-b-xl">
                            <a href="/Notification" class="text-brand-600 dark:text-brand-400 hover:underline font-semibold inline-flex items-center gap-1">
                                <i class="fa-solid fa-list-check"></i>
                                <span>All Notifications</span>
                            </a>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="sendTestPushNotification()" class="text-slate-500 hover:text-brand-600 hover:underline inline-flex items-center gap-1">
                                    <i class="fa-solid fa-paper-plane"></i>
                                    <span>Send Test</span>
                                </button>
                                <button type="button" onclick="registerWebPushSubscription()" class="text-brand-600 hover:underline inline-flex items-center gap-1 font-medium">
                                    <i class="fa-solid fa-bell-ring"></i>
                                    <span>Sync Web Push</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <button type="button" onclick="triggerPwaInstall()" class="text-slate-400 hover:text-brand-500 transition-colors" title="Install App on Phone">
                    <i class="fa-solid fa-mobile-screen-button text-lg"></i>
                </button>

                <button onclick="toggleGlobalDarkMode()" class="text-slate-400 hover:text-brand-500 transition-colors" title="Toggle Dark Mode">
                    <i class="fa-solid @(isDarkMode ? "fa-sun" : "fa-moon") text-lg" id="darkModeIcon"></i>
                </button>

                <button type="button" id="settingGear" class="text-slate-400 hover:text-brand-500 transition-colors" title="User Preferences & Theme">
                    <i class="fa-solid fa-gear text-lg"></i>
                </button>

                <a asp-area="" asp-action="Manage" asp-controller="Dashboard" class="text-slate-400 hover:text-brand-500 transition-colors" title="Dashboards">
                    <i class="fab fa-windows text-lg"></i>
                </a>
                
                @if (_CurrentUser?.IsAdmin == true && _TenantProvider != null && _TenantProvider.IsMultiTenancyEnabled)
                {
                    <a asp-area="" asp-action="Index" asp-controller="Tenant"  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold @(_TenantProvider.IsAdminImpersonating ? "bg-amber-100 text-amber-800 border border-amber-300 animate-pulse" : "bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-200") transition-all" title="Manage & Switch Tenant Workspace">
                        <i class="fa-solid fa-building-user @(_TenantProvider.IsAdminImpersonating ? "text-amber-600" : "text-indigo-600") text-sm"></i>
                        <span class="hidden sm:inline">@(_TenantProvider.IsAdminImpersonating ? "Impersonating" : "Tenants")</span>
                    </a>
                }

                <a asp-area="" asp-action="Index" asp-controller="Profile" class="text-slate-400 hover:text-brand-500 transition-colors flex items-center" title="My Profile">
                    @if(!string.IsNullOrEmpty(_CurrentUser.ProfileImage)){
                        <img src="@_CurrentUser.ProfileImage" class="w-7 h-7 rounded-full object-cover border border-slate-200" />
                    } else {
                        <i class="fa-solid fa-circle-user text-xl"></i>
                    }
                </a>

                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                    <button type="submit" class="text-slate-400 hover:text-brand-500 transition-colors" title="Logout">
                        <i class="fa-solid fa-arrow-right-from-bracket text-lg"></i>
                    </button>
                </form>
            </div>
        </header>

        @if (_TenantProvider != null && _TenantProvider.IsAdminImpersonating)
        {
