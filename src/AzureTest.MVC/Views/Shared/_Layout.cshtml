    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    <script>
        if (window.jQuery && $.validator) {
            $.validator.setDefaults({
                errorClass: 'input-validation-error',
                validClass: 'valid',
                highlight: function (element, errorClass, validClass) {
                    $(element).addClass(errorClass).removeClass(validClass);
                },
                unhighlight: function (element, errorClass, validClass) {
                    $(element).removeClass(errorClass).addClass(validClass);
                }
            });
        }

        // Global Modal Alert and Confirm implementation
        (function () {
            var confirmModal = document.getElementById('appGlobalConfirmModal');
            var confirmTitle = document.getElementById('appGlobalConfirmTitle');
            var confirmMsg = document.getElementById('appGlobalConfirmMessage');
            var confirmBtn = document.getElementById('appGlobalConfirmActionBtn');
            var cancelBtn = document.getElementById('appGlobalConfirmCancelBtn');
            var alertModal = document.getElementById('appGlobalAlertModal');
            var alertTitle = document.getElementById('appGlobalAlertTitle');
            var alertMsg = document.getElementById('appGlobalAlertMessage');
            var alertOkBtn = document.getElementById('appGlobalAlertOkBtn');

            var currentOnConfirm = null;

            window.showAppConfirm = function (opts) {
                if (!confirmModal) return;
                confirmTitle.textContent = opts.title || 'Confirm Action';
                confirmMsg.textContent = opts.message || 'Are you sure you want to proceed?';
                confirmBtn.textContent = opts.confirmBtnText || 'Confirm';
                currentOnConfirm = opts.onConfirm;
                confirmModal.classList.remove('hidden');
            };

            window.showAppAlert = function (opts) {
                if (!alertModal) return;
                var msg = typeof opts === 'string' ? opts : (opts.message || '');
                var title = typeof opts === 'object' && opts.title ? opts.title : 'Notice';
                alertTitle.textContent = title;
                alertMsg.textContent = msg;
                alertModal.classList.remove('hidden');
            };

            if (confirmBtn) {
                confirmBtn.onclick = function () {
                    confirmModal.classList.add('hidden');
                    if (typeof currentOnConfirm === 'function') {
                        currentOnConfirm();
                    }
                };
            }

            if (cancelBtn) {
                cancelBtn.onclick = function () {
                    confirmModal.classList.add('hidden');
                    currentOnConfirm = null;
                };
            }

            if (alertOkBtn) {
                alertOkBtn.onclick = function () {
                    alertModal.classList.add('hidden');
                };
            }

            // Replace window.alert with styled Tailwind modal
            window.alert = function (message) {
                window.showAppAlert(message);
            };

            // Intercept all forms and buttons that have inline confirm(...)
            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll('form').forEach(function (form) {
                    var onsubmitAttr = form.getAttribute('onsubmit');
                    if (onsubmitAttr && onsubmitAttr.indexOf('confirm(') !== -1) {
                        var match = onsubmitAttr.match(/confirm\s*\(\s*['"]([^'"]+)['"]\s*\)/);
                        var message = match ? match[1] : 'Are you sure you want to proceed?';
                        form.removeAttribute('onsubmit');
                        form.addEventListener('submit', function (e) {
                            if (form.dataset.globalConfirmed === 'true') {
                                form.dataset.globalConfirmed = 'false';
                                return true;
                            }
                            e.preventDefault();
                            window.showAppConfirm({
                                title: 'Confirm Action',
                                message: message,
                                onConfirm: function () {
                                    form.dataset.globalConfirmed = 'true';
                                    form.submit();
                                }
                            });
                            return false;
                        });
                    }
                });
            });
        })();
    </script>
