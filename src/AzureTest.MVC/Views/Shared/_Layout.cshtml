                </div>
                <button type="button" onclick="closePwaGuideModal()" class="w-8 h-8 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="space-y-4">
                <!-- iOS Instructions -->
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-750 border border-slate-200/80 dark:border-slate-700 space-y-2.5">
                    <div class="flex items-center gap-2 font-bold text-xs text-slate-900 dark:text-white">
