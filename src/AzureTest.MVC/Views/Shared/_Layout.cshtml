                    Got it
                </button>
            </div>
        </div>
    </div>

    
    <!-- Omnibar Modal -->
    <div id="omnibarModal" class="fixed inset-0 z-[100] hidden">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeOmnibar()"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto p-3 sm:p-6 md:p-20" onclick="if (event.target === this) closeOmnibar()">
            <div class="mx-auto max-w-2xl transform divide-y divide-slate-100 dark:divide-slate-700 overflow-hidden rounded-2xl bg-white dark:bg-slate-800 shadow-2xl ring-1 ring-black/10 transition-all" onclick="event.stopPropagation()">
                <div class="relative flex items-center">
                    <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-4 h-5 w-5 text-slate-400"></i>
                    <input type="text" id="omnibarInput" class="h-14 w-full border-0 bg-transparent pl-12 pr-12 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:ring-0 sm:text-lg focus:outline-none" placeholder="Search tasks, ideas, events, and features..." autocomplete="off">
                    <button type="button" onclick="closeOmnibar()" class="absolute right-3 w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-500 dark:text-slate-300 flex items-center justify-center transition-colors active:scale-95" aria-label="Close search" title="Close search">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>
                <ul id="omnibarResults" class="max-h-96 scroll-py-2 overflow-y-auto py-2 text-sm text-slate-800 dark:text-slate-200 hidden" role="listbox">
                </ul>
                <div id="omnibarEmpty" class="py-14 px-6 text-center text-sm sm:px-14 hidden">
                    <i class="fa-regular fa-face-frown text-4xl text-slate-300 dark:text-slate-600 mb-4"></i>
                    <p class="text-slate-900 dark:text-slate-100 font-semibold text-lg">No results found</p>
                    <p class="text-slate-500 dark:text-slate-400 mt-1">We couldn't find anything matching that search term.</p>
                </div>
                <div class="flex items-center justify-between bg-slate-50 dark:bg-slate-900/50 py-2.5 px-4 text-xs text-slate-500 dark:text-slate-400">
                    <div class="flex items-center gap-2">
                        <span class="hidden sm:inline-flex items-center"><kbd class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-1.5 py-0.5 font-sans font-medium mr-1.5 shadow-sm text-slate-400">esc</kbd> to close</span>
                        <span class="hidden sm:inline-flex items-center text-slate-400"><kbd class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded px-1.5 py-0.5 font-sans font-medium mr-1.5 shadow-sm text-slate-400">⌘K</kbd> shortcut</span>
                    </div>
                    <button type="button" onclick="closeOmnibar()" class="px-3 py-1.5 rounded-xl bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-semibold text-xs transition-colors flex items-center gap-1.5">
                        <i class="fa-solid fa-xmark text-2xs"></i>
                        <span>Close</span>
                    </button>
                </div>
