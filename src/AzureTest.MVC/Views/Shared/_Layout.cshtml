    </div>

    <!-- SignalR & Notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script>
        let unreadCount = 0;
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        // ── Pleasant, Modern Notification Sound ─────────────────────────────────
        // You can customize this by setting window.NOTIFICATION_SOUND_URL = '/sounds/my-sound.mp3';
        window.NOTIFICATION_SOUND_URL = null;

        function playNotificationChime() {
            if (window.NOTIFICATION_SOUND_URL) {
                try {
                    const audio = new Audio(window.NOTIFICATION_SOUND_URL);
                    audio.play().catch(() => {});
                    return;
                } catch (e) {}
            }

            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                if (ctx.state === 'suspended') ctx.resume();

                // Gentle two-tone chime (D5 -> A5)
                const now = ctx.currentTime;
                
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(587.33, now); // D5
                gain1.gain.setValueAtTime(0, now);
                gain1.gain.linearRampToValueAtTime(0.18, now + 0.02);
                gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.50);
                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.start(now);
                osc1.stop(now + 0.50);

                const osc2 = ctx.createOscillator();
                const gain2 = ctx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(880.00, now + 0.08); // A5
                gain2.gain.setValueAtTime(0, now + 0.08);
                gain2.gain.linearRampToValueAtTime(0.14, now + 0.10);
                gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.65);
                osc2.connect(gain2);
                gain2.connect(ctx.destination);
                osc2.start(now + 0.08);
                osc2.stop(now + 0.65);
            } catch (err) {
                console.warn('Audio play notice', err);
            }
        }
        window.playNotificationChime = playNotificationChime;

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function updateBadgeCount(count) {
            unreadCount = Math.max(0, count);
            window.unreadCount = unreadCount;
            const badge = document.getElementById('notificationBadge');
            const fBadge = document.getElementById('floatingNotificationBadge');
            if (badge) {
                badge.innerText = unreadCount;
                badge.classList.toggle('hidden', unreadCount === 0);
            }
            if (fBadge) {
                fBadge.innerText = unreadCount;
                fBadge.classList.toggle('hidden', unreadCount === 0);
            }
        }
        window.updateBadgeCount = updateBadgeCount;

        function createNotificationDomItem(n) {
            const item = document.createElement('div');
            const isRead = n.isRead === true;
            const unreadBg = isRead ? "bg-white dark:bg-slate-800" : "bg-brand-50/70 dark:bg-brand-950/30";
            item.className = `p-2.5 rounded-xl ${unreadBg} hover:bg-slate-50 dark:hover:bg-slate-750 text-xs transition-colors cursor-pointer flex items-start gap-3 relative`;
            
            let iconClass = "fa-solid fa-bell text-brand-600 bg-brand-100/60 dark:bg-brand-900/40";
            if (n.type === "Trade") {
                iconClass = "fa-solid fa-chart-line text-emerald-600 bg-emerald-100/60 dark:bg-emerald-900/40";
            } else if (n.type === "Ticket") {
                iconClass = "fa-solid fa-life-ring text-purple-600 bg-purple-100/60 dark:bg-purple-900/40";
            } else if (n.type === "Security") {
                iconClass = "fa-solid fa-shield-halved text-amber-600 bg-amber-100/60 dark:bg-amber-900/40";
            }

            const iconParts = iconClass.split(' ');
            const faIcon = iconParts.slice(0, 3).join(' ');
            const bgClass = iconParts.slice(3).join(' ');

            item.innerHTML = `
                <div class="w-7 h-7 rounded-lg shrink-0 flex items-center justify-center ${bgClass}">
                    <i class="${faIcon} text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-1">
                        <p class="font-bold text-slate-800 dark:text-slate-100 truncate text-xs">${escapeHtml(n.title)}</p>
                        <span class="text-3xs text-slate-400 shrink-0">${n.timeAgo || 'Just now'}</span>
                    </div>
                    <p class="text-slate-600 dark:text-slate-300 text-2xs mt-0.5 line-clamp-2 leading-relaxed">${escapeHtml(n.message || '').replace(/Realized PnL:\s*([+-]?\$?[0-9,.]+)/gi, (m, val) => {
                        const isPos = val.includes('+') || (!val.includes('-') && !val.includes('$0.00'));
                        const color = isPos ? 'text-emerald-500 font-bold font-mono' : 'text-rose-500 font-bold font-mono';
                        return `Realized PnL: <span class="${color}">${val}</span>`;
                    })}</p>
                </div>
                ${!isRead ? '<span class="unread-dot w-2 h-2 rounded-full bg-brand-500 shrink-0 mt-1.5 ring-2 ring-white dark:ring-slate-800"></span>' : ''}
            `;

            item.onclick = async () => {
                if (!n.isRead && n.id) {
                    try {
                        await fetch('/Notification/MarkAsRead', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ notificationId: n.id })
                        });
                        n.isRead = true;
                        updateBadgeCount(unreadCount - 1);
                    } catch (e) {
                        console.error('Failed to mark read', e);
                    }
                }
                
                // Navigate to notification center showing full details in the top section
                if (n.id) {
                    window.location.href = '/Notification?id=' + encodeURIComponent(n.id);
                } else if (n.actionUrl) {
                    window.location.href = n.actionUrl;
                } else {
                    window.location.href = '/Notification';
                }
            };

            return item;
        }

        function renderNotificationItem(n, prepend = false) {
            const list = document.getElementById('notificationList');
            const fList = document.getElementById('floatingNotificationList');

            document.getElementById('noNotifications')?.remove();
            document.getElementById('floatingNoNotifications')?.remove();

            if (list) {
                const item1 = createNotificationDomItem(n);
                if (prepend) list.prepend(item1); else list.appendChild(item1);
            }
            if (fList) {
                const item2 = createNotificationDomItem(n);
                if (prepend) fList.prepend(item2); else fList.appendChild(item2);
            }
        }

        async function loadUserNotifications() {
            try {
                const res = await fetch('/Notification/GetUserNotifications?limit=30');
                if (!res.ok) return;
                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) return;

                const data = await res.json();
                if (data && data.success && data.notifications) {
                    const list = document.getElementById('notificationList');
                    const fList = document.getElementById('floatingNotificationList');
                    if (list) list.innerHTML = '';
                    if (fList) fList.innerHTML = '';

                    updateBadgeCount(data.unreadCount || 0);

                    if (data.notifications.length === 0) {
                        if (list) list.innerHTML = '<div class="text-sm text-slate-500 dark:text-slate-400 text-center py-6" id="noNotifications">No new notifications</div>';
                        if (fList) fList.innerHTML = '<div class="text-xs text-slate-400 dark:text-slate-500 text-center py-6" id="floatingNoNotifications"><i class="fa-regular fa-bell-slash text-base mb-1 block text-slate-300"></i>No new notifications</div>';
                    } else {
                        data.notifications.forEach(n => renderNotificationItem(n, false));
                    }
                }
            } catch (err) {
                console.warn('Failed to load user notifications', err);
            }
        }

        window.markAllNotificationsAsRead = async function() {
            try {
                await fetch('/Notification/MarkAsRead', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                updateBadgeCount(0);
                document.querySelectorAll('#notificationList > div, #floatingNotificationList > div').forEach(div => {
                    div.classList.remove('bg-brand-50/70', 'dark:bg-brand-950/30');
                    div.querySelector('.unread-dot')?.remove();
                });
            } catch (err) {
                console.error('Failed to mark all as read', err);
            }
        };

        window.registerWebPushSubscription = async function() {
            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
                alert('WebPush is not supported on this browser.');
                return;
            }

            const permission = await Notification.requestPermission();
            if (permission !== 'granted') {
                alert('Push notification permission was denied in your browser settings.');
                return;
            }

            try {
                const keyRes = await fetch('/Notification/GetVapidPublicKey');
                if (!keyRes.ok) {
                    throw new Error(`Failed to fetch VAPID key (Status: ${keyRes.status})`);
                }
                const contentType = keyRes.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    const text = await keyRes.text();
                    throw new Error(`Server returned HTML instead of JSON. Ensure you are logged in. (Preview: ${text.substring(0, 80)}...)`);
                }
                const keyData = await keyRes.json();
                if (!keyData.publicKey) {
                    alert('Unable to retrieve VAPID public key.');
                    return;
                }

                const reg = await navigator.serviceWorker.ready;
                let sub = await reg.pushManager.getSubscription();
                if (!sub) {
                    const convertedKey = urlBase64ToUint8Array(keyData.publicKey);
                    sub = await reg.pushManager.subscribe({
                        userVisibleOnly: true,
                        applicationServerKey: convertedKey
                    });
                }

                const subJson = sub.toJSON();
                const res = await fetch('/Notification/SubscribePush', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        endpoint: subJson.endpoint,
                        p256dh: subJson.keys?.p256dh,
                        auth: subJson.keys?.auth
                    })
                });

                if (res.ok) {
                    alert('WebPush subscribed successfully! You will receive live trade alerts on this device.');
                } else {
                    const errData = await res.json().catch(() => ({}));
                    alert('WebPush subscription error: ' + (errData.error || res.statusText));
                }
            } catch (err) {
                console.warn('WebPush setup error', err);
                alert('WebPush subscription error: ' + (err.message || err));
            }
        };

        window.sendTestPushNotification = async function() {
            try {
                const res = await fetch('/Notification/SendTestNotification', { method: 'POST' });
                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    throw new Error('Server returned non-JSON response.');
                }
                const data = await res.json();
                if (!res.ok || !data.success) {
                    alert('Failed to send test notification: ' + (data.error || 'Server error'));
                }
            } catch (err) {
                console.warn('Test notification error', err);
                alert('Test notification error: ' + (err.message || err));
            }
        };

        function urlBase64ToUint8Array(base64String) {
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
            const rawData = window.atob(base64);
            const outputArray = new Uint8Array(rawData.length);
            for (let i = 0; i < rawData.length; ++i) {
                outputArray[i] = rawData.charCodeAt(i);
            }
            return outputArray;
        }

        // Live Realtime SignalR Notification Handler
        connection.on("ReceiveNotification", (notification) => {
            playNotificationChime();

            updateBadgeCount(unreadCount + 1);
            renderNotificationItem(notification, true);
        });

        connection.on("ReceiveTicketNotification", (title, message) => {
            playNotificationChime();

            updateBadgeCount(unreadCount + 1);

            const n = {
                id: null,
                title: title,
                message: message,
                type: 'Ticket',
                isRead: false,
                timeAgo: 'Just now',
                actionUrl: '/Ticket'
            };
            renderNotificationItem(n, true);
        });

        connection.on("UpdateOnlineUsersCount", (count) => {
            const countEl = document.getElementById('onlineUsersCountDisplay');
            if (countEl) {
                countEl.textContent = count;
                countEl.classList.add('scale-110', 'text-emerald-500');
                setTimeout(() => {
                    countEl.classList.remove('scale-110', 'text-emerald-500');
                }, 300);
            }
        });

        connection.start()
            .then(() => {
                loadUserNotifications();
            })
            .catch(err => {
                console.error('SignalR NotificationHub connection failed:', err);
                loadUserNotifications();
            });

        // Toggle Floating Notification Dropdown
        function toggleFloatingNotificationDropdown(e) {
            if (e) e.stopPropagation();
            const dd = document.getElementById('floatingNotificationDropdown');
            if (dd) dd.classList.toggle('hidden');
        }
        window.toggleFloatingNotificationDropdown = toggleFloatingNotificationDropdown;

        // Toggle Floating 3-Dot Actions Dropdown
        function toggleMobileActionsDropdown(e) {
            if (e) e.stopPropagation();
            const dd = document.getElementById('mobileActionsDropdown');
            if (dd) dd.classList.toggle('hidden');
        }
        function closeMobileActionsDropdown() {
            document.getElementById('mobileActionsDropdown')?.classList.add('hidden');
        }
        window.toggleMobileActionsDropdown = toggleMobileActionsDropdown;
        window.closeMobileActionsDropdown = closeMobileActionsDropdown;

        // Hide dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            const container = document.getElementById('notificationDropdownContainer');
            if (container && !container.contains(e.target)) {
                document.getElementById('notificationDropdown')?.classList.add('hidden');
            }

            const fContainer = document.getElementById('floatingNotificationDropdownContainer');
            const fDropdown = document.getElementById('floatingNotificationDropdown');
            if (fContainer && fDropdown && !fContainer.contains(e.target)) {
                fDropdown.classList.add('hidden');
            }

            const mActionsContainer = document.getElementById('mobileActionsDropdownContainer');
            const mActionsDropdown = document.getElementById('mobileActionsDropdown');
            if (mActionsContainer && mActionsDropdown && !mActionsContainer.contains(e.target)) {
                mActionsDropdown.classList.add('hidden');
            }
        });

        // Web Push / Local Notification Helper (zero external paid services)
        window.requestNotificationPermission = async function() {
            if (!('Notification' in window)) {
                console.log('This browser does not support desktop notifications');
                return false;
            }
            const permission = await Notification.requestPermission();
            return permission === 'granted';
        };

        window.sendLocalNotification = async function(title, options) {
            if (!('Notification' in window)) return;
            if (Notification.permission === 'default') {
                await Notification.requestPermission();
            }
            if (Notification.permission === 'granted') {
                if ('serviceWorker' in navigator) {
                    const reg = await navigator.serviceWorker.ready;
                    if (reg && reg.showNotification) {
                        reg.showNotification(title, {
                            icon: '/icon-192.png',
                            badge: '/icon-192.png',
                            ...options
                        });
                        return;
                    }
                }
                new Notification(title, { icon: '/icon-192.png', ...options });
            }
        };

        // Dark Mode Toggle
        function toggleGlobalDarkMode() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            localStorage.setItem('tracker_dark_mode', isDark ? 'dark' : 'light');
            const icon = document.getElementById('darkModeIcon');
            if (icon) {
                if (isDark) {
                    icon.classList.remove('fa-moon');
                    icon.classList.add('fa-sun');
                } else {
                    icon.classList.remove('fa-sun');
                    icon.classList.add('fa-moon');
                }
            }

            // Save to UserPreferences
            fetch('/UserPreference/Update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ IsDarkMode: isDark })
            });
        }
    </script>


<script>
    // Omnibar Logic
    const omnibarModal = document.getElementById('omnibarModal');
    const omnibarInput = document.getElementById('omnibarInput');
    const omnibarResults = document.getElementById('omnibarResults');
    const omnibarEmpty = document.getElementById('omnibarEmpty');
    let searchTimeout = null;

    function openOmnibar() {
        if (!omnibarModal) return;
        omnibarModal.classList.remove('hidden');
        setTimeout(() => omnibarInput?.focus(), 50);
    }

    function closeOmnibar() {
        if (!omnibarModal) return;
        omnibarModal.classList.add('hidden');
        if (omnibarInput) omnibarInput.value = '';
        if (omnibarResults) {
            omnibarResults.innerHTML = '';
            omnibarResults.classList.add('hidden');
        }
        if (omnibarEmpty) omnibarEmpty.classList.add('hidden');
    }

    function toggleOmnibar() {
        if (!omnibarModal) return;
        if (omnibarModal.classList.contains('hidden')) {
            openOmnibar();
        } else {
            closeOmnibar();
        }
    }
    window.openOmnibar = openOmnibar;
    window.closeOmnibar = closeOmnibar;
    window.toggleOmnibar = toggleOmnibar;

    document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            toggleOmnibar();
        }
        if (e.key === 'Escape' && omnibarModal && !omnibarModal.classList.contains('hidden')) {
            closeOmnibar();
        }
    });

    if(omnibarInput) {
        omnibarInput.addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            const q = e.target.value.trim();
            if (!q) {
                omnibarResults.innerHTML = '';
                omnibarResults.classList.add('hidden');
                omnibarEmpty.classList.add('hidden');
                return;
            }

            searchTimeout = setTimeout(() => {
                fetch('/Search/Omnibar?q=' + encodeURIComponent(q))
                    .then(res => res.json())
                    .then(data => {
                        omnibarResults.innerHTML = '';
                        if (data.length === 0) {
                            omnibarResults.classList.add('hidden');
                            omnibarEmpty.classList.remove('hidden');
                        } else {
                            omnibarEmpty.classList.add('hidden');
                            omnibarResults.classList.remove('hidden');
                            
                            data.forEach(item => {
                                const li = document.createElement('li');
                                li.className = "cursor-pointer select-none hover:bg-slate-100 dark:hover:bg-slate-700/50 transition border-b border-slate-50 dark:border-slate-800/50 last:border-0";
                                li.innerHTML = `
                                    <a href="${item.url}" class="flex items-center px-4 py-3 block w-full h-full">
                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700 ${item.color}">
                                            <i class="${item.icon} text-lg"></i>
                                        </div>
                                        <div class="ml-4 flex-auto">
                                            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">${item.title}</p>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">${item.type} &middot; ${item.subtitle}</p>
                                        </div>
                                        <i class="fa-solid fa-chevron-right text-slate-300 dark:text-slate-600 text-xs"></i>
                                    </a>
                                `;
                                omnibarResults.appendChild(li);
                            });
                        }
                    });
            }, 250);
        });
    }
</script>

</body>
</html>