        <!-- Main Scrollable Area -->
        <main class="flex-1 overflow-y-auto px-6 pb-6 md:px-8 md:pb-8 @(enableFloatingNav ? (isTabletFloating ? "pt-20 lg:pt-8 pb-24 lg:pb-8" : "pt-20 md:pt-8 pb-24 md:pb-8") : "pt-6 md:pt-8") bg-slate-50">
