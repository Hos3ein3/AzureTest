<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Resume Tracker</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- TomSelect -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
    
    <!-- Tailwind Config -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f0fdfa',
                100: '#ccfbf1',
                500: '#14b8a6',
                600: '#0d9488',
                900: '#134e4a',
              }
            }
          }
        }
      }
    </script>
</head>
<body class="h-full flex overflow-hidden text-gray-800 font-sans">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white flex-shrink-0 hidden md:flex md:flex-col shadow-xl">
        <div class="h-16 flex items-center px-6 border-b border-slate-800">
            <i class="fa-solid fa-briefcase text-brand-500 text-2xl mr-3"></i>
            <span class="text-xl font-bold tracking-wider">Tracker<span class="text-brand-500">Pro</span></span>
        </div>
        
        <nav class="flex-1 overflow-y-auto py-4">
            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                
                string GetActiveClasses(string controller)
                {
                    return currentController == controller 
                        ? "bg-slate-800 text-white" 
                        : "text-slate-300 hover:bg-slate-800 hover:text-white";
                }
                
                string GetActiveIconClasses(string controller)
                {
                    return currentController == controller 
                        ? "text-brand-500" 
                        : "text-slate-400 group-hover:text-white";
                }
            }
            <ul class="space-y-1 px-3">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Home")">
                        <i class="fa-solid fa-gauge-high w-6 @GetActiveIconClasses("Home")"></i>
                        <span class="ml-2 font-medium">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Resume" asp-action="Index" class="flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Resume")">
                        <i class="fa-solid fa-file-lines w-6 @GetActiveIconClasses("Resume")"></i>
                        <span class="ml-2 font-medium">Resumes</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Company" asp-action="Index" class="flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Company")">
                        <i class="fa-solid fa-building w-6 @GetActiveIconClasses("Company")"></i>
                        <span class="ml-2 font-medium">Companies</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Analytics" asp-action="Index" class="flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Analytics")">
                        <i class="fa-solid fa-chart-pie w-6 @GetActiveIconClasses("Analytics")"></i>
                        <span class="ml-2 font-medium">Analytics</span>
                    </a>
                </li>
                <li class="pt-4 mt-4 border-t border-slate-800">
                    <p class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">System</p>
                    <a href="/healthchecks-ui" target="_blank" class="flex items-center px-3 py-2.5 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                        <i class="fa-solid fa-heart-pulse w-6 text-slate-400 group-hover:text-white"></i>
                        <span class="ml-2 font-medium">Health Status</span>
                    </a>
                    <a href="/hangfire" target="_blank" class="flex items-center px-3 py-2.5 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                        <i class="fa-solid fa-server w-6 text-slate-400 group-hover:text-white"></i>
                        <span class="ml-2 font-medium">Background Jobs</span>
                    </a>
                </li>
            </ul>
        </nav>
        
        <div class="p-4 border-t border-slate-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="h-8 w-8 rounded-full bg-brand-600 flex items-center justify-center text-white font-bold">
                        MH
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-white">Mohammad</p>
                        <p class="text-xs text-slate-400">Administrator</p>
                    </div>
                </div>
                <a href="#" class="text-slate-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-gear text-lg"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content wrapper -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">
        
        <!-- Top Navbar -->
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-6 z-10">
            <!-- Mobile Menu Button (hidden on md) -->
            <button class="md:hidden text-slate-500 hover:text-slate-700">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
            
            <div class="hidden md:flex items-center text-sm text-slate-500">
                <i class="fa-solid fa-house mr-2"></i>
                <span class="mx-2">/</span>
                <span class="font-medium text-slate-700">@ViewData["Title"]</span>
            </div>
            
            <div class="flex items-center space-x-6">
                <div class="text-sm font-medium text-slate-500">
                    <i class="fa-regular fa-calendar mr-1.5"></i>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </div>
                <button class="text-slate-400 hover:text-brand-500 transition-colors">
                    <i class="fa-regular fa-bell text-lg"></i>
                </button>
                <a asp-controller="Auth" asp-action="Login" class="text-slate-400 hover:text-brand-500 transition-colors" title="Logout">
                    <i class="fa-solid fa-arrow-right-from-bracket text-lg"></i>
                </a>
            </div>
        </header>

        <!-- Main Scrollable Area -->
        <main class="flex-1 overflow-y-auto p-6 md:p-8 bg-slate-50">
            <div class="max-w-7xl mx-auto">
                @RenderBody()
            </div>
        </main>
        
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>