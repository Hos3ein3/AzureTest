@using AzureTest.Application.Interfaces.Services
@using AzureTest.Infrastructure.Services
@inject  ICurrentUser _CurrentUser
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _HostEnv
<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>@ViewData["Title"] - TrackerPro</title>
    
    <!-- Favicon and PWA -->
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#3b82f6">
    <link rel="apple-touch-icon" href="~/icon-192.png">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- TomSelect -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
    
    <!-- Tailwind Config -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#f0fdfa',
                100: '#ccfbf1',
                500: '#14b8a6',
                600: '#0d9488',
                900: '#134e4a',
              }
            }
          }
        }
      }
    </script>
    
    @await RenderSectionAsync("Styles", required: false)

    <!-- Custom Styles -->
    <style>
        #sidebar.collapsed summary i.fa-chevron-down {
            display: none !important;
        }
        #sidebar {
            transition: width 0.3s ease;
        }
        #sidebar.collapsed {
            width: 4.5rem !important;
        }
        #sidebar.collapsed .sidebar-text {
            display: none !important;
        }
        #sidebar.collapsed .logo-brand {
            display: none !important;
        }
        #sidebar.collapsed .logo-container {
            justify-content: center !important;
            padding: 0 !important;
        }
        #sidebar.collapsed .logo-icon {
            display: none !important;
        }
        #sidebar.collapsed #sidebarToggle {
            margin-left: 0 !important;
            margin: 0 auto;
        }
        #sidebar.collapsed .nav-item-link {
            justify-content: center !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            position: relative;
        }
        #sidebar.collapsed .nav-item-link i {
            margin: 0 !important;
        }
        /* Tooltip */
        #sidebar.collapsed .nav-item-link:hover::after {
            content: attr(data-title);
            position: absolute;
            left: calc(100% + 8px);
            background-color: #1e293b;
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.875rem;
            white-space: nowrap;
            z-index: 50;
            pointer-events: none;
            opacity: 1;
        }
    </style>

</head>
<body class="h-full flex overflow-hidden text-gray-800 font-sans">
    
    <!-- Global Page Loader Overlay -->
    <div id="globalPageLoader" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none" style="display: none;" aria-hidden="true">
        <div class="flex flex-col items-center bg-white/95 rounded-2xl p-6 shadow-2xl border border-slate-100 max-w-xs text-center">
            <div class="relative w-12 h-12 mb-3">
                <div class="absolute inset-0 rounded-full border-4 border-slate-200"></div>
                <div class="absolute inset-0 rounded-full border-4 border-brand-500 border-t-transparent animate-spin"></div>
            </div>
            <span class="text-sm font-semibold text-slate-800">Loading...</span>
            <span class="text-xs text-slate-500 mt-1">Please wait while the page loads</span>
        </div>
    </div>

    <!-- Sidebar -->
    <aside id="sidebar" class="w-64 transition-all duration-300 bg-slate-900 text-white flex-shrink-0 hidden md:flex md:flex-col shadow-xl">
        <div class="h-16 flex items-center px-6 border-b border-slate-800 logo-container transition-all">
            <i class="fa-solid fa-briefcase text-brand-500 text-2xl mr-3 logo-icon"></i>
            <span class="logo-brand text-xl font-bold tracking-wider overflow-hidden whitespace-nowrap">Tracker<span class="text-brand-500">Pro</span></span>
            <button id="sidebarToggle" class="ml-auto text-slate-400 hover:text-white transition-all p-2 rounded-lg hover:bg-slate-800"><i class="fa-solid fa-bars"></i></button>
        </div>
        
        <nav class="flex-1 overflow-y-auto py-4 scrollbar-hide">
            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                
                string GetActiveClasses(string controller)
                {
                    return currentController == controller 
                        ? "bg-slate-800 text-white" 
                        : "text-slate-300 hover:bg-slate-800 hover:text-white";
                }
                
                string GetActiveIconClasses(string controller)
                {
                    return currentController == controller 
                        ? "text-brand-500" 
                        : "text-slate-400 group-hover:text-white";
                }
            }
            <ul class="space-y-1 px-3">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index" data-title="Dashboard" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Home")">
                        <i class="fa-solid fa-gauge-high w-6 @GetActiveIconClasses("Home")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Resume" asp-action="Index" data-title="Resumes" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Resume")">
                        <i class="fa-solid fa-file-lines w-6 @GetActiveIconClasses("Resume")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Resumes</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="IdeaTracker" asp-action="Index" data-title="Idea Tracker" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("IdeaTracker")">
                        <i class="fa-solid fa-brain w-6 @GetActiveIconClasses("IdeaTracker")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Idea Tracker</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="JobCrawler" asp-action="Index" data-title="Job Crawler" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("JobCrawler")">
                        <i class="fa-solid fa-spider w-6 @GetActiveIconClasses("JobCrawler")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Job Crawler</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="HouseCrawler" asp-action="Index" data-title="House Crawler" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("HouseCrawler")">
                        <i class="fa-solid fa-house-chimney w-6 @GetActiveIconClasses("HouseCrawler")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">House Crawler</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Company" asp-action="Index" data-title="Companies" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Company")">
                        <i class="fa-solid fa-building w-6 @GetActiveIconClasses("Company")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Companies</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="ResumeFile" asp-action="Index" data-title="Resume Files" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("ResumeFile")">
                        <i class="fa-solid fa-file-pdf w-6 @GetActiveIconClasses("ResumeFile")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Resume Files</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Calendar" asp-action="Index" data-title="Calendar" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Calendar")">
                        <i class="fa-regular fa-calendar w-6 @GetActiveIconClasses("Calendar")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Calendar</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Task" asp-action="Index" data-title="Tasks" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Task")">
                        <i class="fa-solid fa-check-double w-6 @GetActiveIconClasses("Task")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Tasks</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Event" asp-action="Index" data-title="Events" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Event")">
                        <i class="fa-regular fa-calendar-days w-6 @GetActiveIconClasses("Event")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Events</span>
                    </a>
                </li>
                @if (_HostEnv.EnvironmentName != "Production")
                {
                    <li>
                        <a asp-area="" asp-controller="SampleNote" asp-action="Index" data-title="Sample Notes (Dev)" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("SampleNote")">
                            <i class="fa-solid fa-flask w-6 @GetActiveIconClasses("SampleNote")"></i>
                            <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Sample Notes <span class="text-xs text-yellow-300 ml-1">(Dev)</span></span>
                        </a>
                    </li>
                }
                <li>
                    <a asp-area="" asp-controller="Habit" asp-action="Index" data-title="Habits" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Habit")">
                        <i class="fa-solid fa-seedling w-6 @GetActiveIconClasses("Habit")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Habits</span>
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Ticket" asp-action="Index" data-title="Support Tickets" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Ticket")">
                        <i class="fa-solid fa-ticket w-6 @GetActiveIconClasses("Ticket")"></i>
                        <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Support Tickets</span>
                    </a>
                </li>
                
                <!-- 2-Level Dropdown Example (Financials) -->
                <li>
                    <details class="group [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center px-3 py-2.5 rounded-lg transition-colors cursor-pointer text-slate-300 hover:bg-slate-800 hover:text-white">
                            <i class="fa-solid fa-wallet w-6 text-slate-400 group-hover:text-white"></i>
                            <span class="ml-2 font-medium flex-1 sidebar-text">Financials</span>
                            <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200 group-open:rotate-180"></i>
                        </summary>
                        <ul class="mt-1 ml-6 space-y-1 border-l border-slate-700 pl-3">
                            <li>
                                <a asp-controller="Expense" asp-action="Index" class="flex items-center px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                    Expenses
                                </a>
                            </li>
                            <li>
                                <a asp-controller="ExpenseCategory" asp-action="Index" class="flex items-center px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                    Categories
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Debt" asp-action="Index" class="flex items-center px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                    Debts
                                </a>
                            </li>
                            <li>
                                <a asp-controller="DebtPerson" asp-action="Index" class="flex items-center px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                    Persons
                                </a>
                            </li>
                        </ul>
                    </details>
                </li>

                <!-- 3-Level Dropdown Example (Preferences) -->
                <li>
                    <details class="group [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center px-3 py-2.5 rounded-lg transition-colors cursor-pointer text-slate-300 hover:bg-slate-800 hover:text-white">
                            <i class="fa-solid fa-gears w-6 text-slate-400 group-hover:text-white"></i>
                            <span class="ml-2 font-medium flex-1 sidebar-text">Settings</span>
                            <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200 group-open:rotate-180"></i>
                        </summary>
                        <ul class="mt-1 ml-6 space-y-1 border-l border-slate-700 pl-3">
                            <li>
                                <a href="#" class="flex items-center px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                    General
                                </a>
                            </li>
                            <li>
                                <details class="group/sub [&_summary::-webkit-details-marker]:hidden">
                                    <summary class="flex items-center px-3 py-2 rounded-lg text-sm transition-colors cursor-pointer text-slate-400 hover:text-white hover:bg-slate-800">
                                        <span class="flex-1 sidebar-text">Personalization</span>
                                        <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200 group-open/sub:rotate-180"></i>
                                    </summary>
                                    <ul class="mt-1 ml-4 space-y-1 border-l border-slate-600 pl-3">
                                        <li>
                                            <a href="#" class="flex items-center px-3 py-1.5 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                                Theme Colors
                                            </a>
                                        </li>
                                        <li>
                                            <a href="#" class="flex items-center px-3 py-1.5 rounded-lg text-xs text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                                                Language
                                            </a>
                                        </li>
                                    </ul>
                                </details>
                            </li>
                        </ul>
                    </details>
                </li>
                
                    <li class="pt-4 mt-4 border-t border-slate-800">
                        <p class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">System</p>
                        
                        @if (_CurrentUser.HasAccess("User/Index"))
                        {
                            <a asp-area="" asp-controller="User" asp-action="Index" data-title="User Management" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("User")">
                                <i class="fa-solid fa-users w-6 @GetActiveIconClasses("User")"></i>
                                <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">User Management</span>
                            </a>
                        }
                        
                        @if (_CurrentUser.HasAccess("Role/Index"))
                        {
                            <a asp-area="" asp-controller="Role" asp-action="Index" data-title="Roles & Permissions" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Role")">
                                <i class="fa-solid fa-user-shield w-6 @GetActiveIconClasses("Role")"></i>
                                <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Roles & Permissions</span>
                            </a>
                        }
                        
                        @if (_CurrentUser.HasAccess("FileExplorer/Index"))
                        {
                            <a asp-area="" asp-controller="FileExplorer" asp-action="Index" data-title="File Explorer" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("FileExplorer")">
                                <i class="fa-solid fa-folder-tree w-6 @GetActiveIconClasses("FileExplorer")"></i>
                                <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">File Explorer</span>
                            </a>
                        }

                        @if (_CurrentUser.HasAccess("Permissions/Index"))
                        {
                            <a asp-area="" asp-controller="Permission" asp-action="Index" class="flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Permission")">
                                <i class="fa-solid fa-user-lock w-6 @GetActiveIconClasses("Permission")"></i>
                                <span class="ml-2 font-medium">Permissions</span>
                            </a>
                        }
                        
                        @if (_CurrentUser.HasAccess("Component/Index"))
                        {
                            <a asp-area="" asp-controller="Component" asp-action="Index" data-title="Dashboard Components" class="nav-item-link flex items-center px-3 py-2.5 rounded-lg transition-colors group @GetActiveClasses("Component")">
                                <i class="fa-solid fa-cubes w-6 @GetActiveIconClasses("Component")"></i>
                                <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Dashboard Components</span>
                            </a>
                        }
                        
                        @if (_CurrentUser.IsAdmin)
                        {
                            <a href="/healthchecks-ui" target="_blank" class="flex items-center px-3 py-2.5 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                                <i class="fa-solid fa-heart-pulse w-6 text-slate-400 group-hover:text-white"></i>
                                <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Health Status</span>
                            </a>
                            <a href="/hangfire" target="_blank" class="flex items-center px-3 py-2.5 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg transition-colors group">
                                <i class="fa-solid fa-server w-6 text-slate-400 group-hover:text-white"></i>
                                <span class="ml-2 font-medium sidebar-text overflow-hidden whitespace-nowrap transition-all duration-300">Background Jobs</span>
                            </a>
                        }
                    </li>
                
    

            </ul>
        </nav>
        
        <div class="p-4 border-t border-slate-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="h-8 w-8 rounded-full bg-brand-600 flex items-center justify-center text-white font-bold">
                        MH
                    </div>
                    <div class="ml-3">
                        <p class="text-sm font-medium text-white">
                            <cache vary-by-user="true" expires-after="@TimeSpan.FromMinutes(30)">
                                @_CurrentUser.FirstName
                            </cache>
                        </p>
                        <p class="text-xs text-slate-400">Administrator</p>
                    </div>
                </div>
                <a href="#" class="text-slate-400 hover:text-white transition-colors" id="settingGear">
                    <i class="fa-solid fa-gear text-lg"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content wrapper -->
    <div class="flex-1 flex flex-col h-full overflow-hidden">
        
        <!-- Top Navbar -->
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-6 z-10">
            <!-- Mobile Menu Button (hidden on md) -->
            <button class="md:hidden text-slate-500 hover:text-slate-700">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
            
            <div class="hidden md:flex items-center text-sm text-slate-500">
                <i class="fa-solid fa-house mr-2"></i>
                <span class="mx-2">/</span>
                <span class="font-medium text-slate-700">@ViewData["Title"]</span>
            </div>
            
            <div class="flex items-center space-x-6">
                <div class="text-sm font-medium text-slate-500">
                    <i class="fa-regular fa-calendar mr-1.5"></i>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </div>
                <button class="text-slate-400 hover:text-brand-500 transition-colors">
                    <i class="fa-regular fa-bell text-lg"></i>
                </button>
                <a asp-action="Manage" asp-controller="Dashboard" class="text-slate-400 hover:text-brand-500 transition-colors">
                    
                    <i class="fab fa-windows"></i>
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                    <button type="submit" class="text-slate-400 hover:text-brand-500 transition-colors" title="Logout">
                        <i class="fa-solid fa-arrow-right-from-bracket text-lg"></i>
                    </button>
                </form>
            </div>
        </header>

        <!-- Main Scrollable Area -->
        <main class="flex-1 overflow-y-auto p-6 md:p-8 bg-slate-50">
            <div class="max-w-7xl mx-auto">
                @RenderBody()
            </div>
            <partial name="_Toast" />
        </main>
        
    </div>

    <!-- User Preference Modal -->
    <div id="userPreferenceModal" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-labelledby="prefModalTitle" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div id="prefModalBackdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 opacity-0"></div>

        <div class="min-h-full flex items-center justify-center p-4 text-center sm:p-0">
            <div id="prefModalDialog" class="relative bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-lg w-full scale-95 opacity-0 border border-slate-100">
                <!-- Modal Header -->
                <div class="bg-slate-900 px-6 py-4 flex items-center justify-between text-white">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-8 h-8 rounded-lg bg-brand-500/20 text-brand-400 flex items-center justify-center">
                            <i class="fa-solid fa-sliders text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-semibold text-white leading-6" id="prefModalTitle">User Preferences</h3>
                            <p class="text-xs text-slate-400">Customize your display language and theme</p>
                        </div>
                    </div>
                    <button type="button" id="closePrefModalBtn" class="text-slate-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-slate-800">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <form id="userPreferenceForm" class="p-6 space-y-5">
                    <!-- Status message banner -->
                    <div id="prefModalAlert" class="hidden p-3 rounded-lg text-xs font-medium flex items-center space-x-2"></div>

                    <!-- Loading state indicator -->
                    <div id="prefModalLoading" class="py-8 flex flex-col items-center justify-center space-y-3">
                        <div class="w-8 h-8 border-4 border-brand-500 border-t-transparent rounded-full animate-spin"></div>
                        <span class="text-xs text-slate-500 font-medium">Fetching your preferences...</span>
                    </div>

                    <!-- Fields container -->
                    <div id="prefModalFields" class="hidden space-y-4">
                        <!-- Language -->
                        <div>
                            <label for="prefLanguage" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                <i class="fa-solid fa-globe mr-1.5 text-brand-600"></i> Interface Language
                            </label>
                            <select id="prefLanguage" name="language" class="block w-full rounded-lg border-slate-300 text-sm py-2 px-3 focus:border-brand-500 focus:ring-brand-500 border bg-white">
                                <option value="en">English (en)</option>
                                <option value="nl">Dutch (nl)</option>
                                <option value="es">Spanish (es)</option>
                                <option value="fr">French (fr)</option>
                                <option value="de">German (de)</option>
                            </select>
                        </div>

                        <!-- Theme Color -->
                        <div>
                            <label for="prefThemeColor" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                <i class="fa-solid fa-palette mr-1.5 text-brand-600"></i> Theme Accent Color
                            </label>
                            <select id="prefThemeColor" name="themeColor" class="block w-full rounded-lg border-slate-300 text-sm py-2 px-3 focus:border-brand-500 focus:ring-brand-500 border bg-white">
                                <option value="slate">Slate (Default Dark)</option>
                                <option value="blue">Blue Ocean</option>
                                <option value="emerald">Emerald Green</option>
                                <option value="indigo">Indigo Modern</option>
                                <option value="rose">Rose Elegance</option>
                            </select>
                        </div>

                        <!-- Currency -->
                        <div>
                            <label for="prefCurrency" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                <i class="fa-solid fa-coins mr-1.5 text-brand-600"></i> Preferred Currency
                            </label>
                            <select id="prefCurrency" name="currency" class="block w-full rounded-lg border-slate-300 text-sm py-2 px-3 focus:border-brand-500 focus:ring-brand-500 border bg-white">
                                <option value="USD">USD ($)</option>
                                <option value="EUR">EUR (€)</option>
                                <option value="GBP">GBP (£)</option>
                                <option value="JPY">JPY (¥)</option>
                            </select>
                        </div>

                        <!-- Preferred Dashboard -->
                        <div>
                            <label for="prefDashboard" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                                <i class="fa-solid fa-chart-line mr-1.5 text-brand-600"></i> Default Dashboard
                            </label>
                            <select id="prefDashboard" name="preferredDashboard" class="block w-full rounded-lg border-slate-300 text-sm py-2 px-3 focus:border-brand-500 focus:ring-brand-500 border bg-white">
                                <option value="">Standard View (Default)</option>
                                <!-- Dashboards will be loaded here via JS -->
                            </select>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
                        <button type="button" id="cancelPrefModalBtn" class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                            Cancel
                        </button>
                        <button type="submit" id="savePrefModalBtn" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 transition-colors disabled:opacity-50">
                            <span id="savePrefBtnSpinner" class="hidden mr-2"><i class="fa-solid fa-spinner fa-spin"></i></span>
                            <span id="savePrefBtnText">Save Preferences</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Global Page Loader and Setting Modal Scripts -->
    <script>
        // Global Page Loader handling
        (function () {
            const loader = document.getElementById('globalPageLoader');
            if (!loader) return;

            function showLoader() {
                loader.style.display = 'flex';
                requestAnimationFrame(() => {
                    loader.classList.remove('opacity-0', 'pointer-events-none');
                    loader.classList.add('opacity-100');
                    loader.removeAttribute('aria-hidden');
                });
            }

            function hideLoader() {
                loader.classList.remove('opacity-100');
                loader.classList.add('opacity-0', 'pointer-events-none');
                loader.setAttribute('aria-hidden', 'true');
                setTimeout(() => {
                    if (loader.classList.contains('opacity-0')) {
                        loader.style.display = 'none';
                    }
                }, 250);
            }

            window.addEventListener('beforeunload', function () {
                showLoader();
            });

            window.addEventListener('pageshow', function () {
                hideLoader();
            });
        })();

        // Setting Gear & User Preference Modal Logic
        (function () {
            const gearBtn = document.getElementById('settingGear');
            const modal = document.getElementById('userPreferenceModal');
            const backdrop = document.getElementById('prefModalBackdrop');
            const dialog = document.getElementById('prefModalDialog');
            const closeBtn = document.getElementById('closePrefModalBtn');
            const cancelBtn = document.getElementById('cancelPrefModalBtn');
            const form = document.getElementById('userPreferenceForm');
            const loadingIndicator = document.getElementById('prefModalLoading');
            const fieldsContainer = document.getElementById('prefModalFields');
            const alertBox = document.getElementById('prefModalAlert');
            const languageSelect = document.getElementById('prefLanguage');
            const themeColorSelect = document.getElementById('prefThemeColor');
            const saveBtn = document.getElementById('savePrefModalBtn');
            const saveSpinner = document.getElementById('savePrefBtnSpinner');
            const saveText = document.getElementById('savePrefBtnText');

            if (!gearBtn || !modal) return;

            function showAlert(msg, isSuccess) {
                alertBox.textContent = msg;
                alertBox.className = isSuccess 
                    ? 'p-3 rounded-lg text-xs font-medium flex items-center space-x-2 bg-emerald-50 text-emerald-700 border border-emerald-200'
                    : 'p-3 rounded-lg text-xs font-medium flex items-center space-x-2 bg-rose-50 text-rose-700 border border-rose-200';
                alertBox.classList.remove('hidden');
            }

            function hideAlert() {
                alertBox.classList.add('hidden');
                alertBox.textContent = '';
            }

            function openModal() {
                hideAlert();
                modal.classList.remove('hidden');
                requestAnimationFrame(() => {
                    backdrop.classList.remove('opacity-0');
                    dialog.classList.remove('opacity-0', 'scale-95');
                    dialog.classList.add('opacity-100', 'scale-100');
                });
                fetchPreferences();
            }

            function closeModal() {
                backdrop.classList.add('opacity-0');
                dialog.classList.remove('opacity-100', 'scale-100');
                dialog.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }

            async function fetchPreferences() {
                loadingIndicator.classList.remove('hidden');
                fieldsContainer.classList.add('hidden');
                saveBtn.disabled = true;

                try {
                    const response = await fetch('/UserPreference/Get', {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (response.ok) {
                        const data = await response.json();
                        if (data.language && languageSelect) {
                            languageSelect.value = data.language;
                        }
                        if (data.themeColor && themeColorSelect) {
                            themeColorSelect.value = data.themeColor;
                        }
                        
                        const currencySelect = document.getElementById('prefCurrency');
                        if (data.currency && currencySelect) {
                            currencySelect.value = data.currency;
                        }
                        
                        const dashSelect = document.getElementById('prefDashboard');
                        if (dashSelect && data.dashboards) {
                            dashSelect.innerHTML = '<option value="">Standard View (Default)</option>';
                            data.dashboards.forEach(d => {
                                const opt = document.createElement('option');
                                opt.value = d.slug;
                                opt.textContent = d.name;
                                dashSelect.appendChild(opt);
                            });
                            
                            if (data.preferredDashboard) {
                                dashSelect.value = data.preferredDashboard;
                            }
                        }
                        
                    } else {
                        showAlert('Failed to load user preferences.', false);
                    }
                } catch (err) {
                    console.error('Error fetching preferences:', err);
                    showAlert('An unexpected error occurred while loading preferences.', false);
                } finally {
                    loadingIndicator.classList.add('hidden');
                    fieldsContainer.classList.remove('hidden');
                    saveBtn.disabled = false;
                }
            }

            async function savePreferences(e) {
                e.preventDefault();
                hideAlert();
                saveBtn.disabled = true;
                saveSpinner.classList.remove('hidden');
                saveText.textContent = 'Saving...';

                const payload = {
                    language: languageSelect.value,
                    themeColor: themeColorSelect.value
                };

                try {
                    const response = await fetch('/UserPreference/Update', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        showAlert('Preferences updated successfully!', true);
                        setTimeout(() => {
                            closeModal();
                        }, 900);
                    } else {
                        showAlert('Failed to save preferences. Please try again.', false);
                    }
                } catch (err) {
                    console.error('Error saving preferences:', err);
                    showAlert('Error updating preferences.', false);
                } finally {
                    saveBtn.disabled = false;
                    saveSpinner.classList.add('hidden');
                    saveText.textContent = 'Save Preferences';
                }
            }

            gearBtn.addEventListener('click', function (e) {
                e.preventDefault();
                openModal();
            });

            if (closeBtn) closeBtn.addEventListener('click', closeModal);
            if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
            if (backdrop) backdrop.addEventListener('click', closeModal);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                    closeModal();
                }
            });

            if (form) {
                form.addEventListener('submit', savePreferences);
            }
        })();
    </script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const sb = document.getElementById("sidebar");
        const toggleBtn = document.getElementById("sidebarToggle");
        
        // Restore state from localStorage
        if(localStorage.getItem('sidebarCollapsed') === 'true') {
            sb.classList.add("collapsed");
        }

        toggleBtn?.addEventListener("click", function() {
            sb.classList.toggle("collapsed");
            localStorage.setItem('sidebarCollapsed', sb.classList.contains("collapsed"));
        });
    });
</script>


    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').then(reg => {
                    console.log('ServiceWorker registration successful with scope: ', reg.scope);
                }).catch(err => {
                    console.error('ServiceWorker registration failed: ', err);
                });
            });
        }
    </script>
</body>
</html>