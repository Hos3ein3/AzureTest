@model AzureTest.MVC.Models.HomeDashboardViewModel

<!-- Expenses Widget -->
<div class="col-span-1 bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-slate-800 m-0">Recent Expenses</h5>
        <a asp-controller="Expense" asp-action="Index" class="text-xs text-brand-600 hover:text-brand-500 font-medium">Manage &rarr;</a>
    </div>
    <div class="p-6 flex-1">
        @if (!Model.RecentExpenses.Any())
        {
            <div class="text-center text-slate-400 mt-6">
                <i class="fa-solid fa-receipt text-3xl mb-2 block"></i>
                <p class="text-sm">No recent expenses.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var e in Model.RecentExpenses)
                {
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-50 text-slate-600 flex items-center justify-center flex-shrink-0 border border-slate-200">
                            <i class="fa-solid fa-credit-card"></i>
                        </div>
                        <div class="flex-1 truncate">
                            <p class="text-sm font-medium text-slate-700 truncate">@e.CategoryName</p>
                            <p class="text-xs text-slate-500 truncate" title="@e.Description">@e.Description</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-bold text-red-600">-@e.Amount.ToString("C")</p>
                            <p class="text-xs text-slate-400">@e.Date.ToString("MMM dd")</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
