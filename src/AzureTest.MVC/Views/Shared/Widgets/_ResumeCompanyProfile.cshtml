@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
<div class="h-full w-full bg-white rounded-xl shadow-sm ring-1 ring-slate-200 p-5 flex items-center">
    <div class="h-14 w-14 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center mr-4 shrink-0 shadow-inner">
        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
    </div>
    <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase mb-1">Company Profile</p>
        <h3 class="text-lg font-bold text-slate-800 truncate" title="@(Model.CompanyName ?? "Unknown Company")">
            @(Model.CompanyName ?? "Unknown Company")
        </h3>
        <p class="text-sm font-medium text-slate-600 truncate">@Model.PositionTitle</p>
        
        <div class="flex items-center mt-2 text-xs text-slate-500">
            <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span class="truncate">@(string.IsNullOrEmpty(Model.Location) ? "Remote / Unspecified" : Model.Location)</span>
        </div>
    </div>
</div>
