@model AzureTest.MVC.Models.HomeDashboardViewModel

<!-- Debt Person Chart -->
<div class="col-span-1 lg:col-span-6">
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
            <h5 class="text-lg font-semibold text-slate-800 m-0">Debts by Person</h5>
            <i class="fa-solid fa-chart-bar text-slate-400"></i>
        </div>
        <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
            @if (Model.DebtsByPerson.Any())
            {
                <canvas id="debtChart"></canvas>
            }
            else
            {
                <p class="text-slate-400">No debt data available.</p>
            }
        </div>
    </div>
</div>
