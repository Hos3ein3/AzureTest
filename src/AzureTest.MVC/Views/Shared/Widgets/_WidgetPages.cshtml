@using AzureTest.Application.Interfaces.Services
@inject ICurrentUser CurrentUser
@model AzureTest.MVC.Models.HomeDashboardViewModel

@{
    var userId = CurrentUser.Id;
}

<!-- Published Pages Widget -->
<div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 p-6 flex flex-col justify-between hover:border-slate-300 transition-all">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-slate-900 tracking-tight">Published Pages & Docs</h3>
                    @if (Model.UnreadPagesCount > 0)
                    {
                        <span class="px-2 py-0.5 text-2xs font-extrabold rounded-full bg-emerald-500 text-white shadow-xs">
                            @Model.UnreadPagesCount Unread
                        </span>
                    }
                </div>
                <p class="text-xs text-slate-500">Guides, updates, and community documentation</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            @if (Model.IsAdmin)
            {
                <a asp-controller="Pages" asp-action="Index" class="text-xs font-semibold text-brand-600 hover:text-brand-700">
                    Manage &rarr;
                </a>
            }
        </div>
    </div>

    <div class="divide-y divide-slate-100 py-2 flex-1">
        @if (Model.RecentPages != null && Model.RecentPages.Any())
        {
            @foreach (var pageItem in Model.RecentPages)
            {
                var isRead = userId != Guid.Empty && pageItem.ReadBy != null && pageItem.ReadBy.Contains(userId);
                <div class="py-3 flex items-center justify-between gap-3 group">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <i class="fa-regular fa-file-lines text-xs text-slate-400 group-hover:text-emerald-600 transition-colors"></i>
                            @if (!isRead)
                            {
                                <span class="px-1.5 py-0.5 text-3xs font-bold uppercase tracking-wider rounded bg-emerald-500 text-white shrink-0 shadow-xs">
                                    New
                                </span>
                            }
                            <a href="@Url.Action("Read", "Pages", new { slug = pageItem.Slug })" 
                               class="text-sm font-semibold text-slate-800 hover:text-brand-600 transition truncate">
                                @pageItem.Title
                            </a>
                        </div>
                        <div class="flex items-center gap-4 text-2xs text-slate-400 mt-1 pl-5">
                            <span><i class="fa-regular fa-calendar mr-1"></i>@pageItem.CreatedAt.ToString("MMM dd, yyyy")</span>
                            <span><i class="fa-regular fa-thumbs-up mr-1 text-emerald-500"></i>@(pageItem.LikedBy?.Count ?? 0)</span>
                            <span><i class="fa-regular fa-comment mr-1 text-blue-500"></i>@(pageItem.Comments?.Count ?? 0)</span>
                        </div>
                    </div>
                    <a href="@Url.Action("Read", "Pages", new { slug = pageItem.Slug })"
                       class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition shrink-0">
                        Read
                    </a>
                </div>
            }
        }
        else
        {
            <div class="text-center py-8 text-slate-400">
                <i class="fa-regular fa-folder-open text-3xl mb-2 block text-slate-300"></i>
                <p class="text-xs">No published pages found.</p>
            </div>
        }
    </div>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-2xs text-slate-500">
        <span>Total Published: @(Model.RecentPages?.Count ?? 0)</span>
        <span>Click any page to read and mark as read</span>
    </div>
</div>
