@model AzureTest.MVC.Models.HomeDashboardViewModel
@{
    string FormatBytes(long bytes)
    {
        string[] suffix = { "B", "KB", "MB", "GB", "TB" };
        int i = 0;
        double dblSByte = bytes;
        while (bytes / 1024 > 0 && i < suffix.Length - 1)
        {
            dblSByte = bytes / 1024.0;
            bytes /= 1024;
            i++;
        }
        return $"{dblSByte:0.##} {suffix[i]}";
    }
}

<!-- Stat Card: Occupied Storage -->
<div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 flex items-center hover:shadow-md transition-shadow">
    <div class="h-14 w-14 rounded-xl bg-sky-50 flex items-center justify-center flex-shrink-0">
        <i class="fa-solid fa-database text-sky-500 text-2xl"></i>
    </div>
    <div class="ml-4 truncate">
        <p class="text-sm font-medium text-slate-500 truncate">Occupied Storage</p>
        <p class="text-3xl font-bold text-slate-800">@FormatBytes(Model.Analytics.OccupiedStorage)</p>
    </div>
</div>
