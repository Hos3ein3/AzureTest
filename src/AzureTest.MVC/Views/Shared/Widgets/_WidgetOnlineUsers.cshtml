@model AzureTest.MVC.Models.HomeDashboardViewModel

@if (Model.IsAdmin)
{
    <!-- Stat Card: Online Users (Admin Only - Live via SignalR) -->
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700/60 p-6 flex items-center hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="h-14 w-14 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 relative">
            <i class="fa-solid fa-users-viewfinder text-2xl"></i>
            <span class="absolute top-1 right-1 flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
        </div>
        <div class="ml-4 truncate">
            <div class="flex items-center gap-2">
                <p class="text-sm font-medium text-slate-400 dark:text-slate-400 truncate">Online Users</p>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300">
                    LIVE
                </span>
            </div>
            <p id="onlineUsersCountDisplay" class="text-3xl font-bold text-slate-800 dark:text-white transition-all duration-300">
                @Model.OnlineUsersCount
            </p>
        </div>
    </div>
}
