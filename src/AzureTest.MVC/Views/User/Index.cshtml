@model AzureTest.MVC.ViewModels.Users.UserListViewModel
@{
    ViewData["Title"] = "User Management";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Administration", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Users", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "User Management",
        Subtitle = "Manage system accounts, assign security roles, and enforce security policies.",
        Icon = "fa-solid fa-users",
        Badge = $"{Model.Users.TotalCount} Users",
        ActionText = "Add User",
        ActionUrl = "/User/Create",
        ActionIcon = "fa-solid fa-user-plus",
        Breadcrumbs = breadcrumbs
    };
    
    string GetSortLink(string sortBy, string label)
    {
        var isCurrentSort = Model.SortBy?.Equals(sortBy, StringComparison.OrdinalIgnoreCase) ?? (sortBy == "FullName");
        var desc = isCurrentSort ? !Model.SortDescending : false;
        var icon = isCurrentSort ? (Model.SortDescending ? "fa-sort-down text-brand-600" : "fa-sort-up text-brand-600") : "fa-sort text-slate-300";
        var url = $"?PageNumber=1&PageSize={Model.PageSize}&SearchTerm={Model.SearchTerm}&Role={Model.Role}&SortBy={sortBy}&SortDescending={desc}";
        
        return $@"<a href=""{url}"" class=""group inline-flex items-center gap-1.5 hover:text-brand-600 transition-colors""><span>{label}</span> <i class=""fa-solid {icon}""></i></a>";
    }

    string GetPageUrl(int pageNumber)
    {
        return $"?PageNumber={pageNumber}&PageSize={Model.PageSize}&SearchTerm={Model.SearchTerm}&Role={Model.Role}&SortBy={Model.SortBy}&SortDescending={Model.SortDescending}";
    }
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<!-- Filter Users Card -->
<div class="mb-6 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs">
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div>
                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Search</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@Model.SearchTerm" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="Search by name, email..." />
                </div>
            </div>
            
            <div>
                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Role</label>
                <select asp-for="Role" asp-items="Model.AvailableRoles" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white">
                    <option value="">All Roles</option>
                </select>
            </div>

            <div>
                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Page Size</label>
                <select name="PageSize" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (Model.PageSize == size)
                        {
                            <option value="@size" selected>@size items per page</option>
                        }
                        else
                        {
                            <option value="@size">@size items per page</option>
                        }
                    }
                </select>
            </div>
            
            <div class="flex items-end gap-2">
                <button type="submit" class="flex-1 inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-filter"></i> Apply
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-xs font-semibold shadow-2xs transition-colors" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-between gap-3 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <p class="text-xs font-semibold text-emerald-800">@TempData["Success"]</p>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 text-xs" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200/80 flex items-center justify-between gap-3 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <p class="text-xs font-semibold text-rose-800">@TempData["Error"]</p>
        </div>
        <button type="button" class="text-rose-500 hover:text-rose-700 text-xs" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200/80 uppercase tracking-wider text-2xs">
                <tr>
                    <th scope="col" class="px-5 py-3.5">@Html.Raw(GetSortLink("FullName", "Name"))</th>
                    <th scope="col" class="px-5 py-3.5">@Html.Raw(GetSortLink("Email", "Email"))</th>
                    <th scope="col" class="px-5 py-3.5">@Html.Raw(GetSortLink("Roles", "Roles"))</th>
                    <th scope="col" class="px-5 py-3.5 text-center">Status</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (!Model.Users.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="p-8">
                            <partial name="UiComponents/_EmptyState" model='new AzureTest.MVC.Models.EmptyStateModel { Title = "No Users Found", Description = "No accounts matched your filter criteria.", Icon = "fa-solid fa-user-slash", ActionText = "Add New User", ActionUrl = "/User/Create" }' />
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users.Items)
                {
                    <tr class="hover:bg-slate-50/70 transition-colors @(user.IsLockedOut ? "opacity-60 bg-slate-50/40" : "")">
                        <td class="px-5 py-3.5 whitespace-nowrap">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-brand-50 border border-brand-100 text-brand-700 flex items-center justify-center font-bold text-xs shrink-0">
                                    @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 text-xs">@user.FullName</div>
                                    <div class="text-3xs text-slate-400 font-mono">@user.Id.ToString().Substring(0, 8)...</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap">
                            <div class="text-xs font-medium text-slate-800">@user.Email</div>
                            <div class="text-3xs mt-0.5">
                                @if (user.EmailConfirmed)
                                {
                                    <span class="inline-flex items-center gap-1 text-emerald-600 font-semibold">
                                        <i class="fa-solid fa-circle-check text-3xs"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-amber-600 font-semibold">
                                        <i class="fa-solid fa-circle-exclamation text-3xs"></i> Unverified
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="px-5 py-3.5">
                            <div class="flex flex-wrap gap-1.5">
                                @if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-2xs font-semibold @(role == "Admin" ? "bg-purple-50 text-purple-700 border border-purple-200/80" : "bg-slate-100 text-slate-700 border border-slate-200")">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-2xs text-slate-400 italic">None</span>
                                }
                            </div>
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap text-center">
                            @if (user.IsLockedOut)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-rose-50 text-rose-700 border border-rose-200/80">
                                    <i class="fa-solid fa-lock text-3xs"></i> Locked
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                    <i class="fa-solid fa-check text-3xs"></i> Active
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap text-right">
                            <div class="inline-flex items-center gap-1">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="p-2 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-slate-100 transition-colors" title="Edit Profile">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-action="ManageRoles" asp-route-id="@user.Id" class="p-2 rounded-lg text-slate-400 hover:text-purple-600 hover:bg-slate-100 transition-colors" title="Manage Roles">
                                    <i class="fa-solid fa-user-shield"></i>
                                </a>
                                <a asp-controller="UserPermission" asp-action="Index" asp-route-userId="@user.Id" class="p-2 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-slate-100 transition-colors" title="Direct User Permissions">
                                    <i class="fa-solid fa-user-gear"></i>
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-controller="Tenant" asp-action="SwitchTenant" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetTenantId" value="@user.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="p-2 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-slate-100 transition-colors" title="Switch Workspace (Impersonate)">
                                            <i class="fa-solid fa-right-left"></i>
                                        </button>
                                    </form>
                                }
                                
                                @if (user.IsLockedOut)
                                {
                                    <form asp-action="UnlockUser" asp-route-id="@user.Id" method="post" class="inline" onsubmit="return confirm('Unlock user @user.Email?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-2 rounded-lg text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 transition-colors" title="Unlock User">
                                            <i class="fa-solid fa-unlock"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" onclick="openLockUserModal('@user.Id', '@(user.FullName ?? user.Email)', '@user.Email')" class="p-2 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 transition-colors" title="Lock User">
                                        <i class="fa-solid fa-lock"></i>
                                    </button>
                                }

                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to permanently delete this user? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-2 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors" title="Delete User">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Users.TotalPages > 1)
    {
        var paginationModel = new AzureTest.MVC.Models.PaginationModel
        {
            CurrentPage = Model.Users.PageNumber,
            TotalPages = Model.Users.TotalPages,
            PageSize = Model.Users.PageSize,
            TotalItems = Model.Users.TotalCount,
            BaseUrl = "/User/Index",
            RouteParams = new Dictionary<string, string>
            {
                { "SearchTerm", Model.SearchTerm ?? "" },
                { "Role", Model.Role ?? "" },
                { "SortBy", Model.SortBy ?? "" },
                { "SortDescending", Model.SortDescending.ToString() },
                { "PageSize", Model.PageSize.ToString() }
            }
        };
        <partial name="UiComponents/_Pagination" model="paginationModel" />
    }
</div>

<!-- Lock User Modal -->
<div id="lockUserModal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl max-w-lg w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-amber-50/50">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-user-lock"></i>
                </div>
                <div>
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider">Lock User Account</h3>
                    <p class="text-2xs text-slate-500">Specify lockout duration or apply permanent lock</p>
                </div>
            </div>
            <button type="button" onclick="closeLockUserModal()" class="w-7 h-7 rounded-lg hover:bg-slate-200/60 text-slate-400 hover:text-slate-600 flex items-center justify-center text-xs">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="lockUserForm" asp-action="LockUser" method="post" class="p-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" id="lockUserId" name="id" />
            <input type="hidden" id="lockIsPermanent" name="isPermanent" value="false" />

            <!-- User Context Pill -->
            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between">
                <div>
                    <div id="lockUserName" class="text-xs font-bold text-slate-800"></div>
                    <div id="lockUserEmail" class="text-2xs text-slate-500 font-mono"></div>
                </div>
                <span class="text-3xs font-bold uppercase px-2 py-0.5 rounded-full bg-slate-200 text-slate-700">PostgreSQL UTC</span>
            </div>

            <!-- Quick Duration Presets -->
            <div>
                <label class="block text-2xs font-bold uppercase tracking-wider text-slate-500 mb-2">Quick Duration Presets</label>
                <div class="grid grid-cols-4 gap-2 text-2xs">
                    <button type="button" onclick="applyLockPreset(1)" class="py-2 px-2.5 rounded-xl border border-slate-200 hover:border-amber-400 bg-white hover:bg-amber-50/50 font-semibold text-slate-700 transition-colors text-center">
                        +1 Hour
                    </button>
                    <button type="button" onclick="applyLockPreset(24)" class="py-2 px-2.5 rounded-xl border border-slate-200 hover:border-amber-400 bg-white hover:bg-amber-50/50 font-semibold text-slate-700 transition-colors text-center">
                        +24 Hours
                    </button>
                    <button type="button" onclick="applyLockPreset(24 * 7)" class="py-2 px-2.5 rounded-xl border border-slate-200 hover:border-amber-400 bg-white hover:bg-amber-50/50 font-semibold text-slate-700 transition-colors text-center">
                        +7 Days
                    </button>
                    <button type="button" onclick="applyLockPreset(24 * 30)" class="py-2 px-2.5 rounded-xl border border-slate-200 hover:border-amber-400 bg-white hover:bg-amber-50/50 font-semibold text-slate-700 transition-colors text-center">
                        +30 Days
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Custom Date Picker -->
                <div class="relative">
                    <label class="block text-2xs font-bold uppercase tracking-wider text-slate-500 mb-1">Lock Until Date (UTC)</label>
                    <div class="relative">
                        <i class="fa-regular fa-calendar absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input id="lockDateInput" name="lockDate" type="date" required
                               class="w-full pl-8 pr-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500" />
                    </div>
                </div>

                <!-- Custom Time Picker -->
                <div class="relative">
                    <label class="block text-2xs font-bold uppercase tracking-wider text-slate-500 mb-1">Lock Until Time (UTC)</label>
                    <div class="relative">
                        <i class="fa-regular fa-clock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input id="lockTimeInput" name="lockTime" type="time" required
                               class="w-full pl-8 pr-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500" />
                    </div>
                </div>
            </div>

            <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-200 text-2xs text-amber-800 space-y-1">
                <div class="font-bold flex items-center gap-1.5 text-amber-900">
                    <i class="fa-solid fa-clock text-amber-600"></i> UTC Conversion Notice:
                </div>
                <p>The lockout timestamp will be stored as strict UTC in PostgreSQL. When the user logs in, access will be blocked until this timestamp elapses.</p>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <button type="button" onclick="submitPermanentLock()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-2xs font-bold transition-colors">
                    <i class="fa-solid fa-ban"></i> Permanent Lock
                </button>

                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeLockUserModal()" class="px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-2xs font-semibold">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-2xs font-bold shadow-2xs transition-colors">
                        <i class="fa-solid fa-lock"></i> Apply Lockout
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function openLockUserModal(userId, fullName, email) {
        document.getElementById('lockUserId').value = userId;
        document.getElementById('lockUserName').textContent = fullName;
        document.getElementById('lockUserEmail').textContent = email;
        document.getElementById('lockIsPermanent').value = 'false';

        // Default to +24 hours UTC
        applyLockPreset(24);

        document.getElementById('lockUserModal').classList.remove('hidden');
    }

    function closeLockUserModal() {
        document.getElementById('lockUserModal').classList.add('hidden');
    }

    function applyLockPreset(hours) {
        const now = new Date();
        const target = new Date(now.getTime() + (hours * 60 * 60 * 1000));

        // Format UTC date & time
        const yyyy = target.getUTCFullYear();
        const mm = String(target.getUTCMonth() + 1).padStart(2, '0');
        const dd = String(target.getUTCDate()).padStart(2, '0');
        const hh = String(target.getUTCHours()).padStart(2, '0');
        const min = String(target.getUTCMinutes()).padStart(2, '0');

        document.getElementById('lockDateInput').value = `${yyyy}-${mm}-${dd}`;
        document.getElementById('lockTimeInput').value = `${hh}:${min}`;
        document.getElementById('lockIsPermanent').value = 'false';
    }

    function submitPermanentLock() {
        if (confirm('Are you sure you want to permanently lock this user account?')) {
            document.getElementById('lockIsPermanent').value = 'true';
            document.getElementById('lockUserForm').submit();
        }
    }
</script>
