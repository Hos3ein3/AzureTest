<!-- Reset Password Modal Partial -->
<div id="resetPasswordModal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-2xl max-w-lg w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-brand-50/50">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div>
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider">Reset User Password</h3>
                    <p class="text-2xs text-slate-500">Set a new password or send a reset link</p>
                </div>
            </div>
            <button type="button" onclick="closeResetPasswordModal()" class="w-7 h-7 rounded-lg hover:bg-slate-200/60 text-slate-400 hover:text-slate-600 flex items-center justify-center text-xs">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="p-6 space-y-5">
            <!-- User Context Pill -->
            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between">
                <div>
                    <div id="resetUserName" class="text-xs font-bold text-slate-800"></div>
                    <div id="resetUserEmail" class="text-2xs text-slate-500 font-mono"></div>
                </div>
                <span class="text-3xs font-bold uppercase px-2 py-0.5 rounded-full bg-slate-200 text-slate-700">Admin Action</span>
            </div>

            <!-- Direct Password Reset Form -->
            <form id="resetPasswordForm" asp-controller="User" asp-action="ResetPassword" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetUserId" name="id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-2xs font-bold uppercase tracking-wider text-slate-500">New Password</label>
                        <button type="button" onclick="generateSecurePassword()" class="text-3xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1 transition-colors">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Generate Strong
                        </button>
                    </div>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input id="newPasswordInput" name="newPassword" type="password" required minlength="6"
                               class="w-full pl-8 pr-10 py-2 rounded-xl border border-slate-300 text-xs font-medium text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Minimum 6 characters" />
                        <button type="button" onclick="togglePasswordVisibility('newPasswordInput', 'newPasswordEye')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
                            <i id="newPasswordEye" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label class="block text-2xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Confirm New Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock-check absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input id="confirmPasswordInput" name="confirmPassword" type="password" required minlength="6"
                               class="w-full pl-8 pr-10 py-2 rounded-xl border border-slate-300 text-xs font-medium text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Re-type new password" />
                        <button type="button" onclick="togglePasswordVisibility('confirmPasswordInput', 'confirmPasswordEye')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
                            <i id="confirmPasswordEye" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeResetPasswordModal()" class="px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-2xs font-semibold">
                        Cancel
                    </button>
                    <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-2xs font-bold shadow-2xs transition-colors">
                        <i class="fa-solid fa-check"></i> Set Password Now
                    </button>
                </div>
            </form>

            <!-- Divider -->
            <div class="relative py-1">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative flex justify-center text-3xs uppercase font-bold">
                    <span class="bg-white px-3 text-slate-400">Or dispatch via email</span>
                </div>
            </div>

            <!-- Email Reset Link Option -->
            <form id="sendResetEmailForm" asp-controller="User" asp-action="SendPasswordResetEmail" method="post" class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
                @Html.AntiForgeryToken()
                <input type="hidden" id="emailResetUserId" name="id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <div>
                    <div class="text-xs font-bold text-slate-800">Email Reset Link</div>
                    <div class="text-3xs text-slate-500">Sends instructions and secure token link to user inbox</div>
                </div>
                <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-brand-200 bg-brand-50 hover:bg-brand-100 text-brand-700 text-2xs font-bold transition-colors">
                    <i class="fa-solid fa-paper-plane"></i> Send Email
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function openResetPasswordModal(userId, fullName, email) {
        document.getElementById('resetUserId').value = userId;
        document.getElementById('emailResetUserId').value = userId;
        document.getElementById('resetUserName').textContent = fullName;
        document.getElementById('resetUserEmail').textContent = email;
        document.getElementById('newPasswordInput').value = '';
        document.getElementById('confirmPasswordInput').value = '';
        document.getElementById('resetPasswordModal').classList.remove('hidden');
    }

    function closeResetPasswordModal() {
        document.getElementById('resetPasswordModal').classList.add('hidden');
    }

    function togglePasswordVisibility(inputId, eyeId) {
        const input = document.getElementById(inputId);
        const eye = document.getElementById(eyeId);
        if (input.type === 'password') {
            input.type = 'text';
            eye.classList.remove('fa-eye');
            eye.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            eye.classList.remove('fa-eye-slash');
            eye.classList.add('fa-eye');
        }
    }

    function generateSecurePassword() {
        const charsUpper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const charsLower = "abcdefghjkmnpqrstuvwxyz";
        const charsDigits = "23456789";
        const charsSpecial = "!@@#$%^&*()_+~=";
        const all = charsUpper + charsLower + charsDigits + charsSpecial;
        
        let pwd = "";
        pwd += charsUpper[Math.floor(Math.random() * charsUpper.length)];
        pwd += charsLower[Math.floor(Math.random() * charsLower.length)];
        pwd += charsDigits[Math.floor(Math.random() * charsDigits.length)];
        pwd += charsSpecial[Math.floor(Math.random() * charsSpecial.length)];
        for (let i = 4; i < 14; i++) {
            pwd += all[Math.floor(Math.random() * all.length)];
        }
        pwd = pwd.split('').sort(() => 0.5 - Math.random()).join('');

        const newPass = document.getElementById('newPasswordInput');
        const confPass = document.getElementById('confirmPasswordInput');
        newPass.type = 'text';
        confPass.type = 'text';
        newPass.value = pwd;
        confPass.value = pwd;

        const eye1 = document.getElementById('newPasswordEye');
        if (eye1) {
            eye1.classList.remove('fa-eye');
            eye1.classList.add('fa-eye-slash');
        }
        const eye2 = document.getElementById('confirmPasswordEye');
        if (eye2) {
            eye2.classList.remove('fa-eye');
            eye2.classList.add('fa-eye-slash');
        }
    }
</script>
