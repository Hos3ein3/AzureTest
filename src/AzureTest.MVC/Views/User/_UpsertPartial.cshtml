@model AzureTest.MVC.ViewModels.Users.IUserFormViewModel

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
    <div>
        <label asp-for="FirstName" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">First Name <span class="text-rose-500">*</span></label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-user"></i>
            </div>
            <input asp-for="FirstName" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="e.g. John" />
        </div>
        <span asp-validation-for="FirstName" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>
    <div>
        <label asp-for="LastName" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Last Name <span class="text-rose-500">*</span></label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-user"></i>
            </div>
            <input asp-for="LastName" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="e.g. Doe" />
        </div>
        <span asp-validation-for="LastName" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>
</div>
