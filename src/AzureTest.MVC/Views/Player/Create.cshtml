@model AzureTest.Application.FootballFantasy.Commands.CreatePlayerCommand
@{
    ViewData["Title"] = "Add Player";
    var countries = ViewBag.Countries as List<AzureTest.Contracts.DTOs.FootballFantasy.CountryDto>;
}

<div class="max-w-2xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Players</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">New</span>
    </div>
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Add Football Player</h1>
</div>

<div class="max-w-2xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="FirstName" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">First Name</label>
                <input asp-for="FirstName" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="LastName" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Last Name</label>
                <input asp-for="LastName" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
        </div>

        <div>
            <label asp-for="DisplayName" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Display Name</label>
            <input asp-for="DisplayName" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
            <span asp-validation-for="DisplayName" class="text-xs text-rose-500"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Position" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Position</label>
                <select asp-for="Position" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3">
                    <option value="1">Goalkeeper</option>
                    <option value="2">Defender</option>
                    <option value="3">Midfielder</option>
                    <option value="4">Forward</option>
                </select>
            </div>
            <div>
                <label asp-for="CountryId" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Nationality</label>
                <select asp-for="CountryId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required>
                    <option value="">Select Country</option>
                    @if (countries != null)
                    {
                        foreach (var c in countries)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="CountryId" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="InitialPrice" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Initial Fantasy Price (€M)</label>
                <input asp-for="InitialPrice" type="number" step="0.5" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="PhotoUrl" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Photo URL</label>
                <input asp-for="PhotoUrl" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" placeholder="https://..." />
            </div>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-700">
            <a asp-action="Index" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-800">Cancel</a>
            <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm">Save Player</button>
        </div>
    </form>
</div>
