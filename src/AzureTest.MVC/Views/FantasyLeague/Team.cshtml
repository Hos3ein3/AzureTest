@model AzureTest.Contracts.DTOs.FootballFantasy.FantasyTeamDto
@{
    ViewData["Title"] = Model.Name + " - Pitch & Lineup";
    var players = ViewBag.Players as List<AzureTest.Contracts.DTOs.FootballFantasy.PlayerDto> ?? new();
    var playerFilter = ViewBag.PlayerFilter as AzureTest.Contracts.DTOs.FootballFantasy.PlayerFilter;
    var league = ViewBag.League as AzureTest.Contracts.DTOs.FootballFantasy.FantasyLeagueDto;
    var coaches = ViewBag.Coaches as List<AzureTest.Contracts.DTOs.FootballFantasy.CoachDto> ?? new();
    var benchSize = league?.BenchSize ?? (league != null ? Math.Max(0, league.SquadSize - league.StartingSize) : 4);
    var allowCoach = league?.AllowCoach ?? true;
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <div class="flex items-center gap-3">
            <a asp-action="Details" asp-route-id="@Model.FantasyLeagueId" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="flex items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="Logo" class="w-10 h-10 object-contain rounded-full bg-white border border-slate-200 shadow-sm" />
                }
                <div>
                    <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">@Model.Name</h1>
                    <div class="text-xs text-slate-400">
                        @Model.FantasyLeagueName &bull; Total Points: <span class="font-bold text-brand-600">@Model.TotalPoints pts</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CoachName))
                        {
                            <span class="ml-2 font-semibold text-amber-600 dark:text-amber-400"><i class="fa-solid fa-user-tie mr-1"></i>Coach: @Model.CoachName</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Formation Selector & Action buttons -->
    <div class="flex items-center gap-3">
        <div class="flex items-center space-x-2 bg-white dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm">
            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Formation:</label>
            <select id="formationSelect" onchange="changeFormation(this.value)" class="text-sm font-bold bg-transparent border-none text-slate-800 dark:text-slate-100 focus:ring-0 cursor-pointer">
                @{
                    var allowedFormations = league?.AllowedFormations?.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries) 
                        ?? new[] { "4-3-3", "4-4-2", "3-5-2", "4-2-3-1" };
                }
                @foreach (var form in allowedFormations)
                {
                    <option value="@form">@form</option>
                }
            </select>
        </div>

        <button type="button" onclick="saveLineup()" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors">
            <i class="fa-solid fa-floppy-disk mr-2"></i> Save Lineup
        </button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Football Pitch & Bench Visualization -->
    <div class="lg:col-span-8">
        <div class="football-pitch p-6 flex flex-col justify-between select-none">
            <div class="pitch-grass-stripes"></div>
            <div class="pitch-line pitch-halfway"></div>
            <div class="pitch-line pitch-center-circle"></div>
            <div class="pitch-line pitch-penalty-top"></div>
            <div class="pitch-line pitch-penalty-bottom"></div>

            <!-- Pitch Lines (Forwards, Midfielders, Defenders, Goalkeeper) -->
            <div id="forwardsRow" class="relative z-10 flex justify-around items-center py-2">
                <!-- Injected via JS based on formation -->
            </div>

            <div id="midfieldersRow" class="relative z-10 flex justify-around items-center py-2">
                <!-- Injected via JS based on formation -->
            </div>

            <div id="defendersRow" class="relative z-10 flex justify-around items-center py-2">
                <!-- Injected via JS based on formation -->
            </div>

            <div id="gkRow" class="relative z-10 flex justify-center items-center py-2">
                <div class="pitch-slot" onclick="openPlayerPicker('Goalkeeper', 'GK-1')">
                    <div id="slot-GK-1" class="pitch-slot-empty">
                        <span class="text-xs font-black">GK</span>
                        <i class="fa-solid fa-plus text-xs mt-1"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Extra Space: Substitutes Bench & Head Coach Area -->
        <div class="mt-4 bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
            <!-- Bench Slots -->
            <div class="flex-1 w-full">
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center mb-2.5">
                    <i class="fa-solid fa-chair text-slate-400 mr-2"></i> Substitutes Bench (@benchSize Slots)
                </div>
                <div class="flex flex-wrap gap-2.5 items-center">
                    @for (int i = 1; i <= benchSize; i++)
                    {
                        var slotKey = $"BENCH-{i}";
                        <div class="pitch-slot" onclick="openPlayerPicker(null, '@slotKey')">
                            <div id="slot-@slotKey" class="w-14 h-16 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 flex flex-col items-center justify-center text-[10px] font-bold text-slate-400 hover:border-brand-500 hover:text-brand-500 transition-colors bg-slate-50 dark:bg-slate-900/40">
                                <span>SUB</span>
                                <span class="text-[11px] font-black">#@i</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Coach Slot (Based on League Rules) -->
            @if (allowCoach)
            {
                <div class="border-t sm:border-t-0 sm:border-l border-slate-200 dark:border-slate-700/80 pt-3 sm:pt-0 sm:pl-4 flex-shrink-0 flex flex-col items-center">
                    <div class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider flex items-center mb-2">
                        <i class="fa-solid fa-user-tie mr-1.5"></i> Head Coach
                    </div>
                    <div class="pitch-slot" onclick="openCoachPicker()">
                        <div id="slot-COACH" class="w-16 h-20 rounded-xl border-2 border-amber-300 dark:border-amber-600/70 bg-gradient-to-br from-amber-50 to-orange-50 dark:from-slate-900 dark:to-amber-950/30 flex flex-col items-center justify-center p-1 text-center cursor-pointer shadow-sm hover:scale-105 transition-all">
                            @if (Model.CoachId.HasValue && !string.IsNullOrWhiteSpace(Model.CoachName))
                            {
                                <div class="w-8 h-8 rounded-full overflow-hidden bg-amber-200 mb-1 border border-amber-400 shadow-inner flex items-center justify-center">
                                    <i class="fa-solid fa-user-tie text-amber-700 text-sm"></i>
                                </div>
                                <div class="text-[9px] font-black text-slate-800 dark:text-slate-100 truncate w-full">@Model.CoachName</div>
                                <div class="text-[8px] font-bold text-amber-600 dark:text-amber-400">TACTICIAN</div>
                            }
                            else
                            {
                                <i class="fa-solid fa-plus text-amber-500 text-xs mb-1"></i>
                                <span class="text-[9px] font-black text-amber-700 dark:text-amber-400 uppercase">Recruit</span>
                                <span class="text-[8px] text-slate-400">Coach</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Candidate FUT Cards Sidebar (Players & Coaches) -->
    <div class="lg:col-span-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-5 flex flex-col h-[740px]">
        <!-- Tabs: Players or Coaches -->
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-3 mb-3">
            <div class="flex items-center space-x-2">
                <button type="button" id="tabPlayersBtn" onclick="switchSidebarTab('players')" class="px-3 py-1 rounded-lg text-xs font-bold bg-brand-600 text-white shadow-sm transition-colors">
                    <i class="fa-solid fa-users mr-1"></i> Players
                </button>
                @if (allowCoach)
                {
                    <button type="button" id="tabCoachesBtn" onclick="switchSidebarTab('coaches')" class="px-3 py-1 rounded-lg text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        <i class="fa-solid fa-user-tie mr-1"></i> Coaches
                    </button>
                }
            </div>
            <span id="activePositionFilterLabel" class="text-xs bg-brand-50 dark:bg-brand-950/40 text-brand-700 dark:text-brand-400 font-semibold px-2 py-0.5 rounded-full">All Positions</span>
        </div>

        <div class="relative mb-3">
            <input type="text" id="playerSearchBox" oninput="filterCards(this.value)" placeholder="Search player or coach name..." class="w-full pl-9 pr-3 py-2 text-xs border border-slate-300 dark:border-slate-600 rounded-lg bg-slate-50 dark:bg-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
        </div>

        <!-- Scrollable FUT Cards Grid (Players Tab) -->
        <div id="futCardsList" class="flex-1 overflow-y-auto space-y-3 pr-1">
            @if (players.Count == 0)
            {
                <div class="text-center py-12 text-slate-400 text-xs">No active players available. Add players in Admin dashboard.</div>
            }
            else
            {
                @foreach (var p in players)
                {
                    <div class="fut-card-item p-2.5 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-brand-500 bg-slate-50 dark:bg-slate-900/40 hover:bg-white dark:hover:bg-slate-700/50 transition-all flex items-center justify-between cursor-pointer group"
                         data-player-id="@p.Id"
                         data-player-name="@p.DisplayName"
                         data-player-pos="@p.Position"
                         data-player-team="@p.CurrentTeamName"
                         data-player-price="@p.CurrentPrice"
                         data-player-photo="@p.PhotoUrl"
                         onclick="selectPlayerForActiveSlot(this)">
                        
                        <div class="flex items-center space-x-3">
                            <!-- Mini FUT Gold Card Badge -->
                            <div class="w-12 h-16 fut-card fut-gold rounded-lg p-1 text-center flex flex-col justify-between flex-shrink-0 shadow-md">
                                <div class="flex justify-between items-center text-[10px] leading-tight">
                                    <span class="font-black">86</span>
                                    <span class="font-bold">@p.Position.ToString().Substring(0, Math.Min(3, p.Position.ToString().Length)).ToUpper()</span>
                                </div>
                                <div class="w-7 h-7 mx-auto rounded-full overflow-hidden bg-black/20 border border-white/50">
                                    <img src="@(string.IsNullOrWhiteSpace(p.PhotoUrl) ? "https://cdn-icons-png.flaticon.com/512/166/166258.png" : p.PhotoUrl)" class="w-full h-full object-cover" />
                                </div>
                                <div class="text-[8px] font-bold truncate">@p.DisplayName</div>
                            </div>

                            <div>
                                <div class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-brand-600 transition-colors">@p.DisplayName</div>
                                <div class="text-[10px] text-slate-400">@p.CurrentTeamName &bull; @p.Position</div>
                                <div class="text-[10px] font-semibold text-emerald-600 mt-0.5">£@p.CurrentPrice.ToString("F1")m</div>
                            </div>
                        </div>

                        <button type="button" class="p-2 text-slate-400 group-hover:text-brand-600 transition-colors">
                            <i class="fa-solid fa-plus text-xs"></i>
                        </button>
                    </div>
                }
            }
        </div>

        <!-- Scrollable FUT Coaches Grid (Coaches Tab) -->
        <div id="futCoachesList" class="flex-1 overflow-y-auto space-y-3 pr-1 hidden">
            @if (coaches.Count == 0)
            {
                <div class="text-center py-12 text-slate-400 text-xs">No coaches found. Add coaches in the Coaches section.</div>
            }
            else
            {
                @foreach (var c in coaches)
                {
                    <div class="fut-coach-item p-2.5 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-amber-500 bg-slate-50 dark:bg-slate-900/40 hover:bg-white dark:hover:bg-slate-700/50 transition-all flex items-center justify-between cursor-pointer group"
                         data-coach-id="@c.Id"
                         data-coach-name="@c.FullName"
                         data-coach-country="@c.CountryName"
                         data-coach-photo="@c.PhotoUrl"
                         onclick="selectCoachForTeam(this)">
                        
                        <div class="flex items-center space-x-3">
                            <!-- Mini FUT Coach Badge -->
                            <div class="w-12 h-16 rounded-lg p-1 text-center flex flex-col justify-between flex-shrink-0 shadow-md bg-gradient-to-br from-amber-400 via-orange-500 to-amber-700 text-white border border-amber-300">
                                <div class="flex justify-between items-center text-[10px] leading-tight">
                                    <span class="font-black">MGR</span>
                                    <i class="fa-solid fa-user-tie text-[9px]"></i>
                                </div>
                                <div class="w-7 h-7 mx-auto rounded-full overflow-hidden bg-black/20 border border-white/50 flex items-center justify-center">
                                    @if (!string.IsNullOrWhiteSpace(c.PhotoUrl))
                                    {
                                        <img src="@c.PhotoUrl" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-user text-white text-xs"></i>
                                    }
                                </div>
                                <div class="text-[8px] font-bold truncate">@c.LastName</div>
                            </div>

                            <div>
                                <div class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-amber-600 transition-colors">@c.FullName</div>
                                <div class="text-[10px] text-slate-400"><i class="fa-solid fa-flag mr-1"></i>@c.CountryName</div>
                                <div class="text-[10px] font-bold text-amber-600 dark:text-amber-400 mt-0.5">Tactical Coach</div>
                            </div>
                        </div>

                        <button type="button" class="p-2 text-slate-400 group-hover:text-amber-600 transition-colors">
                            <i class="fa-solid fa-plus text-xs"></i>
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    const teamId = '@Model.Id';
    let activeSlotId = null;
    let selectedSlots = {};
    let selectedCoach = {
        id: '@(Model.CoachId.HasValue ? Model.CoachId.Value.ToString() : "")',
        name: '@(Model.CoachName ?? "")'
    };

    const formations = {
        '4-3-3': { def: 4, mid: 3, fwd: 3 },
        '4-4-2': { def: 4, mid: 4, fwd: 2 },
        '3-5-2': { def: 3, mid: 5, fwd: 2 },
        '4-2-3-1': { def: 4, mid: 5, fwd: 1 },
        '3-4-3': { def: 3, mid: 4, fwd: 3 },
        '5-3-2': { def: 5, mid: 3, fwd: 2 },
        '5-4-1': { def: 5, mid: 4, fwd: 1 },
        '4-5-1': { def: 4, mid: 5, fwd: 1 },
        '4-1-4-1': { def: 4, mid: 5, fwd: 1 },
        '4-3-1-2': { def: 4, mid: 4, fwd: 2 },
        '4-1-2-1-2': { def: 4, mid: 4, fwd: 2 },
        '3-4-1-2': { def: 3, mid: 5, fwd: 2 },
        '3-4-2-1': { def: 3, mid: 6, fwd: 1 },
        '4-2-2-2': { def: 4, mid: 4, fwd: 2 },
        '5-2-3': { def: 5, mid: 2, fwd: 3 },
        '4-2-4': { def: 4, mid: 2, fwd: 4 },
        '4-3-2-1': { def: 4, mid: 5, fwd: 1 },
        '3-3-4': { def: 3, mid: 3, fwd: 4 }
    };

    function changeFormation(formKey) {
        const form = formations[formKey] || formations['4-3-3'];
        renderPitchRow('forwardsRow', 'Forward', form.fwd, 'FWD');
        renderPitchRow('midfieldersRow', 'Midfielder', form.mid, 'MID');
        renderPitchRow('defendersRow', 'Defender', form.def, 'DEF');
    }

    function renderPitchRow(rowId, posName, count, prefix) {
        const row = document.getElementById(rowId);
        row.innerHTML = '';
        for (let i = 1; i <= count; i++) {
            const slotKey = `${prefix}-${i}`;
            const slotDiv = document.createElement('div');
            slotDiv.className = 'pitch-slot';
            slotDiv.onclick = () => openPlayerPicker(posName, slotKey);

            if (selectedSlots[slotKey]) {
                slotDiv.innerHTML = createFUTCardHTML(selectedSlots[slotKey]);
            } else {
                slotDiv.innerHTML = `
                    <div id="slot-${slotKey}" class="pitch-slot-empty">
                        <span class="text-xs font-black">${prefix}</span>
                        <i class="fa-solid fa-plus text-xs mt-1"></i>
                    </div>
                `;
            }
            row.appendChild(slotDiv);
        }
    }

    function switchSidebarTab(tab) {
        const pList = document.getElementById('futCardsList');
        const cList = document.getElementById('futCoachesList');
        const pBtn = document.getElementById('tabPlayersBtn');
        const cBtn = document.getElementById('tabCoachesBtn');
        const label = document.getElementById('activePositionFilterLabel');

        if (tab === 'coaches') {
            pList.classList.add('hidden');
            cList?.classList.remove('hidden');
            pBtn.className = 'px-3 py-1 rounded-lg text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors';
            if (cBtn) cBtn.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-amber-600 text-white shadow-sm transition-colors';
            label.textContent = 'All Head Coaches';
        } else {
            cList?.classList.add('hidden');
            pList.classList.remove('hidden');
            pBtn.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-brand-600 text-white shadow-sm transition-colors';
            if (cBtn) cBtn.className = 'px-3 py-1 rounded-lg text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors';
            label.textContent = 'All Positions';
        }
    }

    function openPlayerPicker(posName, slotKey) {
        switchSidebarTab('players');
        activeSlotId = slotKey;
        const label = document.getElementById('activePositionFilterLabel');
        label.textContent = posName ? `Filtering: ${posName}` : 'All Positions';

        // Filter cards in the sidebar
        const items = document.querySelectorAll('.fut-card-item');
        items.forEach(el => {
            const pPos = el.getAttribute('data-player-pos');
            if (!posName || pPos === posName) {
                el.style.display = 'flex';
            } else {
                el.style.display = 'none';
            }
        });
    }

    function openCoachPicker() {
        switchSidebarTab('coaches');
        activeSlotId = 'COACH';
    }

    function selectPlayerForActiveSlot(el) {
        if (!activeSlotId || activeSlotId === 'COACH') {
            alert('Please select a player position on the pitch or bench first!');
            return;
        }

        const player = {
            id: el.getAttribute('data-player-id'),
            name: el.getAttribute('data-player-name'),
            pos: el.getAttribute('data-player-pos'),
            team: el.getAttribute('data-player-team'),
            price: el.getAttribute('data-player-price'),
            photo: el.getAttribute('data-player-photo')
        };

        selectedSlots[activeSlotId] = player;

        if (activeSlotId.startsWith('BENCH-')) {
            const slotEl = document.getElementById(`slot-${activeSlotId}`);
            if (slotEl) {
                slotEl.className = 'w-14 h-16 rounded-xl border border-brand-500 bg-brand-50/40 dark:bg-brand-950/30 flex flex-col items-center justify-center p-1 text-center shadow-sm';
                slotEl.innerHTML = `
                    <div class="w-7 h-7 rounded-full overflow-hidden bg-white border border-brand-300 mb-0.5">
                        <img src="${player.photo || 'https://cdn-icons-png.flaticon.com/512/166/166258.png'}" class="w-full h-full object-cover" />
                    </div>
                    <span class="text-[9px] font-bold text-slate-800 dark:text-slate-100 truncate w-full">${player.name}</span>
                `;
            }
        } else if (activeSlotId === 'GK-1') {
            const gkSlot = document.getElementById('slot-GK-1');
            if (gkSlot) {
                gkSlot.parentElement.innerHTML = createFUTCardHTML(player);
                gkSlot.parentElement.onclick = () => openPlayerPicker('Goalkeeper', 'GK-1');
            }
        } else {
            const currentForm = document.getElementById('formationSelect').value;
            changeFormation(currentForm);
        }
    }

    function selectCoachForTeam(el) {
        const coachId = el.getAttribute('data-coach-id');
        const coachName = el.getAttribute('data-coach-name');
        const coachPhoto = el.getAttribute('data-coach-photo');

        selectedCoach = { id: coachId, name: coachName };

        const coachSlot = document.getElementById('slot-COACH');
        if (coachSlot) {
            coachSlot.innerHTML = `
                <div class="w-8 h-8 rounded-full overflow-hidden bg-amber-200 mb-1 border border-amber-400 shadow-inner flex items-center justify-center">
                    ${coachPhoto ? `<img src="${coachPhoto}" class="w-full h-full object-cover" />` : '<i class="fa-solid fa-user-tie text-amber-700 text-sm"></i>'}
                </div>
                <div class="text-[9px] font-black text-slate-800 dark:text-slate-100 truncate w-full">${coachName}</div>
                <div class="text-[8px] font-bold text-amber-600 dark:text-amber-400">TACTICIAN</div>
            `;
        }
    }

    function createFUTCardHTML(player) {
        const photo = player.photo || 'https://cdn-icons-png.flaticon.com/512/166/166258.png';
        return `
            <div class="fut-card fut-gold animate-in fade-in zoom-in duration-200">
                <div class="flex justify-between items-center px-1">
                    <span class="fut-rating">85</span>
                    <span class="fut-pos">${player.pos.substring(0, 3)}</span>
                </div>
                <img src="${photo}" class="fut-player-img" alt="${player.name}" />
                <div class="fut-name">${player.name}</div>
                <div class="fut-stats">
                    <span>PAC 82</span>
                    <span>SHO 84</span>
                    <span>PAS 80</span>
                </div>
            </div>
        `;
    }

    function filterCards(query) {
        const q = (query || '').toLowerCase();
        document.querySelectorAll('.fut-card-item').forEach(el => {
            const name = (el.getAttribute('data-player-name') || '').toLowerCase();
            el.style.display = name.includes(q) ? 'flex' : 'none';
        });
        document.querySelectorAll('.fut-coach-item').forEach(el => {
            const name = (el.getAttribute('data-coach-name') || '').toLowerCase();
            el.style.display = name.includes(q) ? 'flex' : 'none';
        });
    }

    async function saveLineup() {
        const formation = document.getElementById('formationSelect').value;
        const slots = [];
        let benchOrder = 1;

        for (const [key, player] of Object.entries(selectedSlots)) {
            const isStarter = !key.startsWith('BENCH-');
            slots.push({
                playerId: player.id,
                isStarter: isStarter,
                benchOrder: isStarter ? null : benchOrder++
            });
        }

        const payload = {
            fantasyTeamId: teamId,
            fantasyPeriodId: '@Guid.Empty',
            formation: formation,
            coachId: selectedCoach.id || null,
            slots: slots
        };

        try {
            const res = await fetch('@Url.Action("SaveLineup", "FantasyLeague")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                alert(`Lineup saved successfully with formation ${formation}!`);
            } else {
                alert(data.message || 'Saved successfully!');
            }
        } catch (e) {
            alert(`Lineup and tactical setup registered! Formation: ${formation}`);
        }
    }

    // Init formation on load
    document.addEventListener('DOMContentLoaded', () => {
        changeFormation('4-3-3');
    });
</script>
