@model AzureTest.Contracts.DTOs.FootballFantasy.ManagerProfileDto
@{
    ViewData["Title"] = $"{Model.ManagerName} - Fantasy Profile";
}

<div class="container py-4">
    <!-- Profile Header Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-dark text-white">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-md-auto text-center mb-3 mb-md-0">
                    <div class="rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center shadow" style="width: 100px; height: 100px;">
                        <i class="bi bi-person-badge display-4"></i>
                    </div>
                </div>
                <div class="col-md">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="h3 fw-bold mb-0">@Model.ManagerName</h2>
                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i> Pro Manager</span>
                    </div>
                    <p class="text-white-50 mb-3">User ID: @Model.UserId</p>
                    <div class="d-flex flex-wrap gap-4">
                        <div>
                            <div class="fs-4 fw-bold text-warning">@Model.TotalCareerPoints.ToString("N0")</div>
                            <small class="text-white-50">Total Career Points</small>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-info">@Model.TotalTeamsCreated</div>
                            <small class="text-white-50">Teams Created</small>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-success">@Model.Achievements.Count</div>
                            <small class="text-white-50">Badges Unlocked</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Teams List -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-shield-shaded text-primary me-2"></i>Active Teams & Leagues</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.ActiveTeams.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-shield-x fs-1 opacity-50 mb-2"></i>
                            <p class="mb-0">No active fantasy teams found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var team in Model.ActiveTeams)
                            {
                                <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-light border p-2">
                                            <i class="bi bi-shield text-primary fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0">@team.Name</h6>
                                            <small class="text-muted">@team.FantasyLeagueName</small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
                                            @team.TotalPoints pts
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Badges & Achievements -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-award text-warning me-2"></i>Achievements Trophy Cabinet</h5>
                </div>
                <div class="card-body p-3">
                    @if (Model.Achievements.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-trophy fs-1 opacity-50 mb-2"></i>
                            <p class="mb-0">No badges unlocked yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var ach in Model.Achievements)
                            {
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3 border">
                                        <div class="rounded-circle bg-warning bg-opacity-25 d-flex align-items-center justify-content-center p-3" style="width: 50px; height: 50px;">
                                            <i class="bi @ach.BadgeIcon fs-4 text-warning"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold mb-1">@ach.Title</h6>
                                            <p class="text-muted small mb-0">@ach.Description</p>
                                            <small class="text-secondary opacity-75">Unlocked on @ach.UnlockedAt.ToString("MMM dd, yyyy")</small>
                                        </div>
                                        <span class="badge bg-warning bg-opacity-25 text-dark fw-bold">+@ach.PointsReward XP</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- League & Membership History Section -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-primary">
                        <i class="fa-solid fa-list-check me-2"></i> League Membership & History
                    </h5>
                    <span class="badge bg-light text-dark border">@Model.LeagueHistory.Count Leagues</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.LeagueHistory == null || !Model.LeagueHistory.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-solid fa-folder-open fs-2 mb-2 text-secondary opacity-50"></i>
                            <p class="mb-0">No fantasy league history on record yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="text-uppercase small text-muted">
                                        <th class="ps-4">League</th>
                                        <th>Role</th>
                                        <th>Joined Date</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model.LeagueHistory)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@entry.LeagueName</div>
                                                <span class="badge bg-secondary-subtle text-secondary small font-monospace">#@entry.LeagueTag</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@entry.Role</span>
                                            </td>
                                            <td>
                                                <span class="small text-muted">@entry.JoinedAt.ToString("MMM dd, yyyy")</span>
                                            </td>
                                            <td>
                                                @if (entry.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyMemberStatus.Active)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="fa-solid fa-check-circle me-1"></i> Active Member
                                                    </span>
                                                }
                                                else if (entry.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyMemberStatus.Left)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Left League
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">@entry.Status</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-action="Details" asp-route-id="@entry.LeagueId" class="btn btn-sm btn-outline-primary">
                                                    View League
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
