@model AzureTest.Contracts.DTOs.FootballFantasy.FantasyLeagueDto
@{
    ViewData["Title"] = Model.Name + " - Fantasy League";
    var userTeam = ViewBag.UserTeam as AzureTest.Contracts.DTOs.FootballFantasy.FantasyTeamDto;
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" alt="Logo" class="w-12 h-12 object-contain rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm" />
            }
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">@Model.Name</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 font-mono">
                        #@Model.LeagueTag
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold @(Model.Visibility == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Public ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400" : "bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400")">
                        @Model.Visibility
                    </span>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description provided for this league." : Model.Description)
                </p>
            </div>
        </div>
    </div>

    <div class="flex items-center gap-3">
        @if (Model.Mode == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueMode.Auction)
        {
            <a asp-action="Auction" asp-route-id="@Model.Id" class="inline-flex items-center px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors">
                <i class="fa-solid fa-gavel mr-2"></i> Enter Live Auction
            </a>
        }

        @if (userTeam != null)
        {
            <a asp-action="Team" asp-route-id="@userTeam.Id" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors">
                <i class="fa-solid fa-shirt mr-2"></i> Manage Lineup & Pitch
            </a>

            @if (Model.OwnerUserId != userTeam.UserId)
            {
                <form asp-action="Leave" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to leave this league? Your departure will be logged in your profile history.');" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 dark:hover:bg-rose-900/50 rounded-lg text-sm font-semibold transition-colors border border-rose-200 dark:border-rose-800/40">
                        <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i> Leave League
                    </button>
                </form>
            }
        }
        else if (Model.MaxMembers.HasValue && Model.MemberCount >= Model.MaxMembers.Value)
        {
            <span class="inline-flex items-center px-4 py-2 bg-slate-200 dark:bg-slate-700 text-slate-500 rounded-lg text-sm font-semibold cursor-not-allowed">
                <i class="fa-solid fa-ban mr-2"></i> League Full (@Model.MemberCount/@Model.MaxMembers)
            </span>
        }
        else
        {
            <a asp-action="Join" asp-route-id="@Model.Id" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors">
                <i class="fa-solid fa-plus mr-2"></i> Join League with Team
            </a>
        }
    </div>
</div>

@if (ViewBag.InviteLink is string inviteLink)
{
    <div class="mb-6 p-4 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/40 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-link text-amber-600 text-xl"></i>
            <div>
                <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">Private League Invite Link</div>
                <div class="text-xs text-slate-500 font-mono select-all">@inviteLink</div>
            </div>
        </div>
        <button type="button" onclick="navigator.clipboard.writeText('@inviteLink'); alert('Invite link copied to clipboard!');" class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors flex items-center">
            <i class="fa-solid fa-copy mr-1.5"></i> Copy Invite Link
        </button>
    </div>
}

<!-- League Highlights Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Starting Budget</div>
        <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-1">£@Model.Budget.ToString("F0")m</div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Squad / Starting</div>
        <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-1">@Model.SquadSize / @Model.StartingSize</div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Members</div>
        <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-1">
            @Model.MemberCount @(Model.Visibility == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Global ? "(Unlimited)" : (Model.MaxMembers.HasValue ? $"/ {Model.MaxMembers}" : ""))
        </div>
    </div>
    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Captain Multiplier</div>
        <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-1">@(Model.CaptainEnabled ? $"{Model.CaptainMultiplier:0.#}x" : "Disabled")</div>
    </div>
</div>

<!-- League Details & Standings Section -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center">
                <i class="fa-solid fa-trophy text-amber-500 mr-2"></i> 
                @(Model.Format == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.TotalPoints ? "Classic Standings & Leaderboard" :
                  Model.Format == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.HeadToHead ? "Head-to-Head (1v1) Matchups & Fixtures" :
                  Model.Format == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.Knockout ? "Knockout Cup Elimination Bracket" :
                  "Group Stages & Knockout Tournament")
            </h3>
            @if (Model.Format != AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.TotalPoints)
            {
                <form asp-action="InitializeTournament" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold shadow-sm transition-colors">
                        <i class="fa-solid fa-arrows-rotate mr-1"></i> Generate / Reset Matches
                    </button>
                </form>
            }
        </div>
        
        @if (userTeam != null)
        {
            <div class="mb-4 p-4 rounded-xl bg-brand-50/70 dark:bg-brand-950/30 border border-brand-200 dark:border-brand-800/50 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    @if (!string.IsNullOrWhiteSpace(userTeam.LogoUrl))
                    {
                        <img src="@userTeam.LogoUrl" alt="Logo" class="w-10 h-10 object-contain rounded-full bg-white border border-brand-300" />
                    }
                    else
                    {
                        <div class="w-10 h-10 rounded-full bg-brand-600 text-white flex items-center justify-center font-bold">
                            @userTeam.Name.Substring(0, Math.Min(2, userTeam.Name.Length)).ToUpper()
                        </div>
                    }
                    <div>
                        <div class="font-bold text-slate-900 dark:text-slate-100">@userTeam.Name (Your Team)</div>
                        <div class="text-xs text-slate-500">Credits Remaining: £@userTeam.CreditsLeft.ToString("F1")m</div>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-xl font-black text-brand-600">@userTeam.TotalPoints pts</div>
                    <a asp-action="Profile" asp-route-userId="@userTeam.UserId" class="text-xs text-brand-600 hover:underline">
                        <i class="fa-solid fa-user-circle mr-1"></i> View Manager Profile
                    </a>
                </div>
            </div>
        }

        @if (Model.Format == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.TotalPoints)
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            <th class="py-3 px-3">Rank</th>
                            <th class="py-3 px-3">Team</th>
                            <th class="py-3 px-3 text-right">Points</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">
                        <tr class="text-slate-700 dark:text-slate-300">
                            <td class="py-3 px-3 font-black text-amber-500">1</td>
                            <td class="py-3 px-3 font-semibold">Galactic Strikers</td>
                            <td class="py-3 px-3 text-right font-bold">84 pts</td>
                        </tr>
                        <tr class="text-slate-700 dark:text-slate-300">
                            <td class="py-3 px-3 font-black text-slate-400">2</td>
                            <td class="py-3 px-3 font-semibold">Apex Warriors FC</td>
                            <td class="py-3 px-3 text-right font-bold">78 pts</td>
                        </tr>
                        <tr class="text-slate-700 dark:text-slate-300">
                            <td class="py-3 px-3 font-black text-amber-700">3</td>
                            <td class="py-3 px-3 font-semibold">Thunder City</td>
                            <td class="py-3 px-3 text-right font-bold">72 pts</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else
        {
            var tournamentGroups = ViewBag.TournamentGroups as List<AzureTest.Contracts.DTOs.FootballFantasy.FantasyLeagueGroupDto> ?? new List<AzureTest.Contracts.DTOs.FootballFantasy.FantasyLeagueGroupDto>();
            if (tournamentGroups.Count == 0 || tournamentGroups.All(g => g.Matchups.Count == 0))
            {
                <div class="text-center py-8 text-slate-400">
                    <i class="fa-solid fa-calendar-days text-3xl opacity-50 mb-2"></i>
                    <p class="text-sm">No fixtures scheduled yet. Click "Generate Matches" above once teams have joined.</p>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    @foreach (var grp in tournamentGroups)
                    {
                        <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-slate-50/50 dark:bg-slate-900/30">
                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider mb-3">
                                <i class="fa-solid fa-futbol text-brand-600 mr-1.5"></i> @grp.Name
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                @foreach (var match in grp.Matchups)
                                {
                                    <div class="p-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl flex items-center justify-between">
                                        <div class="flex-1 font-semibold text-xs text-right pr-2">@match.HomeTeamName</div>
                                        <div class="px-2.5 py-1 bg-slate-100 dark:bg-slate-700 rounded-lg text-xs font-bold font-mono">
                                            @match.HomeScore - @match.AwayScore
                                        </div>
                                        <div class="flex-1 font-semibold text-xs text-left pl-2">@match.AwayTeamName</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- League Rules Card -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm p-6">
        <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4 flex items-center">
            <i class="fa-solid fa-scroll text-slate-400 mr-2"></i> League Rules & Specs
        </h3>
        
        <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">League Mode</span>
                <span class="font-bold text-amber-600 dark:text-amber-400">@Model.Mode</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Min Squad Size</span>
                <span class="font-semibold">@Model.MinSquadSize Players</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Unfinalized Kickout</span>
                <span class="font-semibold text-rose-600 dark:text-rose-400">@Model.KickoutType</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Player Diversity</span>
                <span class="font-semibold text-brand-600 dark:text-brand-400">@(Model.PoolScopeSummary ?? "Worldwide (All)")</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Allowed Formations</span>
                <span class="font-semibold text-right">@(Model.AllowedFormations ?? "4-3-3, 4-4-2, 3-5-2")</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Period Frequency</span>
                <span class="font-semibold">@Model.PeriodType</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Squad Selection Mode</span>
                <span class="font-semibold">@Model.SquadMode</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Starts At</span>
                <span class="font-semibold">@Model.StartsAt.ToString("yyyy-MM-dd")</span>
            </li>
            <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                <span class="text-slate-400">Ends At</span>
                <span class="font-semibold">@Model.EndsAt.ToString("yyyy-MM-dd")</span>
            </li>
            @if (!string.IsNullOrWhiteSpace(Model.JoinCode))
            {
                <li class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700/50">
                    <span class="text-slate-400">Join Code</span>
                    <span class="font-mono font-bold text-brand-600">@Model.JoinCode</span>
                </li>
            }
        </ul>

        @if (Model.ScoringRules != null && Model.ScoringRules.Count > 0)
        {
            <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-700/60">
                <h4 class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3 flex items-center">
                    <i class="fa-solid fa-calculator text-amber-500 mr-1.5"></i> Custom Scoring Rules
                </h4>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    @foreach (var r in Model.ScoringRules)
                    {
                        <div class="flex justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-700/40 border border-slate-100 dark:border-slate-700/50">
                            <span class="text-slate-500 dark:text-slate-400">@r.Metric @(r.Position.HasValue ? $"({r.Position.Value})" : "")</span>
                            <span class="font-bold @(r.Points >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-500")">@(r.Points > 0 ? $"+{r.Points}" : r.Points.ToString()) pts</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
