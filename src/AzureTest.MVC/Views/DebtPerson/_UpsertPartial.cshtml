@model AzureTest.Domain.Documents.DebtPerson

<div class="mb-5">
    <label asp-for="FullName" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
        Full Name <span class="text-rose-500">*</span>
    </label>
    <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
            <i class="fa-solid fa-user"></i>
        </div>
        <input asp-for="FullName" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="e.g. John Doe" required />
    </div>
    <span asp-validation-for="FullName" class="text-2xs text-rose-600 mt-1 block"></span>
</div>
