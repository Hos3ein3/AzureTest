@{
    ViewData["Title"] = "Page Not Found";
}

<div class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="mb-8">
        <i class="fa-solid fa-ghost text-6xl text-slate-300"></i>
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">404</h1>
    <h2 class="text-2xl font-bold text-slate-700 mb-2">Page Not Found</h2>
    <p class="text-slate-500 mb-8 max-w-md">Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.</p>
    <div class="flex items-center justify-center gap-x-6">
        <a href="/" class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Go back home
        </a>
        <a href="#" onclick="history.back(); return false;" class="text-sm font-semibold text-slate-900 hover:text-brand-600 transition-colors">Go back <span aria-hidden="true">&rarr;</span></a>
    </div>
</div>
