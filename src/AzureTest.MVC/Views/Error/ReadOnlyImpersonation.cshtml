@using AzureTest.Application.Interfaces.Services
@inject ITenantProvider _TenantProvider
@{
    ViewData["Title"] = "Read-Only Impersonation";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

<div class="flex flex-col items-center justify-center min-h-[70vh] px-4 py-8 text-center">
    <div class="mb-6 relative inline-block">
        <div class="w-20 h-20 rounded-2xl bg-amber-50 border border-amber-200/80 flex items-center justify-center shadow-2xs text-amber-600 text-3xl">
            <i class="fa-solid fa-lock"></i>
        </div>
    </div>

    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-amber-50 text-amber-800 border border-amber-200/80 mb-3">
        <i class="fa-solid fa-user-secret text-amber-700"></i> Impersonation Mode Active
    </div>

    <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 mb-2">
        Workspace is Read-Only
    </h1>

    <p class="text-xs text-slate-500 mb-6 max-w-lg leading-relaxed">
        Administrative write operations (creating, updating, or deleting data) are prohibited while impersonating another tenant workspace. This policy protects tenant data integrity.
    </p>

    <!-- Context Details Box -->
    <div class="mb-8 w-full max-w-md bg-white border border-slate-200/80 rounded-2xl p-5 shadow-2xs text-left">
        <div class="text-2xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-circle-info text-brand-600"></i> Active Security Context
        </div>
        <div class="space-y-2.5 text-xs text-slate-700">
            <div class="flex justify-between items-center py-1 border-b border-slate-100">
                <span class="text-slate-500 font-medium">Impersonated Tenant ID:</span>
                <span class="font-mono font-bold text-slate-900 break-all text-2xs">@(_TenantProvider?.CurrentTenantId.ToString() ?? "Unknown")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(_TenantProvider?.ImpersonatedTenantName))
            {
                <div class="flex justify-between items-center py-1 border-b border-slate-100">
                    <span class="text-slate-500 font-medium">Tenant Owner:</span>
                    <span class="font-bold text-slate-900">@_TenantProvider.ImpersonatedTenantName</span>
                </div>
            }
            <div class="flex justify-between items-center py-1 border-b border-slate-100">
                <span class="text-slate-500 font-medium">Admin User ID:</span>
                <span class="font-mono text-slate-700 text-2xs">@(_TenantProvider?.RealUserId.ToString() ?? "Unknown")</span>
            </div>
            <div class="flex justify-between items-center py-1">
                <span class="text-slate-500 font-medium">Policy Setting:</span>
                <span class="font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200/80 text-2xs">AllowImpersonationWrites: false</span>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3">
        <button type="button" onclick="if(window.history.length > 1) { window.history.back(); } else { window.location.href='@returnUrl'; }" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-semibold shadow-2xs hover:bg-slate-800 transition-colors">
            <i class="fa-solid fa-arrow-left"></i> Go Back
        </button>

        <a asp-area="" asp-controller="Tenant" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-semibold shadow-2xs hover:bg-slate-50 transition-colors">
            <i class="fa-solid fa-building-user text-brand-600"></i> Manage Tenants
        </a>

        @if (_TenantProvider?.IsAdminImpersonating == true)
        {
            <form asp-area="" asp-controller="Tenant" asp-action="ResetTenant" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-600 text-white text-xs font-semibold shadow-2xs hover:bg-amber-700 transition-colors">
                    <i class="fa-solid fa-arrow-rotate-left"></i> Exit Impersonation
                </button>
            </form>
        }
    </div>
</div>
