@using Microsoft.AspNetCore.Diagnostics
@using System.Diagnostics
@{
    ViewData["Title"] = "Server Error";
    var exceptionHandlerPathFeature = Context.Features.Get<IExceptionHandlerPathFeature>();
    var exception = exceptionHandlerPathFeature?.Error;
    var path = exceptionHandlerPathFeature?.Path;
    var requestId = Activity.Current?.Id ?? Context.TraceIdentifier;

    var errorSubject = "Auto-Reported Error: 500 Internal Server Error";
    var errorContent = $@"
        <p><strong>Request ID (Correlation ID):</strong> {requestId}</p>
        <p><strong>Path/URL:</strong> {path}</p>
        <p><strong>Exception Message:</strong> {System.Net.WebUtility.HtmlEncode(exception?.Message)}</p>
        <p><strong>Inner Exception:</strong> {System.Net.WebUtility.HtmlEncode(exception?.InnerException?.Message)}</p>
        <pre>{System.Net.WebUtility.HtmlEncode(exception?.StackTrace)}</pre>
    ";
}

<div class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="mb-8 relative inline-block">
        <div class="absolute inset-0 bg-amber-100 blur-xl rounded-full opacity-60"></div>
        <i class="fa-solid fa-triangle-exclamation text-6xl text-amber-500 animate-pulse relative z-10"></i>
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">500</h1>
    <h2 class="text-2xl font-bold text-slate-700 mb-2">Internal Server Error</h2>
    <p class="text-slate-500 mb-8 max-w-md">Oops! Something went wrong on our end. Our team has been notified and we are working to fix the issue. Please try again later.</p>
    <div class="flex items-center justify-center gap-x-4">
        <a href="/" class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors">
            <i class="fa-solid fa-house mr-2"></i> Back to Safety
        </a>
        <form asp-controller="Ticket" asp-action="Create" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="subject" value="@errorSubject" />
            <input type="hidden" name="content" value="@errorContent" />
            <input type="hidden" name="priority" value="High" />
            <button type="submit" class="rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 transition-colors">
                <i class="fa-solid fa-paper-plane mr-2"></i> Report as Ticket
            </button>
        </form>
    </div>
</div>
