@model AzureTest.MVC.ViewModels.Permissions.UserPermissionsViewModel
@{
    ViewData["Title"] = $"Permissions for {Model.UserName}";
    var groupedPermissions = Model.Permissions
        .GroupBy(p => new { Area = p.AreaName ?? "", Controller = p.ControllerName })
        .OrderBy(g => g.Key.Area)
        .ThenBy(g => g.Key.Controller)
        .ToList();

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Administration", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Users", Url = "/User/Index" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = $"User Permissions: {Model.UserName}", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = $"Direct Permissions: {Model.UserName}",
        Subtitle = "Configure explicit direct permissions for this user to bypass or customize role-level access.",
        Icon = "fa-solid fa-user-gear",
        Badge = Model.UserName,
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<!-- User Overview Card -->
<div class="mb-6 p-4 rounded-2xl bg-white border border-slate-200/80 shadow-2xs flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-sm border border-brand-100">
            <i class="fa-solid fa-user"></i>
        </div>
        <div>
            <div class="font-bold text-slate-800 text-sm flex items-center gap-2">
                @Model.UserName
                <span class="text-xs font-normal text-slate-400">(@Model.UserEmail)</span>
            </div>
            <div class="flex items-center gap-1.5 mt-1">
                <span class="text-3xs font-semibold text-slate-500 uppercase tracking-wider">Assigned Roles:</span>
                @if (Model.UserRoles.Any())
                {
                    @foreach (var role in Model.UserRoles)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-3xs font-semibold @(role == "Admin" ? "bg-rose-50 text-rose-700 border border-rose-200" : "bg-indigo-50 text-indigo-700 border border-indigo-200")">
                            @role
                        </span>
                    }
                }
                else
                {
                    <span class="text-3xs text-slate-400 italic">No roles assigned</span>
                }
            </div>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <a asp-controller="User" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-arrow-left text-3xs"></i> Back to Users
        </a>
    </div>
</div>

<div class="mb-6 p-4 rounded-2xl bg-blue-50/80 border border-blue-200/80 flex items-start gap-3 shadow-2xs">
    <div class="w-8 h-8 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
        <i class="fa-solid fa-circle-info"></i>
    </div>
    <div class="text-xs text-blue-800 space-y-1">
        <div class="font-bold">Direct User Permission System</div>
        <p class="text-2xs text-blue-700 leading-relaxed">
            Permissions checked here are explicitly assigned to <strong>@Model.UserName</strong>. When dynamic user authorization is enabled in the security filter, these direct grants bypass role requirements. Endpoints already inherited from the user's role are indicated with <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full font-bold bg-indigo-100 text-indigo-800 text-3xs border border-indigo-200"><i class="fa-solid fa-shield-halved text-3xs"></i> Role Granted</span>.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-between gap-3 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="text-xs font-semibold text-emerald-800">@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 text-xs" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<form asp-action="Update" method="post" id="userPermissionsForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@Model.UserId" />
    
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden mb-6">
        <!-- Control Bar -->
        <div class="p-4 border-b border-slate-200/80 bg-slate-50/70 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2.5 flex-1">
                <!-- Search Box -->
                <div class="relative flex-1 min-w-[260px] max-w-md">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="permissionSearch" 
                           class="w-full pl-9 pr-8 py-2 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" 
                           placeholder="Search title, description, or URL (e.g. /media/stats, delete)...">
                    <button type="button" id="clearSearchBtn" style="display:none;" 
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 text-xs" title="Clear Search">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </button>
                </div>

                <!-- Status Filter Pills -->
                <div class="inline-flex p-1 bg-white rounded-xl border border-slate-200 shadow-2xs" id="statusFilterPills">
                    <button type="button" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-slate-900 text-white shadow-2xs" data-status="all">
                        All <span id="countAll" class="ml-1 px-1.5 py-0.2 rounded-md bg-white/20 text-3xs font-mono">0</span>
                    </button>
                    <button type="button" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900" data-status="checked">
                        <i class="fa-solid fa-circle-check text-emerald-500 mr-1 text-3xs"></i> Checked <span id="countChecked" class="ml-1 px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 text-3xs font-mono">0</span>
                    </button>
                    <button type="button" class="status-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900" data-status="unchecked">
                        <i class="fa-regular fa-circle text-slate-400 mr-1 text-3xs"></i> Unchecked <span id="countUnchecked" class="ml-1 px-1.5 py-0.2 rounded-md bg-slate-100 text-slate-700 text-3xs font-mono">0</span>
                    </button>
                </div>
            </div>

            <!-- Group Expansion Actions -->
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" id="toggleAllGroupsBtn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-up-right-and-down-left-from-center text-3xs"></i> <span id="toggleAllGroupsText">Collapse All</span>
                </button>
                <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold shadow-xs hover:shadow-sm transition-all">
                    <i class="fa-solid fa-floppy-disk text-3xs"></i> Save Changes
                </button>
            </div>
        </div>

        <!-- No Results Found Banner -->
        <div id="noResultsState" class="hidden p-12 text-center">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
                <i class="fa-solid fa-filter-circle-xmark text-lg"></i>
            </div>
            <h4 class="text-sm font-semibold text-slate-800 mb-1">No matching permissions found</h4>
            <p class="text-xs text-slate-500 max-w-md mx-auto">Try adjusting your search keywords or switching filter tabs.</p>
            <button type="button" id="resetFiltersBtn" class="mt-3 inline-flex items-center gap-1 px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                <i class="fa-solid fa-rotate-left text-3xs"></i> Reset Filters
            </button>
        </div>

        <!-- Permission Groups Accordions -->
        <div class="divide-y divide-slate-100" id="permissionGroupsContainer">
            @foreach (var group in groupedPermissions)
            {
                var groupKeySlug = (!string.IsNullOrEmpty(group.Key.Area) ? $"{group.Key.Area}_{group.Key.Controller}" : group.Key.Controller).Replace(" ", "_");
                var groupTotal = group.Count();
                var groupChecked = group.Count(p => p.IsAssigned);

                <div class="perm-group" data-group-slug="@groupKeySlug">
                    <!-- Group Header -->
                    <div class="p-4 bg-white hover:bg-slate-50/80 transition-colors flex items-center justify-between cursor-pointer group-header select-none">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-chevron-down text-slate-400 text-xs transition-transform duration-200 group-chevron"></i>
                            <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center text-xs">
                                <i class="fa-solid fa-folder-open"></i>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-slate-800 flex items-center gap-2">
                                    <span>@group.Key.Controller</span>
                                    @if (!string.IsNullOrEmpty(group.Key.Area))
                                    {
                                        <span class="px-2 py-0.5 rounded-md bg-purple-50 text-purple-700 border border-purple-200 text-3xs font-semibold uppercase tracking-wider">
                                            Area: @group.Key.Area
                                        </span>
                                    }
                                    <span class="group-match-count hidden px-1.5 py-0.2 rounded-md bg-brand-50 text-brand-700 border border-brand-200 text-3xs font-mono font-medium"></span>
                                </div>
                                <div class="text-2xs text-slate-400 mt-0.5">
                                    <span class="group-assigned-count">@groupChecked</span> of <span class="group-total-count">@groupTotal</span> permissions directly assigned
                                </div>
                            </div>
                        </div>

                        <!-- Bulk check in this group -->
                        <div class="flex items-center gap-3" onclick="event.stopPropagation();">
                            <label class="inline-flex items-center gap-1.5 text-2xs font-semibold text-slate-600 hover:text-slate-900 cursor-pointer select-none">
                                <input type="checkbox" class="toggle-group rounded border-slate-300 text-brand-500 focus:ring-brand-500/20 w-3.5 h-3.5" 
                                       data-group="@groupKeySlug" @(groupChecked == groupTotal ? "checked" : "") />
                                <span>Select All in Group</span>
                            </label>
                        </div>
                    </div>

                    <!-- Group Body -->
                    <div class="group-body bg-slate-50/50 p-4 border-t border-slate-100">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                            @foreach (var perm in group)
                            {
                                var urlPath = !string.IsNullOrEmpty(perm.AreaName) 
                                    ? $"/{perm.AreaName}/{perm.ControllerName}/{perm.ActionName}".ToLowerInvariant()
                                    : $"/{perm.ControllerName}/{perm.ActionName}".ToLowerInvariant();

                                <label class="perm-item flex items-start gap-3 p-3 rounded-xl border border-slate-200/80 bg-white hover:border-brand-500/50 hover:shadow-2xs transition-all cursor-pointer select-none relative overflow-hidden"
                                       data-checked="@(perm.IsAssigned ? "true" : "false")"
                                       data-title="@((perm.DisplayName ?? "").ToLowerInvariant())"
                                       data-desc="@((perm.Description ?? "").ToLowerInvariant())"
                                       data-url="@urlPath"
                                       data-controller="@perm.ControllerName.ToLowerInvariant()"
                                       data-action="@perm.ActionName.ToLowerInvariant()"
                                       data-area="@((perm.AreaName ?? "").ToLowerInvariant())">
                                    
                                    <input type="checkbox" name="selectedPermissions" value="@perm.PermissionId" 
                                           class="perm-checkbox group-cb-@groupKeySlug mt-1 rounded border-slate-300 text-brand-500 focus:ring-brand-500/20 w-4 h-4 shrink-0" 
                                           @(perm.IsAssigned ? "checked" : "") />
                                    
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between gap-1 mb-1 flex-wrap">
                                            <span class="text-xs font-semibold text-slate-800 truncate" title="@perm.DisplayName">
                                                @(string.IsNullOrEmpty(perm.DisplayName) ? perm.ActionName : perm.DisplayName)
                                            </span>
                                            <div class="flex items-center gap-1 shrink-0">
                                                @if (perm.RequiresAdmin)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full font-bold bg-amber-50 text-amber-700 text-3xs border border-amber-200" title="Code-level Admin requirement [Authorize(Roles = 'Admin')]">
                                                        <i class="fa-solid fa-lock text-3xs"></i> Admin Only
                                                    </span>
                                                }
                                                @if (perm.IsGrantedViaRole)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full font-bold bg-indigo-50 text-indigo-700 text-3xs border border-indigo-200" title="Inherited from assigned role">
                                                        <i class="fa-solid fa-shield-halved text-3xs"></i> Role Granted
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(perm.Description))
                                        {
                                            <p class="text-2xs text-slate-500 line-clamp-2 mb-2 leading-relaxed" title="@perm.Description">
                                                @perm.Description
                                            </p>
                                        }

                                        <!-- Endpoint Path -->
                                        <div class="flex items-center gap-1.5 text-3xs font-mono text-slate-400 bg-slate-50 px-2 py-1 rounded-md border border-slate-100">
                                            <i class="fa-solid fa-link text-slate-400"></i>
                                            <span class="truncate" title="@urlPath">@urlPath</span>
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Sticky Bottom Save Bar -->
    <div class="sticky bottom-6 z-20 bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200/90 shadow-lg p-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-xs">
                <i class="fa-solid fa-shield-check"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-slate-800">
                    <span id="selectedCountBottom">0</span> Direct Permissions Selected
                </div>
                <div class="text-2xs text-slate-400">Direct user permission assignments bypass role requirements when enabled.</div>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" id="scrollTopBtn" class="inline-flex items-center justify-center w-9 h-9 rounded-xl border border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50 transition-colors" title="Scroll to Top">
                <i class="fa-solid fa-arrow-up text-xs"></i>
            </button>
            <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold shadow-xs hover:shadow-sm transition-all">
                <i class="fa-solid fa-floppy-disk text-3xs"></i> Save Changes
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let currentStatusFilter = 'all';
        let allGroupsCollapsed = false;

        function updateCounts() {
            const allCheckboxes = document.querySelectorAll('.perm-checkbox');
            const total = allCheckboxes.length;
            let checked = 0;
            
            allCheckboxes.forEach(cb => {
                if (cb.checked) checked++;
                const item = cb.closest('.perm-item');
                if (item) {
                    item.dataset.checked = cb.checked ? 'true' : 'false';
                }
            });

            const unchecked = total - checked;

            const countAll = document.getElementById('countAll');
            const countChecked = document.getElementById('countChecked');
            const countUnchecked = document.getElementById('countUnchecked');
            const bottomCount = document.getElementById('selectedCountBottom');

            if (countAll) countAll.innerText = total;
            if (countChecked) countChecked.innerText = checked;
            if (countUnchecked) countUnchecked.innerText = unchecked;
            if (bottomCount) bottomCount.innerText = checked;

            // Update group headers
            document.querySelectorAll('.perm-group').forEach(group => {
                const groupSlug = group.dataset.groupSlug;
                const groupCheckboxes = group.querySelectorAll('.perm-checkbox');
                const gTotal = groupCheckboxes.length;
                let gChecked = 0;
                groupCheckboxes.forEach(cb => { if (cb.checked) gChecked++; });

                const gAssigned = group.querySelector('.group-assigned-count');
                if (gAssigned) gAssigned.innerText = gChecked;

                const toggleCb = group.querySelector('.toggle-group');
                if (toggleCb) {
                    toggleCb.checked = (gTotal > 0 && gChecked === gTotal);
                    toggleCb.indeterminate = (gChecked > 0 && gChecked < gTotal);
                }
            });
        }

        function applyFilters() {
            const searchInput = document.getElementById('permissionSearch');
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) {
                clearBtn.style.display = query.length > 0 ? 'flex' : 'none';
            }

            let anyVisibleTotal = 0;

            document.querySelectorAll('.perm-group').forEach(group => {
                let visibleInGroup = 0;
                const items = group.querySelectorAll('.perm-item');

                items.forEach(item => {
                    const isChecked = item.dataset.checked === 'true';

                    // 1. Status Filter Check
                    let matchesStatus = true;
                    if (currentStatusFilter === 'checked') {
                        matchesStatus = isChecked;
                    } else if (currentStatusFilter === 'unchecked') {
                        matchesStatus = !isChecked;
                    }

                    // 2. Query Search Check
                    let matchesQuery = true;
                    if (query.length > 0) {
                        const title = item.dataset.title || '';
                        const desc = item.dataset.desc || '';
                        const url = item.dataset.url || '';
                        const ctrl = item.dataset.controller || '';
                        const act = item.dataset.action || '';
                        const area = item.dataset.area || '';

                        matchesQuery = title.includes(query) ||
                                       desc.includes(query) ||
                                       url.includes(query) ||
                                       ctrl.includes(query) ||
                                       act.includes(query) ||
                                       area.includes(query);
                    }

                    if (matchesStatus && matchesQuery) {
                        item.style.display = '';
                        visibleInGroup++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                const badge = group.querySelector('.group-match-count');
                if (query.length > 0 || currentStatusFilter !== 'all') {
                    if (badge) {
                        badge.classList.remove('hidden');
                        badge.innerText = `${visibleInGroup} matches`;
                    }
                } else {
                    if (badge) badge.classList.add('hidden');
                }

                if (visibleInGroup > 0) {
                    group.style.display = '';
                    anyVisibleTotal += visibleInGroup;
                    const body = group.querySelector('.group-body');
                    const chevron = group.querySelector('.group-chevron');
                    if (body && query.length > 0) {
                        body.style.display = '';
                        if (chevron) chevron.classList.remove('-rotate-90');
                    }
                } else {
                    group.style.display = 'none';
                }
            });

            const noResultsState = document.getElementById('noResultsState');
            if (noResultsState) {
                noResultsState.classList.toggle('hidden', anyVisibleTotal > 0);
            }
        }

        // Status Filter Buttons
        document.querySelectorAll('.status-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.status-filter-btn').forEach(b => {
                    b.classList.remove('bg-slate-900', 'text-white', 'shadow-2xs');
                    b.classList.add('text-slate-600');
                });
                this.classList.add('bg-slate-900', 'text-white', 'shadow-2xs');
                this.classList.remove('text-slate-600');

                currentStatusFilter = this.dataset.status;
                applyFilters();
            });
        });

        // Search Input Listener
        const searchInput = document.getElementById('permissionSearch');
        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }

        // Clear Search Button
        const clearSearchBtn = document.getElementById('clearSearchBtn');
        if (clearSearchBtn) {
            clearSearchBtn.addEventListener('click', function() {
                if (searchInput) {
                    searchInput.value = '';
                    applyFilters();
                    searchInput.focus();
                }
            });
        }

        // Reset Filters Button
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');
        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', function() {
                if (searchInput) searchInput.value = '';
                const allBtn = document.querySelector('.status-filter-btn[data-status="all"]');
                if (allBtn) allBtn.click();
            });
        }

        // Toggle Group Checkboxes
        document.querySelectorAll('.toggle-group').forEach(toggler => {
            toggler.addEventListener('change', function() {
                const groupSlug = this.dataset.group;
                const isChecked = this.checked;
                document.querySelectorAll('.group-cb-' + groupSlug).forEach(cb => {
                    cb.checked = isChecked;
                });
                updateCounts();
                if (currentStatusFilter !== 'all') {
                    applyFilters();
                }
            });
        });

        // Individual Checkbox change
        document.querySelectorAll('.perm-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
                updateCounts();
                if (currentStatusFilter !== 'all') {
                    applyFilters();
                }
            });
        });

        // Collapsible groups
        document.querySelectorAll('.group-header').forEach(header => {
            header.addEventListener('click', function(e) {
                if (e.target.closest('.toggle-group') || e.target.tagName === 'INPUT') return;

                const body = this.nextElementSibling;
                const chevron = this.querySelector('.group-chevron');
                if (body.style.display === 'none') {
                    body.style.display = '';
                    chevron.classList.remove('-rotate-90');
                } else {
                    body.style.display = 'none';
                    chevron.classList.add('-rotate-90');
                }
            });
        });

        // Toggle All Groups
        const toggleAllGroupsBtn = document.getElementById('toggleAllGroupsBtn');
        const toggleAllGroupsText = document.getElementById('toggleAllGroupsText');
        if (toggleAllGroupsBtn) {
            toggleAllGroupsBtn.addEventListener('click', function() {
                allGroupsCollapsed = !allGroupsCollapsed;
                document.querySelectorAll('.perm-group').forEach(group => {
                    const body = group.querySelector('.group-body');
                    const chevron = group.querySelector('.group-chevron');
                    if (body) {
                        body.style.display = allGroupsCollapsed ? 'none' : '';
                    }
                    if (chevron) {
                        if (allGroupsCollapsed) {
                            chevron.classList.add('-rotate-90');
                        } else {
                            chevron.classList.remove('-rotate-90');
                        }
                    }
                });
                if (toggleAllGroupsText) {
                    toggleAllGroupsText.innerText = allGroupsCollapsed ? 'Expand All' : 'Collapse All';
                }
            });
        }

        // Scroll to top
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        if (scrollTopBtn) {
            scrollTopBtn.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        updateCounts();
    </script>
}
