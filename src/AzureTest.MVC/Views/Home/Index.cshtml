@using AzureTest.MVC.Models
@model AzureTest.MVC.Models.HomeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Overview";

    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", null, "fa-solid fa-house", true)
    };
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-7xl space-y-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard Overview</h1>
                    <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Real-time telemetry, productivity, and application metrics.</p>
                </div>
            </div>

            @if (Model.IsAdmin && !string.IsNullOrWhiteSpace(Model.CurrentUserName))
            {
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1 bg-brand-50 border border-brand-200 text-brand-700 rounded-xl text-xs font-semibold">
                    <i class="fa-solid fa-eye text-brand-600"></i>
                    <span>Viewing Data For: @Model.CurrentUserName</span>
                </div>
            }
        </div>

        <div class="flex flex-wrap gap-2.5 items-center w-full sm:w-auto">
            @if (Model.IsAdmin)
            {
                <form method="get" class="flex items-center gap-2">
                    <select name="userId" class="px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500">
                        <option value="">-- All Users (Aggregate) --</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            var selected = user.Key == Model.CurrentUserId ? "selected" : null;
                            <option value="@user.Key" selected="@selected">@user.Value</option>
                        }
                    </select>
                    <button type="submit" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-xl shadow-xs transition">
                        Switch
                    </button>
                </form>
            }
            <a asp-controller="Dashboard" asp-action="Manage"
               class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition shadow-xs">
                <i class="fa-solid fa-layer-group text-slate-500"></i> Dashboards
            </a>
            <a asp-controller="Resume" asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition">
                <i class="fa-solid fa-plus"></i> Add Resume
            </a>
        </div>
    </div>

    <!-- Metric Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetTotalApplications", Model)
        @await Html.PartialAsync("Widgets/_WidgetActiveProcessing", Model)
        @await Html.PartialAsync("Widgets/_WidgetInterviewRate", Model)
        @await Html.PartialAsync("Widgets/_WidgetTotalCompanies", Model)
        @await Html.PartialAsync("Widgets/_WidgetRegisteredUsers", Model)
        @await Html.PartialAsync("Widgets/_WidgetOnlineUsers", Model)
        @await Html.PartialAsync("Widgets/_WidgetOccupiedStorage", Model)
        @await Html.PartialAsync("Widgets/_WidgetOutstandingDebt", Model)
        @await Html.PartialAsync("Widgets/_WidgetMonthlyExpenses", Model)
    </div>

    <!-- Productivity & Tasks Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetUnansweredTickets", Model)
        @await Html.PartialAsync("Widgets/_WidgetPendingTasks", Model)
        @await Html.PartialAsync("Widgets/_WidgetUpcomingEvents", Model)
        @await Html.PartialAsync("Widgets/_WidgetDailyHabits", Model)
        @await Html.PartialAsync("Widgets/_WidgetRecentDebts", Model)
        @await Html.PartialAsync("Widgets/_WidgetRecentExpenses", Model)
        @await Html.PartialAsync("Widgets/_WidgetDebtsDueSoon", Model)
    </div>

    <!-- Application Trends & Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetApplicationOverTime", Model)
        @await Html.PartialAsync("Widgets/_WidgetRecentActivity", Model)
    </div>

    <!-- Applications Status Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetApplicationByStatus", Model)
    </div>

    <!-- Positions, Locations & Sources -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetTopPositions", Model)
        @await Html.PartialAsync("Widgets/_WidgetTopLocations", Model)
        @await Html.PartialAsync("Widgets/_WidgetApplicationSources", Model)
    </div>

    <!-- Financial Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetExpensesByCategory", Model)
        @await Html.PartialAsync("Widgets/_WidgetDebtsByPerson", Model)
    </div>

    <!-- Tickets & Performance -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetSupportTickets", Model)
        @await Html.PartialAsync("Widgets/_WidgetHabitAdherence", Model)
        @await Html.PartialAsync("Widgets/_WidgetMonthlyCashFlow", Model)
    </div>

    <!-- Knowledge & Community Pages -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetPages", Model)
    </div>

    <!-- Media & Watchlist Telemetry -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetMediaAnalytics", Model)
    </div>

    <!-- Health, Weight & BMI Analytics -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetHealthAnalytics", Model)
    </div>

    <!-- Shopping List & Grocery Telemetry -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetShoppingAnalytics", Model)
    </div>

    <!-- Universal Paper Trading Telemetry -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetPaperTradingAnalytics", Model)
    </div>

    <!-- Crypto Markets & Portfolio Analytics -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetCryptoTradingAnalytics", Model)
    </div>

    <!-- Forex Trading & Global Sessions Analytics -->
    <div class="grid grid-cols-1 gap-6">
        @await Html.PartialAsync("Widgets/_WidgetForexTradingAnalytics", Model)
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("Widgets/_DashboardScripts", Model)
}