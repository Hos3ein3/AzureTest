@model IEnumerable<AzureTest.Domain.Documents.UserDashboard>

@{
    ViewData["Title"] = "Manage Dashboards";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">My Dashboards</h1>
        <p class="text-slate-500 mt-1">Create and manage your custom dashboard layouts.</p>
    </div>
    <div>
        <a asp-action="Builder" class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-all">
            <i class="fa-solid fa-plus mr-2"></i> New Dashboard
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @if (!Model.Any())
    {
        <div class="col-span-full flex flex-col items-center justify-center p-12 bg-white rounded-xl border border-slate-200 border-dashed">
            <div class="h-16 w-16 rounded-full bg-slate-50 flex items-center justify-center mb-4">
                <i class="fa-solid fa-border-all text-slate-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-medium text-slate-800">No dashboards yet</h3>
            <p class="text-slate-500 mt-1 mb-6 text-center max-w-sm">Create your first custom dashboard to tailor the analytics exactly how you want them.</p>
            <a asp-action="Builder" class="inline-flex items-center justify-center rounded-lg bg-brand-50 text-brand-700 px-4 py-2 text-sm font-medium hover:bg-brand-100 transition-colors">
                Get Started
            </a>
        </div>
    }
    else
    {
        @foreach (var dashboard in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden flex flex-col hover:shadow-md transition-shadow relative group">
                <div class="p-6 flex-1">
                    <div class="flex justify-between items-start mb-4">
                        <div class="h-12 w-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
                            <i class="fa-solid fa-chart-line text-xl"></i>
                        </div>
                        <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                            <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this dashboard?');">
                                <input type="hidden" name="id" value="@dashboard.Id" />
                                <button type="submit" class="text-slate-400 hover:text-red-500 p-1 transition-colors" title="Delete">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-800 mb-1">@dashboard.Name</h3>
                    <div class="flex items-center text-sm text-slate-500 mb-4">
                        <i class="fa-solid fa-link mr-1.5 text-slate-400"></i>
                        <span class="truncate">/@dashboard.Slug</span>
                    </div>
                    
                    <div class="flex flex-wrap gap-2 mb-2">
                        <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">
                            @dashboard.Sections.Count sections
                        </span>
                        <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">
                            @dashboard.Sections.Sum(s => s.Components.Count) widgets
                        </span>
                    </div>
                </div>
                
                <div class="bg-slate-50 border-t border-slate-100 px-6 py-3 flex justify-between items-center">
                    <div class="flex gap-4">
                        <a href="/@dashboard.Slug" class="text-sm font-medium text-slate-700 hover:text-brand-600 flex items-center transition-colors">
                            <i class="fa-solid fa-eye mr-2"></i> View
                        </a>
                        <a asp-action="Builder" asp-route-slug="@dashboard.Slug" class="text-sm font-medium text-brand-600 hover:text-brand-700 flex items-center transition-colors">
                            <i class="fa-solid fa-pen-to-square mr-2"></i> Edit
                        </a>
                    </div>
                    <div>
                        @if(ViewBag.PreferredDashboard == dashboard.Slug)
                        {
                            <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                                <i class="fa-solid fa-star mr-1 text-[10px]"></i> Default
                            </span>
                        }
                        else
                        {
                            <form asp-action="SetDefault" method="post" class="inline">
                                <input type="hidden" name="slug" value="@dashboard.Slug" />
                                <button type="submit" class="text-xs font-medium text-slate-500 hover:text-brand-600 transition-colors">
                                    Set as Default
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
