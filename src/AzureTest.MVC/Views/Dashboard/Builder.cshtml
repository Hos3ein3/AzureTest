@model AzureTest.Domain.Documents.UserDashboard
@{
    ViewData["Title"] = Model == null ? "Create Dashboard" : $"Edit Dashboard - {Model.Name}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allComponents = ViewBag.Components as List<AzureTest.Domain.Documents.DashboardComponent>;
    var allRawComponents = ViewBag.AllRawComponents as IReadOnlyList<AzureTest.Domain.Documents.DashboardRawComponent> ?? new List<AzureTest.Domain.Documents.DashboardRawComponent>();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/gridstack@8.2.3/dist/gridstack.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
    <style>
        .ts-dropdown {
            z-index: 9999 !important;
        }
        .grid-stack {
            min-height: 200px;
            background-color: #f8fafc;
            border-radius: 0.75rem;
            border: 2px dashed #e2e8f0;
        }
        .grid-stack-item-content {
            background-color: white;
            border-radius: 0.75rem;
            box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            border: 1px solid #f1f5f9;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            cursor: move;
        }
        .component-card {
            cursor: grab;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .component-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
        .remove-widget-btn {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 9999px;
            width: 1.5rem;
            height: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ef4444;
            cursor: pointer;
            z-index: 10;
            opacity: 0;
            transition: opacity 0.2s;
        }
        .grid-stack-item:hover .remove-widget-btn {
            opacity: 1;
        }
        .widget-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 1rem;
        }
    </style>
}

<div class="flex flex-col lg:flex-row gap-6 h-[calc(100vh-8rem)]">
    
    <!-- Sidebar / Toolbox -->
    <div class="w-full lg:w-80 bg-white rounded-xl shadow-sm border border-slate-100 flex flex-col overflow-hidden h-full">
        <div class="p-4 border-b border-slate-100 bg-slate-50">
            <h2 class="text-lg font-semibold text-slate-800">Quick Actions</h2>
            <div class="mt-3 space-y-2">
                <button type="button" onclick="createWidget('/RawComponent/Create?type=RawHtml')" class="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded shadow-sm hover:bg-slate-50 transition-colors flex items-center">
                    <i class="fa-solid fa-code text-blue-500 mr-2 w-4 text-center"></i> Create Raw HTML
                </button>
                <button type="button" onclick="createWidget('/RawComponent/Create?type=JsonConfig')" class="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded shadow-sm hover:bg-slate-50 transition-colors flex items-center">
                    <i class="fa-solid fa-chart-simple text-purple-500 mr-2 w-4 text-center"></i> Create JSON Config
                </button>
                <button type="button" onclick="createWidget('/Component/Create')" class="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded shadow-sm hover:bg-slate-50 transition-colors flex items-center">
                    <i class="fa-solid fa-layer-group text-brand-500 mr-2 w-4 text-center"></i> Create Standard View
                </button>
                <div class="border-t border-slate-200 my-2 pt-2 space-y-2">
                    <button type="button" onclick="openRawModal('RawHtml')" class="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 bg-slate-100 border border-slate-200 rounded hover:bg-slate-200 transition-colors flex items-center">
                        <i class="fa-solid fa-plus mr-2 w-4 text-center"></i> Add Existing Raw HTML
                    </button>
                    <button type="button" onclick="openRawModal('JsonConfig')" class="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 bg-slate-100 border border-slate-200 rounded hover:bg-slate-200 transition-colors flex items-center">
                        <i class="fa-solid fa-plus mr-2 w-4 text-center"></i> Add Existing JSON Config
                    </button>
                </div>
            </div>
        </div>
        
        <div class="p-4 border-b border-slate-100 bg-white">
            <h2 class="text-sm font-semibold text-slate-800">Components</h2>
            <p class="text-xs text-slate-500 mt-1 mb-2">Drag items into the grid</p>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <i class="fa-solid fa-search text-slate-400 text-sm"></i>
                </div>
                <input type="text" id="componentSearch" oninput="filterComponents()" class="block w-full rounded-md border-0 py-1.5 pl-9 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-600 sm:text-sm sm:leading-6" placeholder="Search components...">
            </div>
        </div>
        
        <div class="p-4 overflow-y-auto flex-1 custom-scrollbar">
            @{
                var groupedComponents = allComponents.GroupBy(c => c.Category).OrderBy(g => g.Key);
            }
            @foreach (var group in groupedComponents)
            {
                <div class="mb-6 component-group">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">@group.Key</h3>
                    <div class="space-y-3">
                        @foreach (var comp in group)
                        {
                            <div class="component-card bg-slate-50 border border-slate-200 rounded-lg p-3 flex items-center gap-3"
                                 draggable="true" 
                                 data-id="@comp.Id" 
                                 data-name="@comp.Name"
                                 data-w="@comp.DefaultWidth" 
                                 data-h="@comp.DefaultHeight"
                                 data-img="@comp.ImagePath"
                                 data-minw="@comp.MinWidth"
                                 data-maxw="@comp.MaxWidth"
                                 data-minh="@comp.MinHeight"
                                 data-maxh="@comp.MaxHeight"
                                 data-resizable="@comp.IsResizable.ToString().ToLower()"
                                 ondragstart="handleDragStart(event)">
                                <div class="w-10 h-10 rounded bg-white flex items-center justify-center shadow-sm flex-shrink-0 p-1">
                                    <img src="@comp.ImagePath" alt="@comp.Name" class="max-w-full max-h-full object-contain" onerror="this.src='/img/placeholder.png'; this.onerror=null;" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-slate-700 truncate">@comp.Name</p>
                                    @{
                                        var minText = comp.MinWidth > 0 && comp.MinHeight > 0 ? $"{comp.MinWidth}x{comp.MinHeight}" : "None";
                                        var maxText = comp.MaxWidth > 0 && comp.MaxHeight > 0 ? $"{comp.MaxWidth}x{comp.MaxHeight}" : "None";
                                    }
                                    <p class="text-[9px] text-slate-400 mt-0.5" title="Def: @comp.DefaultWidth x @comp.DefaultHeight | Min: @minText | Max: @maxText | Resizable: @(comp.IsResizable ? "Y" : "N")">
                                        Def: @comp.DefaultWidth x @comp.DefaultHeight &bull; Min: @minText &bull; Max: @maxText &bull; Resize: @(comp.IsResizable ? "Y" : "N")
                                    </p>
                                </div>
                                <i class="fa-solid fa-grip-vertical text-slate-300"></i>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="flex-1 flex flex-col h-full min-w-0">
        
        <!-- Toolbar -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-4 mb-4 flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-start gap-4 flex-1">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">Dashboard Name</label>
                    <div class="flex gap-2">
                        <input type="text" id="dashboardName" value="@(Model?.Name)" placeholder="e.g. My Overview" class="block w-full sm:w-64 rounded-md border-0 py-1.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-600 sm:text-sm sm:leading-6" oninput="generateSlug(this.value); clearErrors();" />
                        <button type="button" onclick="randomizeName()" class="inline-flex items-center justify-center rounded-md bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-600 ring-1 ring-inset ring-slate-300 hover:bg-slate-100 transition-colors" title="Generate random name">
                            <i class="fa-solid fa-dice"></i>
                        </button>
                    </div>
                    <p id="nameError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">URL Slug</label>
                    <div class="flex rounded-md shadow-sm relative">
                        <span class="inline-flex items-center rounded-l-md border border-r-0 border-slate-300 px-3 text-slate-500 sm:text-sm bg-slate-50">
                            /
                        </span>
                        <input type="text" id="dashboardSlug" value="@(Model?.Slug)" class="block w-full sm:w-48 min-w-0 flex-1 rounded-none rounded-r-md border-0 py-1.5 text-slate-900 ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-600 sm:text-sm sm:leading-6" oninput="checkSlugUnique(); clearErrors();" />
                        <div id="slugCheckSpinner" class="absolute right-3 top-2 hidden">
                            <i class="fa-solid fa-circle-notch fa-spin text-slate-400 text-sm"></i>
                        </div>
                    </div>
                    <p id="slugError" class="text-xs text-red-500 mt-1 hidden"></p>
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <a asp-action="Manage" class="text-sm font-semibold text-slate-500 hover:text-slate-700">Cancel</a>
                <button type="button" onclick="saveDashboard()" id="saveBtn" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition-colors">
                    <i class="fa-solid fa-save mr-2"></i> Save Layout
                </button>
            </div>
        </div>

        <!-- Grid Area -->
        <!-- Toolbar addon for sections -->
        <div class="px-4 pb-2 text-right">
            <button type="button" onclick="addSection()" class="inline-flex items-center text-sm font-medium text-brand-600 hover:text-brand-500">
                <i class="fa-solid fa-plus mr-1"></i> Add Section
            </button>
        </div>
        <!-- Grid Area -->
        <div class="flex-1 bg-slate-50 p-4 overflow-y-auto custom-scrollbar relative space-y-6" id="sectionsContainer">
            <!-- Sections injected here -->
        </div>
        
    </div>
</div>

<input type="hidden" id="dashboardId" value="@(Model?.Id.ToString())" />

<!-- Raw Component Selection Modal -->
<div id="rawComponentModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-500 bg-opacity-75 transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 sm:mx-0 sm:h-10 sm:w-10">
                            <i class="fa-solid fa-puzzle-piece text-brand-600"></i>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left w-full">
                            <h3 class="text-base font-semibold leading-6 text-slate-900" id="rawModalTitle">Add Dynamic Component</h3>
                            <div class="mt-4">
                                <label class="block text-sm font-medium text-slate-700 mb-1">Select Component</label>
                                <select id="rawComponentSelect" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm" onchange="updateRawComponentDetails()">
                                    <!-- Options injected via JS -->
                                </select>
                                <div id="rawComponentDetails" class="mt-3 text-left bg-slate-50 p-3 rounded border border-slate-200 hidden">
                                    <p class="text-xs text-slate-500 mb-2 font-medium uppercase tracking-wider">Layout Constraints</p>
                                    <div class="grid grid-cols-2 gap-2 text-sm text-slate-700">
                                        <div><span class="text-slate-400">Min Width:</span> <span id="rawMinW" class="font-medium"></span></div>
                                        <div><span class="text-slate-400">Max Width:</span> <span id="rawMaxW" class="font-medium"></span></div>
                                        <div><span class="text-slate-400">Min Height:</span> <span id="rawMinH" class="font-medium"></span></div>
                                        <div><span class="text-slate-400">Max Height:</span> <span id="rawMaxH" class="font-medium"></span></div>
                                        <div class="col-span-2 mt-1"><span class="text-slate-400">Resizable:</span> <span id="rawResizable" class="font-medium"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2">
                    <button type="button" onclick="addSelectedRawComponent()" class="inline-flex w-full justify-center rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 sm:w-auto">Add to Grid</button>
                    <button type="button" onclick="closeRawModal()" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/gridstack@8.2.3/dist/gridstack-all.js"></script>
    <script>
        let grids = {};
        
        function generateId() {
            return 'sect_' + Math.random().toString(36).substr(2, 9);
        }

        function addSection(id = null, name = "New Section") {
            const sectionId = id || generateId();
            const container = document.getElementById('sectionsContainer');
            
            const sectionDiv = document.createElement('div');
            sectionDiv.className = 'section-wrapper bg-white p-4 rounded-xl shadow-sm border border-slate-200';
            sectionDiv.id = `wrapper_${sectionId}`;
            
            sectionDiv.innerHTML = `
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
                    <input type="text" class="section-name font-semibold text-slate-700 bg-transparent border-0 border-b border-transparent hover:border-slate-300 focus:border-brand-500 focus:ring-0 px-0 py-1" value="${name}" placeholder="Section Name" />
                    <button type="button" onclick="removeSection('${sectionId}')" class="text-xs text-red-500 hover:text-red-700 p-1"><i class="fa-solid fa-trash"></i></button>
                </div>
                <div class="grid-stack" id="grid_${sectionId}" ondrop="handleDrop(event, '${sectionId}')" ondragover="allowDrop(event)"></div>
            `;
            
            container.appendChild(sectionDiv);
            
            grids[sectionId] = GridStack.init({
                cellHeight: 80,
                margin: 10,
                acceptWidgets: true,
                float: true,
                disableOneColumnMode: true
            }, `#grid_${sectionId}`);
            
            return sectionId;
        }

        function removeSection(id) {
            if (Object.keys(grids).length <= 1) {
                alert("You must have at least one section.");
                return;
            }
            if(confirm("Are you sure you want to remove this section and all its components?")) {
                grids[id].destroy();
                delete grids[id];
                document.getElementById(`wrapper_${id}`).remove();
            }
        }
        
        document.addEventListener('DOMContentLoaded', function () {
            
            // Load existing data if editing
            @if(Model != null && Model.Sections.Any())
            {
                <text>
                @foreach(var dashboardSection in Model.Sections)
                {
                    <text>
                    (function() {
                        const secId = '@(dashboardSection.Id)';
                        addSection(secId, '@Html.Raw(dashboardSection.Name.Replace("'", "\\'"))');
                        const existingWidgets = [];
                        @foreach(var c in dashboardSection.Components)
                        {
                            var compInfo = allComponents.FirstOrDefault(x => x.Id == c.ComponentId);
                            if(compInfo != null)
                            {
                                <text>
                                existingWidgets.push({
                                    x: @c.X,
                                    y: @c.Y,
                                    w: @c.Width,
                                    h: @c.Height,
                                    id: '@c.ComponentId',
                                    minW: @(compInfo.MinWidth > 0 ? compInfo.MinWidth.ToString() : "undefined"),
                                    maxW: @(compInfo.MaxWidth > 0 ? compInfo.MaxWidth.ToString() : "undefined"),
                                    minH: @(compInfo.MinHeight > 0 ? compInfo.MinHeight.ToString() : "undefined"),
                                    maxH: @(compInfo.MaxHeight > 0 ? compInfo.MaxHeight.ToString() : "undefined"),
                                    noResize: @(compInfo.IsResizable ? "false" : "true"),
                                    content: `
                                        <div class="w-full h-full relative" data-type="Standard">
                                            <button type="button" class="remove-widget-btn" onclick="removeWidget(this, '${secId}')"><i class="fa-solid fa-xmark"></i></button>
                                            <div class="w-full h-full flex flex-col bg-white">
                                                <div class="px-3 py-2 border-b border-slate-100 bg-slate-50/50">
                                                    <p class="text-xs font-semibold text-slate-600 truncate">@compInfo.Name</p>
                                                </div>
                                                <div class="flex-1 p-2 flex items-center justify-center overflow-hidden">
                                                    <img src="@compInfo.ImagePath" class="widget-img" alt="@compInfo.Name" onerror="this.src='/img/placeholder.png'; this.onerror=null;"/>
                                                </div>
                                            </div>
                                        </div>`
                                });
                                </text>
                            }
                            else
                            {
                                var rawCompInfo = allRawComponents.FirstOrDefault(x => x.Id == c.RawComponentId || x.Id == c.ComponentId);
                                if (rawCompInfo != null)
                                {
                                    var badgeClass = rawCompInfo.Type == "RawHtml" ? "bg-blue-100 text-blue-800" : "bg-purple-100 text-purple-800";
                                    <text>
                                    existingWidgets.push({
                                        x: @c.X,
                                        y: @c.Y,
                                        w: @c.Width,
                                        h: @c.Height,
                                        id: '@rawCompInfo.Id',
                                        minW: @(rawCompInfo.MinWidth > 0 ? rawCompInfo.MinWidth.ToString() : "undefined"),
                                        maxW: @(rawCompInfo.MaxWidth > 0 ? rawCompInfo.MaxWidth.ToString() : "undefined"),
                                        minH: @(rawCompInfo.MinHeight > 0 ? rawCompInfo.MinHeight.ToString() : "undefined"),
                                        maxH: @(rawCompInfo.MaxHeight > 0 ? rawCompInfo.MaxHeight.ToString() : "undefined"),
                                        noResize: @(rawCompInfo.IsResizable ? "false" : "true"),
                                        content: `
                                            <div class="w-full h-full relative" data-type="${'@rawCompInfo.Type'}" data-raw-id="${'@rawCompInfo.Id'}">
                                                <button type="button" class="remove-widget-btn" onclick="removeWidget(this, '${secId}')"><i class="fa-solid fa-xmark"></i></button>
                                                <div class="w-full h-full flex flex-col bg-white">
                                                    <div class="px-3 py-2 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                                                        <p class="text-xs font-semibold text-slate-600 truncate">${'@rawCompInfo.Name.Replace("'", "\\'")'}</p>
                                                        <span class="px-1.5 py-0.5 rounded text-[10px] font-medium @badgeClass">${'@rawCompInfo.Type'}</span>
                                                    </div>
                                                    <div class="flex-1 p-4 flex items-center justify-center overflow-hidden bg-slate-50">
                                                        <i class="fa-solid fa-code text-4xl text-slate-300"></i>
                                                    </div>
                                                </div>
                                            </div>`
                                    });
                                    </text>
                                }
                            }
                        }
                        grids[secId].load(existingWidgets);
                    })();
                    </text>
                }
                </text>
            }
            else
            {
                <text>
                addSection('default', 'Main Layout');
                </text>
            }
        });
        
        function handleDragStart(ev) {
            ev.dataTransfer.setData("id", ev.currentTarget.getAttribute("data-id"));
            ev.dataTransfer.setData("w", ev.currentTarget.getAttribute("data-w"));
            ev.dataTransfer.setData("h", ev.currentTarget.getAttribute("data-h"));
            ev.dataTransfer.setData("name", ev.currentTarget.getAttribute("data-name"));
            ev.dataTransfer.setData("img", ev.currentTarget.getAttribute("data-img"));
            ev.dataTransfer.setData("type", "Standard");
            ev.dataTransfer.setData("minw", ev.currentTarget.getAttribute("data-minw"));
            ev.dataTransfer.setData("maxw", ev.currentTarget.getAttribute("data-maxw"));
            ev.dataTransfer.setData("minh", ev.currentTarget.getAttribute("data-minh"));
            ev.dataTransfer.setData("maxh", ev.currentTarget.getAttribute("data-maxh"));
            ev.dataTransfer.setData("resizable", ev.currentTarget.getAttribute("data-resizable"));
        }
        
        function allowDrop(ev) {
            ev.preventDefault();
        }
        
        function handleDrop(ev, sectionId) {
            ev.preventDefault();
            const id = ev.dataTransfer.getData("id");
            if (!id) return;
            
            const w = parseInt(ev.dataTransfer.getData("w")) || 4;
            const h = parseInt(ev.dataTransfer.getData("h")) || 4;
            const name = ev.dataTransfer.getData("name");
            const img = ev.dataTransfer.getData("img");
            const minW = parseInt(ev.dataTransfer.getData("minw")) || 0;
            const maxW = parseInt(ev.dataTransfer.getData("maxw")) || 0;
            const minH = parseInt(ev.dataTransfer.getData("minh")) || 0;
            const maxH = parseInt(ev.dataTransfer.getData("maxh")) || 0;
            const resizable = ev.dataTransfer.getData("resizable") === "true";
            
            // Generate content
            const content = `
                <div class="w-full h-full relative" data-type="Standard">
                    <button type="button" class="remove-widget-btn" onclick="removeWidget(this, '${sectionId}')"><i class="fa-solid fa-xmark"></i></button>
                    <div class="w-full h-full flex flex-col bg-white">
                        <div class="px-3 py-2 border-b border-slate-100 bg-slate-50/50">
                            <p class="text-xs font-semibold text-slate-600 truncate">${name}</p>
                        </div>
                        <div class="flex-1 p-2 flex items-center justify-center overflow-hidden">
                            <img src="${img}" class="widget-img" alt="${name}" onerror="this.src='/img/placeholder.png'; this.onerror=null;"/>
                        </div>
                    </div>
                </div>
            `;
            
            grids[sectionId].addWidget({w: w, h: h, content: content, id: id, autoPosition: true, minW: minW > 0 ? minW : undefined, maxW: maxW > 0 ? maxW : undefined, minH: minH > 0 ? minH : undefined, maxH: maxH > 0 ? maxH : undefined, noResize: !resizable});
        }
        
        function removeWidget(btn, sectionId) {
            const el = btn.closest('.grid-stack-item');
            if(grids[sectionId]) grids[sectionId].removeWidget(el);
        }
        
        function generateSlug(val) {
            // Only auto-generate if we are creating new and slug is mostly empty
            const slugInput = document.getElementById('dashboardSlug');
            const isNew = !document.getElementById('dashboardId').value;
            
            if (isNew) {
                slugInput.value = val.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            }
        }
        
        let slugCheckTimeout;
        async function checkSlugUnique() {
            const slug = document.getElementById('dashboardSlug').value.trim();
            const id = document.getElementById('dashboardId').value;
            const spinner = document.getElementById('slugCheckSpinner');
            const error = document.getElementById('slugError');
            
            if (!slug) return;
            
            clearTimeout(slugCheckTimeout);
            slugCheckTimeout = setTimeout(async () => {
                spinner.classList.remove('hidden');
                try {
                    const response = await fetch(`/Dashboard/CheckSlug?slug=${encodeURIComponent(slug)}&excludeId=${id}`);
                    if (response.ok) {
                        const data = await response.json();
                        if (!data.isAvailable) {
                            error.textContent = "This URL slug is already taken.";
                            error.classList.remove('hidden');
                            document.getElementById('dashboardSlug').classList.add('ring-red-500', 'focus:ring-red-500');
                        } else {
                            error.classList.add('hidden');
                            document.getElementById('dashboardSlug').classList.remove('ring-red-500', 'focus:ring-red-500');
                        }
                    }
                } catch (e) {
                    console.error("Failed to check slug", e);
                } finally {
                    spinner.classList.add('hidden');
                }
            }, 500);
        }

        function clearErrors() {
            document.getElementById('nameError').classList.add('hidden');
            document.getElementById('slugError').classList.add('hidden');
            document.getElementById('dashboardName').classList.remove('ring-red-500', 'focus:ring-red-500');
            document.getElementById('dashboardSlug').classList.remove('ring-red-500', 'focus:ring-red-500');
        }

        const dashboardNames = ["Alpha Nexus", "Metrics Hub", "Executive View", "Command Center", "Operations Deck", "Financial Pulse", "Growth Engine", "Insight Matrix", "Data Core"];
        function randomizeName() {
            const random = dashboardNames[Math.floor(Math.random() * dashboardNames.length)];
            const input = document.getElementById('dashboardName');
            input.value = random;
            generateSlug(random);
            clearErrors();
            checkSlugUnique();
        }

        function createWidget(urlBase) {
            const slug = document.getElementById('dashboardSlug').value.trim();
            if (!slug) {
                document.getElementById('nameError').textContent = "Please set a Dashboard Name and Slug first.";
                document.getElementById('nameError').classList.remove('hidden');
                document.getElementById('dashboardName').focus();
                return;
            }
            
            const returnUrl = encodeURIComponent('/Dashboard/Builder?slug=' + slug);
            const fullUrl = urlBase + (urlBase.includes('?') ? '&' : '?') + 'returnUrl=' + returnUrl + '&dashboardSlug=' + encodeURIComponent(slug);
            
            // Try saving the dashboard first to preserve current layout state
            saveDashboard(fullUrl);
        }

        const rawComponentsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allRawComponents.Select(r => new { r.Id, r.Name, r.Type, r.MinWidth, r.MaxWidth, r.MinHeight, r.MaxHeight, r.IsResizable })));
        
        let rawSelectInstance = null;

        function openRawModal(type) {
            const select = document.getElementById('rawComponentSelect');
            
            if (rawSelectInstance) {
                rawSelectInstance.destroy();
            }
            
            select.innerHTML = '<option value="">-- Select --</option>';
            
            const filtered = rawComponentsData.filter(r => r.Type === type);
            if (filtered.length === 0) {
                select.innerHTML = `<option value="">No ${type} components available.</option>`;
                select.disabled = true;
            } else {
                select.disabled = false;
                filtered.forEach(r => {
                    const opt = document.createElement('option');
                    opt.value = r.Id;
                    const minTxt = r.MinWidth > 0 && r.MinHeight > 0 ? r.MinWidth + "x" + r.MinHeight : "None";
                    const maxTxt = r.MaxWidth > 0 && r.MaxHeight > 0 ? r.MaxWidth + "x" + r.MaxHeight : "None";
                    opt.textContent = `${r.Name} (Min: ${minTxt} | Max: ${maxTxt} | Resize: ${r.IsResizable ? 'Y' : 'N'})`;
                    select.appendChild(opt);
                });
            }
            
            if (!select.disabled) {
                rawSelectInstance = new TomSelect(select, {
                    create: false,
                    dropdownParent: "body",
                    sortField: { field: "text", direction: "asc" },
                    onChange: function(value) {
                        updateRawComponentDetails(value);
                    }
                });
            }
            
            document.getElementById('rawModalTitle').textContent = `Add Existing ${type === 'RawHtml' ? 'Raw HTML' : 'JSON Config'} Component`;
            document.getElementById('rawComponentSelect').setAttribute('data-type', type);
            document.getElementById('rawComponentModal').classList.remove('hidden');
        }

        function updateRawComponentDetails(id) {
            const detailsDiv = document.getElementById('rawComponentDetails');
            if (!id) {
                detailsDiv.classList.add('hidden');
                return;
            }
            
            const comp = rawComponentsData.find(r => r.Id === id);
            if (comp) {
                document.getElementById('rawMinW').textContent = comp.MinWidth > 0 ? comp.MinWidth : 'None';
                document.getElementById('rawMaxW').textContent = comp.MaxWidth > 0 ? comp.MaxWidth : 'None';
                document.getElementById('rawMinH').textContent = comp.MinHeight > 0 ? comp.MinHeight : 'None';
                document.getElementById('rawMaxH').textContent = comp.MaxHeight > 0 ? comp.MaxHeight : 'None';
                document.getElementById('rawResizable').innerHTML = comp.IsResizable ? '<span class="text-green-600">Yes</span>' : '<span class="text-red-500">No (Fixed)</span>';
                detailsDiv.classList.remove('hidden');
            } else {
                detailsDiv.classList.add('hidden');
            }
        }

        function closeRawModal() {
            document.getElementById('rawComponentModal').classList.add('hidden');
        }

        function addSelectedRawComponent() {
            const select = document.getElementById('rawComponentSelect');
            const id = select.value;
            if (!id) return;
            
            const name = rawSelectInstance ? rawSelectInstance.options[id].text : select.options[select.selectedIndex].text;
            const type = select.getAttribute('data-type');
            
            const badgeClass = type === 'RawHtml' ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800';
            
            const content = `
                <div class="w-full h-full relative" data-type="${type}" data-raw-id="${id}">
                    <button type="button" class="remove-widget-btn" onclick="removeWidget(this, '${Object.keys(grids)[0]}')"><i class="fa-solid fa-xmark"></i></button>
                    <div class="w-full h-full flex flex-col bg-white">
                        <div class="px-3 py-2 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                            <p class="text-xs font-semibold text-slate-600 truncate">${name}</p>
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-medium ${badgeClass}">${type}</span>
                        </div>
                        <div class="flex-1 p-4 flex items-center justify-center overflow-hidden bg-slate-50">
                            <i class="fa-solid fa-code text-4xl text-slate-300"></i>
                        </div>
                    </div>
                </div>`;
            
            const firstGridId = Object.keys(grids)[0];
            const comp = rawComponentsData.find(r => r.Id === id);
            let widgetProps = {w: 4, h: 4, content: content, id: id, autoPosition: true};
            if (comp) {
                if (comp.MinWidth > 0) widgetProps.minW = comp.MinWidth;
                if (comp.MaxWidth > 0) widgetProps.maxW = comp.MaxWidth;
                if (comp.MinHeight > 0) widgetProps.minH = comp.MinHeight;
                if (comp.MaxHeight > 0) widgetProps.maxH = comp.MaxHeight;
                widgetProps.noResize = !comp.IsResizable;
            }
            grids[firstGridId].addWidget(widgetProps);
            closeRawModal();
        }

        async function saveDashboard(redirectUrl = null) {
            const btn = document.getElementById('saveBtn');
            const originalHtml = btn.innerHTML;
            
            const name = document.getElementById('dashboardName').value.trim();
            const slug = document.getElementById('dashboardSlug').value.trim();
            const id = document.getElementById('dashboardId').value;
            
            let hasError = false;
            if (!name) {
                const nameErr = document.getElementById('nameError');
                nameErr.textContent = "Dashboard Name is required.";
                nameErr.classList.remove('hidden');
                document.getElementById('dashboardName').classList.add('ring-red-500', 'focus:ring-red-500');
                hasError = true;
            }
            if (!slug) {
                const slugErr = document.getElementById('slugError');
                slugErr.textContent = "URL Slug is required.";
                slugErr.classList.remove('hidden');
                document.getElementById('dashboardSlug').classList.add('ring-red-500', 'focus:ring-red-500');
                hasError = true;
            }
            
            if (!document.getElementById('slugError').classList.contains('hidden') && document.getElementById('slugError').textContent.includes('taken')) {
                hasError = true;
            }
            
            if (hasError) return;
            
            const payload = {
                Id: id,
                Name: name,
                Slug: slug,
                Sections: []
            };

            for (const [secId, g] of Object.entries(grids)) {
                const wrapper = document.getElementById(`wrapper_${secId}`);
                const secName = wrapper ? wrapper.querySelector('.section-name').value || "Section" : "Section";
                
                const components = g.engine.nodes.map(n => {
                    const el = n.el.querySelector('[data-type]');
                    const type = el ? el.getAttribute('data-type') : "Standard";
                    const rawId = el ? el.getAttribute('data-raw-id') : null;
                    
                    return {
                        ComponentId: type === 'Standard' ? n.id : '00000000-0000-0000-0000-000000000000',
                        RawComponentId: type !== 'Standard' ? n.id : null,
                        Type: type,
                        X: n.x,
                        Y: n.y,
                        Width: n.w,
                        Height: n.h
                    };
                });
                
                payload.Sections.push({
                    Id: secId,
                    Name: secName,
                    Components: components
                });
            }
            
            try {
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Saving...';
                btn.disabled = true;
                
                const response = await fetch('/Dashboard/Save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(payload)
                });
                
                if (response.ok) {
                    if (redirectUrl) {
                        window.location.href = redirectUrl;
                    } else {
                        window.location.href = '/Dashboard/Manage';
                    }
                } else {
                    const text = await response.text();
                    document.getElementById('nameError').textContent = "Error saving dashboard: " + text;
                    document.getElementById('nameError').classList.remove('hidden');
                }
            } catch (err) {
                console.error(err);
                document.getElementById('nameError').textContent = "An error occurred while saving.";
                document.getElementById('nameError').classList.remove('hidden');
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }
        
        function filterComponents() {
            const query = document.getElementById('componentSearch').value.toLowerCase();
            const groups = document.querySelectorAll('.component-group');
            
            groups.forEach(group => {
                let hasVisible = false;
                const cards = group.querySelectorAll('.component-card');
                
                cards.forEach(card => {
                    const name = card.getAttribute('data-name').toLowerCase();
                    if (name.includes(query)) {
                        card.style.display = 'flex';
                        hasVisible = true;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                if (hasVisible) {
                    group.style.display = 'block';
                } else {
                    group.style.display = 'none';
                }
            });
        }
    </script>
}
