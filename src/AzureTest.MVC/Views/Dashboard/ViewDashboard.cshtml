@model AzureTest.MVC.Controllers.DashboardViewModel
@{
    ViewData["Title"] = Model.Dashboard.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allComponents = ViewBag.AllComponents as Dictionary<Guid, AzureTest.Domain.Documents.DashboardComponent>;
    var allRawComponents = ViewBag.AllRawComponents as Dictionary<Guid, AzureTest.Domain.Documents.DashboardRawComponent>;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/gridstack@8.2.3/dist/gridstack.min.css" rel="stylesheet"/>
    <style>
        .grid-stack-item-content {
            background-color: transparent !important;
            border: none !important;
            overflow: visible !important;
        }
        
        /* Ensure partials stretch to fill the grid item */
        .grid-stack-item-content > div {
            height: 100% !important;
            margin: 0 !important;
        }
    </style>
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4">
    <div>
        <h1 class="text-3xl font-bold text-slate-800">@Model.Dashboard.Name</h1>
        <div class="flex items-center text-sm text-slate-500 mt-1">
            <span class="inline-flex items-center rounded-md bg-brand-50 px-2 py-1 text-xs font-medium text-brand-700 ring-1 ring-inset ring-brand-600/20 mr-2">Custom Layout</span>
            <span>/@Model.Dashboard.Slug</span>
        </div>
        @if (Model.HomeModel.IsAdmin && !string.IsNullOrWhiteSpace(Model.HomeModel.CurrentUserName))
        {
            <p class="text-sm font-medium text-brand-600 mt-2">
                <i class="fa-solid fa-eye mr-1"></i> Viewing: @Model.HomeModel.CurrentUserName
            </p>
        }
    </div>
    
    <div class="flex gap-3 items-center">
        @if (Model.HomeModel.IsAdmin)
        {
            <form method="get" class="flex items-center gap-2 mr-4">
                <select name="targetUserId" class="block w-64 rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm">
                    <option value="">-- All Users (Aggregate) --</option>
                    @foreach (var user in Model.HomeModel.AvailableUsers)
                    {
                        if (user.Key == Model.HomeModel.CurrentUserId)
                        {
                            <option value="@user.Key" selected>@user.Value</option>
                        }
                        else
                        {
                            <option value="@user.Key">@user.Value</option>
                        }
                    }
                </select>
                <button type="submit" class="bg-slate-800 text-white px-3 py-2 rounded-md hover:bg-slate-700 text-sm font-medium transition-colors shadow-sm">
                    Switch
                </button>
            </form>
        }
        <a asp-controller="Home" asp-action="Index" asp-route-ignorePreference="true" class="inline-flex items-center justify-center rounded-lg bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
            <i class="fa-solid fa-table-cells-large mr-2"></i> Standard View
        </a>
        <a asp-controller="Dashboard" asp-action="Builder" asp-route-slug="@Model.Dashboard.Slug" class="inline-flex items-center justify-center rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200 transition-all shadow-sm">
            <i class="fa-solid fa-pen-to-square mr-2"></i> Edit Layout
        </a>
    </div>
</div>

<div class="space-y-8">
    @if(Model.Dashboard.Sections.Any())
    {
        foreach(var dashboardSection in Model.Dashboard.Sections)
        {
            <div class="section-container bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                @if(Model.Dashboard.Sections.Count > 1 || dashboardSection.Name != "Main Layout")
                {
                    <h2 class="text-xl font-bold text-slate-800 mb-4 pb-2 border-b border-slate-100">@dashboardSection.Name</h2>
                }
                
                <div class="grid-stack" id="grid-@dashboardSection.Id">
                    @foreach(var c in dashboardSection.Components)
                    {
                        if (c.Type == "Standard" && allComponents != null && allComponents.TryGetValue(c.ComponentId, out var comp))
                        {
                            <div class="grid-stack-item" gs-x="@c.X" gs-y="@c.Y" gs-w="@c.Width" gs-h="@c.Height" gs-no-resize="true" gs-no-move="true">
                                <div class="grid-stack-item-content">
                                    @await Html.PartialAsync($"Widgets/{comp.PartialViewName}", Model.HomeModel)
                                </div>
                            </div>
                        }
                        else if (c.Type != "Standard" && allRawComponents != null && c.RawComponentId.HasValue && allRawComponents.TryGetValue(c.RawComponentId.Value, out var rawComp))
                        {
                            <div class="grid-stack-item" gs-x="@c.X" gs-y="@c.Y" gs-w="@c.Width" gs-h="@c.Height" gs-no-resize="true" gs-no-move="true">
                                <div class="grid-stack-item-content">
                                    @if (rawComp.Type == "RawHtml" && !string.IsNullOrWhiteSpace(rawComp.HtmlContent))
                                    {
                                        <div class="h-full w-full">
                                            @Html.Raw(rawComp.HtmlContent)
                                        </div>
                                    }
                                    else if (rawComp.Type == "JsonConfig" && !string.IsNullOrWhiteSpace(rawComp.JsonConfiguration))
                                    {
                                        <div class="p-4 bg-white rounded-xl shadow-sm h-full w-full border border-slate-200 flex flex-col" id="widget-@rawComp.Id">
                                            <h3 class="font-bold text-slate-800 mb-4" id="title-@rawComp.Id">@rawComp.Name</h3>
                                            <div class="flex-1 min-h-0 relative">
                                                <canvas id="chart-@rawComp.Id-@(dashboardSection.Id)" class="w-full h-full"></canvas>
                                            </div>
                                            
                                            <script>
                                                document.addEventListener("DOMContentLoaded", function () {
                                                    try {
                                                        const config = JSON.parse(`@Html.Raw(rawComp.JsonConfiguration.Replace("'", "\\'").Replace("\n", ""))`);
                                                        
                                                        const isPie = config.chartType === 'pie' || config.chartType === 'doughnut';
                                                        const bgColors = isPie ? ['#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#14b8a6', '#f43f5e', '#0ea5e9'] : (config.themeColor || '#3b82f6');
                                                        
                                                        if (!config.endpointUrl) {
                                                            document.getElementById('title-@rawComp.Id').style.display = 'none';
                                                            new Chart(document.getElementById('chart-@rawComp.Id-@(dashboardSection.Id)'), {
                                                                type: config.chartType || 'bar',
                                                                data: {
                                                                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May'],
                                                                    datasets: [{
                                                                        label: config.title || 'Dynamic Data',
                                                                        data: [12, 19, 3, 5, 2],
                                                                        backgroundColor: bgColors,
                                                                        borderColor: config.themeColor || '#3b82f6',
                                                                        borderWidth: 2,
                                                                        tension: 0.3
                                                                    }]
                                                                },
                                                                options: { 
                                                                    maintainAspectRatio: false,
                                                                    plugins: {
                                                                        legend: { position: isPie ? 'right' : 'top', labels: { boxWidth: 12 } }
                                                                    }
                                                                }
                                                            });
                                                            return;
                                                        }

                                                        let fetchUrl = config.endpointUrl;
                                                        const viewName = '@Html.Raw(rawComp.ViewName ?? "")';
                                                        if (viewName) {
                                                            fetchUrl += (fetchUrl.includes('?') ? '&' : '?') + 'viewName=' + encodeURIComponent(viewName);
                                                            fetch(fetchUrl)
                                                                .then(res => res.text())
                                                                .then(html => {
                                                                    document.getElementById('title-@rawComp.Id').style.display = 'none';
                                                                    document.getElementById('widget-@rawComp.Id').innerHTML = html;
                                                                })
                                                                .catch(err => {
                                                                    console.error('Error fetching view', err);
                                                                    document.getElementById('widget-@rawComp.Id').innerHTML = '<p class="text-red-500 text-xs p-2">Error loading view.</p>';
                                                                });
                                                            return;
                                                        }

                                                        fetch(config.endpointUrl)
                                                            .then(res => res.json())
                                                            .then(data => {
                                                                if (config.chartType === 'kpi') {
                                                                    document.getElementById('widget-@rawComp.Id').innerHTML = `
                                                                        <div class="flex items-center justify-center h-full flex-col">
                                                                            <p class="text-slate-500 text-sm font-medium">${config.title || '@Html.Raw(rawComp.Name.Replace("'", "\\'"))'}</p>
                                                                            <h2 class="text-4xl font-bold mt-2" style="color: ${config.themeColor || '#1e293b'}">${data.value !== undefined ? data.value : data}</h2>
                                                                        </div>
                                                                    `;
                                                                    return;
                                                                }
                                                                if (config.chartType === 'list') {
                                                                    let html = '<ul class="space-y-3 overflow-y-auto h-full p-2">';
                                                                    data.forEach(item => {
                                                                        html += `<li class="border-b border-slate-100 pb-2"><p class="font-semibold text-sm text-slate-800">${item.title}</p><p class="text-xs text-slate-500">${item.subtitle || ''}</p></li>`;
                                                                    });
                                                                    html += '</ul>';
                                                                    document.getElementById('widget-@rawComp.Id').innerHTML = `
                                                                        <h3 class="font-bold text-slate-800 mb-2 px-2">${config.title || '@Html.Raw(rawComp.Name.Replace("'", "\\'"))'}</h3>
                                                                        <div class="flex-1 relative min-h-0">
                                                                            ${html}
                                                                        </div>
                                                                    `;
                                                                    return;
                                                                }

                                                                document.getElementById('title-@rawComp.Id').style.display = 'none';
                                                                new Chart(document.getElementById('chart-@rawComp.Id-@(dashboardSection.Id)'), {
                                                                    type: config.chartType || 'bar',
                                                                    data: {
                                                                        labels: data.map(d => d.title || d.name || 'Item'),
                                                                        datasets: [{
                                                                            label: config.title || 'Dynamic Data',
                                                                            data: data.map(d => d.value || d.amount || 0),
                                                                            backgroundColor: bgColors,
                                                                            borderColor: config.themeColor || '#3b82f6',
                                                                            borderWidth: 2,
                                                                            tension: 0.3
                                                                        }]
                                                                    },
                                                                    options: { 
                                                                        maintainAspectRatio: false,
                                                                        plugins: {
                                                                            legend: { position: isPie ? 'right' : 'top', labels: { boxWidth: 12 } }
                                                                        }
                                                                    }
                                                                });
                                                            });
                                                    } catch (e) {
                                                        console.error('Error rendering dynamic widget @rawComp.Id', e);
                                                        document.getElementById('widget-@rawComp.Id').innerHTML += '<p class="text-red-500 text-xs mt-2">Error parsing configuration.</p>';
                                                    }
                                                });
                                            </script>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/gridstack@8.2.3/dist/gridstack-all.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            GridStack.initAll({
                staticGrid: true, // Read-only mode
                cellHeight: 80,
                margin: 10,
                float: true,
                disableOneColumnMode: true
            }, '.grid-stack');
        });
    </script>
    @await Html.PartialAsync("Widgets/_DashboardScripts", Model.HomeModel)
}
