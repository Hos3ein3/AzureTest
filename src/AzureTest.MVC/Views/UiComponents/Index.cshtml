@{
    ViewData["Title"] = "UI Components Catalog";
}

<!-- Page Header -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-brand-600 transition-colors">Home</a>
            <i class="fa-solid fa-chevron-right text-3xs"></i>
            <span class="text-slate-600 font-semibold">Design System</span>
            <i class="fa-solid fa-chevron-right text-3xs"></i>
            <span class="text-slate-600 font-semibold">UI Components</span>
        </nav>
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-xl shadow-sm">
                <i class="fa-solid fa-shapes"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                    UI Components Catalog
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-100 text-brand-700">Design System</span>
                </h1>
                <p class="text-xs text-slate-500 mt-0.5">Comprehensive, copy-paste component library matching the application's Tailwind CSS design standards.</p>
            </div>
        </div>
    </div>

    <!-- Quick Search Components Bar -->
    <div class="flex items-center gap-3">
        <div class="relative w-full sm:w-72">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input id="componentFilterInput" type="text" onkeyup="filterComponents()" placeholder="Filter components (e.g. modal, button, toast)..."
                   class="w-full pl-9 pr-8 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            <button type="button" onclick="clearComponentFilter()" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-500 text-xs bg-transparent border-0 cursor-pointer hidden" id="clearComponentBtn">
                <i class="fa-solid fa-circle-xmark"></i>
            </button>
        </div>
    </div>
</div>

<!-- Category Jump Navigation Pills -->
<div class="bg-white rounded-2xl border border-slate-100 p-3 shadow-2xs mb-8 overflow-x-auto">
    <div class="flex items-center gap-1.5 min-w-max text-xs">
        <span class="text-2xs font-bold uppercase tracking-wider text-slate-400 px-2">Jump to:</span>
        <a href="#sec-buttons" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Buttons</a>
        <a href="#sec-inputs" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Form Inputs</a>
        <a href="#sec-toggles" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Checkboxes & Radios</a>
        <a href="#sec-textareas" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Textareas</a>
        <a href="#sec-dropdowns" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Dropdowns</a>
        <a href="#sec-modals" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Modals</a>
        <a href="#sec-toasts" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Toasts & Alerts</a>
        <a href="#sec-loaders" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Loaders & Progress</a>
        <a href="#sec-badges-tables" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Badges & Tables</a>
        <a href="#sec-filters-pagination" class="px-3 py-1.5 rounded-xl font-semibold bg-brand-50 text-brand-700 hover:bg-brand-100 transition-colors">Filters & Pagination</a>
    </div>
</div>

<div class="space-y-12">

    <!-- ========================================================================= -->
    <!-- SECTION 1: BUTTONS & ACTIONS -->
    <!-- ========================================================================= -->
    <section id="sec-buttons" class="component-section space-y-6">
        <div class="flex items-center gap-2.5 pb-2 border-b border-slate-200">
            <i class="fa-solid fa-hand-pointer text-brand-600 text-lg"></i>
            <h2 class="text-lg font-black text-slate-900 tracking-tight">1. Buttons & Actions</h2>
            <span class="text-3xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 uppercase">Interaction</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Component Card: Button Variants -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Button Variants primary secondary danger success warning ghost">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Button Color Variants</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Primary, Secondary, Destructive (Danger), Success, Warning, and Ghost.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-btn-variants', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <button type="button" class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white shadow-sm transition-colors">
                            Primary Action
                        </button>
                        <button type="button" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors">
                            Secondary
                        </button>
                        <button type="button" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-xs font-semibold text-white shadow-sm transition-colors">
                            <i class="fa-solid fa-trash-can mr-1.5 text-2xs"></i> Danger
                        </button>
                        <button type="button" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs font-semibold text-white shadow-sm transition-colors">
                            <i class="fa-solid fa-check mr-1.5 text-2xs"></i> Success
                        </button>
                        <button type="button" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-xs font-semibold text-white shadow-sm transition-colors">
                            <i class="fa-solid fa-triangle-exclamation mr-1.5 text-2xs"></i> Warning
                        </button>
                        <button type="button" class="px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-colors">
                            Ghost / Outline
                        </button>
                    </div>
                </div>
                <div class="border-t border-slate-100 bg-slate-900 text-slate-200 p-4 font-mono text-2xs overflow-x-auto">
<pre id="code-btn-variants"><code>&lt;!-- Primary --&gt;
&lt;button type="button" class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white shadow-sm transition-colors"&gt;
    Primary Action
&lt;/button&gt;

&lt;!-- Secondary --&gt;
&lt;button type="button" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors"&gt;
    Secondary
&lt;/button&gt;

&lt;!-- Danger / Destructive --&gt;
&lt;button type="button" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-xs font-semibold text-white shadow-sm transition-colors"&gt;
    &lt;i class="fa-solid fa-trash-can mr-1.5 text-2xs"&gt;&lt;/i&gt; Danger
&lt;/button&gt;

&lt;!-- Success --&gt;
&lt;button type="button" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs font-semibold text-white shadow-sm transition-colors"&gt;
    &lt;i class="fa-solid fa-check mr-1.5 text-2xs"&gt;&lt;/i&gt; Success
&lt;/button&gt;</code></pre>
                </div>
            </div>

            <!-- Component Card: Button Sizes & Icon States -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Button Sizes Loading Icon Buttons Group">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Sizes, Loading & Icon Buttons</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Small, standard, large, loading spinners, and circular icon controls.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-btn-sizes', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-4">
                    <!-- Sizes -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <button type="button" class="px-2.5 py-1 rounded-lg bg-brand-600 text-white text-3xs font-semibold">Extra Small</button>
                        <button type="button" class="px-3.5 py-1.5 rounded-xl bg-brand-600 text-white text-xs font-semibold">Small</button>
                        <button type="button" class="px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-semibold">Default</button>
                        <button type="button" class="px-5 py-2.5 rounded-2xl bg-brand-600 text-white text-sm font-semibold">Large</button>
                    </div>
                    <!-- Loading & Icon Buttons -->
                    <div class="flex items-center gap-2 flex-wrap pt-2 border-t border-slate-200">
                        <button type="button" disabled class="px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-semibold opacity-75 cursor-not-allowed inline-flex items-center gap-2">
                            <i class="fa-solid fa-spinner fa-spin text-2xs"></i>
                            Processing...
                        </button>
                        <button type="button" class="w-9 h-9 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-600 transition-colors shadow-2xs" title="Favorite">
                            <i class="fa-regular fa-star text-xs"></i>
                        </button>
                        <button type="button" class="w-9 h-9 rounded-full bg-rose-50 text-rose-600 hover:bg-rose-100 flex items-center justify-center transition-colors" title="Delete">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                        <!-- Button Group -->
                        <div class="inline-flex rounded-xl shadow-2xs border border-slate-200 overflow-hidden bg-white">
                            <button type="button" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 border-r border-slate-200">Day</button>
                            <button type="button" class="px-3 py-1.5 text-xs font-semibold bg-brand-600 text-white">Week</button>
                            <button type="button" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 border-l border-slate-200">Month</button>
                        </div>
                    </div>
                </div>
                <div class="border-t border-slate-100 bg-slate-900 text-slate-200 p-4 font-mono text-2xs overflow-x-auto">
<pre id="code-btn-sizes"><code>&lt;!-- Loading State --&gt;
&lt;button type="button" disabled class="px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-semibold opacity-75 cursor-not-allowed inline-flex items-center gap-2"&gt;
    &lt;i class="fa-solid fa-spinner fa-spin text-2xs"&gt;&lt;/i&gt;
    Processing...
&lt;/button&gt;

&lt;!-- Button Group / Segmented Control --&gt;
&lt;div class="inline-flex rounded-xl shadow-2xs border border-slate-200 overflow-hidden bg-white"&gt;
    &lt;button class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 border-r border-slate-200"&gt;Day&lt;/button&gt;
    &lt;button class="px-3 py-1.5 text-xs font-semibold bg-brand-600 text-white"&gt;Week&lt;/button&gt;
    &lt;button class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 border-l border-slate-200"&gt;Month&lt;/button&gt;
&lt;/div&gt;</code></pre>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 2: FORM INPUTS -->
    <!-- ========================================================================= -->
    <section id="sec-inputs" class="component-section space-y-6">
        <div class="flex items-center gap-2.5 pb-2 border-b border-slate-200">
            <i class="fa-solid fa-i-cursor text-brand-600 text-lg"></i>
            <h2 class="text-lg font-black text-slate-900 tracking-tight">2. Text & Form Inputs</h2>
            <span class="text-3xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 uppercase">Forms</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Component Card: Text, Email, Password Inputs -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Text Input Email Password input show hide">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Text, Email & Password Toggles</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Input with icons, validation helper, and password show/hide action.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-text-inputs', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-4">
                    <!-- Standard Text Input -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Full Name</label>
                        <input type="text" placeholder="e.g. Alexander Hamilton" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                        <span class="text-3xs text-slate-400 mt-1 block">Enter your legal full name for identity records.</span>
                    </div>

                    <!-- Input with Leading Icon -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address</label>
                        <div class="relative">
                            <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="email" placeholder="name@company.com" class="w-full pl-9 pr-3.5 py-2 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                        </div>
                    </div>

                    <!-- Password Input with Toggle -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Password</label>
                        <div class="relative">
                            <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input id="demoPasswordInput" type="password" value="SuperSecret123!" class="w-full pl-9 pr-10 py-2 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                            <button type="button" onclick="togglePasswordVisibility('demoPasswordInput', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 bg-transparent border-0 cursor-pointer">
                                <i class="fa-solid fa-eye text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="border-t border-slate-100 bg-slate-900 text-slate-200 p-4 font-mono text-2xs overflow-x-auto">
<pre id="code-text-inputs"><code>&lt;!-- Password with Show/Hide Toggle --&gt;
&lt;div class="relative"&gt;
    &lt;i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"&gt;&lt;/i&gt;
    &lt;input id="passwordInput" type="password" class="w-full pl-9 pr-10 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-brand-500" /&gt;
    &lt;button type="button" onclick="togglePasswordVisibility('passwordInput', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600"&gt;
        &lt;i class="fa-solid fa-eye text-xs"&gt;&lt;/i&gt;
    &lt;/button&gt;
&lt;/div&gt;</code></pre>
                </div>
            </div>

            <!-- Component Card: Number, Date, Error States -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Number Stepper Date Picker Time Validation Error">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Number Stepper, Dates & Errors</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Numeric step controls, date inputs, and error validation states.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-number-date', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-4">
                    <!-- Number with Stepper -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Quantity (Stepper)</label>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="stepNumber('demoStepper', -1)" class="w-9 h-9 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 flex items-center justify-center text-slate-600 font-bold transition-colors">
                                <i class="fa-solid fa-minus text-2xs"></i>
                            </button>
                            <input id="demoStepper" type="number" value="1" min="1" max="100" class="w-24 text-center rounded-xl border border-slate-300 py-2 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                            <button type="button" onclick="stepNumber('demoStepper', 1)" class="w-9 h-9 rounded-xl border border-slate-300 bg-white hover:bg-slate-100 flex items-center justify-center text-slate-600 font-bold transition-colors">
                                <i class="fa-solid fa-plus text-2xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Date & Time Picker -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Date</label>
                            <input type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Time</label>
                            <input type="time" value="14:30" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
                        </div>
                    </div>

                    <!-- Input with Validation Error State -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-rose-700 mb-1">Username (Invalid Example)</label>
                        <div class="relative">
                            <input type="text" value="invalid@@user!" class="w-full rounded-xl border border-rose-300 bg-rose-50/40 px-3.5 py-2 text-xs text-rose-900 focus:outline-none focus:ring-2 focus:ring-rose-500" />
                            <i class="fa-solid fa-circle-exclamation absolute right-3.5 top-1/2 -translate-y-1/2 text-rose-500 text-xs"></i>
                        </div>
                        <span class="text-3xs text-rose-600 mt-1 block font-medium">Username can only contain alphanumeric characters.</span>
                    </div>
                </div>
                <div class="border-t border-slate-100 bg-slate-900 text-slate-200 p-4 font-mono text-2xs overflow-x-auto">
<pre id="code-number-date"><code>&lt;!-- Input with Validation Error State --&gt;
&lt;div class="relative"&gt;
    &lt;input type="text" class="w-full rounded-xl border border-rose-300 bg-rose-50/40 px-3.5 py-2 text-xs text-rose-900 focus:ring-2 focus:ring-rose-500" /&gt;
    &lt;i class="fa-solid fa-circle-exclamation absolute right-3.5 top-1/2 -translate-y-1/2 text-rose-500 text-xs"&gt;&lt;/i&gt;
&lt;/div&gt;
&lt;span class="text-3xs text-rose-600 mt-1 block font-medium"&gt;Validation error message here.&lt;/span&gt;</code></pre>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 3: CHECKBOXES, TOGGLES & RADIOS -->
    <!-- ========================================================================= -->
    <section id="sec-toggles" class="component-section space-y-6">
        <div class="flex items-center gap-2.5 pb-2 border-b border-slate-200">
            <i class="fa-solid fa-toggle-on text-brand-600 text-lg"></i>
            <h2 class="text-lg font-black text-slate-900 tracking-tight">3. Checkboxes, Toggles & Radios</h2>
            <span class="text-3xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 uppercase">Selection</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Component Card: Checkboxes & Switches -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Checkbox Toggle Switch iOS Switch">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Checkboxes & iOS Switches</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Native styled checkboxes and animated toggle switches.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-checkboxes', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-4">
                    <!-- Standard Checkboxes -->
                    <div class="space-y-2.5">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" checked class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300" />
                            <span class="text-xs font-semibold text-slate-800">Email Notifications (Checked)</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300" />
