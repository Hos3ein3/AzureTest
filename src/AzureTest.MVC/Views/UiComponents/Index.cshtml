@section Scripts {
<script>
    // Copy Code Snippet
    function copySnippet(elementId, btn) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const codeText = el.innerText;
        navigator.clipboard.writeText(codeText).then(() => {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check text-emerald-600 text-3xs"></i> <span class="text-emerald-700 font-bold">Copied!</span>';
            setTimeout(() => {
                btn.innerHTML = originalHtml;
            }, 2000);
        });
    }

    // Accordion Toggle
    function toggleAccordion(id, btn) {
        const content = document.getElementById(id);
        const chevron = btn.querySelector('.accordion-chevron');
        if (!content) return;

        const isHidden = content.classList.contains('hidden');
        content.classList.toggle('hidden');
        if (chevron) {
            chevron.classList.toggle('rotate-180', isHidden);
        }
    }

    // Tab Switching
    function switchTab(groupName, panelId, btn) {
        // Find sibling tabs
        const tabBtns = btn.parentElement.querySelectorAll('.tab-btn');
        tabBtns.forEach(t => {
            t.classList.remove('text-brand-600', 'border-brand-600', 'font-bold');
            t.classList.add('text-slate-500', 'border-transparent', 'font-semibold');
        });

        btn.classList.add('text-brand-600', 'border-brand-600', 'font-bold');
        btn.classList.remove('text-slate-500', 'border-transparent', 'font-semibold');

        // Hide all sibling panels
        const container = btn.parentElement.nextElementSibling;
        if (container) {
            const panels = container.querySelectorAll('.tab-panel');
            panels.forEach(p => p.classList.add('hidden'));
        }

        const targetPanel = document.getElementById(panelId);
        if (targetPanel) {
            targetPanel.classList.remove('hidden');
        }
    }

    // Password Toggle
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            if (icon) { icon.className = 'fa-solid fa-eye-slash text-xs'; }
        } else {
            input.type = 'password';
            if (icon) { icon.className = 'fa-solid fa-eye text-xs'; }
        }
    }

    // Number Stepper
    function stepNumber(inputId, delta) {
        const input = document.getElementById(inputId);
        if (!input) return;
        let val = parseFloat(input.value) || 0;
        val += delta;
        if (input.min && val < parseFloat(input.min)) val = parseFloat(input.min);
        if (input.max && val > parseFloat(input.max)) val = parseFloat(input.max);
        input.value = val;
    }

    // Custom Date Picker Logic
    let currentPickerYear = 2026;
    let currentPickerMonth = 9; // 0-indexed, 9 = October
    let selectedDay = 20;

    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    function renderCustomCalendar() {
        const grid = document.getElementById('calendarDaysGrid');
        const monthYearLabel = document.getElementById('calendarMonthYear');
        if (!grid || !monthYearLabel) return;

        monthYearLabel.innerText = `${monthNames[currentPickerMonth]} ${currentPickerYear}`;
        grid.innerHTML = '';

        // Days in month
        const daysInMonth = new Date(currentPickerYear, currentPickerMonth + 1, 0).getDate();
        // First day index (Monday = 0, Sunday = 6)
        let firstDay = new Date(currentPickerYear, currentPickerMonth, 1).getDay();
        firstDay = (firstDay + 6) % 7; // Convert to Monday-start

        // Blanks for prior month
        for (let i = 0; i < firstDay; i++) {
            const blank = document.createElement('div');
            blank.className = 'p-2 text-slate-300 text-3xs';
            grid.appendChild(blank);
        }

        for (let d = 1; d <= daysInMonth; d++) {
            const dayBtn = document.createElement('button');
            dayBtn.type = 'button';
            const isSelected = (d === selectedDay && currentPickerMonth === 9 && currentPickerYear === 2026);
            dayBtn.className = `p-2 rounded-xl text-xs font-semibold transition-all ${
                isSelected
                    ? 'bg-brand-600 text-white font-bold shadow-xs'
                    : 'text-slate-700 hover:bg-slate-100'
            }`;
            dayBtn.innerText = d;
            dayBtn.onclick = () => selectCustomDate(d);
            grid.appendChild(dayBtn);
        }
    }

    function toggleCustomDatePicker() {
        const menu = document.getElementById('customDatePickerMenu');
        if (menu) {
            menu.classList.toggle('hidden');
        }
    }

    function changeCustomMonth(delta) {
        currentPickerMonth += delta;
        if (currentPickerMonth < 0) {
            currentPickerMonth = 11;
            currentPickerYear--;
        } else if (currentPickerMonth > 11) {
            currentPickerMonth = 0;
            currentPickerYear++;
        }
        renderCustomCalendar();
    }

    function selectCustomDate(day) {
        selectedDay = day;
        const mm = String(currentPickerMonth + 1).padStart(2, '0');
        const dd = String(day).padStart(2, '0');
        const display = document.getElementById('customDateDisplay');
        if (display) {
            display.value = `${currentPickerYear}-${mm}-${dd}`;
        }
        renderCustomCalendar();
    }

    function selectDatePreset(preset) {
        const today = new Date();
        let target = new Date(today);
        if (preset === 'tomorrow') {
            target.setDate(today.getDate() + 1);
        } else if (preset === 'nextWeek') {
            target.setDate(today.getDate() + 7);
        }
        currentPickerYear = target.getFullYear();
        currentPickerMonth = target.getMonth();
        selectedDay = target.getDate();
        selectCustomDate(selectedDay);
    }

    // Custom Time Picker Logic
    let currentHour = 2;
    let currentMinute = 30;
    let currentAmPm = 'PM';

    function updateTimeDisplay() {
        const hh = String(currentHour).padStart(2, '0');
        const mm = String(currentMinute).padStart(2, '0');
        const hourSpan = document.getElementById('timeHourDisplay');
        const minuteSpan = document.getElementById('timeMinuteDisplay');
        const displayInput = document.getElementById('customTimeDisplay');

        if (hourSpan) hourSpan.innerText = hh;
        if (minuteSpan) minuteSpan.innerText = mm;
        if (displayInput) displayInput.value = `${hh}:${mm} ${currentAmPm}`;
    }

    function stepCustomTime(part, delta) {
        if (part === 'hour') {
            currentHour += delta;
            if (currentHour > 12) currentHour = 1;
            if (currentHour < 1) currentHour = 12;
        } else if (part === 'minute') {
            currentMinute += delta;
            if (currentMinute >= 60) currentMinute = 0;
            if (currentMinute < 0) currentMinute = 55;
        }
        updateTimeDisplay();
    }

    function setCustomAmPm(val) {
        currentAmPm = val;
        const btnAm = document.getElementById('btnAm');
        const btnPm = document.getElementById('btnPm');
        if (val === 'AM') {
            btnAm?.classList.add('bg-brand-600', 'text-white', 'shadow-2xs');
            btnAm?.classList.remove('bg-slate-100', 'text-slate-600');
            btnPm?.classList.remove('bg-brand-600', 'text-white', 'shadow-2xs');
            btnPm?.classList.add('bg-slate-100', 'text-slate-600');
        } else {
            btnPm?.classList.add('bg-brand-600', 'text-white', 'shadow-2xs');
            btnPm?.classList.remove('bg-slate-100', 'text-slate-600');
            btnAm?.classList.remove('bg-brand-600', 'text-white', 'shadow-2xs');
            btnAm?.classList.add('bg-slate-100', 'text-slate-600');
        }
        updateTimeDisplay();
    }

    function applyTimePreset(timeStr) {
        const [timePart, ampm] = timeStr.split(' ');
        const [h, m] = timePart.split(':');
        currentHour = parseInt(h);
        currentMinute = parseInt(m);
        setCustomAmPm(ampm);
    }

    // Advanced Multi-Select Dropdown Logic
    function toggleAdvancedMultiSelect() {
        const menu = document.getElementById('advancedMultiSelectMenu');
        menu?.classList.toggle('hidden');
    }

    function filterMultiSelectOptions(term) {
        const filter = (term || '').toLowerCase();
        const items = document.querySelectorAll('#multiSelectOptionsList label');
        items.forEach(lbl => {
            const text = lbl.innerText.toLowerCase();
            lbl.style.display = text.includes(filter) ? 'flex' : 'none';
        });
    }

    function toggleMultiOption(checkbox) {
        const val = checkbox.getAttribute('data-value');
        const label = checkbox.getAttribute('data-label');
        const container = document.getElementById('multiSelectTagsContainer');

        if (checkbox.checked) {
            if (!container.querySelector(`[data-tag-val="${val}"]`)) {
                const span = document.createElement('span');
                span.className = 'inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-brand-50 text-brand-700 text-2xs font-semibold border border-brand-200';
                span.setAttribute('data-tag-val', val);
                span.innerHTML = `${label} <button type="button" onclick="removeMultiSelectTag('${val}')" class="text-brand-400 hover:text-brand-600 ml-1"><i class="fa-solid fa-xmark text-3xs"></i></button>`;
                container.appendChild(span);
            }
        } else {
            const tag = container.querySelector(`[data-tag-val="${val}"]`);
            tag?.remove();
        }
        updateMultiSelectBadge();
    }

    function removeMultiSelectTag(val) {
        const container = document.getElementById('multiSelectTagsContainer');
        const tag = container?.querySelector(`[data-tag-val="${val}"]`);
        tag?.remove();
        const cb = document.querySelector(`#multiSelectOptionsList input[data-value="${val}"]`);
        if (cb) cb.checked = false;
        updateMultiSelectBadge();
    }

    function selectAllMultiOptions() {
        const cbs = document.querySelectorAll('#multiSelectOptionsList input[type="checkbox"]');
        cbs.forEach(cb => {
            if (!cb.checked) {
                cb.checked = true;
                toggleMultiOption(cb);
            }
        });
    }

    function clearAllMultiOptions() {
        const cbs = document.querySelectorAll('#multiSelectOptionsList input[type="checkbox"]');
        cbs.forEach(cb => {
            cb.checked = false;
        });
        const container = document.getElementById('multiSelectTagsContainer');
        if (container) container.innerHTML = '';
        updateMultiSelectBadge();
    }

    function updateMultiSelectBadge() {
        const count = document.querySelectorAll('#multiSelectTagsContainer span[data-tag-val]').length;
        const badge = document.getElementById('multiSelectBadgeCount');
        if (badge) badge.innerText = `${count} Selected`;
    }

    // Sortable Table Logic
    let currentSortColumn = -1;
    let isAscending = true;

    function sortTable(tableId, columnIndex, type) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const headers = table.querySelectorAll('thead th');

        if (currentSortColumn === columnIndex) {
            isAscending = !isAscending;
        } else {
            currentSortColumn = columnIndex;
            isAscending = true;
        }

        // Update Icons
        headers.forEach((th, idx) => {
            const icon = th.querySelector('.sort-icon');
            if (icon) {
                if (idx === columnIndex) {
                    icon.className = `fa-solid fa-sort-${isAscending ? 'up' : 'down'} text-brand-600 text-3xs sort-icon`;
                } else {
                    icon.className = 'fa-solid fa-sort text-slate-400 text-3xs sort-icon';
                }
            }
        });

        rows.sort((a, b) => {
            const cellA = a.children[columnIndex];
            const cellB = b.children[columnIndex];

            if (type === 'number') {
                const valA = parseFloat(cellA.getAttribute('data-val') || cellA.innerText.replace(/[^0-9.-]+/g, '')) || 0;
                const valB = parseFloat(cellB.getAttribute('data-val') || cellB.innerText.replace(/[^0-9.-]+/g, '')) || 0;
                return isAscending ? valA - valB : valB - valA;
            } else {
                const valA = cellA.innerText.trim().toLowerCase();
                const valB = cellB.innerText.trim().toLowerCase();
                return isAscending ? valA.localeCompare(valB) : valB.localeCompare(valA);
            }
        });

        rows.forEach(r => tbody.appendChild(r));
    }

    function toggleAllTableRows(masterCheckbox) {
        const rowCheckboxes = document.querySelectorAll('.row-checkbox');
        rowCheckboxes.forEach(cb => cb.checked = masterCheckbox.checked);
    }

    // Single Searchable Dropdown
    function toggleSearchableMenu() {
        const menu = document.getElementById('searchableDropdownMenu');
        menu?.classList.toggle('hidden');
    }

    function filterSearchableOptions(term) {
        const filter = (term || '').toLowerCase();
        const items = document.querySelectorAll('#searchableOptionsList li');
        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            item.style.display = text.includes(filter) ? 'flex' : 'none';
        });
    }

    function selectSearchableOption(name, category) {
        const label = document.getElementById('searchableSelectedLabel');
        if (label) {
            label.innerText = `${name} (${category})`;
        }
        toggleSearchableMenu();
    }

    // Modal Helpers
    function openDemoModal(id) {
        document.getElementById(id)?.classList.remove('hidden');
    }
    function closeDemoModal(id) {
        document.getElementById(id)?.classList.add('hidden');
    }

    // Drawer Helpers
    function openDemoDrawer() {
        document.getElementById('demoSlideDrawer')?.classList.remove('hidden');
    }
    function closeDemoDrawer() {
        document.getElementById('demoSlideDrawer')?.classList.add('hidden');
    }

    // Floating Toast Notification
    function triggerCatalogToast(title, message, color) {
        const anchor = document.getElementById('catalogToastAnchor');
        if (!anchor) return;

        let icon = 'fa-circle-check text-emerald-600';
        let border = 'border-emerald-200';
        if (color === 'rose') { icon = 'fa-circle-xmark text-rose-600'; border = 'border-rose-200'; }
        else if (color === 'amber') { icon = 'fa-triangle-exclamation text-amber-500'; border = 'border-amber-200'; }
        else if (color === 'brand') { icon = 'fa-circle-info text-brand-600'; border = 'border-brand-200'; }

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto bg-white/95 backdrop-blur-sm border ${border} shadow-lg rounded-2xl p-3.5 flex items-start gap-3 transition-all duration-300 transform translate-y-2 opacity-0 text-xs`;
        toast.innerHTML = `
            <div class="mt-0.5"><i class="fa-solid ${icon} text-sm"></i></div>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-800">${title}</p>
                <p class="text-slate-500 text-2xs mt-0.5">${message}</p>
            </div>
            <button type="button" class="text-slate-400 hover:text-slate-600 ml-1 p-0.5 bg-transparent border-0 cursor-pointer" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark text-2xs"></i>
            </button>
        `;

        anchor.appendChild(toast);
        requestAnimationFrame(() => {
            toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
            toast.classList.add('opacity-0', '-translate-y-2');
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    // Filter Components Live Search
    function filterComponents() {
        const input = document.getElementById('componentFilterInput');
        const clearBtn = document.getElementById('clearComponentBtn');
        const term = (input?.value || '').toLowerCase().trim();

        if (clearBtn) {
            clearBtn.classList.toggle('hidden', term === '');
        }

        const cards = document.querySelectorAll('.component-card');
        const sections = document.querySelectorAll('.component-section');

        cards.forEach(card => {
            const dataName = (card.getAttribute('data-name') || '').toLowerCase();
            const text = card.innerText.toLowerCase();
            const matches = dataName.includes(term) || text.includes(term);
            card.style.display = matches ? '' : 'none';
        });

        sections.forEach(sec => {
            const visibleCards = sec.querySelectorAll('.component-card:not([style*="display: none"])');
            sec.style.display = visibleCards.length > 0 || term === '' ? '' : 'none';
        });
    }

    function clearComponentFilter() {
        const input = document.getElementById('componentFilterInput');
        if (input) {
            input.value = '';
            filterComponents();
        }
    }

    // Init custom calendar on page load
    document.addEventListener('DOMContentLoaded', () => {
        renderCustomCalendar();
    });
</script>
}
