        <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100">
            <button type="button" onclick="closeDemoModal('demoFormModal')" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
            <button type="button" onclick="closeDemoModal('demoFormModal'); triggerCatalogToast('Updated', 'Settings saved successfully.', 'emerald')" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white">Save Changes</button>
        </div>
