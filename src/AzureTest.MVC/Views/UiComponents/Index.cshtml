            <button type="button" onclick="closeDemoDrawer(); triggerCatalogToast('Filters Applied', 'Filtered 24 results.', 'brand')" class="px-5 py-2 rounded-xl bg-brand-600 text-xs font-semibold text-white">Apply</button>
