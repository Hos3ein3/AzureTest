@{
    ViewData["Title"] = "UI Components Catalog";
}

<!-- Page Header -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-brand-600 transition-colors">Home</a>
            <i class="fa-solid fa-chevron-right text-3xs"></i>
            <span class="text-slate-600 font-semibold">Design System</span>
            <i class="fa-solid fa-chevron-right text-3xs"></i>
            <span class="text-slate-600 font-semibold">UI Components</span>
        </nav>
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-xl shadow-sm">
                <i class="fa-solid fa-shapes"></i>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                    UI Components Catalog
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-100 text-brand-700">Design System</span>
                </h1>
                <p class="text-xs text-slate-500 mt-0.5">Comprehensive, copy-paste component library matching the application's Tailwind CSS design standards.</p>
            </div>
        </div>
    </div>

    <!-- Quick Search Components Bar -->
    <div class="flex items-center gap-3">
        <div class="relative w-full sm:w-72">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input id="componentFilterInput" type="text" onkeyup="filterComponents()" placeholder="Filter components (e.g. accordion, tabs, table, datepicker)..."
                   class="w-full pl-9 pr-8 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            <button type="button" onclick="clearComponentFilter()" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-500 text-xs bg-transparent border-0 cursor-pointer hidden" id="clearComponentBtn">
                <i class="fa-solid fa-circle-xmark"></i>
            </button>
        </div>
    </div>
</div>

<!-- Category Jump Navigation Pills -->
<div class="bg-white rounded-2xl border border-slate-100 p-3 shadow-2xs mb-8 overflow-x-auto">
    <div class="flex items-center gap-1.5 min-w-max text-xs">
        <span class="text-2xs font-bold uppercase tracking-wider text-slate-400 px-2">Jump to:</span>
        <a href="#sec-hero-breadcrumbs" class="px-3 py-1.5 rounded-xl font-semibold bg-brand-50 text-brand-700 hover:bg-brand-100 transition-colors">Hero & Breadcrumbs</a>
        <a href="#sec-accordions-tabs" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Accordions & Tabs</a>
        <a href="#sec-buttons" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Buttons</a>
        <a href="#sec-inputs" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Inputs & Validation</a>
        <a href="#sec-custom-pickers" class="px-3 py-1.5 rounded-xl font-semibold bg-brand-50 text-brand-700 hover:bg-brand-100 transition-colors">Custom Date & Time</a>
        <a href="#sec-toggles" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Custom Checkboxes</a>
        <a href="#sec-dropdowns" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Dropdowns & Multi-Select</a>
        <a href="#sec-tables" class="px-3 py-1.5 rounded-xl font-semibold bg-brand-50 text-brand-700 hover:bg-brand-100 transition-colors">Sortable Tables</a>
        <a href="#sec-dashboard-widgets" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">KPIs, Empty States & Timeline</a>
        <a href="#sec-modals" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Modals</a>
        <a href="#sec-toasts" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Toasts & Alerts</a>
        <a href="#sec-loaders" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Loaders & Progress</a>
        <a href="#sec-filters-pagination" class="px-3 py-1.5 rounded-xl font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">Filters & Pagination</a>
    </div>
</div>

<div class="space-y-12">

    <!-- ========================================================================= -->
    <!-- SECTION 1: HERO SECTION & BREADCRUMBS -->
    <!-- ========================================================================= -->
    <section id="sec-hero-breadcrumbs" class="component-section space-y-6">
        <div class="flex items-center gap-2.5 pb-2 border-b border-slate-200">
            <i class="fa-solid fa-flag text-brand-600 text-lg"></i>
            <h2 class="text-lg font-black text-slate-900 tracking-tight">1. Hero Section & Breadcrumbs</h2>
            <span class="text-3xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 uppercase">Layout</span>
        </div>

        <div class="space-y-6">
            <!-- Component Card: Dashboard Hero Banner -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Hero Banner Welcome Section Header Headline Dashboard">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Dashboard Hero Section</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Modern SaaS executive welcome banner with gradient backdrop, quick actions, and embedded KPI highlights.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-hero-banner', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50">
                    <!-- Hero Banner Visual -->
                    <div class="relative overflow-hidden rounded-3xl bg-linear-to-br from-slate-900 via-slate-800 to-brand-950 p-6 md:p-8 text-white shadow-lg">
                        <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-brand-500/15 blur-3xl pointer-events-none"></div>
                        <div class="absolute right-32 -bottom-20 w-80 h-80 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>

                        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                            <div class="space-y-3 max-w-xl">
                                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-2xs font-medium text-brand-200">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                    <span>System Operational</span>
                                    <span class="text-white/40">|</span>
                                    <span>October 20, 2026</span>
                                </div>
                                <h2 class="text-2xl md:text-3xl font-black tracking-tight text-white">
                                    Welcome back, <span class="text-brand-300">Alex</span>!
                                </h2>
                                <p class="text-xs md:text-sm text-slate-300 leading-relaxed">
                                    Here is what is happening across your projects and pantry inventory today. You have <strong class="text-white">4 tasks</strong> due and <strong class="text-white">2 low stock</strong> alerts requiring attention.
                                </p>
                                <div class="flex flex-wrap items-center gap-3 pt-2">
                                    <button type="button" class="px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold shadow-md shadow-brand-600/30 transition-all flex items-center gap-2">
                                        <i class="fa-solid fa-plus text-2xs"></i>
                                        <span>Create New Task</span>
                                    </button>
                                    <button type="button" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold border border-white/20 backdrop-blur-md transition-all flex items-center gap-2">
                                        <i class="fa-solid fa-chart-simple text-2xs"></i>
                                        <span>View Analytics</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Integrated Hero Mini-KPIs -->
                            <div class="grid grid-cols-2 gap-3 min-w-[280px]">
                                <div class="p-4 rounded-2xl bg-white/10 border border-white/10 backdrop-blur-md">
                                    <div class="flex items-center justify-between text-brand-300 text-xs mb-1">
                                        <span class="text-2xs font-semibold uppercase tracking-wider text-slate-300">Active Tasks</span>
                                        <i class="fa-solid fa-list-check"></i>
                                    </div>
                                    <div class="text-2xl font-black text-white">28</div>
                                    <div class="text-3xs text-emerald-300 flex items-center gap-1 mt-1 font-medium">
                                        <i class="fa-solid fa-arrow-trend-up"></i> +14% vs last week
                                    </div>
                                </div>
                                <div class="p-4 rounded-2xl bg-white/10 border border-white/10 backdrop-blur-md">
                                    <div class="flex items-center justify-between text-brand-300 text-xs mb-1">
                                        <span class="text-2xs font-semibold uppercase tracking-wider text-slate-300">Completion</span>
                                        <i class="fa-solid fa-bullseye"></i>
                                    </div>
                                    <div class="text-2xl font-black text-white">92.4%</div>
                                    <div class="text-3xs text-emerald-300 flex items-center gap-1 mt-1 font-medium">
                                        <i class="fa-solid fa-circle-check"></i> On track
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="border-t border-slate-100 bg-slate-900 text-slate-200 p-4 font-mono text-2xs overflow-x-auto">
<pre id="code-hero-banner"><code>&lt;!-- Modern SaaS Hero Banner --&gt;
&lt;div class="relative overflow-hidden rounded-3xl bg-linear-to-br from-slate-900 via-slate-800 to-brand-950 p-8 text-white shadow-lg"&gt;
    &lt;div class="flex flex-col lg:flex-row items-center justify-between gap-6"&gt;
        &lt;div class="space-y-3"&gt;
            &lt;div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-2xs"&gt;
                &lt;span class="w-2 h-2 rounded-full bg-emerald-400"&gt;&lt;/span&gt; Active Session
            &lt;/div&gt;
            &lt;h2 class="text-2xl font-black"&gt;Welcome back, &lt;span class="text-brand-300"&gt;User&lt;/span&gt;!&lt;/h2&gt;
            &lt;p class="text-xs text-slate-300"&gt;Summary of operations and key status metrics.&lt;/p&gt;
            &lt;div class="flex gap-3"&gt;
                &lt;button class="px-4 py-2 bg-brand-600 rounded-xl text-xs font-semibold"&gt;Create Action&lt;/button&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;</code></pre>
                </div>
            </div>

            <!-- Component Card: Breadcrumb Variations -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Breadcrumb Chevron Slash Icons Badge Navigation Hierarchy">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Breadcrumb Navigation Styles</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Chevron, slash, badge, and icon-based breadcrumb hierarchies with responsive truncation.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-breadcrumbs', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-6">
                    <!-- Style 1: Chevron with Icons -->
                    <div class="space-y-1.5">
                        <span class="text-3xs font-bold uppercase tracking-wider text-slate-400">Style A: Chevron with Icons</span>
                        <nav class="flex items-center gap-2 text-xs text-slate-500 flex-wrap">
                            <a href="#" class="inline-flex items-center gap-1.5 text-slate-600 hover:text-brand-600 transition-colors font-medium">
                                <i class="fa-solid fa-house text-2xs text-slate-400"></i>
                                <span>Dashboard</span>
                            </a>
                            <i class="fa-solid fa-chevron-right text-3xs text-slate-300"></i>
                            <a href="#" class="text-slate-600 hover:text-brand-600 transition-colors font-medium">Inventory</a>
                            <i class="fa-solid fa-chevron-right text-3xs text-slate-300"></i>
                            <a href="#" class="text-slate-600 hover:text-brand-600 transition-colors font-medium">Pantry Stock</a>
                            <i class="fa-solid fa-chevron-right text-3xs text-slate-300"></i>
                            <span class="text-slate-900 font-bold bg-slate-100 px-2 py-0.5 rounded-md">Item Details</span>
                        </nav>
                    </div>

                    <!-- Style 2: Modern Slash Breadcrumb -->
                    <div class="space-y-1.5">
                        <span class="text-3xs font-bold uppercase tracking-wider text-slate-400">Style B: Slash Separator</span>
                        <nav class="flex items-center gap-2 text-xs text-slate-500">
                            <a href="#" class="hover:text-brand-600 transition-colors font-medium">Finance</a>
                            <span class="text-slate-300 font-bold">/</span>
                            <a href="#" class="hover:text-brand-600 transition-colors font-medium">Debts & Credit</a>
                            <span class="text-slate-300 font-bold">/</span>
                            <span class="text-brand-700 font-bold">Analytics & Breakdown</span>
                        </nav>
                    </div>

                    <!-- Style 3: Pill / Chip Breadcrumb -->
                    <div class="space-y-1.5">
                        <span class="text-3xs font-bold uppercase tracking-wider text-slate-400">Style C: Pill Container with Badge</span>
                        <nav class="inline-flex items-center gap-1.5 p-1.5 rounded-xl bg-white border border-slate-200 text-xs shadow-2xs">
                            <a href="#" class="px-2.5 py-1 rounded-lg hover:bg-slate-100 text-slate-600 font-semibold transition-colors flex items-center gap-1.5">
                                <i class="fa-solid fa-cube text-2xs text-brand-600"></i> Projects
                            </a>
                            <i class="fa-solid fa-angle-right text-3xs text-slate-400"></i>
                            <a href="#" class="px-2.5 py-1 rounded-lg hover:bg-slate-100 text-slate-600 font-semibold transition-colors">
                                Sprint 42
                            </a>
                            <i class="fa-solid fa-angle-right text-3xs text-slate-400"></i>
                            <span class="px-2.5 py-1 rounded-lg bg-brand-50 text-brand-700 font-bold flex items-center gap-1.5">
                                User Feedback
                                <span class="px-1.5 py-0.2 rounded-full bg-brand-200 text-brand-800 text-3xs">12</span>
                            </span>
                        </nav>
                    </div>
                </div>
                <div class="border-t border-slate-100 bg-slate-900 text-slate-200 p-4 font-mono text-2xs overflow-x-auto">
<pre id="code-breadcrumbs"><code>&lt;!-- Chevron Breadcrumb with Icons --&gt;
&lt;nav class="flex items-center gap-2 text-xs text-slate-500"&gt;
    &lt;a href="#" class="inline-flex items-center gap-1.5 text-slate-600 hover:text-brand-600 font-medium"&gt;
        &lt;i class="fa-solid fa-house text-2xs"&gt;&lt;/i&gt; Home
    &lt;/a&gt;
    &lt;i class="fa-solid fa-chevron-right text-3xs text-slate-300"&gt;&lt;/i&gt;
    &lt;a href="#" class="text-slate-600 hover:text-brand-600"&gt;Section&lt;/a&gt;
    &lt;i class="fa-solid fa-chevron-right text-3xs text-slate-300"&gt;&lt;/i&gt;
    &lt;span class="text-slate-900 font-bold bg-slate-100 px-2 py-0.5 rounded-md"&gt;Active Page&lt;/span&gt;
&lt;/nav&gt;</code></pre>
                </div>
            </div>

            <!-- Component Card: Reusable Partial Tag Component -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Reusable Partial Tag Helper Breadcrumb PageHeader EmptyState Pagination Razor">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Reusable Razor Component Partials</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Use <code>UiComponents/_Breadcrumb</code>, <code>UiComponents/_PageHeader</code>, <code>UiComponents/_EmptyState</code>, and <code>UiComponents/_Pagination</code> across all views.</p>
                    </div>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-4">
                    <partial name="UiComponents/_Breadcrumb" model='new List<AzureTest.MVC.Models.BreadcrumbItem> { new("Design System", "/UiComponents", "fa-solid fa-shapes"), new("Live Catalog", null, IsActive: true) }' />
                    <partial name="UiComponents/_EmptyState" model='new AzureTest.MVC.Models.EmptyStateModel("No Records Found", "Example of the standardized empty state component.", "fa-solid fa-shapes", "Sample Action", "#")' />
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 2: ACCORDIONS, TABS & TABS GROUP -->
    <!-- ========================================================================= -->
    <section id="sec-accordions-tabs" class="component-section space-y-6">
        <div class="flex items-center gap-2.5 pb-2 border-b border-slate-200">
            <i class="fa-solid fa-layer-group text-brand-600 text-lg"></i>
            <h2 class="text-lg font-black text-slate-900 tracking-tight">2. Accordions, Sections & Tab Groups</h2>
            <span class="text-3xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 uppercase">Navigation</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Component Card: Accordions -->
            <div class="component-card bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden" data-name="Accordion Collapsible Expandable FAQ Panels Details">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-xs font-black text-slate-800 uppercase tracking-wider">Expandable Accordions</h3>
                        <p class="text-2xs text-slate-400 mt-0.5">Smooth collapsible sections with chevron rotation, badges, and multi-open support.</p>
                    </div>
                    <button type="button" onclick="copySnippet('code-accordion', this)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-600 text-2xs font-semibold transition-colors">
                        <i class="fa-regular fa-copy text-3xs"></i> <span>Copy Code</span>
                    </button>
                </div>
                <div class="p-6 bg-slate-50/50 space-y-3">
                    <!-- Accordion Item 1 (Expanded) -->
                    <div class="accordion-item rounded-2xl border border-slate-200 bg-white overflow-hidden transition-all shadow-2xs">
                        <button type="button" onclick="toggleAccordion('acc-item-1', this)" class="w-full p-4 text-left flex items-center justify-between gap-3 bg-white hover:bg-slate-50/80 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-xs">
                                    <i class="fa-solid fa-utensils"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-slate-900 block">How does stock auto-decrement work?</span>
                                    <span class="text-3xs text-slate-400">Inventory & Meal Plan Integration</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-full text-3xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                                <i class="fa-solid fa-chevron-down text-2xs text-slate-400 transform transition-transform duration-300 rotate-180 accordion-chevron"></i>
                            </div>
                        </button>
                        <div id="acc-item-1" class="accordion-content px-4 pb-4 pt-1 text-xs text-slate-600 leading-relaxed border-t border-slate-100">
                            When logging a meal, the system checks whether the meal was cooked at home. If so, a stock reduction ledger movement is recorded automatically for all recipe ingredients, decrementing from current stock in real-time.
                        </div>
                    </div>

                    <!-- Accordion Item 2 (Collapsed) -->
                    <div class="accordion-item rounded-2xl border border-slate-200 bg-white overflow-hidden transition-all shadow-2xs">
                        <button type="button" onclick="toggleAccordion('acc-item-2', this)" class="w-full p-4 text-left flex items-center justify-between gap-3 bg-white hover:bg-slate-50/80 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-slate-900 block">Can multiple users share shopping lists?</span>
                                    <span class="text-3xs text-slate-400">SignalR Real-Time Collaboration</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-full text-3xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">SignalR</span>
                                <i class="fa-solid fa-chevron-down text-2xs text-slate-400 transform transition-transform duration-300 accordion-chevron"></i>
                            </div>
                        </button>
                        <div id="acc-item-2" class="accordion-content hidden px-4 pb-4 pt-1 text-xs text-slate-600 leading-relaxed border-t border-slate-100">
                            Yes. The shopping list features real-time SignalR synchronization. Any item added, checked off, or updated broadcasts instantly to all registered family or household members.
                        </div>
                    </div>

                    <!-- Accordion Item 3 (Collapsed) -->
                    <div class="accordion-item rounded-2xl border border-slate-200 bg-white overflow-hidden transition-all shadow-2xs">
                        <button type="button" onclick="toggleAccordion('acc-item-3', this)" class="w-full p-4 text-left flex items-center justify-between gap-3 bg-white hover:bg-slate-50/80 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-slate-900 block">Who can switch between user tenants?</span>
                                    <span class="text-3xs text-slate-400">Security & Dynamic Authorization</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-full text-3xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Admin Only</span>
                                <i class="fa-solid fa-chevron-down text-2xs text-slate-400 transform transition-transform duration-300 accordion-chevron"></i>
                            </div>
