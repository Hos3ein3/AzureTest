<!-- Slide-Over Drawer Demo -->
<div id="demoSlideDrawer" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex justify-end">
    <div class="bg-white w-full max-w-sm h-full shadow-2xl p-6 flex flex-col justify-between transform transition-transform duration-300">
        <div>
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-brand-600"></i> Filter Drawer
                </h3>
                <button type="button" onclick="closeDemoDrawer()" class="text-slate-400 hover:text-slate-600 bg-transparent border-0 cursor-pointer">
