@model AzureTest.Contracts.DTOs.Resumes.ResumeAnalyticsDto
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<div class="mb-6 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-slate-800">Analytics Dashboard</h1>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
    <!-- Status Distribution Pie Chart -->
    <div class="col-span-1 lg:col-span-5">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100">
                <h5 class="text-lg font-semibold text-slate-800 m-0">Applications by Status</h5>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Applications Over Time Bar Chart -->
    <div class="col-span-1 lg:col-span-7">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100">
                <h5 class="text-lg font-semibold text-slate-800 m-0">Applications Over Time</h5>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="dateChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Position Title Chart -->
    <div class="col-span-1 lg:col-span-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100">
                <h5 class="text-lg font-semibold text-slate-800 m-0">Applications by Position</h5>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="positionChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Location Chart -->
    <div class="col-span-1 lg:col-span-6">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
            <div class="px-6 py-4 border-b border-slate-100">
                <h5 class="text-lg font-semibold text-slate-800 m-0">Applications by Location</h5>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="locationChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Data for Status Chart
            const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts.Keys));
            const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts.Values));

            // Custom color palette mapped approximately to status semantics
            const statusColors = statusLabels.map(label => {
                switch(label) {
                    case 'Rejected': return '#dc2626'; // Tailwind red-600
                    case 'Offer': return '#16a34a'; // Tailwind green-600
                    case 'Interviewing': return '#d97706'; // Tailwind amber-600
                    case 'Applied': return '#2563eb'; // Tailwind blue-600
                    case 'Screening': return '#0284c7'; // Tailwind sky-600
                    default: return '#475569'; // Tailwind slate-600
                }
            });

            const ctxStatus = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: statusColors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Data for Dates Chart
            const dateLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsByDate.Keys));
            const dateData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsByDate.Values));

            const ctxDate = document.getElementById('dateChart').getContext('2d');
            new Chart(ctxDate, {
                type: 'bar',
                data: {
                    labels: dateLabels,
                    datasets: [{
                        label: 'Applications',
                        data: dateData,
                        backgroundColor: 'rgba(37, 99, 235, 0.7)', // Tailwind blue-600
                        borderColor: '#2563eb',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Data for Position Chart
            const posLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PositionCounts.Keys));
            const posData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PositionCounts.Values));
            
            const ctxPos = document.getElementById('positionChart').getContext('2d');
            new Chart(ctxPos, {
                type: 'bar', // Horizontal bar is often better for labels
                data: {
                    labels: posLabels,
                    datasets: [{
                        label: 'Positions',
                        data: posData,
                        backgroundColor: 'rgba(13, 148, 136, 0.7)', // Tailwind teal-600 (brand-600)
                        borderColor: '#0d9488',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y', // Make it horizontal
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Data for Location Chart
            const locLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocationCounts.Keys));
            const locData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocationCounts.Values));
            
            const ctxLoc = document.getElementById('locationChart').getContext('2d');
            new Chart(ctxLoc, {
                type: 'doughnut',
                data: {
                    labels: locLabels,
                    datasets: [{
                        data: locData,
                        backgroundColor: [
                            '#8b5cf6', '#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#6366f1', '#14b8a6', '#f43f5e'
                        ], // Vibrant tailwind colors
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        });
    </script>
}
