
<style>
    .fc .fc-toolbar {
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .fc-header-toolbar.fc-toolbar {
        margin-bottom: 1.25rem !important;
    }
    @@media (max-width: 768px) {
        .fc .fc-toolbar {
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }
        .fc .fc-toolbar-title {
            font-size: 1.15rem !important;
            text-align: center;
            margin: 0.25rem 0;
        }
        .fc .fc-button {
            padding: 0.4rem 0.65rem !important;
            font-size: 0.8rem !important;
        }
        .fc .fc-toolbar-chunk {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.25rem;
            width: 100%;
        }
        .fc-daygrid-event {
            font-size: 0.7rem !important;
        }
        .fc-list-event-title {
            font-size: 0.85rem !important;
        }
    }
</style>

@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Calendar";
    var pageHeader = new PageHeaderModel
    {
        Title = "Schedule & Planner",
        Subtitle = "View scheduled events, tasks, and deadlines in calendar view",
        Icon = "fa-regular fa-calendar-days",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", "/"),
            new BreadcrumbItem("Calendar", active: true)
        }
    };
}

<partial name="UiComponents/_PageHeader" model="pageHeader" />

<div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden mb-8">
    <div class="px-4 sm:px-6 py-4 border-b border-slate-100 bg-slate-50/60 flex flex-wrap justify-between items-center gap-2">
        <h5 class="text-base font-bold text-slate-800 m-0 flex items-center gap-2">
            <i class="fa-solid fa-calendar-check text-brand-600"></i> Events & Deadlines
        </h5>
        <div class="flex items-center gap-3 text-xs text-slate-500">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span> Event</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Task</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Debt Due</span>
        </div>
    </div>
    <div class="p-3 sm:p-6 overflow-x-auto">
        <div id="calendar" class="w-full" style="min-height: 480px;"></div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var isMobile = window.innerWidth < 768;

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: isMobile ? 'listMonth' : 'dayGridMonth',
                headerToolbar: isMobile ? {
                    left: 'prev,next',
                    center: 'title',
                    right: 'today,dayGridMonth,listMonth'
                } : {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
                },
                buttonText: {
                    today: 'Today',
                    month: 'Month',
                    week: 'Week',
                    day: 'Day',
                    list: 'Agenda'
                },
                height: 'auto',
                contentHeight: 'auto',
                themeSystem: 'standard',
                events: '/Calendar/GetEvents',
                eventContent: function(arg) {
                    var type = arg.event.extendedProps.type;
                    if (type === 'task') {
                        return { html: '<div class="px-1.5 py-0.5 text-xs font-semibold rounded truncate"><i class="fa-solid fa-check-square mr-1"></i>' + arg.event.title + '</div>' };
                    } else if (type === 'debt') {
                        return { html: '<div class="px-1.5 py-0.5 text-xs font-semibold rounded text-white truncate" style="background-color: ' + (arg.event.backgroundColor || '#f59e0b') + '"><i class="fa-solid fa-money-bill-wave mr-1"></i>' + arg.event.title + '</div>' };
                    } else {
                        return { html: '<div class="px-1.5 py-0.5 text-xs font-semibold rounded text-white truncate" style="background-color: ' + (arg.event.backgroundColor || '#2563eb') + '"><i class="fa-regular fa-calendar-check mr-1"></i>' + arg.event.title + '</div>' };
                    }
                }
            });

            calendar.render();

            // Responsive adapt on resize
            var resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function() {
                    var nowMobile = window.innerWidth < 768;
                    if (nowMobile !== isMobile) {
                        isMobile = nowMobile;
                        calendar.setOption('headerToolbar', isMobile ? {
                            left: 'prev,next',
                            center: 'title',
                            right: 'today,dayGridMonth,listMonth'
                        } : {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
                        });
                        if (isMobile && calendar.view.type === 'timeGridWeek') {
                            calendar.changeView('listMonth');
                        }
                    }
                }, 200);
            });
        });
    </script>
}
