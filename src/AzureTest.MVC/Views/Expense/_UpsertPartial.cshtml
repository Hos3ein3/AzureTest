@model AzureTest.Contracts.DTOs.Expenses.IExpenseFormDto

<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
    <div>
        <label asp-for="Amount" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
            Amount <span class="text-rose-500">*</span>
        </label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-dollar-sign"></i>
            </div>
            <input asp-for="Amount" type="number" step="0.01" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" placeholder="0.00" />
        </div>
        <span asp-validation-for="Amount" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Date" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Expense Date</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-calendar"></i>
            </div>
            <input asp-for="Date" type="date" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" />
        </div>
        <span asp-validation-for="Date" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>

    <div class="sm:col-span-2">
        <label asp-for="Description" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
            Description <span class="text-rose-500">*</span>
        </label>
        <textarea asp-for="Description" rows="3" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="What was this expenditure for?"></textarea>
        <span asp-validation-for="Description" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>
</div>

<div class="mb-6 relative p-4 rounded-2xl border border-slate-200/80 bg-slate-50/50">
    <div class="flex justify-between items-center mb-2">
        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider">Expense Category</label>
        <button type="button" class="text-2xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1" id="toggleNewCategory">
            <i class="fa-solid fa-plus"></i> Add new category
        </button>
    </div>
    
    <div>
        <select id="categorySelect" name="CategoryId" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white">
            <option value="">-- Search or select existing category --</option>
            @if (ViewBag.Categories != null)
            {
                foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories)
                {
                    <option value="@item.Value" selected="@(Model.CategoryId?.ToString() == item.Value)">@item.Text</option>
                }
            }
        </select>
    </div>

    <div id="newCategoryPanel" class="mt-3 bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs" style="display:none;">
        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">New Category Name</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-tag"></i>
            </div>
            <input type="text" id="newCategoryInput" name="NewCategoryName" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white"
                   placeholder="Type new category name..." autocomplete="off" value="@Model.NewCategoryName" />
            <div id="categoryAutocomplete" class="absolute z-10 w-full mt-1 bg-white shadow-lg rounded-xl border border-slate-200/80 max-h-60 overflow-y-auto divide-y divide-slate-100" style="display:none;"></div>
        </div>
        <p class="mt-1.5 text-3xs text-slate-400">
            If this category already exists it will be linked automatically; otherwise a new one will be registered.
        </p>
    </div>
</div>
