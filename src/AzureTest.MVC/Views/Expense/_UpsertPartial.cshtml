@model AzureTest.Contracts.DTOs.Expenses.IExpenseFormDto

<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
    <div>
        <label asp-for="Amount" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
            Amount <span class="text-rose-500">*</span>
        </label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-dollar-sign"></i>
            </div>
            <input asp-for="Amount" type="number" step="0.01" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" placeholder="0.00" />
        </div>
        <span asp-validation-for="Amount" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Date" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Expense Date</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-calendar"></i>
            </div>
            <input asp-for="Date" type="date" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" />
        </div>
        <span asp-validation-for="Date" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>

    <div class="sm:col-span-2">
        <label asp-for="Description" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">
            Description <span class="text-rose-500">*</span>
        </label>
        <textarea asp-for="Description" rows="3" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="What was this expenditure for?"></textarea>
        <span asp-validation-for="Description" class="text-2xs text-rose-600 mt-1 block"></span>
    </div>
</div>

@{
    var categoriesList = ViewBag.Categories as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var selectedCategory = categoriesList?.FirstOrDefault(c => c.Value == Model.CategoryId?.ToString());
    var selectedCategoryText = selectedCategory?.Text;
}

<div class="mb-6 relative p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800">
    <div class="flex justify-between items-center mb-2">
        <label class="block text-2xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Expense Category</label>
        <button type="button" class="text-2xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400 flex items-center gap-1" id="toggleNewCategory">
            <i class="fa-solid fa-plus text-3xs"></i> Add new category
        </button>
    </div>

    <!-- UiComponents Searchable Single Select Dropdown -->
    <div class="relative">
        <input type="hidden" id="categoryIdInput" name="CategoryId" value="@(Model.CategoryId?.ToString() ?? "")" />
        <button id="categoryDropdownBtn" type="button" onclick="toggleCategoryDropdownMenu()"
                class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-xs text-slate-700 dark:text-slate-200 hover:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 shadow-2xs transition-all text-left">
            <span id="categorySelectedLabel" class="@(!string.IsNullOrWhiteSpace(selectedCategoryText) ? "text-slate-900 dark:text-white font-bold" : "text-slate-400 dark:text-slate-400") truncate">
                @(!string.IsNullOrWhiteSpace(selectedCategoryText) ? selectedCategoryText : "-- Search or select existing category --")
            </span>
            <i class="fa-solid fa-chevron-down text-2xs text-slate-400 shrink-0 ml-2"></i>
        </button>

        <!-- Searchable Dropdown Popup Menu -->
        <div id="categoryDropdownMenu" class="hidden absolute left-0 right-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-xl z-30 p-2 space-y-1.5">
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-3xs"></i>
                <input type="text" id="categoryFilterInput" onkeyup="filterCategoryOptions(this.value)" placeholder="Type to filter categories..."
                       class="w-full pl-8 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-750 text-slate-800 dark:text-slate-100 text-xs focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>
            <ul id="categoryOptionsList" class="max-h-52 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700/50 list-none p-0 m-0">
                <li onclick="selectCategoryOption('', '-- Search or select existing category --')"
                    class="category-option p-2 hover:bg-slate-50 dark:hover:bg-slate-700/60 rounded-lg cursor-pointer flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 italic">
                    <span>None / Clear selection</span>
                </li>
                @if (categoriesList != null)
                {
                    foreach (var item in categoriesList)
                    {
                        var isSelected = Model.CategoryId?.ToString() == item.Value;
                        <li onclick="selectCategoryOption('@item.Value', '@Html.Raw(item.Text.Replace("'", "\\'"))')"
                            class="category-option p-2 hover:bg-brand-50 dark:hover:bg-brand-900/30 rounded-lg cursor-pointer flex items-center justify-between text-xs text-slate-800 dark:text-slate-200">
                            <span class="truncate">@item.Text</span>
                            @if (isSelected)
                            {
                                <i class="fa-solid fa-check text-2xs text-brand-600 dark:text-brand-400 shrink-0 ml-2 checkmark-icon"></i>
                            }
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div id="newCategoryPanel" class="mt-3 bg-white dark:bg-slate-700 p-4 rounded-xl border border-slate-200/80 dark:border-slate-600 shadow-2xs" style="display:none;">
        <label class="block text-2xs font-bold text-slate-500 dark:text-slate-300 uppercase tracking-wider mb-1.5">New Category Name</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-tag"></i>
            </div>
            <input type="text" id="newCategoryInput" name="NewCategoryName" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-600 text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white dark:bg-slate-800"
                   placeholder="Type new category name..." autocomplete="off" value="@Model.NewCategoryName" />
            <div id="categoryAutocomplete" class="absolute z-10 w-full mt-1 bg-white dark:bg-slate-800 shadow-lg rounded-xl border border-slate-200/80 dark:border-slate-700 max-h-60 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700" style="display:none;"></div>
        </div>
        <p class="mt-1.5 text-3xs text-slate-400 dark:text-slate-400">
            If this category already exists it will be linked automatically; otherwise a new one will be registered.
        </p>
    </div>
</div>
