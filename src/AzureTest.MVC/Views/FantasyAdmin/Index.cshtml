@model AzureTest.Application.FootballFantasy.Queries.FantasyAdminDashboardDto
@{
    ViewData["Title"] = "Football Fantasy Administration";
    var fantasyTeams = ViewBag.FantasyTeams as List<AzureTest.Contracts.DTOs.FootballFantasy.AdminFantasyTeamOverviewDto>;
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100 flex items-center gap-2">
            <i class="fa-solid fa-screwdriver-wrench text-brand-600"></i> Football Fantasy Admin
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage real-world football entities, audit player teams across fantasy leagues, and adjust scoring rules.</p>
    </div>
</div>

<!-- Metrics Overview Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-earth-americas"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Countries</div>
            <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-0.5">@Model.CountriesCount</div>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-trophy"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Real Leagues</div>
            <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-0.5">@Model.LeaguesCount</div>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-shield"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Teams</div>
            <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-0.5">@Model.TeamsCount</div>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-person-running"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Players</div>
            <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-0.5">@Model.PlayersCount</div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="mb-6 border-b border-slate-200 dark:border-slate-700 flex space-x-8 text-sm font-semibold">
    <button type="button" onclick="switchAdminTab('fantasyTeams')" id="tabBtn-fantasyTeams" class="pb-3 border-b-2 border-brand-600 text-brand-600 flex items-center">
        <i class="fa-solid fa-users-gear mr-2"></i> Player Fantasy Teams & Scores
    </button>
    <button type="button" onclick="switchAdminTab('realWorld')" id="tabBtn-realWorld" class="pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center">
        <i class="fa-solid fa-globe mr-2"></i> Real-World Management
    </button>
    <button type="button" onclick="switchAdminTab('fantasy')" id="tabBtn-fantasy" class="pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center">
        <i class="fa-solid fa-gamepad mr-2"></i> Fantasy Engine & Rules
    </button>
</div>

<!-- Tab 1: All Player Fantasy Teams Oversight -->
<div id="tabContent-fantasyTeams" class="space-y-6">
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
            <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base">All User Fantasy Teams</h3>
                <p class="text-xs text-slate-400 mt-0.5">Audit managers, points, budget remaining, and associated fantasy leagues.</p>
            </div>
            <span class="text-xs font-semibold bg-brand-50 text-brand-700 px-3 py-1 rounded-full border border-brand-200">
                Total Teams: @(fantasyTeams?.Count ?? 0)
            </span>
        </div>

        <table class="min-w-full divide-y divide-slate-100 dark:divide-slate-700 text-sm">
            <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-400 font-semibold text-xs uppercase tracking-wider">
                <tr>
                    <th class="py-3.5 px-4 text-left">Fantasy Team</th>
                    <th class="py-3.5 px-4 text-left">Manager</th>
                    <th class="py-3.5 px-4 text-left">League & Tag</th>
                    <th class="py-3.5 px-4 text-center">Squad Size</th>
                    <th class="py-3.5 px-4 text-center">Credits Left</th>
                    <th class="py-3.5 px-4 text-center">Total Points</th>
                    <th class="py-3.5 px-4 text-right">Pitch View</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                @if (fantasyTeams == null || fantasyTeams.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="py-8 text-center text-slate-400 text-sm">No fantasy teams created yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var ft in fantasyTeams)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/40">
                            <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-100 flex items-center space-x-3">
                                @if (!string.IsNullOrWhiteSpace(ft.LogoUrl))
                                {
                                    <img src="@ft.LogoUrl" class="w-8 h-8 rounded-full object-cover border" alt="@ft.TeamName" />
                                }
                                <div>
                                    <div class="font-bold">@ft.TeamName</div>
                                    <div class="text-xs text-slate-400 font-normal">Joined @ft.JoinedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                            </td>
                            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">@ft.ManagerName</td>
                            <td class="py-3 px-4">
                                <a asp-controller="FantasyLeague" asp-action="Details" asp-route-id="@ft.FantasyLeagueId" class="font-semibold text-brand-600 hover:text-brand-700">
                                    @ft.LeagueName
                                </a>
                                <span class="text-xs font-mono font-bold bg-slate-100 dark:bg-slate-700 px-1.5 py-0.5 rounded text-slate-500 ml-1">@ft.LeagueTag</span>
                            </td>
                            <td class="py-3 px-4 text-center font-medium">@ft.SquadCount</td>
                            <td class="py-3 px-4 text-center font-mono font-semibold text-slate-700 dark:text-slate-300">€@ft.CreditsLeft.ToString("F1")M</td>
                            <td class="py-3 px-4 text-center">
                                <span class="text-base font-black text-emerald-600">@ft.TotalPoints pts</span>
                            </td>
                            <td class="py-3 px-4 text-right">
                                <a asp-controller="FantasyLeague" asp-action="Team" asp-route-id="@ft.Id" class="inline-flex items-center px-3 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-semibold rounded-lg transition-colors border border-brand-200">
                                    <i class="fa-solid fa-eye mr-1.5"></i> Inspect Squad
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Tab 2: Real-World Management -->
<div id="tabContent-realWorld" class="space-y-6 hidden">
    <!-- Action Quick Links to CRUD Portals -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        <a asp-controller="Country" asp-action="Index" class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 text-center hover:border-brand-500 transition-colors shadow-sm">
            <i class="fa-solid fa-earth-americas text-xl text-blue-600 mb-2 block"></i>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Countries</div>
        </a>
        <a asp-controller="League" asp-action="Index" class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 text-center hover:border-brand-500 transition-colors shadow-sm">
            <i class="fa-solid fa-trophy text-xl text-amber-500 mb-2 block"></i>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Leagues</div>
        </a>
        <a asp-controller="Team" asp-action="Index" class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 text-center hover:border-brand-500 transition-colors shadow-sm">
            <i class="fa-solid fa-shield text-xl text-emerald-600 mb-2 block"></i>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Teams</div>
        </a>
        <a asp-controller="Player" asp-action="Index" class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 text-center hover:border-brand-500 transition-colors shadow-sm">
            <i class="fa-solid fa-person-running text-xl text-purple-600 mb-2 block"></i>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Players</div>
        </a>
        <a asp-controller="Fixture" asp-action="Index" class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 text-center hover:border-brand-500 transition-colors shadow-sm">
            <i class="fa-solid fa-calendar-days text-xl text-rose-600 mb-2 block"></i>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Fixtures</div>
        </a>
        <a asp-controller="Coach" asp-action="Index" class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 text-center hover:border-brand-500 transition-colors shadow-sm">
            <i class="fa-solid fa-user-tie text-xl text-slate-600 mb-2 block"></i>
            <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Coaches</div>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Teams List -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-slate-800 dark:text-slate-100">Recent Teams</h3>
                <a asp-controller="Team" asp-action="Index" class="text-xs text-brand-600 hover:text-brand-700 font-semibold">View All</a>
            </div>
            <div class="space-y-2.5">
                @foreach (var team in Model.RecentTeams)
                {
                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/40 text-xs font-semibold text-slate-700 dark:text-slate-300">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-shield text-slate-400"></i>
                            @team.Name (@team.ShortName)
                        </span>
                        <span class="text-slate-400">@team.TeamType</span>
                    </div>
                }
            </div>
        </div>

        <!-- Players List -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-slate-800 dark:text-slate-100">Registered Players</h3>
                <a asp-controller="Player" asp-action="Index" class="text-xs text-brand-600 hover:text-brand-700 font-semibold">View All</a>
            </div>
            <div class="space-y-2.5">
                @foreach (var player in Model.RecentPlayers)
                {
                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900/40 text-xs font-semibold text-slate-700 dark:text-slate-300">
                        <div>
                            <span class="font-bold">@player.DisplayName</span>
                            <span class="text-slate-400 text-xs ml-1 font-normal">(@player.Position)</span>
                        </div>
                        <span class="font-mono text-emerald-600">€@player.CurrentPrice.ToString("F1")M</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tab 3: Fantasy Engine & Rules -->
<div id="tabContent-fantasy" class="space-y-6 hidden">
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
        <h3 class="font-bold text-slate-800 dark:text-slate-100 mb-2">Default Scoring Matrix Template</h3>
        <p class="text-xs text-slate-400 mb-6">Default points awarded across all fantasy competitions.</p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
            <div class="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                <div class="text-slate-400">Playing Appearance</div>
                <div class="font-black text-emerald-600 text-base mt-1">+2 pts</div>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                <div class="text-slate-400">Forward Goal</div>
                <div class="font-black text-emerald-600 text-base mt-1">+4 pts</div>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                <div class="text-slate-400">Midfielder Goal</div>
                <div class="font-black text-emerald-600 text-base mt-1">+5 pts</div>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                <div class="text-slate-400">Defender / GK Clean Sheet</div>
                <div class="font-black text-emerald-600 text-base mt-1">+4 pts</div>
            </div>
        </div>
    </div>
</div>

<script>
    function switchAdminTab(tabKey) {
        const tabs = ['fantasyTeams', 'realWorld', 'fantasy'];
        tabs.forEach(t => {
            const content = document.getElementById('tabContent-' + t);
            const btn = document.getElementById('tabBtn-' + t);
            if (t === tabKey) {
                content.classList.remove('hidden');
                btn.className = 'pb-3 border-b-2 border-brand-600 text-brand-600 flex items-center';
            } else {
                content.classList.add('hidden');
                btn.className = 'pb-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center';
            }
        });
    }
</script>
