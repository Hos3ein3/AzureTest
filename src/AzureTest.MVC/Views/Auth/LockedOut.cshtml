@{
    Layout = "_Layout.Auth";
    ViewData["Title"] = "Account Locked";
    var lockoutEndRaw = ViewBag.LockoutEnd as string;
    DateTimeOffset? lockoutEnd = null;
    if (!string.IsNullOrEmpty(lockoutEndRaw) && DateTimeOffset.TryParse(lockoutEndRaw, out var parsed))
    {
        lockoutEnd = parsed;
    }
    var isPermanent = lockoutEnd.HasValue && lockoutEnd.Value.Year > 2090;
}

<div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-50 border border-amber-200 text-amber-600 text-2xl shadow-2xs mb-4 animate-pulse">
        <i class="fa-solid fa-user-lock"></i>
    </div>
    <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        Account Temporarily Locked
    </h2>
    <p class="mt-2 text-xs text-slate-500 max-w-sm mx-auto">
        Your account access has been suspended due to security policies or multiple failed login attempts.
    </p>
</div>

<div class="space-y-6">
    <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-5 space-y-3">
        <div class="flex items-start gap-3">
            <i class="fa-solid fa-shield-halved text-amber-600 text-base mt-0.5"></i>
            <div>
                <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wider">Lockout Status</h4>
                @if (isPermanent)
                {
                    <p class="text-xs text-amber-800 mt-1">
                        This account has been <span class="font-bold text-rose-700">permanently locked</span> by an administrator. Please reach out to administrative support for assistance.
                    </p>
                }
                else if (lockoutEnd.HasValue)
                {
                    <p class="text-xs text-amber-800 mt-1">
                        Locked until: <span class="font-mono font-bold text-amber-950">@lockoutEnd.Value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                    </p>
                    <p class="text-3xs text-amber-700 mt-0.5">
                        Please wait until the expiration time above and try logging in again.
                    </p>
                }
                else
                {
                    <p class="text-xs text-amber-800 mt-1">
                        @(ViewBag.Message ?? "Your account is temporarily locked. Please check back later or contact an administrator.")
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-2xs text-slate-600 space-y-2">
        <div class="font-bold text-slate-800 flex items-center gap-1.5">
            <i class="fa-solid fa-circle-info text-brand-600"></i> Next steps:
        </div>
        <ul class="list-disc list-inside space-y-1 pl-1 text-slate-500">
            <li>Verify your credentials if you recently attempted to reset your password.</li>
            <li>If you believe this is a mistake, contact your organization's system administrator.</li>
            <li>Ensure no automated processes or scrapers are trying to access your account.</li>
        </ul>
    </div>

    <div class="pt-2 flex flex-col gap-2">
        <a asp-action="Login"
           class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
            <i class="fa-solid fa-arrow-left text-2xs"></i>
            <span>Return to Sign In</span>
        </a>
        <a asp-action="ForgotPassword"
           class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors">
            <i class="fa-solid fa-key text-2xs text-slate-400"></i>
            <span>Forgot Password?</span>
        </a>
    </div>
</div>
