@{
    Layout = "_Layout.Auth";
    ViewData["Title"] = "Set New Password";
    var userId = ViewBag.UserId as string;
    var code = ViewBag.Code as string;
}

<div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 text-brand-600 text-xl shadow-2xs mb-4">
        <i class="fa-solid fa-lock-open"></i>
    </div>
    <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        Reset your password
    </h2>
    <p class="mt-1.5 text-xs text-slate-500">
        Enter and confirm your new password below.
    </p>
</div>

<div class="space-y-6">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-rose-600 text-xs bg-rose-50 border border-rose-200 p-3 rounded-xl space-y-1"></div>
    }

    <form class="space-y-4" asp-action="ResetPassword" method="POST">
        @Html.AntiForgeryToken()

        <input type="hidden" name="userId" value="@userId" />
        <input type="hidden" name="code" value="@code" />

        <div>
            <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">New Password</label>
            <div class="relative">
                <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="password" name="password" type="password" autocomplete="new-password" required
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
                       placeholder="Enter at least 6 characters" />
            </div>
        </div>

        <div>
            <label for="confirmPassword" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Confirm New Password</label>
            <div class="relative">
                <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
                       placeholder="Repeat new password" />
            </div>
        </div>

        <div class="pt-2 space-y-2">
            <button type="submit"
                    class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
                <i class="fa-solid fa-check text-2xs"></i>
                <span>Update Password</span>
            </button>
            <a asp-action="Login"
               class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors">
                <i class="fa-solid fa-arrow-left text-2xs text-slate-400"></i>
                <span>Cancel & Return to Sign In</span>
            </a>
        </div>
    </form>
</div>
