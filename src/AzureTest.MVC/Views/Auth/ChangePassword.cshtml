@{
    ViewData["Title"] = "Change Password";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Security", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Change Password", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "Change Password",
        Subtitle = "Update your account password to ensure ongoing system security",
        Icon = "fa-solid fa-lock",
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<div class="max-w-xl bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-brand-600 text-xs"></i>
            <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Account Credentials</h2>
        </div>
        <span class="text-3xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Active Session</span>
    </div>

    <form asp-action="ChangePassword" method="post" class="p-6 md:p-8 space-y-5">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="p-3 bg-rose-50 border border-rose-200/80 rounded-xl text-rose-700 text-xs space-y-1"></div>
        }

        <div>
            <label for="currentPassword" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Current Password</label>
            <div class="relative">
                <i class="fa-solid fa-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password"
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white"
                       placeholder="••••••••" />
            </div>
        </div>

        <div>
            <label for="newPassword" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">New Password</label>
            <div class="relative">
                <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="newPassword" name="newPassword" type="password" required autocomplete="new-password" minlength="6"
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white"
                       placeholder="••••••••" />
            </div>
            <p class="text-3xs text-slate-400 mt-1">Must be at least 6 characters long.</p>
        </div>

        <div>
            <label for="confirmPassword" class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Confirm New Password</label>
            <div class="relative">
                <i class="fa-solid fa-check-double absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password" minlength="6"
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white"
                       placeholder="••••••••" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100">
            <a href="/" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                Cancel
            </a>
            <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
                <i class="fa-solid fa-floppy-disk text-2xs"></i>
                <span>Update Password</span>
            </button>
        </div>
    </form>
</div>
