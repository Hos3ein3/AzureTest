@{
    Layout = "_Layout.Auth";
    ViewData["Title"] = "Forgot Password";
    var isSubmitted = ViewBag.IsSubmitted as bool? ?? false;
}

<div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 text-brand-600 text-xl shadow-2xs mb-4">
        <i class="fa-solid fa-key"></i>
    </div>
    <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        Reset your password
    </h2>
    <p class="mt-1.5 text-xs text-slate-500">
        Enter your verified email address to receive password reset instructions.
    </p>
</div>

<div class="space-y-6">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-rose-600 text-xs bg-rose-50 border border-rose-200 p-3 rounded-xl space-y-1"></div>
    }

    @if (isSubmitted)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-3">
            <div class="flex items-start gap-3">
                <i class="fa-solid fa-circle-check text-emerald-600 text-lg mt-0.5"></i>
                <div>
                    <h4 class="text-xs font-bold text-emerald-950 uppercase tracking-wider">Request Processed</h4>
                    <p class="text-xs text-emerald-800 mt-1">
                        @(ViewBag.Message ?? "Instructions to reset your password have been processed.")
                    </p>
                    @if (!string.IsNullOrEmpty(ViewBag.ResetToken as string))
                    {
                        <div class="mt-3 p-2.5 rounded-xl bg-white border border-emerald-200 text-2xs font-mono text-slate-700 break-all select-all">
                            <span class="block text-3xs font-bold uppercase text-slate-400 mb-1">Generated Reset Token (Dev Simulation):</span>
                            @ViewBag.ResetToken
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="pt-2">
            <a asp-action="Login"
               class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
                <i class="fa-solid fa-arrow-left text-2xs"></i>
                <span>Back to Sign In</span>
            </a>
        </div>
    }
    else
    {
        <form class="space-y-4" asp-action="ForgotPassword" method="POST">
            @Html.AntiForgeryToken()

            <div>
                <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
                <div class="relative">
                    <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input id="email" name="email" type="email" autocomplete="email" required
                           class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
                           placeholder="name@company.com" />
                </div>
            </div>

            <div class="pt-2 space-y-2">
                <button type="submit"
                        class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
                    <i class="fa-solid fa-paper-plane text-2xs"></i>
                    <span>Send Reset Instructions</span>
                </button>
                <a asp-action="Login"
                   class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors">
                    <i class="fa-solid fa-arrow-left text-2xs text-slate-400"></i>
                    <span>Return to Sign In</span>
                </a>
            </div>
        </form>
    }
</div>
