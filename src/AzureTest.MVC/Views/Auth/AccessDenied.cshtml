@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout.Auth";
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    if (string.IsNullOrWhiteSpace(returnUrl)) {
        returnUrl = Context.Request.Path.ToString();
    }
    if (string.IsNullOrWhiteSpace(returnUrl)) {
        returnUrl = "/";
    }
    var errorSubject = "Request Access to Restricted Page";
    var errorContent = $"<p>I am requesting access to the following page, but I received an Access Denied (403) error:</p><p><strong>URL:</strong> {System.Net.WebUtility.HtmlEncode(returnUrl)}</p>";
}

<div class="text-center space-y-6">
    <!-- Icon Header -->
    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-2xl bg-rose-50 text-rose-600 border border-rose-200 shadow-2xs">
        <i class="fa-solid fa-shield-halved text-2xl"></i>
    </div>

    <div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-2xs font-bold uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200 mb-2">
            403 Restricted
        </span>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
            Access Denied
        </h2>
        <p class="mt-1.5 text-xs text-slate-500 max-w-sm mx-auto">
            You don't have the permissions required to view or perform operations on this page.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(returnUrl) && returnUrl != "/")
    {
        <div class="bg-slate-50 rounded-xl p-3 border border-slate-200/80 text-xs text-slate-500 text-left font-mono break-all">
            <span class="font-bold text-slate-700 block mb-0.5 text-2xs uppercase tracking-wider">Attempted Resource:</span>
            <span class="text-rose-600">@returnUrl</span>
        </div>
    }

    <!-- Action Buttons -->
    <div class="space-y-2.5 pt-2">
        <a href="/" class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
            <i class="fa-solid fa-house text-2xs"></i> Return to Dashboard
        </a>

        <form asp-controller="Ticket" asp-action="Create" method="post" class="w-full m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="subject" value="@errorSubject" />
            <input type="hidden" name="content" value="@errorContent" />
            <input type="hidden" name="priority" value="Medium" />
            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 shadow-2xs transition-colors">
                <i class="fa-solid fa-paper-plane text-brand-600 text-2xs"></i> Request Access via Ticket
            </button>
        </form>

        <form asp-controller="Auth" asp-action="Logout" method="post" class="w-full pt-2 border-t border-slate-100 m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-xl text-xs font-semibold text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors">
                <i class="fa-solid fa-arrow-right-from-bracket text-3xs"></i> Log Out & Switch Account
            </button>
        </form>
    </div>
</div>
