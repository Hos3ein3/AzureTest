@{
    Layout = "_Layout.Auth";
    ViewData["Title"] = "Sign In";
}

<div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 text-brand-600 text-xl shadow-2xs mb-4">
        <i class="fa-solid fa-layer-group"></i>
    </div>
    <h2 class="text-2xl font-black text-slate-900 tracking-tight">
        Sign in to your account
    </h2>
    <p class="mt-1.5 text-xs text-slate-500">
        Or
        <a asp-action="Register" class="font-semibold text-brand-600 hover:text-brand-700 transition-colors">
            create a new account
        </a>
    </p>
</div>

<div class="space-y-6">
    <button type="button"
            class="w-full inline-flex justify-center items-center gap-2.5 px-4 py-2.5 border border-slate-200 rounded-xl shadow-2xs text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 transition-colors">
        <i class="fa-brands fa-google text-red-500 text-sm"></i>
        Sign in with Google
    </button>

    <div class="relative">
        <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200"></div>
        </div>
        <div class="relative flex justify-center text-3xs font-bold uppercase tracking-wider text-slate-400">
            <span class="px-3 bg-white">
                Or continue with email
            </span>
        </div>
    </div>

    <form class="space-y-4" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="POST">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-rose-600 text-xs bg-rose-50 border border-rose-200 p-3 rounded-xl hidden:empty"></div>

        <div>
            <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
            <div class="relative">
                <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="email" name="email" type="email" autocomplete="email" required
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
                       placeholder="name@company.com" />
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between mb-1.5">
                <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Password</label>
                <a href="#" class="text-2xs font-semibold text-brand-600 hover:text-brand-700">
                    Forgot password?
                </a>
            </div>
            <div class="relative">
                <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input id="password" name="password" type="password" autocomplete="current-password" required
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
                       placeholder="••••••••" />
            </div>
        </div>

        <div class="flex items-center">
            <input id="remember-me" name="remember-me" type="checkbox"
                   class="h-4 w-4 text-brand-600 focus:ring-brand-500 border-slate-300 rounded-lg">
            <label for="remember-me" class="ml-2 block text-xs font-medium text-slate-700">
                Remember me on this device
            </label>
        </div>

        <div class="pt-2">
            <button type="submit"
                    class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
                <i class="fa-solid fa-arrow-right-to-bracket text-2xs"></i>
                <span>Sign In</span>
            </button>
        </div>
    </form>
</div>