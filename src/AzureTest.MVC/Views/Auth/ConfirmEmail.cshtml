@{
    Layout = "_Layout.Auth";
    ViewData["Title"] = "Confirm Email";
    var isSuccess = ViewBag.Success as bool? ?? false;
    var message = ViewBag.Message as string;
    var errors = ViewBag.Errors as System.Collections.Generic.IReadOnlyList<string>;
}

<div class="text-center mb-8">
    @if (isSuccess)
    {
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 text-2xl shadow-2xs mb-4">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
            Email Confirmed!
        </h2>
        <p class="mt-1.5 text-xs text-slate-500">
            Thank you for verifying your email address.
        </p>
    }
    else
    {
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 text-2xl shadow-2xs mb-4">
            <i class="fa-solid fa-circle-xmark"></i>
        </div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
            Confirmation Failed
        </h2>
        <p class="mt-1.5 text-xs text-slate-500">
            We could not confirm your email address.
        </p>
    }
</div>

<div class="space-y-6">
    @if (isSuccess)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200">
            <p class="text-xs text-emerald-800 leading-relaxed text-center">
                @(message ?? "Your email has been confirmed successfully. You can now log in and access all features.")
            </p>
        </div>

        <div class="pt-2">
            <a asp-action="Login"
               class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
                <i class="fa-solid fa-arrow-right-to-bracket text-2xs"></i>
                <span>Sign In to Your Account</span>
            </a>
        </div>
    }
    else
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 space-y-2">
            <p class="text-xs text-rose-800 font-medium">
                @(message ?? "The confirmation link is invalid or has expired.")
            </p>
            @if (errors != null && errors.Count > 0)
            {
                <ul class="list-disc list-inside text-2xs text-rose-700 space-y-1">
                    @foreach (var err in errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
        </div>

        <div class="pt-2 space-y-2">
            <a asp-action="Login"
               class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-2xs transition-colors">
                <i class="fa-solid fa-arrow-left text-2xs"></i>
                <span>Back to Sign In</span>
            </a>
            <a asp-action="Register"
               class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors">
                <i class="fa-solid fa-user-plus text-2xs text-slate-400"></i>
                <span>Create New Account</span>
            </a>
        </div>
    }
</div>
