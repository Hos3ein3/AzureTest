@using AzureTest.Contracts.DTOs.Media
@using AzureTest.MVC.Models
@model IReadOnlyList<FollowedPersonDto>

@{
    ViewData["Title"] = "Followed People";

    var headerModel = new PageHeaderModel(
        Title: "Followed Actors & Directors",
        Subtitle: "Track filmographies, see how much you watched, and get alerts for upcoming projects.",
        Icon: "fa-solid fa-user-astronaut",
        Badge: $"{Model.Count} Followed",
        ActionText: "Find People",
        ActionUrl: Url.Action("Search", "Media", new { searchType = "people" }),
        ActionIcon: "fa-solid fa-magnifying-glass"
    );

    string ProfileUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";
}

<div class="space-y-6">
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    @if (!Model.Any())
    {
        var emptyModel = new EmptyStateModel(
            Title: "No People Followed Yet",
            Description: "Search for your favorite movie stars, anime voice actors, or directors to follow their filmography.",
            Icon: "fa-solid fa-users",
            ActionText: "Search TMDb for Actors",
            ActionUrl: Url.Action("Search", "Media", new { searchType = "people" })
        );
        <partial name="UiComponents/_EmptyState" model="emptyModel" />
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var person in Model)
            {
                <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between space-y-4">
                    <!-- Top Info -->
                    <div class="flex items-start gap-4">
                        <img src="@ProfileUrl(person.ProfilePath)" alt="@person.Name"
                             class="w-16 h-16 rounded-2xl object-cover border border-slate-200 flex-shrink-0" />
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <a asp-action="PersonDetails" asp-route-id="@person.TmdbPersonId"
                                   class="text-sm font-bold text-slate-900 hover:text-brand-600 truncate transition-colors">
                                    @person.Name
                                </a>
                                <span class="px-2 py-0.5 rounded-lg text-3xs font-bold uppercase bg-purple-50 text-purple-600 border border-purple-100 flex-shrink-0">
                                    @person.KnownForDepartment
                                </span>
                            </div>

                            <p class="text-3xs text-slate-400 mt-0.5">
                                Followed on @person.FollowedAt.ToString("MMM dd, yyyy")
                            </p>

                            @if (!string.IsNullOrWhiteSpace(person.Notes))
                            {
                                <p class="text-xs text-slate-600 bg-slate-50 p-2 rounded-xl mt-2 line-clamp-2 italic border border-slate-100">
                                    "@person.Notes"
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Watch Progress Indicator ("5 of 20 watched") -->
                    <div class="space-y-1.5 bg-slate-50 p-3 rounded-xl border border-slate-100">
                        <div class="flex items-center justify-between text-xs font-semibold">
                            <span class="text-slate-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-circle-check text-emerald-500 text-2xs"></i>
                                <span>Filmography Progress</span>
                            </span>
                            <span class="text-brand-600 font-bold">
                                @person.WatchedCount of @person.TotalCreditsCount watched (@person.ProgressPercentage%)
                            </span>
                        </div>
                        <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full bg-brand-600 rounded-full transition-all duration-500" style="width: @(person.ProgressPercentage)%"></div>
                        </div>
                    </div>

                    <!-- Upcoming Projects Alert -->
                    @if (person.UpcomingProjects.Any())
                    {
                        <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs flex items-center justify-between">
                            <span class="flex items-center gap-1.5 font-semibold">
                                <i class="fa-solid fa-bell text-amber-600 text-2xs animate-pulse"></i>
                                <span>@person.UpcomingProjects.Count New Project Announced!</span>
                            </span>
                            <span class="text-3xs text-amber-700 underline truncate max-w-[140px]">
                                @person.UpcomingProjects.First().Title
                            </span>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-2 pt-2 border-t border-slate-100">
                        <a asp-action="PersonDetails" asp-route-id="@person.TmdbPersonId"
                           class="flex-1 py-2 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold text-center transition-colors">
                            <i class="fa-solid fa-film mr-1 text-2xs"></i> Filmography
                        </a>

                        <button type="button"
                                onclick="openNotesModal('@person.Id', '@Html.Raw(person.Name.Replace("'", "\\\'"))', '@Html.Raw((person.Notes ?? "").Replace("'", "\\\'"))')"
                                class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs transition-colors" title="Edit Note">
                            <i class="fa-solid fa-note-sticky"></i>
                        </button>

                        <form asp-action="UnfollowPerson" asp-controller="Media" method="post" onsubmit="return confirm('Unfollow @person.Name?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="FollowedPersonId" value="@person.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs transition-colors" title="Unfollow">
                                <i class="fa-solid fa-heart-crack"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Edit Note Modal -->
<div id="notesModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs transition-opacity" onclick="closeNotesModal()"></div>
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl p-6 space-y-4 border border-slate-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-pen"></i>
                    </span>
                    <h3 id="notesModalTitle" class="text-sm font-bold text-slate-900">Notes</h3>
                </div>
                <button type="button" onclick="closeNotesModal()" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <form asp-action="UpdatePersonNotes" asp-controller="Media" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="notesPersonId" name="FollowedPersonId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Personal Notes</label>
                    <textarea id="notesContent" name="Notes" rows="3" placeholder="Why you follow this person, favorite roles, quotes..."
                              class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"></textarea>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeNotesModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-semibold transition-colors shadow-2xs">
                        Save Notes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openNotesModal(id, name, notes) {
        document.getElementById('notesPersonId').value = id;
        document.getElementById('notesModalTitle').innerText = 'Notes for ' + name;
        document.getElementById('notesContent').value = notes;
        document.getElementById('notesModal').classList.remove('hidden');
    }

    function closeNotesModal() {
        document.getElementById('notesModal').classList.add('hidden');
    }
</script>
