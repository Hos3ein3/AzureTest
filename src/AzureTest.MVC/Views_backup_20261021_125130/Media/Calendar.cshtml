@using AzureTest.Contracts.DTOs.Media
@using AzureTest.Domain.Media.Enums
@using AzureTest.MVC.Models
@model MediaCalendarDto

@{
    ViewData["Title"] = "Release Calendar";

    var currentMonthDate = new DateTime(Model.Year, Model.Month, 1);
    var prevMonthDate = currentMonthDate.AddMonths(-1);
    var nextMonthDate = currentMonthDate.AddMonths(1);

    var headerModel = new PageHeaderModel(
        Title: "Release Calendar & Status Alerts",
        Subtitle: "Follow premiere dates for your wishlist and stay updated on renewals and cancellations.",
        Icon: "fa-solid fa-calendar-days",
        Badge: currentMonthDate.ToString("MMMM yyyy"),
        ActionText: "Discover New Titles",
        ActionUrl: Url.Action("Discover", "Media"),
        ActionIcon: "fa-solid fa-compass"
    );

    string PosterUrl(string? path) => string.IsNullOrWhiteSpace(path)
        ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=400&q=80"
        : $"https://image.tmdb.org/t/p/w500{path}";
}

<div class="space-y-8">
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <!-- Month Navigation Bar -->
    <div class="flex items-center justify-between bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
        <a asp-action="Calendar" asp-route-year="@prevMonthDate.Year" asp-route-month="@prevMonthDate.Month"
           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors">
            <i class="fa-solid fa-chevron-left text-2xs"></i>
            <span>@prevMonthDate.ToString("MMM yyyy")</span>
        </a>

        <div class="flex items-center gap-2">
            <i class="fa-regular fa-calendar-check text-brand-600"></i>
            <h2 class="text-sm md:text-base font-bold text-slate-900">@currentMonthDate.ToString("MMMM yyyy")</h2>
            @if (Model.Year != DateTime.Today.Year || Model.Month != DateTime.Today.Month)
            {
                <a asp-action="Calendar" asp-route-year="@DateTime.Today.Year" asp-route-month="@DateTime.Today.Month"
                   class="ml-2 px-2.5 py-1 rounded-lg bg-brand-50 hover:bg-brand-100 text-brand-700 text-3xs font-bold transition-colors">
                    Current Month
                </a>
            }
        </div>

        <a asp-action="Calendar" asp-route-year="@nextMonthDate.Year" asp-route-month="@nextMonthDate.Month"
           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors">
            <span>@nextMonthDate.ToString("MMM yyyy")</span>
            <i class="fa-solid fa-chevron-right text-2xs"></i>
        </a>
    </div>

    <!-- Section 1: Series Renewal & Cancellation Alerts -->
    @if (Model.StatusAlerts.Any())
    {
        <div class="space-y-3">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-bullhorn"></i>
                </span>
                <div>
                    <h3 class="text-sm font-bold text-slate-900">Series Renewal & Cancellation Updates</h3>
                    <p class="text-xs text-slate-500">Official status updates for series you are watching or completed.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                @foreach (var alert in Model.StatusAlerts)
                {
                    var isCanceled = alert.SeriesStatus?.Contains("Canceled", StringComparison.OrdinalIgnoreCase) == true;
                    var isEnded = alert.SeriesStatus?.Contains("Ended", StringComparison.OrdinalIgnoreCase) == true;
                    var isRenewed = alert.SeriesStatus?.Contains("Returning", StringComparison.OrdinalIgnoreCase) == true;

                    var badgeColor = isCanceled ? "bg-rose-50 text-rose-700 border-rose-200" :
                                     isEnded ? "bg-slate-100 text-slate-700 border-slate-200" :
                                     "bg-emerald-50 text-emerald-700 border-emerald-200";

                    var statusIcon = isCanceled ? "fa-solid fa-ban text-rose-500" :
                                     isEnded ? "fa-solid fa-flag-checkered text-slate-500" :
                                     "fa-solid fa-circle-check text-emerald-500";

                    <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition-all flex items-center gap-3">
                        <img src="@PosterUrl(alert.PosterPath)" alt="@alert.Title" class="w-12 h-16 rounded-xl object-cover flex-shrink-0" />
                        <div class="flex-1 min-w-0">
                            <a asp-action="Details" asp-route-id="@alert.TmdbId" asp-route-type="@alert.Type"
                               class="text-xs font-bold text-slate-900 hover:text-brand-600 truncate block transition-colors">
                                @alert.Title
                            </a>
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-3xs font-bold border mt-1.5 @badgeColor">
                                <i class="@statusIcon text-3xs"></i>
                                <span>@(alert.Detail ?? alert.SeriesStatus)</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Section 2: Releases Scheduled This Month -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-calendar-check"></i>
                </span>
                <div>
                    <h3 class="text-sm md:text-base font-bold text-slate-900">
                        Releases in @currentMonthDate.ToString("MMMM yyyy") (@Model.Events.Count)
                    </h3>
                    <p class="text-xs text-slate-500">Wishlist titles and series seasons premiering this month.</p>
                </div>
            </div>
        </div>

        @if (!Model.Events.Any())
        {
            <div class="bg-white rounded-2xl p-8 border border-slate-200 text-center space-y-2">
                <i class="fa-regular fa-calendar-xmark text-slate-300 text-3xl"></i>
                <h4 class="text-xs font-bold text-slate-800">No Releases Scheduled This Month</h4>
                <p class="text-3xs text-slate-500 max-w-sm mx-auto">
                    None of the titles in your wishlist are set to release during @currentMonthDate.ToString("MMMM yyyy").
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var ev in Model.Events.OrderBy(e => e.ReleaseDate))
                {
                    <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-2xs hover:shadow-md transition-all flex items-center gap-4">
                        <div class="text-center w-14 flex-shrink-0 bg-slate-50 border border-slate-100 p-2 rounded-xl">
                            <span class="text-3xs font-bold text-brand-600 uppercase block">@ev.ReleaseDate.ToString("MMM")</span>
                            <span class="text-lg font-black text-slate-900 block leading-tight">@ev.ReleaseDate.Day</span>
                            <span class="text-3xs text-slate-400 block">@ev.ReleaseDate.ToString("ddd")</span>
                        </div>

                        <img src="@PosterUrl(ev.PosterPath)" alt="@ev.Title" class="w-14 h-20 rounded-xl object-cover flex-shrink-0" />

                        <div class="flex-1 min-w-0 space-y-1">
                            <a asp-action="Details" asp-route-id="@ev.TmdbId" asp-route-type="@ev.Type"
                               class="text-xs font-bold text-slate-900 hover:text-brand-600 line-clamp-1 transition-colors">
                                @ev.Title
                            </a>
                            <span class="inline-block px-2 py-0.5 rounded-lg text-3xs font-semibold bg-slate-100 text-slate-600">
                                @ev.EventType
                            </span>
                            @if (!string.IsNullOrWhiteSpace(ev.Detail))
                            {
                                <p class="text-3xs text-slate-500 truncate">@ev.Detail</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Section 3: Upcoming Wishlist Countdowns -->
    @if (Model.UpcomingWishlist.Any())
    {
        <div class="space-y-4">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-hourglass-half"></i>
                </span>
                <div>
                    <h3 class="text-sm md:text-base font-bold text-slate-900">
                        Upcoming Wishlist Countdowns (@Model.UpcomingWishlist.Count)
                    </h3>
                    <p class="text-xs text-slate-500">Titles you want to watch with future release dates.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                @foreach (var wish in Model.UpcomingWishlist.OrderBy(w => w.ReleaseDate))
                {
                    var daysUntil = (wish.ReleaseDate.Date - DateTime.Today).Days;

                    <div class="bg-white rounded-2xl border border-slate-200 p-3.5 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between space-y-3">
                        <div class="flex items-center gap-3">
                            <img src="@PosterUrl(wish.PosterPath)" alt="@wish.Title" class="w-14 h-20 rounded-xl object-cover flex-shrink-0" />
                            <div class="flex-1 min-w-0">
                                <a asp-action="Details" asp-route-id="@wish.TmdbId" asp-route-type="@wish.Type"
                                   class="text-xs font-bold text-slate-900 hover:text-brand-600 line-clamp-1 transition-colors">
                                    @wish.Title
                                </a>
                                <p class="text-3xs text-slate-500 mt-0.5">
                                    <i class="fa-regular fa-calendar mr-1"></i>@wish.ReleaseDate.ToString("MMMM dd, yyyy")
                                </p>
                                <span class="inline-block mt-1 px-2 py-0.5 rounded-lg text-3xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                    @(daysUntil == 0 ? "Releasing Today!" : $"{daysUntil} days away")
                                </span>
                            </div>
                        </div>

                        <a asp-action="Details" asp-route-id="@wish.TmdbId" asp-route-type="@wish.Type"
                           class="w-full py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-3xs font-bold text-center transition-colors">
                            View Details
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>
