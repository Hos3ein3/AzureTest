@model IEnumerable<AzureTest.Domain.Documents.Gym.TrainingCourse>
@{
    ViewData["Title"] = "Gym Courses";
    string search = ViewBag.Search as string ?? "";
    string sort = ViewBag.Sort as string ?? "Name";
    string dir = ViewBag.Dir as string ?? "asc";
    int pageNo = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string GetPageUrl(int p)
    {
        return $"?search={search}&sort={sort}&dir={dir}&page={p}";
    }

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Gym Courses", Url.Action("Index"), IsActive: true)
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel(
        "Gym Courses",
        "Design training programs, structured course weeks, daily workout plans, and exercise progressions.",
        "fa-solid fa-graduation-cap",
        breadcrumbs: breadcrumbs,
        ActionText: "Add Course",
        ActionUrl: Url.Action("Create"),
        ActionIcon: "fa-solid fa-plus"
    );

    var emptyModel = new AzureTest.MVC.Models.EmptyStateModel(
        "No Courses Found",
        string.IsNullOrEmpty(search) ? "Get started by creating your first workout course syllabus." : "No training courses match your current search criteria.",
        "fa-solid fa-graduation-cap",
        ActionText: "Add Course",
        ActionUrl: Url.Action("Create"),
        ActionIcon: "fa-solid fa-plus"
    );

    var paginationModel = new AzureTest.MVC.Models.PaginationModel(
        pageNo,
        totalPages,
        10,
        totalPages * 10,
        p => GetPageUrl(p)
    );
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<!-- Search Bar -->
<div class="mb-6 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs">
    <form method="get" class="flex flex-col md:flex-row gap-4 items-end">
        <input type="hidden" name="sort" value="@sort" />
        <input type="hidden" name="dir" value="@dir" />
        
        <div class="flex-1 w-full">
            <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1.5">Search Courses</label>
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input name="search" type="text" value="@search" placeholder="Search by course title or keywords..." 
                       class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            </div>
        </div>
        
        <div class="flex items-center gap-2 w-full md:w-auto">
            <button type="submit" class="inline-flex justify-center items-center px-4 py-2 text-xs font-semibold rounded-xl text-white bg-slate-800 hover:bg-slate-900 shadow-2xs transition-colors w-full md:w-auto">
                <i class="fa-solid fa-filter mr-1.5 text-slate-300"></i> Filter
            </button>
            @if(!string.IsNullOrEmpty(search)) {
                <a asp-action="Index" class="inline-flex justify-center items-center px-4 py-2 border border-slate-200 text-xs font-semibold rounded-xl text-slate-700 bg-white hover:bg-slate-50 transition-colors w-full md:w-auto">
                    <i class="fa-solid fa-rotate-left mr-1.5 text-slate-400"></i> Reset
                </a>
            }
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <partial name="UiComponents/_EmptyState" model="emptyModel" />
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                <div class="p-6 flex-1 flex flex-col">
                    <div class="flex justify-between items-start mb-3 gap-2">
                        <h3 class="text-base font-bold text-slate-900 line-clamp-1" title="@item.Name">@item.Name</h3>
                        <span class="bg-brand-50 text-brand-700 border border-brand-200 text-2xs font-bold px-2.5 py-1 rounded-full whitespace-nowrap">
                            @(item.Weeks?.Count ?? 0) Weeks
                        </span>
                    </div>
                    
                    <p class="text-xs text-slate-500 mb-4 line-clamp-2" title="@item.Description">
                        @(string.IsNullOrWhiteSpace(item.Description) ? "No course description provided." : item.Description)
                    </p>
                    
                    <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
                        @if(item.Tags != null && item.Tags.Any()) {
                            foreach(var tag in item.Tags.Take(4)) {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-2xs font-medium bg-slate-100 text-slate-600 border border-slate-200">#@tag</span>
                            }
                            if(item.Tags.Count > 4) {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-2xs font-medium bg-slate-100 text-slate-400 border border-slate-200">+@(item.Tags.Count - 4)</span>
                            }
                        }
                    </div>
                </div>
                <div class="bg-slate-50/75 px-6 py-3 border-t border-slate-100 flex justify-end gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 transition-colors">
                        <i class="fa-solid fa-pen-to-square mr-1.5 text-brand-600"></i> Edit Course
                    </a>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
            <partial name="UiComponents/_Pagination" model="paginationModel" />
        </div>
    }
}
