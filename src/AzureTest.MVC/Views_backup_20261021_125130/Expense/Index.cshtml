@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Expenses.ExpenseDto>
@{
    ViewData["Title"] = "My Expenses";
    var filters = ViewBag.Filters as AzureTest.Contracts.DTOs.Expenses.GetAllExpensesFilters;

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Finance", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Expenses", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "Expense Tracker",
        Subtitle = "Track day-to-day expenditures, categorized spending, and transaction histories.",
        Icon = "fa-solid fa-receipt",
        Badge = $"{Model.TotalCount} Entries",
        ActionText = "Add Expense",
        ActionUrl = "/Expense/Create",
        ActionIcon = "fa-solid fa-plus",
        Breadcrumbs = breadcrumbs
    };
    
    string GetSortLink(string sortBy, string label)
    {
        var isCurrentSort = filters?.SortBy?.Equals(sortBy, StringComparison.OrdinalIgnoreCase) ?? (sortBy == "Date");
        var desc = isCurrentSort ? !(filters?.SortDescending ?? true) : false;
        var icon = isCurrentSort ? (filters?.SortDescending ?? true ? "fa-sort-down text-brand-600" : "fa-sort-up text-brand-600") : "fa-sort text-slate-300";
        var url = $"?PageNumber=1&PageSize={filters?.PageSize}&SearchTerm={filters?.SearchTerm}&SortBy={sortBy}&SortDescending={desc}";
        
        return $@"<a href=""{url}"" class=""group inline-flex items-center gap-1.5 hover:text-brand-600 transition-colors""><span>{label}</span> <i class=""fa-solid {icon}""></i></a>";
    }
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<!-- Action Bar -->
<div class="flex flex-wrap items-center justify-between gap-3 mb-6 p-4 bg-white rounded-2xl border border-slate-200/80 shadow-2xs">
    <div class="flex items-center gap-2">
        <a asp-action="Analytics" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-chart-pie text-brand-600"></i> Expense Analytics
        </a>
        <a asp-controller="ExpenseCategory" asp-action="Index" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-tags text-slate-600"></i> Manage Categories
        </a>
    </div>

    <div class="text-2xs text-slate-400 font-mono">
        Total Items: @Model.TotalCount
    </div>
</div>

<!-- Filters Card -->
<div class="mb-6 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs">
    <form asp-action="Index" method="get">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div class="md:col-span-2">
                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Search Description</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input name="SearchTerm" type="text" value="@filters?.SearchTerm" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="Filter by description..." />
                </div>
            </div>

            <div>
                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Page Size</label>
                <select name="PageSize" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        if (filters?.PageSize == size || (filters == null && size == 10))
                        {
                            <option value="@size" selected>@size items per page</option>
                        }
                        else
                        {
                            <option value="@size">@size items per page</option>
                        }
                    }
                </select>
            </div>
            
            <div class="flex items-end gap-2">
                <button type="submit" class="flex-1 inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-filter"></i> Apply
                </button>
                <a asp-action="Index" class="inline-flex justify-center items-center p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-xs font-semibold shadow-2xs transition-colors" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-between gap-3 shadow-2xs">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <p class="text-xs font-semibold text-emerald-800">@TempData["Success"]</p>
        </div>
        <button type="button" class="text-emerald-500 hover:text-emerald-700 text-xs" onclick="this.parentElement.style.display='none';">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200/80 uppercase tracking-wider text-2xs">
                <tr>
                    <th scope="col" class="px-5 py-3.5">@Html.Raw(GetSortLink("Date", "Date"))</th>
                    <th scope="col" class="px-5 py-3.5">Description</th>
                    <th scope="col" class="px-5 py-3.5">Category</th>
                    <th scope="col" class="px-5 py-3.5 text-right">@Html.Raw(GetSortLink("Amount", "Amount"))</th>
                    <th scope="col" class="px-5 py-3.5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="p-8">
                            <partial name="UiComponents/_EmptyState" model='new AzureTest.MVC.Models.EmptyStateModel { Title = "No Expenses Found", Description = "Start logging your spending or adjust your filters.", Icon = "fa-solid fa-receipt", ActionText = "Add Expense", ActionUrl = "/Expense/Create" }' />
                        </td>
                    </tr>
                }
                @foreach (var expense in Model.Items)
                {
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td class="px-5 py-3.5 whitespace-nowrap text-2xs font-mono text-slate-600">
                            @expense.Date.ToString("MMM d, yyyy")
                        </td>
                        <td class="px-5 py-3.5">
                            <div class="font-bold text-slate-900 text-xs">@expense.Description</div>
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap">
                            @if (!string.IsNullOrWhiteSpace(expense.CategoryName))
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-brand-50 text-brand-700 border border-brand-200/80">
                                    <i class="fa-solid fa-tag text-3xs"></i> @expense.CategoryName
                                </span>
                            }
                            else
                            {
                                <span class="text-2xs text-slate-400 italic">Uncategorized</span>
                            }
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap text-right font-black text-rose-600 font-mono text-xs">
                            -@expense.Amount.ToString("C")
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap text-right">
                            <div class="inline-flex items-center gap-1">
                                <a asp-action="Details" asp-route-id="@expense.Id" class="p-2 rounded-lg text-slate-400 hover:text-brand-600 hover:bg-slate-100 transition-colors" title="Details">
                                    <i class="fa-regular fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@expense.Id" class="p-2 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-slate-100 transition-colors" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@expense.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this expense?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-2 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        var paginationModel = new AzureTest.MVC.Models.PaginationModel
        {
            CurrentPage = Model.PageNumber,
            TotalPages = Model.TotalPages,
            PageSize = Model.PageSize,
            TotalItems = Model.TotalCount,
            BaseUrl = "/Expense/Index",
            RouteParams = new Dictionary<string, string>
            {
                { "SearchTerm", filters?.SearchTerm ?? "" },
                { "SortBy", filters?.SortBy ?? "" },
                { "SortDescending", (filters?.SortDescending ?? true).ToString() },
                { "PageSize", (filters?.PageSize ?? 10).ToString() }
            }
        };
        <partial name="UiComponents/_Pagination" model="paginationModel" />
    }
</div>
