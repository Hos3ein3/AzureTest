@model AzureTest.Contracts.DTOs.Expenses.CreateExpenseDto
@{
    ViewData["Title"] = "Add Expense";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Expenses", Url = "/Expense/Index" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Add Expense", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "Record Expense",
        Subtitle = "Log a transaction with cost, category tag, and date.",
        Icon = "fa-solid fa-receipt",
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<div class="max-w-2xl">
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-money-bill-wave text-brand-600 text-xs"></i>
                <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Expense Details</h2>
            </div>
            <span class="text-2xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">New Entry</span>
        </div>

        <div class="p-6 md:p-8">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="p-3 mb-6 bg-rose-50 border border-rose-200/80 rounded-xl text-rose-700 text-xs"></div>
                
                <partial name="_UpsertPartial" />

                <div class="flex items-center justify-end gap-3 pt-5 border-t border-slate-100">
                    <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
                        <i class="fa-solid fa-floppy-disk"></i> Save Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- UiComponents Searchable Dropdown & Category Logic ---
        const toggleBtn = document.getElementById('toggleNewCategory');
        const newPanel  = document.getElementById('newCategoryPanel');
        const newInput  = document.getElementById('newCategoryInput');
        const acList    = document.getElementById('categoryAutocomplete');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                const isVisible = newPanel.style.display !== 'none';
                if (isVisible) {
                    newPanel.style.display = 'none';
                    if (newInput) newInput.value = '';
                } else {
                    newPanel.style.display = 'block';
                    selectCategoryOption('', '-- Search or select existing category --');
                    if (newInput) newInput.focus();
                }
            });
        }

        let debounceTimer;
        if (newInput) {
            newInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                const term = newInput.value.trim();
                if (term.length < 1) { if (acList) acList.style.display = 'none'; return; }

                debounceTimer = setTimeout(async () => {
                    const res  = await fetch(`/Expense/SearchExpenseCategories?term=${encodeURIComponent(term)}`);
                    const data = await res.json();

                    if (!acList) return;
                    acList.innerHTML = '';
                    if (!data || data.length === 0) { acList.style.display = 'none'; return; }

                    data.forEach(c => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'w-full text-left px-4 py-2.5 text-xs text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 hover:text-brand-600 focus:outline-none transition-colors';
                        item.textContent = c.name;
                        item.addEventListener('click', () => {
                            selectCategoryOption(c.id, c.name);
                            newInput.value = '';
                            newPanel.style.display = 'none';
                            acList.style.display = 'none';
                        });
                        acList.appendChild(item);
                    });
                    acList.style.display = 'block';
                }, 300);
            });
        }

        document.addEventListener('click', (e) => {
            const btn = document.getElementById('categoryDropdownBtn');
            const menu = document.getElementById('categoryDropdownMenu');
            if (btn && menu && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.add('hidden');
            }

            if (acList && !acList.contains(e.target) && e.target !== newInput) {
                acList.style.display = 'none';
            }
        });
        
        if (newInput && newInput.value.trim().length > 0) {
            newPanel.style.display = 'block';
        }
    });

    // Global Searchable Dropdown functions for UiComponents pattern
    function toggleCategoryDropdownMenu() {
        const menu = document.getElementById('categoryDropdownMenu');
        menu?.classList.toggle('hidden');
        if (menu && !menu.classList.contains('hidden')) {
            const input = document.getElementById('categoryFilterInput');
            if (input) {
                input.value = '';
                filterCategoryOptions('');
                input.focus();
            }
        }
    }

    function filterCategoryOptions(term) {
        const filter = (term || '').toLowerCase().trim();
        const items = document.querySelectorAll('#categoryOptionsList .category-option');
        items.forEach(item => {
            const text = (item.textContent || '').toLowerCase();
            item.style.display = text.includes(filter) ? 'flex' : 'none';
        });
    }

    function selectCategoryOption(id, name) {
        const hiddenInput = document.getElementById('categoryIdInput');
        const label = document.getElementById('categorySelectedLabel');
        const newPanel = document.getElementById('newCategoryPanel');
        const newInput = document.getElementById('newCategoryInput');

        if (hiddenInput) hiddenInput.value = id;
        if (label) {
            label.innerText = name;
            if (id) {
                label.className = 'text-slate-900 dark:text-white font-bold truncate';
            } else {
                label.className = 'text-slate-400 dark:text-slate-400 font-normal truncate';
            }
        }

        if (id && newPanel) {
            newPanel.style.display = 'none';
            if (newInput) newInput.value = '';
        }

        // Update checkmark in list
        const items = document.querySelectorAll('#categoryOptionsList .category-option');
        items.forEach(item => {
            const check = item.querySelector('.checkmark-icon');
            if (check) check.remove();
        });

        const menu = document.getElementById('categoryDropdownMenu');
        menu?.classList.add('hidden');
    }
    </script>
}
