@model AzureTest.MVC.Controllers.DateTimeConverterViewModel
@{
    ViewData["Title"] = "DateTime Converter & Exact Age";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Utilities", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "DateTime Converter", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "DateTime Converter & Age",
        Subtitle = "Seamless bidirectional conversion between Solar Hijri (Shamsi), Gregorian (Miladi), and Lunar Hijri (Ghamari).",
        Icon = "fa-solid fa-clock-rotate-left",
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<div class="space-y-8">
    
    <!-- SECTION 1: MULTI-CALENDAR CONVERTER -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-xs shrink-0">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
                        DateTime Converter (تبدیل تاریخ و زمان)
                    </h3>
                    <p class="text-2xs text-slate-500 mt-0.5">
                        Convert timestamps across Shamsi, Miladi, and Ghamari calendars with leap year validation.
                    </p>
                </div>
            </div>
            <button type="button" onclick="setNow()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-2xs font-semibold shadow-2xs transition-colors">
                <i class="fa-solid fa-rotate text-brand-600"></i> Set to Current Time
            </button>
        </div>

        <div class="p-6 md:p-8">
            <form asp-action="ConvertDate" method="post" id="convertForm">
                @Html.AntiForgeryToken()
                
                <!-- Calendar System Selector -->
                <div class="mb-6">
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-2">Input Calendar System</label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-xl">
                        <label class="relative flex items-center justify-center gap-2 p-3.5 rounded-xl border cursor-pointer transition-all text-xs @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Shamsi ? "border-brand-500 bg-brand-50 text-brand-700 shadow-2xs font-bold ring-2 ring-brand-500/20" : "border-slate-200/80 hover:bg-slate-50/70 text-slate-700 bg-white")">
                            <input type="radio" name="SelectedCalendar" value="Shamsi" @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Shamsi ? "checked" : "") onchange="this.form.submit()" class="sr-only" />
                            <i class="fa-solid fa-sun text-amber-500"></i>
                            <span>Shamsi (شمسی)</span>
                        </label>
                        <label class="relative flex items-center justify-center gap-2 p-3.5 rounded-xl border cursor-pointer transition-all text-xs @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Miladi ? "border-brand-500 bg-brand-50 text-brand-700 shadow-2xs font-bold ring-2 ring-brand-500/20" : "border-slate-200/80 hover:bg-slate-50/70 text-slate-700 bg-white")">
                            <input type="radio" name="SelectedCalendar" value="Miladi" @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Miladi ? "checked" : "") onchange="this.form.submit()" class="sr-only" />
                            <i class="fa-solid fa-earth-americas text-blue-500"></i>
                            <span>Miladi (میلادی)</span>
                        </label>
                        <label class="relative flex items-center justify-center gap-2 p-3.5 rounded-xl border cursor-pointer transition-all text-xs @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Ghamari ? "border-brand-500 bg-brand-50 text-brand-700 shadow-2xs font-bold ring-2 ring-brand-500/20" : "border-slate-200/80 hover:bg-slate-50/70 text-slate-700 bg-white")">
                            <input type="radio" name="SelectedCalendar" value="Ghamari" @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Ghamari ? "checked" : "") onchange="this.form.submit()" class="sr-only" />
                            <i class="fa-solid fa-moon text-emerald-500"></i>
                            <span>Ghamari (قمری)</span>
                        </label>
                    </div>
                </div>

                <!-- Date & Time Inputs -->
                <div class="grid grid-cols-2 sm:grid-cols-6 gap-3 mb-6">
                    <div class="col-span-1 sm:col-span-2">
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Year (سال)</label>
                        <input type="number" name="Year" id="inputYear" value="@Model.Year" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Month (ماه)</label>
                        <input type="number" min="1" max="12" name="Month" id="inputMonth" value="@Model.Month" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Day (روز)</label>
                        <input type="number" min="1" max="31" name="Day" id="inputDay" value="@Model.Day" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Hour (ساعت)</label>
                        <input type="number" min="0" max="23" name="Hour" id="inputHour" value="@Model.Hour" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Minute (دقیقه)</label>
                        <input type="number" min="0" max="59" name="Minute" id="inputMinute" value="@Model.Minute" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                </div>

                <!-- Hidden inputs to retain age section state -->
                <input type="hidden" name="BirthCalendar" value="@Model.BirthCalendar" />
                <input type="hidden" name="BirthYear" value="@Model.BirthYear" />
                <input type="hidden" name="BirthMonth" value="@Model.BirthMonth" />
                <input type="hidden" name="BirthDay" value="@Model.BirthDay" />
                <input type="hidden" name="BirthHour" value="@Model.BirthHour" />
                <input type="hidden" name="BirthMinute" value="@Model.BirthMinute" />

                <div class="flex items-center gap-3">
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
                        <i class="fa-solid fa-arrow-right-arrow-left"></i> Convert Date
                    </button>
                </div>
            </form>

            <!-- Conversion Results Cards (3 Columns) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                
                <!-- SHAMSI CARD -->
                <div class="rounded-2xl border @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Shamsi ? "border-brand-500 ring-2 ring-brand-500/20 bg-brand-50/20" : "border-slate-200/80 bg-white") p-5 flex flex-col justify-between shadow-2xs">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-amber-50 text-amber-700 border border-amber-200/80">
                                <i class="fa-solid fa-sun text-amber-500"></i> Shamsi (شمسی)
                            </span>
                            <button type="button" onclick="copyText('@Model.ConvertedResult.Shamsi.FormattedDate')" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" title="Copy date">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                        </div>

                        <div class="text-xl font-black text-slate-900 tracking-tight font-mono mb-1" id="resShamsiDate">
                            @Model.ConvertedResult.Shamsi.FormattedDate
                        </div>
                        <div class="text-2xs font-mono text-slate-400 mb-3" id="resShamsiTime">
                            @Model.ConvertedResult.Shamsi.FormattedDateTime.Substring(Math.Max(0, Model.ConvertedResult.Shamsi.FormattedDateTime.Length - 8))
                        </div>

                        <div class="space-y-1.5 pt-3 border-t border-slate-100 text-xs text-slate-600">
                            <div><span class="text-slate-400 text-2xs">فارسی:</span> <strong class="text-slate-800">@Model.ConvertedResult.Shamsi.FullText</strong></div>
                            <div><span class="text-slate-400 text-2xs">Month:</span> @Model.ConvertedResult.Shamsi.MonthName (@Model.ConvertedResult.Shamsi.MonthNameFarsi)</div>
                            <div><span class="text-slate-400 text-2xs">Day:</span> @Model.ConvertedResult.Shamsi.DayOfWeekName (@Model.ConvertedResult.Shamsi.DayOfWeekNameFarsi)</div>
                        </div>
                    </div>

                    <div class="pt-3 mt-3 border-t border-slate-100 flex justify-between text-3xs text-slate-400">
                        <span>Day of Year: @Model.ConvertedResult.Shamsi.DayOfYear</span>
                        <span class="font-semibold text-slate-600">@(Model.ConvertedResult.Shamsi.IsLeapYear ? "Leap Year (کبیسه)" : "Standard Year")</span>
                    </div>
                </div>

                <!-- MILADI CARD -->
                <div class="rounded-2xl border @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Miladi ? "border-brand-500 ring-2 ring-brand-500/20 bg-brand-50/20" : "border-slate-200/80 bg-white") p-5 flex flex-col justify-between shadow-2xs">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-blue-50 text-blue-700 border border-blue-200/80">
                                <i class="fa-solid fa-earth-americas text-blue-500"></i> Miladi (میلادی)
                            </span>
                            <button type="button" onclick="copyText('@Model.ConvertedResult.Miladi.FormattedDate')" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" title="Copy date">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                        </div>

                        <div class="text-xl font-black text-slate-900 tracking-tight font-mono mb-1" id="resMiladiDate">
                            @Model.ConvertedResult.Miladi.FormattedDate
                        </div>
                        <div class="text-2xs font-mono text-slate-400 mb-3" id="resMiladiTime">
                            @Model.ConvertedResult.Miladi.FormattedDateTime.Substring(Math.Max(0, Model.ConvertedResult.Miladi.FormattedDateTime.Length - 8)) UTC
                        </div>

                        <div class="space-y-1.5 pt-3 border-t border-slate-100 text-xs text-slate-600">
                            <div><span class="text-slate-400 text-2xs">Full:</span> <strong class="text-slate-800">@Model.ConvertedResult.Miladi.FullText</strong></div>
                            <div><span class="text-slate-400 text-2xs">Month:</span> @Model.ConvertedResult.Miladi.MonthName (@Model.ConvertedResult.Miladi.MonthNameFarsi)</div>
                            <div><span class="text-slate-400 text-2xs">Day:</span> @Model.ConvertedResult.Miladi.DayOfWeekName (@Model.ConvertedResult.Miladi.DayOfWeekNameFarsi)</div>
                        </div>
                    </div>

                    <div class="pt-3 mt-3 border-t border-slate-100 flex justify-between text-3xs text-slate-400">
                        <span>Day of Year: @Model.ConvertedResult.Miladi.DayOfYear</span>
                        <span class="font-semibold text-slate-600">@(Model.ConvertedResult.Miladi.IsLeapYear ? "Leap Year" : "Standard Year")</span>
                    </div>
                </div>

                <!-- GHAMARI CARD -->
                <div class="rounded-2xl border @(Model.SelectedCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Ghamari ? "border-brand-500 ring-2 ring-brand-500/20 bg-brand-50/20" : "border-slate-200/80 bg-white") p-5 flex flex-col justify-between shadow-2xs">
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                <i class="fa-solid fa-moon text-emerald-500"></i> Ghamari (قمری)
                            </span>
                            <button type="button" onclick="copyText('@Model.ConvertedResult.Ghamari.FormattedDate')" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" title="Copy date">
                                <i class="fa-regular fa-copy text-xs"></i>
                            </button>
                        </div>

                        <div class="text-xl font-black text-slate-900 tracking-tight font-mono mb-1" id="resGhamariDate">
                            @Model.ConvertedResult.Ghamari.FormattedDate
                        </div>
                        <div class="text-2xs font-mono text-slate-400 mb-3" id="resGhamariTime">
                            @Model.ConvertedResult.Ghamari.FormattedDateTime.Substring(Math.Max(0, Model.ConvertedResult.Ghamari.FormattedDateTime.Length - 8))
                        </div>

                        <div class="space-y-1.5 pt-3 border-t border-slate-100 text-xs text-slate-600">
                            <div><span class="text-slate-400 text-2xs">عربی/فارسی:</span> <strong class="text-slate-800">@Model.ConvertedResult.Ghamari.FullText</strong></div>
                            <div><span class="text-slate-400 text-2xs">Month:</span> @Model.ConvertedResult.Ghamari.MonthName (@Model.ConvertedResult.Ghamari.MonthNameFarsi)</div>
                            <div><span class="text-slate-400 text-2xs">Day:</span> @Model.ConvertedResult.Ghamari.DayOfWeekName (@Model.ConvertedResult.Ghamari.DayOfWeekNameFarsi)</div>
                        </div>
                    </div>

                    <div class="pt-3 mt-3 border-t border-slate-100 flex justify-between text-3xs text-slate-400">
                        <span>Day of Year: @Model.ConvertedResult.Ghamari.DayOfYear</span>
                        <span class="font-semibold text-slate-600">@(Model.ConvertedResult.Ghamari.IsLeapYear ? "Leap Year" : "Standard Year")</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- SECTION 2: EXACT AGE CALCULATOR -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden" id="exactAgeSection">
        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xs shrink-0">
                    <i class="fa-solid fa-cake-candles"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
                        Exact Age Calculator (محاسبه دقیق سن)
                    </h3>
                    <p class="text-2xs text-slate-500 mt-0.5">
                        Calculate exact age breakdown down to seconds, zodiac signs, and next birthday countdown.
                    </p>
                </div>
            </div>
            <span class="text-2xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200/80">Precision Timer</span>
        </div>

        <div class="p-6 md:p-8">
            <form asp-action="CalculateAge" method="post" id="ageForm">
                @Html.AntiForgeryToken()

                <!-- Hidden inputs to preserve section 1 state -->
                <input type="hidden" name="SelectedCalendar" value="@Model.SelectedCalendar" />
                <input type="hidden" name="Year" value="@Model.Year" />
                <input type="hidden" name="Month" value="@Model.Month" />
                <input type="hidden" name="Day" value="@Model.Day" />
                <input type="hidden" name="Hour" value="@Model.Hour" />
                <input type="hidden" name="Minute" value="@Model.Minute" />
                <input type="hidden" name="Second" value="@Model.Second" />

                <!-- Birth Calendar System -->
                <div class="mb-5">
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-2">Birth Calendar</label>
                    <div class="flex flex-wrap items-center gap-4">
                        <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                            <input type="radio" name="BirthCalendar" value="Shamsi" @(Model.BirthCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Shamsi ? "checked" : "") class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                            <span>Shamsi (شمسی)</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                            <input type="radio" name="BirthCalendar" value="Miladi" @(Model.BirthCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Miladi ? "checked" : "") class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                            <span>Miladi (میلادی)</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer">
                            <input type="radio" name="BirthCalendar" value="Ghamari" @(Model.BirthCalendar == AzureTest.Application.Interfaces.Services.CalendarType.Ghamari ? "checked" : "") class="w-4 h-4 text-brand-600 focus:ring-brand-500 border-slate-300" />
                            <span>Ghamari (قمری)</span>
                        </label>
                    </div>
                </div>

                <!-- Birth Date Inputs -->
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Birth Year (سال)</label>
                        <input type="number" name="BirthYear" id="birthYear" value="@Model.BirthYear" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" placeholder="e.g. 1375 or 1996" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Birth Month (ماه)</label>
                        <input type="number" min="1" max="12" name="BirthMonth" id="birthMonth" value="@Model.BirthMonth" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Birth Day (روز)</label>
                        <input type="number" min="1" max="31" name="BirthDay" id="birthDay" value="@Model.BirthDay" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Birth Hour (ساعت)</label>
                        <input type="number" min="0" max="23" name="BirthHour" id="birthHour" value="@Model.BirthHour" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Birth Minute (دقیقه)</label>
                        <input type="number" min="0" max="59" name="BirthMinute" id="birthMinute" value="@Model.BirthMinute" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white font-mono" />
                    </div>
                </div>

                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold shadow-2xs transition-colors">
                    <i class="fa-solid fa-calculator"></i> Calculate Exact Age
                </button>
            </form>

            @if (Model.AgeResult != null)
            {
                <div class="mt-8 space-y-6 pt-6 border-t border-slate-100">
                    
                    <!-- Exact Age Highlight Banner -->
                    <div class="p-6 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-lg shadow-amber-500/20">
                        <div class="text-2xs uppercase font-bold tracking-wider text-amber-100 mb-1">Your Exact Age (سن دقیق شما)</div>
                        <div class="text-2xl sm:text-3xl font-black tracking-tight mb-1 font-mono">
                            @Model.AgeResult.Years <span class="text-amber-200 text-base font-medium">Years</span>,
                            @Model.AgeResult.Months <span class="text-amber-200 text-base font-medium">Months</span>,
                            @Model.AgeResult.Days <span class="text-amber-200 text-base font-medium">Days</span>
                        </div>
                        <div class="text-sm font-medium text-amber-100 mb-3 font-mono">
                            @Model.AgeResult.Hours Hours, @Model.AgeResult.Minutes Minutes, @Model.AgeResult.Seconds Seconds
                        </div>
                        <div class="pt-3 border-t border-amber-400/50 text-xs font-semibold text-white flex items-center gap-2">
                            <i class="fa-solid fa-language text-sm"></i> @Model.AgeResult.FormattedAgeFarsi
                        </div>
                    </div>

                    <!-- Statistics Cards Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 text-center shadow-2xs">
                            <span class="text-3xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Total Days Lived</span>
                            <span class="text-lg font-black text-slate-800 font-mono">@Model.AgeResult.TotalDays.ToString("N0")</span>
                            <span class="text-3xs text-slate-400 block mt-0.5">روز سپری شده</span>
                        </div>
                        <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 text-center shadow-2xs">
                            <span class="text-3xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Total Hours Lived</span>
                            <span class="text-lg font-black text-slate-800 font-mono">@Model.AgeResult.TotalHours.ToString("N0")</span>
                            <span class="text-3xs text-slate-400 block mt-0.5">ساعت سپری شده</span>
                        </div>
                        <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 text-center shadow-2xs">
                            <span class="text-3xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Total Minutes Lived</span>
                            <span class="text-lg font-black text-slate-800 font-mono">@Model.AgeResult.TotalMinutes.ToString("N0")</span>
                            <span class="text-3xs text-slate-400 block mt-0.5">دقیقه سپری شده</span>
                        </div>
                        <div class="p-4 rounded-xl border border-slate-200/80 bg-slate-50/50 text-center shadow-2xs">
                            <span class="text-3xs font-bold uppercase tracking-wider text-slate-400 block mb-1">Total Seconds Lived</span>
                            <span class="text-lg font-black text-slate-800 font-mono">@Model.AgeResult.TotalSeconds.ToString("N0")</span>
                            <span class="text-3xs text-slate-400 block mt-0.5">ثانیه سپری شده</span>
                        </div>
                    </div>

                    <!-- Insights Card (Next Birthday & Zodiac) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="p-4 rounded-xl border border-slate-200/80 bg-white flex items-center gap-3.5 shadow-2xs">
                            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-sm flex-shrink-0">
                                <i class="fa-solid fa-cake-candles"></i>
                            </div>
                            <div>
                                <span class="text-3xs font-bold uppercase tracking-wider text-slate-400 block">Next Birthday (تولد بعدی)</span>
                                <span class="text-xs font-bold text-slate-800">In @Model.AgeResult.DaysUntilNextBirthday days</span>
                                <span class="text-2xs text-slate-500 block">On @Model.AgeResult.NextBirthdayDayOfWeek (@Model.AgeResult.NextBirthdayDayOfWeekFarsi)</span>
                            </div>
                        </div>

                        <div class="p-4 rounded-xl border border-slate-200/80 bg-white flex items-center gap-3.5 shadow-2xs">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm flex-shrink-0">
                                <i class="fa-solid fa-star-and-crescent"></i>
                            </div>
                            <div>
                                <span class="text-3xs font-bold uppercase tracking-wider text-slate-400 block">Zodiac Sign (نماد ماه)</span>
                                <span class="text-xs font-bold text-slate-800">@Model.AgeResult.ZodiacSign</span>
                                <span class="text-2xs text-slate-500 block">@Model.AgeResult.ZodiacSignFarsi</span>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function copyText(text) {
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                alert('Copied to clipboard: ' + text);
            });
        }

        function setNow() {
            const now = new Date();
            const selectedCal = document.querySelector('input[name="SelectedCalendar"]:checked').value;
            
            if (selectedCal === 'Miladi') {
                document.getElementById('inputYear').value = now.getUTCFullYear();
                document.getElementById('inputMonth').value = now.getUTCMonth() + 1;
                document.getElementById('inputDay').value = now.getUTCDate();
                document.getElementById('inputHour').value = now.getUTCHours();
                document.getElementById('inputMinute').value = now.getUTCMinutes();
                document.getElementById('convertForm').submit();
            } else {
                window.location.href = '@Url.Action("Index", "DateTimeConverter")?calendar=' + selectedCal;
            }
        }
    </script>
}
