@model AzureTest.Domain.Documents.DashboardRawComponent

<div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Component Name <span class="text-rose-500">*</span></label>
            <input asp-for="Name" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-semibold text-slate-800 placeholder:text-slate-400" placeholder="e.g. Live Sales Chart" />
            <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block font-medium"></span>
        </div>

        <div>
            <label asp-for="Category" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Category (Optional)</label>
            <input asp-for="Category" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" placeholder="e.g. Financials, HR, Metrics" />
            <span asp-validation-for="Category" class="text-xs text-rose-500 mt-1 block font-medium"></span>
        </div>

        <div>
            <label asp-for="RequiredRole" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Required Role (Optional)</label>
            <input asp-for="RequiredRole" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" placeholder="e.g. Admin" />
            <span asp-validation-for="RequiredRole" class="text-xs text-rose-500 mt-1 block font-medium"></span>
        </div>

        <div>
            <label asp-for="Type" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Component Type</label>
            <select asp-for="Type" id="componentTypeSelect" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-semibold text-slate-800">
                <option value="RawHtml">Approach 1: Raw HTML / JS</option>
                <option value="JsonConfig">Approach 2: JSON Configuration</option>
            </select>
            <span asp-validation-for="Type" class="text-xs text-rose-500 mt-1 block font-medium"></span>
        </div>
    </div>

    <!-- HTML Content Area -->
    <div id="htmlSection" class="@(Model.Type == "RawHtml" ? "" : "hidden") space-y-2">
        <label asp-for="HtmlContent" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Raw HTML & JavaScript</label>
        <p class="text-xs text-slate-400">Write HTML markup, inline styles, and script tags. Rendered inside an isolated widget container.</p>
        <textarea asp-for="HtmlContent" rows="8" class="w-full font-mono rounded-xl border border-slate-800 p-4 text-xs bg-slate-900 text-emerald-400 focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="<div>Hello World</div>"></textarea>
        <span asp-validation-for="HtmlContent" class="text-xs text-rose-500 mt-1 block font-medium"></span>
    </div>

    <!-- JSON Content Area -->
    <div id="jsonSection" class="@(Model.Type == "JsonConfig" ? "" : "hidden") space-y-4">
        <div>
            <label asp-for="JsonConfiguration" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">JSON Configuration</label>
            <p class="text-xs text-slate-400 mb-2">Provide a valid JSON configuration object for dynamic chart/data rendering.</p>
            <textarea asp-for="JsonConfiguration" rows="8" class="w-full font-mono rounded-xl border border-slate-200 p-4 text-xs bg-slate-50 text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" placeholder='{ "chartType": "bar" }'></textarea>
            <span asp-validation-for="JsonConfiguration" class="text-xs text-rose-500 mt-1 block font-medium"></span>
        </div>

        <div>
            <label asp-for="ViewName" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">View Name (Optional)</label>
            <p class="text-xs text-slate-400 mb-1">Optional Razor partial view used to parse this config (e.g. "Widgets/_ResumeStatsA").</p>
            <input asp-for="ViewName" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" />
        </div>
    </div>

    <!-- Grid Constraints -->
    <div class="pt-6 border-t border-slate-100">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4">Grid Layout Constraints</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div>
                <label asp-for="MinWidth" class="block text-xs font-medium text-slate-600 mb-1">Min Width</label>
                <input asp-for="MinWidth" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
            </div>
            <div>
                <label asp-for="MaxWidth" class="block text-xs font-medium text-slate-600 mb-1">Max Width</label>
                <input asp-for="MaxWidth" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
            </div>
            <div>
                <label asp-for="MinHeight" class="block text-xs font-medium text-slate-600 mb-1">Min Height</label>
                <input asp-for="MinHeight" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
            </div>
            <div>
                <label asp-for="MaxHeight" class="block text-xs font-medium text-slate-600 mb-1">Max Height</label>
                <input asp-for="MaxHeight" type="number" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
            </div>
        </div>
        <div class="mt-4 flex items-center">
            <input asp-for="IsResizable" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
            <label asp-for="IsResizable" class="ml-2.5 text-xs font-semibold text-slate-700">Allow Resizing in GridStack</label>
        </div>
    </div>
</div>
