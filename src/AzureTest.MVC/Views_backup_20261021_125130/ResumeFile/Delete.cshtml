@model AzureTest.Contracts.DTOs.Resumes.ResumeFileDto
@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Delete Resume Files";
    var pageHeader = new PageHeaderModel
    {
        Title = "Delete Resume Files",
        Subtitle = "Confirm permanent deletion of stored CV and cover letter documents",
        Icon = "fa-solid fa-trash-can",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Resume Files", Url.Action("Index", "ResumeFile")),
            new BreadcrumbItem("Delete", active: true)
        }
    };
}

<partial name="UiComponents/_PageHeader" model="pageHeader" />

<div class="max-w-xl">
    <div class="bg-white rounded-2xl border border-rose-200 shadow-2xs overflow-hidden">
        <div class="px-6 py-4 bg-rose-50/70 border-b border-rose-100 flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <h3 class="text-xs font-bold text-rose-900 m-0">Permanent File Deletion</h3>
                <p class="text-2xs text-rose-700 mt-0.5">This will permanently delete CV and Cover Letter files from disk and database.</p>
            </div>
        </div>
        <div class="p-6">
            <dl class="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-100 text-xs">
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <dt class="font-medium text-slate-500">Resume ID</dt>
                    <dd class="font-mono text-slate-900 text-2xs">@Model.ResumeId</dd>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-200/60">
                    <dt class="font-medium text-slate-500">CV File</dt>
                    <dd class="text-slate-800 font-medium">@(string.IsNullOrWhiteSpace(Model.RealNameOfCV) ? "None" : Model.RealNameOfCV)</dd>
                </div>
                <div class="flex justify-between py-1">
                    <dt class="font-medium text-slate-500">Cover Letter</dt>
                    <dd class="text-slate-800 font-medium">@(string.IsNullOrWhiteSpace(Model.RealNameOfCL) ? "None" : Model.RealNameOfCL)</dd>
                </div>
            </dl>
        </div>
        <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-end gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors">
                <span>Cancel</span>
            </a>
            <form asp-action="Delete" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-sm transition-colors">
                    <i class="fa-solid fa-trash text-2xs"></i>
                    <span>Yes, Delete Files</span>
                </button>
            </form>
        </div>
    </div>
</div>
