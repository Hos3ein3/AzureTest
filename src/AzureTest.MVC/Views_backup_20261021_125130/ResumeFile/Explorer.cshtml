@model AzureTest.MVC.Models.ResumeFileExplorerViewModel
@{
    ViewData["Title"] = "File Explorer";
}

@using AzureTest.MVC.Models

<partial name="UiComponents/_Breadcrumb" model='new List<BreadcrumbItem> { new BreadcrumbItem("Resume Files", Url.Action("Index", "ResumeFile")), new BreadcrumbItem("File Explorer", active: true) }' />

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs shrink-0">
            <i class="fa-solid fa-folder-open"></i>
        </div>
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                File Explorer
            </h1>
            <p class="text-xs text-slate-500 mt-0.5 flex items-center gap-1.5">
                <i class="fa-solid fa-hard-drive text-slate-400"></i>
                <span>uploads / resumes / <strong class="text-slate-800">@Model.CurrentFolderName</strong></span>
            </p>
        </div>
    </div>
    
    @if (Model.IsAdmin)
    {
        <form method="get" class="flex items-center gap-2">
            <select name="folder" class="w-56 px-3 py-2 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white shadow-2xs">
                <option value="">(Select User Folder)</option>
                @foreach (var f in Model.AvailableFolders)
                {
                    if (f.FolderId == Model.CurrentFolder)
                    {
                        <option value="@f.FolderId" selected>@f.FolderName</option>
                    }
                    else
                    {
                        <option value="@f.FolderId">@f.FolderName</option>
                    }
                }
            </select>
            <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white px-3.5 py-2 rounded-xl hover:bg-slate-800 text-xs font-semibold transition-colors shadow-2xs whitespace-nowrap">
                <i class="fa-solid fa-arrow-right-arrow-left text-2xs"></i>
                <span>Switch</span>
            </button>
        </form>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center gap-3 text-xs text-emerald-800 shadow-2xs" role="alert">
        <i class="fa-solid fa-circle-check text-emerald-500"></i>
        <div class="flex-1 font-medium">@TempData["Success"]</div>
    </div>
}

<div class="bg-white shadow-2xs rounded-2xl border border-slate-200/80 p-6 min-h-[400px]">
    @if (!Model.Files.Any())
    {
        <partial name="UiComponents/_EmptyState" model='new EmptyStateModel("This folder is empty", "No files have been uploaded to this directory yet.", "fa-regular fa-folder-open")' />
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var file in Model.Files)
            {
                var isPdf = file.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                var isImage = file.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || 
                              file.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || 
                              file.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                              file.FileName.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);
                              
                <div class="group relative flex flex-col bg-gray-50 rounded-xl border border-gray-200 hover:border-brand-400 hover:shadow-md transition-all duration-200 overflow-hidden">
                    
                    <div class="flex-1 flex items-center justify-center p-8 bg-white border-b border-gray-100">
                        @if (isPdf)
                        {
                            <i class="fa-solid fa-file-pdf text-[80px] text-red-500 group-hover:scale-110 transition-transform duration-300 drop-shadow-sm"></i>
                        }
                        else if (isImage)
                        {
                            <i class="fa-solid fa-file-image text-[80px] text-blue-500 group-hover:scale-110 transition-transform duration-300 drop-shadow-sm"></i>
                        }
                        else if (file.FileName.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || file.FileName.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
                        {
                            <i class="fa-solid fa-file-word text-[80px] text-blue-700 group-hover:scale-110 transition-transform duration-300 drop-shadow-sm"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-file text-[80px] text-gray-400 group-hover:scale-110 transition-transform duration-300 drop-shadow-sm"></i>
                        }
                    </div>

                    <div class="p-4 flex flex-col gap-1.5">
                        <h4 class="text-sm font-medium text-gray-900 truncate" title="@file.FileName">@file.FileName</h4>
                        <div class="flex items-center justify-between text-xs text-gray-500">
                            <span>@(Math.Round(file.SizeBytes / 1024.0, 2)) KB</span>
                            @if (!string.IsNullOrEmpty(file.Type))
                            {
                                <span class="bg-brand-100 text-brand-800 px-2.5 py-0.5 rounded font-semibold text-[10px]">@file.Type.ToUpper()</span>
                            }
                            else if (file.DocumentId.HasValue)
                            {
                                <span class="text-green-600 font-medium" title="Linked to Document"><i class="fa-solid fa-link"></i> Linked</span>
                            }
                            else
                            {
                                <span class="text-red-500 font-medium" title="Unlinked (Orphan)"><i class="fa-solid fa-link-slash"></i> Orphan</span>
                            }
                        </div>
                    </div>

                    <div class="absolute inset-0 bg-gray-900/60 flex items-center justify-center gap-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        <a href="@file.RelativePath" download class="w-12 h-12 bg-white text-gray-700 rounded-full flex items-center justify-center hover:bg-brand-50 hover:text-brand-600 transition-colors shadow-lg hover:scale-105" title="Download File">
                            <i class="fa-solid fa-download text-lg"></i>
                        </a>
                        
                        <a asp-action="Preview" asp-route-folder="@Model.CurrentFolder" asp-route-fileName="@file.FileName" class="w-12 h-12 bg-white text-gray-700 rounded-full flex items-center justify-center hover:bg-blue-50 hover:text-blue-600 transition-colors shadow-lg hover:scale-105" title="Preview File">
                            <i class="fa-solid fa-eye text-lg"></i>
                        </a>

                        <button type="button" onclick="openDeleteModal('@Model.CurrentFolder', '@file.FileName', '@file.DocumentId', '@file.Type')" class="w-12 h-12 bg-white text-gray-700 rounded-full flex items-center justify-center hover:bg-red-50 hover:text-red-600 transition-colors shadow-lg hover:scale-105" title="Delete File">
                            <i class="fa-solid fa-trash text-lg"></i>
                        </button>
                    </div>
                    
                </div>
            }
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="relative z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900 bg-opacity-75 transition-opacity backdrop-blur-sm"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-slate-200">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                            <i class="fa-solid fa-triangle-exclamation text-red-600"></i>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                            <h3 class="text-lg font-semibold leading-6 text-slate-900" id="modal-title">Delete File</h3>
                            <div class="mt-2">
                                <p class="text-sm text-slate-500">Are you sure you want to permanently delete <span id="modalFileName" class="font-bold text-gray-800 break-all"></span>? This action cannot be undone.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 border-t border-slate-100">
                    <form asp-action="DeletePhysicalFile" method="post" id="deleteForm">
                        <input type="hidden" name="folder" id="deleteFolder" />
                        <input type="hidden" name="fileName" id="deleteFileName" />
                        <input type="hidden" name="documentId" id="deleteDocumentId" />
                        <input type="hidden" name="type" id="deleteType" />
                        <button type="submit" class="inline-flex w-full justify-center rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto transition-colors">
                            <i class="fa-solid fa-trash mr-2 mt-0.5"></i> Delete File
                        </button>
                    </form>
                    <button type="button" onclick="closeDeleteModal()" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto transition-colors">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(folder, fileName, documentId, type) {
            document.getElementById('modalFileName').textContent = fileName;
            document.getElementById('deleteFolder').value = folder;
            document.getElementById('deleteFileName').value = fileName;
            document.getElementById('deleteDocumentId').value = documentId;
            document.getElementById('deleteType').value = type;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }
    </script>
}
