@model AzureTest.Contracts.DTOs.Food.NutritionTargetDto
@{
    ViewData["Title"] = "Weekly Meal Planner";
    var recipes = ViewBag.Recipes as List<AzureTest.Contracts.DTOs.Food.RecipeDto> ?? new();
    var days = new[] {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
    var mealTypes = new[] {
        AzureTest.Domain.Documents.Food.Enums.MealType.Breakfast,
        AzureTest.Domain.Documents.Food.Enums.MealType.Lunch,
        AzureTest.Domain.Documents.Food.Enums.MealType.Dinner
    };
    var planSlots = Model?.WeeklyPlan ?? new();
    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Food & Nutrition", Url.Action("Index")),
        new("Weekly Meal Planner", IsActive: true)
    };
}

<div class="mb-4">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
</div>

<!-- Header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-2xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                <i class="fa-solid fa-calendar-week mr-1.5"></i> Household Meal Prep
            </span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Weekly Meal Planner</h1>
        <p class="text-slate-500 text-xs mt-0.5">Schedule meals from Monday to Sunday and generate grocery requirements in one click.</p>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="@Url.Action("Index")" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 transition-colors">
            <i class="fa-solid fa-arrow-left mr-1.5 text-3xs"></i> Daily Diary
        </a>
        <button type="button" onclick="openPlanModal()" class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-xs font-semibold text-white shadow-2xs hover:bg-brand-700 transition-colors">
            <i class="fa-solid fa-plus mr-1.5 text-2xs"></i> Schedule Meal
        </button>
    </div>
</div>

<!-- Weekly Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-7 gap-4 mb-8">
    @foreach (var day in days)
    {
        var daySlots = planSlots.Where(s => s.DayOfWeek == day).ToList();

        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col justify-between">
            <div>
                <!-- Day Header -->
                <div class="p-3.5 border-b border-slate-100 bg-slate-50/70 text-center">
                    <span class="text-xs font-black uppercase tracking-wider text-slate-900">@day</span>
                </div>

                <!-- Meal Occasions -->
                <div class="p-3 space-y-3">
                    @foreach (var mt in mealTypes)
                    {
                        var slot = daySlots.FirstOrDefault(s => s.MealType == mt);

                        <div class="p-2.5 rounded-xl border border-slate-100 bg-slate-50/50">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-3xs uppercase font-bold text-slate-400">@mt</span>
                                @if (slot != null)
                                {
                                    <form asp-action="DeletePlanSlot" method="post" class="inline" onsubmit="return confirm('Clear this slot?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotId" value="@slot.Id" />
                                        <button type="submit" class="text-slate-300 hover:text-rose-600 text-3xs">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            @if (slot != null && !string.IsNullOrWhiteSpace(slot.RecipeName))
                            {
                                <div>
                                    <span class="text-xs font-bold text-slate-800 line-clamp-1">
                                        @if (slot.RecipeId.HasValue)
                                        {
                                            <a href="@Url.Action("RecipeDetails", new { id = slot.RecipeId })" class="hover:text-brand-600">@slot.RecipeName</a>
                                        }
                                        else
                                        {
                                            @slot.RecipeName
                                        }
                                    </span>
                                    <span class="text-3xs text-slate-400">@slot.Servings serv</span>
                                </div>
                            }
                            else
                            {
                                <button type="button" onclick="openPlanModalForDay('@day', '@mt')" class="w-full text-left py-1 text-3xs font-semibold text-slate-400 hover:text-brand-600 flex items-center gap-1">
                                    <i class="fa-solid fa-plus text-4xs"></i> Add dish
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Footer for Day -->
            <div class="p-2.5 bg-slate-50/40 border-t border-slate-100 text-center">
                <span class="text-3xs font-semibold text-slate-400">@daySlots.Count dishes planned</span>
            </div>
        </div>
    }
</div>

<!-- Modal: Assign Meal Plan Slot -->
<div id="planModal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl relative">
        <button type="button" onclick="closePlanModal()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>

        <h3 class="text-xl font-black text-slate-900 mb-1">Schedule Meal</h3>
        <p class="text-xs text-slate-500 mb-4">Assign a recipe to your weekly schedule.</p>

        <form asp-action="UpsertPlanSlot" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-3xs uppercase font-bold text-slate-500 mb-1">Day of Week</label>
                    <select id="modalDay" name="DayOfWeek" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500">
                        @foreach (var d in days)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-3xs uppercase font-bold text-slate-500 mb-1">Meal Occasion</label>
                    <select id="modalMeal" name="MealType" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500">
                        @foreach (var mt in mealTypes)
                        {
                            <option value="@mt">@mt</option>
                        }
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-3xs uppercase font-bold text-slate-500 mb-1">Recipe / Dish</label>
                <select id="recipeSelect" name="RecipeId" onchange="onPlanRecipeChange(this)" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500">
                    <option value="">-- Custom or Select Recipe --</option>
                    @foreach (var r in recipes.OrderBy(r => r.Name))
                    {
                        <option value="@r.Id" data-name="@r.Name" data-servings="@r.Servings">@r.Name (@r.PerServingCalories kcal)</option>
                    }
                </select>
                <input type="hidden" id="planRecipeName" name="RecipeName" value="" />
            </div>

            <div>
                <label class="block text-3xs uppercase font-bold text-slate-500 mb-1">Custom Dish Name (if not selecting recipe above)</label>
                <input type="text" id="customDishName" oninput="document.getElementById('planRecipeName').value = this.value" placeholder="e.g. Grandma's soup" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>

            <div>
                <label class="block text-3xs uppercase font-bold text-slate-500 mb-1">Servings</label>
                <input type="number" min="1" max="50" id="planServings" name="Servings" value="1" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500" required />
            </div>

            <div>
                <label class="block text-3xs uppercase font-bold text-slate-500 mb-1">Notes (Optional)</label>
                <input type="text" name="Notes" placeholder="e.g. meal prep Sunday, double portion" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-brand-500" />
            </div>

            <div class="pt-3 flex items-center justify-end gap-3">
                <button type="button" onclick="closePlanModal()" class="px-4 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-xs font-semibold text-white shadow-sm">Save to Plan</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openPlanModal() {
        document.getElementById('planModal').classList.remove('hidden');
    }
    function openPlanModalForDay(day, meal) {
        document.getElementById('modalDay').value = day;
        document.getElementById('modalMeal').value = meal;
        openPlanModal();
    }
    function closePlanModal() {
        document.getElementById('planModal').classList.add('hidden');
    }

    function onPlanRecipeChange(sel) {
        const opt = sel.options[sel.selectedIndex];
        if (opt && opt.dataset.name) {
            document.getElementById('planRecipeName').value = opt.dataset.name;
            document.getElementById('customDishName').value = opt.dataset.name;
            if (opt.dataset.servings) {
                document.getElementById('planServings').value = opt.dataset.servings;
            }
        }
    }
</script>
}
