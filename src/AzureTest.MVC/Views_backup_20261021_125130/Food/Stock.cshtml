@using AzureTest.Contracts.DTOs.Common
@using AzureTest.Contracts.DTOs.Food
@using AzureTest.Domain.Documents.Food.Enums
@model PagedResult<PantryStockItemDto, StockFilter>
@{
    ViewData["Title"] = "Pantry & Stock Management";
    var overview = ViewBag.Overview as StockInventoryOverviewDto;
    var filter = ViewBag.Filter as StockFilter ?? new StockFilter();
    var ingredients = ViewBag.IngredientsList as List<IngredientDto> ?? new List<IngredientDto>();
    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new("Dashboard", "/"),
        new("Food & Nutrition", Url.Action("Index")),
        new("Pantry & Stock", IsActive: true)
    };
}

<div class="space-y-6">
    <!-- Breadcrumbs & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="mb-2">
                <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                <i class="fa-solid fa-boxes-stacked text-brand-600"></i>
                Pantry & Stock Inventory
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Real-time household stock with FEFO batch depletion, reorder par levels, and movement ledger.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <a asp-action="Movements" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-2xs">
                <i class="fa-solid fa-receipt text-slate-400"></i>
                Movement Ledger
            </a>
            <a asp-action="ShoppingList" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-2xs">
                <i class="fa-solid fa-cart-shopping text-brand-600"></i>
                Shopping List
            </a>
            <button type="button" onclick="openAddStockModal()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 text-xs font-semibold text-white hover:bg-brand-700 shadow-sm transition-colors">
                <i class="fa-solid fa-plus"></i>
                Add Stock Item
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center gap-3 text-emerald-800 text-xs font-medium">
            <i class="fa-solid fa-circle-check text-emerald-600"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-3.5 bg-rose-50 border border-rose-200 rounded-xl flex items-center gap-3 text-rose-800 text-xs font-medium">
            <i class="fa-solid fa-circle-exclamation text-rose-600"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Key Inventory KPI Metrics -->
    @if (overview != null)
    {
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-3.5">
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-slate-400 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Active Lots</span>
                    <i class="fa-solid fa-layer-group text-slate-300"></i>
                </div>
                <div class="text-2xl font-black text-slate-900">@overview.TotalItems</div>
                <span class="text-3xs text-slate-400">Distinct inventory batches</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-amber-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Below Par Level</span>
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="text-2xl font-black text-amber-600">@overview.LowStockCount</div>
                <span class="text-3xs text-slate-400">Needs restock soon</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-indigo-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Expiring Soon</span>
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="text-2xl font-black text-indigo-600">@overview.ExpiringSoonCount</div>
                <span class="text-3xs text-slate-400">Next 3 days (FEFO)</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-rose-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Expired</span>
                    <i class="fa-solid fa-ban"></i>
                </div>
                <div class="text-2xl font-black text-rose-600">@overview.ExpiredCount</div>
                <span class="text-3xs text-slate-400">Check or log waste</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs">
                <div class="flex items-center justify-between text-emerald-500 mb-1">
                    <span class="text-2xs font-bold uppercase tracking-wider">Total Value</span>
                    <i class="fa-solid fa-coins"></i>
                </div>
                <div class="text-2xl font-black text-emerald-600">$@overview.TotalEstimatedValue.ToString("N2")</div>
                <span class="text-3xs text-slate-400">Estimated pantry worth</span>
            </div>
        </div>
    }

    <!-- Filter & Location Tabs -->
    <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-2xs space-y-4">
        <!-- Location Tabs -->
        <div class="flex flex-wrap items-center gap-1.5 border-b border-slate-100 pb-3">
            <a asp-action="Stock" asp-route-location="" asp-route-onlyLowStock="@filter.OnlyLowStock" asp-route-onlyExpiringSoon="@filter.OnlyExpiringSoon" asp-route-onlyStaples="@filter.OnlyStaples" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-colors @(!filter.Location.HasValue ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                <i class="fa-solid fa-border-all mr-1"></i> All Locations
            </a>
            @foreach (StockLocation loc in Enum.GetValues(typeof(StockLocation)))
            {
                var iconClass = loc switch
                {
                    StockLocation.Fridge => "fa-temperature-half text-cyan-500",
                    StockLocation.Freezer => "fa-snowflake text-blue-500",
                    StockLocation.Pantry => "fa-box-archive text-amber-600",
                    StockLocation.SpiceRack => "fa-pepper-hot text-rose-500",
                    StockLocation.Cellar => "fa-wine-bottle text-purple-500",
                    _ => "fa-box text-slate-400"
                };

                <a asp-action="Stock" asp-route-location="@loc" asp-route-onlyLowStock="@filter.OnlyLowStock" asp-route-onlyExpiringSoon="@filter.OnlyExpiringSoon" asp-route-onlyStaples="@filter.OnlyStaples" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-colors @(filter.Location == loc ? "bg-brand-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                    <i class="fa-solid @iconClass mr-1"></i> @loc
                </a>
            }
        </div>

        <!-- Quick Filters & Search -->
        <form method="get" asp-action="Stock" class="flex flex-wrap items-center justify-between gap-3">
            @if (filter.Location.HasValue)
            {
                <input type="hidden" name="Location" value="@filter.Location.Value" />
            }

            <div class="flex flex-wrap items-center gap-2">
                <a asp-action="Stock" asp-route-location="@filter.Location" asp-route-onlyLowStock="@(!filter.OnlyLowStock)" asp-route-onlyExpiringSoon="@filter.OnlyExpiringSoon" asp-route-onlyStaples="@filter.OnlyStaples" asp-route-searchTerm="@filter.SearchTerm" class="px-3 py-1.5 rounded-xl text-2xs font-bold border transition-colors @(filter.OnlyLowStock ? "bg-amber-50 border-amber-300 text-amber-700" : "border-slate-200 text-slate-600 hover:bg-slate-50")">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i> Low Stock
                </a>
                <a asp-action="Stock" asp-route-location="@filter.Location" asp-route-onlyLowStock="@filter.OnlyLowStock" asp-route-onlyExpiringSoon="@(!filter.OnlyExpiringSoon)" asp-route-onlyStaples="@filter.OnlyStaples" asp-route-searchTerm="@filter.SearchTerm" class="px-3 py-1.5 rounded-xl text-2xs font-bold border transition-colors @(filter.OnlyExpiringSoon ? "bg-indigo-50 border-indigo-300 text-indigo-700" : "border-slate-200 text-slate-600 hover:bg-slate-50")">
                    <i class="fa-solid fa-clock mr-1"></i> Expiring Soon
                </a>
                <a asp-action="Stock" asp-route-location="@filter.Location" asp-route-onlyLowStock="@filter.OnlyLowStock" asp-route-onlyExpiringSoon="@filter.OnlyExpiringSoon" asp-route-onlyStaples="@(!filter.OnlyStaples)" asp-route-searchTerm="@filter.SearchTerm" class="px-3 py-1.5 rounded-xl text-2xs font-bold border transition-colors @(filter.OnlyStaples ? "bg-purple-50 border-purple-300 text-purple-700" : "border-slate-200 text-slate-600 hover:bg-slate-50")">
                    <i class="fa-solid fa-jar mr-1"></i> Staples Only
                </a>
                <a asp-action="Stock" asp-route-location="@filter.Location" asp-route-includeDepleted="@(!filter.IncludeDepleted)" asp-route-searchTerm="@filter.SearchTerm" class="px-3 py-1.5 rounded-xl text-2xs font-bold border transition-colors @(filter.IncludeDepleted ? "bg-slate-800 border-slate-800 text-white" : "border-slate-200 text-slate-600 hover:bg-slate-50")">
                    <i class="fa-solid fa-box-open mr-1"></i> Show Depleted
                </a>
            </div>

            <div class="relative min-w-[240px]">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="SearchTerm" value="@filter.SearchTerm" placeholder="Search ingredient or batch..." class="w-full pl-9 pr-3.5 py-1.5 rounded-xl border border-slate-200 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>
        </form>
    </div>

    <!-- Stock Inventory Items Table -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-slate-400 uppercase font-bold text-3xs tracking-wider">
                        <th class="py-3.5 px-4">Item & Batch</th>
                        <th class="py-3.5 px-4">Location</th>
                        <th class="py-3.5 px-4">Quantity / Par</th>
                        <th class="py-3.5 px-4">Expiry Date</th>
                        <th class="py-3.5 px-4">Unit Price</th>
                        <th class="py-3.5 px-4 text-right">Quick Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (Model != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/70 transition-colors @(item.NeedsRestockReconciliation ? "bg-rose-50/30" : "")">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-xs shrink-0">
                                            @item.IngredientName.Substring(0, Math.Min(2, item.IngredientName.Length)).ToUpperInvariant()
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-900 flex items-center gap-2">
                                                @item.IngredientName
                                                @if (item.IsStaple)
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-3xs font-bold bg-purple-100 text-purple-700">Staple</span>
                                                }
                                                @if (item.NeedsRestockReconciliation)
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-3xs font-bold bg-rose-100 text-rose-700" title="Consumed without purchase record">
                                                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> Reconciliation Needed
                                                    </span>
                                                }
                                            </div>
                                            <span class="text-3xs text-slate-400 font-mono">
                                                @(string.IsNullOrWhiteSpace(item.BatchCode) ? $"Lot #{item.Id.ToString().Substring(0, 8)}" : item.BatchCode)
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3 px-4">
                                    @{
                                        var locColor = item.Location switch
                                        {
                                            StockLocation.Fridge => "bg-cyan-50 text-cyan-700 border-cyan-200",
                                            StockLocation.Freezer => "bg-blue-50 text-blue-700 border-blue-200",
                                            StockLocation.Pantry => "bg-amber-50 text-amber-700 border-amber-200",
                                            StockLocation.SpiceRack => "bg-rose-50 text-rose-700 border-rose-200",
                                            _ => "bg-slate-50 text-slate-700 border-slate-200"
                                        };
                                    }
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-2xs font-semibold border @locColor">
                                        @item.Location
                                    </span>
                                </td>

                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono font-bold text-sm @(item.CurrentQuantity < 0 ? "text-rose-600 font-black" : item.IsBelowParLevel ? "text-amber-600" : "text-slate-900")">
                                            @item.CurrentQuantity @item.Unit
                                        </span>
                                        @if (item.MinimumParLevel.HasValue)
                                        {
                                            <span class="text-3xs text-slate-400 font-mono" title="Reorder Point">
                                                (Par: @item.MinimumParLevel.Value @item.Unit)
                                            </span>
                                        }
                                    </div>
                                    @if (item.IsStaple)
                                    {
                                        <div class="mt-0.5">
                                            @{
                                                var stapleColor = item.StapleStatus switch
                                                {
                                                    StapleStatus.InStock => "text-emerald-600",
                                                    StapleStatus.Low => "text-amber-600",
                                                    StapleStatus.OutOfStock => "text-rose-600",
                                                    _ => "text-slate-400"
                                                };
                                            }
                                            <span class="text-3xs font-semibold @stapleColor flex items-center gap-1">
                                                <i class="fa-solid fa-circle text-4xs"></i> @item.StapleStatus
                                            </span>
                                        </div>
                                    }
                                </td>

                                <td class="py-3 px-4">
                                    @if (item.ExpiryDate.HasValue)
                                    {
                                        if (item.IsExpired)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-3xs font-bold bg-rose-100 text-rose-800">
                                                <i class="fa-solid fa-circle-xmark"></i> Expired (@item.ExpiryDate.Value.ToString("MMM dd"))
                                            </span>
                                        }
                                        else if (item.IsExpiringSoon)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg text-3xs font-bold bg-amber-100 text-amber-800">
                                                <i class="fa-solid fa-clock"></i> In @item.DaysUntilExpiry d (@item.ExpiryDate.Value.ToString("MMM dd"))
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-mono text-slate-600">
                                                @item.ExpiryDate.Value.ToString("yyyy-MM-dd")
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-2xs italic">No expiry</span>
                                    }
                                </td>

                                <td class="py-3 px-4 font-mono text-slate-600">
                                    @(item.UnitPrice.HasValue ? $"${item.UnitPrice.Value:N2}/{item.Unit}" : "-")
                                </td>

                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Quick Adjust -->
                                        <button type="button" onclick="openAdjustModal('@item.Id', '@item.IngredientName', @item.CurrentQuantity, '@item.Unit')" class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-100 rounded-lg transition-colors" title="Adjust Balance">
                                            <i class="fa-solid fa-sliders"></i>
                                        </button>
                                        <!-- Transfer Location -->
                                        <button type="button" onclick="openTransferModal('@item.Id', '@item.IngredientName', '@item.Location')" class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-100 rounded-lg transition-colors" title="Transfer Location">
                                            <i class="fa-solid fa-right-left"></i>
                                        </button>
                                        <!-- Log Waste -->
                                        <button type="button" onclick="openWasteModal('@item.Id', '@item.IngredientName', @item.CurrentQuantity, '@item.Unit', @(item.UnitPrice ?? 0))" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Log Waste">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                        <!-- Delete -->
                                        <form asp-action="DeleteStockItem" method="post" class="inline" onsubmit="return confirm('Remove @item.IngredientName from stock?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="stockItemId" value="@item.Id" />
                                            <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors bg-transparent border-0 cursor-pointer" title="Delete">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <i class="fa-solid fa-boxes-stacked text-3xl mb-2 text-slate-300 block"></i>
                                <span class="text-sm font-semibold text-slate-600 block">No pantry items found</span>
                                <span class="text-2xs text-slate-400">Add an ingredient or finish a shopping trip to stock your kitchen.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================== MODALS ======================== -->

<!-- Add Stock Modal -->
<div id="addStockModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-plus text-brand-600"></i> Add Stock Lot
            </h3>
            <button type="button" onclick="closeAddStockModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form asp-action="AddStockItem" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Catalog Ingredient</label>
                <select name="IngredientId" class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required>
                    <option value="">-- Choose Ingredient --</option>
                    @foreach (var ing in ingredients.OrderBy(i => i.Name))
                    {
                        <option value="@ing.Id">@ing.Name (@ing.Category) - Unit: @ing.DefaultUnit</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Quantity</label>
                    <input type="number" step="any" min="0.01" name="Quantity" value="1" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Unit</label>
                    <input type="text" name="Unit" value="g" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Location</label>
                    <select name="Location" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                        @foreach (StockLocation loc in Enum.GetValues(typeof(StockLocation)))
                        {
                            <option value="@loc">@loc</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Expiry Date</label>
                    <input type="date" name="ExpiryDate" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Unit Price ($)</label>
                    <input type="number" step="0.01" min="0" name="UnitPrice" placeholder="e.g. 2.50" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Min Par Level</label>
                    <input type="number" step="any" min="0" name="MinimumParLevel" placeholder="Reorder point" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                </div>
            </div>

            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-800 block">Kitchen Staple</span>
                    <span class="text-2xs text-slate-500">Qualitative status tracking (e.g. salt, spices, cooking oil)</span>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="IsStaple" value="true" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                </label>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeAddStockModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white">Save Item</button>
            </div>
        </form>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div id="adjustModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-slate-900">Adjust Physical Stock</h3>
            <button type="button" onclick="closeAdjustModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-action="AdjustStock" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="adjustStockItemId" name="StockItemId" value="" />

            <div>
                <span class="text-xs text-slate-500 block mb-1">Item: <strong id="adjustItemName" class="text-slate-900"></strong></span>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">New Physical Count</label>
                <div class="flex items-center gap-2">
                    <input type="number" step="any" id="adjustNewQuantity" name="NewQuantity" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                    <span id="adjustUnit" class="text-xs font-bold text-slate-500"></span>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Reason / Notes</label>
                <input type="text" name="Reason" placeholder="e.g. Periodic pantry audit, recount" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeAdjustModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white">Save Correction</button>
            </div>
        </form>
    </div>
</div>

<!-- Transfer Location Modal -->
<div id="transferModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-slate-900">Transfer Item Location</h3>
            <button type="button" onclick="closeTransferModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-action="TransferStock" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="transferStockItemId" name="StockItemId" value="" />

            <div>
                <span class="text-xs text-slate-500 block mb-1">Moving: <strong id="transferItemName" class="text-slate-900"></strong></span>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Target Location</label>
                <select id="transferNewLocation" name="NewLocation" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                    @foreach (StockLocation loc in Enum.GetValues(typeof(StockLocation)))
                    {
                        <option value="@loc">@loc</option>
                    }
                </select>
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeTransferModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-xs font-semibold text-white">Transfer</button>
            </div>
        </form>
    </div>
</div>

<!-- Log Waste Modal -->
<div id="wasteModal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="text-base font-black text-rose-600 flex items-center gap-2">
                <i class="fa-solid fa-trash-can"></i> Log Food Waste
            </h3>
            <button type="button" onclick="closeWasteModal()" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-action="LogWaste" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="wasteStockItemId" name="StockItemId" value="" />

            <div>
                <span class="text-xs text-slate-500 block mb-1">Item: <strong id="wasteItemName" class="text-slate-900"></strong></span>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Wasted Quantity</label>
                <div class="flex items-center gap-2">
                    <input type="number" step="any" min="0.01" id="wasteQuantity" name="Quantity" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                    <span id="wasteUnit" class="text-xs font-bold text-slate-500"></span>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Reason</label>
                <select name="Reason" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500">
                    @foreach (WasteReason r in Enum.GetValues(typeof(WasteReason)))
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Estimated Cost Lost ($)</label>
                <input type="number" step="0.01" min="0" id="wasteCost" name="EstimatedCost" placeholder="Optional" class="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>

            <div class="pt-2 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeWasteModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-xs font-semibold text-white">Record Waste</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openAddStockModal() {
        document.getElementById('addStockModal').classList.remove('hidden');
    }
    function closeAddStockModal() {
        document.getElementById('addStockModal').classList.add('hidden');
    }

    function openAdjustModal(id, name, qty, unit) {
        document.getElementById('adjustStockItemId').value = id;
        document.getElementById('adjustItemName').innerText = name;
        document.getElementById('adjustNewQuantity').value = qty;
        document.getElementById('adjustUnit').innerText = unit;
        document.getElementById('adjustModal').classList.remove('hidden');
    }
    function closeAdjustModal() {
        document.getElementById('adjustModal').classList.add('hidden');
    }

    function openTransferModal(id, name, currentLoc) {
        document.getElementById('transferStockItemId').value = id;
        document.getElementById('transferItemName').innerText = name;
        document.getElementById('transferNewLocation').value = currentLoc;
        document.getElementById('transferModal').classList.remove('hidden');
    }
    function closeTransferModal() {
        document.getElementById('transferModal').classList.add('hidden');
    }

    function openWasteModal(id, name, qty, unit, unitPrice) {
        document.getElementById('wasteStockItemId').value = id;
        document.getElementById('wasteItemName').innerText = name;
        document.getElementById('wasteQuantity').value = qty;
        document.getElementById('wasteUnit').innerText = unit;
        if (unitPrice > 0) {
            document.getElementById('wasteCost').value = (qty * unitPrice).toFixed(2);
        }
        document.getElementById('wasteModal').classList.remove('hidden');
    }
    function closeWasteModal() {
        document.getElementById('wasteModal').classList.add('hidden');
    }
</script>
}
