@using AzureTest.MVC.Models
@model IEnumerable<AzureTest.Domain.Documents.UserDashboard>
@{
    ViewData["Title"] = "Manage Dashboards";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Manage Dashboards", null, "fa-solid fa-layer-group", true)
    };

    var headerModel = new PageHeaderModel(
        "My Custom Dashboards",
        "Create, arrange, and manage your personalized analytics workspaces.",
        "fa-solid fa-layer-group",
        new HeaderAction("New Dashboard", Url.Action("Builder"), "fa-solid fa-plus", "primary")
    );
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-7xl space-y-6">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
                <i class="fa-solid fa-layer-group text-brand-600"></i> My Dashboards
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Create and manage your tailored analytics layouts and widgets.</p>
        </div>
        <div class="flex items-center gap-2.5">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Component" asp-action="Index"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl shadow-xs transition"
                   title="Manage Standard & Dynamic Components">
                    <i class="fa-solid fa-puzzle-piece text-slate-500"></i> Components
                </a>
            }
            <a asp-action="Builder"
               class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition">
                <i class="fa-solid fa-plus"></i> New Dashboard
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        var emptyModel = new EmptyStateModel(
            "No Custom Dashboards Yet",
            "Build your first custom dashboard with drag-and-drop widgets tailored to your workflows.",
            "fa-solid fa-border-all",
            new HeaderAction("Create First Dashboard", Url.Action("Builder"), "fa-solid fa-plus", "primary")
        );
        <partial name="UiComponents/_EmptyState" model="emptyModel" />
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var dashboard in Model)
            {
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-all duration-300 relative group">
                    <div class="p-6 flex-1 space-y-4">
                        <div class="flex justify-between items-start">
                            <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl shrink-0">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <form asp-action="Delete" method="post" class="opacity-0 group-hover:opacity-100 transition-opacity" onsubmit="return confirm('Are you sure you want to delete this dashboard?');">
                                <input type="hidden" name="id" value="@dashboard.Id" />
                                <button type="submit" class="p-2 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition" title="Delete Dashboard">
                                    <i class="fa-solid fa-trash text-xs"></i>
                                </button>
                            </form>
                        </div>

                        <div>
                            <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-600 transition-colors">@dashboard.Name</h3>
                            <div class="flex items-center text-xs text-slate-500 mt-1">
                                <i class="fa-solid fa-link text-slate-400 mr-1.5 text-[11px]"></i>
                                <span class="font-mono">/@dashboard.Slug</span>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-2 pt-1">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                                @dashboard.Sections.Count sections
                            </span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                                @dashboard.Sections.Sum(s => s.Components.Count) widgets
                            </span>
                        </div>
                    </div>

                    <div class="bg-slate-50/70 border-t border-slate-100 px-6 py-3 flex justify-between items-center text-xs">
                        <div class="flex items-center gap-3">
                            <a href="/@dashboard.Slug" class="font-semibold text-slate-700 hover:text-brand-600 inline-flex items-center gap-1 transition">
                                <i class="fa-solid fa-eye text-slate-400"></i> View
                            </a>
                            <a asp-action="Builder" asp-route-slug="@dashboard.Slug" class="font-semibold text-brand-700 hover:text-brand-800 inline-flex items-center gap-1 transition">
                                <i class="fa-solid fa-pen text-brand-600"></i> Edit
                            </a>
                        </div>
                        <div>
                            @if (ViewBag.PreferredDashboard == dashboard.Slug)
                            {
                                <form asp-action="SetDefault" method="post" class="inline">
                                    <input type="hidden" name="slug" value="" />
                                    <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-rose-50 hover:text-rose-700 hover:border-rose-200 transition" title="Clear Default">
                                        <i class="fa-solid fa-star text-[10px]"></i> Default
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="SetDefault" method="post" class="inline">
                                    <input type="hidden" name="slug" value="@dashboard.Slug" />
                                    <button type="submit" class="font-semibold text-slate-400 hover:text-brand-600 transition">
                                        Set as Default
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
