@using AzureTest.Contracts.DTOs.IdeaTracker
@using AzureTest.Domain.Documents
@using AzureTest.Domain.Enums
@using AzureTest.MVC.Models
@model IdeaDto
@{
    ViewData["Title"] = Model.Title;
    var subPages = ViewBag.SubPages as List<IdeaDto> ?? new List<IdeaDto>();
    var ideaPages = ViewBag.Pages as List<IdeaPageDto> ?? new List<IdeaPageDto>();

    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Idea Tracker", Url.Action("Index"), "fa-solid fa-brain"),
        new BreadcrumbItem(Model.Title, null, Model.Icon ?? "fa-solid fa-lightbulb", true)
    };
}

<div class="min-h-[calc(100vh-4rem)] flex flex-col bg-slate-50/50">
    <div class="px-4 sm:px-6 lg:px-8 pt-6 pb-2 mx-auto max-w-7xl w-full">
        <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
    </div>

    <!-- Cover Banner -->
    <div class="h-60 md:h-72 w-full relative shrink-0 bg-slate-800"
         style="@(string.IsNullOrEmpty(Model.CoverImage) && !string.IsNullOrEmpty(Model.ThemeColor) ? $"background: linear-gradient(135deg, {Model.ThemeColor} 0%, rgba(15,23,42,0.85) 100%);" : "")">
        @if (!string.IsNullOrEmpty(Model.CoverImage))
        {
            <img src="@Model.CoverImage" alt="Cover" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-black/20"></div>
        }

        <!-- Actions Overlay -->
        <div class="absolute top-4 right-4 flex items-center gap-2">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/90 hover:bg-white text-slate-800 rounded-xl shadow-sm text-xs font-semibold transition backdrop-blur-sm">
                <i class="fa-solid fa-brain text-brand-600"></i> Workspace
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/90 hover:bg-white text-slate-800 rounded-xl shadow-sm text-xs font-semibold transition backdrop-blur-sm">
                <i class="fa-solid fa-pen text-slate-600"></i> Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this idea?');" class="inline">
                <button type="submit" class="inline-flex items-center justify-center w-8 h-8 bg-rose-600/90 hover:bg-rose-600 text-white rounded-xl shadow-sm text-xs transition backdrop-blur-sm" title="Delete Idea">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </form>
        </div>
    </div>

    <div class="flex-1 flex max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pb-20 relative">
        <!-- Main Content Area -->
        <div class="flex-1 max-w-4xl pt-1">
            <!-- Floating Big Icon -->
            <div class="-mt-14 mb-6 relative z-10 flex items-end justify-between">
                <div class="w-24 h-24 sm:w-28 sm:h-28 bg-white rounded-2xl shadow-xl border border-slate-200/80 flex items-center justify-center text-5xl text-brand-600">
                    <i class="@(string.IsNullOrEmpty(Model.Icon) ? "fa-solid fa-lightbulb" : Model.Icon)"></i>
                </div>
            </div>

            <!-- Header Info -->
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">@Model.Title</h1>

            <div class="flex flex-wrap items-center gap-3 mb-8 pb-6 border-b border-slate-200/80">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-slate-100 text-xs font-semibold text-slate-700">
                    <span class="text-slate-400">Status:</span>
                    <span class="text-brand-700">@(((IdeaStatus)Model.Status).ToString())</span>
                </div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-slate-100 text-xs font-semibold text-slate-700">
                    <span class="text-slate-400">Priority:</span>
                    <span>@(((IdeaPriority)Model.Priority).ToString())</span>
                </div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-slate-100 text-xs font-semibold text-slate-700">
                    <i class="fa-regular fa-calendar text-slate-400"></i>
                    <span>@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>

            <!-- Content Area -->
            <div id="content-container" class="prose prose-slate prose-img:rounded-2xl prose-img:shadow-sm max-w-none bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm mb-10">
                @Html.Raw(Model.Content)
            </div>

            <!-- Document Pages Section -->
            <div class="mt-10 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-regular fa-file-lines text-brand-600"></i> Document Pages
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">Extended documentation, specs, and modules.</p>
                    </div>
                    <a asp-controller="IdeaPage" asp-action="Create" asp-route-ideaId="@Model.Id"
                       class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-700 rounded-xl text-xs font-semibold transition border border-brand-200/60">
                        <i class="fa-solid fa-plus"></i> Add Page
                    </a>
                </div>

                @if (ideaPages.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var pageDto in ideaPages)
                        {
                            <div class="flex items-center p-3.5 rounded-xl border border-slate-200/80 hover:border-brand-300 hover:shadow-md transition bg-slate-50/70 group">
                                <div class="w-10 h-10 rounded-xl bg-white shadow-sm flex items-center justify-center text-base mr-3 shrink-0 text-slate-500 group-hover:text-brand-600">
                                    <i class="fa-regular fa-file"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <a asp-controller="IdeaPage" asp-action="Details" asp-route-id="@pageDto.Id" class="font-bold text-sm text-slate-800 truncate hover:text-brand-600 block">
                                        @pageDto.Title
                                    </a>
                                </div>
                                <div class="ml-2 flex items-center gap-1.5">
                                    <a asp-controller="IdeaPage" asp-action="Edit" asp-route-id="@pageDto.Id" class="p-1.5 text-slate-400 hover:text-brand-600 transition" title="Edit">
                                        <i class="fa-solid fa-pen text-xs"></i>
                                    </a>
                                    <form asp-controller="IdeaPage" asp-action="Delete" asp-route-id="@pageDto.Id" asp-route-ideaId="@Model.Id" method="post" onsubmit="return confirm('Delete this page?');" class="inline">
                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 transition" title="Delete">
                                            <i class="fa-solid fa-trash text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 px-4 rounded-xl border border-dashed border-slate-200 bg-slate-50/50">
                        <i class="fa-regular fa-file-lines text-slate-300 text-3xl mb-2 block"></i>
                        <p class="text-xs text-slate-500 font-medium">No document pages attached to this idea yet.</p>
                    </div>
                }
            </div>

            <!-- Sub-Ideas Section -->
            <div class="mt-8 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-sm">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-regular fa-folder-open text-brand-600"></i> Sub-Ideas
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">Nested branches and connected initiatives.</p>
                    </div>
                    <a asp-action="Create" asp-route-parentId="@Model.Id"
                       class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-brand-50 hover:bg-brand-100 text-brand-700 rounded-xl text-xs font-semibold transition border border-brand-200/60">
                        <i class="fa-solid fa-plus"></i> Add Sub-Idea
                    </a>
                </div>

                @if (subPages.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var subPage in subPages)
                        {
                            <a asp-action="Details" asp-route-id="@subPage.Id"
                               class="flex items-center p-3.5 rounded-xl border border-slate-200/80 hover:border-brand-300 hover:shadow-md transition bg-slate-50/70 group">
                                <div class="w-10 h-10 rounded-xl bg-white shadow-sm flex items-center justify-center text-base mr-3 shrink-0 text-brand-600">
                                    <i class="@(string.IsNullOrEmpty(subPage.Icon) ? "fa-solid fa-lightbulb" : subPage.Icon)"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-bold text-sm text-slate-800 truncate group-hover:text-brand-600">@subPage.Title</h4>
                                    <p class="text-xs text-slate-500">@(((IdeaStatus)subPage.Status).ToString())</p>
                                </div>
                                <i class="fa-solid fa-chevron-right text-slate-300 text-xs ml-2 group-hover:text-brand-600 group-hover:translate-x-0.5 transition-all"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 px-4 rounded-xl border border-dashed border-slate-200 bg-slate-50/50">
                        <i class="fa-regular fa-folder-open text-slate-300 text-3xl mb-2 block"></i>
                        <p class="text-xs text-slate-500 font-medium">No sub-ideas linked yet.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Sticky Table of Contents (Right Sidebar) -->
        <div class="hidden xl:block w-64 shrink-0 pl-10 pt-10">
            <div class="sticky top-8 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-list-ul text-slate-400"></i> Table of Contents
                </h4>
                <nav id="toc-container" class="space-y-1 text-xs text-slate-600 border-l border-slate-200 pl-3">
                    <!-- Populated dynamically via JS -->
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            buildTableOfContents();

            function buildTableOfContents() {
                const tocContainer = document.getElementById('toc-container');
                const contentContainer = document.getElementById('content-container');
                const headers = contentContainer.querySelectorAll('h1, h2, h3, h4');

                if (headers.length === 0) {
                    tocContainer.innerHTML = '<p class="text-xs text-slate-400 italic">No headings found in content.</p>';
                    return;
                }

                headers.forEach((header, index) => {
                    if (!header.id) {
                        header.id = 'heading-' + index;
                    }

                    const a = document.createElement('a');
                    a.href = '#' + header.id;
                    a.textContent = header.textContent;
                    a.className = 'block py-1 hover:text-brand-600 transition-colors truncate font-medium';

                    const level = parseInt(header.tagName.substring(1));
                    if (level === 3) a.classList.add('ml-2');
                    if (level === 4) a.classList.add('ml-4');

                    tocContainer.appendChild(a);
                });
            }
        });
    </script>
}
