@using AzureTest.MVC.Models
@using AzureTest.Domain.Enums
@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.Pages.PageDto, AzureTest.Application.Pages.PageFilter>
@{
    ViewData["Title"] = "Manage Pages";
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Pages", null, "fa-regular fa-file-lines", true)
    };

    var headerModel = new PageHeaderModel(
        "Manage CMS Pages",
        "Create, publish, and maintain custom content pages across your site.",
        "fa-regular fa-file-lines",
        new HeaderAction("Add New Page", Url.Action("Create"), "fa-solid fa-plus", "primary")
    );
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-7xl space-y-6">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <!-- Filter Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
        <form method="get" class="flex flex-col sm:flex-row gap-4 items-end">
            <div class="flex-1 w-full">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Search Pages</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search pages by title or slug..."
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" />
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit"
                        class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition-all duration-200">
                    <i class="fa-solid fa-filter"></i> Search
                </button>
                <a asp-action="Index"
                   class="inline-flex items-center justify-center p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-800 rounded-xl transition-all"
                   title="Clear Filter">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Table Container -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-slate-50/80 border-b border-slate-200 text-slate-500 text-xs font-semibold uppercase tracking-wider">
                    <tr>
                        <th scope="col" class="px-6 py-4">Title</th>
                        <th scope="col" class="px-6 py-4">Slug Route</th>
                        <th scope="col" class="px-6 py-4">Status</th>
                        <th scope="col" class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var p in Model.Items)
                    {
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="px-6 py-4 font-semibold text-slate-900">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center text-sm shrink-0">
                                        <i class="fa-regular fa-file"></i>
                                    </div>
                                    <span>@p.Title</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 border border-slate-200">
                                    /Page/@p.Slug
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                @if (p.Status == PageStatus.Published)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <i class="fa-solid fa-check text-[10px]"></i> Published
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                                        <i class="fa-regular fa-clock text-[10px]"></i> @p.Status
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="@Url.Action("Read", new { slug = p.Slug })" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition" target="_blank">
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> View
                                </a>
                                <a href="@Url.Action("Edit", new { id = p.Id })" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800 bg-brand-50 hover:bg-brand-100 rounded-lg transition">
                                    <i class="fa-solid fa-pen text-[10px]"></i> Edit
                                </a>
                                <form method="post" action="@Url.Action("Delete", new { id = p.Id })" class="inline" onsubmit="return confirm('Delete this page?');">
                                    <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 rounded-lg transition">
                                        <i class="fa-solid fa-trash text-[10px]"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-500">
                                <i class="fa-regular fa-file-lines text-3xl mb-2 text-slate-300 block"></i>
                                <p class="text-sm font-semibold text-slate-800">No CMS pages found</p>
                                <p class="text-xs text-slate-400 mt-1">Get started by creating a new content page.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            var paginationModel = new PaginationModel(
                Model.PageNumber,
                Model.TotalPages,
                Model.PageSize,
                Model.TotalCount,
                p => Url.Action("Index", new { page = p, search = ViewBag.Search }) ?? $"#page={p}"
            );
            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                <partial name="UiComponents/_Pagination" model="paginationModel" />
            </div>
        }
    </div>
</div>
