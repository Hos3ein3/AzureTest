@model IReadOnlyList<AzureTest.MVC.Models.BreadcrumbItem>

@if (Model != null && Model.Any())
{
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-4 flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="inline-flex items-center gap-1.5 text-slate-600 hover:text-brand-600 transition-colors font-medium">
            <i class="fa-solid fa-house text-2xs text-slate-400"></i>
            <span>Home</span>
        </a>

        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var isLast = i == Model.Count - 1 || item.IsActive;

            <i class="fa-solid fa-chevron-right text-3xs text-slate-300"></i>

            if (isLast || string.IsNullOrWhiteSpace(item.Url))
            {
                <span class="text-slate-900 font-bold bg-slate-100 px-2 py-0.5 rounded-md flex items-center gap-1.5" aria-current="page">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <i class="@item.Icon text-2xs text-brand-600"></i>
                    }
                    <span>@item.Label</span>
                </span>
            }
            else
            {
                <a href="@item.Url" class="inline-flex items-center gap-1.5 text-slate-600 hover:text-brand-600 transition-colors font-medium">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <i class="@item.Icon text-2xs text-slate-400"></i>
                    }
                    <span>@item.Label</span>
                </a>
            }
        }
    </nav>
}
