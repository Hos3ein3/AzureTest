@model AzureTest.MVC.Models.PageHeaderModel

@if (Model != null)
{
    @if (Model.Breadcrumbs != null && Model.Breadcrumbs.Any())
    {
        <partial name="UiComponents/_Breadcrumb" model="Model.Breadcrumbs" />
    }

    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(Model.Icon))
                {
                    <div class="w-11 h-11 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-lg shadow-2xs shrink-0">
                        <i class="@Model.Icon"></i>
                    </div>
                }
                <div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                        <span>@Model.Title</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Badge))
                        {
                            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-100 text-brand-700">@Model.Badge</span>
                        }
                    </h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                    {
                        <p class="text-xs text-slate-500 mt-0.5">@Model.Subtitle</p>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
        {
            <div class="flex items-center gap-2.5">
                <a href="@Model.ActionUrl" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-sm transition-colors">
                    @if (!string.IsNullOrWhiteSpace(Model.ActionIcon))
                    {
                        <i class="@Model.ActionIcon text-2xs"></i>
                    }
                    <span>@Model.ActionText</span>
                </a>
            </div>
        }
    </div>
}
