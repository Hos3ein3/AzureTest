@model AzureTest.MVC.Models.HomeDashboardViewModel

@{
    var bmi = Model.CurrentBmi ?? 0;
    string bmiBadgeClass = "bg-slate-100 text-slate-700";
    if (bmi > 0)
    {
        if (bmi < 18.5) bmiBadgeClass = "bg-amber-100 text-amber-800 border-amber-200";
        else if (bmi < 25.0) bmiBadgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
        else if (bmi < 30.0) bmiBadgeClass = "bg-orange-100 text-orange-800 border-orange-200";
        else bmiBadgeClass = "bg-rose-100 text-rose-800 border-rose-200";
    }
}

<!-- Health, Weight & BMI Telemetry Widget -->
<div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 p-6 flex flex-col justify-between hover:border-slate-300 transition-all col-span-1 lg:col-span-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900 tracking-tight">Health, Weight & BMI Metrics</h3>
                <p class="text-xs text-slate-500">Body composition, weight logs, and fitness telemetry</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Workout" asp-action="Analytics" class="text-xs font-semibold text-teal-600 hover:text-teal-700 bg-teal-50 hover:bg-teal-100 px-3 py-1.5 rounded-lg transition">
                Gym Telemetry &rarr;
            </a>
            <a asp-controller="Workout" asp-action="Index" class="text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition">
                Workouts
            </a>
        </div>
    </div>

    <!-- Health KPIs Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-5">
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Current Weight</p>
            <div class="flex items-baseline gap-2 mt-1">
                <p class="text-2xl font-extrabold text-slate-800">
                    @(Model.CurrentWeightKg.HasValue ? Model.CurrentWeightKg.Value.ToString("0.0") : "—")
                    <span class="text-xs font-medium text-slate-400">kg</span>
                </p>
                @if (Model.HealthStats?.WeightChangeKg.HasValue == true && Model.HealthStats.WeightChangeKg.Value != 0)
                {
                    var change = Model.HealthStats.WeightChangeKg.Value;
                    <span class="text-2xs font-bold @(change > 0 ? "text-rose-600" : "text-emerald-600")">
                        @(change > 0 ? "+" : "")@change.ToString("0.0") kg
                    </span>
                }
            </div>
        </div>

        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Body Mass Index (BMI)</p>
            <div class="flex items-center gap-2 mt-1">
                <p class="text-2xl font-extrabold text-slate-800">
                    @(Model.CurrentBmi.HasValue ? Model.CurrentBmi.Value.ToString("0.1") : "—")
                </p>
                <span class="px-2 py-0.5 text-2xs font-bold rounded-lg border @bmiBadgeClass">
                    @Model.CurrentBmiCategory
                </span>
            </div>
        </div>

        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Muscle Percentage</p>
            <p class="text-2xl font-extrabold text-teal-600 mt-1">
                @(Model.HealthStats?.CurrentMusclePercent.HasValue == true ? Model.HealthStats.CurrentMusclePercent.Value.ToString("0.0") + "%" : "—")
            </p>
        </div>

        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Total Workouts</p>
            <p class="text-2xl font-extrabold text-indigo-600 mt-1">
                @(Model.HealthStats?.TotalSessions ?? 0)
                <span class="text-xs font-medium text-slate-400">sessions</span>
            </p>
        </div>
    </div>

    <!-- Health Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 pt-2">
        <div class="lg:col-span-8 bg-slate-50/50 rounded-xl p-4 border border-slate-100 flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-700">Weight Progression Trend</span>
                <i class="fa-solid fa-chart-line text-slate-400 text-xs"></i>
            </div>
            <div class="relative h-60 w-full flex items-center justify-center">
                <canvas id="weightTrendChart"></canvas>
            </div>
        </div>

        <div class="lg:col-span-4 bg-slate-50/50 rounded-xl p-4 border border-slate-100 flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-700">Body Composition</span>
                <i class="fa-solid fa-dna text-slate-400 text-xs"></i>
            </div>
            <div class="relative h-60 w-full flex items-center justify-center">
                <canvas id="bodyCompChart"></canvas>
            </div>
        </div>
    </div>
</div>
