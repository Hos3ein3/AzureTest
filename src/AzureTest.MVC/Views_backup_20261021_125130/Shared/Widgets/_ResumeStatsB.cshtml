@model AzureTest.Contracts.DTOs.Resumes.ResumeDto

<div class="h-full w-full p-4 bg-gradient-to-br from-brand-500 to-brand-700 text-white rounded-xl shadow-inner flex flex-col items-center justify-center text-center">
    <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mb-3">
        <i class="fa-solid fa-file-contract text-2xl"></i>
    </div>
    <h3 class="text-lg font-bold">@Model.PositionTitle</h3>
   
    <div class="mt-4 flex items-center gap-6">
        <div>
            <p class="text-xs text-brand-100 uppercase tracking-widest">ATS Score</p>
            <p class="text-3xl font-black">@(Model.AtsScore ?? 0)</p>
        </div>
        <div class="w-px h-10 bg-white/20"></div>
        <div>
            <p class="text-xs text-brand-100 uppercase tracking-widest">Status</p>
            <p class="text-xl font-medium">@Model.Status</p>
        </div>
    </div>
</div>
