@model AzureTest.MVC.Models.HomeDashboardViewModel
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        
        // Common Options
        const commonOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } }
        };
        const barOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { precision: 0 } },
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        };
        const hBarOptions = {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { beginAtZero: true, ticks: { precision: 0 } }
            }
        };

        // Status Chart
        if (document.getElementById('statusChart')) {
            const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.StatusCounts.Keys));
            const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.StatusCounts.Values));
            const statusColors = statusLabels.map(label => {
                switch(label) {
                    case 'Rejected': return '#dc2626'; // red-600
                    case 'OfferExtended': 
                    case 'OfferAccepted':
                    case 'Offer': return '#16a34a'; // green-600
                    case 'Interview': return '#d97706'; // amber-600
                    case 'Applied': return '#2563eb'; // blue-600
                    case 'Screening': return '#0284c7'; // sky-600
                    default: return '#94a3b8'; // slate-400
                }
            });
            new Chart(document.getElementById('statusChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{ data: statusData, backgroundColor: statusColors, borderWidth: 1 }]
                },
                options: commonOptions
            });
        }

        // Date Chart
        if (document.getElementById('dateChart')) {
            const dateLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.ApplicationsByDate.Keys));
            const dateData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.ApplicationsByDate.Values));
            new Chart(document.getElementById('dateChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: dateLabels,
                    datasets: [{
                        label: 'Applications',
                        data: dateData,
                        backgroundColor: '#3b82f6', // blue-500
                        borderRadius: 4
                    }]
                },
                options: barOptions
            });
        }

        // Position Chart
        if (document.getElementById('positionChart')) {
            const posLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.PositionCounts.Keys));
            const posData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.PositionCounts.Values));
            new Chart(document.getElementById('positionChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: posLabels,
                    datasets: [{ label: 'Positions', data: posData, backgroundColor: '#0d9488', borderRadius: 4 }]
                },
                options: hBarOptions
            });
        }

        // Location Chart
        if (document.getElementById('locationChart')) {
            const locLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.LocationCounts.Keys));
            const locData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.LocationCounts.Values));
            new Chart(document.getElementById('locationChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: locLabels,
                    datasets: [{ label: 'Locations', data: locData, backgroundColor: '#8b5cf6', borderRadius: 4 }]
                },
                options: hBarOptions
            });
        }
        
        // Source Chart
        if (document.getElementById('sourceChart')) {
            const srcLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.SourceCounts.Keys));
            const srcData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Analytics.SourceCounts.Values));
            new Chart(document.getElementById('sourceChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: srcLabels,
                    datasets: [{ 
                        data: srcData, 
                        backgroundColor: ['#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#6366f1', '#14b8a6', '#f43f5e', '#8b5cf6'],
                        borderWidth: 1 
                    }]
                },
                options: commonOptions
            });
        }
        
        // Expense Chart
        if (document.getElementById('expenseChart')) {
            const expLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory.Keys));
            const expData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory.Values));
            new Chart(document.getElementById('expenseChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: expLabels,
                    datasets: [{ 
                        data: expData, 
                        backgroundColor: ['#f87171', '#fb923c', '#fbbf24', '#a3e635', '#4ade80', '#2dd4bf', '#38bdf8', '#818cf8', '#c084fc', '#f472b6'],
                        borderWidth: 1 
                    }]
                },
                options: commonOptions
            });
        }

        // Debt Chart
        if (document.getElementById('debtChart')) {
            const debtLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DebtsByPerson.Keys));
            const debtData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DebtsByPerson.Values));
            new Chart(document.getElementById('debtChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: debtLabels,
                    datasets: [{ label: 'Total Debt ($)', data: debtData, backgroundColor: '#f43f5e', borderRadius: 4 }]
                },
                options: barOptions
            });
        }

        // Ticket Status Chart
        if (document.getElementById('ticketStatusChart')) {
            const tStatusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketStatusCounts.Keys));
            const tStatusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TicketStatusCounts.Values));
            const tColors = tStatusLabels.map(l => {
                switch(l) {
                    case 'Open': return '#f59e0b';
                    case 'InProgress': return '#3b82f6';
                    case 'Answered': return '#0284c7';
                    case 'Closed': return '#10b981';
                    default: return '#94a3b8';
                }
            });
            new Chart(document.getElementById('ticketStatusChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: tStatusLabels,
                    datasets: [{ data: tStatusData, backgroundColor: tColors, borderWidth: 1 }]
                },
                options: commonOptions
            });
        }

        // Habit Adherence Chart
        if (document.getElementById('habitAdherenceChart')) {
            const habitLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HabitAdherence.Keys));
            const habitData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HabitAdherence.Values));
            new Chart(document.getElementById('habitAdherenceChart').getContext('2d'), {
                type: 'pie',
                data: {
                    labels: habitLabels,
                    datasets: [{ data: habitData, backgroundColor: ['#10b981', '#f43f5e'], borderWidth: 1 }]
                },
                options: commonOptions
            });
        }

        // Monthly Finance Chart
        if (document.getElementById('monthlyFinanceChart')) {
            const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses.Keys));
            const mExpenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses.Values));
            const mDebts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyDebts.Values));
            
            new Chart(document.getElementById('monthlyFinanceChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: monthLabels,
                    datasets: [
                        { label: 'Expenses', data: mExpenses, backgroundColor: '#3b82f6', borderRadius: 4 },
                        { label: 'Debts', data: mDebts, backgroundColor: '#f43f5e', borderRadius: 4 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // Media Type Chart
        if (document.getElementById('mediaTypeChart')) {
            const mtLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MediaByType.Keys));
            const mtData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MediaByType.Values));
            new Chart(document.getElementById('mediaTypeChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: mtLabels,
                    datasets: [{
                        data: mtData,
                        backgroundColor: ['#3b82f6', '#6366f1', '#f43f5e'],
                        borderWidth: 1
                    }]
                },
                options: commonOptions
            });
        }

        // Media Status Chart
        if (document.getElementById('mediaStatusChart')) {
            const msLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MediaByStatus.Keys));
            const msData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MediaByStatus.Values));
            new Chart(document.getElementById('mediaStatusChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: msLabels,
                    datasets: [{
                        label: 'Titles',
                        data: msData,
                        backgroundColor: ['#0284c7', '#10b981', '#f59e0b', '#ef4444'],
                        borderRadius: 6
                    }]
                },
                options: barOptions
            });
        }

        // Weight Progression Trend Chart
        if (document.getElementById('weightTrendChart')) {
            const wLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightHistoryTrend.Keys));
            const wData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightHistoryTrend.Values));
            new Chart(document.getElementById('weightTrendChart').getContext('2d'), {
                type: 'line',
                data: {
                    labels: wLabels,
                    datasets: [{
                        label: 'Weight (kg)',
                        data: wData,
                        borderColor: '#0d9488',
                        backgroundColor: 'rgba(13, 148, 136, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointBackgroundColor: '#0d9488'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: false }
                    }
                }
            });
        }

        // Body Composition Chart
        if (document.getElementById('bodyCompChart')) {
            const bcLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BodyComposition.Keys));
            const bcData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BodyComposition.Values));
            new Chart(document.getElementById('bodyCompChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: bcLabels,
                    datasets: [{
                        data: bcData,
                        backgroundColor: ['#0d9488', '#f59e0b', '#6366f1'],
                        borderWidth: 1
                    }]
                },
                options: commonOptions
            });
        }

        // Shopping List By Category Chart
        if (document.getElementById('shoppingCategoryChart')) {
            const scLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShoppingListByCategory.Keys));
            const scData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShoppingListByCategory.Values));
            new Chart(document.getElementById('shoppingCategoryChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: scLabels,
                    datasets: [{
                        label: 'Items',
                        data: scData,
                        backgroundColor: '#d97706',
                        borderRadius: 6
                    }]
                },
                options: barOptions
            });
        }
    });
</script>
