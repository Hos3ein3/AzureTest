@model AzureTest.MVC.Models.HomeDashboardViewModel

<!-- Media & Entertainment Analytics Widget -->
<div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 p-6 flex flex-col justify-between hover:border-slate-300 transition-all col-span-1 lg:col-span-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-film"></i>
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900 tracking-tight">Media & Entertainment Telemetry</h3>
                <p class="text-xs text-slate-500">TMDb movies, series, anime, and watch time statistics</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Media" asp-action="Stats" class="text-xs font-semibold text-purple-600 hover:text-purple-700 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-lg transition">
                Detailed Stats &rarr;
            </a>
            <a asp-controller="Media" asp-action="Index" class="text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition">
                Watchlist
            </a>
        </div>
    </div>

    <!-- Media KPIs Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 my-5">
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Watch Time</p>
            <p class="text-xl font-extrabold text-slate-800 mt-1">@Model.TotalMediaHours <span class="text-xs font-medium text-slate-400">hrs</span></p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Movies</p>
            <p class="text-xl font-extrabold text-blue-600 mt-1">@(Model.MediaStats?.TotalMoviesWatched ?? 0)</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Series</p>
            <p class="text-xl font-extrabold text-indigo-600 mt-1">@(Model.MediaStats?.TotalSeriesWatched ?? 0)</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Anime</p>
            <p class="text-xl font-extrabold text-rose-600 mt-1">@(Model.MediaStats?.TotalAnimeWatched ?? 0)</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Episodes</p>
            <p class="text-xl font-extrabold text-amber-600 mt-1">@(Model.MediaStats?.TotalEpisodesWatched ?? 0)</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Avg Rating</p>
            <p class="text-xl font-extrabold text-emerald-600 mt-1">
                @((Model.MediaStats?.AverageRating ?? 0) > 0 ? (Model.MediaStats?.AverageRating.ToString("0.0") + " / 10") : "N/A")
            </p>
        </div>
    </div>

    <!-- Media Charts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-700">Distribution by Media Type</span>
                <i class="fa-solid fa-chart-pie text-slate-400 text-xs"></i>
            </div>
            <div class="relative h-56 w-full flex items-center justify-center">
                <canvas id="mediaTypeChart"></canvas>
            </div>
        </div>

        <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100 flex flex-col">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-700">Watch Status Breakdown</span>
                <i class="fa-solid fa-bars-progress text-slate-400 text-xs"></i>
            </div>
            <div class="relative h-56 w-full flex items-center justify-center">
                <canvas id="mediaStatusChart"></canvas>
            </div>
        </div>
    </div>
</div>
