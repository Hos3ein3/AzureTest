@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
<div class="h-full w-full bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl shadow-lg p-5 text-white flex flex-col justify-between">
    <div>
        <h3 class="text-sm font-medium text-indigo-100 mb-1">ATS Score</h3>
        <p class="text-3xl font-bold">@(Model.AtsScore?.ToString() ?? "N/A")<span class="text-lg font-normal text-indigo-200">/100</span></p>
    </div>
    <div class="mt-4">
        <div class="w-full bg-indigo-900/30 rounded-full h-2">
            <div class="bg-white h-2 rounded-full" style="width: @(Model.AtsScore ?? 0)%"></div>
        </div>
        <p class="text-xs text-indigo-100 mt-2">@(Model.AtsScore.HasValue ? "Great match for the role!" : "Score not calculated")</p>
    </div>
</div>
