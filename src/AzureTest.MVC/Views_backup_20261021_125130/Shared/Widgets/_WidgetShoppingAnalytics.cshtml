@model AzureTest.MVC.Models.HomeDashboardViewModel

@{
    var total = Model.ShoppingListTotalItems;
    var bought = Model.ShoppingListBoughtItems;
    var completionRate = total > 0 ? (int)Math.Round((double)bought / total * 100) : 0;
}

<!-- Smart Shopping & Grocery Tracker Widget -->
<div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 p-6 flex flex-col justify-between hover:border-slate-300 transition-all col-span-1 lg:col-span-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg shrink-0">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900 tracking-tight">Shopping List & Pantry Telemetry</h3>
                <p class="text-xs text-slate-500">Live grocery inventory, cart status, and store section allocations</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Food" asp-action="ShoppingList" class="text-xs font-semibold text-amber-600 hover:text-amber-700 bg-amber-50 hover:bg-amber-100 px-3 py-1.5 rounded-lg transition">
                Open Shopping List &rarr;
            </a>
            <a asp-controller="Food" asp-action="Pantry" class="text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg transition">
                Pantry Stock
            </a>
        </div>
    </div>

    <!-- Shopping KPIs Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 my-5">
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Total Items</p>
            <p class="text-2xl font-extrabold text-slate-800 mt-1">@Model.ShoppingListTotalItems</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">To Buy</p>
            <p class="text-2xl font-extrabold text-amber-600 mt-1">@Model.ShoppingListToBuyItems</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">In Cart</p>
            <p class="text-2xl font-extrabold text-blue-600 mt-1">@Model.ShoppingListInCartItems</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Bought / Done</p>
            <p class="text-2xl font-extrabold text-emerald-600 mt-1">@Model.ShoppingListBoughtItems</p>
        </div>
        <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-100">
            <p class="text-2xs font-semibold text-slate-500 uppercase tracking-wider">Est. Cost</p>
            <p class="text-2xl font-extrabold text-slate-800 mt-1">@Model.ShoppingListEstimatedCost.ToString("C")</p>
        </div>
    </div>

    <!-- Progress bar -->
    <div class="mb-5 bg-slate-50/80 rounded-xl p-4 border border-slate-100">
        <div class="flex items-center justify-between text-xs mb-2">
            <span class="font-bold text-slate-700">Shopping List Completion Progress</span>
            <span class="font-extrabold text-brand-600">@completionRate% Completed</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden flex">
            <div class="bg-emerald-500 h-2.5 rounded-full transition-all duration-500" style="width: @completionRate%"></div>
        </div>
    </div>

    <!-- Shopping Section Chart -->
    <div class="bg-slate-50/50 rounded-xl p-4 border border-slate-100">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-700">Items by Store Section</span>
            <i class="fa-solid fa-layer-group text-slate-400 text-xs"></i>
        </div>
        <div class="relative h-56 w-full flex items-center justify-center">
            <canvas id="shoppingCategoryChart"></canvas>
        </div>
    </div>
</div>
