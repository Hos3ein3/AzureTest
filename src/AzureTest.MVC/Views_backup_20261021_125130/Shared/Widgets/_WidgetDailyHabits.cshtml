@model AzureTest.MVC.Models.HomeDashboardViewModel

<!-- Habits Widget -->
<div class="col-span-1 bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <div class="flex items-center gap-2">
            <h5 class="text-lg font-semibold text-slate-800 m-0">Habits</h5>
            @if (Model.RecentHabits.Any())
            {
                <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">@Model.RecentHabits.Count()</span>
            }
        </div>
        <a asp-controller="Habit" asp-action="Index" class="inline-flex items-center text-xs text-brand-600 hover:text-brand-700 font-semibold transition-colors">
            View All <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
    </div>
    <div class="p-6 flex-1 overflow-y-auto custom-scrollbar">
        @if (!Model.RecentHabits.Any())
        {
            <div class="text-center text-slate-400 mt-6">
                <i class="fa-solid fa-seedling text-3xl mb-2 block"></i>
                <p class="text-sm">No active habits.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var h in Model.RecentHabits)
                {
                    var isDone = h.IsCompletedToday;
                    var progress = h.ProgressPercentage;

                    <div class="flex items-center justify-between gap-3 p-2 rounded-lg hover:bg-slate-50 transition-colors">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <a asp-controller="Habit" asp-action="Details" asp-route-id="@h.Id" class="text-sm font-medium text-slate-700 hover:text-brand-600 truncate transition-colors" title="View details & charts">
                                    @h.Name
                                </a>
                                @if (h.CurrentStreak > 0)
                                {
                                    <span class="inline-flex items-center text-xs font-semibold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded" title="Current streak">
                                        <i class="fa-solid fa-fire text-amber-500 mr-1"></i> @h.CurrentStreak
                                    </span>
                                }
                            </div>
                            
                            @if (h.Type == AzureTest.Domain.Enums.HabitType.Counter)
                            {
                                <p class="text-xs text-slate-500 mt-0.5">
                                    Current: <strong class="text-slate-700">@h.TodayNumericValue</strong>
                                    @if (h.Target > 0) { <span>/ @h.Target</span> }
                                </p>
                                @if (h.Target > 0)
                                {
                                    <div class="w-full bg-slate-100 rounded-full h-1.5 mt-1 overflow-hidden">
                                        <div class="bg-brand-500 h-1.5 rounded-full transition-all" style="width: @Math.Min(100, progress)%"></div>
                                    </div>
                                }
                            }
                            else if (h.Type == AzureTest.Domain.Enums.HabitType.Quantity || h.Type == AzureTest.Domain.Enums.HabitType.Duration)
                            {
                                <p class="text-xs text-slate-500 mt-0.5">
                                    Current: <strong class="text-slate-700">@h.TodayNumericValue</strong>
                                    @if (h.Target > 0) { <span>/ @h.Target</span> }
                                </p>
                                <div class="w-full bg-slate-100 rounded-full h-1.5 mt-1 overflow-hidden">
                                    <div class="bg-brand-500 h-1.5 rounded-full transition-all" style="width: @Math.Min(100, progress)%"></div>
                                </div>
                            }
                            else if (h.Type == AzureTest.Domain.Enums.HabitType.Quit)
                            {
                                <p class="text-xs text-slate-500 mt-0.5">
                                    <span class="inline-flex items-center text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
                                        <i class="fa-solid fa-shield-halved text-emerald-600 mr-1"></i> @h.TodayValue
                                    </span>
                                </p>
                            }
                            else
                            {
                                <p class="text-xs text-slate-500 mt-0.5">
                                    @(isDone ? "Done for today!" : "Pending")
                                </p>
                            }
                        </div>
                        
                        @if (!Model.IsViewingOtherUser)
                        {
                            <div class="flex items-center gap-1">
                                @if (h.Type == AzureTest.Domain.Enums.HabitType.Boolean)
                                {
                                    <form asp-controller="Habit" asp-action="Log" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <input type="hidden" name="booleanValue" value="@(isDone ? "false" : "true")" />
                                        <button type="submit" class="w-8 h-8 rounded-full flex items-center justify-center @(isDone ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-400 hover:bg-brand-50 hover:text-brand-600") transition-colors focus:outline-none" title="@(isDone ? "Mark as not done" : "Mark as done")">
                                            <i class="fa-solid fa-check text-xs"></i>
                                        </button>
                                    </form>
                                }
                                else if (h.Type == AzureTest.Domain.Enums.HabitType.Counter)
                                {
                                    @if (h.TodayNumericValue > 0)
                                    {
                                        <form asp-controller="Habit" asp-action="Undo" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@h.Id" />
                                            <button type="submit" class="w-7 h-7 rounded-full flex items-center justify-center bg-slate-100 text-slate-500 hover:bg-rose-50 hover:text-rose-600 transition-colors focus:outline-none" title="Undo click (-1)">
                                                <i class="fa-solid fa-rotate-left text-xs"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-controller="Habit" asp-action="Log" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <input type="hidden" name="numericValue" value="1" />
                                        <button type="submit" class="w-8 h-8 rounded-full flex items-center justify-center @(isDone ? "bg-emerald-500 text-white" : "bg-brand-50 text-brand-600 hover:bg-brand-100") transition-colors focus:outline-none" title="+1 Click">
                                            <i class="fa-solid fa-plus text-xs"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Habit" asp-action="Index" class="w-8 h-8 rounded-full flex items-center justify-center @(isDone ? "bg-emerald-100 text-emerald-600" : "bg-slate-100 text-slate-500 hover:bg-brand-50 hover:text-brand-600") transition-colors" title="Manage habit">
                                        <i class="fa-solid @(isDone ? "fa-check" : "fa-pen-to-square") text-xs"></i>
                                    </a>
                                }
                            </div>
                        }
                        else if (isDone)
                        {
                            <div class="w-8 h-8 rounded-full flex items-center justify-center bg-emerald-100 text-emerald-600">
                                <i class="fa-solid fa-check text-xs"></i>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 rounded-b-xl text-center">
        <a asp-controller="Habit" asp-action="Index" class="inline-flex items-center justify-center w-full text-xs font-semibold text-slate-700 hover:text-brand-600 transition-colors">
            View All Habits & Full Analytics &rarr;
        </a>
    </div>
</div>
