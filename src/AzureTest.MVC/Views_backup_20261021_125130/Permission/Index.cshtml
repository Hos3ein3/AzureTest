@model IReadOnlyList<AzureTest.Application.Permissions.PermissionDto>
@{
    ViewData["Title"] = "Permissions Management";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Administration", Url = "#" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Permissions", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "Permissions Management",
        Subtitle = "Review and enforce endpoint restriction rules across all controller actions.",
        Icon = "fa-solid fa-key",
        Badge = $"{Model.Count} Listed",
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<!-- Action Bar -->
<div class="flex flex-wrap items-center justify-between gap-3 mb-6 p-4 bg-white rounded-2xl border border-slate-200/80 shadow-2xs">
    <form method="get" class="flex items-center gap-2 flex-1 max-w-md">
        <input type="hidden" name="sort" value="@ViewBag.Sort" />
        <input type="hidden" name="dir" value="@ViewBag.Dir" />
        <div class="relative w-full">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <input type="text" name="search" value="@ViewBag.Search" class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" placeholder="Search permissions by name, controller, area...">
        </div>
        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-2xs transition-colors shrink-0">
            <i class="fa-solid fa-filter"></i> Filter
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Index" class="p-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-xs font-semibold shadow-2xs transition-colors shrink-0" title="Clear Filter">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        }
    </form>

    <div class="flex items-center gap-2.5">
        <form asp-action="Sync" method="post" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                <i class="fa-solid fa-arrows-rotate text-brand-600"></i> Sync Endpoints
            </button>
        </form>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-plus"></i> New Permission
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200/80 text-emerald-800 p-4 rounded-2xl mb-6 flex items-center gap-3 shadow-2xs">
        <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <div class="text-xs font-semibold">@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-rose-50 border border-rose-200/80 text-rose-800 p-4 rounded-2xl mb-6 flex items-center gap-3 shadow-2xs">
        <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="text-xs font-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-semibold border-b border-slate-200/80 uppercase tracking-wider text-2xs">
                @{
                    var currentSort = ViewBag.Sort as string;
                    var currentDir = ViewBag.Dir as string;
                    var nextDir = currentDir == "asc" ? "desc" : "asc";
                }
                <tr>
                    <th scope="col" class="px-5 py-3.5">
                        <a asp-action="Index" asp-route-sort="AreaName" asp-route-dir="@(currentSort == "AreaName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 inline-flex items-center gap-1.5">
                            <span>Area</span>
                            @if(currentSort == "AreaName") { <i class="fa-solid fa-sort-@currentDir text-brand-600"></i> } else { <i class="fa-solid fa-sort text-slate-300"></i> }
                        </a>
                    </th>
                    <th scope="col" class="px-5 py-3.5">
                        <a asp-action="Index" asp-route-sort="ControllerName" asp-route-dir="@(currentSort == "ControllerName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 inline-flex items-center gap-1.5">
                            <span>Controller</span>
                            @if(currentSort == "ControllerName") { <i class="fa-solid fa-sort-@currentDir text-brand-600"></i> } else { <i class="fa-solid fa-sort text-slate-300"></i> }
                        </a>
                    </th>
                    <th scope="col" class="px-5 py-3.5">
                        <a asp-action="Index" asp-route-sort="ActionName" asp-route-dir="@(currentSort == "ActionName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 inline-flex items-center gap-1.5">
                            <span>Action</span>
                            @if(currentSort == "ActionName") { <i class="fa-solid fa-sort-@currentDir text-brand-600"></i> } else { <i class="fa-solid fa-sort text-slate-300"></i> }
                        </a>
                    </th>
                    <th scope="col" class="px-5 py-3.5">
                        <a asp-action="Index" asp-route-sort="DisplayName" asp-route-dir="@(currentSort == "DisplayName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 inline-flex items-center gap-1.5">
                            <span>Display Name</span>
                            @if(currentSort == "DisplayName") { <i class="fa-solid fa-sort-@currentDir text-brand-600"></i> } else { <i class="fa-solid fa-sort text-slate-300"></i> }
                        </a>
                    </th>
                    <th scope="col" class="px-5 py-3.5 text-center">
                        <a asp-action="Index" asp-route-sort="IsRestricted" asp-route-dir="@(currentSort == "IsRestricted" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 inline-flex items-center gap-1.5">
                            <span>Restricted</span>
                            @if(currentSort == "IsRestricted") { <i class="fa-solid fa-sort-@currentDir text-brand-600"></i> } else { <i class="fa-solid fa-sort text-slate-300"></i> }
                        </a>
                    </th>
                    <th scope="col" class="px-5 py-3.5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8">
                            <partial name="UiComponents/_EmptyState" model='new AzureTest.MVC.Models.EmptyStateModel { Title = "No Permissions Found", Description = "No permission endpoints found matching current query.", Icon = "fa-solid fa-shield-halved", ActionText = "Sync Endpoints", ActionUrl = "/Permission/Index" }' />
                        </td>
                    </tr>
                }
                @foreach (var perm in Model)
                {
                    <tr class="hover:bg-slate-50/70 transition-colors">
                        <td class="px-5 py-3.5 whitespace-nowrap">
                            @if (!string.IsNullOrWhiteSpace(perm.AreaName))
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80">
                                    <i class="fa-solid fa-box text-3xs"></i> @perm.AreaName
                                </span>
                            }
                            else
                            {
                                <span class="text-2xs text-slate-400 italic">Global</span>
                            }
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap">
                            <span class="font-bold text-slate-900 font-mono text-xs">@perm.ControllerName</span>
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap">
                            <span class="font-mono text-slate-600 text-xs bg-slate-50 px-2 py-0.5 rounded-md border border-slate-200/60">@perm.ActionName</span>
                        </td>
                        <td class="px-5 py-3.5">
                            <div class="font-bold text-slate-800 text-xs">@perm.DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(perm.Description))
                            {
                                <div class="text-2xs text-slate-400 mt-0.5">@perm.Description</div>
                            }
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap text-center">
                            @if(perm.IsRestricted) {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-rose-50 text-rose-700 border border-rose-200/80">
                                    <i class="fa-solid fa-lock text-3xs"></i> Restricted
                                </span>
                            } else {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-2xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80">
                                    <i class="fa-solid fa-lock-open text-3xs"></i> Public
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3.5 whitespace-nowrap text-right">
                            <form asp-action="ToggleRestriction" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@perm.Id" />
                                <input type="hidden" name="isRestricted" value="@(perm.IsRestricted ? "false" : "true")" />
                                <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 text-2xs font-bold transition-colors shadow-2xs">
                                    <i class="fa-solid fa-arrows-rotate text-3xs text-brand-600"></i> Toggle
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        var paginationModel = new AzureTest.MVC.Models.PaginationModel
        {
            CurrentPage = (int)(ViewBag.CurrentPage ?? 1),
            TotalPages = (int)(ViewBag.TotalPages ?? 1),
            PageSize = 20,
            TotalItems = (int)(ViewBag.TotalPages * 20),
            BaseUrl = "/Permission/Index",
            RouteParams = new Dictionary<string, string>
            {
                { "search", ViewBag.Search as string ?? "" },
                { "sort", ViewBag.Sort as string ?? "" },
                { "dir", ViewBag.Dir as string ?? "" }
            }
        };
        <partial name="UiComponents/_Pagination" model="paginationModel" />
    }
</div>
