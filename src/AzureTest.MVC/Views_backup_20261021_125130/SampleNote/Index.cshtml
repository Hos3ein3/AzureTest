@model List<AzureTest.Contracts.DTOs.SampleNotes.SampleNoteDto>
@using AzureTest.Domain.Enums
@using AzureTest.MVC.Extensions
@using AzureTest.Application.SampleNotes.Queries
@using AzureTest.MVC.Models
@{
    ViewData["Title"] = "Sample Notes";
    var filter = ViewBag.Filter as SampleNoteFilter ?? new SampleNoteFilter();

    var pageHeader = new PageHeaderModel
    {
        Title = "Sample Notes",
        Subtitle = "Developer playground for testing IValidationService, ResultExtensions, and Toast notifications",
        Icon = "fa-solid fa-note-sticky",
        Badge = "Dev Playground",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", "/"),
            new BreadcrumbItem("Sample Notes", active: true)
        },
        ActionText = "New Note",
        ActionUrl = Url.Action("Create", "SampleNote"),
        ActionIcon = "fa-solid fa-plus"
    };
}

<partial name="UiComponents/_PageHeader" model="pageHeader" />

<!-- Toast Notification -->
@if (TempData["Success"] != null)
{
    <div class="mb-6 flex items-center gap-3 px-4 py-3 bg-emerald-50 border border-emerald-200/80 text-emerald-800 rounded-xl text-xs font-medium shadow-2xs">
        <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- Validation summary -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-6 px-4 py-3 bg-rose-50 border border-rose-200/80 text-rose-700 rounded-xl text-xs shadow-2xs">
        <div asp-validation-summary="All"></div>
    </div>
}

<!-- Filter Card -->
<div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-2xs mb-6">
    <form method="get" class="flex flex-wrap items-end gap-3.5">
        <div class="flex-1 min-w-56">
            <label class="block text-2xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Search</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="Search" value="@filter.Search"
                       placeholder="Search title or content..."
                       class="w-full pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white" />
            </div>
        </div>
        <div class="min-w-44">
            <label class="block text-2xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Category</label>
            <select name="Category" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all bg-white">
                <option value="">All Categories</option>
                @foreach (var item in EnumExtensions.ToSelectList<NoteCategory>(filter.Category))
                {
                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                }
            </select>
        </div>
        <div class="flex items-center gap-2 pb-2.5">
            <input type="checkbox" name="IsPinned" value="true" id="isPinned" @(filter.IsPinned == true ? "checked" : "")
                   class="w-4 h-4 text-brand-600 rounded border-slate-300 focus:ring-brand-500" />
            <label for="isPinned" class="text-xs font-medium text-slate-700 cursor-pointer">Pinned only</label>
        </div>
        <div class="flex items-center gap-2">
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-semibold transition-colors shadow-2xs">
                <i class="fa-solid fa-filter text-2xs"></i>
                <span>Filter</span>
            </button>
            <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2.5 bg-white border border-slate-200 text-slate-600 rounded-xl text-xs font-semibold hover:bg-slate-50 transition-colors shadow-2xs">
                <i class="fa-solid fa-rotate-left"></i>
                <span>Reset</span>
            </a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden mb-6">
    @if (!Model.Any())
    {
        <partial name="UiComponents/_EmptyState" model='new EmptyStateModel("No notes found", "Create a note to start experimenting with the validation and result pipeline.", "fa-solid fa-note-sticky", "Create Note", Url.Action("Create", "SampleNote"))' />
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50/75 text-slate-500 font-semibold border-b border-slate-200/80 uppercase tracking-wider text-2xs">
                    <tr>
                        <th class="px-5 py-3.5">Title</th>
                        <th class="px-5 py-3.5">Category</th>
                        <th class="px-5 py-3.5">Priority</th>
                        <th class="px-5 py-3.5 text-center">Pinned</th>
                        <th class="px-5 py-3.5">Created</th>
                        <th class="px-5 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var note in Model)
                    {
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="px-5 py-3.5">
                                <div class="font-semibold text-slate-900">@note.Title</div>
                                <div class="text-2xs text-slate-400 truncate max-w-sm mt-0.5">@note.Content</div>
                            </td>
                            <td class="px-5 py-3.5">
                                @{
                                    var badgeClass = note.Category switch
                                    {
                                        NoteCategory.Urgent => "bg-rose-50 text-rose-700 border-rose-200/60",
                                        NoteCategory.Work => "bg-blue-50 text-blue-700 border-blue-200/60",
                                        NoteCategory.Personal => "bg-emerald-50 text-emerald-700 border-emerald-200/60",
                                        _ => "bg-slate-50 text-slate-700 border-slate-200/60"
                                    };
                                }
                                <span class="px-2.5 py-0.5 text-3xs font-semibold rounded-full border @badgeClass">@note.Category</span>
                            </td>
                            <td class="px-5 py-3.5">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-bold text-slate-700">@note.Priority</span>
                                    <span class="inline-flex items-center gap-0.5">
                                        @for (int s = 0; s < note.Priority; s++)
                                        {
                                            <i class="fa-solid fa-star text-amber-400 text-3xs"></i>
                                        }
                                        @for (int s = note.Priority; s < 5; s++)
                                        {
                                            <i class="fa-regular fa-star text-slate-300 text-3xs"></i>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                @if (note.IsPinned)
                                {
                                    <span class="text-amber-500" title="Pinned">
                                        <i class="fa-solid fa-thumbtack text-xs"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-300 text-xs">-</span>
                                }
                            </td>
                            <td class="px-5 py-3.5 text-slate-500 text-2xs">@note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@note.Id"
                                       class="w-7 h-7 rounded-lg text-slate-500 hover:text-brand-600 hover:bg-brand-50 flex items-center justify-center transition-colors" title="Edit">
                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@note.Id" method="post" class="inline"
                                          onsubmit="return confirm('Delete \'@Html.Raw(note.Title.Replace("'", "\\'"))\'? This cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="w-7 h-7 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors" title="Delete">
                                            <i class="fa-solid fa-trash text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Dev Info Box -->
<div class="bg-amber-50/70 border border-amber-200/80 rounded-2xl p-5 text-xs text-amber-900 shadow-2xs">
    <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-circle-info"></i>
        </div>
        <div>
            <h3 class="font-bold mb-1">About this page</h3>
            <p class="text-slate-600 leading-relaxed">This is a <strong>dev-only playground</strong> for testing <code class="bg-amber-100/80 px-1 py-0.5 rounded text-2xs">IValidationService</code>, <code class="bg-amber-100/80 px-1 py-0.5 rounded text-2xs">ResultExtensions</code>, <code class="bg-amber-100/80 px-1 py-0.5 rounded text-2xs">TempData with Toast Extension</code>, and <code class="bg-amber-100/80 px-1 py-0.5 rounded text-2xs">EnumExtensions</code>.
            Notes are stored in memory + a flat file (<code class="bg-amber-100/80 px-1 py-0.5 rounded text-2xs">sample_notes_data.csv</code>) &mdash; no database required.</p>
        </div>
    </div>
</div>
