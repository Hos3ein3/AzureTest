@using AzureTest.MVC.Models
@model AzureTest.Domain.Documents.DashboardComponent
@{
    ViewData["Title"] = "Edit Component";
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Dashboard", Url.Action("Index", "Home"), "fa-solid fa-house"),
        new BreadcrumbItem("Components", Url.Action("Index"), "fa-solid fa-puzzle-piece"),
        new BreadcrumbItem(Model.Name ?? "Component", null, "fa-solid fa-shapes"),
        new BreadcrumbItem("Edit", null, "fa-solid fa-pen", true)
    };

    var headerModel = new PageHeaderModel(
        "Edit Component",
        $"Modify settings for \"{Model.Name}\".",
        "fa-solid fa-pen-to-square",
        new HeaderAction("Back to List", Url.Action("Index"), "fa-solid fa-arrow-left", "secondary")
    );
}

<div class="px-4 sm:px-6 lg:px-8 py-8 mx-auto max-w-4xl space-y-6">
    <partial name="UiComponents/_Breadcrumb" model="breadcrumbs" />
    <partial name="UiComponents/_PageHeader" model="headerModel" />

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagePath" />

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 text-rose-700 border border-rose-200 text-sm font-medium"></div>

            <!-- Image Upload Preview Section -->
            <div class="flex flex-col items-center">
                <div class="w-full max-w-md border-2 border-dashed border-slate-200 rounded-2xl p-6 text-center cursor-pointer hover:border-brand-500 hover:bg-slate-50/50 transition-colors" onclick="document.getElementById('imageFile').click()">
                    <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ImagePath) ? "" : Model.ImagePath)" class="mx-auto max-h-48 rounded-xl object-contain @(string.IsNullOrEmpty(Model.ImagePath) ? "hidden" : "") mb-3 border border-slate-200 shadow-sm" />
                    <div id="imagePlaceholder" class="py-4 @(!string.IsNullOrEmpty(Model.ImagePath) ? "hidden" : "")">
                        <div class="w-12 h-12 mx-auto rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl mb-2">
                            <i class="fa-regular fa-image"></i>
                        </div>
                        <p class="text-xs font-semibold text-slate-700">Click to upload new preview</p>
                        <p class="text-[11px] text-slate-400 mt-0.5">PNG, JPG, WebP up to 5MB</p>
                    </div>
                </div>
                <input type="file" id="imageFile" name="imageFile" accept="image/*" class="hidden" onchange="previewImage(event)" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Display Name <span class="text-rose-500">*</span></label>
                    <input asp-for="Name" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-semibold text-slate-800 placeholder:text-slate-400" />
                    <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="Category" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Category</label>
                    <input asp-for="Category" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" />
                    <span asp-validation-for="Category" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Description</label>
                    <textarea asp-for="Description" rows="2" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400"></textarea>
                    <span asp-validation-for="Description" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="PartialViewName" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Partial View Name <span class="text-rose-500">*</span></label>
                    <input asp-for="PartialViewName" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" />
                    <span asp-validation-for="PartialViewName" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="RequiredRole" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Required Role (Optional)</label>
                    <input asp-for="RequiredRole" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all font-medium text-slate-800 placeholder:text-slate-400" />
                    <span asp-validation-for="RequiredRole" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>
            </div>

            <!-- Grid Dimensions -->
            <div class="pt-6 border-t border-slate-100">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4">Gridstack Dimensions & Bounds</h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
                    <div>
                        <label asp-for="DefaultWidth" class="block text-xs font-medium text-slate-600 mb-1">Def W (1-12)</label>
                        <input asp-for="DefaultWidth" type="number" min="1" max="12" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>
                    <div>
                        <label asp-for="DefaultHeight" class="block text-xs font-medium text-slate-600 mb-1">Def Height</label>
                        <input asp-for="DefaultHeight" type="number" min="1" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>
                    <div>
                        <label asp-for="MinWidth" class="block text-xs font-medium text-slate-600 mb-1">Min W</label>
                        <input asp-for="MinWidth" type="number" min="0" max="12" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>
                    <div>
                        <label asp-for="MaxWidth" class="block text-xs font-medium text-slate-600 mb-1">Max W</label>
                        <input asp-for="MaxWidth" type="number" min="0" max="12" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>
                    <div>
                        <label asp-for="MinHeight" class="block text-xs font-medium text-slate-600 mb-1">Min H</label>
                        <input asp-for="MinHeight" type="number" min="0" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>
                    <div>
                        <label asp-for="MaxHeight" class="block text-xs font-medium text-slate-600 mb-1">Max H</label>
                        <input asp-for="MaxHeight" type="number" min="0" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
                    </div>
                </div>
                <div class="mt-4 flex items-center">
                    <input asp-for="IsResizable" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                    <label asp-for="IsResizable" class="ml-2.5 text-xs font-semibold text-slate-700">Allow Resizing in GridStack</label>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl transition">
                    Cancel
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('imagePreview');
                var placeholder = document.getElementById('imagePlaceholder');
                output.src = reader.result;
                output.classList.remove('hidden');
                placeholder.classList.add('hidden');
            };
            if(event.target.files[0]){
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
}
