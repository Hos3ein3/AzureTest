@model AzureTest.Contracts.DTOs.Resumes.ResumeAnalyticsDto
@{
    ViewData["Title"] = "Analytics Dashboard";

    var breadcrumbs = new List<AzureTest.MVC.Models.BreadcrumbItem>
    {
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Dashboard", Url = "/" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Resume", Url = "/Resume/Index" },
        new AzureTest.MVC.Models.BreadcrumbItem { Label = "Analytics", IsActive = true }
    };

    var headerModel = new AzureTest.MVC.Models.PageHeaderModel
    {
        Title = "Resume Analytics",
        Subtitle = "Performance indicators, application pipeline health, and status distributions.",
        Icon = "fa-solid fa-chart-pie",
        Breadcrumbs = breadcrumbs
    };
}

<partial name="UiComponents/_PageHeader" model="headerModel" />

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
    <!-- Status Distribution Doughnut Chart -->
    <div class="col-span-1 lg:col-span-5">
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs h-full flex flex-col overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-chart-pie text-brand-600 text-xs"></i>
                    <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Applications by Status</h5>
                </div>
                <span class="text-3xs font-semibold px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-200/80">Pipeline</span>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Applications Over Time Bar Chart -->
    <div class="col-span-1 lg:col-span-7">
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs h-full flex flex-col overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-chart-column text-brand-600 text-xs"></i>
                    <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Applications Over Time</h5>
                </div>
                <span class="text-3xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Timeline</span>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="dateChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Position Title Chart -->
    <div class="col-span-1 lg:col-span-6">
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs h-full flex flex-col overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-briefcase text-brand-600 text-xs"></i>
                    <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Applications by Position</h5>
                </div>
                <span class="text-3xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Titles</span>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="positionChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Location Chart -->
    <div class="col-span-1 lg:col-span-6">
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs h-full flex flex-col overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-location-dot text-brand-600 text-xs"></i>
                    <h5 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Applications by Location</h5>
                </div>
                <span class="text-3xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">Geography</span>
            </div>
            <div class="p-6 flex-1 flex items-center justify-center min-h-[300px]">
                <canvas id="locationChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Data for Status Chart
            const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts.Keys));
            const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts.Values));

            const statusColors = statusLabels.map(label => {
                switch(label) {
                    case 'Rejected': return '#e11d48';
                    case 'Offer': return '#10b981';
                    case 'Interviewing': return '#f59e0b';
                    case 'Applied': return '#3b82f6';
                    case 'Screening': return '#06b6d4';
                    default: return '#64748b';
                }
            });

            const ctxStatus = document.getElementById('statusChart').getContext('2d');
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: statusColors,
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Data for Dates Chart
            const dateLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsByDate.Keys));
            const dateData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApplicationsByDate.Values));

            const ctxDate = document.getElementById('dateChart').getContext('2d');
            new Chart(ctxDate, {
                type: 'bar',
                data: {
                    labels: dateLabels,
                    datasets: [{
                        label: 'Applications',
                        data: dateData,
                        backgroundColor: 'rgba(59, 130, 246, 0.8)',
                        borderColor: '#3b82f6',
                        borderWidth: 1,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Data for Position Chart
            const posLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PositionCounts.Keys));
            const posData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PositionCounts.Values));
            
            const ctxPos = document.getElementById('positionChart').getContext('2d');
            new Chart(ctxPos, {
                type: 'bar',
                data: {
                    labels: posLabels,
                    datasets: [{
                        label: 'Positions',
                        data: posData,
                        backgroundColor: 'rgba(16, 185, 129, 0.8)',
                        borderColor: '#10b981',
                        borderWidth: 1,
                        borderRadius: 8
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Data for Location Chart
            const locLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocationCounts.Keys));
            const locData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocationCounts.Values));
            
            const ctxLoc = document.getElementById('locationChart').getContext('2d');
            new Chart(ctxLoc, {
                type: 'doughnut',
                data: {
                    labels: locLabels,
                    datasets: [{
                        data: locData,
                        backgroundColor: [
                            '#8b5cf6', '#ec4899', '#f59e0b', '#10b981', '#3b82f6', '#6366f1', '#14b8a6', '#f43f5e'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        });
    </script>
}
