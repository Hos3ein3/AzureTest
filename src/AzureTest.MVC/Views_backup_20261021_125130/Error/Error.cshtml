@using Microsoft.AspNetCore.Diagnostics
@using System.Diagnostics
@{
    ViewData["Title"] = "Server Error";
    var exceptionHandlerPathFeature = Context.Features.Get<IExceptionHandlerPathFeature>();
    var exception = exceptionHandlerPathFeature?.Error;
    var path = exceptionHandlerPathFeature?.Path;
    var requestId = Activity.Current?.Id ?? Context.TraceIdentifier;

    var errorSubject = "Auto-Reported Error: 500 Internal Server Error";
    var errorContent = $@"
        <p><strong>Request ID (Correlation ID):</strong> {requestId}</p>
        <p><strong>Path/URL:</strong> {path}</p>
        <p><strong>Exception Message:</strong> {System.Net.WebUtility.HtmlEncode(exception?.Message)}</p>
        <p><strong>Inner Exception:</strong> {System.Net.WebUtility.HtmlEncode(exception?.InnerException?.Message)}</p>
        <pre>{System.Net.WebUtility.HtmlEncode(exception?.StackTrace)}</pre>
    ";
}

<div class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="mb-6 relative inline-block">
        <div class="w-20 h-20 rounded-2xl bg-amber-50 border border-amber-200/80 flex items-center justify-center shadow-2xs text-amber-500 text-3xl">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
    </div>

    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-2xs font-bold uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200/80 mb-3">
        <i class="fa-solid fa-circle-exclamation text-rose-600"></i> Error 500
    </span>

    <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 mb-2">Internal Server Error</h1>
    <p class="text-xs text-slate-500 mb-6 max-w-md">An unexpected condition occurred while processing your request. Correlation ID has been logged for diagnostics.</p>

    <div class="mb-6 w-full max-w-md bg-white border border-slate-200/80 rounded-2xl p-4 shadow-2xs text-left">
        <div class="text-2xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
            <i class="fa-solid fa-bug text-brand-600"></i> Diagnostics Context
        </div>
        <div class="space-y-1.5 text-2xs text-slate-700 font-mono">
            <div class="truncate"><span class="text-slate-400">Request ID:</span> @requestId</div>
            <div class="truncate"><span class="text-slate-400">Path:</span> @path</div>
        </div>
    </div>

    <div class="flex items-center justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-2xs transition-colors">
            <i class="fa-solid fa-house"></i> Back to Safety
        </a>
        <form asp-controller="Ticket" asp-action="Create" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="subject" value="@errorSubject" />
            <input type="hidden" name="content" value="@errorContent" />
            <input type="hidden" name="priority" value="High" />
            <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs transition-colors">
                <i class="fa-solid fa-paper-plane text-amber-500"></i> Report as Ticket
            </button>
        </form>
    </div>
</div>
