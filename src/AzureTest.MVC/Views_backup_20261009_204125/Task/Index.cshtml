@model IEnumerable<AzureTest.Contracts.DTOs.Tasks.TaskDto>
@{
    ViewData["Title"] = "Task Management";
}

<nav aria-label="breadcrumb" class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li class="font-medium text-slate-800" aria-current="page">Tasks</li>
    </ol>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Tasks List -->
    <div class="lg:col-span-2 space-y-4">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-8 text-center text-slate-500">
                <i class="fa-solid fa-list-check text-4xl mb-3 text-slate-300 block"></i>
                <p>No tasks found. Create one to get started!</p>
            </div>
        }
        @foreach(var t in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-4 flex items-start gap-4 hover:border-brand-300 transition-colors">
                <form asp-action="Toggle" method="post" class="mt-1">
                    <input type="hidden" name="id" value="@t.Id" />
                    <button type="submit" class="text-2xl @(t.IsCompleted ? "text-brand-500" : "text-slate-300 hover:text-brand-400") focus:outline-none transition-colors">
                        <i class="fa-solid @(t.IsCompleted ? "fa-circle-check" : "fa-circle")"></i>
                    </button>
                </form>
                
                <div class="flex-1">
                    <h4 class="text-base font-semibold @(t.IsCompleted ? "line-through text-slate-400" : "text-slate-800")">
                        @t.Title
                        @if (!string.IsNullOrEmpty(t.Priority))
                        {
                            <span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-orange-100 text-orange-700">@t.Priority</span>
                        }
                    </h4>
                    @if (!string.IsNullOrEmpty(t.Description))
                    {
                        <p class="text-sm text-slate-500 mt-1 @(t.IsCompleted ? "line-through" : "")">@t.Description</p>
                    }
                    @if (t.StartDate.HasValue || t.EndDate.HasValue)
                    {
                        <p class="text-xs text-slate-400 mt-2">
                            <i class="fa-regular fa-calendar mr-1"></i>
                            @if (t.StartDate.HasValue && t.EndDate.HasValue)
                            {
                                <span>@t.StartDate.Value.ToShortDateString() &rarr; @t.EndDate.Value.ToShortDateString()</span>
                            }
                            else if (t.StartDate.HasValue)
                            {
                                <span>Start: @t.StartDate.Value.ToShortDateString()</span>
                            }
                            else if (t.EndDate.HasValue)
                            {
                                <span>Due: @t.EndDate.Value.ToShortDateString()</span>
                            }
                        </p>
                    }
                </div>

                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this task?');">
                    <input type="hidden" name="id" value="@t.Id" />
                    <button type="submit" class="text-slate-400 hover:text-red-500 p-2 rounded focus:outline-none transition-colors">
                        <i class="fa-regular fa-trash-can"></i>
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- Create Task Form -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden sticky top-6">
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                <h5 class="text-sm font-semibold text-slate-800 m-0"><i class="fa-solid fa-plus mr-2 text-brand-500"></i> New Task</h5>
            </div>
            <div class="p-6">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Task Title <span class="text-red-500">*</span></label>
                        <input type="text" name="title" required class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="e.g. Call John" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
                        <textarea name="description" rows="2" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" placeholder="Optional details..."></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Start Date</label>
                            <input type="date" name="startDate" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">End Date</label>
                            <input type="date" name="endDate" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border" />
                        </div>
                    </div>
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Priority</label>
                        <select name="priority" class="w-full rounded-lg border-slate-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 sm:text-sm px-4 py-2 border">
                            <option value="">None</option>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full inline-flex justify-center rounded-lg border border-transparent bg-brand-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                        Add Task
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
