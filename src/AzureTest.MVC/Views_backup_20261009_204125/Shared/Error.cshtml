@model AzureTest.MVC.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mx-auto p-8 max-w-4xl mt-12">
    <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-lg shadow-sm mb-8">
        <h1 class="text-3xl font-bold text-red-700 mb-2">Error.</h1>
        <h2 class="text-xl text-red-600">An unexpected error occurred while processing your request.</h2>
        
        @if (Model.ShowRequestId)
        {
            <p class="mt-4 text-sm text-red-800">
                <strong>Request ID:</strong> <code class="bg-red-100 px-2 py-1 rounded">@Model.RequestId</code>
            </p>
        }
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 mb-8">
            <h3 class="text-lg font-semibold text-slate-800 mb-2">Help Us Fix This</h3>
            <p class="text-slate-600 mb-4">You can automatically report this crash directly to our support team as a high priority ticket.</p>
            
            <form asp-controller="Ticket" asp-action="ReportBug" method="post">
                <input type="hidden" name="RequestId" value="@Model.RequestId" />
                <input type="hidden" name="ExceptionMessage" value="@Model.ExceptionMessage" />
                <input type="hidden" name="InnerExceptionMessage" value="@Model.InnerExceptionMessage" />
                
                <button type="submit" class="bg-brand-600 text-white px-5 py-2.5 rounded-lg shadow hover:bg-brand-700 transition flex items-center">
                    <i class="fa-solid fa-bug mr-2"></i> Report Bug via Ticket
                </button>
            </form>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ExceptionMessage))
    {
        <div class="bg-slate-900 rounded-xl overflow-hidden shadow-sm">
            <div class="bg-slate-800 px-4 py-2 border-b border-slate-700 flex justify-between items-center">
                <h3 class="text-slate-200 font-mono text-sm">Exception Details (Development)</h3>
            </div>
            <div class="p-4 overflow-x-auto text-sm text-slate-300 font-mono">
                <p class="text-red-400 font-bold mb-2">@Model.ExceptionMessage</p>
                @if (!string.IsNullOrEmpty(Model.InnerExceptionMessage))
                {
                    <p class="text-orange-400 mb-2">Inner: @Model.InnerExceptionMessage</p>
                }
                @if (!string.IsNullOrEmpty(Model.StackTrace))
                {
                    <pre class="whitespace-pre-wrap text-xs text-slate-400 mt-4 border-t border-slate-700 pt-4">@Model.StackTrace</pre>
                }
            </div>
        </div>
    }
</div>
