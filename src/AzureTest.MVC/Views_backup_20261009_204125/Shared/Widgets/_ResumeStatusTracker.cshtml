@model AzureTest.Contracts.DTOs.Resumes.ResumeDto
<div class="h-full w-full bg-slate-900 rounded-xl shadow-lg p-5 text-white flex flex-col justify-between">
    <div class="flex justify-between items-start mb-4">
        <div>
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Application Status</p>
            <h3 class="text-xl font-bold text-white">@Model.Status.ToString()</h3>
        </div>
        <div class="px-2.5 py-1 rounded-full bg-slate-800 text-xs font-medium text-slate-300 ring-1 ring-slate-700">
            @Model.Source.ToString()
        </div>
    </div>
    
    @{
        var statuses = new[] { "Draft", "Applied", "Interview", "Offer", "Rejected" };
        var currentIndex = Array.IndexOf(statuses, Model.Status.ToString());
        if (currentIndex == -1) currentIndex = 1; // fallback
    }
    
    <div class="mt-2">
        <div class="flex justify-between mb-2">
            @for (int i = 0; i < 4; i++)
            {
                <div class="flex flex-col items-center flex-1">
                    <div class="h-3 w-3 rounded-full mb-1 @(i <= currentIndex ? "bg-brand-500 shadow-[0_0_8px_rgba(59,130,246,0.8)]" : "bg-slate-700")"></div>
                </div>
            }
        </div>
        <div class="relative h-1 w-full bg-slate-800 rounded-full overflow-hidden -mt-5 mb-4 -z-10 mx-auto" style="width: 80%;">
            <div class="h-full bg-brand-500 rounded-full transition-all duration-500" style="width: @(currentIndex * 33.33)%;"></div>
        </div>
        <div class="flex justify-between px-1">
            <span class="text-[10px] text-slate-400 font-medium">Applied</span>
            <span class="text-[10px] text-slate-400 font-medium">Interview</span>
            <span class="text-[10px] text-slate-400 font-medium text-right">Offer</span>
        </div>
    </div>
</div>
