@model AzureTest.MVC.Models.HomeDashboardViewModel

<!-- Tickets Widget -->
<div class="col-span-1 bg-white rounded-xl shadow-sm border border-slate-100 h-full flex flex-col">
    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-slate-800 m-0">@(Model.IsAdmin ? "Unanswered Tickets" : "Ticket Updates")</h5>
        <a asp-controller="Ticket" asp-action="Index" class="text-xs text-brand-600 hover:text-brand-500 font-medium">View All &rarr;</a>
    </div>
    <div class="p-6 flex-1 overflow-y-auto custom-scrollbar">
        @if (!Model.Tickets.Any())
        {
            <div class="text-center text-slate-400 mt-6">
                <i class="fa-solid fa-ticket text-3xl mb-2 block"></i>
                <p class="text-sm">No action required.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var t in Model.Tickets.Take(4))
                {
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-circle-exclamation text-amber-500 text-sm"></i>
                        <div class="flex-1 truncate">
                            <a asp-controller="Ticket" asp-action="Details" asp-route-id="@t.Id" class="text-sm font-medium text-slate-700 hover:text-brand-600 block truncate">@t.Subject</a>
                            <p class="text-xs text-slate-500">Opened: @t.CreatedOn.ToLocalTime().ToString("MMM dd")</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
