@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout.Auth";
    var returnUrl = Context.Request.Query["ReturnUrl"].ToString();
    if (string.IsNullOrEmpty(returnUrl)) {
        returnUrl = "Unknown URL";
    }
    var errorSubject = "Request Access to Restricted Page";
    var errorContent = $"<p>I am requesting access to the following page, but I received an Access Denied error:</p><p><strong>URL:</strong> {System.Net.WebUtility.HtmlEncode(returnUrl)}</p>";
}
<div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-6">
            <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h2 class="text-center text-3xl font-extrabold text-slate-900">
            Access Denied
        </h2>
        <p class="mt-2 text-center text-sm text-slate-600">
            You do not have permission to access this page.
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 text-center">
            <a href="/" class="w-full flex justify-center py-2 px-4 mb-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500">
                Return to Dashboard
            </a>
            <form asp-controller="Ticket" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subject" value="@errorSubject" />
                <input type="hidden" name="content" value="@errorContent" />
                <input type="hidden" name="priority" value="Medium" />
                <button type="submit" class="w-full flex items-center justify-center py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition-colors">
                    <i class="fa-solid fa-paper-plane mr-2"></i> Request Access via Ticket
                </button>
            </form>
        </div>
    </div>
</div>
