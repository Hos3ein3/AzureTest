@model IReadOnlyList<AzureTest.Application.Permissions.PermissionDto>

<div class="container mx-auto p-4">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-slate-800">Permissions</h1>
        <div class="flex items-center space-x-4">
            <a asp-action="Create" class="bg-brand-600 text-white px-4 py-2 rounded shadow hover:bg-brand-700 transition">Create New</a>
            <form asp-action="Sync" method="post">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700 transition">Sync Permissions</button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search / Filter -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex justify-between items-center">
        <form method="get" class="flex items-center w-full max-w-md">
            <input type="hidden" name="sort" value="@ViewBag.Sort" />
            <input type="hidden" name="dir" value="@ViewBag.Dir" />
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fa-solid fa-search text-slate-400"></i>
                </div>
                <input type="text" name="search" value="@ViewBag.Search" class="block w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-brand-500 focus:border-brand-500" placeholder="Search permissions...">
            </div>
            <button type="submit" class="ml-3 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-lg transition-colors">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Index" class="ml-2 text-sm text-brand-600 hover:text-brand-800">Clear</a>
            }
        </form>
    </div>

    <div class="overflow-x-auto bg-white rounded shadow border border-slate-200">
        <table class="min-w-full leading-normal">
            <thead>
                <tr>
                    @{
                        var currentSort = ViewBag.Sort as string;
                        var currentDir = ViewBag.Dir as string;
                        var nextDir = currentDir == "asc" ? "desc" : "asc";
                    }
                    <th class="px-5 py-3 border-b border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="ControllerName" asp-route-dir="@(currentSort == "ControllerName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 flex items-center">
                            Controller @if(currentSort == "ControllerName") { <i class="fa-solid fa-sort-@currentDir ml-1"></i> } else { <i class="fa-solid fa-sort text-slate-300 ml-1"></i> }
                        </a>
                    </th>
                    <th class="px-5 py-3 border-b border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="ActionName" asp-route-dir="@(currentSort == "ActionName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 flex items-center">
                            Action @if(currentSort == "ActionName") { <i class="fa-solid fa-sort-@currentDir ml-1"></i> } else { <i class="fa-solid fa-sort text-slate-300 ml-1"></i> }
                        </a>
                    </th>
                    <th class="px-5 py-3 border-b border-gray-200 bg-gray-50 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="DisplayName" asp-route-dir="@(currentSort == "DisplayName" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 flex items-center">
                            Display Name @if(currentSort == "DisplayName") { <i class="fa-solid fa-sort-@currentDir ml-1"></i> } else { <i class="fa-solid fa-sort text-slate-300 ml-1"></i> }
                        </a>
                    </th>
                    <th class="px-5 py-3 border-b border-gray-200 bg-gray-50 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        <a asp-action="Index" asp-route-sort="IsRestricted" asp-route-dir="@(currentSort == "IsRestricted" ? nextDir : "asc")" asp-route-search="@ViewBag.Search" class="hover:text-brand-600 flex items-center justify-center">
                            Restricted @if(currentSort == "IsRestricted") { <i class="fa-solid fa-sort-@currentDir ml-1"></i> } else { <i class="fa-solid fa-sort text-slate-300 ml-1"></i> }
                        </a>
                    </th>
                    <th class="px-5 py-3 border-b border-gray-200 bg-gray-50 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var perm in Model)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-4 bg-white text-sm">
                            <div class="font-medium text-slate-900">@perm.ControllerName</div>
                        </td>
                        <td class="px-5 py-4 bg-white text-sm text-slate-600">@perm.ActionName</td>
                        <td class="px-5 py-4 bg-white text-sm text-slate-600">
                            <div>@perm.DisplayName</div>
                            <div class="text-xs text-slate-400">@perm.Description</div>
                        </td>
                        <td class="px-5 py-4 bg-white text-sm text-center">
                            @if(perm.IsRestricted) {
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Yes</span>
                            } else {
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">No</span>
                            }
                        </td>
                        <td class="px-5 py-4 bg-white text-sm text-center">
                            <form asp-action="ToggleRestriction" method="post" class="inline">
                                <input type="hidden" name="id" value="@perm.Id" />
                                <input type="hidden" name="isRestricted" value="@(perm.IsRestricted ? "false" : "true")" />
                                <button type="submit" class="text-indigo-600 hover:text-indigo-900 ml-2 font-medium">Toggle</button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-5 py-8 text-center text-slate-500">
                            No permissions found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="px-5 py-4 border-t border-gray-200 bg-gray-50 flex flex-col xs:flex-row items-center xs:justify-between">
                <span class="text-sm text-gray-700">
                    Showing Page <span class="font-semibold">@ViewBag.CurrentPage</span> of <span class="font-semibold">@ViewBag.TotalPages</span>
                </span>
                <div class="inline-flex mt-2 xs:mt-0 space-x-2">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-sort="@ViewBag.Sort" asp-route-dir="@ViewBag.Dir" asp-route-search="@ViewBag.Search"
                           class="text-sm bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded transition-colors">
                            Prev
                        </a>
                    }
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-sort="@ViewBag.Sort" asp-route-dir="@ViewBag.Dir" asp-route-search="@ViewBag.Search"
                           class="text-sm bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded transition-colors">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
