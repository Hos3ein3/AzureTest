@model AzureTest.Contracts.DTOs.Debts.DebtDto
@{
    ViewData["Title"] = "Debt Details";
}

<nav aria-label="breadcrumb" class="mb-6">
    <ol class="flex items-center space-x-2 text-sm text-slate-500">
        <li>
            <a asp-action="Index" class="hover:text-brand-600 transition-colors">Debts</a>
        </li>
        <li>
            <i class="fa-solid fa-chevron-right text-xs mx-1"></i>
        </li>
        <li class="font-medium text-slate-800" aria-current="page">Details</li>
    </ol>
</nav>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-3xl">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
        <h5 class="text-lg font-semibold text-slate-800 m-0">Debt Details</h5>
        <div class="flex space-x-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white py-1.5 px-4 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors">
                <i class="fa-regular fa-pen-to-square mr-2"></i> Edit
            </a>
            <a asp-action="Index" class="inline-flex items-center justify-center rounded-lg border border-transparent bg-slate-800 py-1.5 px-4 text-sm font-medium text-white shadow-sm hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2 transition-colors">
                Back to List
            </a>
        </div>
    </div>
    <div class="p-6 md:p-8">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Person</dt>
                <dd class="mt-1 text-sm text-slate-900">@Model.DebtPersonName</dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Amount</dt>
                <dd class="mt-1 text-sm text-slate-900 font-semibold">@Model.Amount.ToString("C")</dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Date of Borrow</dt>
                <dd class="mt-1 text-sm text-slate-900">@Model.DateOfBorrow.ToShortDateString()</dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Date of Return</dt>
                <dd class="mt-1 text-sm text-slate-900">@(Model.DateOfReturn?.ToShortDateString() ?? "Not set")</dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Promissed Return Date</dt>
                <dd class="mt-1 text-sm text-slate-900">@(Model.PromissedReturnDate?.ToShortDateString() ?? "Not set")</dd>
            </div>
            <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-slate-500">Profit</dt>
                <dd class="mt-1 text-sm text-slate-900 font-semibold">@Model.Profit.ToString("C")</dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="text-sm font-medium text-slate-500">Description</dt>
                <dd class="mt-1 text-sm text-slate-900">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
            </div>
            <div class="sm:col-span-2">
                <dt class="text-sm font-medium text-slate-500">Status</dt>
                <dd class="mt-1 text-sm text-slate-900">
                    @if (Model.IsDone)
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Done
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                            Pending
                        </span>
                    }
                </dd>
            </div>
        </dl>
    </div>
</div>
