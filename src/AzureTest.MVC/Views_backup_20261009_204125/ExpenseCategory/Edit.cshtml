@model AzureTest.Domain.Documents.ExpenseCategory
@{
    ViewData["Title"] = "Edit Expense Category";
}

<div class="mb-6 flex items-center justify-between">
    <div class="flex items-center space-x-3">
        <a asp-action="Index" class="text-slate-400 hover:text-slate-600 transition-colors">
            <i class="fa-solid fa-arrow-left text-lg"></i>
        </a>
        <h1 class="text-2xl font-bold text-slate-800">Edit Category</h1>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden max-w-2xl">
    <form asp-action="Edit" method="post" class="p-6 sm:p-8">
        <div asp-validation-summary="ModelOnly" class="mb-6 p-4 rounded-lg bg-red-50 text-red-700 text-sm border border-red-200 hidden"></div>
        <input type="hidden" asp-for="Id" />

        <div class="space-y-6">
            <div>
                <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1">Name <span class="text-red-500">*</span></label>
                <input asp-for="Name" class="block w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors bg-slate-50 focus:bg-white text-slate-900" placeholder="e.g. Groceries, Rent, Utilities" required />
                <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
            </div>
        </div>

        <div class="mt-8 flex items-center justify-end space-x-4 pt-6 border-t border-slate-100">
            <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors flex items-center">
                <i class="fa-solid fa-check mr-2"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
