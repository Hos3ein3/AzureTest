
@model AzureTest.Domain.Documents.IdentitySetting

@{
    ViewData["Title"] = "Identity Settings";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800 dark:text-white">Identity & Auth Settings</h1>
    <p class="text-slate-500">Configure global authentication flows and defaults.</p>
</div>

<div class="bg-red-50 dark:bg-red-900/30 border-l-4 border-red-500 p-4 mb-6 rounded shadow-sm">
    <div class="flex items-start">
        <div class="flex-shrink-0">
            <i class="fa-solid fa-triangle-exclamation text-red-500 mt-1"></i>
        </div>
        <div class="ml-3">
            <h3 class="text-sm font-bold text-red-800 dark:text-red-200">Warning: Proceed with Caution</h3>
            <p class="text-sm text-red-700 dark:text-red-300 mt-1">
                Changing these settings can alter the core authentication flow and default access rights. 
                Invalid redirect URLs or incorrectly assigned roles might prevent users from logging in or grant them unintended privileges.
            </p>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 px-4 py-3 rounded mb-6 flex items-center shadow-sm">
        <i class="fa-solid fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="bg-white dark:bg-slate-800 shadow-sm border border-slate-100 dark:border-slate-700 rounded-xl p-6">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="form-group">
                <label asp-for="RedirectAfterLogin" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Redirect After Login</label>
                <input asp-for="RedirectAfterLogin" class="form-input w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 bg-white dark:bg-slate-700 dark:text-white focus:outline-none focus:ring-1 focus:ring-brand-500" placeholder="/Home/Index" />
                <span asp-validation-for="RedirectAfterLogin" class="text-xs text-red-500"></span>
            </div>

            <div class="form-group">
                <label asp-for="RedirectAfterRegister" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Redirect After Register</label>
                <input asp-for="RedirectAfterRegister" class="form-input w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 bg-white dark:bg-slate-700 dark:text-white focus:outline-none focus:ring-1 focus:ring-brand-500" placeholder="/Auth/Login" />
                <span asp-validation-for="RedirectAfterRegister" class="text-xs text-red-500"></span>
            </div>

            <div class="form-group">
                <label asp-for="RolesForRegister" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Roles Assigned on Register</label>
                <select asp-for="RolesForRegister" asp-items="ViewBag.Roles" multiple class="form-input w-full border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 bg-white dark:bg-slate-700 dark:text-white focus:outline-none focus:ring-1 focus:ring-brand-500 h-32"></select>
                <span asp-validation-for="RolesForRegister" class="text-xs text-red-500"></span>
                <p class="text-xs text-slate-500 mt-1">Hold Ctrl/Cmd to select multiple roles.</p>
            </div>

            <div class="form-group flex flex-col justify-center">
                <label class="flex items-center space-x-3 cursor-pointer">
                    <input asp-for="StayLoginAfterRegister" type="checkbox" class="form-checkbox h-5 w-5 text-brand-600 border-slate-300 rounded focus:ring-brand-500 bg-white dark:bg-slate-700" />
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Auto-login After Registration</span>
                </label>
                <p class="text-xs text-slate-500 mt-2 ml-8">If checked, new users are automatically signed in after successful registration and sent to the Login redirect.</p>
            </div>
        </div>

        <div class="mt-8 flex justify-end">
            <button type="submit" class="px-6 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg shadow-sm font-medium transition-colors">
                <i class="fa-solid fa-save mr-2"></i> Save Settings
            </button>
        </div>
    </form>
</div>
