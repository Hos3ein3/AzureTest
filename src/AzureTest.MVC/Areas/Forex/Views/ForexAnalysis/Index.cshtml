@model (AzureTest.Contracts.DTOs.Forex.TechnicalOverviewDto Technical, AzureTest.Contracts.DTOs.Forex.FundamentalOverviewDto Fundamental)
@{
    var symbol = ViewBag.Symbol as string ?? "EUR/USD";
    var timeframe = (ForexTimeframe)(ViewBag.Timeframe ?? ForexTimeframe.H1);
    ViewData["Title"] = $"Forex Analysis Hub - {symbol}";
    var t = Model.Technical;
    var f = Model.Fundamental;
    var ind = t.Indicators;
    var p = t.Pivots;
    var mtf = t.MultiTimeframe;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-compass-drafting"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Forex Analysis Hub</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Integrated Technical Signals, Macro Drivers, Currency Strength & COT Sentiment</p>
                </div>
            </div>
        </div>

        <!-- Controls: Symbol & Sub-Navigation -->
        <div class="flex flex-wrap items-center gap-2">
            <form method="get" asp-action="Index" class="flex items-center gap-2">
                <select name="symbol" onchange="this.form.submit()" class="px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200">
                    @foreach (var s in new[] { "EUR/USD", "GBP/USD", "USD/JPY", "AUD/USD", "USD/CAD", "USD/CHF", "NZD/USD", "EUR/GBP", "XAU/USD" })
                    {
                        <option value="@s" selected="@(s == symbol)">@s</option>
                    }
                </select>
                <select name="timeframe" onchange="this.form.submit()" class="px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200">
                    @foreach (ForexTimeframe tf in Enum.GetValues(typeof(ForexTimeframe)))
                    {
                        <option value="@tf" selected="@(tf == timeframe)">@tf</option>
                    }
                </select>
            </form>

            <a asp-action="Technical" asp-route-symbol="@symbol" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors">
                <i class="fa-solid fa-chart-simple"></i> Indicators
            </a>
            <a asp-action="Strength" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors">
                <i class="fa-solid fa-gauge-high"></i> Strength & Correlation
            </a>
            <a asp-action="Fundamental" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors">
                <i class="fa-solid fa-landmark"></i> Fundamentals
            </a>
        </div>
    </div>

    <!-- Quick Status Ticker -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Trend Verdict -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <div class="text-2xs font-semibold uppercase tracking-wider text-slate-400">Technical Verdict (@symbol)</div>
            <div class="mt-1 flex items-center justify-between">
                <span class="text-base font-bold text-slate-800 dark:text-white">@ind.TrendSummary</span>
                <span class="px-2 py-0.5 rounded-full text-2xs font-bold @(ind.TrendSummary.Contains("Bullish") ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300")">
                    @timeframe
                </span>
            </div>
            <div class="mt-2 text-2xs text-slate-500 font-mono">Price: @ind.Price.ToString("F5")</div>
        </div>

        <!-- RSI Status -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <div class="text-2xs font-semibold uppercase tracking-wider text-slate-400">RSI (14) Momentum</div>
            <div class="mt-1 flex items-center justify-between">
                <span class="text-base font-bold font-mono @(ind.Rsi14 > 70 ? "text-rose-600" : ind.Rsi14 < 30 ? "text-emerald-600" : "text-slate-800 dark:text-white")">
                    @ind.Rsi14.ToString("F1")
                </span>
                <span class="text-2xs text-slate-500 font-medium">
                    @(ind.Rsi14 > 70 ? "Overbought" : ind.Rsi14 < 30 ? "Oversold" : "Neutral")
                </span>
            </div>
            <div class="w-full bg-slate-200 dark:bg-slate-700 h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="h-full bg-brand-500 rounded-full" style="width: @Math.Min(100, Math.Max(0, (float)ind.Rsi14))%"></div>
            </div>
        </div>

        <!-- Multi-Timeframe Alignment -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <div class="text-2xs font-semibold uppercase tracking-wider text-slate-400">MTF Alignment</div>
            <div class="mt-1 flex items-center justify-between">
                <span class="text-sm font-bold text-slate-800 dark:text-white">@mtf.OverallVerdict</span>
                <div class="flex items-center gap-1 text-2xs font-mono font-bold">
                    <span class="@(mtf.SignalM15 == "BUY" ? "text-emerald-600" : "text-rose-600")">M15</span>
                    <span class="@(mtf.SignalH1 == "BUY" ? "text-emerald-600" : "text-rose-600")">H1</span>
                    <span class="@(mtf.SignalH4 == "BUY" ? "text-emerald-600" : "text-rose-600")">H4</span>
                    <span class="@(mtf.SignalD1 == "BUY" ? "text-emerald-600" : "text-rose-600")">D1</span>
                </div>
            </div>
            <div class="mt-2 text-2xs text-slate-400">4-Timeframe directional confluence</div>
        </div>

        <!-- Next High Impact Event -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
            <div class="text-2xs font-semibold uppercase tracking-wider text-slate-400">Next High Impact Release</div>
            @{
                var nextHigh = f.UpcomingEvents.FirstOrDefault(e => e.Impact == ForexImpactLevel.High);
            }
            @if (nextHigh != null)
            {
                <div class="mt-1 flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-800 dark:text-white truncate">@nextHigh.Currency - @nextHigh.Title</span>
                    <span class="px-1.5 py-0.5 rounded text-3xs font-bold bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">HIGH</span>
                </div>
                <div class="mt-2 text-2xs font-mono text-slate-500">
                    @nextHigh.EventTimeUtc.ToString("HH:mm") UTC (@nextHigh.Country)
                </div>
            }
            else
            {
                <div class="mt-1 text-xs text-slate-500">No imminent high-impact releases</div>
            }
        </div>
    </div>

    <!-- Main Grid: Technical Indicators & Fundamental Drivers -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Technical Indicators & Pivots -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-5">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-chart-line text-blue-500"></i> Moving Averages & Bands
                </h2>
                <a asp-action="Technical" asp-route-symbol="@symbol" class="text-xs text-brand-600 hover:text-brand-700 font-semibold">View Detail &rarr;</a>
            </div>

            <!-- Indicator Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 font-mono text-xs">
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <div class="text-2xs font-sans text-slate-400">EMA 9 / 21</div>
                    <div class="font-bold text-slate-700 dark:text-slate-300 mt-1">@ind.Ema9.ToString("F5")</div>
                    <div class="text-2xs text-slate-500">@ind.Ema21.ToString("F5")</div>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <div class="text-2xs font-sans text-slate-400">EMA 50 / 200</div>
                    <div class="font-bold text-slate-700 dark:text-slate-300 mt-1">@ind.Ema50.ToString("F5")</div>
                    <div class="text-2xs text-slate-500">@ind.Ema200.ToString("F5")</div>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <div class="text-2xs font-sans text-slate-400">ATR 14 (Pips)</div>
                    <div class="font-bold text-slate-700 dark:text-slate-300 mt-1">@(ind.Atr14 * 10000m > 1 ? (ind.Atr14 * 10000m).ToString("F1") : ind.Atr14.ToString("F5"))</div>
                    <div class="text-2xs text-slate-500">Volatility gauge</div>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <div class="text-2xs font-sans text-slate-400">Bollinger Upper</div>
                    <div class="font-bold text-slate-700 dark:text-slate-300 mt-1">@ind.BollingerUpper.ToString("F5")</div>
                    <div class="text-2xs text-slate-500">+2 Std Dev</div>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <div class="text-2xs font-sans text-slate-400">Bollinger Middle</div>
                    <div class="font-bold text-slate-700 dark:text-slate-300 mt-1">@ind.BollingerMiddle.ToString("F5")</div>
                    <div class="text-2xs text-slate-500">20 SMA</div>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <div class="text-2xs font-sans text-slate-400">Bollinger Lower</div>
                    <div class="font-bold text-slate-700 dark:text-slate-300 mt-1">@ind.BollingerLower.ToString("F5")</div>
                    <div class="text-2xs text-slate-500">-2 Std Dev</div>
                </div>
            </div>

            <!-- Classic Pivot Points Table -->
            <div class="mt-4">
                <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">Classic Pivot Points (@p.Method)</div>
                <div class="grid grid-cols-7 gap-1 text-center font-mono text-2xs">
                    <div class="p-2 bg-rose-500/10 text-rose-600 rounded">
                        <div class="font-sans font-bold">R3</div>
                        <div class="mt-1">@p.R3.ToString("F5")</div>
                    </div>
                    <div class="p-2 bg-rose-500/10 text-rose-600 rounded">
                        <div class="font-sans font-bold">R2</div>
                        <div class="mt-1">@p.R2.ToString("F5")</div>
                    </div>
                    <div class="p-2 bg-rose-500/10 text-rose-600 rounded">
                        <div class="font-sans font-bold">R1</div>
                        <div class="mt-1">@p.R1.ToString("F5")</div>
                    </div>
                    <div class="p-2 bg-amber-500/20 text-amber-700 dark:text-amber-300 rounded font-bold">
                        <div class="font-sans">PIVOT</div>
                        <div class="mt-1">@p.Pivot.ToString("F5")</div>
                    </div>
                    <div class="p-2 bg-emerald-500/10 text-emerald-600 rounded">
                        <div class="font-sans font-bold">S1</div>
                        <div class="mt-1">@p.S1.ToString("F5")</div>
                    </div>
                    <div class="p-2 bg-emerald-500/10 text-emerald-600 rounded">
                        <div class="font-sans font-bold">S2</div>
                        <div class="mt-1">@p.S2.ToString("F5")</div>
                    </div>
                    <div class="p-2 bg-emerald-500/10 text-emerald-600 rounded">
                        <div class="font-sans font-bold">S3</div>
                        <div class="mt-1">@p.S3.ToString("F5")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Central Bank Interest Rates & COT Positioning -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-5">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-landmark text-emerald-500"></i> Central Bank Rates & Yields
                </h2>
                <a asp-action="Fundamental" class="text-xs text-brand-600 hover:text-brand-700 font-semibold">View All &rarr;</a>
            </div>

            <!-- Rate table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 font-semibold uppercase text-2xs border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="px-3 py-2">Central Bank</th>
                            <th class="px-3 py-2">Rate</th>
                            <th class="px-3 py-2">Trend</th>
                            <th class="px-3 py-2">Last Change</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700 font-mono">
                        @foreach (var cb in f.CentralBankRates.Take(5))
                        {
                            <tr>
                                <td class="px-3 py-2 font-sans font-medium text-slate-700 dark:text-slate-300">
                                    @cb.Currency (@cb.CentralBank)
                                </td>
                                <td class="px-3 py-2 font-bold text-slate-800 dark:text-white">@cb.InterestRate.ToString("F2")%</td>
                                <td class="px-3 py-2 font-sans">
                                    <span class="px-2 py-0.5 rounded text-2xs font-semibold @(cb.Trend == "Hawkish" ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : cb.Trend == "Dovish" ? "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300" : "bg-slate-100 text-slate-600 dark:bg-slate-700")">
                                        @cb.Trend
                                    </span>
                                </td>
                                <td class="px-3 py-2 text-slate-400">@cb.LastChangeDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- CFTC Commitments of Traders (COT) -->
            <div class="pt-2">
                <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">CFTC COT Institutional Positioning</div>
                <div class="space-y-2">
                    @foreach (var cot in f.CotReports.Take(3))
                    {
                        var isNetLong = cot.NetPositions >= 0;
                        <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-between text-xs font-mono">
                            <div>
                                <span class="font-sans font-bold text-slate-800 dark:text-white">@cot.Currency</span>
                                <span class="text-2xs font-sans text-slate-400 ml-1">Non-Commercials</span>
                            </div>
                            <div class="text-right">
                                <span class="font-bold @(isNetLong ? "text-emerald-600" : "text-rose-600")">
                                    @(isNetLong ? "+" : "")@cot.NetPositions.ToString("N0")
                                </span>
                                <span class="text-2xs text-slate-400 block font-sans">contracts net</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Currency Strength & Pair Correlations Snapshot -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-gauge-high text-brand-500"></i> Currency Strength Meter (0 - 100)
            </h2>
            <a asp-action="Strength" class="text-xs text-brand-600 hover:text-brand-700 font-semibold">Full Correlation Matrix &rarr;</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
            @foreach (var cs in t.CurrencyStrength)
            {
                var isStrong = cs.StrengthScore >= 60;
                var isWeak = cs.StrengthScore <= 40;
                <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 text-center">
                    <div class="text-xs font-bold text-slate-800 dark:text-white">@cs.Currency</div>
                    <div class="text-lg font-mono font-bold mt-1 @(isStrong ? "text-emerald-600" : isWeak ? "text-rose-600" : "text-slate-600 dark:text-slate-400")">
                        @cs.StrengthScore.ToString("F0")
                    </div>
                    <div class="w-full bg-slate-200 dark:bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
                        <div class="h-full @(isStrong ? "bg-emerald-500" : isWeak ? "bg-rose-500" : "bg-slate-400")" style="width: @cs.StrengthScore%"></div>
                    </div>
                    <div class="text-3xs font-semibold uppercase mt-1 @(isStrong ? "text-emerald-600" : isWeak ? "text-rose-600" : "text-slate-400")">
                        @cs.Status
                    </div>
                </div>
            }
        </div>
    </div>
</div>
