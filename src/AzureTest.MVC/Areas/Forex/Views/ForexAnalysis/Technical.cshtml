@model (AzureTest.Contracts.DTOs.Forex.TechnicalOverviewDto Technical, AzureTest.Contracts.DTOs.Forex.FundamentalOverviewDto Fundamental)
@{
    var symbol = ViewBag.Symbol as string ?? "EUR/USD";
    var timeframe = (ForexTimeframe)(ViewBag.Timeframe ?? ForexTimeframe.H1);
    ViewData["Title"] = $"Technical Indicators - {symbol}";
    var t = Model.Technical;
    var ind = t.Indicators;
    var p = t.Pivots;
    var mtf = t.MultiTimeframe;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Technical Indicators & Support/Resistance</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Trend indicators, momentum oscillators, volatility bands, and multi-timeframe confirmation</p>
                </div>
            </div>
        </div>

        <!-- Controls: Pair & Timeframe -->
        <div class="flex flex-wrap items-center gap-3">
            <form method="get" asp-action="Technical" class="flex items-center gap-2">
                <select name="symbol" onchange="this.form.submit()" class="px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200">
                    @foreach (var s in new[] { "EUR/USD", "GBP/USD", "USD/JPY", "AUD/USD", "USD/CAD", "USD/CHF", "NZD/USD", "EUR/GBP", "XAU/USD" })
                    {
                        <option value="@s" selected="@(s == symbol)">@s</option>
                    }
                </select>
                <select name="timeframe" onchange="this.form.submit()" class="px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200">
                    @foreach (ForexTimeframe tf in Enum.GetValues(typeof(ForexTimeframe)))
                    {
                        <option value="@tf" selected="@(tf == timeframe)">@tf</option>
                    }
                </select>
            </form>
            <a asp-action="Index" asp-route-symbol="@symbol" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl">
                Hub Overview
            </a>
        </div>
    </div>

    <!-- Multi-Timeframe Alignment Ribbon -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-700">
            <div>
                <h2 class="text-sm font-bold text-slate-800 dark:text-white">Multi-Timeframe Trend Confluence</h2>
                <p class="text-xs text-slate-400">Alignment across short (M15), intermediate (H1, H4), and macro (D1) trends</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-slate-500">Overall Signal:</span>
                <span class="px-3 py-1 rounded-full text-xs font-bold @(mtf.OverallVerdict.Contains("BUY") ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : mtf.OverallVerdict.Contains("SELL") ? "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300")">
                    @mtf.OverallVerdict
                </span>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4 text-center">
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-2xs font-semibold text-slate-400 block uppercase">15-Minute (M15)</span>
                <span class="text-lg font-bold block mt-1 @(mtf.SignalM15 == "BUY" ? "text-emerald-600" : "text-rose-600")">
                    @mtf.SignalM15
                </span>
                <span class="text-2xs text-slate-400">Intraday Entry</span>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-2xs font-semibold text-slate-400 block uppercase">1-Hour (H1)</span>
                <span class="text-lg font-bold block mt-1 @(mtf.SignalH1 == "BUY" ? "text-emerald-600" : "text-rose-600")">
                    @mtf.SignalH1
                </span>
                <span class="text-2xs text-slate-400">Session Trend</span>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-2xs font-semibold text-slate-400 block uppercase">4-Hour (H4)</span>
                <span class="text-lg font-bold block mt-1 @(mtf.SignalH4 == "BUY" ? "text-emerald-600" : "text-rose-600")">
                    @mtf.SignalH4
                </span>
                <span class="text-2xs text-slate-400">Swing Trend</span>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-2xs font-semibold text-slate-400 block uppercase">Daily (D1)</span>
                <span class="text-lg font-bold block mt-1 @(mtf.SignalD1 == "BUY" ? "text-emerald-600" : "text-rose-600")">
                    @mtf.SignalD1
                </span>
                <span class="text-2xs text-slate-400">Macro Direction</span>
            </div>
        </div>
    </div>

    <!-- Moving Averages & Oscillators Tables -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Moving Averages -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-water text-cyan-500"></i> Moving Averages Analysis
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 font-sans text-2xs uppercase">
                        <tr>
                            <th class="px-3 py-2">Indicator</th>
                            <th class="px-3 py-2">Value</th>
                            <th class="px-3 py-2 font-sans">Price Relation</th>
                            <th class="px-3 py-2 font-sans text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">EMA 9</td>
                            <td class="px-3 py-2.5">@ind.Ema9.ToString("F5")</td>
                            <td class="px-3 py-2.5 font-sans @(ind.Price >= ind.Ema9 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema9 ? "Above" : "Below")
                            </td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.Price >= ind.Ema9 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema9 ? "BUY" : "SELL")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">EMA 21</td>
                            <td class="px-3 py-2.5">@ind.Ema21.ToString("F5")</td>
                            <td class="px-3 py-2.5 font-sans @(ind.Price >= ind.Ema21 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema21 ? "Above" : "Below")
                            </td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.Price >= ind.Ema21 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema21 ? "BUY" : "SELL")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">EMA 50</td>
                            <td class="px-3 py-2.5">@ind.Ema50.ToString("F5")</td>
                            <td class="px-3 py-2.5 font-sans @(ind.Price >= ind.Ema50 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema50 ? "Above" : "Below")
                            </td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.Price >= ind.Ema50 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema50 ? "BUY" : "SELL")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">EMA 200</td>
                            <td class="px-3 py-2.5">@ind.Ema200.ToString("F5")</td>
                            <td class="px-3 py-2.5 font-sans @(ind.Price >= ind.Ema200 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema200 ? "Above (Bullish Trend)" : "Below (Bearish Trend)")
                            </td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.Price >= ind.Ema200 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Ema200 ? "BUY" : "SELL")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">SMA 50</td>
                            <td class="px-3 py-2.5">@ind.Sma50.ToString("F5")</td>
                            <td class="px-3 py-2.5 font-sans @(ind.Price >= ind.Sma50 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Sma50 ? "Above" : "Below")
                            </td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.Price >= ind.Sma50 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.Price >= ind.Sma50 ? "BUY" : "SELL")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Oscillators & Momentum -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-wave-square text-purple-500"></i> Momentum & Oscillators
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 font-sans text-2xs uppercase">
                        <tr>
                            <th class="px-3 py-2">Oscillator</th>
                            <th class="px-3 py-2">Value</th>
                            <th class="px-3 py-2 font-sans">Condition</th>
                            <th class="px-3 py-2 font-sans text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">RSI (14)</td>
                            <td class="px-3 py-2.5 font-bold">@ind.Rsi14.ToString("F2")</td>
                            <td class="px-3 py-2.5 font-sans">
                                @(ind.Rsi14 > 70 ? "Overbought (>70)" : ind.Rsi14 < 30 ? "Oversold (<30)" : "Neutral Range")
                            </td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.Rsi14 > 70 ? "text-rose-600" : ind.Rsi14 < 30 ? "text-emerald-600" : "text-slate-500")">
                                @(ind.Rsi14 > 70 ? "SELL" : ind.Rsi14 < 30 ? "BUY" : "NEUTRAL")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">MACD (12,26,9)</td>
                            <td class="px-3 py-2.5">@ind.MacdValue.ToString("F5")</td>
                            <td class="px-3 py-2.5 font-sans">Signal: @ind.MacdSignal.ToString("F5")</td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.MacdHistogram >= 0 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.MacdHistogram >= 0 ? "BUY" : "SELL")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">MACD Histogram</td>
                            <td class="px-3 py-2.5 font-bold @(ind.MacdHistogram >= 0 ? "text-emerald-600" : "text-rose-600")">
                                @ind.MacdHistogram.ToString("F5")
                            </td>
                            <td class="px-3 py-2.5 font-sans">Momentum Delta</td>
                            <td class="px-3 py-2.5 text-right font-sans font-bold @(ind.MacdHistogram >= 0 ? "text-emerald-600" : "text-rose-600")">
                                @(ind.MacdHistogram >= 0 ? "EXPANDING" : "CONTRACTING")
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2.5 font-sans font-medium text-slate-700 dark:text-slate-300">ATR (14) Volatility</td>
                            <td class="px-3 py-2.5">@(ind.Atr14 * 10000m > 1 ? (ind.Atr14 * 10000m).ToString("F1") + " pips" : ind.Atr14.ToString("F5"))</td>
                            <td class="px-3 py-2.5 font-sans">Expected bar range</td>
                            <td class="px-3 py-2.5 text-right font-sans text-slate-400">INFO</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pivot Points Full Matrix -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-arrows-to-dot text-amber-500"></i> Floor Traders Pivot Points (@p.Method)
            </h2>
            <span class="text-xs text-slate-400 font-mono">Current Price: @ind.Price.ToString("F5")</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-7 gap-3 text-center font-mono text-xs">
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Resistance 3 (R3)</div>
                <div class="text-sm font-bold mt-1">@p.R3.ToString("F5")</div>
                <div class="text-3xs font-sans text-slate-400 mt-1">Extreme Exhaustion</div>
            </div>
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Resistance 2 (R2)</div>
                <div class="text-sm font-bold mt-1">@p.R2.ToString("F5")</div>
                <div class="text-3xs font-sans text-slate-400 mt-1">Take-Profit Target</div>
            </div>
            <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Resistance 1 (R1)</div>
                <div class="text-sm font-bold mt-1">@p.R1.ToString("F5")</div>
                <div class="text-3xs font-sans text-slate-400 mt-1">First Barrier</div>
            </div>
            <div class="p-3 bg-amber-500/20 border border-amber-500/30 text-amber-900 dark:text-amber-200 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Daily Pivot (PP)</div>
                <div class="text-sm font-bold mt-1">@p.Pivot.ToString("F5")</div>
                <div class="text-3xs font-sans text-amber-700 dark:text-amber-400 mt-1">Trend Equilibrium</div>
            </div>
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Support 1 (S1)</div>
                <div class="text-sm font-bold mt-1">@p.S1.ToString("F5")</div>
                <div class="text-3xs font-sans text-slate-400 mt-1">First Floor</div>
            </div>
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Support 2 (S2)</div>
                <div class="text-sm font-bold mt-1">@p.S2.ToString("F5")</div>
                <div class="text-3xs font-sans text-slate-400 mt-1">Swing Buy Zone</div>
            </div>
            <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 rounded-xl">
                <div class="font-sans font-bold text-2xs uppercase">Support 3 (S3)</div>
                <div class="text-sm font-bold mt-1">@p.S3.ToString("F5")</div>
                <div class="text-3xs font-sans text-slate-400 mt-1">Capitulation Low</div>
            </div>
        </div>
    </div>

    <!-- Smart Money Concepts (SMC) & Institutional Market Structure -->
    @if (t.MarketStructure != null)
    {
        var ms = t.MarketStructure;
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-shapes text-indigo-500"></i> Smart Money Concepts (SMC) & Market Structure
                    </h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Order blocks, Break of Structure (BOS), Change of Character (CHoCH), and liquidity sweep levels</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-bold @(ms.CurrentStructure.Contains("Bullish") ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : ms.CurrentStructure.Contains("Bearish") ? "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300")">
                    @ms.CurrentStructure
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                <!-- BOS & CHoCH -->
                <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="text-2xs font-bold uppercase text-slate-400">Structural Break (BOS / CHoCH)</span>
                    <div class="mt-2 space-y-1.5 font-mono">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Last BOS (@ms.BosDirection):</span>
                            <span class="font-bold text-slate-800 dark:text-white">@ms.LastBosPrice.ToString("F5")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Last CHoCH:</span>
                            <span class="font-semibold text-slate-700 dark:text-slate-300">@ms.LastChochPrice.ToString("F5")</span>
                        </div>
                    </div>
                </div>

                <!-- Order Block: Demand -->
                <div class="p-4 bg-emerald-500/5 rounded-xl border border-emerald-500/20">
                    <span class="text-2xs font-bold uppercase text-emerald-600 dark:text-emerald-400">Institutional Demand Zone (OB)</span>
                    <div class="mt-2 space-y-1.5 font-mono">
                        <div class="flex justify-between">
                            <span class="text-slate-500">OB Low:</span>
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">@ms.OrderBlockDemandLow.ToString("F5")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">OB High:</span>
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">@ms.OrderBlockDemandHigh.ToString("F5")</span>
                        </div>
                    </div>
                </div>

                <!-- Order Block: Supply -->
                <div class="p-4 bg-rose-500/5 rounded-xl border border-rose-500/20">
                    <span class="text-2xs font-bold uppercase text-rose-600 dark:text-rose-400">Institutional Supply Zone (OB)</span>
                    <div class="mt-2 space-y-1.5 font-mono">
                        <div class="flex justify-between">
                            <span class="text-slate-500">OB Low:</span>
                            <span class="font-bold text-rose-600 dark:text-rose-400">@ms.OrderBlockSupplyLow.ToString("F5")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">OB High:</span>
                            <span class="font-bold text-rose-600 dark:text-rose-400">@ms.OrderBlockSupplyHigh.ToString("F5")</span>
                        </div>
                    </div>
                </div>

                <!-- Liquidity Sweeps -->
                <div class="p-4 bg-indigo-500/5 rounded-xl border border-indigo-500/20">
                    <span class="text-2xs font-bold uppercase text-indigo-600 dark:text-indigo-400">Liquidity Sweep Levels</span>
                    <div class="mt-2 space-y-1.5 font-mono">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Buy-Side Sweep:</span>
                            <span class="font-bold text-slate-800 dark:text-white">@ms.LiquiditySweepHigh.ToString("F5")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Sell-Side Sweep:</span>
                            <span class="font-bold text-slate-800 dark:text-white">@ms.LiquiditySweepLow.ToString("F5")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Fibonacci Retracements & Session VWAP Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Fibonacci Retracements & Extensions -->
        @if (t.Fibonacci != null)
        {
            var fib = t.Fibonacci;
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-calculator text-amber-500"></i> Fibonacci Retracements & Extensions
                    </h2>
                    <span class="text-xs font-mono text-slate-400">High: @fib.SwingHigh.ToString("F5") | Low: @fib.SwingLow.ToString("F5")</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 font-mono text-xs">
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
                        <span class="text-3xs font-sans text-slate-400 block">23.6% Retracement</span>
                        <span class="font-bold text-slate-800 dark:text-white">@fib.Retracement236.ToString("F5")</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
                        <span class="text-3xs font-sans text-slate-400 block">38.2% Retracement</span>
                        <span class="font-bold text-slate-800 dark:text-white">@fib.Retracement382.ToString("F5")</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
                        <span class="text-3xs font-sans text-slate-400 block">50.0% Equilibrium</span>
                        <span class="font-bold text-slate-800 dark:text-white">@fib.Retracement500.ToString("F5")</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300">
                        <span class="text-3xs font-sans font-bold block">61.8% Golden Pocket</span>
                        <span class="font-bold">@fib.Retracement618.ToString("F5")</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
                        <span class="text-3xs font-sans text-slate-400 block">78.6% Deep Pocket</span>
                        <span class="font-bold text-slate-800 dark:text-white">@fib.Retracement786.ToString("F5")</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
                        <span class="text-3xs font-sans text-slate-400 block">127.2% Extension</span>
                        <span class="font-bold text-slate-800 dark:text-white">@fib.Extension1272.ToString("F5")</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/30 text-indigo-700 dark:text-indigo-300 col-span-2">
                        <span class="text-3xs font-sans font-bold block">161.8% Target Extension</span>
                        <span class="font-bold">@fib.Extension1618.ToString("F5")</span>
                    </div>
                </div>
            </div>
        }

        <!-- Session VWAP & Volatility Bands -->
        @if (t.Vwap != null)
        {
            var vw = t.Vwap;
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                            <i class="fa-solid fa-water text-cyan-500"></i> Session Volume Weighted Average Price (VWAP)
                        </h2>
                        <p class="text-2xs text-slate-400">Institutional benchmark price with 1-Sigma and 2-Sigma standard deviation bands</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-2xs font-bold @(Math.Abs(vw.CurrentStdDevFromVwap) > 1.5m ? "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")">
                        @(vw.CurrentStdDevFromVwap > 0 ? "+" : "")@vw.CurrentStdDevFromVwap.ToString("F2") σ
                    </span>
                </div>

                <div class="space-y-2 font-mono text-xs">
                    <div class="flex justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-900">
                        <span class="font-sans text-slate-500">+2 Sigma Upper Band:</span>
                        <span class="font-bold text-rose-600 dark:text-rose-400">@vw.UpperBand2Sigma.ToString("F5")</span>
                    </div>
                    <div class="flex justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-900">
                        <span class="font-sans text-slate-500">+1 Sigma Upper Band:</span>
                        <span class="font-semibold text-amber-600 dark:text-amber-400">@vw.UpperBand1Sigma.ToString("F5")</span>
                    </div>
                    <div class="flex justify-between p-2.5 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-cyan-800 dark:text-cyan-300">
                        <span class="font-sans font-bold">Session VWAP Equilibrium:</span>
                        <span class="font-bold text-sm">@vw.VwapPrice.ToString("F5")</span>
                    </div>
                    <div class="flex justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-900">
                        <span class="font-sans text-slate-500">-1 Sigma Lower Band:</span>
                        <span class="font-semibold text-emerald-600 dark:text-emerald-400">@vw.LowerBand1Sigma.ToString("F5")</span>
                    </div>
                    <div class="flex justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-900">
                        <span class="font-sans text-slate-500">-2 Sigma Lower Band:</span>
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">@vw.LowerBand2Sigma.ToString("F5")</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Retail Sentiment, ADR Volatility Regime & Options Expiries -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Retail Sentiment (Contrarian) -->
        @if (t.RetailSentiment != null)
        {
            var sent = t.RetailSentiment;
            <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Retail Sentiment</h3>
                    <span class="px-2 py-0.5 rounded text-2xs font-bold @(sent.ContrarianBias.Contains("Bullish") ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : sent.ContrarianBias.Contains("Bearish") ? "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300")">
                        Contrarian: @sent.ContrarianBias.Split(' ')[0]
                    </span>
                </div>
                <div class="space-y-2 mt-3">
                    <div class="flex justify-between text-xs font-bold">
                        <span class="text-emerald-600">Long @sent.LongPercentage%</span>
                        <span class="text-rose-600">Short @sent.ShortPercentage%</span>
                    </div>
                    <div class="w-full h-3 rounded-full bg-rose-500 overflow-hidden flex">
                        <div class="h-full bg-emerald-500" style="width: @sent.LongPercentage%"></div>
                    </div>
                    <div class="flex justify-between text-2xs text-slate-400 pt-2">
                        <span>L/S Ratio: @sent.LongShortRatio.ToString("F2")</span>
                        <span>Sample: @sent.SampleTraderCount.ToString("N0") traders</span>
                    </div>
                </div>
            </div>
        }

        <!-- ADR & Volatility Regime -->
        @if (t.Volatility != null)
        {
            var vol = t.Volatility;
            <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">ADR Volatility Regime</h3>
                    <span class="px-2 py-0.5 rounded text-2xs font-bold bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                        @vol.MarketRegime
                    </span>
                </div>
                <div class="space-y-2 mt-3 text-xs">
                    <div class="flex justify-between">
                        <span class="text-slate-400">14-Day Average Range:</span>
                        <span class="font-bold text-slate-800 dark:text-white">@vol.Adr14Pips pips</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Today's Range:</span>
                        <span class="font-bold text-slate-800 dark:text-white">@vol.TodayRangePips pips</span>
                    </div>
                    <div class="flex justify-between font-semibold">
                        <span class="text-slate-400">% ADR Exhausted:</span>
                        <span class="@(vol.PercentAdrUsed > 85 ? "text-rose-600" : "text-emerald-600")">@vol.PercentAdrUsed%</span>
                    </div>
                </div>
            </div>
        }

        <!-- Options Expiry & Yield Spread -->
        @if (t.OptionsExpiry != null)
        {
            var opt = t.OptionsExpiry;
            <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">FX Options 10 AM NY Cut</h3>
                    <span class="text-2xs font-mono text-slate-400">@opt.ExpiryDateUtc.ToString("HH:mm") UTC</span>
                </div>
                <div class="space-y-2 mt-3 text-xs font-mono">
                    <div class="flex justify-between">
                        <span class="font-sans text-slate-400">Max Pain Strike:</span>
                        <span class="font-bold text-slate-800 dark:text-white">@opt.MaxPainStrike.ToString("F4")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-sans text-slate-400">Open Interest Notional:</span>
                        <span class="font-bold text-slate-800 dark:text-white">$@opt.TotalOpenInterestNotionalMillions M</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-sans text-slate-400">25-Delta Risk Reversal:</span>
                        <span class="font-bold @(opt.RiskReversal25Delta >= 0 ? "text-emerald-600" : "text-rose-600")">
                            @(opt.RiskReversal25Delta >= 0 ? "+" : "")@opt.RiskReversal25Delta.ToString("F2")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
