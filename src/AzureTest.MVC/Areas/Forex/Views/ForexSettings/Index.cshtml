@model AzureTest.Contracts.DTOs.Forex.ForexApiSettingsDto
@{
    ViewData["Title"] = "Forex Settings, API Keys & Legal Disclaimers";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-slate-500/10 text-slate-700 dark:text-slate-200 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-gear"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Forex API Settings & Risk Disclaimers</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Configure external market feeds, broker simulation latency, and review critical financial risk notices</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Frankfurter Feed Active (No Key Needed)
            </span>
        </div>
    </div>

    <!-- Legal & Critical Financial Risk Warnings (Prominent Alert Box) -->
    <div class="bg-rose-500/10 border-2 border-rose-500/30 p-6 rounded-2xl space-y-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold text-lg shrink-0">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <h2 class="text-base font-bold text-rose-800 dark:text-rose-300">
                    MANDATORY LEGAL DISCLAIMER: NOT FINANCIAL ADVICE
                </h2>
                <p class="text-xs text-rose-700 dark:text-rose-400">
                    Forex trading involves substantial risk of loss and is not suitable for all investors. Read and understand these disclosures before proceeding.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-slate-700 dark:text-slate-300 pt-2">
            <div class="p-4 bg-white/70 dark:bg-slate-900/60 rounded-xl border border-rose-500/20">
                <h3 class="font-bold text-rose-700 dark:text-rose-400 flex items-center gap-2 mb-1">
                    <i class="fa-solid fa-bomb"></i> 1. High-Leverage Risk & Forced Liquidation
                </h3>
                <p class="text-2xs leading-relaxed text-slate-600 dark:text-slate-400">
                    Leverage amplifies both profits and losses. At 1:30 leverage (ESMA retail limit), a mere 3.3% move against your position obliterates 100% of your committed margin. At unregulated offshore 1:500 leverage, a microscopic 0.2% fluctuation (20 pips) triggers total account liquidation.
                </p>
            </div>

            <div class="p-4 bg-white/70 dark:bg-slate-900/60 rounded-xl border border-rose-500/20">
                <h3 class="font-bold text-rose-700 dark:text-rose-400 flex items-center gap-2 mb-1">
                    <i class="fa-solid fa-clock text-amber-500"></i> 2. Free Data Feed Delay & Slippage Warning
                </h3>
                <p class="text-2xs leading-relaxed text-slate-600 dark:text-slate-400">
                    Free API plans (Alpha Vantage, Finnhub, ExchangeRate-API) provide <strong>15-minute delayed</strong> quotes or daily reference rates. Attempting live automated trading on delayed or synthetic tick data guarantees severe slippage and immediate loss. Live execution requires true low-latency broker FIX/WebSocket feeds.
                </p>
            </div>
        </div>

        <!-- Mandatory User Verification Checklist -->
        <div class="p-4 bg-white/70 dark:bg-slate-900/60 rounded-xl border border-rose-500/20 text-xs">
            <h3 class="font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
                <i class="fa-solid fa-clipboard-check text-emerald-600"></i> What You Must Verify Yourself Before Any Real Trading:
            </h3>
            <ul class="list-disc list-inside space-y-1 text-2xs text-slate-600 dark:text-slate-400 leading-relaxed">
                <li>Verify your broker is explicitly licensed by the <strong>AFM (Netherlands)</strong> or equivalent EEA tier-1 regulator (e.g. BaFin, CySEC).</li>
                <li>Confirm that <strong>Negative Balance Protection</strong> is legally enforced on your specific account tier.</li>
                <li>Verify your broker's true swap/overnight financing rates; carry trade costs can silently turn a profitable swing trade negative.</li>
                <li>Test every quantitative strategy extensively in the Demo Terminal across different market regimes (trending, ranging, high news volatility) before committing capital.</li>
            </ul>
        </div>
    </div>

    <!-- API Keys Configuration Form -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center font-bold">
                <i class="fa-solid fa-key"></i>
            </div>
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white">External Market Data & Broker Credentials</h2>
                <p class="text-xs text-slate-400">Enter free tier API keys when you obtain them. The system operates on Frankfurter ECB data by default.</p>
            </div>
        </div>

        <form method="post" asp-action="Update" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Twelve Data -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Twelve Data API Key (Real-time Forex & Intraday Candles)
                    </label>
                    <input type="password" name="Settings.TwelveDataApiKey" value="@Model.TwelveDataApiKey" placeholder="Free key from twelvedata.com" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    <span class="text-3xs text-slate-400 mt-1 block">Provides 800 free credits/day for live FX rates and candles.</span>
                </div>

                <!-- Alpha Vantage -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Alpha Vantage API Key (Forex Candles & Indicator Engine)
                    </label>
                    <input type="password" name="Settings.AlphaVantageApiKey" value="@Model.AlphaVantageApiKey" placeholder="Free key from alphavantage.co" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    <span class="text-3xs text-slate-400 mt-1 block">Free tier supports 25 requests/day.</span>
                </div>

                <!-- FRED St. Louis Fed -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        FRED St. Louis Fed Key (Macro Yields & Policy Rates)
                    </label>
                    <input type="password" name="Settings.FredApiKey" value="@Model.FredApiKey" placeholder="Free key from fred.stlouisfed.org" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    <span class="text-3xs text-slate-400 mt-1 block">Free central bank interest rate series and economic data.</span>
                </div>

                <!-- Finnhub -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        Finnhub API Key (Forex News Feed & Economic Calendar)
                    </label>
                    <input type="password" name="Settings.FinnhubApiKey" value="@Model.FinnhubApiKey" placeholder="Free key from finnhub.io" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    <span class="text-3xs text-slate-400 mt-1 block">Free plan provides market news and calendar events.</span>
                </div>

                <!-- OANDA Broker Demo Key -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        OANDA Demo API Key (Optional Broker Sandbox)
                    </label>
                    <input type="password" name="Settings.OandaApiKey" value="@Model.OandaApiKey" placeholder="v20 REST API Token" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                </div>

                <!-- OANDA Account ID -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                        OANDA Demo Account ID
                    </label>
                    <input type="text" name="Settings.OandaAccountId" value="@Model.OandaAccountId" placeholder="001-004-..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                </div>
            </div>

            <!-- Simulator & Protection Toggles -->
            <div class="pt-4 border-t border-slate-100 dark:border-slate-700 grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Primary Provider -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Active Market Feed</label>
                    <select name="Settings.PrimaryPriceProvider" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-800 dark:text-white">
                        <option value="Frankfurter" selected>Frankfurter (ECB Daily - No Key Needed)</option>
                        <option value="TwelveData">Twelve Data</option>
                        <option value="AlphaVantage">Alpha Vantage</option>
                        <option value="Oanda">OANDA Practice Broker</option>
                    </select>
                </div>

                <!-- Simulated Latency -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Simulated Network Delay (ms)</label>
                    <input type="number" step="10" min="0" max="5000" name="Settings.SimulatedLatencyMs" value="@Model.SimulatedLatencyMs" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    <span class="text-3xs text-slate-400 mt-1 block">Simulates broker execution transit time.</span>
                </div>

                <!-- Protection Toggles -->
                <div class="space-y-2 pt-2 text-xs">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="Settings.EnableSafeRetries" value="true" checked="@Model.EnableSafeRetries" class="w-4 h-4 text-brand-600 rounded" />
                        <span class="text-slate-700 dark:text-slate-300 font-semibold">Enable Safe Retry Idempotency</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="Settings.EnableNewsFilterWarning" value="true" checked="@Model.EnableNewsFilterWarning" class="w-4 h-4 text-rose-600 rounded" />
                        <span class="text-slate-700 dark:text-slate-300 font-semibold">Block Market Orders around News</span>
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end pt-4 border-t border-slate-100 dark:border-slate-700">
                <button type="submit" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold rounded-xl shadow-xs flex items-center gap-2">
                    <i class="fa-solid fa-floppy-disk"></i> Save Preferences & API Settings
                </button>
            </div>
        </form>
    </div>
</div>
