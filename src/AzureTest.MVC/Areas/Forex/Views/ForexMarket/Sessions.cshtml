@model AzureTest.Contracts.DTOs.Forex.MarketOverviewDto
@{
    ViewData["Title"] = "Global Forex Market Sessions";
    var nowUtc = DateTime.UtcNow;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-earth-americas"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Forex Market Sessions & Overlaps</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Track 24-hour interbank liquidity across Sydney, Tokyo, London, and New York</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="px-4 py-2 bg-slate-100 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-mono">
                <span class="text-slate-400">Current UTC:</span>
                <span class="font-bold text-slate-800 dark:text-white ml-1">@nowUtc.ToString("HH:mm:ss")</span>
            </div>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl">
                Back to Rates
            </a>
        </div>
    </div>

    <!-- Active Sessions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var s in Model.Sessions)
        {
            <div class="bg-white dark:bg-slate-800 rounded-2xl border @(s.IsOpen ? "border-emerald-500 shadow-md ring-2 ring-emerald-500/20" : "border-slate-200 dark:border-slate-700") p-5 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <span class="text-base font-bold text-slate-800 dark:text-white">@s.City</span>
                            <span class="text-2xs text-slate-400">(@s.Session)</span>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold @(s.IsOpen ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400")">
                            <span class="w-2 h-2 rounded-full @(s.IsOpen ? "bg-emerald-500 animate-pulse" : "bg-slate-400")"></span>
                            @(s.IsOpen ? "ACTIVE" : "CLOSED")
                        </span>
                    </div>

                    <div class="space-y-2 mt-4 text-xs">
                        <div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700">
                            <span class="text-slate-400">UTC Trading Hours</span>
                            <span class="font-mono font-medium text-slate-700 dark:text-slate-300">@s.OpenUtc.ToString(@"hh\:mm") - @s.CloseUtc.ToString(@"hh\:mm")</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700">
                            <span class="text-slate-400">Timezone</span>
                            <span class="font-medium text-slate-700 dark:text-slate-300">@s.TimeZone</span>
                        </div>
                        <div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700">
                            <span class="text-slate-400">Status Counter</span>
                            <span class="font-semibold text-brand-600 dark:text-brand-400">
                                @(s.IsOpen ? $"Closes in {s.TimeUntilNextState.Hours}h {s.TimeUntilNextState.Minutes}m" : $"Opens in {s.TimeUntilNextState.Hours}h {s.TimeUntilNextState.Minutes}m")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-700">
                    <div class="text-2xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Key Currencies</div>
                    <div class="text-xs font-medium text-slate-700 dark:text-slate-300">
                        @switch (s.Session)
                        {
                            case ForexMarketSession.Sydney:
                                <span>AUD, NZD (Commodity flows)</span>
                                break;
                            case ForexMarketSession.Tokyo:
                                <span>JPY, AUD, NZD (Asian liquidity)</span>
                                break;
                            case ForexMarketSession.London:
                                <span>EUR, GBP, CHF (38% global volume)</span>
                                break;
                            case ForexMarketSession.NewYork:
                                <span>USD, CAD (Highest volatility)</span>
                                break;
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Market Overlaps & Volatility Profile -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Major Session Overlaps -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <h2 class="text-base font-bold text-slate-800 dark:text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-arrows-split-up-and-left text-brand-500"></i> Critical Session Overlaps
            </h2>
            <div class="space-y-4">
                <div class="p-4 rounded-xl bg-amber-500/5 border border-amber-500/20">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-amber-700 dark:text-amber-400">London - New York Overlap (13:00 - 17:00 UTC)</span>
                        <span class="px-2 py-0.5 rounded text-2xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">MAX LIQUIDITY</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">
                        Over 70% of total daily global forex turnover happens during these 4 hours. Highest volatility, tightest spreads on EUR/USD and GBP/USD. Optimal time for breakout and trend-following strategies.
                    </p>
                </div>

                <div class="p-4 rounded-xl bg-blue-500/5 border border-blue-500/20">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-blue-700 dark:text-blue-400">Tokyo - London Overlap (08:00 - 09:00 UTC)</span>
                        <span class="px-2 py-0.5 rounded text-2xs font-bold bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300">MODERATE</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">
                        The Asian session winds down as European institutions open. Often triggers the initial trend direction of the European day.
                    </p>
                </div>

                <div class="p-4 rounded-xl bg-purple-500/5 border border-purple-500/20">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-purple-700 dark:text-purple-400">Sydney - Tokyo Overlap (00:00 - 07:00 UTC)</span>
                        <span class="px-2 py-0.5 rounded text-2xs font-bold bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300">CONSOLIDATION</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">
                        Typically a calmer range-bound period unless Chinese macroeconomic data or Bank of Japan policy announcements are released.
                    </p>
                </div>
            </div>
        </div>

        <!-- Strategy Implications & Best Practices -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-lightbulb text-amber-500"></i> Session Strategy Guide
                </h2>
                <div class="space-y-3 text-xs text-slate-600 dark:text-slate-400">
                    <div class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-2xs">1</div>
                        <div>
                            <strong class="text-slate-800 dark:text-white">Asian Range Box (00:00 - 07:00 UTC):</strong>
                            Mark the high and low of the Asian range on EUR/USD and GBP/USD. This creates clear breakout boundary levels for London Open.
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0 font-bold text-2xs">2</div>
                        <div>
                            <strong class="text-slate-800 dark:text-white">London Breakout (07:00 - 09:00 UTC):</strong>
                            European traders enter the market, creating momentum breakouts beyond Asian levels or liquidity sweeps (Judas swing).
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-indigo-500/10 text-indigo-600 flex items-center justify-center shrink-0 font-bold text-2xs">3</div>
                        <div>
                            <strong class="text-slate-800 dark:text-white">US Economic Releases (12:30 - 14:00 UTC):</strong>
                            High-impact news (CPI, Non-Farm Payrolls, FOMC) causes severe spreads widening and slippage. Safe traders avoid opening new market orders 15 minutes before and after.
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between">
                <a asp-area="Forex" asp-controller="ForexStrategy" asp-action="Index" class="inline-flex items-center gap-2 text-xs font-bold text-brand-600 hover:text-brand-700">
                    Test London Breakout Strategy <i class="fa-solid fa-arrow-right"></i>
                </a>
                <span class="text-2xs text-slate-400">All session times synchronized in UTC</span>
            </div>
        </div>
    </div>

    <!-- 24-Hour Volatility Heatmap by UTC Hour -->
    @if (Model.HourlyVolatility != null && Model.HourlyVolatility.Count > 0)
    {
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-simple text-indigo-500"></i> 24-Hour Hourly Volatility Heatmap (EUR/USD & Majors)
                    </h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Average pip distribution across 24 UTC hours showing session momentum spikes</p>
                </div>
                <div class="flex items-center gap-3 text-2xs font-semibold">
                    <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded bg-slate-200 dark:bg-slate-700"></span> Low (&lt;25p)</span>
                    <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded bg-blue-300 dark:bg-blue-800"></span> Moderate (25-45p)</span>
                    <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded bg-amber-400 dark:bg-amber-600"></span> High (45-70p)</span>
                    <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded bg-rose-500"></span> Peak (&gt;70p)</span>
                </div>
            </div>

            <div class="grid grid-cols-6 sm:grid-cols-12 lg:grid-cols-24 gap-1.5 pt-2">
                @foreach (var h in Model.HourlyVolatility)
                {
                    var isCurrent = nowUtc.Hour == h.UtcHour;
                    string bgClass = h.ActivityLevel switch
                    {
                        "Peak Volatility" => "bg-rose-500 text-white",
                        "High" => "bg-amber-400 dark:bg-amber-600 text-slate-900 dark:text-white",
                        "Moderate" => "bg-blue-300 dark:bg-blue-800 text-slate-800 dark:text-white",
                        _ => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"
                    };

                    <div class="flex flex-col items-center justify-between p-2 rounded-xl text-center border @(isCurrent ? "border-brand-500 ring-2 ring-brand-500/30" : "border-slate-200 dark:border-slate-700") @bgClass">
                        <span class="text-2xs font-mono font-bold">@h.UtcHour:00</span>
                        <span class="text-xs font-extrabold my-1">@h.AveragePipsMovement p</span>
                        <span class="text-3xs uppercase tracking-tighter opacity-80 truncate w-full" title="@h.PrimarySession">@h.PrimarySession.Split(' ')[0]</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Intermarket Context & Broker Execution Spreads -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Intermarket Context Markets (Yields, DXY, Commodities) -->
        @if (Model.ContextMarkets != null && Model.ContextMarkets.Count > 0)
        {
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <h2 class="text-base font-bold text-slate-800 dark:text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-link text-brand-500"></i> Macro Context Markets
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Sovereign bond yields, DXY Dollar Index, and context assets steering currency flows</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left">
                        <thead class="text-2xs text-slate-400 uppercase bg-slate-50 dark:bg-slate-900/50 border-b border-slate-100 dark:border-slate-700">
                            <tr>
                                <th class="py-2.5 px-3">Asset</th>
                                <th class="py-2.5 px-3">Category</th>
                                <th class="py-2.5 px-3 text-right">Price / Yield</th>
                                <th class="py-2.5 px-3 text-right">24h Change</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                            @foreach (var c in Model.ContextMarkets)
                            {
                                <tr>
                                    <td class="py-2.5 px-3">
                                        <div class="font-bold text-slate-800 dark:text-white">@c.Symbol</div>
                                        <div class="text-2xs text-slate-400">@c.Name</div>
                                    </td>
                                    <td class="py-2.5 px-3">
                                        <span class="px-2 py-0.5 rounded text-2xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">@c.Category</span>
                                    </td>
                                    <td class="py-2.5 px-3 text-right font-mono font-bold text-slate-800 dark:text-white">
                                        @c.Price @c.Unit
                                    </td>
                                    <td class="py-2.5 px-3 text-right font-mono font-semibold @(c.ChangePercent >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                                        @(c.ChangePercent >= 0 ? "+" : "")@c.ChangePercent.ToString("F2")%
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Broker Spread & Execution Latency Comparison -->
        @if (Model.BrokerComparisons != null && Model.BrokerComparisons.Count > 0)
        {
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <h2 class="text-base font-bold text-slate-800 dark:text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-server text-emerald-500"></i> Broker Spreads & Execution Comparison
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Comparing typical retail ECN raw spreads, AFM passporting, and execution latency</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left">
                        <thead class="text-2xs text-slate-400 uppercase bg-slate-50 dark:bg-slate-900/50 border-b border-slate-100 dark:border-slate-700">
                            <tr>
                                <th class="py-2.5 px-3">Broker</th>
                                <th class="py-2.5 px-3">Regulation</th>
                                <th class="py-2.5 px-3 text-right">Typical Spread</th>
                                <th class="py-2.5 px-3 text-right">Commission</th>
                                <th class="py-2.5 px-3 text-right">Latency</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                            @foreach (var b in Model.BrokerComparisons)
                            {
                                <tr>
                                    <td class="py-2.5 px-3 font-bold text-slate-800 dark:text-white">@b.BrokerName</td>
                                    <td class="py-2.5 px-3 text-2xs text-slate-500">@b.Regulation</td>
                                    <td class="py-2.5 px-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">@b.TypicalSpreadPips p</td>
                                    <td class="py-2.5 px-3 text-right font-mono text-slate-700 dark:text-slate-300">
                                        @(b.CommissionPerLot > 0 ? $"${b.CommissionPerLot:F2}/lot" : "Zero")
                                    </td>
                                    <td class="py-2.5 px-3 text-right font-mono font-semibold text-slate-600 dark:text-slate-400">
                                        @b.AverageExecutionLatencyMs ms
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
