@model AzureTest.Contracts.DTOs.Forex.ForexRiskOverviewDto
@{
    ViewData["Title"] = "Forex Risk Management & ESMA Compliance";
    var acc = Model.Account;
    var news = Model.NewsFilter;
    var cmp = Model.Compliance;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Risk Management & Capital Preservation</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Position sizing formulas, cluster exposure guardrails, and Netherlands AFM / ESMA retail compliance</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                <i class="fa-solid fa-scale-balanced"></i> AFM / ESMA 1:30 Max
            </span>
            <a asp-area="Forex" asp-controller="ForexTrade" asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl">
                Trading Terminal
            </a>
        </div>
    </div>

    <!-- News No-Trade Filter Alert Ribbon -->
    <div class="p-5 rounded-2xl border @(news.IsSafeToTrade ? "bg-emerald-500/10 border-emerald-500/20" : "bg-rose-500/10 border-rose-500/30") flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl @(news.IsSafeToTrade ? "bg-emerald-500" : "bg-rose-500") text-white flex items-center justify-center font-bold text-lg shrink-0">
                <i class="fa-solid @(news.IsSafeToTrade ? "fa-shield-check" : "fa-ban")"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h2 class="text-sm font-bold text-slate-800 dark:text-white">
                        News Filter: @(news.IsSafeToTrade ? "SAFE TO TRADE" : "NO-TRADE WINDOW ACTIVE")
                    </h2>
                    <span class="px-2 py-0.5 rounded text-2xs font-bold @(news.IsSafeToTrade ? "bg-emerald-200 text-emerald-800" : "bg-rose-200 text-rose-800")">
                        @(news.MinutesToNearestEvent == int.MaxValue ? "No News" : $"{news.MinutesToNearestEvent}m to event")
                    </span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">
                    @news.StatusMessage
                </p>
            </div>
        </div>
        <div class="text-xs font-medium text-slate-500 shrink-0">
            Rule: Zero market orders &plusmn;15m around High Impact releases
        </div>
    </div>

    <!-- Live Position Size Calculator & Cluster Exposure -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Interactive Lot Sizing Calculator -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-calculator text-brand-500"></i> Fixed-Fractional Lot Sizing Calculator
                </h2>
                <span class="text-xs font-mono text-slate-400">Equity: $@acc.Equity.ToString("N0")</span>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Account Equity ($)</label>
                    <input type="number" id="calcEquity" value="@acc.Equity.ToString("F0")" oninput="calculateLotSize()" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl font-mono text-slate-800 dark:text-white" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Risk per Trade (%)</label>
                    <input type="number" step="0.25" min="0.25" max="5.0" id="calcRiskPercent" value="1.0" oninput="calculateLotSize()" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl font-mono text-slate-800 dark:text-white" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Stop Loss Distance (Pips)</label>
                    <input type="number" step="1" min="5" id="calcStopLossPips" value="25" oninput="calculateLotSize()" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl font-mono text-slate-800 dark:text-white" />
                </div>
                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Currency Pair</label>
                    <select id="calcSymbol" onchange="calculateLotSize()" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl font-semibold text-slate-800 dark:text-white">
                        <option value="EUR/USD">EUR/USD (Major 1:30)</option>
                        <option value="GBP/USD">GBP/USD (Major 1:30)</option>
                        <option value="USD/JPY">USD/JPY (Major 1:30)</option>
                        <option value="EUR/GBP">EUR/GBP (Minor 1:20)</option>
                        <option value="XAU/USD">XAU/USD (Gold 1:10)</option>
                    </select>
                </div>
            </div>

            <!-- Calculation Output Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 font-mono text-xs">
                <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 rounded-xl">
                    <span class="text-2xs font-sans text-emerald-800 dark:text-emerald-300 block">Recommended Lots</span>
                    <span class="text-lg font-bold text-emerald-600 block mt-1" id="resLots">0.40 Lots</span>
                    <span class="text-3xs text-slate-400 font-sans">Strict 1.0% cap</span>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl">
                    <span class="text-2xs font-sans text-slate-400 block">Amount at Risk</span>
                    <span class="text-lg font-bold text-slate-800 dark:text-white block mt-1" id="resRiskAmount">$100.00</span>
                    <span class="text-3xs text-slate-400 font-sans">Max loss on SL</span>
                </div>
                <div class="p-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl">
                    <span class="text-2xs font-sans text-slate-400 block">Margin Required</span>
                    <span class="text-lg font-bold text-slate-800 dark:text-white block mt-1" id="resMargin">$1,333.33</span>
                    <span class="text-3xs text-slate-400 font-sans">1:30 ESMA</span>
                </div>
            </div>

            <div id="esmaWarningBox" class="p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-xs text-rose-700 dark:text-rose-400 hidden">
                <strong class="font-bold">ESMA Leverage Warning:</strong> This position size requires more margin than permitted under 1:30 retail leverage limits.
            </div>
        </div>

        <!-- Currency Exposure & Cluster Risk Monitor -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-pie-chart text-indigo-500"></i> Currency Exposure Cluster Monitor
                    </h2>
                    <p class="text-xs text-slate-400">Net exposure per currency across all open positions</p>
                </div>
                <span class="text-xs font-semibold text-rose-500">Max 30% per currency</span>
            </div>

            <div class="space-y-3">
                @foreach (var exp in Model.CurrencyExposures)
                {
                    <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                        <div class="flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-800 dark:text-white">@exp.Currency</span>
                                @if (exp.IsOverexposed)
                                {
                                    <span class="px-2 py-0.5 rounded text-3xs font-bold bg-rose-100 text-rose-700">OVEREXPOSED</span>
                                }
                            </div>
                            <div class="font-mono text-2xs">
                                Long: <strong class="text-emerald-600">@exp.LongExposureLots.ToString("F2")L</strong> | Short: <strong class="text-rose-600">@exp.ShortExposureLots.ToString("F2")L</strong>
                            </div>
                        </div>

                        <!-- Progress Bar for % of Equity -->
                        <div class="mt-2">
                            <div class="flex items-center justify-between text-3xs text-slate-400 font-mono mb-1">
                                <span>Equity Exposure</span>
                                <span>@exp.PercentOfEquity.ToString("F1")%</span>
                            </div>
                            <div class="w-full bg-slate-200 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
                                <div class="h-full rounded-full @(exp.IsOverexposed ? "bg-rose-500" : exp.PercentOfEquity > 15 ? "bg-amber-500" : "bg-brand-500")"
                                     style="width: @Math.Min(100m, exp.PercentOfEquity)%"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ESMA & AFM Legal Framework Accordion / Guide -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-gavel text-amber-500"></i> Regulatory Compliance: ESMA & AFM (Netherlands)
                </h2>
                <p class="text-xs text-slate-400">Statutory retail investor protection measures under European MiFID II</p>
            </div>
            <span class="px-3 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-mono font-bold">
                AFM Licensed Jurisdiction
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
            <!-- 1:30 Leverage Limit -->
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold mb-2">
                    1:30
                </div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">Strict Leverage Caps</h3>
                <p class="text-slate-500 dark:text-slate-400 text-2xs leading-relaxed">
                    ESMA mandates a 1:30 limit on major pairs (3.33% margin), 1:20 on non-major pairs (5% margin), and 1:10 on gold/commodities. Brokers cannot offer 1:500 to retail.
                </p>
            </div>

            <!-- 50% Margin Close-Out -->
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-600 flex items-center justify-center font-bold mb-2">
                    50%
                </div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">50% Margin Close-Out</h3>
                <p class="text-slate-500 dark:text-slate-400 text-2xs leading-relaxed">
                    When account equity drops below 50% of the required margin, the broker must automatically liquidate the largest losing positions to stop complete account destruction.
                </p>
            </div>

            <!-- Negative Balance Protection -->
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold mb-2">
                    0.00
                </div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">Negative Balance Protection</h3>
                <p class="text-slate-500 dark:text-slate-400 text-2xs leading-relaxed">
                    Retail traders under AFM / ESMA can NEVER lose more than their deposited capital. Any gap below zero due to black-swan events must be absorbed by the broker.
                </p>
            </div>

            <!-- Ban on Trading Incentives -->
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold mb-2">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <h3 class="font-bold text-slate-800 dark:text-white mb-1">No Deposit Bonuses</h3>
                <p class="text-slate-500 dark:text-slate-400 text-2xs leading-relaxed">
                    Brokers are legally prohibited from offering deposit match bonuses, rebates, or binary options to retail clients in the Netherlands and European Union.
                </p>
            </div>
        </div>
    </div>

    <!-- Prop Firm Challenge Monitor (Pillar 7 & 8) -->
    @if (Model.PropFirm != null)
    {
        var pf = Model.PropFirm;
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-medal text-amber-500"></i> Prop Firm Challenge Tracker (@pf.FirmName)
                    </h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Enforcing institutional evaluation rules (5% daily drawdown, 10% max trailing drawdown, 10% target)</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-bold @(pf.OverallPassed ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : "bg-rose-100 text-rose-700")">
                    @pf.StatusSummary.Split(':')[0]
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 font-mono text-xs">
                <!-- Daily Loss Limit -->
                <div class="p-4 rounded-xl border @(pf.DailyLossPassed ? "bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700" : "bg-rose-500/10 border-rose-500/30")">
                    <div class="flex items-center justify-between text-2xs font-sans text-slate-400 uppercase">
                        <span>Max Daily Loss (5.0%)</span>
                        <span class="font-bold @(pf.DailyLossPassed ? "text-emerald-600" : "text-rose-600")">@(pf.DailyLossPassed ? "PASS" : "BREACHED")</span>
                    </div>
                    <div class="text-xl font-bold mt-2 @(pf.TodayLossPercent > 3.0m ? "text-rose-600" : "text-slate-800 dark:text-white")">
                        @pf.TodayLossPercent.ToString("F2")%
                    </div>
                    <div class="text-3xs text-slate-400 mt-1 font-sans">
                        -$@pf.TodayLossAmount.ToString("N2") loss today (Cap: $@(pf.StartingCapital * 0.05m).ToString("N0"))
                    </div>
                </div>

                <!-- Max Trailing Drawdown -->
                <div class="p-4 rounded-xl border @(pf.MaxDrawdownPassed ? "bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700" : "bg-rose-500/10 border-rose-500/30")">
                    <div class="flex items-center justify-between text-2xs font-sans text-slate-400 uppercase">
                        <span>Max Trailing DD (10.0%)</span>
                        <span class="font-bold @(pf.MaxDrawdownPassed ? "text-emerald-600" : "text-rose-600")">@(pf.MaxDrawdownPassed ? "PASS" : "BREACHED")</span>
                    </div>
                    <div class="text-xl font-bold mt-2 @(pf.CurrentTrailingDrawdownPercent > 6.0m ? "text-amber-500" : "text-slate-800 dark:text-white")">
                        @pf.CurrentTrailingDrawdownPercent.ToString("F2")%
                    </div>
                    <div class="text-3xs text-slate-400 mt-1 font-sans">
                        From peak equity (Cap: $@(pf.StartingCapital * 0.10m).ToString("N0"))
                    </div>
                </div>

                <!-- Profit Target -->
                <div class="p-4 rounded-xl border bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700">
                    <div class="flex items-center justify-between text-2xs font-sans text-slate-400 uppercase">
                        <span>Profit Target (10.0%)</span>
                        <span class="font-bold text-brand-600">@(pf.ProfitTargetReached ? "REACHED" : "IN PROGRESS")</span>
                    </div>
                    <div class="text-xl font-bold mt-2 text-emerald-600">
                        @pf.CurrentProfitPercent.ToString("F2")%
                    </div>
                    <div class="text-3xs text-slate-400 mt-1 font-sans">
                        Target: +$@(pf.StartingCapital * 0.10m).ToString("N0")
                    </div>
                </div>

                <!-- Trading Days -->
                <div class="p-4 rounded-xl border bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700">
                    <div class="flex items-center justify-between text-2xs font-sans text-slate-400 uppercase">
                        <span>Trading Days</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300">Min @pf.MinimumTradingDaysRequired Days</span>
                    </div>
                    <div class="text-xl font-bold mt-2 text-slate-800 dark:text-white">
                        @pf.DaysTradedCount / @pf.MinimumTradingDaysRequired
                    </div>
                    <div class="text-3xs text-slate-400 mt-1 font-sans">
                        Active trading days recorded
                    </div>
                </div>
            </div>

            <div class="mt-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-900 text-xs text-slate-600 dark:text-slate-300">
                <i class="fa-solid fa-circle-info text-brand-500 mr-1.5"></i>
                @pf.StatusSummary
            </div>
        </div>
    }

    <!-- Weekend Gap Risk & Triple Swap Calendar (Pillar 7) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Weekend Gap Protection -->
        @if (Model.WeekendGap != null)
        {
            var wg = Model.WeekendGap;
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                <i class="fa-solid fa-shield-cat text-rose-500"></i> Weekend Gap Protection
                            </h2>
                            <p class="text-xs text-slate-400">Prevent catastrophic slippage and black swan news gaps across Saturday & Sunday</p>
                        </div>
                        <span class="px-2.5 py-1 rounded text-2xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                            AUTO-FLATTEN ACTIVE
                        </span>
                    </div>

                    <div class="space-y-3 font-mono text-xs">
                        <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900">
                            <span class="font-sans text-slate-400">Scheduled Auto-Flatten Time:</span>
                            <span class="font-bold text-slate-800 dark:text-white">Friday @wg.FridayFlattenTimeUtc.ToString(@"hh\:mm") UTC</span>
                        </div>
                        <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900">
                            <span class="font-sans text-slate-400">Open Positions at Risk:</span>
                            <span class="font-bold text-amber-500">@wg.OpenTradesAtRiskCount Trades</span>
                        </div>
                        <div class="flex justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900">
                            <span class="font-sans text-slate-400">Total Notional Exposure at Risk:</span>
                            <span class="font-bold">$@wg.TotalNotionalExposureAtRisk.ToString("N0")</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-xs text-amber-800 dark:text-amber-300">
                    <i class="fa-solid fa-triangle-exclamation mr-1.5"></i>
                    Stop-loss orders do NOT protect against weekend price gaps. If an emergency announcement happens over the weekend, the market opens Sunday at 21:00 UTC with slippage that completely bypasses stop loss orders.
                </div>
            </div>
        }

        <!-- Triple Swap Rollover Schedule -->
        @if (Model.SwapCalendar != null)
        {
            var sc = Model.SwapCalendar;
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                            <i class="fa-solid fa-calendar-week text-indigo-500"></i> Triple Swap Rollover Schedule
                        </h2>
                        <p class="text-xs text-slate-400">Overnight interest financing charged at 21:00 UTC daily</p>
                    </div>
                    <span class="px-2.5 py-1 rounded text-2xs font-mono font-bold bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
                        @sc.TripleSwapDayOfWeek
                    </span>
                </div>

                <div class="overflow-x-auto max-h-56">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="text-2xs text-slate-400 uppercase font-sans border-b border-slate-100 dark:border-slate-700">
                            <tr>
                                <th class="py-2">Pair</th>
                                <th class="py-2">Long Swap (pips)</th>
                                <th class="py-2">Short Swap (pips)</th>
                                <th class="py-2 text-right">Triple Swap Today?</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                            @foreach (var s in sc.SwapRates)
                            {
                                <tr>
                                    <td class="py-2 font-bold font-sans text-slate-800 dark:text-white">@s.Symbol</td>
                                    <td class="py-2 @(s.LongSwapPips >= 0 ? "text-emerald-600 font-bold" : "text-rose-600")">
                                        @(s.LongSwapPips >= 0 ? "+" : "")@s.LongSwapPips.ToString("F2")
                                    </td>
                                    <td class="py-2 @(s.ShortSwapPips >= 0 ? "text-emerald-600 font-bold" : "text-rose-600")">
                                        @(s.ShortSwapPips >= 0 ? "+" : "")@s.ShortSwapPips.ToString("F2")
                                    </td>
                                    <td class="py-2 text-right">
                                        <span class="px-2 py-0.5 rounded text-3xs font-bold @(s.IsTripleSwapDay ? "bg-amber-100 text-amber-800" : "bg-slate-100 text-slate-500")">
                                            @(s.IsTripleSwapDay ? "YES (3x)" : "No (1x)")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs font-mono">
                    <span class="font-sans text-slate-400">Estimated Portfolio Daily Swap:</span>
                    <span class="font-bold @(sc.EstimatedPortfolioDailySwapCost >= 0 ? "text-emerald-600" : "text-rose-600")">
                        @(sc.EstimatedPortfolioDailySwapCost >= 0 ? "+$" : "-$")@Math.Abs(sc.EstimatedPortfolioDailySwapCost).ToString("N2")
                    </span>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function calculateLotSize() {
        var eq = parseFloat(document.getElementById('calcEquity').value) || 10000;
        var riskPct = parseFloat(document.getElementById('calcRiskPercent').value) || 1.0;
        var slPips = parseFloat(document.getElementById('calcStopLossPips').value) || 25;
        var sym = document.getElementById('calcSymbol').value;

        var riskAmount = eq * (riskPct / 100.0);
        var pipValueStandardLot = (sym.indexOf('JPY') > -1) ? 6.80 : 10.0;
        var lotSize = riskAmount / (slPips * pipValueStandardLot);
        lotSize = Math.max(0.01, Math.round(lotSize * 100) / 100);

        var lev = (sym === 'XAU/USD') ? 10 : (sym === 'EUR/GBP' ? 20 : 30);
        var margin = (lotSize * 100000) / lev;

        document.getElementById('resLots').innerText = lotSize.toFixed(2) + ' Lots';
        document.getElementById('resRiskAmount').innerText = '$' + riskAmount.toFixed(2);
        document.getElementById('resMargin').innerText = '$' + margin.toFixed(2);

        var warn = document.getElementById('esmaWarningBox');
        if (margin > eq) {
            warn.classList.remove('hidden');
        } else {
            warn.classList.add('hidden');
        }
    }
    calculateLotSize();
</script>
