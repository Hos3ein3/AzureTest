@model (IReadOnlyList<AzureTest.Contracts.DTOs.Forex.ForexJournalEntryDto> Entries, AzureTest.Contracts.DTOs.Forex.TaxReportSummaryDto TaxSummary, AzureTest.Contracts.DTOs.Forex.JournalAnalyticsDashboardDto Analytics)
@{
    ViewData["Title"] = "Forex Trading Journal & Quantitative Analytics";
    var tax = Model.TaxSummary;
    var an = Model.Analytics;
    var isNetPositive = tax.NetRealizedGainLoss >= 0;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-teal-500/10 text-teal-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-book-journal-whills"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Trade Psychology Journal & Quantitative Analytics</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">R-multiple distributions, expectancy, behavioral mistakes, and Dutch Box 3/Box 1 tax reporting</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a asp-action="ExportTax" asp-route-year="@tax.TaxYear" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl flex items-center gap-2 transition-colors">
                <i class="fa-solid fa-file-csv"></i> Export Tax CSV (@tax.TaxYear)
            </a>
            <button type="button" onclick="document.getElementById('newEntryModal').classList.remove('hidden')" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-xl shadow-xs flex items-center gap-2">
                <i class="fa-solid fa-plus"></i> New Journal Entry
            </button>
        </div>
    </div>

    <!-- Annual Tax / P&L Summary Cards -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-calculator text-brand-500"></i> Tax Year @tax.TaxYear Summary (Realized Closed Trades)
                </h2>
                <p class="text-xs text-slate-400">Total closed trades: @tax.TotalTradesClosed</p>
            </div>
            <span class="text-xs font-mono font-bold text-slate-500">Box 3 / Capital Gains basis</span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 font-mono">
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-3xs font-sans text-slate-400 block uppercase">Gross Profits</span>
                <span class="text-lg font-bold text-emerald-600 block mt-1">+$@tax.TotalGrossProfits.ToString("N2")</span>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-3xs font-sans text-slate-400 block uppercase">Gross Losses</span>
                <span class="text-lg font-bold text-rose-600 block mt-1">-$@Math.Abs(tax.TotalLosses).ToString("N2")</span>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-3xs font-sans text-slate-400 block uppercase">Fees & Overnight Swaps</span>
                <span class="text-lg font-bold text-slate-700 dark:text-slate-300 block mt-1">-$@Math.Abs(tax.TotalFeesAndSwaps).ToString("N2")</span>
            </div>
            <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                <span class="text-3xs font-sans text-slate-400 block uppercase">Net Realized P&L</span>
                <span class="text-lg font-bold block mt-1 @(isNetPositive ? "text-emerald-600" : "text-rose-600")">
                    @(isNetPositive ? "+$" : "-$")@Math.Abs(tax.NetRealizedGainLoss).ToString("N2")
                </span>
            </div>
        </div>

        <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-900 rounded-xl text-xs text-slate-600 dark:text-slate-400 flex items-center justify-between">
            <span>
                <i class="fa-solid fa-circle-info text-blue-500 mr-1.5"></i>
                <strong>Dutch Tax Authority (Belastingdienst):</strong> @tax.NetherlandsTaxNotes
            </span>
            <span class="font-mono text-2xs font-bold text-slate-500">Box 3 Regime</span>
        </div>
    </div>

    <!-- Quantitative Performance Metrics Ribbon (Pillar 8) -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 font-mono text-xs">
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-sans text-slate-400 block uppercase">Expectancy ($)</span>
            <div class="text-base font-bold text-emerald-600 mt-1">+$@an.ExpectancyDollars.ToString("N2")</div>
            <span class="text-3xs font-sans text-slate-400">Avg edge per trade</span>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-sans text-slate-400 block uppercase">Profit Factor</span>
            <div class="text-base font-bold text-slate-800 dark:text-white mt-1">@an.ProfitFactor.ToString("F2")</div>
            <span class="text-3xs font-sans text-slate-400">Wins / Losses</span>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-sans text-slate-400 block uppercase">Win Rate</span>
            <div class="text-base font-bold text-slate-800 dark:text-white mt-1">@an.WinRatePercent.ToString("F1")%</div>
            <span class="text-3xs font-sans text-slate-400">Win frequency</span>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-sans text-slate-400 block uppercase">Win / Loss Ratio</span>
            <div class="text-base font-bold text-brand-600 mt-1">@an.WinLossRatio.ToString("F2")</div>
            <span class="text-3xs font-sans text-slate-400">Avg Win / Avg Loss</span>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-sans text-slate-400 block uppercase">Sharpe Ratio</span>
            <div class="text-base font-bold text-slate-800 dark:text-white mt-1">@an.SharpeRatio.ToString("F2")</div>
            <span class="text-3xs font-sans text-slate-400">Risk-adjusted return</span>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-sans text-slate-400 block uppercase">Sortino Ratio</span>
            <div class="text-base font-bold text-blue-600 mt-1">@an.SortinoRatio.ToString("F2")</div>
            <span class="text-3xs font-sans text-slate-400">Downside deviation</span>
        </div>
    </div>

    <!-- R-Multiple Distribution Histogram & Performance Breakdown (Pillar 8) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- R-Multiple Distribution Histogram -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-column text-teal-600"></i> R-Multiple Distribution Histogram
                    </h2>
                    <p class="text-xs text-slate-400">Distribution of trade outcomes standardized by initial risk (1R = Initial Stop Loss)</p>
                </div>
                <span class="text-xs font-mono font-bold text-emerald-600">Target: Skew Right (> +2R)</span>
            </div>

            <div class="space-y-3 font-mono text-xs">
                @foreach (var b in an.RMultipleDistribution)
                {
                    var isPos = b.TotalNetProfit >= 0;
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <span class="font-bold text-slate-700 dark:text-slate-300">@b.RRangeLabel</span>
                            <span class="text-slate-500">@b.TradeCount trades (@b.PercentageOfTotal.ToString("F1")%) &bull; <strong class="@(isPos ? "text-emerald-600" : "text-rose-600")">@(isPos ? "+" : "")$@b.TotalNetProfit.ToString("N0")</strong></span>
                        </div>
                        <div class="w-full bg-slate-100 dark:bg-slate-900 h-2.5 rounded-full overflow-hidden">
                            <div class="h-full rounded-full @(b.RRangeLabel.StartsWith("+") ? "bg-emerald-500" : (b.RRangeLabel.StartsWith("-") ? "bg-rose-500" : "bg-amber-400"))" style="width: @(Math.Max(5, (int)b.PercentageOfTotal * 2))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Performance Attribution Breakdown -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <h2 class="text-base font-bold text-slate-800 dark:text-white mb-3 flex items-center gap-2">
                <i class="fa-solid fa-table-cells text-indigo-500"></i> Performance Attribution by Dimension
            </h2>
            <div class="overflow-x-auto max-h-72">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="text-2xs text-slate-400 uppercase font-sans border-b border-slate-100 dark:border-slate-700">
                        <tr>
                            <th class="py-2">Dimension</th>
                            <th class="py-2">Trades</th>
                            <th class="py-2">Win %</th>
                            <th class="py-2">Profit Factor</th>
                            <th class="py-2 text-right">Net Profit</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var d in an.PerformanceBySession.Concat(an.PerformanceByWeekday).Concat(an.PerformanceByStrategy))
                        {
                            var isWin = d.NetProfit >= 0;
                            <tr>
                                <td class="py-2 font-sans font-bold text-slate-800 dark:text-white">
                                    <span class="text-3xs uppercase font-normal text-slate-400 block">@d.Category</span>
                                    @d.Name
                                </td>
                                <td class="py-2">@d.TotalTrades</td>
                                <td class="py-2 font-bold @(d.WinRatePercent >= 60 ? "text-emerald-600" : "text-slate-700 dark:text-slate-300")">@d.WinRatePercent.ToString("F1")%</td>
                                <td class="py-2">@d.ProfitFactor.ToString("F2")</td>
                                <td class="py-2 text-right font-bold @(isWin ? "text-emerald-600" : "text-rose-600")">
                                    @(isWin ? "+$" : "-$")@Math.Abs(d.NetProfit).ToString("N0")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Journal Entries Feed -->
    <div class="space-y-4">
        <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
            <i class="fa-solid fa-list-check text-teal-600"></i> Trade Reflection & Psychology Logs (@Model.Entries.Count)
        </h2>

        @if (Model.Entries.Count == 0)
        {
            <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 text-center text-xs text-slate-400">
                No journal entries logged yet. Record your trade setup, psychological state, and discipline rating.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @foreach (var entry in Model.Entries)
                {
                    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col justify-between space-y-4">
                        <div>
                            <!-- Header row: Symbol, Session, Rating, Plan badge -->
                            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
                                <div class="flex items-center gap-2">
                                    <span class="text-base font-bold text-slate-800 dark:text-white">@entry.Symbol</span>
                                    <span class="px-2 py-0.5 rounded text-2xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                                        @entry.MarketSession
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded text-2xs font-bold @(entry.FollowedPlan ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300")">
                                        @(entry.FollowedPlan ? "Plan Followed" : "Plan Deviated")
                                    </span>
                                    <!-- Stars -->
                                    <div class="flex items-center text-amber-400 text-2xs">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fa-star @(i <= entry.ExecutionRating ? "fa-solid" : "fa-regular text-slate-300 dark:text-slate-600")"></i>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Setup & Emotional State -->
                            <div class="mt-3 flex items-center gap-4 text-xs">
                                <div>
                                    <span class="text-slate-400 text-2xs block">Setup Strategy</span>
                                    <span class="font-semibold text-slate-700 dark:text-slate-300">@entry.SetupType</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 text-2xs block">Mindset / Emotions</span>
                                    <span class="font-semibold text-slate-700 dark:text-slate-300">@entry.Emotions</span>
                                </div>
                                <div class="ml-auto text-right">
                                    <span class="text-slate-400 text-2xs block">Logged</span>
                                    <span class="font-mono text-2xs text-slate-500">@entry.TradeDateUtc.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>

                            <!-- Detailed Reflection -->
                            <p class="text-xs text-slate-600 dark:text-slate-400 mt-3 leading-relaxed">
                                @entry.DetailedNotes
                            </p>

                            @if (!string.IsNullOrEmpty(entry.Mistakes))
                            {
                                <div class="mt-3 p-2.5 bg-rose-500/5 rounded-xl border border-rose-500/20 text-xs">
                                    <span class="font-bold text-rose-700 dark:text-rose-400 block text-2xs uppercase">Mistake Identified:</span>
                                    <span class="text-slate-700 dark:text-slate-300">@entry.Mistakes</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(entry.LessonsLearned))
                            {
                                <div class="mt-2 p-2.5 bg-emerald-500/5 rounded-xl border border-emerald-500/20 text-xs">
                                    <span class="font-bold text-emerald-700 dark:text-emerald-400 block text-2xs uppercase">Lesson Learned:</span>
                                    <span class="text-slate-700 dark:text-slate-300">@entry.LessonsLearned</span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(entry.ScreenshotUrl))
                        {
                            <div class="pt-3 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between">
                                <a href="@entry.ScreenshotUrl" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1.5">
                                    <i class="fa-solid fa-image"></i> View Trade Chart Screenshot &rarr;
                                </a>
                                <a href="@entry.ScreenshotUrl" target="_blank" rel="noopener noreferrer" class="block w-16 h-10 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:opacity-80 transition-opacity">
                                    <img src="@entry.ScreenshotUrl" alt="Screenshot" class="w-full h-full object-cover" />
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- New Entry Modal (Hidden by default) -->
    <div id="newEntryModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-lg w-full p-6 border border-slate-200 dark:border-slate-700 shadow-xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
                <h3 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-pen-nib text-teal-600"></i> New Trade Journal Entry
                </h3>
                <button type="button" onclick="document.getElementById('newEntryModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form method="post" asp-action="Create" enctype="multipart/form-data" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Symbol</label>
                        <input type="text" name="Symbol" value="EUR/USD" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl font-bold text-slate-800 dark:text-white" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Session</label>
                        <select name="MarketSession" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white">
                            <option value="London">London Session</option>
                            <option value="New York">New York Session</option>
                            <option value="Tokyo">Tokyo Session</option>
                            <option value="Sydney">Sydney Session</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Setup Type</label>
                        <input type="text" name="SetupType" value="London Breakout" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Emotional State</label>
                        <select name="Emotions" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white">
                            <option value="Calm & Disciplined">Calm & Disciplined</option>
                            <option value="FOMO (Fear of Missing Out)">FOMO</option>
                            <option value="Hesitant / Scared">Hesitant / Scared</option>
                            <option value="Revenge Trading">Revenge Trading</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Execution Rating (1 - 5)</label>
                        <input type="number" min="1" max="5" name="ExecutionRating" value="5" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl font-bold text-slate-800 dark:text-white" />
                    </div>
                    <div class="flex items-center pt-5">
                        <label class="flex items-center gap-2 cursor-pointer font-semibold text-slate-700 dark:text-slate-300">
                            <input type="checkbox" name="FollowedPlan" value="true" checked class="w-4 h-4 text-teal-600 rounded" />
                            <span>Followed Plan Strict</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Detailed Analysis & Rationale</label>
                    <textarea name="DetailedNotes" rows="3" placeholder="Why did you enter? Key support/resistance levels, indicators..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white"></textarea>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Mistakes</label>
                        <input type="text" name="Mistakes" placeholder="Moved stop loss, rushed entry..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Lessons Learned</label>
                        <input type="text" name="LessonsLearned" placeholder="Wait for candle close..." class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white" />
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Upload Chart Screenshot</label>
                    <input type="file" name="screenshotFile" accept="image/*" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-800 dark:text-white text-xs file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-teal-50 file:text-teal-700 dark:file:bg-teal-900/30 dark:file:text-teal-300 hover:file:bg-teal-100" />
                    <p class="mt-1 text-2xs text-slate-400">Upload trade chart image (PNG, JPG, WEBP). Stored directly in local storage.</p>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-700">
                    <button type="button" onclick="document.getElementById('newEntryModal').classList.add('hidden')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold rounded-xl">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-xl shadow-xs">
                        Save Entry
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
