@model AzureTest.Contracts.DTOs.Forex.TradeTerminalDashboardDto
@{
    ViewData["Title"] = "Forex Demo Trading Terminal";
    var acc = Model.Account;
    var marginHealth = acc.MarginLevelPercent >= 200 ? "text-emerald-600" : acc.MarginLevelPercent >= 100 ? "text-amber-500" : "text-rose-600";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-800 dark:text-white">Forex Demo Trading Terminal</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                            DEMO / SIMULATED
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                            1:@acc.Leverage ESMA
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Zero financial risk demo environment. Test strategies, idempotency, and stop-loss mechanics.</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- Reset Demo Balance Form -->
            <form method="post" asp-action="ResetAccount" class="inline" onsubmit="return confirm('Reset demo account balance to $10,000? All open positions will be closed.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="InitialBalance" value="10000" />
                <input type="hidden" name="Leverage" value="30" />
                <button type="submit" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-rotate-left"></i> Reset Balance
                </button>
            </form>

            <a asp-area="Forex" asp-controller="ForexRisk" asp-action="Index" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl">
                <i class="fa-solid fa-calculator"></i> Risk & Margin
            </a>
        </div>
    </div>

    <!-- Account Monitor Ribbon -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Balance</span>
            <div class="text-base font-bold font-mono text-slate-800 dark:text-white mt-1">$@acc.Balance.ToString("N2")</div>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Equity</span>
            <div class="text-base font-bold font-mono @(acc.Equity >= acc.Balance ? "text-emerald-600" : "text-rose-600") mt-1">
                $@acc.Equity.ToString("N2")
            </div>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Used Margin</span>
            <div class="text-base font-bold font-mono text-slate-800 dark:text-white mt-1">$@acc.UsedMargin.ToString("N2")</div>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Free Margin</span>
            <div class="text-base font-bold font-mono text-slate-800 dark:text-white mt-1">$@acc.FreeMargin.ToString("N2")</div>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Margin Level</span>
            <div class="text-base font-bold font-mono @marginHealth mt-1">
                @(acc.UsedMargin == 0 ? "Infinite" : $"{acc.MarginLevelPercent:F0}%")
            </div>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Daily P&L</span>
            <div class="text-base font-bold font-mono @(acc.DailyPnl >= 0 ? "text-emerald-600" : "text-rose-600") mt-1">
                @(acc.DailyPnl >= 0 ? "+$" : "-$")@Math.Abs(acc.DailyPnl).ToString("N2")
            </div>
        </div>
        <div class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
            <span class="text-3xs font-semibold uppercase text-slate-400 block">Daily Drawdown</span>
            <div class="text-base font-bold font-mono text-rose-600 mt-1">
                @acc.DailyDrawdownPercent.ToString("F2")%
            </div>
        </div>
    </div>

    <!-- Order Execution Ticket & Live Quotes -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Order Ticket Form -->
        <div class="lg:col-span-2 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-ticket text-brand-500"></i> New Order Ticket
                </h2>
                <span class="text-xs font-mono text-slate-400">Safe Retry Idempotency Protected</span>
            </div>

            <form method="post" asp-action="PlaceOrder" id="orderForm" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="idempotencyKeyInput" name="IdempotencyKey" value="" />

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Symbol -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Instrument</label>
                        <select name="Symbol" id="ticketSymbol" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-800 dark:text-white">
                            @foreach (var q in Model.LiveWatchlist)
                            {
                                <option value="@q.Symbol" data-bid="@q.Bid" data-ask="@q.Ask">@q.Symbol (Spread: @q.SpreadPips pips)</option>
                            }
                        </select>
                    </div>

                    <!-- Order Type -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Order Type</label>
                        <select name="OrderType" id="ticketOrderType" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-semibold text-slate-800 dark:text-white">
                            <option value="Market" selected>Market Order</option>
                            <option value="Limit">Limit Order</option>
                            <option value="Stop">Stop Order</option>
                        </select>
                    </div>

                    <!-- Lot Size -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Volume (Lots)</label>
                        <input type="number" step="0.01" min="0.01" max="50" name="LotSize" value="0.10" id="ticketLotSize" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                        <span class="text-3xs text-slate-400 mt-0.5 block">0.10 lot = $1/pip on EUR/USD</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Price -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Price (Limit/Stop)</label>
                        <input type="number" step="0.00001" name="RequestedPrice" id="ticketPrice" value="1.08500" required class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    </div>

                    <!-- Stop Loss -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Stop Loss (Price)</label>
                        <input type="number" step="0.00001" name="StopLoss" id="ticketStopLoss" placeholder="Optional" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    </div>

                    <!-- Take Profit -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Take Profit (Price)</label>
                        <input type="number" step="0.00001" name="TakeProfit" id="ticketTakeProfit" placeholder="Optional" class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white" />
                    </div>
                </div>

                <!-- Direction Buttons (Buy / Sell) -->
                <div class="grid grid-cols-2 gap-4 pt-2">
                    <button type="submit" name="Direction" value="Sell" onclick="generateIdempotency()" class="py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm rounded-xl shadow-xs transition-colors flex items-center justify-center gap-2">
                        <i class="fa-solid fa-arrow-down"></i> SELL / SHORT
                    </button>
                    <button type="submit" name="Direction" value="Buy" onclick="generateIdempotency()" class="py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-xs transition-colors flex items-center justify-center gap-2">
                        <i class="fa-solid fa-arrow-up"></i> BUY / LONG
                    </button>
                </div>
            </form>
        </div>

        <!-- Quick Live Watchlist -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col justify-between">
            <div>
                <h2 class="text-sm font-bold text-slate-800 dark:text-white mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-list text-cyan-500"></i> Fast Watchlist
                </h2>
                <div class="space-y-2 max-h-64 overflow-y-auto">
                    @foreach (var q in Model.LiveWatchlist.Take(6))
                    {
                        <div class="p-2.5 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-between text-xs font-mono">
                            <div>
                                <span class="font-bold text-slate-800 dark:text-white font-sans">@q.Symbol</span>
                                <span class="text-3xs text-slate-400 block font-sans">Spread: @q.SpreadPips p</span>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-slate-800 dark:text-white">@q.Bid</div>
                                <span class="text-3xs @(q.ChangePercent >= 0 ? "text-emerald-600" : "text-rose-600")">
                                    @(q.ChangePercent >= 0 ? "+" : "")@q.ChangePercent.ToString("F2")%
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-700 text-center">
                <a asp-area="Forex" asp-controller="ForexMarket" asp-action="Index" class="text-xs text-brand-600 hover:text-brand-700 font-semibold">
                    View Full 15-Pair Market Rates &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Active Open Positions Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-xs">
        <div class="p-4 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-folder-open text-emerald-500"></i> Active Open Positions (@Model.OpenTrades.Count)
            </h2>
            <span class="text-xs text-slate-400">Live mark-to-market valuation</span>
        </div>

        @if (Model.OpenTrades.Count == 0)
        {
            <div class="p-8 text-center text-slate-400 text-xs">
                No open positions. Use the order ticket above to place a demo trade.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 font-sans text-2xs uppercase border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="px-4 py-3">Open Time</th>
                            <th class="px-4 py-3">Symbol</th>
                            <th class="px-4 py-3">Type</th>
                            <th class="px-4 py-3">Lots</th>
                            <th class="px-4 py-3">Open Price</th>
                            <th class="px-4 py-3">Current Price</th>
                            <th class="px-4 py-3">Stop Loss</th>
                            <th class="px-4 py-3">Take Profit</th>
                            <th class="px-4 py-3">Pips</th>
                            <th class="px-4 py-3">Unrealized P&L</th>
                            <th class="px-4 py-3 font-sans text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var tr in Model.OpenTrades)
                        {
                            var isWin = tr.UnrealizedPnl >= 0;
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750">
                                <td class="px-4 py-3 text-slate-500">@tr.OpenTimeUtc.ToString("MM-dd HH:mm")</td>
                                <td class="px-4 py-3 font-sans font-bold text-slate-800 dark:text-white">@tr.Symbol</td>
                                <td class="px-4 py-3">
                                    <span class="px-2 py-0.5 rounded text-3xs font-bold @(tr.Direction == ForexTradeDirection.Buy ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300")">
                                        @tr.Direction
                                    </span>
                                </td>
                                <td class="px-4 py-3">@tr.LotSize.ToString("F2")</td>
                                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">@tr.OpenPrice.ToString("F5")</td>
                                <td class="px-4 py-3 font-bold text-slate-800 dark:text-white">@tr.CurrentPrice.ToString("F5")</td>
                                <td class="px-4 py-3 text-rose-600">@(tr.StopLoss.HasValue ? tr.StopLoss.Value.ToString("F5") : "None")</td>
                                <td class="px-4 py-3 text-emerald-600">@(tr.TakeProfit.HasValue ? tr.TakeProfit.Value.ToString("F5") : "None")</td>
                                <td class="px-4 py-3 font-bold @(tr.UnrealizedPips >= 0 ? "text-emerald-600" : "text-rose-600")">
                                    @(tr.UnrealizedPips >= 0 ? "+" : "")@tr.UnrealizedPips.ToString("F1")
                                </td>
                                <td class="px-4 py-3 font-bold @(isWin ? "text-emerald-600" : "text-rose-600")">
                                    @(isWin ? "+$" : "-$")@Math.Abs(tr.UnrealizedPnl).ToString("F2")
                                </td>
                                <td class="px-4 py-3 font-sans text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Close Position Form -->
                                        <form method="post" asp-action="Close" class="inline" onsubmit="return confirm('Close this position immediately at market price?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tradeId" value="@tr.Id" />
                                            <button type="submit" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded text-2xs font-semibold">
                                                Close
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Pending Orders Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-xs">
        <div class="p-4 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-800 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-hourglass-half text-amber-500"></i> Pending Limit & Stop Orders (@Model.PendingOrders.Count)
            </h2>
            <span class="text-xs text-slate-400">Awaiting market trigger price</span>
        </div>

        @if (Model.PendingOrders.Count == 0)
        {
            <div class="p-6 text-center text-slate-400 text-xs">
                No active pending orders.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 font-sans text-2xs uppercase border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="px-4 py-2.5">Time Placed</th>
                            <th class="px-4 py-2.5">Symbol</th>
                            <th class="px-4 py-2.5">Order Type</th>
                            <th class="px-4 py-2.5">Direction</th>
                            <th class="px-4 py-2.5">Lots</th>
                            <th class="px-4 py-2.5">Trigger Price</th>
                            <th class="px-4 py-2.5">Stop Loss</th>
                            <th class="px-4 py-2.5">Take Profit</th>
                            <th class="px-4 py-2.5 font-sans text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var ord in Model.PendingOrders)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750">
                                <td class="px-4 py-2.5 text-slate-500">@ord.CreatedOn.ToString("MM-dd HH:mm")</td>
                                <td class="px-4 py-2.5 font-sans font-bold text-slate-800 dark:text-white">@ord.Symbol</td>
                                <td class="px-4 py-2.5">@ord.OrderType</td>
                                <td class="px-4 py-2.5">
                                    <span class="px-2 py-0.5 rounded text-3xs font-bold @(ord.Direction == ForexTradeDirection.Buy ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")">
                                        @ord.Direction
                                    </span>
                                </td>
                                <td class="px-4 py-2.5">@ord.LotSize.ToString("F2")</td>
                                <td class="px-4 py-2.5 font-bold">@ord.RequestedPrice.ToString("F5")</td>
                                <td class="px-4 py-2.5 text-rose-600">@(ord.StopLoss.HasValue ? ord.StopLoss.Value.ToString("F5") : "-")</td>
                                <td class="px-4 py-2.5 text-emerald-600">@(ord.TakeProfit.HasValue ? ord.TakeProfit.Value.ToString("F5") : "-")</td>
                                <td class="px-4 py-2.5 font-sans text-right">
                                    <form method="post" asp-action="Cancel" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@ord.Id" />
                                        <button type="submit" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 rounded text-2xs">
                                            Cancel
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
    function generateIdempotency() {
        var key = 'order_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        document.getElementById('idempotencyKeyInput').value = key;
    }
</script>
