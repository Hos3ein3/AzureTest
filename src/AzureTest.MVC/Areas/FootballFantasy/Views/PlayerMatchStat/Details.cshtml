@model AzureTest.Contracts.DTOs.FootballFantasy.PlayerMatchStatDto
@{
    ViewData["Title"] = "Match Stat Details";
}

<div class="max-w-3xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Match Stats</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">@Model.PlayerName</span>
    </div>
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">
            @Model.PlayerName &bull; <span class="text-base text-slate-500">@Model.FixtureName</span>
        </h1>
        <div class="space-x-2">
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg">Back to List</a>
        </div>
    </div>
</div>

<div class="max-w-3xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
            <div class="text-xs text-slate-400 font-semibold uppercase">Minutes</div>
            <div class="text-2xl font-black text-slate-900 dark:text-slate-100 mt-1">@Model.MinutesPlayed'</div>
        </div>
        <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
            <div class="text-xs text-slate-400 font-semibold uppercase">Goals</div>
            <div class="text-2xl font-black text-emerald-600 mt-1">@Model.Goals</div>
        </div>
        <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
            <div class="text-xs text-slate-400 font-semibold uppercase">Assists</div>
            <div class="text-2xl font-black text-blue-600 mt-1">@Model.Assists</div>
        </div>
        <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
            <div class="text-xs text-slate-400 font-semibold uppercase">Clean Sheet</div>
            <div class="text-2xl font-black @(Model.CleanSheet ? "text-emerald-600" : "text-slate-400") mt-1">@(Model.CleanSheet ? "Yes" : "No")</div>
        </div>
    </div>

    <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-700 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-semibold text-slate-600 dark:text-slate-400">
        <div>Shots: <span class="font-bold text-slate-900 dark:text-slate-100">@Model.ShotsTotal (@Model.ShotsOnTarget on target)</span></div>
        <div>Passes: <span class="font-bold text-slate-900 dark:text-slate-100">@Model.PassesTotal</span></div>
        <div>Key Passes: <span class="font-bold text-slate-900 dark:text-slate-100">@Model.KeyPasses</span></div>
        <div>Tackles: <span class="font-bold text-slate-900 dark:text-slate-100">@Model.Tackles</span></div>
        <div>Interceptions: <span class="font-bold text-slate-900 dark:text-slate-100">@Model.Interceptions</span></div>
        <div>Saves: <span class="font-bold text-slate-900 dark:text-slate-100">@Model.Saves</span></div>
        <div>Yellow Cards: <span class="font-bold text-amber-600">@Model.YellowCards</span></div>
        <div>Red Cards: <span class="font-bold text-rose-600">@Model.RedCards</span></div>
    </div>
</div>
