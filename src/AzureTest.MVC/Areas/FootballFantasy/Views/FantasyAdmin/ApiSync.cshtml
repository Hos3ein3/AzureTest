@model AzureTest.Contracts.DTOs.FootballFantasy.FootballApiProviderSettingsDto
@{
    ViewData["Title"] = "API-Football Provider & Data Sync";
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="flex items-center gap-3">
        <a asp-controller="FantasyAdmin" asp-action="Index" class="text-slate-400 hover:text-brand-600 transition-colors">
            <i class="fa-solid fa-arrow-left text-xl"></i>
        </a>
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100 flex items-center gap-2">
                <i class="fa-solid fa-satellite-dish text-brand-600"></i> API-Football Sync Center
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Configure credentials and sync real-world football entities (Countries, Leagues, Teams, Players, Fixtures & Match Stats).</p>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <form asp-action="TriggerSync" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="domain" value="all" />
            <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold rounded-xl shadow-sm transition-colors flex items-center">
                <i class="fa-solid fa-arrows-rotate mr-2"></i> Sync All Domains Now
            </button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-start" role="alert">
        <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 mr-3"></i>
        <div class="flex-1 text-sm font-medium text-emerald-800">@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 flex items-start" role="alert">
        <i class="fa-solid fa-triangle-exclamation text-red-500 mt-0.5 mr-3"></i>
        <div class="flex-1 text-sm font-medium text-red-800">@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Database Architecture Notice -->
<div class="mb-8 p-5 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-900 rounded-2xl border border-blue-100 dark:border-slate-700">
    <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center flex-shrink-0 text-lg">
            <i class="fa-solid fa-database"></i>
        </div>
        <div>
            <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">CQRS & Read-Only Database Pipeline</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">
                When you sync, data is fetched from <a href="https://www.api-football.com/" target="_blank" class="text-blue-600 font-semibold underline">API-Football</a> and committed to the primary transactional store, which streams into the dedicated <strong>ReadOnlyAzureTestDbContext</strong>. All high-traffic fantasy league tables, user lineups, prediction clubs, and match viewer pages read directly from the replica.
            </p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Provider Credentials & Settings Form -->
    <div class="lg:col-span-1 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm">
        <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base mb-4 flex items-center">
            <i class="fa-solid fa-key mr-2 text-brand-600"></i> Provider Credentials
        </h3>

        <form asp-action="SaveApiSettings" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Provider Platform</label>
                <input type="text" asp-for="ProviderName" readonly class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-semibold text-slate-500 cursor-not-allowed" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">API Key (<a href="https://dashboard.api-football.com/" target="_blank" class="text-brand-600 lowercase underline">get key</a>)</label>
                <input type="password" asp-for="ApiKey" placeholder="Enter API-Football v3 API Key..." class="w-full px-3.5 py-2.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-mono focus:ring-2 focus:ring-brand-500 focus:outline-none" />
                <p class="text-[11px] text-slate-400 mt-1">Sent as <code class="bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">x-apisports-key</code> in HTTP headers.</p>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase mb-1">Base Endpoint URL</label>
                <input type="text" asp-for="BaseUrl" class="w-full px-3.5 py-2.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-mono text-slate-700 dark:text-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none" />
            </div>

            <div class="pt-3">
                <button type="submit" class="w-full py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold rounded-xl transition-colors shadow-sm flex items-center justify-center">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> Save Provider Settings
                </button>
            </div>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-700 text-xs text-slate-500 space-y-1.5">
            <div><strong>Last Status:</strong> <span class="font-bold @(Model.LastSyncStatus == "Success" ? "text-emerald-600" : "text-amber-600")">@Model.LastSyncStatus</span></div>
            <div><strong>Last Synced:</strong> @(Model.LastSyncedAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</div>
            @if (!string.IsNullOrEmpty(Model.LastSyncMessage))
            {
                <div class="text-[11px] text-slate-400 mt-1 italic">"@Model.LastSyncMessage"</div>
            }
        </div>
    </div>

    <!-- Domain-Specific Sync Cards -->
    <div class="lg:col-span-2 space-y-4">
        <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base flex items-center mb-2">
            <i class="fa-solid fa-cubes-stacked mr-2 text-brand-600"></i> Domain Sync Operations
        </h3>

        <!-- Countries -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-earth-americas"></i>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">Countries</h4>
                    <p class="text-xs text-slate-400">Endpoint: <code class="font-mono text-slate-500">GET /countries</code></p>
                    <span class="text-xs font-semibold text-slate-500">Current in DB: @Model.CountriesSynced</span>
                </div>
            </div>
            <form asp-action="TriggerSync" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="domain" value="countries" />
                <button type="submit" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-brand-600 hover:text-white text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors flex items-center">
                    <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> Sync Countries
                </button>
            </form>
        </div>

        <!-- Leagues -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">Leagues & Tournaments</h4>
                    <p class="text-xs text-slate-400">Endpoint: <code class="font-mono text-slate-500">GET /leagues</code></p>
                    <span class="text-xs font-semibold text-slate-500">Current in DB: @Model.LeaguesSynced</span>
                </div>
            </div>
            <form asp-action="TriggerSync" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="domain" value="leagues" />
                <button type="submit" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-brand-600 hover:text-white text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors flex items-center">
                    <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> Sync Leagues
                </button>
            </form>
        </div>

        <!-- Teams -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-shield"></i>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">Teams & Clubs</h4>
                    <p class="text-xs text-slate-400">Endpoint: <code class="font-mono text-slate-500">GET /teams</code></p>
                    <span class="text-xs font-semibold text-slate-500">Current in DB: @Model.TeamsSynced</span>
                </div>
            </div>
            <form asp-action="TriggerSync" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="domain" value="teams" />
                <button type="submit" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-brand-600 hover:text-white text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors flex items-center">
                    <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> Sync Teams
                </button>
            </form>
        </div>

        <!-- Players -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-person-running"></i>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">Players</h4>
                    <p class="text-xs text-slate-400">Endpoint: <code class="font-mono text-slate-500">GET /players</code></p>
                    <span class="text-xs font-semibold text-slate-500">Current in DB: @Model.PlayersSynced</span>
                </div>
            </div>
            <form asp-action="TriggerSync" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="domain" value="players" />
                <button type="submit" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-brand-600 hover:text-white text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors flex items-center">
                    <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> Sync Players
                </button>
            </form>
        </div>

        <!-- Fixtures, Match Facts & Player Match Stats -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div>
                    <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">Fixtures, Match Facts & Player Match Stats</h4>
                    <p class="text-xs text-slate-400">Endpoints: <code class="font-mono text-slate-500">/fixtures/statistics & /fixtures/players</code></p>
                    <span class="text-xs font-semibold text-slate-500">Current Fixtures in DB: @Model.FixturesSynced</span>
                </div>
            </div>
            <form asp-action="TriggerSync" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="domain" value="fixtures" />
                <button type="submit" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-brand-600 hover:text-white text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors flex items-center">
                    <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> Sync Match Stats
                </button>
            </form>
        </div>
    </div>
</div>
