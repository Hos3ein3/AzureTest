@model AzureTest.Contracts.DTOs.FootballFantasy.PlayerDto
@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="max-w-4xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Players</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">@Model.DisplayName</span>
    </div>
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center space-x-3">
            @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" class="w-10 h-10 rounded-full object-cover border" alt="@Model.DisplayName" />
            }
            <span>@Model.DisplayName</span>
            <span class="text-xs font-semibold px-2.5 py-1 rounded bg-brand-50 text-brand-700 border border-brand-200">@Model.Position</span>
        </h1>
        <div class="space-x-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm">Edit</a>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg">Back to List</a>
        </div>
    </div>
</div>

<div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- FIFA Ultimate Team Card Preview -->
    <div class="bg-gradient-to-b from-amber-100 via-amber-50 to-amber-200 dark:from-amber-950 dark:via-slate-900 dark:to-slate-950 p-6 rounded-2xl border-2 border-amber-300 dark:border-amber-700 shadow-lg text-center flex flex-col items-center justify-between">
        <div class="w-full flex justify-between items-start text-amber-900 dark:text-amber-300">
            <div>
                <div class="text-3xl font-black">86</div>
                <div class="text-xs font-bold uppercase">@Model.Position</div>
            </div>
            <div class="text-right">
                <span class="text-xs font-mono font-bold bg-amber-200/60 dark:bg-amber-900/40 px-2 py-0.5 rounded">FUT</span>
            </div>
        </div>

        <div class="my-4">
            <img src="@(Model.PhotoUrl ?? "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=160&auto=format&fit=crop&q=80")" class="w-28 h-28 rounded-full object-cover border-4 border-amber-300 shadow-md" alt="@Model.DisplayName" />
            <div class="font-black text-lg text-slate-900 dark:text-slate-100 mt-2">@Model.DisplayName</div>
            <div class="text-xs font-semibold text-amber-700 dark:text-amber-400">@Model.CurrentTeamName</div>
        </div>

        <div class="w-full grid grid-cols-3 gap-1 pt-3 border-t border-amber-300/40 text-xs font-bold text-slate-700 dark:text-slate-300">
            <div>PAC <span class="text-emerald-600">88</span></div>
            <div>SHO <span class="text-emerald-600">84</span></div>
            <div>PAS <span class="text-emerald-600">82</span></div>
            <div>DRI <span class="text-emerald-600">87</span></div>
            <div>DEF <span class="text-emerald-600">55</span></div>
            <div>PHY <span class="text-emerald-600">76</span></div>
        </div>
    </div>

    <!-- Player Details Spec -->
    <div class="md:col-span-2 bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Player Details</h3>
        <dl class="grid grid-cols-2 gap-4">
            <div>
                <dt class="text-xs font-semibold text-slate-400 uppercase">Nationality</dt>
                <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@Model.CountryName</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-slate-400 uppercase">Current Team</dt>
                <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@Model.CurrentTeamName</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-slate-400 uppercase">Fantasy Price</dt>
                <dd class="text-base font-bold text-brand-600 mt-1">€@Model.CurrentPrice.ToString("F1")M</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold text-slate-400 uppercase">Status</dt>
                <dd class="text-base font-medium mt-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @(Model.IsActive ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-800")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </dd>
            </div>
        </dl>
    </div>
</div>
