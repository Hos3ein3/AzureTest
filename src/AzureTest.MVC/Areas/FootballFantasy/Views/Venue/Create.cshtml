@model AzureTest.Application.FootballFantasy.Commands.CreateVenueCommand
@{
    ViewData["Title"] = "Create Stadium / Venue";
    var countries = ViewBag.Countries as IReadOnlyList<AzureTest.Contracts.DTOs.FootballFantasy.CountryDto>;
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                <i class="fa-solid fa-landmark text-brand-600"></i> New Football Venue
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Register a stadium or match venue connected to a country.</p>
        </div>
        <a asp-action="Index" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200">
            Back to List
        </a>
    </div>

    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
        <form asp-action="Create" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Stadium / Venue Name *</label>
                <input asp-for="Name" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" placeholder="e.g. Santiago Bernabéu, Wembley Stadium" required />
                <span asp-validation-for="Name" class="text-xs text-rose-500"></span>
            </div>

            <div>
                <label asp-for="CountryId" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Host Country *</label>
                <select asp-for="CountryId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" required>
                    <option value="">-- Select Country --</option>
                    @if (countries != null)
                    {
                        foreach (var c in countries)
                        {
                            <option value="@c.Id">@c.Name (@c.Code) - @c.Continent</option>
                        }
                    }
                </select>
                <span asp-validation-for="CountryId" class="text-xs text-rose-500"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="City" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">City</label>
                    <input asp-for="City" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" placeholder="e.g. Madrid, London" />
                    <span asp-validation-for="City" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="Capacity" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Capacity (Seats)</label>
                    <input asp-for="Capacity" type="number" min="0" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" placeholder="e.g. 81044" />
                    <span asp-validation-for="Capacity" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Surface" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Pitch Surface</label>
                    <input asp-for="Surface" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" placeholder="e.g. Grass, Hybrid Grass, Artificial Turf" />
                    <span asp-validation-for="Surface" class="text-xs text-rose-500"></span>
                </div>
                <div>
                    <label asp-for="Address" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Street Address</label>
                    <input asp-for="Address" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" placeholder="e.g. Av. de Concha Espina, 1" />
                    <span asp-validation-for="Address" class="text-xs text-rose-500"></span>
                </div>
            </div>

            <div>
                <label asp-for="ImageUrl" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Stadium Image URL</label>
                <input asp-for="ImageUrl" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" placeholder="https://... or /ff/venues/..." />
                <span asp-validation-for="ImageUrl" class="text-xs text-rose-500"></span>
            </div>

            <div class="pt-4 flex items-center justify-end space-x-3">
                <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-sm font-semibold rounded-lg hover:bg-slate-200">Cancel</a>
                <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm">Save Venue</button>
            </div>
        </form>
    </div>
</div>
