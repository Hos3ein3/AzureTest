@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.FootballFantasy.VenueDto>
@{
    ViewData["Title"] = "Venues & Stadiums";
    var filter = ViewBag.Filter as AzureTest.Contracts.DTOs.FootballFantasy.VenueFilter;
    var countries = ViewBag.Countries as IReadOnlyList<AzureTest.Contracts.DTOs.FootballFantasy.CountryDto>;
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
            <i class="fa-solid fa-landmark text-brand-600"></i> Venues & Stadiums
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage stadiums, pitch surfaces, capacities, and host countries & resident clubs.</p>
    </div>
    <div class="flex items-center space-x-3">
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Add Venue
        </a>
    </div>
</div>

<div class="mb-6 bg-white dark:bg-slate-800 p-5 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700">
    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Search</label>
            <input type="text" name="SearchTerm" value="@filter?.SearchTerm" placeholder="Venue name or city..." class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Country</label>
            <select name="CountryId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3">
                <option value="">All Countries</option>
                @if (countries != null)
                {
                    foreach (var c in countries)
                    {
                        <option value="@c.Id" selected="@(filter?.CountryId == c.Id)">@c.Name (@c.Code)</option>
                    }
                }
            </select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">City</label>
            <input type="text" name="City" value="@filter?.City" placeholder="Filter by city..." class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 focus:border-brand-500 focus:ring-brand-500 py-2 px-3" />
        </div>
        <div class="flex items-end space-x-2">
            <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium rounded-lg">Filter</button>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-sm font-medium rounded-lg">Reset</a>
        </div>
    </form>
</div>

<div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
    <table class="min-w-full divide-y divide-slate-100 dark:divide-slate-700 text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-400 font-semibold text-xs uppercase tracking-wider">
            <tr>
                <th class="py-3.5 px-4 text-left">Venue</th>
                <th class="py-3.5 px-4 text-left">Country</th>
                <th class="py-3.5 px-4 text-left">City / Address</th>
                <th class="py-3.5 px-4 text-center">Capacity</th>
                <th class="py-3.5 px-4 text-center">Surface</th>
                <th class="py-3.5 px-4 text-center">Teams</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="py-8 text-center text-slate-400">No stadiums or venues found.</td>
                </tr>
            }
            @foreach (var v in Model.Items)
            {
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/40">
                    <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-100 flex items-center space-x-3">
                        @if (!string.IsNullOrWhiteSpace(v.ImageUrl))
                        {
                            <img src="@v.ImageUrl" class="w-10 h-8 rounded object-cover shadow-sm border" alt="@v.Name" />
                        }
                        else
                        {
                            <div class="w-10 h-8 rounded bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-400 text-sm">
                                <i class="fa-solid fa-landmark"></i>
                            </div>
                        }
                        <div>
                            <span class="font-bold">@v.Name</span>
                        </div>
                    </td>
                    <td class="py-3 px-4 text-slate-600 dark:text-slate-400">
                        <span class="inline-flex items-center gap-1.5 font-medium">
                            <i class="fa-solid fa-earth-americas text-xs text-slate-400"></i>
                            @v.CountryName
                        </span>
                    </td>
                    <td class="py-3 px-4 text-slate-600 dark:text-slate-400">
                        <div class="font-medium text-slate-700 dark:text-slate-300">@(v.City ?? "—")</div>
                        @if (!string.IsNullOrWhiteSpace(v.Address))
                        {
                            <div class="text-xs text-slate-400 truncate max-w-xs">@v.Address</div>
                        }
                    </td>
                    <td class="py-3 px-4 text-center font-mono font-medium">
                        @(v.Capacity.HasValue ? v.Capacity.Value.ToString("N0") : "—")
                    </td>
                    <td class="py-3 px-4 text-center">
                        <span class="text-xs px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium">
                            @(v.Surface ?? "Grass")
                        </span>
                    </td>
                    <td class="py-3 px-4 text-center">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                            @v.TeamsCount @(v.TeamsCount == 1 ? "team" : "teams")
                        </span>
                    </td>
                    <td class="py-3 px-4 text-right space-x-2">
                        <a asp-action="Details" asp-route-id="@v.Id" class="text-slate-600 hover:text-brand-600 text-xs font-semibold">Details</a>
                        <a asp-action="Edit" asp-route-id="@v.Id" class="text-brand-600 hover:text-brand-700 text-xs font-semibold">Edit</a>
                        <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="inline" onsubmit="return confirm('Delete this venue? Any linked teams will be detached.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-rose-600 hover:text-rose-700 text-xs font-semibold">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
