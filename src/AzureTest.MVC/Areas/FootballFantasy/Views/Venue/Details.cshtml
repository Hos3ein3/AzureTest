@model AzureTest.Contracts.DTOs.FootballFantasy.VenueDto
@{
    ViewData["Title"] = $"{Model.Name} - Venue Details";
    var teams = ViewBag.Teams as IReadOnlyList<AzureTest.Contracts.DTOs.FootballFantasy.TeamDto>;
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                <i class="fa-solid fa-landmark text-brand-600"></i> @Model.Name
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                <i class="fa-solid fa-earth-americas mr-1"></i> @Model.CountryName @(!string.IsNullOrWhiteSpace(Model.City) ? $" • {Model.City}" : "")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm">
                <i class="fa-solid fa-pen-to-square mr-1.5"></i> Edit Venue
            </a>
            <a asp-action="Index" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-semibold rounded-lg hover:bg-slate-200">
                Back to Venues
            </a>
        </div>
    </div>

    <!-- Stadium Banner & Specs -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="w-full h-64 bg-slate-100 dark:bg-slate-900 relative overflow-hidden">
                <img src="@Model.ImageUrl" class="w-full h-full object-cover" alt="@Model.Name" />
            </div>
        }

        <div class="p-6">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Capacity</div>
                    <div class="text-xl font-black text-slate-800 dark:text-slate-100 mt-1 font-mono">
                        @(Model.Capacity.HasValue ? Model.Capacity.Value.ToString("N0") : "N/A")
                    </div>
                </div>

                <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Surface</div>
                    <div class="text-xl font-bold text-slate-800 dark:text-slate-100 mt-1">
                        @(Model.Surface ?? "Grass")
                    </div>
                </div>

                <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Host Nation</div>
                    <div class="text-xl font-bold text-slate-800 dark:text-slate-100 mt-1">
                        @Model.CountryName
                    </div>
                </div>

                <div class="p-4 bg-slate-50 dark:bg-slate-900/40 rounded-xl">
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Resident Clubs</div>
                    <div class="text-xl font-black text-emerald-600 mt-1">
                        @Model.TeamsCount
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Address))
            {
                <div class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-2">
                    <i class="fa-solid fa-location-dot text-rose-500"></i>
                    <span>@Model.Address</span>
                </div>
            }
        </div>
    </div>

    <!-- Connected Teams Section -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700 p-6">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 text-base flex items-center gap-2">
                    <i class="fa-solid fa-shield text-emerald-600"></i> Teams Playing at this Venue
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">Clubs and national teams that use @Model.Name as their home ground.</p>
            </div>
            <a asp-controller="Team" asp-action="Create" class="text-xs font-semibold text-brand-600 hover:text-brand-700">
                + Add Team
            </a>
        </div>

        @if (teams == null || teams.Count == 0)
        {
            <div class="py-8 text-center text-slate-400 text-sm">
                No teams are currently assigned to this stadium.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var team in teams)
                {
                    <div class="p-4 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-brand-500 transition-colors flex items-center justify-between bg-slate-50 dark:bg-slate-900/40">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(team.LogoUrl))
                            {
                                <img src="@team.LogoUrl" class="w-10 h-10 rounded-full object-cover border" alt="@team.Name" />
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-500">
                                    <i class="fa-solid fa-shield"></i>
                                </div>
                            }
                            <div>
                                <div class="font-bold text-slate-800 dark:text-slate-100 text-sm">@team.Name</div>
                                <div class="text-xs text-slate-400">@team.ShortName • @team.TeamType</div>
                            </div>
                        </div>
                        <a asp-controller="Team" asp-action="Details" asp-route-id="@team.Id" class="text-xs font-semibold text-brand-600 hover:text-brand-700 px-3 py-1 bg-white dark:bg-slate-800 rounded-lg border shadow-xs">
                            View Club
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
