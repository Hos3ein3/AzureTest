<!-- Reusable Interactive HTML5 Canvas Logo Designer Modal (Supports Team Badge & League Trophy/Logo modes) -->
<div id="logoCanvasModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <i id="canvasModalHeaderIcon" class="fa-solid fa-shield-halved text-brand-600 text-xl"></i>
                <h3 id="canvasModalHeaderTitle" class="font-bold text-lg text-slate-800 dark:text-slate-100">Badge & Logo Designer</h3>
            </div>
            <button type="button" onclick="closeLogoCanvasModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-lg transition-colors">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
            <!-- Canvas Live Preview -->
            <div class="flex flex-col items-center justify-center bg-slate-50 dark:bg-slate-900/50 p-5 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700">
                <canvas id="designerCanvas" width="200" height="200" class="drop-shadow-xl rounded-2xl bg-transparent"></canvas>
                <div class="flex items-center gap-2 mt-3 text-xs text-slate-400 font-medium">
                    <span id="canvasModeLabelBadge" class="px-2 py-0.5 rounded-full bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-400 font-semibold uppercase text-[10px]">Team Mode</span>
                    <span>200x200 Canvas Vector</span>
                </div>
            </div>

            <!-- Customization Controls -->
            <div class="space-y-3.5 max-h-[380px] overflow-y-auto pr-1">
                <!-- Frame Shape -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Frame Shape</label>
                    <select id="canvasShapeSelect" onchange="renderDesignerCanvas()" class="w-full text-sm border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-brand-500">
                        <!-- Populated by JS based on mode -->
                    </select>
                </div>

                <!-- Gradient Colors -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Primary Color</label>
                        <input type="color" id="canvasBgColor1" value="#0d9488" onchange="renderDesignerCanvas()" class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-600 cursor-pointer p-0.5" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Secondary Color</label>
                        <input type="color" id="canvasBgColor2" value="#111827" onchange="renderDesignerCanvas()" class="w-full h-9 rounded-lg border border-slate-300 dark:border-slate-600 cursor-pointer p-0.5" />
                    </div>
                </div>

                <!-- Gradient Style & Pattern Overlay -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Gradient Style</label>
                        <select id="canvasGradientStyle" onchange="renderDesignerCanvas()" class="w-full text-sm border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100">
                            <option value="diagonal">Diagonal</option>
                            <option value="radial">Radial Glow</option>
                            <option value="vertical">Vertical</option>
                            <option value="split">Half & Half</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Pattern Overlay</label>
                        <select id="canvasPatternOverlay" onchange="renderDesignerCanvas()" class="w-full text-sm border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100">
                            <option value="none">None</option>
                            <option value="stripes">Vertical Stripes</option>
                            <option value="stars">Star Particles</option>
                            <option value="dots">Halftone Dots</option>
                        </select>
                    </div>
                </div>

                <!-- Center Emblem / Symbol -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Center Emblem</label>
                    <select id="canvasEmblemSelect" onchange="renderDesignerCanvas()" class="w-full text-sm border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-2 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-brand-500">
                        <!-- Populated by JS based on mode -->
                    </select>
                </div>

                <!-- Border Style & Color -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Rim Trim</label>
                        <select id="canvasRimTrim" onchange="renderDesignerCanvas()" class="w-full text-sm border border-slate-300 dark:border-slate-600 rounded-lg px-2.5 py-1.5 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100">
                            <option value="gold">Gold Crown</option>
                            <option value="silver">Silver Platinum</option>
                            <option value="bronze">Bronze Metal</option>
                            <option value="neon">Neon Cyan</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Ribbon / Text</label>
                        <input type="text" id="canvasTextBadge" maxlength="6" placeholder="e.g. FFL" value="PRO" oninput="renderDesignerCanvas()" class="w-full text-sm border border-slate-300 dark:border-slate-600 rounded-lg px-3 py-1.5 bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-100 focus:ring-1 focus:ring-brand-500 uppercase" />
                    </div>
                </div>
            </div>
        </div>

        <div class="px-6 py-4 bg-slate-50 dark:bg-slate-900/40 border-t border-slate-100 dark:border-slate-700 flex justify-between items-center">
            <button type="button" onclick="randomizeDesigner()" class="text-xs text-brand-600 hover:text-brand-700 dark:text-brand-400 font-semibold flex items-center">
                <i class="fa-solid fa-dice mr-1.5"></i> Randomize
            </button>
            <div class="flex items-center space-x-3">
                <button type="button" onclick="closeLogoCanvasModal()" class="px-4 py-2 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                    Cancel
                </button>
                <button type="button" onclick="applyCanvasLogo()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors flex items-center">
                    <i class="fa-solid fa-check mr-2"></i> Apply Logo
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Global active context for the designer: 'team' or 'league'
    let currentDesignerMode = 'team';
    let targetLogoInputId = 'teamLogoUrlInput';
    let targetPreviewImgId = 'teamLogoPreview';
    let targetDefaultIconId = 'defaultCrestIcon';

    // Different shapes and emblems tailored to Teams vs Leagues
    const teamShapes = [
        { value: 'shield', label: 'Classic Club Shield' },
        { value: 'circle', label: 'Modern Roundel Crest' },
        { value: 'hexagon', label: 'Geometric Hexagon' },
        { value: 'diamond', label: 'Diamond Badge' },
        { value: 'pennant', label: 'Pointed Pennant' }
    ];

    const leagueShapes = [
        { value: 'wreath', label: 'Championship Laurel Wreath' },
        { value: 'shield_ribbon', label: 'Cup Shield with Ribbon' },
        { value: 'star_burst', label: 'Octagon League Insignia' },
        { value: 'golden_roundel', label: 'Official Federation Roundel' },
        { value: 'trophy_crest', label: 'Tournament Grand Crest' }
    ];

    const teamEmblems = [
        { value: '⚽', label: '⚽ Football Ball' },
        { value: '🦁', label: '🦁 Fierce Lion' },
        { value: '🦅', label: '🦅 Soaring Eagle' },
        { value: '⚡', label: '⚡ Lightning Thunder' },
        { value: '🔥', label: '🔥 Inferno Flame' },
        { value: '🐉', label: '🐉 Dragon' },
        { value: '🐺', label: '🐺 Wolf' },
        { value: '🛡️', label: '🛡️ Armor Shield' },
        { value: '⚔️', label: '⚔️ Crossed Swords' },
        { value: '🎯', label: '🎯 Bullseye' }
    ];

    const leagueEmblems = [
        { value: '🏆', label: '🏆 Champions Trophy' },
        { value: '👑', label: '👑 Golden Crown' },
        { value: '🌍', label: '🌍 World Cup Globe' },
        { value: '⭐', label: '⭐ Golden Star' },
        { value: '✨', label: '✨ Sparkle Constellation' },
        { value: '🎖️', label: '🎖️ Medal of Honor' },
        { value: '🔱', label: '🔱 Trident Empire' },
        { value: '🥇', label: '🥇 First Place Gold' },
        { value: '🏟️', label: '🏟️ Colosseum Arena' },
        { value: '🌟', label: '🌟 Star of Champions' }
    ];

    function openLogoCanvasModal(mode = 'team', inputId = null, previewId = null, iconId = null) {
        currentDesignerMode = mode;
        targetLogoInputId = inputId || (mode === 'league' ? 'leagueLogoUrlInput' : 'teamLogoUrlInput');
        targetPreviewImgId = previewId || (mode === 'league' ? 'leagueLogoPreview' : 'teamLogoPreview');
        targetDefaultIconId = iconId || (mode === 'league' ? 'defaultLeagueCrestIcon' : 'defaultCrestIcon');

        // Configure UI labels & icons based on mode
        const headerTitle = document.getElementById('canvasModalHeaderTitle');
        const headerIcon = document.getElementById('canvasModalHeaderIcon');
        const modeBadge = document.getElementById('canvasModeLabelBadge');

        if (mode === 'league') {
            headerTitle.textContent = 'Fantasy League Trophy & Logo Designer';
            headerIcon.className = 'fa-solid fa-trophy text-amber-500 text-xl';
            modeBadge.textContent = 'League Tournament Mode';
            modeBadge.className = 'px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 font-semibold uppercase text-[10px]';
        } else {
            headerTitle.textContent = 'Team Crest & Badge Designer';
            headerIcon.className = 'fa-solid fa-shield-halved text-brand-600 text-xl';
            modeBadge.textContent = 'Fantasy Team Mode';
            modeBadge.className = 'px-2 py-0.5 rounded-full bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-400 font-semibold uppercase text-[10px]';
        }

        // Populate shape options
        const shapeSelect = document.getElementById('canvasShapeSelect');
        shapeSelect.innerHTML = '';
        const shapes = mode === 'league' ? leagueShapes : teamShapes;
        shapes.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.value;
            opt.textContent = s.label;
            shapeSelect.appendChild(opt);
        });

        // Populate emblem options
        const emblemSelect = document.getElementById('canvasEmblemSelect');
        emblemSelect.innerHTML = '';
        const emblems = mode === 'league' ? leagueEmblems : teamEmblems;
        emblems.forEach(e => {
            const opt = document.createElement('option');
            opt.value = e.value;
            opt.textContent = e.label;
            emblemSelect.appendChild(opt);
        });

        // Preset defaults
        if (mode === 'league') {
            document.getElementById('canvasBgColor1').value = '#1e1b4b'; // deep indigo
            document.getElementById('canvasBgColor2').value = '#b45309'; // gold/amber
            document.getElementById('canvasTextBadge').value = 'CUP';
            document.getElementById('canvasRimTrim').value = 'gold';
        } else {
            document.getElementById('canvasBgColor1').value = '#0d9488'; // teal
            document.getElementById('canvasBgColor2').value = '#0f172a'; // slate
            document.getElementById('canvasTextBadge').value = 'FC';
            document.getElementById('canvasRimTrim').value = 'silver';
        }

        document.getElementById('logoCanvasModal').classList.remove('hidden');
        renderDesignerCanvas();
    }

    function closeLogoCanvasModal() {
        document.getElementById('logoCanvasModal').classList.add('hidden');
    }

    function randomizeDesigner() {
        const shapeSelect = document.getElementById('canvasShapeSelect');
        shapeSelect.selectedIndex = Math.floor(Math.random() * shapeSelect.options.length);

        const emblemSelect = document.getElementById('canvasEmblemSelect');
        emblemSelect.selectedIndex = Math.floor(Math.random() * emblemSelect.options.length);

        const randHex = () => '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6, '0');
        document.getElementById('canvasBgColor1').value = randHex();
        document.getElementById('canvasBgColor2').value = randHex();

        const gradStyles = ['diagonal', 'radial', 'vertical', 'split'];
        document.getElementById('canvasGradientStyle').value = gradStyles[Math.floor(Math.random() * gradStyles.length)];

        const patterns = ['none', 'stripes', 'stars', 'dots'];
        document.getElementById('canvasPatternOverlay').value = patterns[Math.floor(Math.random() * patterns.length)];

        renderDesignerCanvas();
    }

    function renderDesignerCanvas() {
        const canvas = document.getElementById('designerCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const width = canvas.width;
        const height = canvas.height;

        ctx.clearRect(0, 0, width, height);

        const shape = document.getElementById('canvasShapeSelect').value;
        const color1 = document.getElementById('canvasBgColor1').value;
        const color2 = document.getElementById('canvasBgColor2').value;
        const gradStyle = document.getElementById('canvasGradientStyle').value;
        const pattern = document.getElementById('canvasPatternOverlay').value;
        const emblem = document.getElementById('canvasEmblemSelect').value;
        const text = (document.getElementById('canvasTextBadge').value || '').toUpperCase();
        const rim = document.getElementById('canvasRimTrim').value;

        // Build Gradient
        let grad;
        if (gradStyle === 'radial') {
            grad = ctx.createRadialGradient(width / 2, height / 2, 10, width / 2, height / 2, 95);
            grad.addColorStop(0, color1);
            grad.addColorStop(1, color2);
        } else if (gradStyle === 'vertical') {
            grad = ctx.createLinearGradient(0, 0, 0, height);
            grad.addColorStop(0, color1);
            grad.addColorStop(1, color2);
        } else if (gradStyle === 'split') {
            grad = ctx.createLinearGradient(0, 0, width, 0);
            grad.addColorStop(0, color1);
            grad.addColorStop(0.5, color1);
            grad.addColorStop(0.501, color2);
            grad.addColorStop(1, color2);
        } else {
            // diagonal default
            grad = ctx.createLinearGradient(0, 0, width, height);
            grad.addColorStop(0, color1);
            grad.addColorStop(1, color2);
        }

        ctx.save();
        ctx.beginPath();

        // Draw shape path
        if (shape === 'circle' || shape === 'golden_roundel') {
            ctx.arc(width / 2, height / 2, 86, 0, Math.PI * 2);
        } else if (shape === 'shield') {
            ctx.moveTo(35, 25);
            ctx.lineTo(width - 35, 25);
            ctx.lineTo(width - 35, 105);
            ctx.quadraticCurveTo(width - 35, 175, width / 2, 190);
            ctx.quadraticCurveTo(35, 175, 35, 105);
            ctx.closePath();
        } else if (shape === 'shield_ribbon') {
            ctx.moveTo(30, 20);
            ctx.lineTo(width - 30, 20);
            ctx.lineTo(width - 30, 110);
            ctx.quadraticCurveTo(width - 30, 180, width / 2, 192);
            ctx.quadraticCurveTo(30, 180, 30, 110);
            ctx.closePath();
        } else if (shape === 'hexagon') {
            const r = 88;
            for (let i = 0; i < 6; i++) {
                const a = (i * Math.PI) / 3 - Math.PI / 6;
                const x = width / 2 + r * Math.cos(a);
                const y = height / 2 + r * Math.sin(a);
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.closePath();
        } else if (shape === 'diamond') {
            ctx.moveTo(width / 2, 12);
            ctx.lineTo(width - 15, height / 2);
            ctx.lineTo(width / 2, height - 12);
            ctx.lineTo(15, height / 2);
            ctx.closePath();
        } else if (shape === 'pennant') {
            ctx.moveTo(30, 20);
            ctx.lineTo(width - 30, 20);
            ctx.lineTo(width / 2, 188);
            ctx.closePath();
        } else if (shape === 'star_burst' || shape === 'trophy_crest') {
            // Octagon League Badge
            const r = 88;
            for (let i = 0; i < 8; i++) {
                const a = (i * Math.PI) / 4 - Math.PI / 8;
                const x = width / 2 + r * Math.cos(a);
                const y = height / 2 + r * Math.sin(a);
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.closePath();
        } else if (shape === 'wreath') {
            ctx.arc(width / 2, height / 2, 82, 0, Math.PI * 2);
        } else {
            ctx.arc(width / 2, height / 2, 85, 0, Math.PI * 2);
        }

        ctx.fillStyle = grad;
        ctx.fill();

        // Pattern overlay clipped to frame
        ctx.clip();
        if (pattern === 'stripes') {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
            for (let x = 0; x < width; x += 18) {
                ctx.fillRect(x, 0, 9, height);
            }
        } else if (pattern === 'stars') {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
            for (let i = 0; i < 16; i++) {
                const sx = (i * 37) % width;
                const sy = (i * 29) % height;
                ctx.beginPath();
                ctx.arc(sx, sy, 3, 0, Math.PI * 2);
                ctx.fill();
            }
        } else if (pattern === 'dots') {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.07)';
            for (let px = 10; px < width; px += 16) {
                for (let py = 10; py < height; py += 16) {
                    ctx.beginPath();
                    ctx.arc(px, py, 2.5, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
        }
        ctx.restore();

        // Draw Rim Borders
        ctx.save();
        let rimColor = '#ffffff';
        let innerRimColor = '#fbbf24'; // gold
        if (rim === 'gold') {
            rimColor = '#fef08a';
            innerRimColor = '#d97706';
        } else if (rim === 'silver') {
            rimColor = '#f1f5f9';
            innerRimColor = '#94a3b8';
        } else if (rim === 'bronze') {
            rimColor = '#fed7aa';
            innerRimColor = '#b45309';
        } else if (rim === 'neon') {
            rimColor = '#22d3ee';
            innerRimColor = '#06b6d4';
        }

        ctx.lineWidth = 6;
        ctx.strokeStyle = rimColor;
        ctx.stroke();

        ctx.lineWidth = 2;
        ctx.strokeStyle = innerRimColor;
        ctx.stroke();
        ctx.restore();

        // Championship Laurel Wreath decor for League mode
        if (shape === 'wreath' || currentDesignerMode === 'league') {
            ctx.save();
            ctx.font = '22px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = innerRimColor;
            ctx.fillText('🌿', 26, height / 2);
            ctx.fillText('🌿', width - 26, height / 2);
            ctx.restore();
        }

        // Center Emblem
        ctx.save();
        ctx.font = '52px "Segoe UI Emoji", "Apple Color Emoji", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.shadowColor = 'rgba(0, 0, 0, 0.4)';
        ctx.shadowBlur = 8;
        ctx.fillText(emblem, width / 2, height / 2 - 14);
        ctx.restore();

        // Text Badge / Banner
        if (text) {
            ctx.save();
            ctx.font = '900 16px Inter, system-ui, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            // Ribbon banner background
            ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
            ctx.beginPath();
            ctx.roundRect(width / 2 - 45, height / 2 + 30, 90, 24, 6);
            ctx.fill();
            ctx.lineWidth = 1.5;
            ctx.strokeStyle = innerRimColor;
            ctx.stroke();

            // Ribbon text
            ctx.fillStyle = '#ffffff';
            ctx.fillText(text, width / 2, height / 2 + 42);
            ctx.restore();
        }
    }

    function applyCanvasLogo() {
        const canvas = document.getElementById('designerCanvas');
        if (!canvas) return;
        const dataUrl = canvas.toDataURL('image/png');

        const logoInput = document.getElementById(targetLogoInputId);
        if (logoInput) logoInput.value = dataUrl;

        const previewImg = document.getElementById(targetPreviewImgId);
        if (previewImg) {
            previewImg.src = dataUrl;
            previewImg.classList.remove('hidden');
        }

        const defaultIcon = document.getElementById(targetDefaultIconId);
        if (defaultIcon) defaultIcon.classList.add('hidden');

        closeLogoCanvasModal();
    }

    function handleLocalImageUpload(input, inputId = null, previewId = null, iconId = null) {
        const targetInput = inputId || targetLogoInputId;
        const targetPreview = previewId || targetPreviewImgId;
        const targetIcon = iconId || targetDefaultIconId;

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                const logoInput = document.getElementById(targetInput);
                if (logoInput) logoInput.value = dataUrl;

                const previewImg = document.getElementById(targetPreview);
                if (previewImg) {
                    previewImg.src = dataUrl;
                    previewImg.classList.remove('hidden');
                }

                const defaultIcon = document.getElementById(targetIcon);
                if (defaultIcon) defaultIcon.classList.add('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
