@model AzureTest.Contracts.DTOs.FootballFantasy.JoinLeagueRequest
@{
    ViewData["Title"] = "Create Fantasy Team & Join League";
    var league = ViewBag.League as AzureTest.Contracts.DTOs.FootballFantasy.FantasyLeagueDto;
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2">
                <a asp-action="Details" asp-route-id="@Model.FantasyLeagueId" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Create Team & Join</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 ml-9">Joining league: <span class="font-bold text-slate-800 dark:text-slate-200">@(league?.Name ?? "Fantasy League")</span></p>
        </div>
    </div>

    <form asp-action="Join" method="post" class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-sm p-6 sm:p-8 space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FantasyLeagueId" />

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400 p-3 bg-red-50 dark:bg-red-950/30 rounded-lg"></div>

        <div>
            <label asp-for="TeamName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Team Name</label>
            <input asp-for="TeamName" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" placeholder="e.g. Red Dragons FC" required />
            <span asp-validation-for="TeamName" class="text-xs text-red-500 mt-1"></span>
        </div>

        @if (league != null && league.Visibility == AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Private)
        {
            <div>
                <label asp-for="JoinCode" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">League Join Code</label>
                <input asp-for="JoinCode" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500 font-mono" placeholder="Enter private league password/code" required />
            </div>
        }

        <!-- Team Crest / Logo Selection with 3 Modes: URL, File upload, or Interactive Canvas -->
        <div class="pt-4 border-t border-slate-100 dark:border-slate-700/60">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Team Badge / Crest</label>
            
            <div class="flex items-center gap-4 mb-4">
                <div class="w-20 h-20 rounded-2xl bg-slate-100 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-700 flex items-center justify-center overflow-hidden flex-shrink-0 shadow-inner">
                    <img id="teamLogoPreview" src="" alt="Crest Preview" class="w-full h-full object-contain hidden" />
                    <i id="defaultCrestIcon" class="fa-solid fa-shield text-3xl text-slate-300 dark:text-slate-600"></i>
                </div>
                <div class="space-y-1">
                    <div class="text-sm font-bold text-slate-800 dark:text-slate-200">Design or Upload Badge</div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Choose between URL, selecting an image from your computer, or building a custom crest using our built-in canvas creator.</p>
                </div>
            </div>

            <!-- Hidden Logo Url input populated by either URL or Canvas DataUrl -->
            <input type="hidden" asp-for="LogoUrl" id="teamLogoUrlInput" />

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Option 1: Canvas Creator -->
                <button type="button" onclick="openLogoCanvasModal()" class="flex flex-col items-center justify-center p-4 rounded-xl border-2 border-brand-500/40 bg-brand-50/30 dark:bg-brand-950/20 hover:border-brand-500 transition-all text-center group">
                    <i class="fa-solid fa-wand-magic-sparkles text-xl text-brand-600 mb-1 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Built-in Designer</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">Canvas Crest Builder</span>
                </button>

                <!-- Option 2: Upload File -->
                <label class="flex flex-col items-center justify-center p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-slate-50 dark:hover:bg-slate-600/50 cursor-pointer transition-all text-center group">
                    <i class="fa-solid fa-cloud-arrow-up text-xl text-slate-500 dark:text-slate-400 mb-1 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Upload File</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">PNG, JPG from PC</span>
                    <input type="file" accept="image/*" class="hidden" onchange="handleLocalImageUpload(this)" />
                </label>

                <!-- Option 3: Image URL input toggle -->
                <button type="button" onclick="document.getElementById('urlInputContainer').classList.toggle('hidden')" class="flex flex-col items-center justify-center p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-slate-50 dark:hover:bg-slate-600/50 transition-all text-center group">
                    <i class="fa-solid fa-link text-xl text-slate-500 dark:text-slate-400 mb-1 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Image URL</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">Direct web link</span>
                </button>
            </div>

            <!-- Direct URL input -->
            <div id="urlInputContainer" class="hidden mt-3">
                <input type="url" id="manualUrlField" oninput="document.getElementById('teamLogoUrlInput').value = this.value; document.getElementById('teamLogoPreview').src = this.value; document.getElementById('teamLogoPreview').classList.remove('hidden');" placeholder="https://example.com/crest.png" class="w-full px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200" />
            </div>
        </div>

        @if (league != null && league.AllowCoach)
        {
            var coaches = ViewBag.Coaches as IEnumerable<AzureTest.Contracts.DTOs.FootballFantasy.CoachDto> ?? Enumerable.Empty<AzureTest.Contracts.DTOs.FootballFantasy.CoachDto>();
            <div class="pt-4 border-t border-slate-100 dark:border-slate-700/60">
                <div class="flex items-center justify-between mb-2">
                    <label asp-for="CoachId" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                        <i class="fa-solid fa-user-tie text-brand-600 mr-1.5"></i> Head Coach (Optional)
                    </label>
                    <span class="text-[11px] text-brand-600 dark:text-brand-400 font-medium">Tactical Leader</span>
                </div>
                <p class="text-xs text-slate-500 mb-3">League rules permit selecting an official Head Coach for your fantasy club.</p>
                <select asp-for="CoachId" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                    <option value="">-- No Coach Selected --</option>
                    @foreach (var coach in coaches)
                    {
                        <option value="@coach.Id">@coach.FullName (@coach.CountryName)</option>
                    }
                </select>
            </div>
        }

        <div class="flex items-center justify-end space-x-3 pt-6 border-t border-slate-100 dark:border-slate-700/60">
            <a asp-action="Details" asp-route-id="@Model.FantasyLeagueId" class="px-5 py-2.5 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-sm font-semibold transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors flex items-center">
                <i class="fa-solid fa-check mr-2"></i> Join League
            </button>
        </div>
    </form>
</div>

<!-- Render the reusable interactive canvas badge modal -->
@await Html.PartialAsync("_LogoCanvasModal")
