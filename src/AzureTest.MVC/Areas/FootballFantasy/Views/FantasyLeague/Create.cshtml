@model AzureTest.Application.FootballFantasy.Commands.CreateFantasyLeagueCommand
@{
    ViewData["Title"] = "Create Fantasy League";
    bool isAdmin = ViewBag.IsAdmin is bool b && b;
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2">
                <a asp-action="Index" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <h1 class="text-2xl font-black text-slate-900 dark:text-slate-100">Create Fantasy League</h1>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 ml-9">The unique League Tag (10-12 numbers and uppercase letters) will be automatically generated by the system.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/80 dark:border-slate-700/80 shadow-sm p-6 sm:p-8 space-y-6">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 dark:text-red-400 p-3 bg-red-50 dark:bg-red-950/30 rounded-lg"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">League Name</label>
                <input asp-for="Name" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" placeholder="e.g. Premier Elite Cup" required />
                <span asp-validation-for="Name" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div id="maxMembersContainer">
                <label asp-for="MaxMembers" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Max Teams (Between 4 and 48)</label>
                <input asp-for="MaxMembers" id="maxMembersInput" type="number" min="4" max="48" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" value="20" required />
                <span asp-validation-for="MaxMembers" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div id="globalUnlimitedNotice" class="hidden p-3.5 bg-brand-50 dark:bg-brand-950/30 rounded-xl border border-brand-200 dark:border-brand-800/40 flex items-center gap-3">
                <i class="fa-solid fa-infinity text-brand-600 text-xl"></i>
                <div>
                    <div class="text-xs font-bold text-brand-900 dark:text-brand-200 uppercase tracking-wider">Unlimited Players / Teams</div>
                    <div class="text-xs text-brand-700 dark:text-brand-300">Global leagues have no participant cap. Anyone can join freely.</div>
                </div>
            </div>
        </div>

        <div>
            <label asp-for="Description" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Description (Optional)</label>
            <textarea asp-for="Description" rows="3" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" placeholder="Describe the league, awards, guidelines..."></textarea>
        </div>

        <!-- Fantasy League Trophy & Logo Selection (Canvas, Upload, URL) -->
        <div class="pt-4 border-t border-slate-100 dark:border-slate-700/60">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">League Insignia & Tournament Logo</label>
            
            <div class="flex items-center gap-4 mb-4">
                <div class="w-20 h-20 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 flex items-center justify-center overflow-hidden flex-shrink-0 shadow-inner">
                    <img id="leagueLogoPreview" src="" alt="League Logo" class="w-full h-full object-contain hidden" />
                    <i id="defaultLeagueCrestIcon" class="fa-solid fa-trophy text-3xl text-amber-500"></i>
                </div>
                <div class="space-y-1">
                    <div class="text-sm font-bold text-slate-800 dark:text-slate-200">Custom Tournament Logo</div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Design an official league emblem using our tournament canvas builder, upload an image from your PC, or paste a link.</p>
                </div>
            </div>

            <!-- Hidden Logo Url input populated by Canvas or URL -->
            <input type="hidden" asp-for="LogoUrl" id="leagueLogoUrlInput" />

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Option 1: Canvas Creator (League Mode) -->
                <button type="button" onclick="openLogoCanvasModal('league', 'leagueLogoUrlInput', 'leagueLogoPreview', 'defaultLeagueCrestIcon')" class="flex flex-col items-center justify-center p-4 rounded-xl border-2 border-amber-500/40 bg-amber-50/30 dark:bg-amber-950/20 hover:border-amber-500 transition-all text-center group">
                    <i class="fa-solid fa-trophy text-xl text-amber-500 mb-1 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">League Designer</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">Trophy & Wreath Canvas</span>
                </button>

                <!-- Option 2: Upload File -->
                <label class="flex flex-col items-center justify-center p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-slate-50 dark:hover:bg-slate-600/50 cursor-pointer transition-all text-center group">
                    <i class="fa-solid fa-cloud-arrow-up text-xl text-slate-500 dark:text-slate-400 mb-1 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Upload File</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">PNG, JPG from PC</span>
                    <input type="file" accept="image/*" class="hidden" onchange="handleLocalImageUpload(this, 'leagueLogoUrlInput', 'leagueLogoPreview', 'defaultLeagueCrestIcon')" />
                </label>

                <!-- Option 3: Image URL -->
                <button type="button" onclick="document.getElementById('leagueUrlInputContainer').classList.toggle('hidden')" class="flex flex-col items-center justify-center p-4 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-slate-50 dark:hover:bg-slate-600/50 transition-all text-center group">
                    <i class="fa-solid fa-link text-xl text-slate-500 dark:text-slate-400 mb-1 group-hover:scale-110 transition-transform"></i>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Image URL</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">Direct web link</span>
                </button>
            </div>

            <div id="leagueUrlInputContainer" class="hidden mt-3">
                <input type="url" oninput="document.getElementById('leagueLogoUrlInput').value = this.value; const prev = document.getElementById('leagueLogoPreview'); prev.src = this.value; prev.classList.remove('hidden'); document.getElementById('defaultLeagueCrestIcon').classList.add('hidden');" placeholder="https://example.com/league-logo.png" class="w-full px-3 py-2 border border-slate-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200" />
            </div>
        </div>

        <!-- Visibility Selection -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-6 pt-4 border-t border-slate-100 dark:border-slate-700/60">
            <div>
                <label asp-for="Visibility" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Visibility</label>
                <select asp-for="Visibility" id="visibilitySelect" onchange="handleVisibilityChange(this.value)" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Public">Public (Request & Approve)</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Private">Private (Hidden & Invite Only)</option>
                    @if (isAdmin)
                    {
                        <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueVisibility.Global">Global System League (Direct Join)</option>
                    }
                </select>
            </div>

            <div>
                <label asp-for="Mode" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">League Mode</label>
                <select asp-for="Mode" id="leagueModeSelect" onchange="handleModeChange(this.value)" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueMode.FreeForAll">Free-for-All (Shared Player Pool)</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueMode.Auction">Live Auction (Exclusive Player Ownership)</option>
                </select>
            </div>

            <div>
                <label asp-for="Format" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Competition Format</label>
                <select asp-for="Format" id="leagueFormatSelect" onchange="handleFormatChange(this.value)" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.TotalPoints">Classic (Total Points Table)</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.HeadToHead">Head-to-Head (1v1 Matchups)</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.Knockout">Knockout Cup (Single Elimination)</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyLeagueFormat.GroupedKnockout">Grouped Knockout (Groups + Playoff Bracket)</option>
                </select>
            </div>

            <div>
                <label asp-for="PeriodType" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Period Type</label>
                <select asp-for="PeriodType" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyPeriodType.Weekly">Weekly Gameweek</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyPeriodType.Session">Session</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyPeriodType.Championship">Full Championship</option>
                </select>
            </div>

            <div>
                <label asp-for="KickoutType" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Unfinalized Kickout</label>
                <select asp-for="KickoutType" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyKickoutType.FullRemoval">Full Removal (Lose all access)</option>
                    <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.FantasyKickoutType.SpectatorOnly">Spectator Only (Read-only tables & scores)</option>
                </select>
            </div>
        </div>

        <!-- Grouped Knockout Group Count Container -->
        <div id="groupCountContainer" class="hidden p-4 bg-indigo-50 dark:bg-indigo-950/20 rounded-2xl border border-indigo-200 dark:border-indigo-800/40">
            <label asp-for="GroupCount" class="block text-xs font-semibold text-indigo-900 dark:text-indigo-200 uppercase tracking-wider mb-1">Number of Groups (e.g. 2, 4, 8)</label>
            <input asp-for="GroupCount" type="number" min="2" max="16" value="4" class="w-full px-3.5 py-2 rounded-lg border border-indigo-300 dark:border-indigo-700 bg-white dark:bg-slate-800 text-sm" />
            <p class="text-[11px] text-indigo-700 dark:text-indigo-300 mt-1">Teams will be randomly seeded and divided across these groups. Top teams advance to Knockout.</p>
        </div>

        <!-- Auction Mode Configuration Container -->
        <div id="auctionConfigContainer" class="hidden p-4 bg-amber-50 dark:bg-amber-950/20 rounded-2xl border border-amber-200 dark:border-amber-800/40">
            <div class="flex items-center gap-2 mb-2">
                <i class="fa-solid fa-gavel text-amber-600"></i>
                <h4 class="text-xs font-bold text-amber-900 dark:text-amber-200 uppercase tracking-wider">Live Auction Schedule (Exclusive Ownership)</h4>
            </div>
            <p class="text-xs text-amber-700 dark:text-amber-300 mb-3">Each player & coach will be owned by exactly ONE team in this league. Managers take turns nominating players with 10-second real-time countdown bidding.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="AuctionStartsAt" class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 uppercase mb-1">Auction Starts</label>
                    <input asp-for="AuctionStartsAt" type="datetime-local" class="w-full px-2.5 py-1.5 rounded-lg border border-amber-300 dark:border-amber-700 bg-white dark:bg-slate-800 text-xs" />
                </div>
                <div>
                    <label asp-for="AuctionEndsAt" class="block text-[11px] font-semibold text-slate-700 dark:text-slate-300 uppercase mb-1">Auction Deadline</label>
                    <input asp-for="AuctionEndsAt" type="datetime-local" class="w-full px-2.5 py-1.5 rounded-lg border border-amber-300 dark:border-amber-700 bg-white dark:bg-slate-800 text-xs" />
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
            <div>
                <label asp-for="Budget" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Budget (£m)</label>
                <input asp-for="Budget" type="number" step="0.5" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" value="100.0" />
            </div>

            <div>
                <label asp-for="SquadSize" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Max Squad Size</label>
                <input asp-for="SquadSize" type="number" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" value="15" />
            </div>

            <div>
                <label asp-for="MinSquadSize" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Min Squad Size</label>
                <input asp-for="MinSquadSize" type="number" min="11" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" value="11" />
                <span class="text-[10px] text-slate-400">Min required players (11+)</span>
            </div>

            <div id="privateCodeContainer" class="hidden">
                <label asp-for="JoinCode" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Join Code</label>
                <input asp-for="JoinCode" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500 font-mono" placeholder="Auto-generated if empty" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-700/60 flex items-center justify-between">
                <div>
                    <label asp-for="AllowCoach" class="text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-user-tie text-brand-600"></i>
                        Allow Head Coach Selection
                    </label>
                    <p class="text-xs text-slate-500 mt-0.5">Permits fantasy managers to select an official Head Coach.</p>
                </div>
                <div class="flex items-center">
                    <input asp-for="AllowCoach" type="checkbox" class="w-5 h-5 text-brand-600 rounded border-slate-300 focus:ring-brand-500 cursor-pointer" checked />
                </div>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-700/60 flex items-center justify-between">
                <div>
                    <label asp-for="AllowAutoSub" class="text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-repeat text-emerald-600"></i>
                        Auto Substitutions
                    </label>
                    <p class="text-xs text-slate-500 mt-0.5">Bench players auto-substitute for starters who don't play.</p>
                </div>
                <div class="flex items-center">
                    <input asp-for="AllowAutoSub" type="checkbox" class="w-5 h-5 text-brand-600 rounded border-slate-300 focus:ring-brand-500 cursor-pointer" />
                </div>
            </div>
        </div>

        <div class="p-4 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-700/60 flex items-center justify-between">
            <div>
                <label asp-for="EnableMvpBonus" class="text-sm font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-medal text-amber-500"></i>
                    MVP / Match Bonus Points System
                </label>
                <p class="text-xs text-slate-500 mt-0.5">Top performing player of each match receives +3 MVP bonus points.</p>
            </div>
            <div class="flex items-center">
                <input asp-for="EnableMvpBonus" type="checkbox" class="w-5 h-5 text-brand-600 rounded border-slate-300 focus:ring-brand-500 cursor-pointer" checked />
            </div>
        </div>

        @if (isAdmin)
        {
            <div class="p-4 bg-amber-50 dark:bg-amber-950/30 rounded-xl border border-amber-200 dark:border-amber-800/40">
                <label asp-for="CustomTag" class="block text-xs font-semibold text-amber-800 dark:text-amber-300 uppercase tracking-wider mb-1">Admin Option: Custom Tag (10-12 alphanumeric uppercase characters)</label>
                <input asp-for="CustomTag" maxlength="12" class="w-full px-3 py-2 border border-amber-300 dark:border-amber-700 rounded-lg text-sm bg-white dark:bg-slate-700 font-mono uppercase" placeholder="Leave blank for auto-generation" />
            </div>
        }

        <!-- Player Diversity / Competition Scope -->
        <div class="pt-6 border-t border-slate-100 dark:border-slate-700/60">
            <div class="flex items-center gap-2 mb-3">
                <i class="fa-solid fa-earth-americas text-brand-600"></i>
                <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Player Diversity / Competition Scope</h3>
            </div>
            <p class="text-xs text-slate-500 mb-4">Choose which players can be selected in this fantasy league (e.g. worldwide, UEFA Champions / Continental tournaments, or specific national leagues/countries).</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label asp-for="ScopeType" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Scope Type</label>
                    <select asp-for="ScopeType" id="scopeTypeSelect" onchange="updateDiversityOptions(this.value)" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500">
                        <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.PoolScopeType.All">Worldwide (All Eligible Players & Clubs)</option>
                        <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.PoolScopeType.Continent">Continental / Champions Competitions (Europe, South America...)</option>
                        <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.PoolScopeType.Country">Specific Country (e.g. England, Spain, Germany...)</option>
                        <option value="@AzureTest.Domain.Entities.FootballFantasy.Enums.PoolScopeType.League">Specific League (e.g. Premier League, La Liga...)</option>
                    </select>
                </div>

                <div id="scopeValueContainer">
                    <label asp-for="ScopeValue" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Scope Target / Competition</label>
                    <input asp-for="ScopeValue" id="scopeValueInput" list="scopeDatalist" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" placeholder="Search or select competition/league/country..." value="All" autocomplete="off" />
                    <datalist id="scopeDatalist">
                        <!-- Populated dynamically via JS based on ScopeType selection -->
                    </datalist>
                    
                    <div id="diversityQuickPills" class="flex flex-wrap gap-1.5 mt-2">
                        <!-- Quick filter suggestions -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Custom Scoring Rules Configuration -->
        <div class="pt-6 border-t border-slate-100 dark:border-slate-700/60">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-calculator text-amber-500"></i>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Scoring Rules Configuration</h3>
                </div>
                <span class="text-xs text-slate-400">Custom scoring directly in this league</span>
            </div>
            <p class="text-xs text-slate-500 mb-4">Customize the points awarded or deducted for match events in this fantasy league.</p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-700/60">
                <div>
                    <label asp-for="ScoringAppearance" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Appearance</label>
                    <input asp-for="ScoringAppearance" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold" />
                </div>
                <div>
                    <label asp-for="ScoringPlayed60Plus" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">60+ Mins Played</label>
                    <input asp-for="ScoringPlayed60Plus" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold" />
                </div>
                <div>
                    <label asp-for="ScoringGoalForward" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Goal (Forward)</label>
                    <input asp-for="ScoringGoalForward" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-emerald-600" />
                </div>
                <div>
                    <label asp-for="ScoringGoalMidfielder" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Goal (Midfielder)</label>
                    <input asp-for="ScoringGoalMidfielder" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-emerald-600" />
                </div>
                <div>
                    <label asp-for="ScoringGoalDefender" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Goal (Defender/GK)</label>
                    <input asp-for="ScoringGoalDefender" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-emerald-600" />
                </div>
                <div>
                    <label asp-for="ScoringAssist" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Assist</label>
                    <input asp-for="ScoringAssist" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-blue-600" />
                </div>
                <div>
                    <label asp-for="ScoringCleanSheet" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Clean Sheet (DEF/GK)</label>
                    <input asp-for="ScoringCleanSheet" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-indigo-600" />
                </div>
                <div>
                    <label asp-for="ScoringPenaltySaved" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Penalty Saved</label>
                    <input asp-for="ScoringPenaltySaved" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-purple-600" />
                </div>
                <div>
                    <label asp-for="ScoringPenaltyMissed" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Penalty Missed</label>
                    <input asp-for="ScoringPenaltyMissed" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-red-500" />
                </div>
                <div>
                    <label asp-for="ScoringYellowCard" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Yellow Card</label>
                    <input asp-for="ScoringYellowCard" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-amber-500" />
                </div>
                <div>
                    <label asp-for="ScoringRedCard" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Red Card</label>
                    <input asp-for="ScoringRedCard" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-red-600" />
                </div>
                <div>
                    <label asp-for="ScoringOwnGoal" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Own Goal</label>
                    <input asp-for="ScoringOwnGoal" type="number" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-center font-bold text-rose-600" />
                </div>
            </div>
        </div>

        <!-- Transfer Market Windows Configuration -->
        <div class="pt-6 border-t border-slate-100 dark:border-slate-700/60">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-arrows-rotate text-emerald-600"></i>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Transfer Market Windows</h3>
                </div>
                <span class="text-xs text-slate-400">Buying & selling player schedule</span>
            </div>
            <p class="text-xs text-slate-500 mb-4">Real-world leagues have 2 transfer windows (Summer & Winter). Cup/Tournament leagues like World Cup can use a single window or no windows (fixed initial squad).</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-700/60">
                <!-- Window 1 (e.g. Summer Window / Pre-Tournament) -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200"><i class="fa-solid fa-sun text-amber-500 mr-1.5"></i>Window 1 (Primary / Summer)</span>
                        <span class="text-[10px] text-slate-400">Pre-season buying</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label asp-for="Window1Open" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Opens</label>
                            <input asp-for="Window1Open" type="datetime-local" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-xs" />
                        </div>
                        <div>
                            <label asp-for="Window1Close" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Closes</label>
                            <input asp-for="Window1Close" type="datetime-local" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-xs" />
                        </div>
                    </div>
                </div>

                <!-- Window 2 (e.g. Winter Window / Mid-Season) -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200"><i class="fa-solid fa-snowflake text-sky-500 mr-1.5"></i>Window 2 (Secondary / Winter)</span>
                        <span class="text-[10px] text-slate-400">Optional for tournaments</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label asp-for="Window2Open" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Opens</label>
                            <input asp-for="Window2Open" type="datetime-local" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-xs" />
                        </div>
                        <div>
                            <label asp-for="Window2Close" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Closes</label>
                            <input asp-for="Window2Close" type="datetime-local" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-xs" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transfer Penalties & Financial Taxes -->
            <div class="mt-4 p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-700/60 space-y-4">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-scale-balanced text-brand-600"></i>
                    <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Transfer Quotas, Point Deductions & Profit Tax</h4>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="FreeTransfersPerGameweek" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Free Transfers / GW</label>
                        <input asp-for="FreeTransfersPerGameweek" type="number" min="0" max="10" value="1" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm font-bold text-center" />
                        <span class="text-[10px] text-slate-400">Default: 1 free transfer per GW</span>
                    </div>

                    <div>
                        <label asp-for="ExtraTransferPointPenalty" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Extra Transfer Penalty (pts)</label>
                        <input asp-for="ExtraTransferPointPenalty" type="number" min="0" max="50" value="4" placeholder="Empty = Disallowed" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm font-bold text-center text-rose-600 dark:text-rose-400" />
                        <span class="text-[10px] text-slate-400">Empty: Not allowed | 0: Allowed (free) | &gt;0: Penalty points (e.g. 4)</span>
                    </div>

                    <div>
                        <label asp-for="ProfitTaxPercent" class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1">Percent Profit Tax (%)</label>
                        <input asp-for="ProfitTaxPercent" type="number" step="0.5" min="0" max="100" value="50.0" class="w-full px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm font-bold text-center text-amber-600 dark:text-amber-400" />
                        <span class="text-[10px] text-slate-400">Tax on appreciation when selling players (e.g. 50%)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-slate-100 dark:border-slate-700/60">
            <div>
                <label asp-for="StartsAt" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">League Start Date</label>
                <input asp-for="StartsAt" type="date" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" />
            </div>

            <div>
                <label asp-for="EndsAt" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">League End Date</label>
                <input asp-for="EndsAt" type="date" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:ring-1 focus:ring-brand-500" />
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-6 border-t border-slate-100 dark:border-slate-700/60">
            <a asp-action="Index" class="px-5 py-2.5 border border-slate-300 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-sm font-semibold transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-sm font-semibold shadow-sm transition-colors flex items-center">
                <i class="fa-solid fa-trophy mr-2"></i> Create League
            </button>
        </div>
    </form>
</div>

<!-- Render the reusable interactive canvas badge/trophy modal -->
@await Html.PartialAsync("_LogoCanvasModal")

<script>
    function handleModeChange(val) {
        const auctionContainer = document.getElementById('auctionConfigContainer');
        if (val === 'Auction') {
            auctionContainer?.classList.remove('hidden');
        } else {
            auctionContainer?.classList.add('hidden');
        }
    }

    function handleFormatChange(val) {
        const groupContainer = document.getElementById('groupCountContainer');
        if (val === 'GroupedKnockout') {
            groupContainer?.classList.remove('hidden');
        } else {
            groupContainer?.classList.add('hidden');
        }
    }

    function handleVisibilityChange(val) {
        const privateContainer = document.getElementById('privateCodeContainer');
        const maxMembersContainer = document.getElementById('maxMembersContainer');
        const unlimitedNotice = document.getElementById('globalUnlimitedNotice');
        const maxMembersInput = document.getElementById('maxMembersInput');

        if (val === 'Private') {
            privateContainer.classList.remove('hidden');
        } else {
            privateContainer.classList.add('hidden');
        }

        if (val === 'Global') {
            maxMembersContainer.classList.add('hidden');
            unlimitedNotice.classList.remove('hidden');
            maxMembersInput.required = false;
            maxMembersInput.value = '';
        } else {
            maxMembersContainer.classList.remove('hidden');
            unlimitedNotice.classList.add('hidden');
            maxMembersInput.required = true;
            if (!maxMembersInput.value || parseInt(maxMembersInput.value) <= 0) {
                maxMembersInput.value = '20';
            }
        }
    }

    const dbLeagues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.AvailableLeagues as IEnumerable<AzureTest.Contracts.DTOs.FootballFantasy.LeagueDto>)?.Select(l => l.Name).Distinct() ?? Enumerable.Empty<string>()));
    const dbCountries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.AvailableCountries as IEnumerable<AzureTest.Contracts.DTOs.FootballFantasy.CountryDto>)?.Select(c => c.Name).Distinct() ?? Enumerable.Empty<string>()));
    const continents = ['Europe', 'South America', 'Asia', 'Africa', 'North America', 'Oceania'];

    const diversityPills = {
        'Continent': ['Europe', 'South America', 'Asia', 'Africa', 'North America'],
        'Country': dbCountries.slice(0, 10),
        'League': dbLeagues.slice(0, 10)
    };

    function updateDiversityOptions(val) {
        const datalist = document.getElementById('scopeDatalist');
        const pillsContainer = document.getElementById('diversityQuickPills');
        const input = document.getElementById('scopeValueInput');
        
        datalist.innerHTML = '';
        pillsContainer.innerHTML = '';

        if (val === 'All') {
            input.value = 'All';
            input.placeholder = 'Worldwide (All Players & Competitions)';
            input.readOnly = true;
            return;
        }

        input.readOnly = false;
        let availableOptions = [];

        if (val === 'Continent') {
            availableOptions = continents;
            input.placeholder = 'Search continent (e.g. Europe, South America)...';
        } else if (val === 'Country') {
            availableOptions = dbCountries.length > 0 ? dbCountries : ['England', 'Spain', 'Germany', 'Italy', 'France'];
            input.placeholder = 'Search country (e.g. England, Spain, Brazil)...';
        } else if (val === 'League') {
            availableOptions = dbLeagues.length > 0 ? dbLeagues : ['Premier League', 'La Liga', 'Serie A', 'Bundesliga'];
            input.placeholder = 'Search tournament/league (e.g. Champions League, World Cup)...';
        }

        // Populate HTML5 datalist for autocomplete search
        availableOptions.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt;
            datalist.appendChild(option);
        });

        if (input.value === 'All' && availableOptions.length > 0) {
            input.value = availableOptions[0];
        }

        // Render quick suggestion pills
        const pills = diversityPills[val] || availableOptions.slice(0, 8);
        pills.forEach(opt => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'px-2.5 py-1 text-xs rounded-full bg-slate-100 hover:bg-brand-50 hover:text-brand-600 text-slate-600 dark:bg-slate-700 dark:text-slate-300 transition-colors border border-slate-200 dark:border-slate-600';
            btn.textContent = opt;
            btn.onclick = () => { input.value = opt; };
            pillsContainer.appendChild(btn);
        });
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
        const select = document.getElementById('scopeTypeSelect');
        if (select) updateDiversityOptions(select.value);

        const visSelect = document.getElementById('visibilitySelect');
        if (visSelect) handleVisibilityChange(visSelect.value);
    });
</script>
