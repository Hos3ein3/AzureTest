@model AzureTest.Contracts.DTOs.Common.PagedResult<AzureTest.Contracts.DTOs.FootballFantasy.FixtureDto>
@{
    ViewData["Title"] = "Fixtures & Matches";
    var filter = ViewBag.Filter as AzureTest.Contracts.DTOs.FootballFantasy.FixtureFilter;
}

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
            <i class="fa-solid fa-calendar-days text-emerald-600"></i> Match Fixtures
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage scheduled matches, enter live scores, and finalize match statistics.</p>
    </div>
    <div class="flex items-center space-x-3">
        <a asp-action="Create" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
            <i class="fa-solid fa-plus mr-2"></i> Schedule Match
        </a>
    </div>
</div>

<div class="mb-6 bg-white dark:bg-slate-800 p-5 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700">
    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Search</label>
            <input type="text" name="SearchTerm" value="@filter?.SearchTerm" placeholder="Team, round, venue..." class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider mb-1">Status</label>
            <select name="Status" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3">
                <option value="">All Statuses</option>
                <option value="1" selected="@(filter?.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Scheduled)">Scheduled</option>
                <option value="2" selected="@(filter?.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Live)">Live</option>
                <option value="4" selected="@(filter?.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Finished)">Finished</option>
                <option value="5" selected="@(filter?.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Postponed)">Postponed</option>
            </select>
        </div>
        <div class="flex items-end space-x-2">
            <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium rounded-lg">Filter</button>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 text-sm font-medium rounded-lg">Reset</a>
        </div>
    </form>
</div>

<div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
    <table class="min-w-full divide-y divide-slate-100 dark:divide-slate-700 text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-400 font-semibold text-xs uppercase tracking-wider">
            <tr>
                <th class="py-3.5 px-4 text-left">Kickoff</th>
                <th class="py-3.5 px-4 text-center">Matchup & Score</th>
                <th class="py-3.5 px-4 text-left">Round / Venue</th>
                <th class="py-3.5 px-4 text-left">Status</th>
                <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="py-8 text-center text-slate-400">No fixtures found.</td>
                </tr>
            }
            @foreach (var f in Model.Items)
            {
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/40">
                    <td class="py-3 px-4 font-medium text-slate-700 dark:text-slate-300 whitespace-nowrap">
                        @f.KickoffAt.ToString("MMM dd, yyyy HH:mm")
                    </td>
                    <td class="py-3 px-4 text-center">
                        <div class="inline-flex items-center space-x-3 font-semibold text-slate-900 dark:text-slate-100">
                            <span>@f.HomeTeamName</span>
                            <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-700 text-sm font-bold">
                                @(f.HomeScore.HasValue ? f.HomeScore.Value.ToString() : "-") : @(f.AwayScore.HasValue ? f.AwayScore.Value.ToString() : "-")
                            </span>
                            <span>@f.AwayTeamName</span>
                        </div>
                    </td>
                    <td class="py-3 px-4 text-slate-500 dark:text-slate-400 text-xs">
                        <div>@(f.Round ?? "Regular Round")</div>
                        <div class="text-slate-400">@(f.Venue ?? "TBD")</div>
                    </td>
                    <td class="py-3 px-4">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @(f.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Finished ? "bg-slate-100 text-slate-700" : f.Status == AzureTest.Domain.Entities.FootballFantasy.Enums.FixtureStatus.Live ? "bg-rose-100 text-rose-700 animate-pulse" : "bg-emerald-100 text-emerald-800")">
                            @f.Status
                        </span>
                    </td>
                    <td class="py-3 px-4 text-right space-x-2">
                        <a asp-action="Details" asp-route-id="@f.Id" class="text-slate-600 hover:text-brand-600 text-xs font-semibold">Details</a>
                        <a asp-action="Edit" asp-route-id="@f.Id" class="text-brand-600 hover:text-brand-700 text-xs font-semibold">Edit</a>
                        <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="inline" onsubmit="return confirm('Delete this fixture?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-rose-600 hover:text-rose-700 text-xs font-semibold">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
