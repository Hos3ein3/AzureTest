@model AzureTest.Application.FootballFantasy.Commands.CreateTeamCommand
@{
    ViewData["Title"] = "Add Team";
    var countries = ViewBag.Countries as List<AzureTest.Contracts.DTOs.FootballFantasy.CountryDto>;
}

<div class="max-w-2xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Teams</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">New</span>
    </div>
    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Add Football Team</h1>
</div>

<div class="max-w-2xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Full Team Name</label>
                <input asp-for="Name" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
                <span asp-validation-for="Name" class="text-xs text-rose-500"></span>
            </div>
            <div>
                <label asp-for="ShortName" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Short Name / Tri-code</label>
                <input asp-for="ShortName" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required />
                <span asp-validation-for="ShortName" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="TeamType" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Type</label>
                <select asp-for="TeamType" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3">
                    <option value="1">Club</option>
                    <option value="2">National Team</option>
                </select>
            </div>
            <div>
                <label asp-for="CountryId" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Country</label>
                <select asp-for="CountryId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" required>
                    <option value="">Select Country</option>
                    @if (countries != null)
                    {
                        foreach (var c in countries)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="CountryId" class="text-xs text-rose-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="VenueId" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Assigned Stadium / Venue</label>
                <select asp-for="VenueId" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3">
                    <option value="">-- None / Select Venue --</option>
                    @if (ViewBag.Venues is IReadOnlyList<AzureTest.Contracts.DTOs.FootballFantasy.VenueDto> venuesList)
                    {
                        foreach (var v in venuesList)
                        {
                            <option value="@v.Id">@v.Name (@v.CountryName)</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label asp-for="StadiumName" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Stadium Custom Name</label>
                <input asp-for="StadiumName" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" placeholder="Optional custom name" />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="StadiumCapacity" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Capacity</label>
                <input asp-for="StadiumCapacity" type="number" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" />
            </div>
            <div>
                <label asp-for="Code" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Club Code</label>
                <input asp-for="Code" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" placeholder="e.g. RMA, BAR" />
            </div>
        </div>

        <div>
            <label asp-for="LogoUrl" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase mb-1">Logo URL</label>
            <input asp-for="LogoUrl" class="w-full text-sm rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-900 py-2 px-3" placeholder="https://..." />
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-700">
            <a asp-action="Index" class="px-4 py-2 text-sm text-slate-600 hover:text-slate-800">Cancel</a>
            <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg shadow-sm">Save Team</button>
        </div>
    </form>
</div>
