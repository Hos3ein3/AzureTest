@model AzureTest.Contracts.DTOs.FootballFantasy.TeamDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="max-w-3xl mx-auto mb-6">
    <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
        <a asp-action="Index" class="hover:text-slate-700">Teams</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200">@Model.Name</span>
    </div>
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 flex items-center space-x-3">
            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" class="w-8 h-8 object-contain" alt="@Model.Name" />
            }
            <span>@Model.Name</span>
            <span class="text-sm font-mono bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded text-brand-600">@Model.ShortName</span>
        </h1>
        <div class="space-x-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow-sm">Edit</a>
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg">Back to List</a>
        </div>
    </div>
</div>

<div class="max-w-3xl mx-auto bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-100 dark:border-slate-700">
    <dl class="grid grid-cols-2 gap-4">
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Team Type</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@Model.TeamType</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Country</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@Model.CountryName</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Stadium / Venue</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">
                @if (Model.VenueId.HasValue && !string.IsNullOrWhiteSpace(Model.VenueName))
                {
                    <a asp-controller="Venue" asp-action="Details" asp-route-id="@Model.VenueId.Value" class="text-brand-600 hover:text-brand-700 underline font-semibold">
                        <i class="fa-solid fa-landmark mr-1 text-xs"></i> @Model.VenueName
                    </a>
                }
                else
                {
                    @(Model.StadiumName ?? "N/A")
                }
            </dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-slate-400 uppercase">Stadium Capacity</dt>
            <dd class="text-base font-medium text-slate-800 dark:text-slate-100 mt-1">@(Model.StadiumCapacity.HasValue ? Model.StadiumCapacity.Value.ToString("N0") : "N/A")</dd>
        </div>
    </dl>
</div>
