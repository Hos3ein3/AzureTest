                                foreach (var tr in Model.TrailingStops)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50">
                                        <td class="py-2 px-3 font-bold text-slate-800 dark:text-white font-sans">@tr.Symbol</td>
                                        <td class="py-2 px-3 font-sans">
                                            <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(tr.Side == CryptoPositionSide.Long ? "bg-emerald-100 text-emerald-600" : "bg-rose-100 text-rose-600")">
                                                @tr.Side
                                            </span>
                                        </td>
                                        <td class="py-2 px-3 text-right text-slate-700 dark:text-slate-300">$@tr.EntryPrice.ToString("N2")</td>
                                        <td class="py-2 px-3 text-right font-bold text-purple-600">$@tr.HighWaterMarkPrice.ToString("N2")</td>
                                        <td class="py-2 px-3 text-right font-bold text-amber-500">$@tr.ActiveStopPrice.ToString("N2")</td>
                                        <td class="py-2 px-3 text-right text-slate-400">-$@tr.TrailDistanceUsd.ToString("N2")</td>
                                        <td class="py-2 px-3 text-center font-sans">
                                            @if (tr.IsBreakevenLocked)
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                                                    <i class="fa-solid fa-lock text-[9px] mr-1"></i> LOCKED
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-slate-100 text-slate-600">
                                                    Tracking
                                                </span>
                                            }
                                        </td>
                                        <td class="py-2 px-3 text-right font-bold @(tr.LockedProfitUsd > 0 ? "text-emerald-600" : "text-slate-400")">
                                            @(tr.LockedProfitUsd > 0 ? $"+${tr.LockedProfitUsd:N2} (+{tr.LockedProfitPercent:F2}%)" : "--")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="py-3 text-center text-slate-400 font-sans text-2xs">
                                        No active trailing stops. Select the Trailing tab on the ticket to lock in profits.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function switchTicketTab(tabId, btn) {
        document.querySelectorAll('.ticket-panel').forEach(p => p.classList.add('hidden'));
        document.querySelectorAll('.ticket-tab-btn').forEach(b => {
            b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-800', 'dark:text-white', 'shadow-2xs');
            b.classList.add('text-slate-600', 'dark:text-slate-300');
        });

        document.getElementById(tabId).classList.remove('hidden');
        btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-800', 'dark:text-white', 'shadow-2xs');
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');
    }
</script>
}
