@model TradeTerminalDashboardDto
@{
    ViewData["Title"] = "Crypto Trading Terminal";
    var acc = Model.Account;
    var symbol = Model.SelectedSymbol ?? "BTCUSDT";
    var price = Model.CurrentPrice > 0 ? Model.CurrentPrice : 67500m;
}

<div class="space-y-6">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600">&times;</button>
        </div>
    }

    <!-- Terminal Header & Account Capital Ribbon -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-800 dark:text-white">Crypto Trading Console</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-2xs font-bold @(acc.TradingMode == CryptoTradingMode.LiveTrading ? "bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")">
                            <i class="fa-solid fa-circle text-[8px] animate-pulse mr-1"></i>
                            @(acc.TradingMode == CryptoTradingMode.LiveTrading ? "LIVE TRADING" : "PAPER TRADING")
                        </span>
                        @if (acc.IsKillSwitchActive)
                        {
                            <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-rose-600 text-white animate-pulse">
                                KILL SWITCH ACTIVE
                            </span>
                        }
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Multi-coin execution engine with safe retry idempotency protection</p>
                </div>
            </div>
        </div>

        <!-- Account Balance Strip -->
        <div class="flex flex-wrap items-center gap-3">
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Cash Balance</span>
                <span class="text-sm font-bold font-mono text-slate-800 dark:text-white">$@acc.CashBalance.ToString("N2")</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Equity</span>
                <span class="text-sm font-bold font-mono text-slate-800 dark:text-white">$@acc.Equity.ToString("N2")</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Free Margin</span>
                <span class="text-sm font-bold font-mono text-emerald-600">$@acc.FreeMargin.ToString("N2")</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Margin Used</span>
                <span class="text-sm font-bold font-mono text-purple-600">$@acc.MarginUsed.ToString("N2")</span>
            </div>
            <a asp-area="Crypto" asp-controller="CryptoRisk" asp-action="Index" class="px-3 py-3 bg-rose-500/10 text-rose-600 hover:bg-rose-500 hover:text-white rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5" title="Risk Management & Emergency Controls">
                <i class="fa-solid fa-shield-halved"></i> Risk
            </a>
        </div>
    </div>

    <!-- Main Trading Grid: Order Ticket (Left) & Order Book Depth / Public Trades (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Order Placement Ticket (5 cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
                <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-ticket text-brand-500"></i> New Order Ticket
                </h3>
                <div class="text-xs font-mono font-bold text-slate-800 dark:text-white">
                    @symbol: <span class="text-brand-600">$@price.ToString("N2")</span>
                </div>
            </div>

            <!-- Quick Symbol Buttons -->
            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var s in new[] { "BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT", "XRPUSDT" })
                {
                    <a asp-action="Index" asp-route-symbol="@s" class="px-2.5 py-1 rounded-lg text-2xs font-semibold transition-colors @(s == symbol ? "bg-brand-500 text-white" : "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200")">
                        @s.Replace("USDT", "")
                    </a>
                }
            </div>

            <!-- Order Submission Form -->
            <form asp-action="PlaceOrder" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="accountId" value="@acc.Id" />
                <input type="hidden" name="symbol" value="@symbol" />
                <input type="hidden" name="tradingMode" value="@acc.TradingMode" />

                <!-- Side Selector (Buy / Sell) -->
                <div class="grid grid-cols-2 gap-2">
                    <label class="cursor-pointer">
                        <input type="radio" name="side" value="@CryptoOrderSide.Buy" checked class="peer sr-only" />
                        <div class="py-2.5 rounded-xl border border-emerald-500/30 text-center text-xs font-bold peer-checked:bg-emerald-600 peer-checked:text-white text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition-all">
                            BUY / LONG
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="side" value="@CryptoOrderSide.Sell" class="peer sr-only" />
                        <div class="py-2.5 rounded-xl border border-rose-500/30 text-center text-xs font-bold peer-checked:bg-rose-600 peer-checked:text-white text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-all">
                            SELL / SHORT
                        </div>
                    </label>
                </div>

                <!-- Order Type (Market, Limit, StopLoss, TakeProfit, StopLimit) -->
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Order Type</label>
                    <select name="orderType" id="orderTypeSelect" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="@CryptoOrderType.Market">Market (Instant Fill)</option>
                        <option value="@CryptoOrderType.Limit">Limit (Book Maker)</option>
                        <option value="@CryptoOrderType.StopLoss">Stop Loss Order</option>
                        <option value="@CryptoOrderType.TakeProfit">Take Profit Order</option>
                        <option value="@CryptoOrderType.StopLimit">Stop Limit</option>
                    </select>
                </div>

                <!-- Quantity & Price -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Quantity (Coins)</label>
                        <input type="number" step="0.0001" name="quantity" value="0.05" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                    </div>
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Limit Price ($)</label>
                        <input type="number" step="0.01" name="requestedPrice" value="@price" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                    </div>
                </div>

                <!-- Leverage Selector (1x - 20x) -->
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="text-2xs font-bold text-slate-500 uppercase tracking-wider">Leverage</label>
                        <span id="leverageLabel" class="text-xs font-mono font-bold text-purple-600">1x (Spot / No Leverage)</span>
                    </div>
                    <input type="range" name="leverage" min="1" max="20" value="1" id="leverageRange" class="w-full accent-purple-600 cursor-pointer" oninput="document.getElementById('leverageLabel').innerText = this.value + 'x' + (this.value > 5 ? ' (HIGH RISK)' : '')" />
                    <span class="text-[10px] text-slate-400 block mt-0.5">Dutch AFM &amp; ESMA recommend retail leverage &le; 2x for crypto derivatives.</span>
                </div>

                <!-- Risk Management: Stop Loss & Take Profit -->
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-700/40 border border-slate-100 dark:border-slate-700 space-y-3">
                    <span class="text-2xs font-bold uppercase tracking-wider text-slate-500 block">Automated Risk Protection</span>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-rose-500 mb-1">Stop Loss ($)</label>
                            <input type="number" step="0.01" name="stopLoss" placeholder="e.g. @((price * 0.98m).ToString("0.00"))" class="w-full text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-white px-2.5 py-1.5" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-500 mb-1">Take Profit ($)</label>
                            <input type="number" step="0.01" name="takeProfit" placeholder="e.g. @((price * 1.04m).ToString("0.00"))" class="w-full text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-white px-2.5 py-1.5" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-purple-500 mb-1">Trailing Stop Distance ($)</label>
                        <input type="number" step="0.01" name="trailingStopDistance" placeholder="e.g. 500.00" class="w-full text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-white px-2.5 py-1.5" />
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-xs transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i> Submit Order (Idempotency Safe)
                </button>
            </form>
        </div>

        <!-- Right Side: Order Book Depth & Public Trades (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Order Book Depth Mini Ladder -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-brand-500"></i> @symbol Depth Ladder
                    </h3>
                    <div class="text-2xs font-mono text-slate-400">
                        Spread: $@(Model.Depth?.Spread.ToString("N2") ?? "0.00") (@(Model.Depth?.SpreadPercent.ToString("F3") ?? "0.000")%)
                    </div>
                </div>

                <div class="grid grid-cols-2 divide-x divide-slate-100 dark:divide-slate-700">
                    <!-- Bids (Left) -->
                    <div class="p-3">
                        <div class="text-[10px] font-bold uppercase text-emerald-600 mb-2 flex justify-between">
                            <span>Bid Price</span>
                            <span>Size</span>
                        </div>
                        <div class="space-y-1 font-mono text-xs">
                            @if (Model.Depth?.Bids != null)
                            {
                                foreach (var b in Model.Depth.Bids.Take(8))
                                {
                                    <div class="flex justify-between items-center text-slate-700 dark:text-slate-300 hover:bg-emerald-500/5 px-1 py-0.5 rounded">
                                        <span class="font-bold text-emerald-600">$@b.Price.ToString("N2")</span>
                                        <span>@b.Quantity.ToString("F4")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Asks (Right) -->
                    <div class="p-3">
                        <div class="text-[10px] font-bold uppercase text-rose-600 mb-2 flex justify-between">
                            <span>Ask Price</span>
                            <span>Size</span>
                        </div>
                        <div class="space-y-1 font-mono text-xs">
                            @if (Model.Depth?.Asks != null)
                            {
                                foreach (var a in Model.Depth.Asks.Take(8))
                                {
                                    <div class="flex justify-between items-center text-slate-700 dark:text-slate-300 hover:bg-rose-500/5 px-1 py-0.5 rounded">
                                        <span class="font-bold text-rose-600">$@a.Price.ToString("N2")</span>
                                        <span>@a.Quantity.ToString("F4")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Public Executions -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">
                        Recent Public Executions (@symbol)
                    </h3>
                    <span class="text-2xs text-slate-400">Binance Market Trades</span>
                </div>
                <div class="overflow-x-auto max-h-48">
                    <table class="w-full text-left text-xs font-mono">
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">
                            @if (Model.RecentTrades != null && Model.RecentTrades.Any())
                            {
                                foreach (var tr in Model.RecentTrades.Take(6))
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50">
                                        <td class="py-2 px-4 text-slate-500 text-2xs">@tr.Time.ToString("HH:mm:ss")</td>
                                        <td class="py-2 px-4 font-bold @(tr.IsBuyerMaker ? "text-rose-600" : "text-emerald-600")">
                                            $@tr.Price.ToString("N2")
                                        </td>
                                        <td class="py-2 px-4 text-right text-slate-700 dark:text-slate-300">
                                            @tr.Quantity.ToString("F4")
                                        </td>
                                        <td class="py-2 px-4 text-center font-sans text-2xs font-bold @(tr.IsBuyerMaker ? "text-rose-500" : "text-emerald-500")">
                                            @(tr.IsBuyerMaker ? "SELL" : "BUY")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Positions Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-briefcase text-emerald-500"></i> Open Positions (@(Model.OpenPositions?.Count ?? 0))
            </h3>
            <span class="text-2xs text-slate-400">Live P&L Tracking</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 text-[11px] font-bold uppercase">
                        <th class="py-3 px-4">Symbol</th>
                        <th class="py-3 px-4 text-center">Side</th>
                        <th class="py-3 px-4 text-center">Leverage</th>
                        <th class="py-3 px-4 text-right">Size</th>
                        <th class="py-3 px-4 text-right">Entry Price</th>
                        <th class="py-3 px-4 text-right">Mark Price</th>
                        <th class="py-3 px-4 text-right">Liq. Price</th>
                        <th class="py-3 px-4 text-right">Unrealized P&L</th>
                        <th class="py-3 px-4 text-center">Stops (SL / TP)</th>
                        <th class="py-3 px-4 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-mono">
                    @if (Model.OpenPositions != null && Model.OpenPositions.Any())
                    {
                        foreach (var pos in Model.OpenPositions)
                        {
                            var win = pos.UnrealizedPnl >= 0;
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-3 px-4 font-bold text-slate-800 dark:text-white font-sans">@pos.Symbol</td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(pos.Side == CryptoPositionSide.Long ? "bg-emerald-100 text-emerald-600" : "bg-rose-100 text-rose-600")">
                                        @pos.Side
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-purple-100 dark:bg-purple-950 text-purple-600">
                                        @(pos.Leverage)x
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right text-slate-700 dark:text-slate-300">@pos.Quantity.ToString("F4")</td>
                                <td class="py-3 px-4 text-right text-slate-700 dark:text-slate-300">$@pos.EntryPrice.ToString("N2")</td>
                                <td class="py-3 px-4 text-right font-bold text-slate-800 dark:text-white">$@pos.CurrentPrice.ToString("N2")</td>
                                <td class="py-3 px-4 text-right text-amber-500 font-bold">
                                    @(pos.LiquidationPrice > 0 ? $"${pos.LiquidationPrice:N2}" : "--")
                                </td>
                                <td class="py-3 px-4 text-right font-bold @(win ? "text-emerald-600" : "text-rose-600")">
                                    @(win ? "+" : "")$@pos.UnrealizedPnl.ToString("N2") (@(win ? "+" : "")@pos.PnlPercent.ToString("F2")%)
                                </td>
                                <td class="py-3 px-4 text-center font-sans text-2xs text-slate-500">
                                    SL: @(pos.StopLoss.HasValue ? $"${pos.StopLoss.Value:N0}" : "None") | TP: @(pos.TakeProfit.HasValue ? $"${pos.TakeProfit.Value:N0}" : "None")
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <form asp-action="ClosePosition" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="positionId" value="@pos.Id" />
                                        <input type="hidden" name="closePrice" value="@pos.CurrentPrice" />
                                        <input type="hidden" name="symbol" value="@symbol" />
                                        <button type="submit" class="px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-2xs font-semibold transition-colors">
                                            Close Market
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="py-6 text-center text-slate-400 font-sans">
                                No active positions open currently.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Working Pending Orders Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-clock text-amber-500"></i> Working Pending Orders (@(Model.RecentOrders?.Count ?? 0))
            </h3>
            <span class="text-2xs text-slate-400">Limit &amp; Stop Execution Queue</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 text-[11px] font-bold uppercase">
                        <th class="py-3 px-4">Placed On</th>
                        <th class="py-3 px-4">Symbol</th>
                        <th class="py-3 px-4 text-center">Type</th>
                        <th class="py-3 px-4 text-center">Side</th>
                        <th class="py-3 px-4 text-right">Size</th>
                        <th class="py-3 px-4 text-right">Order Price</th>
                        <th class="py-3 px-4 text-right">Stop Price</th>
                        <th class="py-3 px-4 text-center">Status</th>
                        <th class="py-3 px-4 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-mono">
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        foreach (var ord in Model.RecentOrders)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-2.5 px-4 text-slate-500 font-sans">@ord.CreatedOn.ToString("MM-dd HH:mm")</td>
                                <td class="py-2.5 px-4 font-bold text-slate-800 dark:text-white font-sans">@ord.Symbol</td>
                                <td class="py-2.5 px-4 text-center font-sans">@ord.OrderType</td>
                                <td class="py-2.5 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(ord.Side == CryptoOrderSide.Buy ? "bg-emerald-100 text-emerald-600" : "bg-rose-100 text-rose-600")">
                                        @ord.Side
                                    </span>
                                </td>
                                <td class="py-2.5 px-4 text-right text-slate-700 dark:text-slate-300">@ord.Quantity.ToString("F4")</td>
                                <td class="py-2.5 px-4 text-right font-bold text-slate-800 dark:text-white">$@ord.RequestedPrice.ToString("N2")</td>
                                <td class="py-2.5 px-4 text-right text-slate-500">
                                    @(ord.StopPrice.HasValue ? $"${ord.StopPrice.Value:N2}" : "--")
                                </td>
                                <td class="py-2.5 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-amber-100 text-amber-600">
                                        @ord.Status
                                    </span>
                                </td>
                                <td class="py-2.5 px-4 text-center font-sans">
                                    <form asp-action="CancelOrder" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@ord.Id" />
                                        <input type="hidden" name="symbol" value="@symbol" />
                                        <button type="submit" class="px-2.5 py-1 bg-slate-200 dark:bg-slate-700 hover:bg-rose-600 hover:text-white rounded-lg text-2xs font-semibold transition-colors">
                                            Cancel
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="py-6 text-center text-slate-400 font-sans">
                                No working pending orders in queue.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
