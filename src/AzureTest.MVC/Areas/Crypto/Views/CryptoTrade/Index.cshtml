                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-3 px-4 font-bold text-slate-800 dark:text-white font-sans">@pos.Symbol</td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(pos.Side == CryptoPositionSide.Long ? "bg-emerald-100 text-emerald-600" : "bg-rose-100 text-rose-600")">
                                        @pos.Side
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-purple-100 dark:bg-purple-950 text-purple-600">
                                        @(pos.Leverage)x
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right text-slate-700 dark:text-slate-300">@pos.Quantity.ToString("F4")</td>
                                <td class="py-3 px-4 text-right text-slate-700 dark:text-slate-300">$@pos.EntryPrice.ToString("N2")</td>
                                <td class="py-3 px-4 text-right font-bold text-slate-800 dark:text-white">$@pos.CurrentPrice.ToString("N2")</td>
                                <td class="py-3 px-4 text-right text-amber-500 font-bold">
                                    @(pos.LiquidationPrice > 0 ? $"${pos.LiquidationPrice:N2}" : "--")
                                </td>
