                    <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 text-[11px] font-bold uppercase">
                        <th class="py-3 px-4">Symbol</th>
                        <th class="py-3 px-4 text-center">Side</th>
                        <th class="py-3 px-4 text-center">Leverage</th>
