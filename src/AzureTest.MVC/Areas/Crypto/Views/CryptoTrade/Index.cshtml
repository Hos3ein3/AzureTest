@model TradeTerminalDashboardDto
@{
    ViewData["Title"] = "Crypto Trading Terminal";
    var acc = Model.Account;
    var symbol = Model.SelectedSymbol ?? "BTCUSDT";
    var price = Model.CurrentPrice > 0 ? Model.CurrentPrice : 67500m;
}

<div class="space-y-6">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600">&times;</button>
        </div>
    }

    <!-- Terminal Header & Account Capital Ribbon -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-800 dark:text-white">Crypto Trading Console</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-2xs font-bold @(acc.TradingMode == CryptoTradingMode.LiveTrading ? "bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")">
                            <i class="fa-solid fa-circle text-[8px] animate-pulse mr-1"></i>
                            @(acc.TradingMode == CryptoTradingMode.LiveTrading ? "LIVE TRADING" : "PAPER TRADING")
                        </span>
                        @if (acc.IsKillSwitchActive)
                        {
                            <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-rose-600 text-white animate-pulse">
                                KILL SWITCH ACTIVE
                            </span>
                        }
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Multi-coin execution engine with safe retry idempotency protection</p>
                </div>
            </div>
        </div>

        <!-- Account Balance Strip -->
        <div class="flex flex-wrap items-center gap-3">
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Cash Balance</span>
                <span class="text-sm font-bold font-mono text-slate-800 dark:text-white">$@acc.CashBalance.ToString("N2")</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Equity</span>
                <span class="text-sm font-bold font-mono text-slate-800 dark:text-white">$@acc.Equity.ToString("N2")</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Free Margin</span>
                <span class="text-sm font-bold font-mono text-emerald-600">$@acc.FreeMargin.ToString("N2")</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-100 dark:border-slate-700 text-right">
                <span class="text-[10px] text-slate-400 uppercase font-semibold block">Margin Used</span>
                <span class="text-sm font-bold font-mono text-purple-600">$@acc.MarginUsed.ToString("N2")</span>
            </div>
            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Arbitrage" class="px-3 py-3 bg-purple-500/10 text-purple-600 dark:text-purple-400 hover:bg-purple-500 hover:text-white rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5" title="Arbitrage & Execution Scanner">
                <i class="fa-solid fa-arrows-split-up-and-left"></i> Arbitrage
            </a>
            <a asp-area="Crypto" asp-controller="CryptoRisk" asp-action="Index" class="px-3 py-3 bg-rose-500/10 text-rose-600 hover:bg-rose-500 hover:text-white rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5" title="Risk Management & Emergency Controls">
                <i class="fa-solid fa-shield-halved"></i> Risk
            </a>
        </div>
    </div>

    <!-- Main Trading Grid: Order Ticket (Left) & Order Book Depth / Public Trades (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Order Placement Ticket (5 cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-700">
                <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-ticket text-brand-500"></i> Execution Ticket
                </h3>
                <div class="text-xs font-mono font-bold text-slate-800 dark:text-white">
                    @symbol: <span class="text-brand-600">$@price.ToString("N2")</span>
                </div>
            </div>

            <!-- Smart Ticket Mode Tabs -->
            <div class="grid grid-cols-4 gap-1 p-1 bg-slate-100 dark:bg-slate-700/60 rounded-xl text-center">
                <button type="button" onclick="switchTicketTab('tabStandard', this)" class="ticket-tab-btn px-2 py-1.5 rounded-lg text-2xs font-bold transition-all bg-white dark:bg-slate-800 text-slate-800 dark:text-white shadow-2xs">
                    Standard
                </button>
                <button type="button" onclick="switchTicketTab('tabTwap', this)" class="ticket-tab-btn px-2 py-1.5 rounded-lg text-2xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:bg-white/50">
                    TWAP
                </button>
                <button type="button" onclick="switchTicketTab('tabIceberg', this)" class="ticket-tab-btn px-2 py-1.5 rounded-lg text-2xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:bg-white/50">
                    Iceberg
                </button>
                <button type="button" onclick="switchTicketTab('tabTrailing', this)" class="ticket-tab-btn px-2 py-1.5 rounded-lg text-2xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:bg-white/50">
                    Trailing
                </button>
            </div>

            <!-- Quick Symbol Buttons -->
            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var s in new[] { "BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT", "XRPUSDT" })
                {
                    <a asp-action="Index" asp-route-symbol="@s" class="px-2.5 py-1 rounded-lg text-2xs font-semibold transition-colors @(s == symbol ? "bg-brand-500 text-white" : "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200")">
                        @s.Replace("USDT", "")
                    </a>
                }
            </div>

            <!-- 1. STANDARD ORDER FORM -->
            <div id="tabStandard" class="ticket-panel space-y-4">
                <form asp-action="PlaceOrder" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@acc.Id" />
                    <input type="hidden" name="symbol" value="@symbol" />
                    <input type="hidden" name="tradingMode" value="@acc.TradingMode" />

                    <!-- Side Selector (Buy / Sell) -->
                    <div class="grid grid-cols-2 gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="side" value="@CryptoOrderSide.Buy" checked class="peer sr-only" />
                            <div class="py-2.5 rounded-xl border border-emerald-500/30 text-center text-xs font-bold peer-checked:bg-emerald-600 peer-checked:text-white text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition-all">
                                BUY / LONG
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="side" value="@CryptoOrderSide.Sell" class="peer sr-only" />
                            <div class="py-2.5 rounded-xl border border-rose-500/30 text-center text-xs font-bold peer-checked:bg-rose-600 peer-checked:text-white text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-all">
                                SELL / SHORT
                            </div>
                        </label>
                    </div>

                    <!-- Order Type -->
                    <div>
                        <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Order Type</label>
                        <select name="orderType" id="orderTypeSelect" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                            <option value="@CryptoOrderType.Market">Market (Instant Fill)</option>
                            <option value="@CryptoOrderType.Limit">Limit (Book Maker)</option>
                            <option value="@CryptoOrderType.StopLoss">Stop Loss Order</option>
                            <option value="@CryptoOrderType.TakeProfit">Take Profit Order</option>
                            <option value="@CryptoOrderType.StopLimit">Stop Limit</option>
                        </select>
                    </div>

                    <!-- Quantity & Price -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Quantity</label>
                            <input type="number" step="0.0001" name="quantity" value="0.05" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Limit Price ($)</label>
                            <input type="number" step="0.01" name="requestedPrice" value="@price" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                    </div>

                    <!-- Leverage Selector -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="text-2xs font-bold text-slate-500 uppercase tracking-wider">Leverage</label>
                            <span id="leverageLabel" class="text-xs font-mono font-bold text-purple-600">1x (Spot)</span>
                        </div>
                        <input type="range" name="leverage" min="1" max="20" value="1" id="leverageRange" class="w-full accent-purple-600 cursor-pointer" oninput="document.getElementById('leverageLabel').innerText = this.value + 'x' + (this.value > 5 ? ' (HIGH RISK)' : '')" />
                    </div>

                    <!-- Stops -->
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-700/40 border border-slate-100 dark:border-slate-700 space-y-2">
                        <span class="text-2xs font-bold uppercase tracking-wider text-slate-500 block">Automated Risk Stops</span>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[10px] font-bold text-rose-500 mb-0.5">Stop Loss ($)</label>
                                <input type="number" step="0.01" name="stopLoss" placeholder="@((price * 0.98m).ToString("0.00"))" class="w-full text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-white px-2.5 py-1.5" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-emerald-500 mb-0.5">Take Profit ($)</label>
                                <input type="number" step="0.01" name="takeProfit" placeholder="@((price * 1.04m).ToString("0.00"))" class="w-full text-xs font-mono rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-white px-2.5 py-1.5" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-xs transition-colors flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Submit Standard Order
                    </button>
                </form>
            </div>

            <!-- 2. TWAP EXECUTION ENGINE FORM -->
            <div id="tabTwap" class="ticket-panel space-y-4 hidden">
                <form asp-action="PlaceSmartOrder" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@acc.Id" />
                    <input type="hidden" name="symbol" value="@symbol" />
                    <input type="hidden" name="smartOrderType" value="@CryptoOrderType.Twap" />

                    <div class="p-3 bg-purple-50 dark:bg-purple-950/30 rounded-xl border border-purple-200 dark:border-purple-900/40 text-2xs text-purple-900 dark:text-purple-200">
                        <i class="fa-solid fa-clock mr-1 text-purple-600"></i>
                        <span class="font-bold">TWAP Time-Slicing:</span> Slices parent volume into micro-tranches to achieve benchmark time-weighted average price and reduce adverse market impact.
                    </div>

                    <!-- Side Selector -->
                    <div class="grid grid-cols-2 gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="side" value="@CryptoOrderSide.Buy" checked class="peer sr-only" />
                            <div class="py-2 rounded-xl border border-emerald-500/30 text-center text-xs font-bold peer-checked:bg-emerald-600 peer-checked:text-white text-emerald-600 transition-all">
                                BUY TWAP
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="side" value="@CryptoOrderSide.Sell" class="peer sr-only" />
                            <div class="py-2 rounded-xl border border-rose-500/30 text-center text-xs font-bold peer-checked:bg-rose-600 peer-checked:text-white text-rose-600 transition-all">
                                SELL TWAP
                            </div>
                        </label>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Total Quantity</label>
                            <input type="number" step="0.001" name="totalQuantity" value="1.00" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Benchmark Price ($)</label>
                            <input type="number" step="0.01" name="requestedPrice" value="@price" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Execution Window</label>
                            <select name="durationMinutes" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                                <option value="15">15 Minutes</option>
                                <option value="30" selected>30 Minutes</option>
                                <option value="60">1 Hour</option>
                                <option value="120">2 Hours</option>
                                <option value="360">6 Hours</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Tranche Interval</label>
                            <select name="intervalMinutes" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                                <option value="1">Every 1 min</option>
                                <option value="2">Every 2 mins</option>
                                <option value="5" selected>Every 5 mins</option>
                                <option value="10">Every 10 mins</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold shadow-xs transition-colors flex items-center justify-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left"></i> Launch TWAP Execution Plan
                    </button>
                </form>
            </div>

            <!-- 3. ICEBERG ORDER FORM -->
            <div id="tabIceberg" class="ticket-panel space-y-4 hidden">
                <form asp-action="PlaceSmartOrder" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@acc.Id" />
                    <input type="hidden" name="symbol" value="@symbol" />
                    <input type="hidden" name="smartOrderType" value="@CryptoOrderType.Iceberg" />

                    <div class="p-3 bg-blue-50 dark:bg-blue-950/30 rounded-xl border border-blue-200 dark:border-blue-900/40 text-2xs text-blue-900 dark:text-blue-200">
                        <i class="fa-solid fa-icicles mr-1 text-blue-600"></i>
                        <span class="font-bold">Iceberg Reserve Engine:</span> Places a small visible tip on the order book while keeping the bulk reserve invisible, replenishing dynamically with randomized variance.
                    </div>

                    <!-- Side Selector -->
                    <div class="grid grid-cols-2 gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="side" value="@CryptoOrderSide.Buy" checked class="peer sr-only" />
                            <div class="py-2 rounded-xl border border-emerald-500/30 text-center text-xs font-bold peer-checked:bg-emerald-600 peer-checked:text-white text-emerald-600 transition-all">
                                BUY ICEBERG
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="side" value="@CryptoOrderSide.Sell" class="peer sr-only" />
                            <div class="py-2 rounded-xl border border-rose-500/30 text-center text-xs font-bold peer-checked:bg-rose-600 peer-checked:text-white text-rose-600 transition-all">
                                SELL ICEBERG
                            </div>
                        </label>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Total Hidden Size</label>
                            <input type="number" step="0.01" name="totalQuantity" value="5.00" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Visible Display Tip</label>
                            <input type="number" step="0.01" name="visibleQuantity" value="1.00" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Limit Price ($)</label>
                            <input type="number" step="0.01" name="requestedPrice" value="@price" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Anti-Detection Jitter</label>
                            <select name="variancePercent" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                                <option value="5">&plusmn;5% Size Variance</option>
                                <option value="10" selected>&plusmn;10% Anti-Bot Jitter</option>
                                <option value="15">&plusmn;15% Maximum Masking</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-xs transition-colors flex items-center justify-center gap-2">
                        <i class="fa-solid fa-water"></i> Deploy Iceberg Order
                    </button>
                </form>
            </div>

            <!-- 4. TRAILING STOP RATCHET FORM -->
            <div id="tabTrailing" class="ticket-panel space-y-4 hidden">
                <form asp-action="PlaceSmartOrder" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@acc.Id" />
                    <input type="hidden" name="symbol" value="@symbol" />
                    <input type="hidden" name="smartOrderType" value="@CryptoOrderType.TrailingStop" />

                    <div class="p-3 bg-amber-50 dark:bg-amber-950/30 rounded-xl border border-amber-200 dark:border-amber-900/40 text-2xs text-amber-900 dark:text-amber-200">
                        <i class="fa-solid fa-shield-halved mr-1 text-amber-600"></i>
                        <span class="font-bold">Trailing Stop Ratchet:</span> Dynamically tracks market highs/lows, ratcheting stop price upward in profit and locking in gains with breakeven protection.
                    </div>

                    @if (Model.OpenPositions != null && Model.OpenPositions.Any())
                    {
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Attach to Active Position</label>
                            <select name="positionId" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                                @foreach (var p in Model.OpenPositions)
                                {
                                    <option value="@p.Id">@p.Symbol (@p.Side @p.Quantity.ToString("F4")) Entry: $@p.EntryPrice.ToString("N2")</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Quantity</label>
                                <input type="number" step="0.001" name="totalQuantity" value="0.10" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                            </div>
                            <div>
                                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Trigger Price ($)</label>
                                <input type="number" step="0.01" name="requestedPrice" value="@price" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                            </div>
                        </div>
                    }

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Trailing Distance ($)</label>
                            <input type="number" step="10" name="trailingDistanceUsd" value="500" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                        </div>
                        <div>
                            <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Ratchet Frequency</label>
