@model CryptoRiskOverviewDto
@{
    ViewData["Title"] = "Institutional Risk Management & Liquidation Safeguards";
    var acc = Model.Account;
    var dailyLoss = acc.DailyLoss;
    var dailyLossPercent = dailyLoss != null && dailyLoss.LimitPercent > 0 
        ? Math.Min(100f, (float)(dailyLoss.Percent / dailyLoss.LimitPercent) * 100f) 
        : 0f;
    var atrSizing = Model.AtrPositionSizing;
    var guards = Model.LiquidationGuards ?? Array.Empty<CryptoLiquidationGuardPositionDto>();
    var counterpartyScores = Model.CounterpartyRiskScores ?? Array.Empty<CryptoExchangeCounterpartyRiskDto>();
}

<div class="space-y-6">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200 shadow-xs">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200 shadow-xs">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                <span class="font-medium">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600">&times;</button>
        </div>
    }

    <!-- Header & Institutional Health Ribbon -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-shield-virus"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-800 dark:text-white">Institutional Risk Management &amp; Safeguards</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-2xs font-bold uppercase tracking-wider bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300">
                            Feature 7.1 &amp; 7.2
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Volatility-Adjusted (ATR) Position Sizing &bull; Real-Time Margin &amp; Liquidation Guard &bull; Outage &amp; Counterparty Shield
                    </p>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <!-- Account Health Grade Pill -->
            <div class="px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 flex items-center gap-2">
                <span class="text-2xs uppercase tracking-wider text-slate-400 font-semibold">Health Grade:</span>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold font-mono @(Model.AccountHealthGrade.StartsWith("A") ? "text-emerald-500" : Model.AccountHealthGrade.StartsWith("B") ? "text-blue-500" : Model.AccountHealthGrade.StartsWith("C") ? "text-amber-500" : "text-rose-500")">
                    <span class="w-2 h-2 rounded-full @(Model.AccountHealthGrade.StartsWith("A") ? "bg-emerald-500 animate-pulse" : "bg-rose-500")"></span>
                    @Model.AccountHealthGrade
                </span>
            </div>

            <!-- Quick Limits Config Button -->
            <button type="button" onclick="document.getElementById('editLimitsModal').classList.remove('hidden')" class="px-4 py-2.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors flex items-center gap-1.5">
                <i class="fa-solid fa-sliders"></i> Risk Limits
            </button>

            <!-- Emergency Kill Switch Button -->
            <button type="button" onclick="document.getElementById('killSwitchModal').classList.remove('hidden')" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors flex items-center gap-2">
                <i class="fa-solid fa-power-off"></i> KILL SWITCH
            </button>
        </div>
    </div>

    <!-- Key Risk Metric KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Account Equity & Liquidation Buffer -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Free Liquidation Buffer</span>
                <span class="p-2 rounded-xl bg-blue-500/10 text-blue-500 text-xs"><i class="fa-solid fa-vault"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold font-mono text-slate-800 dark:text-white">$@Model.FreeLiquidationBufferUsd.ToString("N2")</div>
            <div class="mt-1 text-2xs text-slate-400">
                Equity: $@acc.Equity.ToString("N2") | Margin: $@acc.MarginUsed.ToString("N2")
            </div>
        </div>

        <!-- Maintenance Margin Ratio -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Total Maint. Margin Req.</span>
                <span class="p-2 rounded-xl bg-purple-500/10 text-purple-500 text-xs"><i class="fa-solid fa-scale-balanced"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold font-mono text-purple-600 dark:text-purple-400">
                $@Model.TotalMaintenanceMarginRequired.ToString("N2")
            </div>
            <div class="mt-1 text-2xs text-slate-400">
                Standard 0.5% perpetual futures MMR threshold
            </div>
        </div>

        <!-- Daily Drawdown Breaker -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Daily Drawdown Breaker</span>
                <span class="p-2 rounded-xl bg-rose-500/10 text-rose-500 text-xs"><i class="fa-solid fa-chart-line-down"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold font-mono @(dailyLoss != null && dailyLoss.IsBreached ? "text-rose-500" : "text-slate-800 dark:text-white")">
                $@(dailyLoss?.Amount.ToString("N2") ?? "0.00") / @(dailyLoss?.LimitPercent.ToString("F1") ?? "5.0")%
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-700 h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="h-full rounded-full @(dailyLoss != null && dailyLoss.IsBreached ? "bg-rose-500" : "bg-emerald-500")" style="width: @(dailyLossPercent)%"></div>
            </div>
        </div>

        <!-- Safe Leverage Cap -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Safe Leverage Cap</span>
                <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-500 text-xs"><i class="fa-solid fa-shield-check"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold font-mono text-emerald-500">
                @Model.MaxSafePortfolioLeverage.ToString("F1")x Portfolio Cap
            </div>
            <div class="mt-1 text-2xs text-slate-400">
                Recommended Risk/Trade: @acc.RiskPercentagePerTrade.ToString("F1")%
            </div>
        </div>
    </div>

    <!-- Active Risk Alerts & AFM Notice -->
    @if (Model.RiskAlerts != null && Model.RiskAlerts.Count > 0)
    {
        <div class="space-y-2">
            @foreach (var alert in Model.RiskAlerts)
            {
                <div class="p-3.5 rounded-xl bg-amber-50 dark:bg-amber-950/25 border border-amber-200 dark:border-amber-900/50 flex items-center gap-3 text-xs text-amber-800 dark:text-amber-200">
                    <i class="fa-solid fa-triangle-exclamation text-amber-500 text-sm shrink-0"></i>
                    <span>@alert</span>
                </div>
            }
        </div>
    }

    <!-- Navigation Tabs -->
    <div class="border-b border-slate-200 dark:border-slate-700 flex flex-wrap gap-2 text-xs font-semibold">
        <button type="button" onclick="switchRiskTab('tab-atr')" id="btn-tab-atr" class="px-4 py-2.5 rounded-t-xl border-b-2 border-brand-500 text-brand-600 dark:text-brand-400 flex items-center gap-2">
            <i class="fa-solid fa-wave-square"></i> 7.1 Volatility-Adjusted (ATR) Sizing
        </button>
        <button type="button" onclick="switchRiskTab('tab-guard')" id="btn-tab-guard" class="px-4 py-2.5 rounded-t-xl border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-shield-halved"></i> 7.2 Real-Time Margin &amp; Liquidation Guard
            <span class="px-1.5 py-0.2 rounded-full text-2xs bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300 font-mono">@guards.Count</span>
        </button>
        <button type="button" onclick="switchRiskTab('tab-counterparty')" id="btn-tab-counterparty" class="px-4 py-2.5 rounded-t-xl border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-building-shield"></i> Counterparty &amp; Outage Safeguard
        </button>
        <button type="button" onclick="switchRiskTab('tab-regulatory')" id="btn-tab-regulatory" class="px-4 py-2.5 rounded-t-xl border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-landmark"></i> Dutch AFM &amp; MiCA Guardrails
        </button>
    </div>

    <!-- TAB 1: 7.1 Volatility-Adjusted (ATR) Position Sizing Engine -->
    <div id="tab-atr" class="space-y-6">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-slate-100 dark:border-slate-700">
                <div>
                    <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-bolt text-brand-500"></i> Dynamic 14-Period ATR Position Sizing Engine
                    </h2>
                    <p class="text-2xs text-slate-400 mt-0.5">
                        Calibrates position notional and leverage directly to asset volatility, preventing outsized drawdowns during turbulent market regimes.
                    </p>
                </div>
                <!-- Asset Preset Pills -->
                <div class="flex items-center gap-1.5 flex-wrap">
                    <button type="button" onclick="selectAtrAsset('BTCUSDT', 67500, 2450)" class="px-2.5 py-1 text-2xs rounded-lg font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-brand-500 hover:text-white transition-colors">BTC</button>
                    <button type="button" onclick="selectAtrAsset('ETHUSDT', 3480, 145)" class="px-2.5 py-1 text-2xs rounded-lg font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-brand-500 hover:text-white transition-colors">ETH</button>
                    <button type="button" onclick="selectAtrAsset('SOLUSDT', 152.5, 9.5)" class="px-2.5 py-1 text-2xs rounded-lg font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-brand-500 hover:text-white transition-colors">SOL</button>
                    <button type="button" onclick="selectAtrAsset('SUIUSDT', 2.15, 0.18)" class="px-2.5 py-1 text-2xs rounded-lg font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-brand-500 hover:text-white transition-colors">SUI</button>
                    <button type="button" onclick="selectAtrAsset('DOGEUSDT', 0.138, 0.0125)" class="px-2.5 py-1 text-2xs rounded-lg font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-brand-500 hover:text-white transition-colors">DOGE</button>
                </div>
            </div>

            <!-- Interactive Inputs Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Trading Asset</label>
                    <input type="text" id="atrSymbol" value="@(atrSizing?.Symbol ?? "BTCUSDT")" class="w-full text-xs font-mono font-bold rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2 uppercase" onchange="recalculateAtr()" />
                </div>
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Account Equity ($)</label>
                    <input type="number" id="atrEquity" value="@acc.Equity" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" oninput="recalculateAtr()" />
                </div>
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Risk Budget (%)</label>
                    <input type="number" step="0.25" id="atrRiskPct" value="@acc.RiskPercentagePerTrade" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" oninput="recalculateAtr()" />
                </div>
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Entry Price ($)</label>
                    <input type="number" step="0.01" id="atrEntryPrice" value="@(atrSizing?.EntryPrice ?? 67500m)" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" oninput="recalculateAtr()" />
                </div>
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">ATR Multiplier</label>
                    <select id="atrMultiplier" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" onchange="recalculateAtr()">
                        <option value="1.0">1.0x (Tight / Scalp)</option>
                        <option value="1.5" selected>1.5x (Day Trade / Momentum)</option>
                        <option value="2.0">2.0x (Swing / Standard)</option>
                        <option value="3.0">3.0x (Wide / Chandelier)</option>
                    </select>
                </div>
            </div>

            <!-- Custom ATR override expandable -->
            <div class="flex items-center gap-4 text-xs text-slate-500">
                <span class="text-2xs font-bold uppercase tracking-wider">ATR-14 Benchmark:</span>
                <span id="dispAtrPrice" class="font-mono font-bold text-slate-800 dark:text-white">$@(atrSizing?.Atr14Price.ToString("N2") ?? "2,450.00")</span>
                <span class="text-2xs text-slate-400">|</span>
                <span class="text-2xs font-bold uppercase tracking-wider">Daily ATR %:</span>
                <span id="dispAtrPercent" class="font-mono font-bold text-brand-500">@(atrSizing?.AtrPercent.ToString("F2") ?? "3.63")%</span>
                <span class="text-2xs text-slate-400">|</span>
                <span class="text-2xs font-bold uppercase tracking-wider">Regime:</span>
                <span id="dispAtrRegime" class="px-2 py-0.5 rounded-full text-2xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                    @(atrSizing?.VolatilityRegime ?? "Normal Volatility")
                </span>
            </div>

            <!-- Recommended Position Sizing Matrix -->
            <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-700/40 dark:to-slate-800 border border-slate-200 dark:border-slate-700 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="text-2xs text-slate-400 uppercase font-semibold block">Max Dollar Risk Budget</span>
                    <span id="dispDollarRisk" class="text-lg font-bold font-mono text-rose-500 mt-1 block">
                        $@(atrSizing?.DollarRiskBudget.ToString("N2") ?? "100.00")
                    </span>
                    <span class="text-2xs text-slate-400 mt-0.5 block">Capital at risk if Stop Loss hit</span>
                </div>

                <div class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="text-2xs text-slate-400 uppercase font-semibold block">Volatility-Adjusted Size</span>
                    <span id="dispCoins" class="text-lg font-bold font-mono text-emerald-500 mt-1 block">
                        @(atrSizing?.RecommendedPositionCoins.ToString("F4") ?? "0.0272") Coins
                    </span>
                    <span id="dispNotional" class="text-2xs text-slate-400 mt-0.5 block">
                        Notional: $@(atrSizing?.TotalNotionalUsd.ToString("N2") ?? "1,836.00")
                    </span>
                </div>

                <div class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="text-2xs text-slate-400 uppercase font-semibold block">Safe Institutional Leverage</span>
                    <span id="dispSafeLeverage" class="text-lg font-bold font-mono text-blue-500 mt-1 block">
                        @(atrSizing?.SafeLeverageCap ?? 1)x Leverage Cap
                    </span>
                    <span class="text-2xs text-slate-400 mt-0.5 block">AFM retail limit compliant</span>
                </div>

                <div class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
                    <span class="text-2xs text-slate-400 uppercase font-semibold block">Half-Kelly Fraction (f*)</span>
                    <span id="dispKelly" class="text-lg font-bold font-mono text-purple-500 mt-1 block">
                        @(atrSizing?.KellyFractionPercent.ToString("F2") ?? "13.85")%
                    </span>
                    <span class="text-2xs text-slate-400 mt-0.5 block">Mathematical optimal safe cap</span>
                </div>
            </div>

            <!-- Sizing Comparison: Volatility Parity vs. Fixed 2% -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center justify-between">
                        <span><i class="fa-solid fa-code-compare text-brand-500"></i> Volatility Parity vs. Fixed %</span>
                        <span id="dispVolRatio" class="text-2xs font-mono font-bold text-blue-500">@(atrSizing?.VolatilityAdjustmentRatio.ToString("F1") ?? "73.5")% of Fixed Size</span>
                    </h3>
                    <p class="text-2xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        In high-volatility regimes, naive fixed % sizing causes outsized dollar stops. Volatility Parity dynamically contracts position sizing by 
                        <strong id="dispContraction" class="text-rose-500">@((100m - (atrSizing?.VolatilityAdjustmentRatio ?? 73.5m)).ToString("F1"))%</strong> 
                        to maintain exact normalized dollar risk across all crypto pairs.
                    </p>
                </div>

                <!-- Dynamic ATR Stops & Take Profit Targets -->
                <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
                    <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-bullseye text-emerald-500"></i> Calculated Dynamic Price Targets
                    </h3>
                    <div class="grid grid-cols-2 gap-2 text-2xs font-mono">
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded-lg">
                            <span class="text-slate-400 block font-sans">Stop Loss (Long):</span>
                            <span id="dispStopLong" class="font-bold text-rose-500">$@(atrSizing?.RecommendedStopLossLong.ToString("N2") ?? "63,825.00")</span>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded-lg">
                            <span class="text-slate-400 block font-sans">Stop Loss (Short):</span>
                            <span id="dispStopShort" class="font-bold text-rose-500">$@(atrSizing?.RecommendedStopLossShort.ToString("N2") ?? "71,175.00")</span>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded-lg">
                            <span class="text-slate-400 block font-sans">Take Profit 1 (1.5R):</span>
                            <span id="dispTp1" class="font-bold text-emerald-500">$@(atrSizing?.RecommendedTakeProfit1.ToString("N2") ?? "73,012.50")</span>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded-lg">
                            <span class="text-slate-400 block font-sans">Chandelier Exit (3x ATR):</span>
                            <span id="dispChandelier" class="font-bold text-blue-500">$@(atrSizing?.SuggestedChandelierExitLong.ToString("N2") ?? "60,150.00")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: 7.2 Real-Time Margin & Liquidation Guard -->
    <div id="tab-guard" class="hidden space-y-6">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-100 dark:border-slate-700">
                <div>
                    <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-rose-500"></i> Real-Time Margin &amp; Liquidation Safeguards
                    </h2>
                    <p class="text-2xs text-slate-400 mt-0.5">
                        Continuous distance-to-liquidation monitoring calibrated against daily ATR wick probabilities, with one-click top-up and position de-risking.
                    </p>
                </div>
                <div class="flex items-center gap-2 text-2xs font-semibold">
                    <span class="flex items-center gap-1 text-emerald-600"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> &gt;15% Safe</span>
                    <span class="flex items-center gap-1 text-amber-600"><span class="w-2 h-2 rounded-full bg-amber-500"></span> 8-15% Caution</span>
                    <span class="flex items-center gap-1 text-orange-600"><span class="w-2 h-2 rounded-full bg-orange-500"></span> 3-8% Margin Call</span>
                    <span class="flex items-center gap-1 text-rose-600"><span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> &lt;3% Imminent</span>
                </div>
            </div>

            <!-- Liquidation Guard Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                    <thead class="text-2xs uppercase tracking-wider text-slate-400 bg-slate-50 dark:bg-slate-700/50">
                        <tr>
                            <th class="py-3 px-4 rounded-l-xl">Position</th>
                            <th class="py-3 px-3">Mark Price</th>
                            <th class="py-3 px-3">Liq. Price</th>
                            <th class="py-3 px-3">Distance to Liq.</th>
                            <th class="py-3 px-3">ATR Wick Buffer</th>
                            <th class="py-3 px-3">Initial Margin</th>
                            <th class="py-3 px-3">Maint. Margin</th>
                            <th class="py-3 px-3">Guard Status</th>
                            <th class="py-3 px-4 text-right rounded-r-xl">Safeguard Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @if (guards.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="py-8 text-center text-slate-400 text-xs">
                                    No open leveraged positions. Your margin account is 100% liquid and safe from forced liquidation.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pos in guards)
                            {
                                var statusClass = pos.GuardStatus switch
                                {
                                    "Safe" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300",
                                    "Caution" => "bg-amber-100 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300",
                                    "High Risk / Margin Call" => "bg-orange-100 text-orange-700 dark:bg-orange-950/40 dark:text-orange-300",
                                    _ => "bg-rose-100 text-rose-700 dark:bg-rose-900/50 dark:text-rose-200 animate-pulse"
                                };

                                var distTextClass = pos.DistanceToLiquidationPercent switch
                                {
                                    > 15m => "text-emerald-500",
                                    > 8m => "text-amber-500",
                                    > 3m => "text-orange-500",
                                    _ => "text-rose-500 font-bold"
                                };

                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
                                    <td class="py-3.5 px-4 font-mono">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-slate-800 dark:text-white">@pos.Symbol</span>
                                            <span class="px-1.5 py-0.5 rounded text-2xs font-bold @(pos.Side == CryptoPositionSide.Long ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50" : "bg-rose-50 text-rose-600 dark:bg-rose-950/50")">
                                                @pos.Side @(pos.Leverage)x
                                            </span>
                                        </div>
                                        <div class="text-2xs text-slate-400 mt-0.5 font-sans">
                                            Qty: @pos.Quantity.ToString("F4") | Entry: $@pos.EntryPrice.ToString("N2")
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-3 font-mono font-bold text-slate-800 dark:text-white">
                                        $@pos.CurrentPrice.ToString("N2")
                                    </td>
                                    <td class="py-3.5 px-3 font-mono font-bold text-rose-500">
                                        $@pos.LiquidationPrice.ToString("N2")
                                    </td>
                                    <td class="py-3.5 px-3 font-mono font-bold @distTextClass">
                                        @pos.DistanceToLiquidationPercent.ToString("F2")%
                                    </td>
                                    <td class="py-3.5 px-3 font-mono text-slate-600 dark:text-slate-300">
                                        <span class="inline-flex items-center gap-1">
                                            <i class="fa-solid fa-ruler-horizontal text-2xs text-slate-400"></i>
                                            @pos.DistanceToLiquidationAtrWicks.ToString("F1") wicks
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-3 font-mono text-slate-700 dark:text-slate-200">
                                        $@pos.InitialMargin.ToString("N2")
                                    </td>
                                    <td class="py-3.5 px-3 font-mono text-purple-600 dark:text-purple-400">
                                        $@pos.MaintenanceMargin.ToString("N2")
                                    </td>
                                    <td class="py-3.5 px-3">
                                        <span class="px-2.5 py-1 rounded-full text-2xs font-bold @statusClass">
                                            @pos.GuardStatus
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1.5">
                                            <!-- Top Up Margin Button -->
                                            <button type="button" onclick="openTopUpModal('@pos.PositionId', '@pos.Symbol', @pos.RecommendedTopUpUsd)" class="px-2.5 py-1.5 bg-blue-50 dark:bg-blue-900/30 hover:bg-blue-100 text-blue-600 dark:text-blue-300 rounded-lg text-2xs font-bold transition-colors">
                                                <i class="fa-solid fa-plus-circle"></i> +$@pos.RecommendedTopUpUsd.ToString("N0")
                                            </button>
                                            <!-- Trim 50% Position Button -->
                                            <button type="button" onclick="openTrimModal('@pos.PositionId', '@pos.Symbol', @pos.RecommendedTrimQuantity)" class="px-2.5 py-1.5 bg-rose-50 dark:bg-rose-900/30 hover:bg-rose-100 text-rose-600 dark:text-rose-300 rounded-lg text-2xs font-bold transition-colors">
                                                <i class="fa-solid fa-scissors"></i> Trim 50%
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: Exchange Counterparty Risk & Outage Safeguard -->
    <div id="tab-counterparty" class="hidden space-y-6">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-5">
            <div>
                <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-building-shield text-emerald-500"></i> Tier-1 Exchange Counterparty Risk &amp; Outage Safeguards
                </h2>
                <p class="text-2xs text-slate-400 mt-0.5">
                    Evaluates Proof-of-Reserves (PoR), Dutch AFM / MiCA registration status, and automated websocket failover heartbeats.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var cp in counterpartyScores)
                {
                    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200 dark:border-slate-600 space-y-3">
                        <div class="flex items-center justify-between">
