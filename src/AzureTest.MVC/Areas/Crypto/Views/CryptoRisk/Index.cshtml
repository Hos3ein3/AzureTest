                                    @cp.Exchange.ToString().Substring(0, 2).ToUpper()
                                </div>
                                <div>
                                    <h3 class="text-xs font-bold text-slate-800 dark:text-white">@cp.Exchange</h3>
                                    <span class="text-2xs text-slate-400 font-mono">Vol Share: @cp.DailyVolumeSharePercent%</span>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded-md font-mono text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">
                                Rating: @cp.Rating
                            </span>
                        </div>

                        <div class="space-y-1.5 text-2xs">
                            <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                <span>Safety Score:</span>
                                <span class="font-mono font-bold text-slate-800 dark:text-white">@cp.SafetyScore / 100</span>
                            </div>
                            <div class="w-full bg-slate-200 dark:bg-slate-600 h-1.5 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full" style="width: @cp.SafetyScore%"></div>
                            </div>

                            <div class="flex justify-between text-slate-600 dark:text-slate-300 pt-1">
                                <span>Proof-of-Reserves:</span>
                                <span class="font-mono font-bold text-emerald-500">@cp.ProofOfReservesRatioPercent.ToString("F1")% Collateralized</span>
                            </div>
                            <div class="flex justify-between text-slate-600 dark:text-slate-300">
                                <span>Outage Shield:</span>
                                <span class="font-mono text-blue-500 font-semibold">@cp.OutageSafeguardStatus</span>
                            </div>
                        </div>

                        <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 text-2xs text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                            <i class="fa-solid fa-stamp text-emerald-500 mr-1"></i> @cp.RegulatoryCompliance
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB 4: Dutch AFM & MiCA Guardrails -->
    <div id="tab-regulatory" class="hidden space-y-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs space-y-5">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider">
                        Dutch AFM, ESMA &amp; EU MiCA Regulatory Safeguards
                    </h2>
                    <p class="text-2xs text-slate-400">Statutory leverage constraints, risk disclosures, and Box 3 asset monitoring</p>
                </div>
            </div>

            <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/50 space-y-2 text-xs text-amber-900 dark:text-amber-200 leading-relaxed">
                <p>
                    <strong>Autoriteit Financiële Markten (AFM) / ESMA Leverage Restrictions:</strong>
                    Under EU product intervention measures, crypto-asset derivatives offered to retail clients are subject to strict leverage caps (maximum 2:1 for crypto CFDs). High leverage magnifies volatility drag and exchange execution latency.
                </p>
                <p>
                    <strong>EU MiCA (Markets in Crypto-Assets) Framework:</strong>
                    Crypto-Asset Service Providers (CASPs) must maintain audited 1:1 asset backing, segregated client accounts, and real-time stress testing against black swan de-peg events.
                </p>
                <p>
                    <strong>Dutch Tax (Belastingdienst Box 3):</strong>
                    Cryptocurrencies held on January 1st (peildatum) are classified under "overige bezittingen" for Dutch wealth tax calculations. Maintain complete transaction logs and trade histories for compliance.
                </p>
            </div>
        </div>
    </div>
