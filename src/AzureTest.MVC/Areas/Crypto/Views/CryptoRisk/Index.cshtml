<script>
function switchRiskTab(tabId) {
    const tabs = ['tab-atr', 'tab-guard', 'tab-counterparty', 'tab-regulatory'];
    tabs.forEach(t => {
        const el = document.getElementById(t);
        const btn = document.getElementById('btn-' + t);
        if (el) el.classList.toggle('hidden', t !== tabId);
        if (btn) {
            if (t === tabId) {
                btn.className = 'px-4 py-2.5 rounded-t-xl border-b-2 border-brand-500 text-brand-600 dark:text-brand-400 flex items-center gap-2 font-bold';
            } else {
                btn.className = 'px-4 py-2.5 rounded-t-xl border-b-2 border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-2 font-semibold';
            }
        }
    });
}

function selectAtrAsset(symbol, price, atr) {
    document.getElementById('atrSymbol').value = symbol;
    document.getElementById('atrEntryPrice').value = price;
    window.currentCustomAtr = atr;
    recalculateAtr();
}

function recalculateAtr() {
    const symbol = document.getElementById('atrSymbol').value || 'BTCUSDT';
    const equity = parseFloat(document.getElementById('atrEquity').value) || 10000;
    const riskPct = parseFloat(document.getElementById('atrRiskPct').value) || 1.0;
    const entry = parseFloat(document.getElementById('atrEntryPrice').value) || 67500;
    const mult = parseFloat(document.getElementById('atrMultiplier').value) || 1.5;

    // Fast client-side dynamic calculation with live formulas
    let atr14 = window.currentCustomAtr || (entry * 0.0363);
    if (symbol.toUpperCase().includes('ETH')) atr14 = 145;
    else if (symbol.toUpperCase().includes('SOL')) atr14 = 9.5;
    else if (symbol.toUpperCase().includes('SUI')) atr14 = 0.18;
    else if (symbol.toUpperCase().includes('DOGE')) atr14 = 0.0125;
    else if (symbol.toUpperCase().includes('BTC')) atr14 = 2450;

    const atrPct = (atr14 / entry) * 100;
    const stopDist = atr14 * mult;
    const dollarRisk = equity * (riskPct / 100);
    const coins = stopDist > 0 ? (dollarRisk / stopDist) : 0;
    const notional = coins * entry;
    const safeLeverage = Math.min(5, Math.max(1, Math.ceil(notional / equity)));
    const fixedStopDist = entry * 0.02;
    const fixedCoins = fixedStopDist > 0 ? (dollarRisk / fixedStopDist) : 0;
    const volRatio = fixedCoins > 0 ? (coins / fixedCoins) * 100 : 100;

    let regime = "Normal Volatility";
    if (atrPct < 3.0) regime = "Low Volatility (Compression)";
    else if (atrPct > 6.0) regime = "High Volatility (Turbulent)";

    // Update UI elements
    document.getElementById('dispAtrPrice').innerText = '$' + atr14.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
    document.getElementById('dispAtrPercent').innerText = atrPct.toFixed(2) + '%';
    document.getElementById('dispAtrRegime').innerText = regime;
    document.getElementById('dispDollarRisk').innerText = '$' + dollarRisk.toFixed(2);
    document.getElementById('dispCoins').innerText = coins.toFixed(4) + ' Coins';
    document.getElementById('dispNotional').innerText = 'Notional: $' + notional.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('dispSafeLeverage').innerText = safeLeverage + 'x Leverage Cap';
    document.getElementById('dispVolRatio').innerText = volRatio.toFixed(1) + '% of Fixed Size';
    document.getElementById('dispContraction').innerText = Math.max(0, (100 - volRatio)).toFixed(1) + '%';

    document.getElementById('dispStopLong').innerText = '$' + Math.max(0, (entry - stopDist)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('dispStopShort').innerText = '$' + (entry + stopDist).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('dispTp1').innerText = '$' + (entry + 1.5 * stopDist).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('dispChandelier').innerText = '$' + Math.max(0, (entry - 3.0 * atr14)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function openTopUpModal(posId, symbol, recAmount) {
    document.getElementById('topUpPositionId').value = posId;
    document.getElementById('topUpAmountUsd').value = Math.ceil(recAmount || 100);
    document.getElementById('topUpModalSubtitle').innerText = 'Inject margin for ' + symbol + ' position';
    document.getElementById('topUpModal').classList.remove('hidden');
}

function openTrimModal(posId, symbol, trimQty) {
    document.getElementById('trimPositionId').value = posId;
    document.getElementById('trimQuantity').value = trimQty || 0.25;
    document.getElementById('trimModalSubtitle').innerText = 'De-risk ' + symbol + ' position by trimming units';
    document.getElementById('trimModal').classList.remove('hidden');
}

document.addEventListener('DOMContentLoaded', function() {
    recalculateAtr();
});
</script>
