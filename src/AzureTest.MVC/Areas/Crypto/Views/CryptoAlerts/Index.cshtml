@model IReadOnlyList<CryptoAlertDto>
@{
    ViewData["Title"] = "Crypto Automated Alerts";
}

<div class="space-y-6">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600">&times;</button>
        </div>
    }

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Price &amp; Signal Alerts</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Automated notifications for price thresholds, RSI overextensions, and MACD crossovers</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a asp-area="Crypto" asp-controller="CryptoMarket" asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-semibold transition-colors">
                <i class="fa-solid fa-chart-line"></i> Markets
            </a>
            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition-colors">
                <i class="fa-solid fa-bolt"></i> Trading Terminal
            </a>
        </div>
    </div>

    <!-- Create Alert Card -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
        <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 dark:border-slate-700 pb-3">
            <i class="fa-solid fa-plus-circle text-amber-500"></i> Setup New Automated Alert
        </h3>

        <form asp-action="Create" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Coin / Pair</label>
                    <input type="text" name="symbol" value="BTCUSDT" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Trigger Condition</label>
                    <select name="alertType" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="@CryptoAlertType.PriceAbove">Price Crosses Above (&gt;=)</option>
                        <option value="@CryptoAlertType.PriceBelow">Price Crosses Below (&lt;=)</option>
                        <option value="@CryptoAlertType.RsiOverbought">RSI Overbought (&gt;= 70)</option>
                        <option value="@CryptoAlertType.RsiOversold">RSI Oversold (&lt;= 30)</option>
                        <option value="@CryptoAlertType.MacdCross">MACD Bullish Cross</option>
                        <option value="@CryptoAlertType.WhaleAlert">Whale On-Chain Movement</option>
                    </select>
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Target Value ($ / Level)</label>
                    <input type="number" step="0.01" name="targetValue" value="70000" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Delivery Channel</label>
                    <select name="channel" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="InApp">In-App Notification</option>
                        <option value="Telegram">Telegram Bot</option>
                        <option value="Email">Email Digest</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Custom Note / Alert Message</label>
                <input type="text" name="message" placeholder="e.g. BTC reached psychological resistance $70k. Check EMA alignment for short setup." class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" />
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="px-6 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors">
                    Create Alert
                </button>
            </div>
        </form>
    </div>

    <!-- Active Alerts Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-list-check text-amber-500"></i> Active &amp; Triggered Alerts (@(Model?.Count ?? 0))
            </h3>
            <span class="text-2xs text-slate-400">Continuous 24/7 Monitoring</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 text-[11px] font-bold uppercase">
                        <th class="py-3 px-4">Created On</th>
                        <th class="py-3 px-4">Symbol</th>
                        <th class="py-3 px-4">Trigger Condition</th>
                        <th class="py-3 px-4 text-right">Target Value</th>
                        <th class="py-3 px-4">Channel</th>
                        <th class="py-3 px-4">Custom Note</th>
                        <th class="py-3 px-4 text-center">Status</th>
                        <th class="py-3 px-4 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-mono">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var alert in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-3 px-4 text-slate-500 font-sans">@alert.CreatedOn.ToString("MM-dd HH:mm")</td>
                                <td class="py-3 px-4 font-bold text-slate-800 dark:text-white font-sans">@alert.Symbol</td>
                                <td class="py-3 px-4 font-sans text-slate-700 dark:text-slate-300">@alert.AlertType</td>
                                <td class="py-3 px-4 text-right font-bold text-slate-800 dark:text-white">$@alert.TargetValue.ToString("N2")</td>
                                <td class="py-3 px-4 font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                                        @alert.Channel
                                    </span>
                                </td>
                                <td class="py-3 px-4 font-sans text-2xs text-slate-500 max-w-xs truncate">@(alert.Message ?? "--")</td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(alert.IsTriggered ? "bg-rose-100 text-rose-600" : "bg-emerald-100 text-emerald-600")">
                                        @(alert.IsTriggered ? $"Triggered ({alert.TriggeredAtUtc:HH:mm})" : "Monitoring Active")
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <form asp-action="Delete" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="alertId" value="@alert.Id" />
                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 transition-colors" title="Delete Alert">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-6 text-center text-slate-400 font-sans">
                                No active alerts configured. Use the form above to add a price or indicator alert.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
