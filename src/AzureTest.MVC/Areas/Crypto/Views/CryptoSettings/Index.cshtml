@model IReadOnlyList<CryptoApiSettingsDto>
@{
    ViewData["Title"] = "Crypto API & Security Settings";
}

<div class="space-y-6">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600">&times;</button>
        </div>
    }

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">API Credentials &amp; Security Controls</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Connect exchange accounts with read/trade permissions only (strictly NO withdrawal access)</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition-colors">
                <i class="fa-solid fa-bolt"></i> Trading Terminal
            </a>
            <a asp-area="Crypto" asp-controller="CryptoRisk" asp-action="Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-semibold transition-colors">
                <i class="fa-solid fa-shield-halved"></i> Risk Dashboard
            </a>
        </div>
    </div>

    <!-- Security Warning & Legal Policy -->
    <div class="p-5 rounded-2xl bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 flex items-start gap-4">
        <div class="p-2 rounded-xl bg-rose-500/20 text-rose-600 text-lg shrink-0">
            <i class="fa-solid fa-shield-cat"></i>
        </div>
        <div class="space-y-1">
            <h3 class="text-xs font-bold text-rose-900 dark:text-rose-200 uppercase tracking-wider">
                Security Mandate: Strict Zero-Withdrawal Policy
            </h3>
            <p class="text-xs text-rose-800 dark:text-rose-300 leading-relaxed">
                When generating API keys on <strong>Binance, Kraken, Bybit, or Coinbase</strong>, you must <strong>UNCHECK the "Withdrawals" permission</strong>. The trading engine only requires <strong>"Read"</strong> and <strong>"Spot/Futures Trading"</strong> permissions. Stored credentials are encrypted at rest with AES-256 and audited.
            </p>
            <div class="text-[11px] text-rose-700 dark:text-rose-400 pt-1 font-semibold">
                Paper Trading Mode is active by default. Live execution is permitted only after deliberate testing on testnet or paper capital.
            </div>
        </div>
    </div>

    <!-- Add / Update API Key Form -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
        <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 dark:border-slate-700 pb-3">
            <i class="fa-solid fa-plus-circle text-brand-500"></i> Configure Exchange Connectivity
        </h3>

        <form asp-action="Update" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Exchange</label>
                    <select name="exchange" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="@CryptoExchange.Binance">Binance Spot &amp; Futures</option>
                        <option value="@CryptoExchange.Kraken">Kraken</option>
                        <option value="@CryptoExchange.Bybit">Bybit</option>
                    </select>
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Environment Mode</label>
                    <select name="isTestnet" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="true" selected>Spot Testnet (Recommended for verification)</option>
                        <option value="false">Live Production (Requires explicit confirmation)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">API Passphrase (Optional / Bybit)</label>
                    <input type="password" name="passphrase" placeholder="Optional passphrase" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">API Key</label>
                    <input type="text" name="apiKey" placeholder="Paste your exchange API public key..." class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                </div>
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">API Secret</label>
                    <input type="password" name="apiSecret" placeholder="Paste your exchange API private secret..." class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors">
                    Encrypt &amp; Save Credentials
                </button>
            </div>
        </form>
    </div>

    <!-- Connected Exchanges Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-server text-purple-500"></i> Registered Exchange Credentials (@(Model?.Count ?? 0))
            </h3>
            <span class="text-2xs text-slate-400">Encrypted AES-256 Storage</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 text-[11px] font-bold uppercase">
                        <th class="py-3 px-4">Exchange</th>
                        <th class="py-3 px-4">Masked Key</th>
                        <th class="py-3 px-4 text-center">Environment</th>
                        <th class="py-3 px-4 text-center">Withdrawal Status</th>
                        <th class="py-3 px-4 text-center">Live Trading</th>
                        <th class="py-3 px-4">Configured On</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-mono">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var key in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-3 px-4 font-bold text-slate-800 dark:text-white font-sans">@key.Exchange</td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300">@key.ApiKeyMasked</td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(key.IsTestnet ? "bg-purple-100 text-purple-600" : "bg-amber-100 text-amber-600")">
                                        @(key.IsTestnet ? "Testnet" : "Live")
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-emerald-100 text-emerald-600">
                                        <i class="fa-solid fa-ban text-[9px] mr-1"></i> Blocked (Safe)
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(key.IsConnected ? "bg-emerald-100 text-emerald-600" : "bg-slate-100 text-slate-500")">
                                        @(key.IsConnected ? "Connected" : "Disconnected")
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-slate-500 font-sans">@(key.LastTestedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Pending")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-6 text-center text-slate-400 font-sans">
                                No exchange API keys registered yet. Paper trading remains operational without keys using free market feeds.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
