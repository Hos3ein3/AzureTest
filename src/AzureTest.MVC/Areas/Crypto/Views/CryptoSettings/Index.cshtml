@model IReadOnlyList<CryptoApiSettingsDto>
@{
    ViewData["Title"] = "Cipher-Grade API Key Security (AES-GCM-256)";
}

<div class="space-y-6">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200 shadow-xs">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-sm"></i>
                <span class="font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200 shadow-xs">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                <span class="font-medium">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600">&times;</button>
        </div>
    }

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-800 dark:text-white">API Credentials &amp; Cipher Security</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-2xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                            Feature 9.1
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        AES-GCM-256 authenticated encryption &bull; 12-byte cryptographic nonce &bull; Strict zero-withdrawal enforcement
                    </p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- Cipher Security Status Badge -->
            <div class="px-3.5 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-2xs font-mono font-bold text-emerald-700 dark:text-emerald-300">AES-GCM-256 ACTIVE</span>
            </div>

            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5">
                <i class="fa-solid fa-bolt"></i> Trading Terminal
            </a>
        </div>
    </div>

    <!-- Security Mandate: Strict Zero-Withdrawal Policy & Cipher Architecture -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="p-5 rounded-2xl bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 flex items-start gap-4">
            <div class="p-2 rounded-xl bg-rose-500/20 text-rose-600 text-lg shrink-0">
                <i class="fa-solid fa-ban"></i>
            </div>
            <div class="space-y-1">
                <h3 class="text-xs font-bold text-rose-900 dark:text-rose-200 uppercase tracking-wider">
                    Institutional Mandate: Strict Zero-Withdrawal Scope
                </h3>
                <p class="text-xs text-rose-800 dark:text-rose-300 leading-relaxed">
                    When creating exchange API keys, <strong>NEVER enable "Withdrawals"</strong>. The execution algorithms and risk monitors require only <strong>"Read"</strong> and <strong>"Trade"</strong> permissions. Any keys detecting withdrawal capabilities are automatically rejected by the platform validator.
                </p>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200 dark:border-slate-700 flex items-start gap-4">
            <div class="p-2 rounded-xl bg-emerald-500/20 text-emerald-600 text-lg shrink-0">
                <i class="fa-solid fa-lock"></i>
            </div>
            <div class="space-y-1">
                <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider">
                    AES-GCM-256 Authenticated Encryption Specification
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                    API Secrets are encrypted with <strong>AES-256 in Galois/Counter Mode (GCM)</strong> using unique 96-bit (12-byte) cryptographically secure random nonces and 128-bit (16-byte) authentication tags, providing tamper-proof confidentiality and data integrity.
                </p>
            </div>
        </div>
    </div>

    <!-- Add / Update API Key Form -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
        <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2 border-b border-slate-100 dark:border-slate-700 pb-3">
            <i class="fa-solid fa-plus-circle text-brand-500"></i> Register Exchange API Credentials
        </h3>

        <form asp-action="Update" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Exchange Gateway</label>
                    <select name="exchange" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="@CryptoExchange.Binance">Binance Spot &amp; Futures</option>
                        <option value="@CryptoExchange.Kraken">Kraken Pro</option>
                        <option value="@CryptoExchange.Bybit">Bybit Derivatives</option>
                        <option value="@CryptoExchange.Coinbase">Coinbase Advanced Trade</option>
                        <option value="@CryptoExchange.Okx">OKX Perpetuals &amp; Spot</option>
                    </select>
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Execution Mode</label>
                    <select name="isTestnet" class="w-full text-xs rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                        <option value="true" selected>Testnet / Sandbox (Zero Risk Verification)</option>
                        <option value="false">Live Production (Requires Explicit Risk Confirmation)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Passphrase (Optional / OKX / Bybit)</label>
                    <input type="password" name="passphrase" placeholder="API Passphrase if required" class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Public API Key</label>
                    <input type="text" name="apiKey" placeholder="Paste your exchange public API key..." class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                </div>
                <div>
                    <label class="block text-2xs font-bold text-slate-500 uppercase tracking-wider mb-1">Private API Secret</label>
                    <input type="password" name="apiSecret" placeholder="Paste your exchange private secret..." class="w-full text-xs font-mono rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2" required />
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-lock"></i> ENCRYPT WITH AES-GCM-256 &amp; SAVE
                </button>
            </div>
        </form>
    </div>

    <!-- Registered Exchanges Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-server text-purple-500"></i> Registered Exchange Gateways (@(Model?.Count ?? 0))
            </h3>
            <span class="text-2xs font-mono text-emerald-500 font-semibold"><i class="fa-solid fa-shield"></i> AES-GCM-256 Guard Active</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-500 text-[11px] font-bold uppercase">
                        <th class="py-3 px-4">Exchange</th>
                        <th class="py-3 px-4">Masked Key</th>
                        <th class="py-3 px-4 text-center">Environment</th>
                        <th class="py-3 px-4 text-center">Withdrawal Scope</th>
                        <th class="py-3 px-4">Security / Handshake Status</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-mono">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var key in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-3 px-4 font-bold text-slate-800 dark:text-white font-sans">@key.Exchange</td>
                                <td class="py-3 px-4 text-slate-600 dark:text-slate-300">
                                    @(string.IsNullOrWhiteSpace(key.ApiKeyMasked) ? "••••••••••••" : key.ApiKeyMasked)
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold @(key.IsTestnet ? "bg-purple-100 text-purple-600 dark:bg-purple-900/40 dark:text-purple-300" : "bg-amber-100 text-amber-600 dark:bg-amber-900/40 dark:text-amber-300")">
                                        @(key.IsTestnet ? "Testnet" : "Production")
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center font-sans">
                                    <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                                        <i class="fa-solid fa-ban text-[9px] mr-1"></i> Forbidden (Safe)
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-2xs font-sans text-slate-500 dark:text-slate-400">
                                    <span class="flex items-center gap-1.5 font-mono text-emerald-600 dark:text-emerald-400 font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        @(key.ConnectionStatusMessage ?? "AES-GCM-256 Ready")
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right font-sans">
                                    <form asp-action="TestConnection" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="exchange" value="@key.Exchange" />
                                        <button type="submit" class="px-2.5 py-1 text-2xs font-bold rounded-lg bg-slate-100 hover:bg-emerald-50 text-slate-700 hover:text-emerald-600 dark:bg-slate-700 dark:text-slate-200 transition-colors">
                                            <i class="fa-solid fa-handshake mr-1"></i> Test Handshake
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
