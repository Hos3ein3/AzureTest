@model CryptoTaxReportDto
@{
    ViewData["Title"] = $"Dutch Box 3 & EU MiCA Tax Valuation ({Model?.TaxYear ?? 2026})";
    var year = Model?.TaxYear ?? 2026;
    var items = Model?.Items ?? Array.Empty<CryptoTaxItemDto>();
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl font-bold">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-slate-800 dark:text-white">Dutch Box 3 &amp; EU MiCA Tax Compliance</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-2xs font-bold uppercase tracking-wider bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
                            Feature 8.2
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Belastingdienst compliant Box 3 valuation (Peildatum 1 januari 00:00 CET) &bull; Audit-ready transaction ledger
                    </p>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Year Selector -->
            <form method="get" asp-action="TaxReport" class="flex items-center gap-2">
                <select name="taxYear" onchange="this.form.submit()" class="text-xs font-mono font-bold rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-2">
                    @for (int y = 2026; y >= 2022; y--)
                    {
                        <option value="@y" selected="@(y == year)">Tax Year @y</option>
                    }
                </select>
            </form>

            <!-- Export Audit CSV Button -->
            <a asp-action="ExportTaxCsv" asp-route-taxYear="@year" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors flex items-center gap-1.5 shadow-xs">
                <i class="fa-solid fa-file-csv"></i> Download Audit CSV
            </a>

            <!-- Print / PDF Button -->
            <button type="button" onclick="window.print()" class="px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-semibold transition-colors flex items-center gap-1.5">
                <i class="fa-solid fa-print"></i> Print Report
            </button>
        </div>
    </div>

    <!-- Dutch Tax Authority (Belastingdienst) Guidance Alert -->
    <div class="p-5 rounded-2xl bg-blue-50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-900/50 flex items-start gap-4">
        <div class="p-2 rounded-xl bg-blue-500/20 text-blue-600 text-lg shrink-0">
            <i class="fa-solid fa-landmark"></i>
        </div>
        <div class="space-y-1.5">
            <h3 class="text-xs font-bold text-blue-900 dark:text-blue-200 uppercase tracking-wider">
                Belastingdienst Netherlands: Box 3 Wealth Tax Statutory Rules
            </h3>
            <p class="text-xs text-blue-800 dark:text-blue-300 leading-relaxed">
                In the Netherlands, cryptocurrencies are classified as <em>"overige bezittingen"</em> (other assets) in <strong>Box 3</strong>. You are taxed not on your individual daily trading profits or capital gains, but on a statutory deemed return (<em>forfaitair rendement</em> of <strong>@(Model?.DeemedYieldPercent.ToString("F2") ?? "6.04")%</strong>) applied to your total cryptocurrency portfolio value on the reference date (<strong>Peildatum: 1 januari 00:00 CET</strong>).
            </p>
            <div class="text-2xs text-blue-700 dark:text-blue-400 font-medium">
                @Model?.DutchTaxBox3Guidance
            </div>
        </div>
    </div>

    <!-- Box 3 Calculation Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Peildatum Valuation -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Jan 1st Peildatum Value</span>
                <span class="p-2 rounded-xl bg-blue-500/10 text-blue-500 text-xs"><i class="fa-solid fa-calendar-check"></i></span>
            </div>
            <div class="mt-2 text-2xl font-bold font-mono text-slate-800 dark:text-white">
                €@(Model?.EstimatedBox3ValuationJan1stEur.ToString("N2") ?? "0.00")
            </div>
            <div class="mt-1 text-2xs text-slate-400">Fair market value 1 jan 00:00 CET</div>
        </div>

        <!-- Heffingvrij Vermogen -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Heffingvrij Vermogen</span>
                <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-500 text-xs"><i class="fa-solid fa-shield-heart"></i></span>
            </div>
            <div class="mt-2 text-2xl font-bold font-mono text-emerald-500">
                €@(Model?.TaxFreeAllowanceEur.ToString("N0") ?? "57,000")
            </div>
            <div class="mt-1 text-2xs text-slate-400">Standard single tax-free threshold</div>
        </div>

        <!-- Taxable Box 3 Base -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Taxable Box 3 Base</span>
                <span class="p-2 rounded-xl bg-purple-500/10 text-purple-500 text-xs"><i class="fa-solid fa-scale-balanced"></i></span>
            </div>
            <div class="mt-2 text-2xl font-bold font-mono text-purple-600 dark:text-purple-400">
                €@(Model?.TaxableBox3WealthEur.ToString("N2") ?? "0.00")
            </div>
            <div class="mt-1 text-2xs text-slate-400">Excess over €57k threshold</div>
        </div>

        <!-- Estimated Box 3 Tax -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500">Estimated Box 3 Tax</span>
                <span class="p-2 rounded-xl bg-rose-500/10 text-rose-500 text-xs"><i class="fa-solid fa-receipt"></i></span>
            </div>
            <div class="mt-2 text-2xl font-bold font-mono text-slate-800 dark:text-white">
                €@(Model?.EstimatedBox3TaxPayableEur.ToString("N2") ?? "0.00")
            </div>
            <div class="mt-1 text-2xs text-slate-400">@(Model?.DeemedYieldPercent.ToString("F2") ?? "6.04")% deemed return &times; 36% tax rate</div>
        </div>
    </div>

    <!-- Annual Trading Volume & Realized PnL Strip -->
    <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-4 text-xs">
        <div>
            <span class="text-slate-400 uppercase font-semibold text-2xs block">Annual Transactional Turnover</span>
            <span class="font-mono font-bold text-slate-800 dark:text-white text-base">€@(Model?.TotalVolumeEur.ToString("N2") ?? "0.00")</span>
            <span class="text-2xs text-slate-400 block mt-0.5">Across @(Model?.TotalTradesCount ?? 0) completed fills</span>
        </div>
        <div>
            <span class="text-slate-400 uppercase font-semibold text-2xs block">Realized Capital Gain / Loss</span>
            <span class="font-mono font-bold text-emerald-500 text-base">+€@(Model?.TotalRealizedPnlEur.ToString("N2") ?? "0.00")</span>
            <span class="text-2xs text-slate-400 block mt-0.5">Reported for MiCA audit verification</span>
        </div>
        <div>
            <span class="text-slate-400 uppercase font-semibold text-2xs block">Regulatory Standard</span>
            <span class="font-bold text-blue-500 flex items-center gap-1 mt-0.5">
                <i class="fa-solid fa-stamp"></i> EU MiCA &amp; Dutch AFM Compliant
            </span>
            <span class="text-2xs text-slate-400 block mt-0.5">Segregated trade recordkeeping</span>
        </div>
    </div>

    <!-- Audit-Ready Trade Transaction Ledger (MiCA Compliant) -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-table-list text-blue-500"></i> Audit-Ready Transaction Ledger (MiCA Article 68 Compliant)
            </h3>
            <span class="text-2xs font-mono text-slate-400">@items.Count Transaction Records</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
                <thead class="text-2xs uppercase tracking-wider text-slate-400 bg-slate-50 dark:bg-slate-700/50">
                    <tr>
                        <th class="py-3 px-4 rounded-l-xl">Date / Time (UTC)</th>
                        <th class="py-3 px-3">Asset</th>
                        <th class="py-3 px-3">Action</th>
                        <th class="py-3 px-3">Quantity</th>
                        <th class="py-3 px-3">Unit Price (EUR)</th>
                        <th class="py-3 px-3">Gross Total (EUR)</th>
                        <th class="py-3 px-4 text-right rounded-r-xl">Realized P&amp;L (EUR)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-400 text-xs">
                                No tax transactions recorded for tax year @year.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var it in items)
                        {
                            var isGain = it.RealizedGainLossEur >= 0;
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
                                <td class="py-3 px-4 font-mono text-2xs text-slate-500 dark:text-slate-400">
                                    @it.Date.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td class="py-3 px-3 font-mono font-bold text-slate-800 dark:text-white">@it.Symbol</td>
                                <td class="py-3 px-3">
                                    <span class="text-2xs font-bold px-2 py-0.5 rounded-full @(it.Action.Contains("BUY") ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50" : "bg-blue-50 text-blue-600 dark:bg-blue-950/50")">
                                        @it.Action
                                    </span>
                                </td>
                                <td class="py-3 px-3 font-mono">@it.Quantity.ToString("F4")</td>
                                <td class="py-3 px-3 font-mono">€@it.PriceEur.ToString("N2")</td>
                                <td class="py-3 px-3 font-mono font-bold text-slate-800 dark:text-white">€@it.TotalValueEur.ToString("N2")</td>
                                <td class="py-3 px-4 font-mono text-right font-bold @(isGain ? "text-emerald-500" : "text-rose-500")">
                                    @(isGain ? "+" : "")€@it.RealizedGainLossEur.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
