@model CryptoMarketStructureDto
@{
    var symbol = ViewBag.Symbol as string ?? "BTCUSDT";
    var timeframe = ViewBag.Timeframe is CryptoTimeframe tf ? tf : CryptoTimeframe.H1;
    ViewData["Title"] = $"{symbol} ICT / SMC Market Structure";

    var isBullish = Model?.CurrentTrend.Contains("Bullish") ?? false;
    var isBearish = Model?.CurrentTrend.Contains("Bearish") ?? false;
    var isOte = Model?.CurrentZone.Contains("OTE") ?? false;
    var isDiscount = Model?.CurrentZone.Contains("Discount") ?? false;
    var isPremium = Model?.CurrentZone.Contains("Premium") ?? false;
}

<div class="space-y-6">
    <!-- Header with Sub-Navigation -->
    <div class="flex flex-col gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-violet-500/10 text-violet-500 flex items-center justify-center text-lg font-bold">
                        <i class="fa-solid fa-shapes"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-xl font-bold text-slate-800 dark:text-white">@symbol ICT / SMC Market Structure</h1>
                            <span class="px-2 py-0.5 rounded-md text-2xs font-bold bg-violet-500/10 text-violet-500">@timeframe</span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Smart Money Concepts: Order Blocks, Fair Value Gaps, Liquidity Sweeps, BOS & CHoCH</p>
                    </div>
                </div>
            </div>

            <!-- Timeframe & Symbol Picker -->
            <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-700/60 p-1 rounded-xl">
                    @foreach (var s in new[] { "BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT" })
                    {
                        <a asp-action="MarketStructure" asp-route-symbol="@s" asp-route-timeframe="@timeframe" class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors @(s == symbol ? "bg-white dark:bg-slate-800 text-violet-600 shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-800")">
                            @s.Replace("USDT", "")
                        </a>
                    }
                </div>
                <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-700/60 p-1 rounded-xl">
                    @foreach (CryptoTimeframe tfVal in Enum.GetValues(typeof(CryptoTimeframe)))
                    {
                        <a asp-action="MarketStructure" asp-route-symbol="@symbol" asp-route-timeframe="@tfVal" class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors @(tfVal == timeframe ? "bg-white dark:bg-slate-800 text-violet-600 shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-800")">
                            @tfVal
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Navigation Tabs across Analysis modules -->
        <div class="flex items-center gap-2 border-t border-slate-100 dark:border-slate-700/60 pt-4 overflow-x-auto text-xs font-semibold">
            <a asp-action="Index" asp-route-symbol="@symbol" asp-route-timeframe="@timeframe" class="px-3 py-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="fa-solid fa-chart-line mr-1 text-slate-400"></i> Technicals
            </a>
            <a asp-action="MarketStructure" asp-route-symbol="@symbol" asp-route-timeframe="@timeframe" class="px-3 py-1.5 rounded-xl bg-violet-600 text-white shadow-xs">
                <i class="fa-solid fa-shapes mr-1"></i> ICT / SMC Structure
            </a>
            <a asp-action="VolumeProfile" asp-route-symbol="@symbol" asp-route-timeframe="@timeframe" class="px-3 py-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="fa-solid fa-bars-staggered mr-1 text-slate-400"></i> Volume Profile (VPVR) & AVWAP
            </a>
            <a asp-action="MarketRegime" asp-route-symbol="@symbol" asp-route-timeframe="@timeframe" class="px-3 py-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="fa-solid fa-compass mr-1 text-slate-400"></i> Market Regime & Quant
            </a>
            <a asp-action="Sentiment" class="px-3 py-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="fa-solid fa-gauge-high mr-1 text-slate-400"></i> Sentiment & News
            </a>
            <a asp-action="Screener" class="px-3 py-1.5 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="fa-solid fa-filter mr-1 text-slate-400"></i> Screener
            </a>
        </div>
    </div>

    <!-- SMC Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Trend & Structure -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
                <span>Structure Trend</span>
                <i class="fa-solid @(isBullish ? "fa-arrow-trend-up text-emerald-500" : isBearish ? "fa-arrow-trend-down text-rose-500" : "fa-arrows-left-right text-amber-500")"></i>
            </div>
            <div class="mt-2 text-lg font-bold @(isBullish ? "text-emerald-500" : isBearish ? "text-rose-500" : "text-amber-500")">
                @(Model?.CurrentTrend ?? "Consolidation")
            </div>
            <div class="mt-1 text-2xs text-slate-500 dark:text-slate-400">
                Highs/Lows structural sequence
            </div>
        </div>

        <!-- Last Break -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
                <span>Last Break Type</span>
                <i class="fa-solid fa-bolt text-amber-500"></i>
            </div>
            <div class="mt-2 text-lg font-bold text-slate-800 dark:text-white">
                @(Model?.LastBreakType ?? "BOS")
            </div>
            <div class="mt-1 text-2xs text-slate-500 dark:text-slate-400">
                Breach Level: $@Model?.LastBreakPrice.ToString("N2")
            </div>
        </div>

        <!-- Price Zone -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
                <span>Current Price Zone</span>
                <i class="fa-solid fa-crosshairs text-violet-500"></i>
            </div>
            <div class="mt-2 text-sm font-bold @(isOte ? "text-violet-500" : isDiscount ? "text-emerald-500" : isPremium ? "text-rose-500" : "text-amber-500")">
                @(Model?.CurrentZone ?? "Equilibrium")
            </div>
            <div class="mt-1 text-2xs text-slate-500 dark:text-slate-400">
                Eq (50%): $@Model?.EquilibriumPrice.ToString("N2")
            </div>
        </div>

        <!-- SMC Trade Bias -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
                <span>SMC Institutional Bias</span>
                <i class="fa-solid fa-fingerprint text-brand-500"></i>
            </div>
            <div class="mt-2 text-sm font-bold text-slate-800 dark:text-white truncate" title="@Model?.SmcTradeBias">
                @(Model?.SmcTradeBias ?? "Neutral")
            </div>
            <div class="mt-1 text-2xs text-slate-500 dark:text-slate-400">
                Updated: @Model?.LastUpdatedUtc.ToString("HH:mm:ss") UTC
            </div>
        </div>
    </div>

    <!-- Dealing Range / Equilibrium / OTE Visualizer -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-violet-500"></i> Dealing Range & Premium / Discount Matrix
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">Institutional order execution occurs in Discount (<50%) for long accumulation and Premium (>50%) for short distribution.</p>
            </div>
        </div>

        @if (Model != null)
        {
            var range = Math.Max(0.0001m, Model.RecentSwingHigh - Model.RecentSwingLow);
            var ote618 = Model.RecentSwingLow + (range * 0.618m);
            var ote786 = Model.RecentSwingLow + (range * 0.786m);

            <div class="relative bg-slate-50 dark:bg-slate-900/60 p-6 rounded-xl border border-slate-200 dark:border-slate-700">
                <div class="space-y-4">
                    <!-- Swing High (Premium Extreme) -->
                    <div class="flex items-center justify-between text-xs border-b border-rose-500/20 pb-2">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-500 font-bold">100.0%</span>
                            <span class="font-bold text-rose-500">Recent Swing High (Buy-Side Liquidity BSL)</span>
                        </div>
                        <span class="font-mono font-bold text-slate-800 dark:text-white">$@Model.RecentSwingHigh.ToString("N2")</span>
                    </div>

                    <!-- Premium Zone -->
                    <div class="flex items-center justify-between text-2xs text-slate-400 pl-4">
                        <span>PREMIUM ZONE (Distribution / Look for Bearish Order Block Rejections)</span>
                    </div>

                    <!-- Equilibrium (50%) -->
                    <div class="flex items-center justify-between text-xs border-y border-dashed border-amber-500/40 py-2 bg-amber-500/5 px-2 rounded-lg">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 font-bold">50.0%</span>
                            <span class="font-bold text-amber-500">Equilibrium (Fair Value Midpoint)</span>
                        </div>
                        <span class="font-mono font-bold text-amber-500">$@Model.EquilibriumPrice.ToString("N2")</span>
                    </div>

                    <!-- Optimal Trade Entry (OTE 61.8% - 78.6%) -->
                    <div class="bg-violet-500/10 border border-violet-500/30 p-3 rounded-xl flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded bg-violet-600 text-white font-bold text-2xs">OTE</span>
                            <div>
                                <span class="font-bold text-violet-400">Optimal Trade Entry Zone (61.8% – 78.6% Fib)</span>
                                <div class="text-2xs text-slate-400">High-probability institutional institutional entry bracket</div>
                            </div>
                        </div>
                        <span class="font-mono font-bold text-violet-400">$@ote618.ToString("N2") – $@ote786.ToString("N2")</span>
                    </div>

                    <!-- Discount Zone -->
                    <div class="flex items-center justify-between text-2xs text-slate-400 pl-4">
                        <span>DISCOUNT ZONE (Accumulation / Look for Bullish Order Block Entries)</span>
                    </div>

                    <!-- Swing Low (Discount Extreme) -->
                    <div class="flex items-center justify-between text-xs border-t border-emerald-500/20 pt-2">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">0.0%</span>
                            <span class="font-bold text-emerald-500">Recent Swing Low (Sell-Side Liquidity SSL)</span>
                        </div>
                        <span class="font-mono font-bold text-slate-800 dark:text-white">$@Model.RecentSwingLow.ToString("N2")</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Order Blocks (+OB & -OB) and Fair Value Gaps (FVG) Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Order Blocks Table -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-cube text-brand-500"></i> Institutional Order Blocks (OB)
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Last opposing candle before displacement. Mean Threshold (50%) is the key reaction level.</p>
                    </div>
                    <span class="px-2 py-1 rounded-lg text-2xs font-bold bg-slate-100 dark:bg-slate-700 text-slate-500">
                        @(Model?.OrderBlocks.Count ?? 0) Active
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-700 text-2xs uppercase tracking-wider text-slate-400 font-bold">
                                <th class="pb-3">Type</th>
                                <th class="pb-3">Zone (Bottom - Top)</th>
                                <th class="pb-3">Mean Threshold</th>
                                <th class="pb-3">Strength</th>
                                <th class="pb-3 text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 text-xs font-medium">
                            @if (Model?.OrderBlocks != null && Model.OrderBlocks.Any())
                            {
                                @foreach (var ob in Model.OrderBlocks)
                                {
                                    var isBullOb = ob.Type.Contains("Bullish");
                                    <tr>
                                        <td class="py-3">
                                            <span class="px-2 py-0.5 rounded text-2xs font-bold @(isBullOb ? "bg-emerald-500/10 text-emerald-500" : "bg-rose-500/10 text-rose-500")">
                                                @(isBullOb ? "+OB" : "-OB")
                                            </span>
                                        </td>
                                        <td class="py-3 font-mono text-slate-800 dark:text-white">
                                            $@ob.BottomPrice.ToString("N2") – $@ob.TopPrice.ToString("N2")
                                        </td>
                                        <td class="py-3 font-mono text-slate-600 dark:text-slate-300">
                                            $@ob.MeanThreshold.ToString("N2")
                                        </td>
                                        <td class="py-3 font-semibold text-slate-800 dark:text-white">
                                            @ob.StrengthScore%
                                        </td>
                                        <td class="py-3 text-right">
                                            @if (ob.IsMitigated)
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-slate-100 dark:bg-slate-700 text-slate-400">
                                                    Mitigated
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-amber-500/10 text-amber-500">
                                                    Untapped (Prime)
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-slate-400">No active order blocks detected on visible candles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Fair Value Gaps Table -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-water text-violet-500"></i> Fair Value Gaps (FVG Imbalances)
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Three-candle price inefficiencies (BISI / SIBI). Consequent Encroachment (C.E.) is 50% midpoint.</p>
                    </div>
                    <span class="px-2 py-1 rounded-lg text-2xs font-bold bg-slate-100 dark:bg-slate-700 text-slate-500">
                        @(Model?.FairValueGaps.Count ?? 0) Active
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-700 text-2xs uppercase tracking-wider text-slate-400 font-bold">
                                <th class="pb-3">Type</th>
                                <th class="pb-3">Gap Range</th>
                                <th class="pb-3">C.E. (50%)</th>
                                <th class="pb-3">Fill %</th>
                                <th class="pb-3 text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 text-xs font-medium">
                            @if (Model?.FairValueGaps != null && Model.FairValueGaps.Any())
                            {
                                @foreach (var fvg in Model.FairValueGaps)
                                {
                                    var isBisi = fvg.Type.Contains("Bullish") || fvg.Type.Contains("BISI");
                                    <tr>
                                        <td class="py-3">
                                            <span class="px-2 py-0.5 rounded text-2xs font-bold @(isBisi ? "bg-emerald-500/10 text-emerald-500" : "bg-rose-500/10 text-rose-500")">
                                                @(isBisi ? "BISI (Bull)" : "SIBI (Bear)")
                                            </span>
                                        </td>
                                        <td class="py-3 font-mono text-slate-800 dark:text-white">
                                            $@fvg.BottomPrice.ToString("N2") – $@fvg.TopPrice.ToString("N2")
                                        </td>
                                        <td class="py-3 font-mono text-slate-600 dark:text-slate-300">
                                            $@fvg.ConsequentEncroachment.ToString("N2")
                                        </td>
                                        <td class="py-3">
                                            <div class="flex items-center gap-2">
                                                <div class="w-16 bg-slate-100 dark:bg-slate-700 rounded-full h-1.5 overflow-hidden">
                                                    <div class="bg-violet-500 h-1.5 rounded-full" style="width: @fvg.PercentFilled%"></div>
                                                </div>
                                                <span class="font-mono text-2xs text-slate-500">@fvg.PercentFilled%</span>
                                            </div>
                                        </td>
                                        <td class="py-3 text-right">
                                            @if (fvg.IsFilled)
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-slate-100 dark:bg-slate-700 text-slate-400">
                                                    Filled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-2xs font-bold bg-emerald-500/10 text-emerald-500">
                                                    Open Void
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-slate-400">No active fair value gaps detected on visible candles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Liquidity Pools & Sweeps -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-sm font-bold text-slate-800 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-magnet text-amber-500"></i> Liquidity Pools & Stop Hunt Radar
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">Buy-Side Liquidity (BSL) above swing highs and Sell-Side Liquidity (SSL) below swing lows acted as magnets for institutional liquidity engineering.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            @if (Model?.LiquidityPools != null)
            {
                @foreach (var pool in Model.LiquidityPools)
                {
                    var isBsl = pool.Type.Contains("Buy-Side") || pool.Type.Contains("BSL");
                    var isSwept = pool.Status.Contains("Swept");
                    <div class="p-4 rounded-xl border @(isSwept ? "border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40" : isBsl ? "border-rose-500/20 bg-rose-500/5" : "border-emerald-500/20 bg-emerald-500/5")">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded text-2xs font-bold @(isBsl ? "bg-rose-500/10 text-rose-500" : "bg-emerald-500/10 text-emerald-500")">
                                @(isBsl ? "BSL (Buy Stops)" : "SSL (Sell Stops)")
                            </span>
                            <span class="text-2xs font-bold @(isSwept ? "text-slate-400" : "text-amber-500")">
                                @pool.Status
                            </span>
                        </div>
                        <div class="mt-3 text-lg font-mono font-bold text-slate-800 dark:text-white">
                            $@pool.PriceLevel.ToString("N2")
                        </div>
                        <div class="mt-1 text-2xs text-slate-500 flex items-center justify-between">
                            <span>Est. Pool Size:</span>
                            <span class="font-bold text-slate-700 dark:text-slate-300">$@pool.EstimatedVolumeUsd.ToString("N0")</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
