@model CryptoMarketOverviewDto
@{
    ViewData["Title"] = "Crypto Market Overview";
    var filter = ViewBag.Filter as CryptoMarketFilter ?? new CryptoMarketFilter();
}

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl font-bold">
                    <i class="fa-brands fa-bitcoin"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800 dark:text-white">Cryptocurrency Markets</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Live prices from Binance Public API, CoinLore, and DIA feeds (No API key required)</p>
                </div>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-xs transition-colors">
                <i class="fa-solid fa-bolt"></i> Trading Terminal
            </a>
            <a asp-area="Crypto" asp-controller="CryptoAnalysis" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors">
                <i class="fa-solid fa-chart-line"></i> Technical Analysis
            </a>
            <a asp-area="Crypto" asp-controller="CryptoMarket" asp-action="Futures" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-xl transition-colors">
                <i class="fa-solid fa-scale-balanced"></i> Futures &amp; Funding
            </a>
        </div>
    </div>

    <!-- Market High-Level Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Market Cap -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Total Crypto Market Cap</span>
                <span class="p-2 rounded-xl bg-blue-500/10 text-blue-500 text-xs"><i class="fa-solid fa-coins"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold text-slate-800 dark:text-white">
                $@(Model.TotalMarketCapUsd.ToString("N0"))
            </div>
            <div class="mt-1 text-2xs text-slate-400">Global aggregate market valuation</div>
        </div>

        <!-- 24h Volume -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">24h Global Volume</span>
                <span class="p-2 rounded-xl bg-purple-500/10 text-purple-500 text-xs"><i class="fa-solid fa-chart-column"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold text-slate-800 dark:text-white">
                $@(Model.Total24hVolumeUsd.ToString("N0"))
            </div>
            <div class="mt-1 text-2xs text-slate-400">Aggregate volume across exchanges</div>
        </div>

        <!-- Bitcoin Dominance -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">BTC Dominance</span>
                <span class="p-2 rounded-xl bg-amber-500/10 text-amber-500 text-xs"><i class="fa-brands fa-btc"></i></span>
            </div>
            <div class="mt-2 text-xl font-bold text-slate-800 dark:text-white">
                @(Model.BtcDominance.ToString("F1"))%
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-700 h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-amber-500 h-full rounded-full" style="width: @(Model.BtcDominance)%"></div>
            </div>
        </div>

        <!-- Fear & Greed Index -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Fear &amp; Greed Index</span>
                <span class="p-2 rounded-xl bg-rose-500/10 text-rose-500 text-xs"><i class="fa-solid fa-gauge-high"></i></span>
            </div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-xl font-bold @(Model.FearAndGreedIndex >= 55 ? "text-emerald-500" : Model.FearAndGreedIndex <= 45 ? "text-rose-500" : "text-amber-500")">
                    @Model.FearAndGreedIndex
                </span>
                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">/ 100</span>
                <span class="ml-auto px-2 py-0.5 rounded-md text-2xs font-bold @(Model.FearAndGreedIndex >= 55 ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-600" : Model.FearAndGreedIndex <= 45 ? "bg-rose-100 dark:bg-rose-950 text-rose-600" : "bg-amber-100 dark:bg-amber-950 text-amber-600")">
                    @Model.SentimentLabel
                </span>
            </div>
            <div class="mt-1 text-2xs text-slate-400">Alternative.me free sentiment feed</div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <form method="get" asp-action="Index" class="flex flex-wrap items-center gap-2">
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
                <input type="text" name="Search" value="@filter.Search" placeholder="Search coin or symbol (e.g. BTC, ETH)..." class="pl-8 pr-3 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-brand-500" />
            </div>
            <select name="SortBy" class="text-xs rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-800 dark:text-white px-3 py-1.5">
                <option value="Rank" selected="@(filter.SortBy == "Rank")">Sort by Rank</option>
                <option value="Price" selected="@(filter.SortBy == "Price")">Sort by Price</option>
                <option value="Change24h" selected="@(filter.SortBy == "Change24h")">Sort by 24h Change</option>
                <option value="Volume24h" selected="@(filter.SortBy == "Volume24h")">Sort by 24h Volume</option>
            </select>
            <button type="submit" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-colors">
                Apply Filter
            </button>
            @if (!string.IsNullOrEmpty(filter.Search))
            {
                <a asp-action="Index" class="px-3 py-1.5 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-xs font-medium hover:bg-slate-200">Reset</a>
            }
        </form>

        <div class="text-2xs text-slate-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Updated @Model.LastUpdatedUtc.ToString("HH:mm:ss") UTC
        </div>
    </div>

    <!-- Main Coin Table -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                        <th class="py-3.5 px-4 w-12 text-center">#</th>
                        <th class="py-3.5 px-4">Coin</th>
                        <th class="py-3.5 px-4 text-right">Price (USD)</th>
                        <th class="py-3.5 px-4 text-right">24h Change</th>
                        <th class="py-3.5 px-4 text-right">24h Range</th>
                        <th class="py-3.5 px-4 text-right">24h Volume</th>
                        <th class="py-3.5 px-4 text-right">Market Cap</th>
                        <th class="py-3.5 px-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 text-xs">
                    @if (Model.Coins != null && Model.Coins.Any())
                    {
                        foreach (var coin in Model.Coins)
                        {
                            var isPositive = coin.Change24h >= 0;
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750/50 transition-colors">
                                <td class="py-3.5 px-4 text-center font-medium text-slate-400">@coin.Rank</td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center font-bold text-2xs text-slate-700 dark:text-slate-300">
                                            @coin.Symbol.Substring(0, Math.Min(3, coin.Symbol.Length))
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-800 dark:text-white">@coin.Name</div>
                                            <div class="text-2xs text-slate-400">@coin.Symbol</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono font-bold text-slate-800 dark:text-white">
                                    $@(coin.Price > 1m ? coin.Price.ToString("N2") : coin.Price.ToString("0.0000"))
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <span class="inline-flex items-center gap-1 font-semibold text-2xs px-2 py-0.5 rounded-md @(isPositive ? "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400" : "bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400")">
                                        <i class="fa-solid @(isPositive ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                                        @(isPositive ? "+" : "")@(coin.Change24h.ToString("F2"))%
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono text-2xs text-slate-500 dark:text-slate-400">
                                    $@coin.Low24h.ToString("0.00") - $@coin.High24h.ToString("0.00")
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono text-slate-600 dark:text-slate-300">
                                    $@(coin.Volume24h.ToString("N0"))
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono text-slate-600 dark:text-slate-300">
                                    $@(coin.MarketCap.ToString("N0"))
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <a asp-action="Chart" asp-route-symbol="@(coin.Symbol.EndsWith("USDT") ? coin.Symbol : coin.Symbol + "USDT")" title="View Candlestick Chart" class="p-1.5 rounded-lg text-slate-400 hover:text-brand-500 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                            <i class="fa-solid fa-chart-candlestick"></i>
                                        </a>
                                        <a asp-action="OrderBook" asp-route-symbol="@(coin.Symbol.EndsWith("USDT") ? coin.Symbol : coin.Symbol + "USDT")" title="View Order Book Ladder" class="p-1.5 rounded-lg text-slate-400 hover:text-purple-500 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                            <i class="fa-solid fa-layer-group"></i>
                                        </a>
                                        <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" asp-route-symbol="@(coin.Symbol.EndsWith("USDT") ? coin.Symbol : coin.Symbol + "USDT")" title="Open Trading Ticket" class="px-2 py-1 rounded-lg text-2xs font-semibold bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500 hover:text-white transition-colors">
                                            Trade
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-8 text-center text-slate-400">
                                No coins matching the selected criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
