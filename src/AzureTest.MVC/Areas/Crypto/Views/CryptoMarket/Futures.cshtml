@model CryptoDerivativesHubDto
@{
    var symbol = Model?.Symbol ?? "BTCUSDT";
    ViewData["Title"] = $"{symbol} Derivatives, Liquidations & Options Hub";

    var funding = Model?.Funding;
    var lsRatio = Model?.LongShortRatio;
    var liqMap = Model?.LiquidationMap;
    var options = Model?.Options;
    var curve = Model?.Curve;

    var fundingRate = funding?.FundingRate ?? 0.0001m;
    var isPositiveFunding = fundingRate >= 0;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="w-11 h-11 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center text-lg font-bold">
                <i class="fa-solid fa-gauge-high"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl font-black text-slate-900 dark:text-white">@symbol Derivatives &amp; Options Intelligence</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">INSTITUTIONAL</span>
                    <span class="text-sm font-mono font-bold text-slate-800 dark:text-slate-200">
                        Mark: $@(funding?.MarkPrice.ToString("N2") ?? "--")
                    </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Perpetual funding rates, Open Interest, Long/Short ratio, Liquidation heatmap, Deribit options IV/Max Pain, and Futures curve
                </p>
            </div>
        </div>

        <!-- Symbol Switcher Tabs -->
        <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-2xs font-bold text-slate-400 uppercase tracking-wider mr-1">Pairs:</span>
            @foreach (var s in new[] { "BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT", "DOGEUSDT", "XRPUSDT" })
            {
                <a asp-action="Futures" asp-route-symbol="@s"
                   class="px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors @(s == symbol ? "bg-purple-600 text-white shadow-xs" : "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200")">
                    @s.Replace("USDT", "")
                </a>
            }
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center gap-2">
            <a asp-action="OnChain" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-cubes-stacked mr-1 text-emerald-500"></i> On-Chain
            </a>
            <a asp-action="OrderFlow" asp-route-symbol="@symbol" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-water mr-1 text-amber-500"></i> Order Flow
            </a>
            <a asp-action="Chart" asp-route-symbol="@symbol" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-chart-candlestick mr-1"></i> Chart
            </a>
            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" asp-route-symbol="@symbol" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors flex items-center gap-1.5">
                <i class="fa-solid fa-bolt"></i> Trade
            </a>
        </div>
    </div>

    <!-- Educational Banner -->
    <div class="p-4 rounded-xl bg-purple-50 dark:bg-purple-950/30 border border-purple-200 dark:border-purple-900/50 flex items-start gap-3">
        <i class="fa-solid fa-circle-info text-purple-600 text-base mt-0.5"></i>
        <div class="text-xs text-purple-950 dark:text-purple-200 leading-relaxed">
            <span class="font-bold">Derivatives Microstructure:</span> Funding rates reflect perpetual swap premium over spot. When Long/Short ratios spike alongside high funding, retail crowd is overleveraged on the long side. Market makers frequently trigger cascade hunts toward <strong>dense liquidation clusters</strong> to wipe out excessive leverage before resuming structural trends.
        </div>
    </div>

    <!-- 4 Primary Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 8h Funding Rate -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">8h Funding / Annualized APR</span>
                <span class="p-2 rounded-xl bg-purple-500/10 text-purple-500 text-xs"><i class="fa-solid fa-percent"></i></span>
            </div>
            <div class="text-2xl font-black font-mono @(isPositiveFunding ? "text-emerald-500" : "text-rose-500")">
                @(isPositiveFunding ? "+" : "")@((fundingRate * 100m).ToString("F4"))%
            </div>
            <div class="text-2xs text-slate-400 flex items-center justify-between">
                <span>APR: @((funding?.EstimatedAnnualRate ?? 10.95m).ToString("F2"))%</span>
                <span>Next: @(funding?.NextFundingTimeUtc.ToString("HH:mm:ss") ?? "--:--:--") UTC</span>
            </div>
        </div>

        <!-- Open Interest -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Total Open Interest (OI)</span>
                <span class="p-2 rounded-xl bg-blue-500/10 text-blue-500 text-xs"><i class="fa-solid fa-coins"></i></span>
            </div>
            <div class="text-2xl font-black font-mono text-slate-800 dark:text-slate-200">
                $@(((funding?.OpenInterestUsd ?? 4850000000m) / 1000000000m).ToString("N2"))B
            </div>
            <div class="text-2xs text-slate-400 flex items-center justify-between">
                <span>Contracts: @((funding?.OpenInterest ?? 72000m).ToString("N0"))</span>
                <span class="text-emerald-600 font-bold">+3.2% 24h</span>
            </div>
        </div>

        <!-- Long/Short Ratio -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Global Long/Short Ratio</span>
                <span class="p-2 rounded-xl bg-amber-500/10 text-amber-500 text-xs"><i class="fa-solid fa-users"></i></span>
            </div>
            <div class="text-2xl font-black font-mono text-amber-500">
                @((lsRatio?.LongShortRatio ?? 1.21m).ToString("F2")) : 1.0
            </div>
            <div class="text-2xs text-slate-400 flex items-center justify-between">
                <span>Long: @(lsRatio?.LongAccountPercent ?? 54.8m)%</span>
                <span>Short: @(lsRatio?.ShortAccountPercent ?? 45.2m)%</span>
            </div>
        </div>

        <!-- Deribit Options IV & Max Pain -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Deribit DVol (Implied Volatility)</span>
                <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-500 text-xs"><i class="fa-solid fa-brain"></i></span>
            </div>
            <div class="text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400">
                @((options?.ImpliedVolatilityDvol ?? 52.8m).ToString("F1"))%
            </div>
            <div class="text-2xs text-slate-400 flex items-center justify-between">
                <span>Max Pain: <strong>$@((options?.MaxPainStrike ?? 65000m).ToString("N0"))</strong></span>
                <span>P/C Ratio: @((options?.PutCallRatioOi ?? 0.68m).ToString("F2"))</span>
            </div>
        </div>
    </div>

    <!-- Section 1: Liquidation Map & Live Liquidation Tape -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Liquidation Clusters Table (Map) -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-crosshairs text-rose-500"></i> Leverage Liquidation Clusters
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Estimated pool of stop-loss and forced liquidation orders at 10x to 100x leverage.
                    </p>
                </div>
                <span class="text-2xs font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">
                    Cascade Radar
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50 dark:bg-slate-900 text-slate-500 text-2xs uppercase">
                        <tr>
                            <th class="py-2 px-2.5">Leverage</th>
                            <th class="py-2 px-2.5">Liquidation Price</th>
                            <th class="py-2 px-2.5">Side</th>
                            <th class="py-2 px-2.5">Est. Pool Volume</th>
                            <th class="py-2 px-2.5">Distance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var cl in liqMap?.Clusters ?? Array.Empty<CryptoLiquidationClusterDto>())
                        {
                            var isLongLiq = cl.Side == "Long";
                            <tr>
                                <td class="py-2 px-2.5 font-bold text-slate-700 dark:text-slate-300">@cl.LeverageLevel</td>
                                <td class="py-2 px-2.5 font-bold @(isLongLiq ? "text-rose-600" : "text-emerald-600")">
                                    $@cl.PriceLevel.ToString("N2")
                                </td>
                                <td class="py-2 px-2.5">
                                    <span class="px-1.5 py-0.5 rounded text-3xs font-bold @(isLongLiq ? "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300" : "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300")">
                                        @(isLongLiq ? "LONG LIQ (BUY SL)" : "SHORT LIQ (SELL SL)")
                                    </span>
                                </td>
                                <td class="py-2 px-2.5 text-slate-800 dark:text-slate-200">$@((cl.EstimatedLiquidationUsd / 1000000m).ToString("N1"))M</td>
                                <td class="py-2 px-2.5 text-slate-500">@cl.DistancePercent.ToString("F2")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-2xs text-slate-600 dark:text-slate-400 flex justify-between">
                <span>24h Long Liquidated: <strong class="text-rose-600">$@(((liqMap?.LongLiquidations24hUsd ?? 82100000m) / 1000000m).ToString("N1"))M</strong></span>
                <span>24h Short Liquidated: <strong class="text-emerald-600">$@(((liqMap?.ShortLiquidations24hUsd ?? 66400000m) / 1000000m).ToString("N1"))M</strong></span>
            </div>
        </div>

        <!-- Live Liquidation Feed (forceOrder stream) -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-bolt-lightning text-amber-500"></i> Live Liquidation Tape (forceOrder Stream)
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Real-time exchange bankruptcy engine market fills.
                    </p>
                </div>
                <span class="flex items-center gap-1.5 text-2xs font-bold text-rose-600 animate-pulse">
                    <span class="w-2 h-2 rounded-full bg-rose-600"></span> LIVE
                </span>
            </div>

            <div class="space-y-2 font-mono text-xs">
                @foreach (var ord in liqMap?.LiveFeed ?? Array.Empty<CryptoLiquidationOrderDto>())
                {
                    var isBuy = ord.Side == "BUY";
                    <div class="flex items-center justify-between p-2.5 rounded-xl border border-slate-100 dark:border-slate-700/60 bg-slate-50 dark:bg-slate-900">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded text-3xs font-bold @(isBuy ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300" : "bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300")">
                                @ord.Side
                            </span>
                            <span class="font-bold text-slate-800 dark:text-slate-200">@ord.Symbol</span>
                            <span class="text-slate-400 text-2xs">@ord.Time.ToString("HH:mm:ss")</span>
                        </div>
                        <div class="text-right">
                            <span class="font-bold text-slate-900 dark:text-white">$@ord.Price.ToString("N2")</span>
                            <span class="text-2xs text-slate-400 ml-2">(@ord.Quantity.ToString("F2") = $@ord.TotalUsd.ToString("N0"))</span>
                        </div>
                    </div>
                }
            </div>

            <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 text-2xs text-amber-900 dark:text-amber-300">
                <i class="fa-solid fa-triangle-exclamation mr-1 text-amber-600"></i>
                <strong>Trader Note:</strong> When large liquidations cluster within a 60-second window, volatility expands exponentially. Avoid market orders during active cascades due to slippage.
            </div>
        </div>
    </div>

    <!-- Section 2: Options Intelligence (Deribit) & Basis Term Structure -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Deribit Options Market Intelligence -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-emerald-500"></i> Deribit Options Surface &amp; Max Pain
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Implied volatility, Put/Call ratios, and strike pin risk.
                    </p>
                </div>
                <span class="px-2 py-0.5 rounded text-2xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                    Deribit Public API
                </span>
            </div>

            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-1">
                    <span class="text-slate-400 text-2xs block">Max Pain Strike Price</span>
                    <span class="text-lg font-bold font-mono text-emerald-600">$@((options?.MaxPainStrike ?? 65000m).ToString("N0"))</span>
                    <p class="text-3xs text-slate-500">Price where option holders lose the most at Friday expiry.</p>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-1">
                    <span class="text-slate-400 text-2xs block">25-Delta Risk Reversal Skew</span>
                    <span class="text-lg font-bold font-mono text-purple-600">+@((options?.Skew25Delta ?? 1.8m).ToString("F1"))%</span>
                    <p class="text-3xs text-slate-500">Positive skew indicates traders pay premium for downside put hedges.</p>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-1">
                    <span class="text-slate-400 text-2xs block">Put/Call Open Interest Ratio</span>
                    <span class="text-lg font-bold font-mono text-slate-800 dark:text-slate-200">@((options?.PutCallRatioOi ?? 0.68m).ToString("F2"))</span>
                    <p class="text-3xs text-slate-500">Ratio &lt; 0.70 reflects prevailing structural bullish bias.</p>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-1">
                    <span class="text-slate-400 text-2xs block">30d Volatility Premium</span>
                    <span class="text-lg font-bold font-mono text-slate-800 dark:text-slate-200">
                        IV @((options?.ImpliedVolatilityDvol ?? 52.8m).ToString("F1"))% vs HV @((options?.HistoricalVolatility30d ?? 46.5m).ToString("F1"))%
                    </span>
                    <p class="text-3xs text-slate-500">Implied Vol is priced higher than realized historical volatility.</p>
                </div>
            </div>
        </div>

        <!-- Basis & Futures Term Structure Curve -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-bezier-curve text-indigo-500"></i> Futures Term Structure &amp; Basis Curve
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Spot vs. Delivery Futures. Evaluates <strong>Contango</strong> and cash-and-carry yields.
                    </p>
                </div>
                <span class="px-2 py-0.5 rounded text-2xs font-bold bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                    Regime: @(curve?.Regime ?? "Contango")
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-50 dark:bg-slate-900 text-slate-500 text-2xs uppercase">
                        <tr>
                            <th class="py-2 px-2.5">Contract</th>
                            <th class="py-2 px-2.5">Expiry</th>
                            <th class="py-2 px-2.5">Price</th>
                            <th class="py-2 px-2.5">Basis USD (%)</th>
                            <th class="py-2 px-2.5">Annualized Yield</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var c in curve?.Contracts ?? Array.Empty<CryptoFuturesContractDto>())
                        {
                            <tr>
                                <td class="py-2.5 px-2.5 font-bold text-slate-800 dark:text-slate-200">@c.ContractName</td>
                                <td class="py-2.5 px-2.5 text-slate-500">@(c.DaysToExpiry == 0 ? "Perpetual" : $"{c.DaysToExpiry}d")</td>
                                <td class="py-2.5 px-2.5 font-bold">$@c.FuturesPrice.ToString("N2")</td>
                                <td class="py-2.5 px-2.5 text-emerald-600">
                                    +$@c.BasisUsd.ToString("N0") (@c.BasisPercent.ToString("F2")%)
                                </td>
                                <td class="py-2.5 px-2.5 font-bold text-indigo-600 dark:text-indigo-400">
                                    @c.AnnualizedYieldPercent.ToString("F2")% APR
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900 text-2xs text-blue-900 dark:text-blue-300">
                <i class="fa-solid fa-circle-check mr-1 text-blue-600"></i>
                <strong>Cash-and-Carry Arbitrage Edge:</strong> Buying spot BTC while shorting quarterly delivery futures locks in an annualized risk-free yield of <strong>@((curve?.AverageAnnualizedBasisPercent ?? 6.8m).ToString("F2"))% APR</strong> without any directional price exposure.
            </div>
        </div>
    </div>
</div>
