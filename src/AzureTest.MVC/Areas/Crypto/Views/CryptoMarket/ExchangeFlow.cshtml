@model CryptoExchangeFlowAnalysisHubDto
@{
    ViewData["Title"] = "3.1 Exchange Net Flow Analysis | Institutional Reserves";
    var exchanges = Model?.Exchanges ?? Array.Empty<CryptoExchangeDetailFlowDto>();
    var trend = Model?.HistoricalTrend ?? Array.Empty<CryptoExchangeFlowTrendPointDto>();
    var miners = Model?.MinerFlows ?? Array.Empty<CryptoMinerToExchangeFlowDto>();
    var net24h = Model?.TotalNetFlow24hUsd ?? 0m;
}

<div class="space-y-6">
    <!-- Header with Sub-Feature Navigation Bar -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs">
        <div class="flex items-center gap-3">
            <a asp-action="OnChain" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 transition-colors" title="Back to On-Chain Hub">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-lg font-bold">
                <i class="fa-solid fa-building-columns"></i>
            </div>
            <div>
                <div class="flex items-center gap-2.5">
                    <h1 class="text-xl font-black text-slate-900 dark:text-white">Exchange Net Flow Analysis</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                        FEATURE 3.1
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-3xs font-bold bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                        INSTITUTIONAL RESERVES
                    </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Real-time CEX inflows, outflows, cold custody reserves, whale deposit velocity &amp; miner-to-exchange capitulation tracking
                </p>
            </div>
        </div>

        <!-- Sub-Feature Switcher Tabs -->
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="OnChain" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-cubes-stacked mr-1"></i> Hub Overview
            </a>
            <a asp-action="ExchangeFlow" class="px-3 py-2 bg-emerald-600 text-white rounded-xl text-xs font-bold shadow-xs transition-colors">
                <i class="fa-solid fa-building-columns mr-1"></i> 3.1 Net Flows
            </a>
            <a asp-action="TokenUnlocks" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-calendar-xmark mr-1 text-rose-500"></i> 3.2 Token Unlocks
            </a>
            <a asp-action="DexScreener" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-shield-halved mr-1 text-indigo-500"></i> 3.3 DEX Rugpull
            </a>
            <a asp-area="Crypto" asp-controller="CryptoTrade" asp-action="Index" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-700 dark:hover:bg-slate-600 rounded-xl text-xs font-bold transition-colors">
                <i class="fa-solid fa-bolt mr-1 text-amber-400"></i> Trade
            </a>
        </div>
    </div>

    <!-- Educational & Institutional Macro Verdict Banner -->
    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 flex items-start gap-3">
        <i class="fa-solid fa-circle-check text-emerald-600 text-base mt-0.5"></i>
        <div class="text-xs text-emerald-950 dark:text-emerald-200 leading-relaxed">
            <span class="font-bold">Macro On-Chain Verdict:</span> @(Model?.MacroFlowVerdict ?? "Structural institutional accumulation detected. Net spot exchange outflows remove available liquidity, priming the order books for rapid supply squeeze rallies.")
        </div>
    </div>

    <!-- 4 Multi-Timeframe Flow KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1h Net Flow -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-2xs font-bold uppercase tracking-wider text-slate-400">
                <span>1-Hour Net Flow</span>
                <i class="fa-solid fa-clock text-slate-400"></i>
            </div>
            <div class="text-xl font-black font-mono @(Model?.TotalNetFlow1hUsd < 0 ? "text-emerald-500" : "text-rose-500")">
                @(Model?.TotalNetFlow1hUsd < 0 ? "-$" : "+$")@Math.Abs((Model?.TotalNetFlow1hUsd ?? 0m) / 1000000m).ToString("N1")M
            </div>
            <p class="text-3xs text-slate-400">Past 60-minute immediate velocity across CEXs</p>
        </div>

        <!-- 24h Net Flow -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-2xs font-bold uppercase tracking-wider text-slate-400">
                <span>24-Hour Net Flow</span>
                <i class="fa-solid fa-calendar-day text-emerald-500"></i>
            </div>
            <div class="text-xl font-black font-mono @(net24h < 0 ? "text-emerald-500" : "text-rose-500")">
                @(net24h < 0 ? "-$" : "+$")@Math.Abs(net24h / 1000000m).ToString("N0")M
            </div>
            <p class="text-3xs text-slate-400">Full day aggregate exchange accumulation / deposit balance</p>
        </div>

        <!-- 7-Day Net Cumulative -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-2xs font-bold uppercase tracking-wider text-slate-400">
                <span>7-Day Net Flow</span>
                <i class="fa-solid fa-calendar-week text-blue-500"></i>
            </div>
            <div class="text-xl font-black font-mono @(Model?.TotalNetFlow7dUsd < 0 ? "text-emerald-500" : "text-rose-500")">
                @(Model?.TotalNetFlow7dUsd < 0 ? "-$" : "+$")@Math.Abs((Model?.TotalNetFlow7dUsd ?? 0m) / 1000000000m).ToString("N2")B
            </div>
            <p class="text-3xs text-slate-400">Weekly sustained flow direction</p>
        </div>

        <!-- 30-Day Net Cumulative -->
        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-2">
            <div class="flex items-center justify-between text-2xs font-bold uppercase tracking-wider text-slate-400">
                <span>30-Day Net Flow</span>
                <i class="fa-solid fa-chart-line text-purple-500"></i>
            </div>
            <div class="text-xl font-black font-mono @(Model?.TotalNetFlow30dUsd < 0 ? "text-emerald-500" : "text-rose-500")">
                @(Model?.TotalNetFlow30dUsd < 0 ? "-$" : "+$")@Math.Abs((Model?.TotalNetFlow30dUsd ?? 0m) / 1000000000m).ToString("N2")B
            </div>
            <p class="text-3xs text-slate-400">Monthly institutional cold custody shift</p>
        </div>
    </div>

    <!-- Exchange Breakdown Table -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-server text-emerald-500"></i> Detailed CEX Reserves &amp; Multi-Timeframe Net Flows
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Breakdown of BTC, ETH, and Stablecoin reserves with whale deposit sizes and flow classifications
                </p>
            </div>
            <span class="px-2.5 py-1 rounded text-2xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-mono">
                7 CENTRALIZED EXCHANGES MONITORED
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
                <thead class="text-2xs text-slate-400 uppercase font-sans border-b border-slate-100 dark:border-slate-700">
                    <tr>
                        <th class="py-3 px-3">Exchange</th>
                        <th class="py-3 px-3 text-right">1h Net</th>
                        <th class="py-3 px-3 text-right">24h Inflow</th>
                        <th class="py-3 px-3 text-right">24h Outflow</th>
                        <th class="py-3 px-3 text-right">24h Net</th>
                        <th class="py-3 px-3 text-right">7d Net</th>
                        <th class="py-3 px-3 text-right">BTC Reserves</th>
                        <th class="py-3 px-3 text-right">Stable Reserves</th>
                        <th class="py-3 px-3 text-right">Mean Deposit</th>
                        <th class="py-3 px-3 text-right">Flow Signal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @foreach (var ex in exchanges)
                    {
                        var isOutflow24 = ex.NetFlow24hUsd < 0;
                        var isOutflow1 = ex.NetFlow1hUsd < 0;
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-750 transition-colors">
                            <td class="py-3 px-3 font-sans font-bold text-slate-800 dark:text-white flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full @(isOutflow24 ? "bg-emerald-500" : "bg-rose-500")"></span>
                                @ex.ExchangeName
                            </td>
                            <td class="py-3 px-3 text-right font-bold @(isOutflow1 ? "text-emerald-600" : "text-rose-600")">
                                @(isOutflow1 ? "-$" : "+$")@Math.Abs(ex.NetFlow1hUsd / 1000000m).ToString("N1")M
                            </td>
                            <td class="py-3 px-3 text-right text-slate-600 dark:text-slate-300">
                                $@((ex.Inflow24hUsd / 1000000m).ToString("N0"))M
                            </td>
                            <td class="py-3 px-3 text-right text-slate-600 dark:text-slate-300">
                                $@((ex.Outflow24hUsd / 1000000m).ToString("N0"))M
                            </td>
                            <td class="py-3 px-3 text-right font-black @(isOutflow24 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600")">
                                @(isOutflow24 ? "-$" : "+$")@Math.Abs(ex.NetFlow24hUsd / 1000000m).ToString("N0")M
                            </td>
                            <td class="py-3 px-3 text-right font-bold @(ex.NetFlow7dUsd < 0 ? "text-emerald-600" : "text-rose-600")">
                                @(ex.NetFlow7dUsd < 0 ? "-$" : "+$")@Math.Abs(ex.NetFlow7dUsd / 1000000m).ToString("N0")M
                            </td>
                            <td class="py-3 px-3 text-right font-bold text-slate-800 dark:text-slate-200">
                                @ex.BtcReserve.ToString("N0") BTC
                            </td>
                            <td class="py-3 px-3 text-right text-slate-600 dark:text-slate-400">
                                $@((ex.StablecoinReserveUsd / 1000000000m).ToString("N1"))B
                            </td>
                            <td class="py-3 px-3 text-right text-slate-700 dark:text-slate-300">
                                @ex.MeanInflowVolumeBtc.ToString("F2") BTC
                            </td>
                            <td class="py-3 px-3 text-right font-sans">
                                <span class="px-2 py-0.5 rounded text-3xs font-bold @(isOutflow24 ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300")">
                                    @ex.FlowSignal
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 24-Hour Net Flow vs. BTC Price Timeline -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-chart-area text-blue-500"></i> Hourly Exchange Net Flow &amp; Cumulative Delta (24h)
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Sustained negative bars reflect continuous withdrawal to cold wallets, reducing liquid float
                </p>
            </div>
            <div class="flex items-center gap-3 text-2xs font-semibold">
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-500"></span> Outflow (Accumulation)</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-rose-500"></span> Inflow (Deposit Risk)</span>
            </div>
        </div>

        <div class="grid grid-cols-6 sm:grid-cols-12 lg:grid-cols-24 gap-1.5 pt-2">
            @foreach (var p in trend)
            {
                var isNeg = p.NetFlowUsd < 0;
                <div class="p-2 rounded-xl text-center border border-slate-200 dark:border-slate-700 @(isNeg ? "bg-emerald-50/70 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300" : "bg-rose-50/70 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300") flex flex-col justify-between">
                    <span class="text-3xs font-mono font-bold">@p.Time.ToString("HH:mm")</span>
                    <span class="text-xs font-black my-1">
                        @(isNeg ? "-$" : "+$")@Math.Abs(p.NetFlowUsd / 1000000m).ToString("N0")M
                    </span>
                    <span class="text-3xs font-mono text-slate-400">$@p.BtcPrice.ToString("N0")</span>
                </div>
            }
        </div>
    </div>

    <!-- Miner-to-Exchange Flows & Capitulation Risk -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-pickaxe text-amber-500"></i> Bitcoin Mining Pool to Exchange Transfers
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Tracking whether miners are selling rewards to cover OPEX or hoarding in treasury
                </p>
            </div>
            <span class="px-2.5 py-1 rounded text-2xs font-mono font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                MINER FLOW INDEX
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
                <thead class="text-2xs text-slate-400 uppercase font-sans border-b border-slate-100 dark:border-slate-700">
                    <tr>
                        <th class="py-2.5 px-3">Mining Pool</th>
                        <th class="py-2.5 px-3 text-right">24h Transferred BTC</th>
                        <th class="py-2.5 px-3 text-right">Value (USD)</th>
                        <th class="py-2.5 px-3 text-right">Outflow Multiple</th>
                        <th class="py-2.5 px-3 text-right">Miner Capitulation Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @foreach (var m in miners)
                    {
                        <tr>
                            <td class="py-2.5 px-3 font-sans font-bold text-slate-800 dark:text-white">
                                @m.PoolName
                            </td>
                            <td class="py-2.5 px-3 text-right font-bold text-slate-800 dark:text-slate-200">
                                @m.Transferred24hBtc.ToString("N0") BTC
                            </td>
                            <td class="py-2.5 px-3 text-right text-slate-600 dark:text-slate-300">
                                $@((m.TransferredUsd / 1000000m).ToString("N2"))M
                            </td>
                            <td class="py-2.5 px-3 text-right font-bold text-amber-600">
                                @m.MinerOutflowMultiple.ToString("F2")x
                            </td>
                            <td class="py-2.5 px-3 text-right font-sans">
                                <span class="px-2 py-0.5 rounded text-3xs font-bold @(m.CapitulationStatus.Contains("HODL") ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" : "bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300")">
                                    @m.CapitulationStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
