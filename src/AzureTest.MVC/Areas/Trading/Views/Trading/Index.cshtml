                    <div>
                        <span class="text-3xs uppercase font-extrabold text-slate-400 block tracking-wider">Profit Factor</span>
                        <div class="text-lg sm:text-xl font-black mt-1 font-mono @(profitFactor >= 1.5m ? "text-emerald-500" : (profitFactor >= 1.0m ? "text-amber-500" : "text-rose-500"))">
                            @profitFactor.ToString("N2")
