                        <span class="font-bold font-mono @(netPnl >= 0 ? "text-emerald-500" : "text-rose-500")">@FormatPnl5(netPnl)</span>
                    </div>
                </div>

                <!-- 2. Win Rate % -->
                <div class="p-4 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col justify-between">
