    async function runJsonBatch() {
        const btn = document.getElementById('runJsonBatchBtn');
        const output = document.getElementById('jsonBatchOutput');
        const json = document.getElementById('jsonBatchInput').value;

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';

        try {
            const res = await fetch('/Trading/Trading/ExecuteJson', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ json: json })
            });

            const data = await res.json();
            output.classList.remove('hidden');
            output.innerHTML = `<pre class="text-emerald-500">${JSON.stringify(data, null, 2)}</pre>`;
            setTimeout(() => { window.location.reload(); }, 1200);
        } catch (err) {
            output.classList.remove('hidden');
            output.innerHTML = `<span class="text-rose-500">Error: ${err.message}</span>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-play"></i> <span>Execute Batch</span>';
        }
    }
    async function toggleWatchlistDatalist(e, sym, name, cls, btn) {
        e.stopPropagation();
        e.preventDefault();
        try {
            const formData = new FormData();
            formData.append('symbol', sym);
            formData.append('assetName', name);
            formData.append('assetClass', cls);

            const res = await fetch('/Trading/Trading/ToggleWatchlist', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                const icon = btn.querySelector('i');
                const targetQuote = allQuotes.find(q => q.Symbol.toLowerCase() === sym.toLowerCase());
                if (targetQuote) targetQuote.IsWatchlisted = data.isWatchlisted;

                if (data.isWatchlisted) {
                    icon.className = 'fa-solid fa-star text-amber-500 text-xs';
                    btn.title = 'Remove from Watchlist';
                } else {
                    icon.className = 'fa-regular fa-star text-slate-400 hover:text-amber-500 text-xs';
                    btn.title = 'Add to Watchlist';
                }
            }
        } catch (err) {
            console.error('Watchlist toggle failed:', err);
        }
    }

    // Toast Alert Helper
    function showToast(type, msg) {
        let container = document.getElementById('dynamicAlertContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'dynamicAlertContainer';
            container.className = 'fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm pointer-events-none';
            document.body.appendChild(container);
        }
        const isSuccess = type === 'success';
        const isInfo = type === 'info';
        const el = document.createElement('div');
        el.className = `p-4 rounded-2xl pointer-events-auto shadow-xl transition-all transform animate-scale-in border ${
            isSuccess ? 'bg-emerald-50 dark:bg-emerald-950/80 border-emerald-500/30 text-emerald-800 dark:text-emerald-200' :
            isInfo ? 'bg-indigo-50 dark:bg-indigo-950/80 border-indigo-500/30 text-indigo-800 dark:text-indigo-200' :
            'bg-rose-50 dark:bg-rose-950/80 border-rose-500/30 text-rose-800 dark:text-rose-200'
        }`;
        el.innerHTML = `
            <div class="flex items-center gap-3">
                <i class="fa-solid ${isSuccess ? 'fa-circle-check text-emerald-500' : isInfo ? 'fa-circle-info text-indigo-500' : 'fa-circle-exclamation text-rose-500'} text-lg"></i>
                <div class="text-xs font-bold">${msg}</div>
            </div>
        `;
        container.appendChild(el);
        setTimeout(() => {
            el.classList.add('opacity-0', 'translate-x-4');
            setTimeout(() => el.remove(), 400);
        }, 4000);
    }

    function formatPrice5(val) {
        const n = Number(val);
        if (isNaN(n) || n <= 0) return '--';
        return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 5, maximumFractionDigits: 5 });
    }

    function formatPriceInput(val) {
        if (val === null || val === undefined || isNaN(val)) return '0.00';
        const num = Number(val);
        let maxDigits = 2;
        if (num < 0.0001) maxDigits = 8;
        else if (num < 0.01) maxDigits = 6;
        else if (num < 1) maxDigits = 5;
        else if (num < 10) maxDigits = 5;
        else if (num < 1000) maxDigits = 4;
        else maxDigits = 2;

        let s = num.toFixed(maxDigits);
        if (s.includes('.')) {
            const parts = s.split('.');
            if (parts[1].length > 2) {
                parts[1] = parts[1].replace(/0+$/, '');
                if (parts[1].length < 2) parts[1] = parts[1].padEnd(2, '0');
                s = parts[0] + '.' + parts[1];
            }
        }
        return s;
    }

    function formatPnl5(val) {
        const n = Number(val);
        if (isNaN(n)) return '$0.00000';
        const sign = n >= 0 ? '+' : '-';
        const abs = Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 5, maximumFractionDigits: 5 });
        return `${sign}$${abs}`;
    }

    function renderTpCellHtml(tp, multiTpJson) {
        if (!multiTpJson) {
            return (tp && Number(tp) > 0) ? formatPrice5(tp) : '--';
        }
        try {
            let levels = typeof multiTpJson === 'string' ? JSON.parse(multiTpJson) : multiTpJson;
            if (Array.isArray(levels) && levels.length > 1) {
                let html = `
                    <div class="space-y-1">
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-black text-4xs uppercase tracking-wider border border-emerald-500/20">
                            <i class="fa-solid fa-layer-group text-5xs"></i>
                            <span>${levels.length} TP Targets</span>
                        </span>
                        <div class="flex flex-col gap-0.5 font-mono text-3xs">
                `;
                levels.forEach((lvl, idx) => {
                    const p = Number(lvl.price ?? lvl.Price ?? 0);
                    const pct = Number(lvl.percentage ?? lvl.Percentage ?? 0);
                    html += `
                        <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">TP${idx + 1}:</span>
                            <span class="font-extrabold">${formatPrice5(p)}</span>
                            <span class="text-slate-400 text-4xs font-semibold">(${pct}%)</span>
                        </div>
                    `;
                });
                html += `</div></div>`;
                return html;
            } else if (Array.isArray(levels) && levels.length === 1) {
                const singleP = Number(levels[0].price ?? levels[0].Price ?? 0);
                return singleP > 0 ? formatPrice5(singleP) : '--';
            }
        } catch (e) {
            // fallback
        }
        return (tp && Number(tp) > 0) ? formatPrice5(tp) : '--';
    }

    // Modify Position Modal logic
    function openModifyModal(id, symbol, side, entry, current, sl, tp, trail) {
        document.getElementById('modifyPosId').value = id;
        document.getElementById('modifyPosSymbol').value = symbol;
        document.getElementById('modifyModalSymbol').textContent = symbol;
        document.getElementById('modifyModalSideBadge').textContent = `${side} Position`;
        document.getElementById('modifyModalPrices').textContent = `${formatPrice5(entry)} / ${formatPrice5(current)}`;
        document.getElementById('modifyPosCurrentPrice').value = current;
        document.getElementById('modifyPosSide').value = side;

        const slInput = document.getElementById('modifyPosSlInput');
        slInput.value = (sl && Number(sl) > 0) ? Number(sl).toFixed(5) : '';

        const slHint = document.getElementById('modifySlHint');
        const tpHint = document.getElementById('modifyTpHint');
        if (String(side).toLowerCase().includes('buy')) {
            slHint.textContent = `Must be strictly BELOW current price (${formatPrice5(current)}).`;
            tpHint.textContent = `Must be strictly ABOVE current price (${formatPrice5(current)}).`;
        } else {
            slHint.textContent = `Must be strictly ABOVE current price (${formatPrice5(current)}).`;
            tpHint.textContent = `Must be strictly BELOW current price (${formatPrice5(current)}).`;
        }

        // Retrieve existing multi-level TP JSON from row data attribute
        const row = document.getElementById(`posRowIdx_${id}`) || document.getElementById(`posRow_${id}`);
        const multiTpJson = row ? row.getAttribute('data-multi-tp') : '';
        populateModifyTpLevels(multiTpJson, tp, side, current);

        document.getElementById('modifyPositionModal').classList.remove('hidden');
    }

    function populateModifyTpLevels(multiTpJson, singleTp, side, currentPrice) {
        const container = document.getElementById('modifyTpLevelsContainer');
        if (!container) return;
        container.innerHTML = '';

        let levels = [];
        if (multiTpJson) {
            try {
                const parsed = typeof multiTpJson === 'string' ? JSON.parse(multiTpJson) : multiTpJson;
                if (Array.isArray(parsed) && parsed.length > 0) {
                    levels = parsed;
                }
            } catch (e) {
                console.debug('Failed to parse position multi-tp json:', e);
            }
        }

        if (levels.length === 0 && singleTp && Number(singleTp) > 0) {
            levels = [{ price: Number(singleTp), percentage: 100 }];
        }

        if (levels.length === 0) {
            levels = [{ price: '', percentage: 100 }];
        }

        levels.forEach((lvl, idx) => {
            const p = (lvl.price !== undefined && lvl.price !== null && lvl.price !== '') ? formatPriceInput(lvl.price) : '';
            const pct = lvl.percentage || (levels.length === 1 ? 100 : Math.floor(100 / levels.length));
            const rowEl = createModifyTpHtmlRow(idx + 1, p, pct, levels.length > 1);
            container.appendChild(rowEl);
        });

        onModifyTpLevelChange();
    }

    function createModifyTpHtmlRow(index, priceVal, pctVal, showRemove) {
        const div = document.createElement('div');
        div.className = 'modify-tp-row flex items-center gap-2';
        div.setAttribute('data-index', index);
        div.innerHTML = `
            <span class="text-3xs font-black text-emerald-600 dark:text-emerald-400 px-1.5 py-1 rounded bg-emerald-500/10 shrink-0 modify-tp-tag">TP ${index}</span>
            <div class="relative flex-1">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-xs">$</span>
                <input type="text" inputmode="decimal"
                       value="${priceVal}"
                       placeholder="Target Price"
                       oninput="this.value = this.value.replace(',', '.'); onModifyTpLevelChange();"
                       class="modify-tp-price w-full pl-6 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
            </div>
            <div class="flex items-center gap-1 w-20 shrink-0">
                <input type="number" min="1" max="100" value="${pctVal}"
                       oninput="onModifyTpLevelChange();"
                       class="modify-tp-pct w-14 px-1.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                <span class="text-3xs font-extrabold text-slate-400">%</span>
            </div>
            <button type="button" onclick="removeModifyTpLevel(this)" class="modify-tp-remove ${showRemove ? '' : 'hidden'} p-1.5 text-slate-400 hover:text-rose-500 rounded transition-colors shrink-0" title="Remove level">
                <i class="fa-solid fa-xmark text-xs"></i>
            </button>
        `;
        return div;
    }

    function addModifyTpLevel() {
        const container = document.getElementById('modifyTpLevelsContainer');
        const rows = container.querySelectorAll('.modify-tp-row');
        if (rows.length >= 5) {
            showToast('error', 'Maximum 5 Take Profit levels allowed.');
            return;
        }

        const newIndex = rows.length + 1;
        const currentPrice = parseFloat(document.getElementById('modifyPosCurrentPrice').value) || 0;
        const side = document.getElementById('modifyPosSide').value;
        const isBuy = String(side).toLowerCase().includes('buy');
        const offset = isBuy ? (1 + (0.02 * newIndex)) : (1 - (0.02 * newIndex));
        const suggPrice = currentPrice > 0 ? formatPriceInput(currentPrice * offset) : '';

        const newPct = Math.floor(100 / newIndex);
        const remPct = 100 - (newPct * (newIndex - 1));

        rows.forEach((r, idx) => {
            const pctInput = r.querySelector('.modify-tp-pct');
            if (pctInput) pctInput.value = (idx === 0 ? remPct : newPct);
        });

        const newRow = createModifyTpHtmlRow(newIndex, suggPrice, newPct, true);
        container.appendChild(newRow);

        container.querySelectorAll('.modify-tp-remove').forEach(btn => btn.classList.remove('hidden'));
        onModifyTpLevelChange();
    }

    function removeModifyTpLevel(btn) {
        const row = btn.closest('.modify-tp-row');
        const container = document.getElementById('modifyTpLevelsContainer');
        if (row && container) {
            row.remove();
            const remaining = container.querySelectorAll('.modify-tp-row');
            remaining.forEach((r, idx) => {
                const tag = r.querySelector('.modify-tp-tag');
                if (tag) tag.textContent = `TP ${idx + 1}`;
                r.setAttribute('data-index', idx + 1);
            });

            if (remaining.length <= 1) {
                remaining.forEach(r => {
                    const remBtn = r.querySelector('.modify-tp-remove');
                    if (remBtn) remBtn.classList.add('hidden');
                    const pct = r.querySelector('.modify-tp-pct');
                    if (pct) pct.value = 100;
                });
            }

            onModifyTpLevelChange();
        }
    }

    function clearModifyTpLevels() {
        const container = document.getElementById('modifyTpLevelsContainer');
        if (container) {
            container.innerHTML = '';
            container.appendChild(createModifyTpHtmlRow(1, '', 100, false));
            onModifyTpLevelChange();
        }
    }

    function onModifyTpLevelChange() {
        const container = document.getElementById('modifyTpLevelsContainer');
        if (!container) return;
        const rows = container.querySelectorAll('.modify-tp-row');

        let totalPct = 0;
        const validLevels = [];

        rows.forEach((r, idx) => {
            const priceInput = r.querySelector('.modify-tp-price');
            const pctInput = r.querySelector('.modify-tp-pct');
            const p = parseFloat((priceInput?.value || '').replace(',', '.')) || 0;
            const pct = parseFloat(pctInput?.value) || 0;

            totalPct += pct;
            if (p > 0 && pct > 0) {
                validLevels.push({ price: p, percentage: pct });
            }

            if (idx === 0) {
                document.getElementById('modifyPosTpInput').value = p > 0 ? p : '';
            }
        });

        const badge = document.getElementById('modifyTpAllocationBadge');
        if (badge) {
            badge.textContent = `${totalPct}%`;
            if (totalPct === 100) badge.className = 'text-emerald-600 font-mono font-black';
            else if (totalPct > 100) badge.className = 'text-rose-500 font-mono font-black animate-pulse';
            else badge.className = 'text-amber-500 font-mono font-black';
        }

        const jsonInput = document.getElementById('modifyMultipleTakeProfitsJson');
        if (jsonInput) {
            jsonInput.value = (validLevels.length > 0) ? JSON.stringify(validLevels) : '';
        }
    }

    function closeModifyModal() {
        document.getElementById('modifyPositionModal').classList.add('hidden');
    }

    async function submitModifyPosition(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSaveModifyPosition');
        const posId = document.getElementById('modifyPosId').value;
        const sym = document.getElementById('modifyPosSymbol').value;
        const side = document.getElementById('modifyPosSide').value;
        const currentPrice = parseFloat(document.getElementById('modifyPosCurrentPrice').value) || 0;
        const sl = (document.getElementById('modifyPosSlInput').value || '').trim();
        const tp = (document.getElementById('modifyPosTpInput').value || '').trim();
        const multiTpJson = (document.getElementById('modifyMultipleTakeProfitsJson').value || '').trim();

        // Multi-level TP client-side validation
        if (multiTpJson) {
            try {
                const levels = JSON.parse(multiTpJson);
                const isBuy = String(side).toLowerCase().includes('buy');
                let totalPct = 0;
                for (let lvl of levels) {
                    const p = Number(lvl.price);
                    const pct = Number(lvl.percentage);
                    if (isBuy && p <= currentPrice) {
                        showToast('error', `Multi-level TP price ($${p}) must be above current price ($${currentPrice}).`);
                        return;
                    }
                    if (!isBuy && p >= currentPrice) {
                        showToast('error', `Multi-level TP price ($${p}) must be below current price ($${currentPrice}).`);
                        return;
                    }
                    if (pct <= 0 || pct > 100) {
                        showToast('error', 'Each Take Profit percentage must be between 1% and 100%.');
                        return;
                    }
                    totalPct += pct;
                }
                if (totalPct !== 100) {
                    showToast('error', `Total Take Profit percentage allocation must equal 100% (currently ${totalPct}%).`);
                    return;
                }
            } catch (err) {
                showToast('error', 'Invalid multi-level Take Profit format.');
                return;
            }
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

        try {
            const fd = new FormData();
            fd.append('positionId', posId);
            fd.append('symbol', sym);
            fd.append('stopLoss', sl);
            fd.append('takeProfit', tp);
            fd.append('multipleTakeProfitsJson', multiTpJson);
            fd.append('sourcePage', 'index');

            const res = await fetch('/Trading/Trading/ModifyPosition', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const data = await res.json();
            if (res.ok && data.success) {
                showToast('success', data.message || 'Position stops updated successfully!');
                closeModifyModal();
                const slCell = document.getElementById(`idxPosSl_${posId}`) || document.getElementById(`posSl_${posId}`);
                if (slCell) slCell.textContent = (sl && parseFloat(sl) > 0) ? formatPrice5(sl) : '--';
                const tpCell = document.getElementById(`idxPosTp_${posId}`) || document.getElementById(`posTp_${posId}`);
                if (tpCell) {
                    tpCell.innerHTML = renderTpCellHtml(tp, multiTpJson);
                }
                const row = document.getElementById(`posRowIdx_${posId}`) || document.getElementById(`posRow_${posId}`);
                if (row) {
                    row.setAttribute('data-multi-tp', multiTpJson || '');
                }
                pollLiveIndexStatus(true);
            } else {
                showToast('error', data.error || 'Failed to update position.');
            }
        } catch (err) {
            showToast('error', err.message || 'Network error updating position.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> <span>Save Protection</span>';
        }
    }

    // AJAX Close Position
    async function ajaxClosePositionIndex(posId, sym) {
        try {
            const priceEl = document.getElementById(`idxPosPrice_${posId}`);
            let cp = priceEl ? parseFloat(priceEl.textContent.replace('$', '').replace(/,/g, '').trim()) : 0;

            const fd = new FormData();
            fd.append('positionId', posId);
            fd.append('symbol', sym);
            if (cp > 0) {
                fd.append('closePrice', cp);
            }
            fd.append('sourcePage', 'index');

            const res = await fetch('/Trading/Trading/ClosePosition', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const data = await res.json();
            if (res.ok && data.success) {
                showToast('success', data.message || 'Position closed successfully.');
                const row = document.getElementById(`posRowIdx_${posId}`);
                if (row) row.remove();
                pollLiveIndexStatus(true);
            } else {
                showToast('error', data.error || 'Failed to close position.');
            }
        } catch (err) {
            showToast('error', 'Error closing position: ' + err.message);
        }
    }

    // Live status polling (no reload needed to see closed trades or price updates)
    let knownOpenIndexPosIds = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpenPositions.Select(p => p.Id.ToString()))));

    async function pollLiveIndexStatus(immediate = false) {
        try {
            const res = await fetch('/Trading/Trading/LiveStatus?symbol=BTCUSDT', {
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
            });
            if (!res.ok) return;
            const data = await res.json();
            if (!data || !data.success) return;

            // 1. Update Account KPIs
            if (data.account) {
                const acc = data.account;
                const cashEl = document.getElementById('idxKpiCash');
                if (cashEl) cashEl.textContent = formatPrice5(acc.cashBalance ?? acc.CashBalance);
                const eqEl = document.getElementById('idxKpiEquity');
                if (eqEl) eqEl.textContent = formatPrice5(acc.equity ?? acc.Equity);
                const mgEl = document.getElementById('idxKpiMargin');
                if (mgEl) mgEl.textContent = formatPrice5(acc.marginUsed ?? acc.MarginUsed);
                const freeEl = document.getElementById('idxKpiFree');
                if (freeEl) freeEl.textContent = 'Free: ' + formatPrice5(acc.freeMargin ?? acc.FreeMargin);
                const pnlEl = document.getElementById('idxKpiPnl');
                if (pnlEl) {
                    const pnlVal = Number(acc.realizedPnl ?? acc.RealizedPnl ?? 0);
                    pnlEl.textContent = formatPnl5(pnlVal);
                    pnlEl.className = `text-lg sm:text-xl font-black mt-1 ${pnlVal >= 0 ? 'text-emerald-500' : 'text-rose-500'}`;
                }
            }

            // 2. Track Closed Positions automatically
            const currentOpen = data.openPositions || [];
            const currentOpenIds = new Set(currentOpen.map(p => String(p.id ?? p.Id)));

            knownOpenIndexPosIds.forEach(id => {
                if (!currentOpenIds.has(String(id))) {
                    const row = document.getElementById(`posRowIdx_${id}`);
                    if (row) {
                        const sym = row.getAttribute('data-symbol') || 'Asset';
                        row.remove();
                        showToast('info', `Position ${sym} closed (Stop Loss / Take Profit executed).`);
                    }
                }
            });

            knownOpenIndexPosIds = currentOpenIds;

            // Update badge counts
            const badge = document.getElementById('idxOpenPositionsBadge');
            if (badge) badge.textContent = `${currentOpen.length} Active`;
            const countKpi = document.getElementById('idxKpiOpenCount');
            if (countKpi) countKpi.textContent = `Open Trades: ${currentOpen.length}`;

            // Update mark prices and PnL for active positions
            currentOpen.forEach(pos => {
                const id = pos.id ?? pos.Id;
                const curPrice = Number(pos.currentPrice ?? pos.CurrentPrice ?? 0);
                const unPnl = Number(pos.unrealizedPnl ?? pos.UnrealizedPnl ?? 0);

                const priceEl = document.getElementById(`idxPosPrice_${id}`);
                if (priceEl && curPrice > 0) priceEl.textContent = formatPrice5(curPrice);

                const pnlEl = document.getElementById(`idxPosPnl_${id}`);
                if (pnlEl) {
                    pnlEl.innerHTML = `<span class="${unPnl >= 0 ? 'text-emerald-500' : 'text-rose-500'}">${formatPnl5(unPnl)}</span>`;
                }

                const row = document.getElementById(`posRowIdx_${id}`);
                const multiTp = pos.multipleTakeProfitsJson ?? pos.MultipleTakeProfitsJson;
                if (row) {
                    row.setAttribute('data-multi-tp', multiTp || '');
                }

                const slCell = document.getElementById(`idxPosSl_${id}`);
                if (slCell) {
                    const sl = Number(pos.stopLoss ?? pos.StopLoss ?? 0);
                    slCell.textContent = sl > 0 ? formatPrice5(sl) : '--';
                }

                const tpCell = document.getElementById(`idxPosTp_${id}`);
                if (tpCell) {
                    const tp = Number(pos.takeProfit ?? pos.TakeProfit ?? 0);
                    tpCell.innerHTML = renderTpCellHtml(tp, multiTp);
                }
            });

            // If empty open positions
            const container = document.getElementById('indexOpenPositionsContainer');
            if (container && currentOpen.length === 0 && !container.querySelector('.text-slate-400')) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-400">
                        <i class="fa-solid fa-folder-open text-3xl text-slate-300 dark:text-slate-700 mb-2"></i>
                        <p class="text-xs font-bold text-slate-700 dark:text-slate-300">No Open Positions</p>
                        <p class="text-3xs text-slate-400 mt-1">Select an asset from the Watchlist or Search bar to place your first paper trade.</p>
                    </div>`;
            }
        } catch (e) {
            console.debug('Index live status poll error:', e);
        }
    }

    setInterval(pollLiveIndexStatus, 3500);
</script>
}
