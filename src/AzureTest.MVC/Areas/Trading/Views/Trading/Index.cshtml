@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // =========================================================================
    // ADVANCED QUANTITATIVE PERFORMANCE ANALYTICS CHARTS (CHART.JS)
    // =========================================================================
    function toggleAnalyticsView() {
        const container = document.getElementById('analyticsBodyContainer');
        const icon = document.getElementById('analyticsToggleIcon');
        const text = document.getElementById('analyticsToggleText');
        if (!container) return;

        if (container.classList.contains('hidden')) {
            container.classList.remove('hidden');
            if (icon) icon.className = 'fa-solid fa-compress text-brand-500';
            if (text) text.textContent = 'Collapse View';
        } else {
            container.classList.add('hidden');
            if (icon) icon.className = 'fa-solid fa-expand text-brand-500';
            if (text) text.textContent = 'Expand View';
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const isDark = document.documentElement.classList.contains('dark');
        const gridColor = isDark ? 'rgba(148, 163, 184, 0.08)' : 'rgba(148, 163, 184, 0.12)';
        const textColor = isDark ? '#94a3b8' : '#64748b';

        const commonPlugins = {
            legend: {
                labels: { color: textColor, font: { weight: 'bold', size: 11 } }
            },
            tooltip: {
                backgroundColor: isDark ? 'rgba(15, 23, 42, 0.95)' : 'rgba(255, 255, 255, 0.95)',
                titleColor: isDark ? '#f8fafc' : '#0f172a',
                bodyColor: isDark ? '#94a3b8' : '#475569',
                borderColor: isDark ? '#334155' : '#e2e8f0',
                borderWidth: 1,
                padding: 10,
                cornerRadius: 12
            }
        };

        // 1. Line Chart: Equity Growth & Cumulative PnL Trajectory
        const eqCanvas = document.getElementById('ptEquityCurveCanvas');
        if (eqCanvas) {
            const eqLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(eqLabels));
            const eqData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(eqValues));
            const isProfitable = (eqData.length > 0 && eqData[eqData.length - 1] >= eqData[0]);
            const lineColor = isProfitable ? '#10b981' : '#f43f5e';
            const bgGradient = isProfitable ? 'rgba(16, 185, 129, 0.12)' : 'rgba(244, 63, 94, 0.12)';

            new Chart(eqCanvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: eqLabels,
                    datasets: [{
                        label: 'Net Account Equity ($)',
                        data: eqData,
                        borderColor: lineColor,
                        backgroundColor: bgGradient,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: lineColor,
                        borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        ...commonPlugins,
                        tooltip: {
                            ...commonPlugins.tooltip,
                            callbacks: {
                                label: ctx => ` Equity: $${Number(ctx.raw || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: textColor, font: { size: 10 } } },
                        y: {
                            grid: { color: gridColor },
                            ticks: {
                                color: textColor,
                                font: { size: 10 },
                                callback: val => `$${Number(val).toLocaleString()}`
                            }
                        }
                    }
                }
            });
        }

        // 2. Donut Chart: Asset Class Allocation
        const acCanvas = document.getElementById('ptAssetClassCanvas');
        if (acCanvas) {
            const acLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(assetClassDict.Keys));
            const acData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(assetClassDict.Values));

            new Chart(acCanvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: acLabels,
                    datasets: [{
                        data: acData,
                        backgroundColor: ['#10b981', '#3b82f6', '#8b5cf6', '#f59e0b', '#06b6d4'],
                        borderWidth: 2,
                        borderColor: isDark ? '#0f172a' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
