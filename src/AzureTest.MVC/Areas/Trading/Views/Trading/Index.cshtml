                    </div>
                    <div class="pt-2 mt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-3xs">
                        <span class="text-slate-400">Usage Ratio</span>
                        <span class="font-bold text-slate-700 dark:text-slate-300 font-mono">@marginUsagePct.ToString("N1")% Used</span>
                    </div>
                </div>
            </div>

            <!-- Charts Suite: 6 Visualizers (Lines, Bars, Donuts) -->
