                <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500">Exit / Close Price</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-slate-200" id="calcExitPrice">--</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500">Price Move per Unit</span>
                    <span class="font-mono font-black" id="calcPriceDiff">--</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500">Executed Units (Quantity)</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-slate-200" id="calcQuantity">--</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500">Leverage</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-slate-200" id="calcLeverage">--</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500">Total Position Notional</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-slate-200" id="calcNotional">--</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100 dark:border-slate-800">
                    <span class="text-slate-500">Initial Margin Allocated</span>
                    <span class="font-mono font-bold text-slate-800 dark:text-slate-200" id="calcInitialMargin">--</span>
                </div>
                <div class="flex justify-between items-center py-1 text-emerald-600 dark:text-emerald-400 font-bold">
                    <span>Collateral Returned to Balance</span>
                    <span class="font-mono font-black" id="calcReturnedCollateral">--</span>
                </div>
            </div>

            <!-- Clear Explanation Box -->
            <div class="p-3.5 rounded-2xl bg-slate-100/70 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-3xs text-slate-600 dark:text-slate-300 leading-relaxed" id="calcExplanationText">
                --
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 flex items-center justify-between">
            <span class="text-3xs text-slate-400">AzureTest Trade Calculation Engine</span>
            <button type="button" onclick="closePnlCalculationModal()" class="px-4 py-2 text-xs font-black rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-colors">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const allTradeHistoryItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trades));

    function quickFilterTable() {
        const val = (document.getElementById('tableQuickSearch').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#historyDataTable tbody tr.trade-row');
        rows.forEach(r => {
            const sym = r.getAttribute('data-symbol') || '';
            const name = r.getAttribute('data-name') || '';
            const side = r.getAttribute('data-side') || '';
            const outcome = r.getAttribute('data-outcome') || '';
            const txt = (r.innerText || '').toLowerCase();
            if (!val || sym.includes(val) || name.includes(val) || side.includes(val) || outcome.includes(val) || txt.includes(val)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function showTradeReceiptById(id) {
        const t = (allTradeHistoryItems || []).find(x => String(x.Id || x.id || '').toLowerCase() === String(id || '').toLowerCase());
        if (!t) return;
        showTradeReceipt(t);
    }

    function showPnlCalculationModal(id) {
        const t = (allTradeHistoryItems || []).find(x => String(x.Id || x.id || '').toLowerCase() === String(id || '').toLowerCase());
        if (!t) return;
        const isBuy = t.Side === 1 || t.Side === 'Buy' || t.side === 1 || t.side === 'Buy';
        const entryP = Number(t.EntryPrice ?? t.entryPrice ?? 0);
        const closeP = Number(t.ClosePrice ?? t.closePrice ?? t.CurrentPrice ?? t.currentPrice ?? 0);
        const qty = Number(t.Quantity ?? t.quantity ?? 0);
        const lev = Number(t.Leverage ?? t.leverage ?? 1);
        const initMargin = Number(t.InitialMargin ?? t.initialMargin ?? 0);
        const pnl = Number(t.RealizedPnl ?? t.realizedPnl ?? 0);
        const roi = Number(t.RoiPercentage ?? t.roiPercentage ?? 0);
        const notional = qty * entryP;
        const isWin = pnl >= 0;
        const isLiquidated = t.Status === 3 || t.Status === 'Liquidated' || t.status === 3 || t.status === 'Liquidated' || t.OutcomeBadge === 'LIQUIDATED' || t.outcomeBadge === 'LIQUIDATED';

        const priceDiff = isBuy ? (closeP - entryP) : (entryP - closeP);
        const returnedCollateral = Math.max(0, initMargin + pnl);

        document.getElementById('calcModalTitle').innerText = `${t.Symbol || t.symbol} (${t.AssetName || t.assetName || t.Symbol || t.symbol})`;
        document.getElementById('calcModalTicketId').innerText = `Ticket #${t.Id || t.id} • ${isBuy ? 'Long (Buy)' : 'Short (Sell)'} • ${lev}x Leverage`;
        
        // Result hero banner
        const pnlEl = document.getElementById('calcModalPnlDisplay');
        pnlEl.innerText = `${pnl >= 0 ? '+' : ''}$${pnl.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 })}`;
        pnlEl.className = `text-2xl font-black ${isWin ? 'text-emerald-500' : 'text-rose-500'}`;

        const roiEl = document.getElementById('calcModalRoiDisplay');
        roiEl.innerText = `${roi >= 0 ? '+' : ''}${roi.toFixed(2)}% ROI`;

        const badgeEl = document.getElementById('calcModalBadge');
        badgeEl.innerText = t.OutcomeBadge || t.outcomeBadge || (isWin ? 'WIN' : 'LOSS');
        badgeEl.className = `px-2.5 py-1 rounded-lg text-3xs font-black uppercase ${isWin ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white'}`;

        // Formula elements
        document.getElementById('calcFormulaName').innerText = isBuy ? 'Long Formula: (Exit Price - Entry Price) × Quantity' : 'Short Formula: (Entry Price - Exit Price) × Quantity';
        document.getElementById('calcFormulaMath').innerText = isBuy 
            ? `($${closeP.toFixed(4)} - $${entryP.toFixed(4)}) × ${qty.toFixed(6)} Units = ${pnl >= 0 ? '+' : ''}$${pnl.toFixed(4)}`
            : `($${entryP.toFixed(4)} - $${closeP.toFixed(4)}) × ${qty.toFixed(6)} Units = ${pnl >= 0 ? '+' : ''}$${pnl.toFixed(4)}`;

        // Inputs breakdown
        document.getElementById('calcEntryPrice').innerText = '$' + entryP.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 });
        document.getElementById('calcExitPrice').innerText = '$' + closeP.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 });
        document.getElementById('calcPriceDiff').innerText = `${priceDiff >= 0 ? '+' : ''}$${priceDiff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 })} per unit`;
        document.getElementById('calcQuantity').innerText = qty.toLocaleString('en-US', { maximumFractionDigits: 6 }) + ' Units';
        document.getElementById('calcLeverage').innerText = `${lev}x`;
        document.getElementById('calcNotional').innerText = '$' + notional.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('calcInitialMargin').innerText = '$' + initMargin.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('calcReturnedCollateral').innerText = '$' + returnedCollateral.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        // Explanation text
        const explEl = document.getElementById('calcExplanationText');
        if (isLiquidated) {
            explEl.innerHTML = `<span class="text-rose-600 font-bold">Liquidation:</span> Price touched the liquidation threshold. The entire position initial margin of $${initMargin.toFixed(2)} was absorbed by the liquidation mechanism.`;
        } else if (pnl < 0) {
            explEl.innerHTML = `<strong>Why didn't you lose all margin?</strong> Because you closed before liquidation! Your initial margin ($${initMargin.toFixed(2)}) was collateral. Only the realized loss (-$${Math.abs(pnl).toFixed(2)}) was deducted. The remaining <span class="text-emerald-600 font-bold">$${returnedCollateral.toFixed(2)}</span> of collateral was unlocked and returned to your cash balance.`;
        } else {
            explEl.innerHTML = `<strong>Profitable Trade:</strong> Your full initial margin of $${initMargin.toFixed(2)} plus your profit of <span class="text-emerald-600 font-bold">+$${pnl.toFixed(2)}</span> was credited back to your account cash balance ($${returnedCollateral.toFixed(2)} total returned).`;
        }

        document.getElementById('tradeCalculationModal').classList.remove('hidden');
    }

    function closePnlCalculationModal() {
        document.getElementById('tradeCalculationModal').classList.add('hidden');
    }

    function showTradeReceipt(t) {
        if (!t) return;
        const modal = document.getElementById('tradeReceiptModal');
        const isBuy = t.Side === 1 || t.Side === 'Buy' || t.side === 1 || t.side === 'Buy';

        document.getElementById('modalTradeTitle').innerText = `${t.Symbol || t.symbol} (${t.AssetName || t.assetName || t.Symbol || t.symbol})`;
        document.getElementById('modalTicketId').innerText = `Ticket #${t.Id || t.id}`;

        // Outcome Banner
        const pnl = Number(t.RealizedPnl ?? t.realizedPnl ?? 0);
        const pnlEl = document.getElementById('modalRealizedPnl');
        pnlEl.innerText = (pnl >= 0 ? '+' : '') + '$' + pnl.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        pnlEl.className = 'text-base font-black ' + (pnl >= 0 ? 'text-emerald-500' : 'text-rose-500');

        const banner = document.getElementById('modalOutcomeBanner');
        banner.className = 'p-3.5 rounded-2xl flex items-center justify-between ' + 
            (pnl >= 0 ? 'bg-emerald-500/10 border border-emerald-500/20' : 'bg-rose-500/10 border border-rose-500/20');

        const badge = document.getElementById('modalOutcomeBadge');
        badge.innerText = t.OutcomeBadge || t.outcomeBadge || (pnl >= 0 ? 'WIN' : 'LOSS');
        badge.className = 'px-2.5 py-1 rounded-lg text-3xs font-black uppercase ' +
            (pnl >= 0 ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white');

        document.getElementById('modalRoiPct').innerText = (Number(t.RoiPercentage ?? t.roiPercentage ?? 0) >= 0 ? '+' : '') + 
            Number(t.RoiPercentage ?? t.roiPercentage ?? 0).toFixed(2) + '% ROI';

        // Price Trade Closed With & Closed When - Hero Highlights
        const closeP = (t.ClosePrice !== null && t.ClosePrice !== undefined) ? Number(t.ClosePrice) : ((t.closePrice !== null && t.closePrice !== undefined) ? Number(t.closePrice) : ((t.CurrentPrice !== null && t.CurrentPrice !== undefined) ? Number(t.CurrentPrice) : ((t.currentPrice !== null && t.currentPrice !== undefined) ? Number(t.currentPrice) : null)));
        const entryP = Number(t.EntryPrice ?? t.entryPrice ?? 0);

        if (closeP !== null && closeP > 0) {
            document.getElementById('modalHeroExitPrice').innerText = '$' + closeP.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 });
            const pDiff = closeP - entryP;
            const pDiffPct = entryP > 0 ? (pDiff / entryP) * 100 : 0;
            const diffEl = document.getElementById('modalHeroExitDiff');
            diffEl.innerText = `${pDiff >= 0 ? '+' : ''}${pDiffPct.toFixed(2)}% vs Entry ($${entryP.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 })})`;
            diffEl.className = `text-3xs font-black ${pDiff >= 0 ? 'text-emerald-500' : 'text-rose-500'}`;
        } else {
            document.getElementById('modalHeroExitPrice').innerText = '--';
            const diffEl = document.getElementById('modalHeroExitDiff');
            diffEl.innerText = 'Closed Price Unavailable';
            diffEl.className = 'text-3xs font-bold text-slate-400';
        }

        const closedAt = t.ClosedAtUtc || t.closedAtUtc;
        if (closedAt) {
            const cDate = new Date(closedAt);
            document.getElementById('modalHeroClosedWhen').innerText = cDate.toUTCString();
            const diffMs = Date.now() - cDate.getTime();
            const diffSec = Math.max(0, Math.floor(diffMs / 1000));
            let rel = '';
            if (diffSec < 60) rel = 'Just now';
            else if (diffSec < 3600) rel = `${Math.floor(diffSec / 60)}m ago`;
            else if (diffSec < 86400) rel = `${Math.floor(diffSec / 3600)}h ago`;
            else rel = `${Math.floor(diffSec / 86400)}d ago`;
            document.getElementById('modalHeroClosedRelative').innerText = `${rel} (Holding period logged)`;
        } else {
            document.getElementById('modalHeroClosedWhen').innerText = '--';
            document.getElementById('modalHeroClosedRelative').innerText = '--';
        }

        // Grid values
        document.getElementById('modalSideText').innerText = isBuy ? 'Long (Buy)' : 'Short (Sell)';
        document.getElementById('modalUnitsText').innerText = Number(t.Quantity ?? t.quantity ?? 0).toLocaleString('en-US', { maximumFractionDigits: 6 }) + ' Units';
        document.getElementById('modalMarginText').innerText = '$' + Number(t.InitialMargin ?? t.initialMargin ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('modalLeverageText').innerText = (t.Leverage ?? t.leverage ?? 1) + 'x Leverage';
        document.getElementById('modalWholeBalanceText').innerText = '$' + Number(t.WholeAccountBalance ?? t.wholeAccountBalance ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('modalBalancePctText').innerText = Number(t.BalancePercentage ?? t.balancePercentage ?? 0).toFixed(1) + '% of Whole Balance';
        document.getElementById('modalEntryPriceText').innerText = '$' + Number(t.EntryPrice ?? t.entryPrice ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 });
        const exitPriceVal = t.ClosePrice ?? t.closePrice;
        document.getElementById('modalExitPriceText').innerText = exitPriceVal ? ('$' + Number(exitPriceVal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 })) : '--';
        const tpVal = t.TakeProfit ?? t.takeProfit;
        document.getElementById('modalTpText').innerText = tpVal ? ('$' + Number(tpVal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 })) : 'None';
        const slVal = t.StopLoss ?? t.stopLoss;
        document.getElementById('modalSlText').innerText = slVal ? ('$' + Number(slVal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 })) : 'None';

        const openedAt = t.OpenedAtUtc || t.openedAtUtc;
        document.getElementById('modalOpenedText').innerText = openedAt ? new Date(openedAt).toUTCString() : '--';
        document.getElementById('modalClosedText').innerText = closedAt ? new Date(closedAt).toUTCString() : '--';

        // Multi-TP handling
        const multiBox = document.getElementById('modalMultiTpBox');
        const multiList = document.getElementById('modalMultiTpList');
        multiList.innerHTML = '';
        const multiTpJson = t.MultipleTakeProfitsJson || t.multipleTakeProfitsJson;
        if (multiTpJson) {
            try {
                const arr = JSON.parse(multiTpJson);
                if (Array.isArray(arr) && arr.length > 0) {
                    multiBox.classList.remove('hidden');
                    arr.forEach((item, idx) => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between text-3xs font-bold';
                        row.innerHTML = `<span class="text-slate-500">TP ${idx + 1} (${item.Percentage || item.percentage}% qty):</span><span class="text-emerald-500 font-black">$${Number(item.Price || item.price).toFixed(4)}</span>`;
                        multiList.appendChild(row);
                    });
                } else {
                    multiBox.classList.add('hidden');
                }
            } catch {
                multiBox.classList.add('hidden');
            }
        } else {
            multiBox.classList.add('hidden');
        }

        modal.classList.remove('hidden');
    }

    function closeTradeReceiptModal() {
        document.getElementById('tradeReceiptModal').classList.add('hidden');
    }

    function exportHistoryCsv() {
        if (!allTradeHistoryItems || !allTradeHistoryItems.length) {
            alert('No trade history available to export.');
            return;
        }

        let csv = 'TicketId,Symbol,Side,Units,Margin,Leverage,BalancePct,EntryPrice,ExitPrice,TakeProfit,StopLoss,RealizedPnl,RoiPct,Outcome,CloseReason,OpenedAt,ClosedAt\n';

        allTradeHistoryItems.forEach(t => {
            const side = (t.Side === 1 || t.Side === 'Buy' || t.side === 1 || t.side === 'Buy') ? 'Long' : 'Short';
            csv += `"${t.Id || t.id}","${t.Symbol || t.symbol}","${side}",${t.Quantity || t.quantity || 0},${t.InitialMargin || t.initialMargin || 0},${t.Leverage || t.leverage || 1},${t.BalancePercentage || t.balancePercentage || 0},${t.EntryPrice || t.entryPrice || 0},${t.ClosePrice || t.closePrice || 0},${t.TakeProfit || t.takeProfit || ''},${t.StopLoss || t.stopLoss || ''},${t.RealizedPnl || t.realizedPnl || 0},${t.RoiPercentage || t.roiPercentage || 0},"${t.OutcomeBadge || t.outcomeBadge || ''}","${t.CloseReasonBadge || t.closeReasonBadge || ''}","${t.OpenedAtUtc || t.openedAtUtc || ''}","${t.ClosedAtUtc || t.closedAtUtc || ''}"\n`;
        });

        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `TradeHistory_Export_${new Date().toISOString().slice(0,10)}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    // Explicitly bind to window to ensure global availability in inline onclick attributes
    window.quickFilterTable = quickFilterTable;
    window.showTradeReceiptById = showTradeReceiptById;
    window.showPnlCalculationModal = showPnlCalculationModal;
    window.closePnlCalculationModal = closePnlCalculationModal;
    window.showTradeReceipt = showTradeReceipt;
    window.closeTradeReceiptModal = closeTradeReceiptModal;
    window.exportHistoryCsv = exportHistoryCsv;
</script>
}
