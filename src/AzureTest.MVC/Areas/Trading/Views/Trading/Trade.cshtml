                                                    <span>@multiTpList.Count TP Targets</span>
                                                </span>
                                                <div class="flex flex-col gap-0.5 font-mono text-3xs">
                                                    @for (int i = 0; i < multiTpList.Count; i++)
                                                    {
                                                        var lvl = multiTpList[i];
                                                        <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                                                            <span class="font-bold text-emerald-600 dark:text-emerald-400">TP@(i + 1):</span>
                                                            <span class="font-extrabold">@FormatTablePrice5(lvl.Price)</span>
                                                            <span class="text-slate-400 text-4xs font-semibold">(@lvl.Percentage%)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @(pos.TakeProfit.HasValue && pos.TakeProfit > 0 ? FormatTablePrice5(pos.TakeProfit.Value) : "--")
                                        }
                                    </td>
                                    <td class="p-3 font-mono font-black whitespace-nowrap" id="posPnl_@pos.Id">
                                        <div class="flex items-center gap-1.5">
                                            <span class="@(pos.UnrealizedPnl >= 0 ? "text-emerald-500" : "text-rose-500") text-sm" id="posPnlVal_@pos.Id">
                                                @FormatTablePnl5(pos.UnrealizedPnl)
                                            </span>
                                            <span class="text-3xs px-1.5 py-0.2 rounded font-extrabold @(roi >= 0 ? "bg-emerald-500/10 text-emerald-600" : "bg-rose-500/10 text-rose-600")" id="posRoiVal_@pos.Id">
                                                @(roi >= 0 ? "+" : "")@roi.ToString("N2")%
                                            </span>
                                        </div>
                                    </td>
                                    <td class="p-3 pr-4 text-right whitespace-nowrap space-x-1.5">
                                        <button type="button" onclick="openModifyModal('@pos.Id', '@pos.Symbol', '@pos.Side', '@pos.EntryPrice', '@pos.CurrentPrice', '@(pos.StopLoss ?? 0)', '@(pos.TakeProfit ?? 0)')"
                                                class="px-2.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold text-3xs transition-all border border-indigo-200 dark:border-indigo-800/40" title="Edit Stop Loss & Take Profit">
                                            <i class="fa-solid fa-pen-to-square mr-1"></i>Edit
                                        </button>
                                        <button type="button" onclick="ajaxClosePosition('@pos.Id', '@pos.Symbol')" class="px-3 py-1.5 rounded-xl bg-rose-500 hover:bg-rose-600 active:scale-95 text-white font-bold text-3xs transition-all shadow-2xs">
                                            Close Trade
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TAB 2: Pending Orders Table -->
        <div id="holdingPanelPending" class="hidden space-y-4">
            @if (Model.PendingOrders.Count == 0)
            {
                <div class="p-8 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 text-center space-y-1">
                    <p class="text-xs font-bold text-slate-500">No working limit or stop orders pending execution.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50/80 dark:bg-slate-800/50 text-slate-400 uppercase text-3xs font-black">
                            <tr>
                                <th class="p-3 pl-4 whitespace-nowrap">Asset</th>
                                <th class="p-3 whitespace-nowrap">Order Type</th>
                                <th class="p-3 whitespace-nowrap">Side</th>
                                <th class="p-3 whitespace-nowrap">Quantity</th>
                                <th class="p-3 whitespace-nowrap">Target Price</th>
                                <th class="p-3 whitespace-nowrap">TIF</th>
                                <th class="p-3 whitespace-nowrap">Placed At</th>
                                <th class="p-3 pr-4 text-right whitespace-nowrap">Cancel</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var ord in Model.PendingOrders)
                            {
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30" id="ordRow_@ord.Id">
                                    <td class="p-3 pl-4 font-black text-slate-900 dark:text-white whitespace-nowrap">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span>@ord.Symbol</span>
                                            <span class="px-1.5 py-0.5 rounded text-4xs font-extrabold uppercase @GetAssetBadgeClass(ord.AssetClass)">
                                                @GetAssetDisplayName(ord.AssetClass)
                                            </span>
                                        </div>
                                    </td>
                                    <td class="p-3 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-3xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">
                                            @ord.OrderType
                                        </span>
                                    </td>
                                    <td class="p-3 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-3xs font-extrabold whitespace-nowrap @(ord.Side == AzureTest.Domain.Entities.Trading.Enums.TradingOrderSide.Buy ? "text-emerald-500" : "text-rose-500")">
                                            @ord.Side
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono font-bold whitespace-nowrap">@FormatTableQty5(ord.Quantity)</td>
                                    <td class="p-3 font-mono font-black text-slate-900 dark:text-white whitespace-nowrap">
                                        @FormatTablePrice5(ord.Price ?? ord.TriggerPrice)
                                    </td>
                                    <td class="p-3 text-3xs text-slate-400 whitespace-nowrap">@ord.TimeInForce</td>
                                    <td class="p-3 text-3xs text-slate-400 whitespace-nowrap">@ord.PlacedAtUtc.ToString("HH:mm:ss")</td>
                                    <td class="p-3 pr-4 text-right whitespace-nowrap">
                                        <button type="button" onclick="ajaxCancelOrder('@ord.Id', '@ord.Symbol')" class="px-2.5 py-1 rounded-lg bg-slate-200 dark:bg-slate-700 hover:bg-rose-500 hover:text-white font-bold text-3xs transition-colors">
                                            Cancel
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TAB 3: Closed Trades & Profit/Loss History -->
        <div id="holdingPanelClosed" class="hidden space-y-4">
            @if (Model.ClosedPositions.Count == 0)
            {
                <div class="p-8 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 text-center space-y-1" id="emptyClosedState">
                    <p class="text-xs font-bold text-slate-500">No closed trades yet in your paper trading history.</p>
                </div>
            }
            <div id="closedPositionsTableWrapper" class="@(Model.ClosedPositions.Count == 0 ? "hidden" : "")">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50/80 dark:bg-slate-800/50 text-slate-400 uppercase text-3xs font-black">
                            <tr>
                                <th class="p-3 pl-4 whitespace-nowrap">Asset</th>
                                <th class="p-3 whitespace-nowrap">Side</th>
                                <th class="p-3 whitespace-nowrap">Quantity</th>
                                <th class="p-3 whitespace-nowrap">Entry Price</th>
                                <th class="p-3 whitespace-nowrap">Exit Price</th>
                                <th class="p-3 whitespace-nowrap font-black text-slate-700 dark:text-slate-300">Realized Profit / Loss (PnL)</th>
                                <th class="p-3 pr-4 text-right whitespace-nowrap">Closed At</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="closedPositionsTableBody">
                            @foreach (var c in Model.ClosedPositions)
                            {
                                var isWin = c.RealizedPnl >= 0;
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                                    <td class="p-3 pl-4 font-black text-slate-800 dark:text-slate-200 whitespace-nowrap">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span>@c.Symbol</span>
                                            <span class="px-1.5 py-0.5 rounded text-4xs font-extrabold uppercase @GetAssetBadgeClass(c.AssetClass)">
                                                @GetAssetDisplayName(c.AssetClass)
                                            </span>
                                        </div>
                                        <p class="text-3xs text-slate-400 truncate font-normal">@c.AssetName</p>
                                    </td>
                                    <td class="p-3 text-3xs font-extrabold whitespace-nowrap @(c.Side == AzureTest.Domain.Entities.Trading.Enums.TradingOrderSide.Buy ? "text-emerald-500" : "text-rose-500")">
                                        @c.Side
                                    </td>
                                    <td class="p-3 font-mono font-bold whitespace-nowrap">@FormatTableQty5(c.Quantity)</td>
                                    <td class="p-3 font-mono text-slate-600 dark:text-slate-400 whitespace-nowrap">@FormatTablePrice5(c.EntryPrice)</td>
                                    <td class="p-3 font-mono text-slate-900 dark:text-white font-bold whitespace-nowrap">@FormatTablePrice5(c.ClosePrice ?? c.CurrentPrice)</td>
                                    <td class="p-3 font-mono font-black whitespace-nowrap">
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-black @(isWin ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/30" : "bg-rose-500/10 text-rose-600 border border-rose-500/30")">
                                            @FormatTablePnl5(c.RealizedPnl)
                                        </span>
                                    </td>
                                    <td class="p-3 pr-4 text-right text-3xs text-slate-400 whitespace-nowrap">
                                        @((c.ClosedAtUtc ?? DateTime.UtcNow).ToString("yyyy-MM-dd HH:mm"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modify Position Modal (Edit Stop Loss & Take Profit) -->
<div id="modifyPositionModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-md w-full p-6 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4 animate-scale-in">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
            <h3 class="text-sm font-black text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-pen-to-square text-brand-500"></i>
                <span>Modify Position Protection (TP / SL)</span>
            </h3>
            <button type="button" onclick="closeModifyModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between text-xs">
            <div>
                <span class="text-3xs uppercase font-extrabold text-slate-400 block" id="modifyModalSideBadge">Long Position</span>
                <span class="text-sm font-black text-slate-900 dark:text-white font-mono" id="modifyModalSymbol">BTCUSDT</span>
            </div>
            <div class="text-right">
                <span class="text-3xs uppercase font-extrabold text-slate-400 block">Entry / Current Price</span>
                <span class="text-xs font-mono font-bold text-slate-700 dark:text-slate-300" id="modifyModalPrices">$0.00000 / $0.00000</span>
            </div>
        </div>

        <form id="modifyPositionForm" onsubmit="submitModifyPosition(event)" class="space-y-4">
            <input type="hidden" id="modifyPosId" name="positionId" />
            <input type="hidden" id="modifyPosSymbol" name="symbol" />
            <input type="hidden" id="modifyPosSide" />
            <input type="hidden" id="modifyPosCurrentPrice" />

            <!-- Stop Loss -->
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                        <span>Stop Loss (SL)</span>
                    </label>
                    <button type="button" onclick="document.getElementById('modifyPosSlInput').value = ''" class="text-3xs text-rose-500 hover:underline font-bold">Clear SL</button>
                </div>
                <input type="text" inputmode="decimal" id="modifyPosSlInput" name="stopLoss" placeholder="Leave blank to remove Stop Loss"
                       class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 font-mono font-bold focus:border-brand-500 focus:outline-none" />
                <p class="text-4xs text-slate-400 mt-1" id="modifySlHint">Price to automatically close trade and prevent loss.</p>
            </div>

            <!-- Take Profit Targets (Multi-Level Target Protection) -->
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>Take Profit Target(s)</span>
                    </label>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="addModifyTpLevel()" id="btnAddModifyTpLevel"
                                class="text-3xs px-2 py-0.5 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500 hover:text-white transition-colors font-bold inline-flex items-center gap-1">
                            <i class="fa-solid fa-plus text-4xs"></i> Add Level
                        </button>
                        <button type="button" onclick="clearModifyTpLevels()" class="text-3xs text-emerald-500 hover:underline font-bold">
                            Clear All
                        </button>
                    </div>
