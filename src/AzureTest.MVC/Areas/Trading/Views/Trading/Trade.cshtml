                                            <span>@pos.Side</span>
                                            <span class="opacity-80 font-mono">@pos.Leverage&times;</span>
                                        </div>
                                    </td>
                                    <td class="p-3 font-mono font-bold text-slate-800 dark:text-slate-200 whitespace-nowrap">
