                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-20 w-52 p-1.5 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Text')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold">Text</button>
                    <button type="button" onclick="selectTool('Anchored Text')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Anchored Text</button>
                    <button type="button" onclick="selectTool('Note')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Note</button>
                    <button type="button" onclick="selectTool('Price Note')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Price Note</button>
                    <button type="button" onclick="selectTool('Pin')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Pin</button>
                    <button type="button" onclick="selectTool('Table')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Table</button>
                    <button type="button" onclick="selectTool('Callout')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Callout</button>
                    <button type="button" onclick="selectTool('Comment')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Comment</button>
                    <button type="button" onclick="selectTool('Price Label')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Price Label</button>
                    <button type="button" onclick="selectTool('Signpost')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Signpost</button>
                    <button type="button" onclick="selectTool('Flag Mark')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Flag Mark</button>
                    <button type="button" onclick="selectTool('Image')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Image</button>
                    <button type="button" onclick="selectTool('Tweet')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Tweet</button>
                    <button type="button" onclick="selectTool('Idea')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Idea</button>
