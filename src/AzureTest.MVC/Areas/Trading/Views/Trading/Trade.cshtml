@model AzureTest.Contracts.DTOs.Trading.TradingDashboardDto
@{
    var selected = Model.SelectedQuote;
    ViewData["Title"] = $"{selected.Symbol} - Trade & Pro Chart";
    var account = Model.Account;
    var openForSymbol = Model.OpenPositions.Where(p => p.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase)).ToList();
    var pendingForSymbol = Model.PendingOrders.Where(o => o.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase)).ToList();
    var totalUnrealizedPnl = Model.OpenPositions.Sum(p => p.UnrealizedPnl);
}

@functions {
    string GetAssetBadgeClass(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) => assetClass switch
    {
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Crypto => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Forex => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock => "bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index => "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700"
    };

    string GetAssetDisplayName(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) => assetClass switch
    {
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Crypto => "Crypto",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Forex => "Forex",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock => "Stock",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index => "Indices",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future => "Futures",
        _ => assetClass.ToString()
    };

    bool IsSimulatedFeed(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) =>
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock ||
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index ||
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future;
}

<div class="space-y-6 pb-12 font-sans">
    <!-- Dynamic Alert Toasts / Notification Container -->
    <div id="dynamicAlertContainer" class="space-y-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-check text-lg text-emerald-500"></i>
                    <div>
                        <strong class="font-bold text-xs uppercase tracking-wider">Success</strong>
                        <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-0.5">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-exclamation text-lg text-rose-500"></i>
                    <div>
                        <strong class="font-bold text-xs uppercase tracking-wider">Execution Error</strong>
                        <p class="text-xs text-rose-600 dark:text-rose-400 mt-0.5">@TempData["ErrorMessage"]</p>
                    </div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>

    <!-- Top Asset Bar & Navigation -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="w-10 h-10 rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors" title="Back to Watchlist & Portfolio">
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </a>

            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight" id="terminalSymbolTitle">@selected.Symbol</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-3xs font-extrabold uppercase tracking-wide @GetAssetBadgeClass(selected.AssetClass)">
                        @GetAssetDisplayName(selected.AssetClass)
                    </span>
                    @if (selected.IsSimulated || IsSimulatedFeed(selected.AssetClass))
                    {
                        <span class="px-2 py-0.5 rounded-lg text-4xs font-black uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center gap-1 shadow-2xs">
                            <i class="fa-solid fa-flask text-amber-500"></i>
                            <span>Simulate</span>
                        </span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded-lg text-4xs font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1 shadow-2xs">
                            <i class="fa-solid fa-satellite-dish text-emerald-500 animate-pulse"></i>
                            <span>Live API</span>
                        </span>
                    }
                    <!-- Watchlist Toggle Button (AJAX Icon) -->
                    <button type="button" 
                            id="tradeWatchlistBtn"
                            onclick="toggleTradeWatchlist('@selected.Symbol', '@selected.AssetName.Replace("'", "\\'")', @((int)selected.AssetClass))"
                            class="w-8 h-8 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-amber-400 bg-white dark:bg-slate-800 flex items-center justify-center transition-all shadow-2xs hover:scale-105"
                            title="@(selected.IsWatchlisted ? "Remove from watchlist" : "Add to watchlist")">
                        <i id="tradeWatchlistIcon" class="@(selected.IsWatchlisted ? "fa-solid fa-star text-amber-500" : "fa-regular fa-star text-slate-400 hover:text-amber-500") text-sm"></i>
                    </button>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@selected.AssetName</p>
            </div>
        </div>

        <!-- Live Price & Statistics Strip -->
        <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60">
                <span class="text-3xs uppercase font-extrabold text-slate-400 tracking-wider block">Live Market Price</span>
                <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white transition-colors" id="liveTickerPrice">
                        $@selected.Price.ToString("N2")
                    </span>
                    <span class="px-2 py-0.5 rounded-md text-2xs font-extrabold @(selected.ChangePercent24h >= 0 ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" : "bg-rose-500/10 text-rose-600 border border-rose-500/20")" id="liveTickerChange">
                        @(selected.ChangePercent24h >= 0 ? "+" : "")@selected.ChangePercent24h.ToString("N2")%
                    </span>
                </div>
            </div>

            <!-- Available Margin Badge -->
            <div class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/20">
                <span class="text-3xs uppercase font-extrabold text-emerald-600 dark:text-emerald-400 tracking-wider block">Available Margin</span>
                <div class="text-lg sm:text-xl font-black text-emerald-600 dark:text-emerald-400 mt-0.5" id="topAvailableMarginDisplay">
                    $@account.FreeMargin.ToString("N2")
                </div>
            </div>

            <div class="hidden sm:block text-xs space-y-0.5 text-slate-500 dark:text-slate-400">
                <div>24h High: <strong class="text-slate-800 dark:text-slate-200" id="liveHighDisplay">$@selected.High24h.ToString("N2")</strong></div>
                <div>24h Low: <strong class="text-slate-800 dark:text-slate-200" id="liveLowDisplay">$@selected.Low24h.ToString("N2")</strong></div>
            </div>

            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full @(selected.IsSimulated || IsSimulatedFeed(selected.AssetClass) ? "bg-amber-500" : "bg-emerald-500") animate-pulse" id="syncStatusDot"></span>
                <span class="text-3xs font-extrabold text-slate-500 dark:text-slate-400 uppercase tracking-wider" id="syncStatusLabel">
                    @(selected.IsSimulated || IsSimulatedFeed(selected.AssetClass) ? "Simulate Sync" : "Live API Sync")
                </span>
            </div>
        </div>
    </div>

    <!-- TOP SECTION: Interactive Professional Chart with Official TradingView Widget & Canvas Engine -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-5 shadow-xs space-y-4">
        <!-- Chart Controls Header -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
            <!-- Left: Chart Engine Mode Switcher -->
            <div class="flex items-center gap-2 flex-wrap">
                <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl text-3xs font-extrabold">
                    <button type="button" onclick="switchChartEngine('tradingview')" id="btnTvEngine" class="px-3 py-1.5 rounded-lg active bg-brand-500 text-white shadow-2xs transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>TradingView Pro Live</span>
                    </button>
                    <button type="button" onclick="switchChartEngine('canvas')" id="btnCanvasEngine" class="px-3 py-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-palette"></i>
                        <span>Canvas Studio</span>
                    </button>
                </div>

                <!-- Canvas Timeframe Pills (shown in canvas mode) -->
                <div id="canvasTfGroup" class="hidden flex items-center gap-1 text-3xs font-bold bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                    <button type="button" onclick="setTimeframe('1m')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1m">1m</button>
                    <button type="button" onclick="setTimeframe('5m')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="5m">5m</button>
                    <button type="button" onclick="setTimeframe('15m')" class="tf-btn px-2.5 py-1 rounded-lg active bg-brand-500 text-white" data-tf="15m">15m</button>
                    <button type="button" onclick="setTimeframe('1h')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1h">1h</button>
                    <button type="button" onclick="setTimeframe('4h')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="4h">4h</button>
                    <button type="button" onclick="setTimeframe('1D')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1D">1D</button>
                </div>
            </div>

            <!-- Right: Chart Height & Fullscreen Resizers -->
            <div class="flex items-center gap-2 flex-wrap text-3xs font-bold">
                <span class="text-slate-400 uppercase font-extrabold mr-1">Height:</span>
                <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                    <button type="button" onclick="setChartHeight(440)" class="chart-h-btn px-2 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-all text-slate-600 dark:text-slate-400" data-h="440">440px</button>
                    <button type="button" onclick="setChartHeight(560)" class="chart-h-btn px-2 py-1 rounded-lg active bg-white dark:bg-slate-700 text-brand-600 dark:text-brand-400 shadow-2xs transition-all font-black" data-h="560">560px</button>
                    <button type="button" onclick="setChartHeight(700)" class="chart-h-btn px-2 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-all text-slate-600 dark:text-slate-400" data-h="700">700px</button>
                    <button type="button" onclick="toggleChartFullscreen()" class="px-2 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-all text-slate-700 dark:text-slate-300" title="Fullscreen Mode">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                </div>

                <!-- Canvas Style & Indicators Controls (only in Canvas mode) -->
                <div id="canvasExtrasGroup" class="hidden flex items-center gap-2">
                    <select id="chartStyleSelect" onchange="setChartStyle(this.value)" class="text-xs font-bold px-2 py-1 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-700 dark:text-slate-300 focus:outline-none">
                        <option value="candles">Candles</option>
                        <option value="hollow">Hollow</option>
                        <option value="heikin">Heikin-Ashi</option>
                        <option value="line">Line</option>
                        <option value="area">Area</option>
                    </select>

                    <button type="button" onclick="toggleIndicator('ema20')" id="btnEma20" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">EMA20</button>
                    <button type="button" onclick="toggleIndicator('bollinger')" id="btnBollinger" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">BB</button>
                    <button type="button" onclick="toggleIndicator('volume')" id="btnVolume" class="px-2 py-1 rounded-lg border border-brand-500 bg-brand-500 text-white">Vol</button>
                </div>
            </div>
        </div>

        <!-- Drawing Tools Toolbar (Visible when Canvas Studio is active, completely above the chart with z-50) -->
        <div id="canvasToolbar" class="hidden relative z-50 flex flex-wrap items-center gap-2 pb-2 text-3xs">
            <span class="text-slate-400 font-extrabold uppercase shrink-0"><i class="fa-solid fa-paintbrush mr-1"></i> Tools:</span>

            <!-- Lines & Channels -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-arrows-left-right text-brand-500"></i>
                    <span>Lines &amp; Channels</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-50 w-52 p-2 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Trend Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Trend Line</button>
                    <button type="button" onclick="selectTool('Ray')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Ray</button>
                    <button type="button" onclick="selectTool('Horizontal Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-brand-600">Horizontal Line</button>
                    <button type="button" onclick="selectTool('Vertical Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Vertical Line</button>
                    <button type="button" onclick="selectTool('Parallel Channel')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-amber-500">Parallel Channel</button>
                </div>
            </div>

            <!-- Gann & Fibonacci -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-calculator text-amber-500"></i>
                    <span>Fibonacci</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-50 w-52 p-2 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Fib Retracement')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-amber-600">Fib Retracement</button>
                    <button type="button" onclick="selectTool('Trend-Based Fib')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Trend-Based Fib</button>
                    <button type="button" onclick="selectTool('Fib Channel')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Channel</button>
                </div>
            </div>

            <!-- Risk Management Forecast -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-ruler-combined text-emerald-500"></i>
                    <span>Risk Forecast</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl z-50 w-52 p-2 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Long Position')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-emerald-600">Long Position (Target/SL)</button>
                    <button type="button" onclick="selectTool('Short Position')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-rose-600">Short Position (Target/SL)</button>
                    <button type="button" onclick="selectTool('Price Range')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Price Range Measure</button>
                </div>
            </div>

            <button type="button" onclick="clearDrawings()" class="px-2.5 py-1.5 rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold hover:bg-rose-100 shrink-0">
                <i class="fa-solid fa-trash-can mr-1"></i> Clear Tools
            </button>
        </div>

        <!-- Main Chart Display Container (Resizable & Fullscreen Capable) -->
        <div id="chartMainContainer" class="relative w-full h-[560px] bg-slate-950 rounded-2xl overflow-hidden border border-slate-800 shadow-inner transition-all">
            <!-- 1. Official TradingView Real-Time Embed Widget (Live Interactive with Pan, Zoom, Multi-Timeframe) -->
            <div id="tradingview_widget" class="w-full h-full"></div>

            <!-- 2. Interactive Canvas Chart (Studio Fallback / Mode) -->
            <canvas id="tradingCanvas" class="hidden w-full h-full cursor-crosshair block"></canvas>

            <!-- Chart Watermark for Canvas Mode -->
            <div id="chartWatermark" class="hidden absolute left-6 bottom-6 pointer-events-none font-mono font-black text-slate-800/30 text-6xl select-none">
                @selected.Symbol
            </div>

            <!-- Hover Bar Stats for Canvas Mode -->
            <div id="canvasStatsPill" class="hidden absolute top-3 left-4 px-3 py-1.5 rounded-xl bg-slate-900/80 backdrop-blur-md border border-slate-700/60 text-white font-mono text-3xs flex items-center gap-3 pointer-events-none z-10">
                <span>O: <strong id="hoverO" class="text-emerald-400">--</strong></span>
                <span>H: <strong id="hoverH" class="text-slate-200">--</strong></span>
                <span>L: <strong id="hoverL" class="text-rose-400">--</strong></span>
                <span>C: <strong id="hoverC" class="text-emerald-400">--</strong></span>
            </div>

            <!-- Bottom Left Canvas Usage Guide -->
            <div id="canvasGuidePill" class="hidden absolute left-4 bottom-3 z-10 pointer-events-none text-4xs font-mono text-slate-500 bg-slate-900/70 px-2.5 py-1 rounded-lg flex items-center gap-2">
                <span><i class="fa-solid fa-computer-mouse mr-1"></i> Scroll = Zoom</span>
                <span>• Drag = Pan</span>
                <span>• Crosshair active</span>
            </div>

            <!-- Active Drawing Tool Label -->
            <div id="activeToolBanner" class="hidden absolute top-3 right-4 px-3 py-1 rounded-lg bg-brand-500 text-white font-bold text-3xs shadow-md pointer-events-none z-20">
                Active Tool: <span id="activeToolName">Trend Line</span>
            </div>
        </div>
    </div>

    <!-- BOTTOM SECTION: Buy / Sell Order Terminal with UIComponent Tabs & iOS Plain English Switch -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-wallet text-brand-500"></i>
                    <span>Order Execution Terminal</span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Execute simulated market, limit, or stop positions with multi-level profit taking and loss protection.
                </p>
            </div>

            <!-- UIComponent iOS Switch Button: Plain English (Simple Mode) vs Professional Buzzwords -->
            <div class="flex items-center gap-3 p-2 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60">
                <div class="text-right">
                    <span class="text-xs font-black text-slate-800 dark:text-slate-200 block" id="modeTitleLabel">Plain English Mode</span>
                    <span class="text-3xs text-slate-400 block" id="modeSubtitleLabel">Beginner-friendly field names</span>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="terminologyToggle" onchange="toggleTerminology(this.checked)" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-brand-500"></div>
                </label>
            </div>
        </div>

        <!-- Account Margin Overview KPI Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800">
            <div>
                <span class="text-3xs uppercase font-extrabold text-slate-400 block tracking-wider">Available Margin</span>
                <div class="text-base sm:text-lg font-black text-emerald-600 dark:text-emerald-400 mt-0.5" id="availMarginCardDisplay">
                    $@account.FreeMargin.ToString("N2")
                </div>
            </div>
            <div>
                <span class="text-3xs uppercase font-extrabold text-slate-400 block tracking-wider">Cash Balance</span>
                <div class="text-base sm:text-lg font-black text-slate-800 dark:text-slate-200 mt-0.5" id="cashBalanceCardDisplay">
                    $@account.CashBalance.ToString("N2")
                </div>
            </div>
            <div>
                <span class="text-3xs uppercase font-extrabold text-slate-400 block tracking-wider">Used Margin</span>
                <div class="text-base sm:text-lg font-black text-slate-800 dark:text-slate-200 mt-0.5" id="marginUsedCardDisplay">
                    $@account.MarginUsed.ToString("N2")
                </div>
            </div>
            <div>
                <span class="text-3xs uppercase font-extrabold text-slate-400 block tracking-wider">Total Equity</span>
                <div class="text-base sm:text-lg font-black text-brand-600 dark:text-brand-400 mt-0.5" id="equityCardDisplay">
                    $@account.Equity.ToString("N2")
                </div>
            </div>
        </div>

        <!-- UIComponent Group Tab: Market | Limit | Stop -->
        <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
            <button type="button" onclick="setOrderTab('market')" id="tabMarket" class="order-type-tab px-4 py-2 rounded-xl text-xs font-black bg-brand-500 text-white shadow-xs transition-all">
                Market Order
            </button>
            <button type="button" onclick="setOrderTab('limit')" id="tabLimit" class="order-type-tab px-4 py-2 rounded-xl text-xs font-black bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 transition-all">
                Limit Order
            </button>
            <button type="button" onclick="setOrderTab('stop')" id="tabStop" class="order-type-tab px-4 py-2 rounded-xl text-xs font-black bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 transition-all">
                Stop Order
            </button>
        </div>

        <!-- Order Form Submission -->
        <form asp-action="PlaceOrder" method="post" id="tradingOrderForm" class="space-y-6">
            <input type="hidden" name="symbol" value="@selected.Symbol" />
            <input type="hidden" name="assetName" value="@selected.AssetName" />
            <input type="hidden" name="assetClass" value="@((int)selected.AssetClass)" />
            <input type="hidden" name="side" id="formOrderSide" value="1" /> <!-- 1 = Buy, 2 = Sell -->
            <input type="hidden" name="orderType" id="formOrderType" value="1" /> <!-- 1 = Market, 2 = Limit, 3 = Stop -->
            <input type="hidden" name="multipleTakeProfitsJson" id="formMultiTpJson" value="" />
            <input type="hidden" name="quantity" id="orderQuantityInput" value="1" />

            <!-- Price & Order Duration Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Market Execution Price Display (Market Tab) -->
                <div id="marketPriceGroup" class="space-y-1.5">
                    <label class="text-xs font-bold text-slate-600 dark:text-slate-300">Market Execution Price</label>
                    <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-800 font-mono font-black text-slate-800 dark:text-white flex items-center justify-between border border-slate-200 dark:border-slate-700">
                        <span id="marketOrderPriceDisplay">$@selected.Price.ToString("N2")</span>
                        <span class="text-3xs uppercase font-extrabold text-emerald-500 flex items-center gap-1">
                            <i class="fa-solid fa-bolt"></i> Instant Fill
                        </span>
                    </div>
                </div>

                <!-- Limit Price Input (Limit Tab) -->
                <div id="priceInputGroup" class="hidden space-y-1.5">
                    <div class="flex justify-between items-center text-xs font-bold text-slate-600 dark:text-slate-300">
                        <label class="term-price-label">Desired Purchase Price ($)</label>
                        <button type="button" onclick="setLimitToMarket()" class="text-3xs font-extrabold text-brand-500 hover:underline">
                            Market: $<span id="limitMarketHint">@selected.Price.ToString("N2")</span>
                        </button>
                    </div>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-sm">$</span>
                        <input type="number" step="any" name="price" id="orderPriceInput" value="@selected.Price"
                               oninput="recalculateAllSizeAndMargin()"
                               class="w-full pl-8 pr-4 py-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none" />
                    </div>
                </div>

                <!-- Stop Trigger Price Input (Stop Tab) -->
                <div id="stopTriggerInputGroup" class="hidden space-y-1.5">
                    <div class="flex justify-between items-center text-xs font-bold text-slate-600 dark:text-slate-300">
                        <label class="term-trigger-label">Trigger Price ($)</label>
                        <button type="button" onclick="setStopToMarket()" class="text-3xs font-extrabold text-brand-500 hover:underline">
                            Current: $<span id="stopMarketHint">@selected.Price.ToString("N2")</span>
                        </button>
                    </div>
                    <div class="relative">
                        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-sm">$</span>
                        <input type="number" step="any" name="triggerPrice" id="orderTriggerPriceInput" value="@selected.Price"
                               oninput="recalculateAllSizeAndMargin()"
                               class="w-full pl-8 pr-4 py-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono font-bold text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none" />
                    </div>
                </div>

                <!-- Time in Force (TIF) -->
                <div id="tifGroup" class="hidden space-y-1.5">
                    <label class="term-tif-label text-xs font-bold text-slate-600 dark:text-slate-300">How Long Order Stays Open</label>
                    <select name="timeInForce" id="orderTifSelect" class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
                        <option value="1">Good 'Til Cancelled (GTC)</option>
                        <option value="2">Immediate Or Cancel (IOC)</option>
                        <option value="3">Fill Or Kill (FOK)</option>
                        <option value="4">Day Order (Expires at Midnight)</option>
                    </select>
                </div>
            </div>

            <!-- Multi-Unit Type Input & Trade Size Slider Card -->
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <span class="term-quantity-label text-xs font-black text-slate-700 dark:text-slate-300 uppercase tracking-wide">
                        Order Size &amp; Units
                    </span>
                    
                    <!-- Multi-Unit Mode Switcher (Units | USD Margin | % Balance | Total Value) -->
                    <div class="flex items-center gap-1 bg-white dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700 text-3xs font-extrabold">
                        <button type="button" onclick="setTradeSizeMode('units')" id="sizeModeBtnUnits" class="size-mode-btn px-2.5 py-1 rounded-lg bg-brand-500 text-white shadow-2xs transition-all">
                            Units
                        </button>
                        <button type="button" onclick="setTradeSizeMode('margin')" id="sizeModeBtnMargin" class="size-mode-btn px-2.5 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 transition-all">
                            USD Margin ($)
                        </button>
                        <button type="button" onclick="setTradeSizeMode('percent')" id="sizeModeBtnPercent" class="size-mode-btn px-2.5 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 transition-all">
                            % Balance
                        </button>
                        <button type="button" onclick="setTradeSizeMode('total')" id="sizeModeBtnTotal" class="size-mode-btn px-2.5 py-1 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 transition-all">
                            Total Value ($)
                        </button>
                    </div>
                </div>

                <!-- Main Input Field -->
                <div class="relative">
                    <span id="mainInputPrefix" class="hidden absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-sm">$</span>
                    <input type="number" step="any" min="0.000001" id="orderSizeMainInput" value="1.0"
                           oninput="onMainSizeInputChange(this.value)"
                           class="w-full px-4 py-3 rounded-2xl border border-slate-300 dark:border-slate-600 dark:bg-slate-800 text-slate-900 dark:text-white font-mono font-black text-base focus:ring-2 focus:ring-brand-500 focus:outline-none" />
                    <span id="mainInputSuffix" class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-black text-slate-400">@selected.Symbol</span>
                </div>

                <!-- Slider for Trade Value (1% - 100% of Available Margin) -->
                <div class="space-y-2 pt-1">
                    <div class="flex justify-between items-center text-3xs font-extrabold text-slate-400">
                        <span>Trade Size Slider (% Available Margin):</span>
                        <span id="tradeValueSliderLabel" class="font-mono text-brand-600 dark:text-brand-400 font-black">10%</span>
                    </div>
                    <input type="range" min="1" max="100" value="10" id="tradeValueSlider"
                           oninput="onTradeValueSliderChange(this.value)"
                           class="w-full accent-brand-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                    <div class="flex items-center justify-between text-3xs font-extrabold text-slate-400">
                        <button type="button" onclick="setSliderPreset(10)" class="hover:text-brand-500">10%</button>
                        <button type="button" onclick="setSliderPreset(25)" class="hover:text-brand-500">25%</button>
                        <button type="button" onclick="setSliderPreset(50)" class="hover:text-brand-500">50%</button>
                        <button type="button" onclick="setSliderPreset(75)" class="hover:text-brand-500">75%</button>
                        <button type="button" onclick="setSliderPreset(100)" class="hover:text-brand-500 text-amber-500 font-black">100% (Max)</button>
                    </div>
                </div>

                <!-- Real-Time Calculated Conversions Strip -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-slate-200/60 dark:border-slate-700/60 text-xs">
                    <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700">
                        <span class="text-3xs uppercase font-extrabold text-slate-400 block">📦 Units</span>
                        <div class="font-mono font-black text-slate-900 dark:text-white mt-0.5 truncate" id="calcUnitsDisplay">
                            1.0000 <span class="text-3xs font-bold text-slate-400">@selected.Symbol</span>
                        </div>
                    </div>
                    <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700">
                        <span class="text-3xs uppercase font-extrabold text-slate-400 block">💵 USD Margin</span>
                        <div class="font-mono font-black text-emerald-600 dark:text-emerald-400 mt-0.5 truncate" id="calcMarginDisplay">
                            $0.00
                        </div>
                    </div>
                    <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700">
                        <span class="text-3xs uppercase font-extrabold text-slate-400 block">📊 % Balance</span>
                        <div class="font-mono font-black text-blue-600 dark:text-blue-400 mt-0.5 truncate" id="calcBalancePctDisplay">
                            0.00%
                        </div>
                    </div>
                    <div class="p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700">
                        <span class="text-3xs uppercase font-extrabold text-slate-400 block">🏷️ Total Value</span>
                        <div class="font-mono font-black text-brand-600 dark:text-brand-400 mt-0.5 truncate" id="calcTotalValueDisplay">
                            $0.00
                        </div>
                    </div>
                </div>
            </div>

            <!-- Leverage Multiplier Slider Card (1x to 250x) -->
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 space-y-3">
                <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300">
                    <span class="term-leverage-label flex items-center gap-1.5 font-black uppercase tracking-wide">
                        <i class="fa-solid fa-bolt text-amber-500"></i>
                        <span>Leverage Multiplier</span>
                    </span>
                    <div class="flex items-center gap-2">
                        <span class="text-3xs uppercase font-bold text-slate-400">Multiplier:</span>
                        <span id="leverageDisplay" class="px-2.5 py-0.5 rounded-lg bg-brand-500 text-white font-mono font-black text-xs shadow-2xs">1x</span>
                    </div>
                </div>
                <input type="range" min="1" max="250" value="1" name="leverage" id="orderLeverageInput"
                       oninput="updateLeverage(this.value)"
                       class="w-full accent-brand-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                <div class="flex flex-wrap items-center justify-between gap-1 text-3xs font-extrabold text-slate-400">
                    <button type="button" onclick="setLeveragePreset(1)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">1x</button>
                    <button type="button" onclick="setLeveragePreset(2)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">2x</button>
                    <button type="button" onclick="setLeveragePreset(5)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">5x</button>
                    <button type="button" onclick="setLeveragePreset(10)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">10x</button>
                    <button type="button" onclick="setLeveragePreset(20)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">20x</button>
                    <button type="button" onclick="setLeveragePreset(50)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">50x</button>
                    <button type="button" onclick="setLeveragePreset(100)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">100x</button>
                    <button type="button" onclick="setLeveragePreset(150)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">150x</button>
                    <button type="button" onclick="setLeveragePreset(200)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">200x</button>
                    <button type="button" onclick="setLeveragePreset(250)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors font-black text-brand-600 dark:text-brand-400">250x</button>
                </div>
            </div>

            <!-- Exit Management Section: Take Profit & Stop Loss with iOS ON/OFF Switches -->
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-2">
                    <h4 class="text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-emerald-500"></i>
                        <span class="term-exit-header">Target Profit &amp; Loss Protection</span>
                    </h4>
                    <!-- Quick R:R Pre-set Buttons -->
                    <div class="flex items-center gap-1.5 text-3xs">
                        <span class="text-slate-400 font-bold uppercase mr-1">R:R:</span>
                        <button type="button" onclick="setQuickRr(1.5)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 hover:bg-brand-500 hover:text-white transition-colors">1:1.5</button>
                        <button type="button" onclick="setQuickRr(2.0)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 hover:bg-brand-500 hover:text-white transition-colors">1:2</button>
                        <button type="button" onclick="setQuickRr(3.0)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 hover:bg-brand-500 hover:text-white transition-colors">1:3</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Take Profit Box with iOS Switch -->
                    <div class="p-4 rounded-xl border border-slate-200/80 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <span class="term-tp-label">Profit Goal (Sell when up)</span>
                            </span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="tpToggleSwitch" checked onchange="toggleTpEnabled(this.checked)" class="sr-only peer" />
                                <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:bg-emerald-500"></div>
                            </label>
                        </div>

                        <div id="tpInputsContainer" class="space-y-2 transition-opacity">
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-xs">$</span>
                                <input type="number" step="any" name="takeProfit" id="orderTakeProfitInput"
                                       value="@((selected.Price * 1.05m).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                       oninput="calculateRiskRewardOutputs()"
                                       class="w-full pl-7 pr-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                            </div>

                            <div class="flex justify-between items-center text-3xs font-bold text-slate-400">
                                <span>Estimated Reward:</span>
                                <span id="tpRewardSummary" class="text-emerald-600 font-mono font-black">+$0.00 (+5.00%)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Stop Loss Box with iOS Switch -->
                    <div class="p-4 rounded-xl border border-slate-200/80 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                <span class="term-sl-label">Safety Stop (Sell if down)</span>
                            </span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="slToggleSwitch" checked onchange="toggleSlEnabled(this.checked)" class="sr-only peer" />
                                <div class="w-9 h-5 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:bg-rose-500"></div>
                            </label>
                        </div>

                        <div id="slInputsContainer" class="space-y-2 transition-opacity">
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-xs">$</span>
                                <input type="number" step="any" name="stopLoss" id="orderStopLossInput"
                                       value="@((selected.Price * 0.97m).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                       oninput="calculateRiskRewardOutputs()"
                                       class="w-full pl-7 pr-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-rose-500 focus:outline-none" />
                            </div>

                            <div class="flex justify-between items-center text-3xs font-bold text-slate-400">
                                <span>Estimated Risk:</span>
                                <span id="slRiskSummary" class="text-rose-600 font-mono font-black">-$0.00 (-3.00%)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Action Buttons (Buy / Long vs Sell / Short) -->
            <div class="grid grid-cols-2 gap-4 pt-2">
                <button type="button" id="buyOrderSubmitBtn" onclick="submitOrder(1)" class="py-4 rounded-2xl bg-emerald-500 hover:bg-emerald-600 active:scale-[0.99] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                    <span id="buyBtnLabel">Buy (Long Position)</span>
                </button>
                <button type="button" id="sellOrderSubmitBtn" onclick="submitOrder(2)" class="py-4 rounded-2xl bg-rose-500 hover:bg-rose-600 active:scale-[0.99] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-trend-down"></i>
                    <span id="sellBtnLabel">Sell (Short Position)</span>
                </button>
            </div>
        </form>
    </div>

    <!-- BOTTOM SECTION: Comprehensive Portfolio, Holdings & Profit/Loss Trade Terminal -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div>
                <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-layer-group text-brand-500"></i>
                    <span>Portfolio Terminal &amp; Trade Monitor</span>
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Live profit and loss tracking for all active holdings and completed trades.
                </p>
            </div>

            <!-- Station Tab Switchers -->
            <div class="flex items-center gap-1.5 bg-slate-100 dark:bg-slate-800 p-1.5 rounded-2xl text-xs font-black">
                <button type="button" onclick="switchHoldingTab('open')" id="tabHoldingOpen" class="holding-tab-btn px-4 py-2 rounded-xl active bg-brand-500 text-white shadow-2xs transition-all flex items-center gap-1.5">
                    <span>Open Positions</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-white/20 text-3xs font-extrabold" id="openCountBadge">@Model.OpenPositions.Count</span>
                </button>
                <button type="button" onclick="switchHoldingTab('pending')" id="tabHoldingPending" class="holding-tab-btn px-4 py-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-slate-900 transition-all flex items-center gap-1.5">
                    <span>Pending Orders</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-slate-200 dark:bg-slate-700 text-3xs font-extrabold">@Model.PendingOrders.Count</span>
                </button>
                <button type="button" onclick="switchHoldingTab('closed')" id="tabHoldingClosed" class="holding-tab-btn px-4 py-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-slate-900 transition-all flex items-center gap-1.5">
                    <span>Closed Trades (PnL)</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-slate-200 dark:bg-slate-700 text-3xs font-extrabold">@Model.ClosedPositions.Count</span>
                </button>
            </div>
        </div>

        <!-- TAB 1: Open Positions Table -->
        <div id="holdingPanelOpen" class="space-y-4">
            <!-- Filter Toggle: All vs Current Symbol Only -->
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-3xs uppercase font-extrabold text-slate-400 tracking-wider">Scope:</span>
                    <button type="button" onclick="filterPositionsView('all')" id="btnPosFilterAll" class="pos-filter-btn px-3 py-1 rounded-lg text-xs font-black bg-slate-100 dark:bg-slate-800 text-brand-600 dark:text-brand-400 border border-brand-500/30">
                        All Assets (@Model.OpenPositions.Count)
                    </button>
                    <button type="button" onclick="filterPositionsView('current')" id="btnPosFilterCurrent" class="pos-filter-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200">
                        @selected.Symbol Only (@openForSymbol.Count)
                    </button>
                </div>
                
                <div class="text-xs font-black text-slate-700 dark:text-slate-300">
                    Total Unrealized PnL: 
                    <strong class="@(totalUnrealizedPnl >= 0 ? "text-emerald-500" : "text-rose-500") font-mono" id="totalPnlSummaryBadge">
                        @(totalUnrealizedPnl >= 0 ? "+" : "")$@totalUnrealizedPnl.ToString("N2")
                    </strong>
                </div>
            </div>

            @if (Model.OpenPositions.Count == 0)
            {
                <div class="p-10 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 text-center space-y-2">
                    <div class="w-12 h-12 rounded-2xl bg-brand-500/10 text-brand-500 mx-auto flex items-center justify-center text-xl">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <h5 class="text-sm font-black text-slate-800 dark:text-slate-200">No Open Positions Currently</h5>
                    <p class="text-xs text-slate-400 max-w-sm mx-auto">
                        Place a Buy (Long) or Sell (Short) order above to start testing your strategy with real-time profit and loss tracking.
                    </p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50/80 dark:bg-slate-800/50 text-slate-400 uppercase text-3xs font-black">
                            <tr>
                                <th class="p-3 pl-4">Asset</th>
                                <th class="p-3">Side &amp; Lev</th>
                                <th class="p-3">Quantity</th>
                                <th class="p-3">Entry Price</th>
                                <th class="p-3">Mark Price</th>
                                <th class="p-3">Margin</th>
                                <th class="p-3">Stop Loss</th>
                                <th class="p-3">Take Profit</th>
                                <th class="p-3 font-black text-slate-700 dark:text-slate-300">Profit / Loss (PnL)</th>
                                <th class="p-3 pr-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800" id="openPositionsTableBody">
                            @foreach (var pos in Model.OpenPositions)
                            {
                                var isCurrentSym = pos.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase);
                                var roi = pos.InitialMargin > 0 ? (pos.UnrealizedPnl / pos.InitialMargin) * 100m : 0m;
                                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors pos-row @(isCurrentSym ? "bg-brand-500/5" : "")" data-symbol="@pos.Symbol">
                                    <td class="p-3 pl-4 font-black text-slate-900 dark:text-white">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <a asp-action="Trade" asp-route-symbol="@pos.Symbol" class="hover:text-brand-500 transition-colors underline-offset-2 hover:underline">
                                                @pos.Symbol
                                            </a>
                                            <span class="px-1.5 py-0.5 rounded text-4xs font-extrabold uppercase @GetAssetBadgeClass(pos.AssetClass)">
                                                @GetAssetDisplayName(pos.AssetClass)
                                            </span>
                                            @if (IsSimulatedFeed(pos.AssetClass))
                                            {
                                                <span class="text-4xs uppercase px-1.5 py-0.5 rounded font-black tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">Simulate</span>
                                            }
                                        </div>
                                        <p class="text-3xs text-slate-400 truncate font-normal">@pos.AssetName</p>
                                    </td>
                                    <td class="p-3">
                                        <span class="px-2 py-0.5 rounded-md font-black text-3xs @(pos.Side == AzureTest.Domain.Entities.Trading.Enums.TradingOrderSide.Buy ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" : "bg-rose-500/10 text-rose-600 border border-rose-500/20")">
                                            @pos.Side @pos.Leverage&times;
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono font-bold text-slate-800 dark:text-slate-200">
                                        @pos.Quantity.ToString("N4")
                                    </td>
                                    <td class="p-3 font-mono text-slate-600 dark:text-slate-300">
                                        $@pos.EntryPrice.ToString("N2")
                                    </td>
                                    <td class="p-3 font-mono font-black text-slate-900 dark:text-white" id="posCurrentPrice_@pos.Id">
                                        $@pos.CurrentPrice.ToString("N2")
                                    </td>
                                    <td class="p-3 font-mono text-slate-600 dark:text-slate-300">
                                        $@pos.InitialMargin.ToString("N2")
                                    </td>
                                    <td class="p-3 font-mono text-3xs text-slate-500">
                                        @(pos.StopLoss.HasValue && pos.StopLoss > 0 ? $"${pos.StopLoss.Value:N2}" : "--")
                                    </td>
                                    <td class="p-3 font-mono text-3xs text-slate-500">
                                        @(pos.TakeProfit.HasValue && pos.TakeProfit > 0 ? $"${pos.TakeProfit.Value:N2}" : "--")
                                    </td>
                                    <td class="p-3 font-mono font-black" id="posPnl_@pos.Id">
                                        <div class="flex items-center gap-1.5">
                                            <span class="@(pos.UnrealizedPnl >= 0 ? "text-emerald-500" : "text-rose-500") text-sm">
                                                @(pos.UnrealizedPnl >= 0 ? "+" : "")$@pos.UnrealizedPnl.ToString("N2")
                                            </span>
                                            <span class="text-3xs px-1.5 py-0.2 rounded font-extrabold @(roi >= 0 ? "bg-emerald-500/10 text-emerald-600" : "bg-rose-500/10 text-rose-600")">
                                                @(roi >= 0 ? "+" : "")@roi.ToString("N2")%
                                            </span>
                                        </div>
                                    </td>
                                    <td class="p-3 pr-4 text-right">
                                        <button type="button" onclick="ajaxClosePosition('@pos.Id', '@pos.Symbol')" class="px-3 py-1.5 rounded-xl bg-rose-500 hover:bg-rose-600 active:scale-95 text-white font-bold text-3xs transition-all shadow-2xs">
                                            Close Trade
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TAB 2: Pending Orders Table -->
        <div id="holdingPanelPending" class="hidden space-y-4">
            @if (Model.PendingOrders.Count == 0)
            {
                <div class="p-8 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 text-center space-y-1">
                    <p class="text-xs font-bold text-slate-500">No working limit or stop orders pending execution.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50/80 dark:bg-slate-800/50 text-slate-400 uppercase text-3xs font-black">
                            <tr>
                                <th class="p-3 pl-4">Asset</th>
                                <th class="p-3">Order Type</th>
                                <th class="p-3">Side</th>
                                <th class="p-3">Quantity</th>
                                <th class="p-3">Target Price</th>
                                <th class="p-3">TIF</th>
                                <th class="p-3">Placed At</th>
                                <th class="p-3 pr-4 text-right">Cancel</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var ord in Model.PendingOrders)
                            {
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                                    <td class="p-3 pl-4 font-black text-slate-900 dark:text-white">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span>@ord.Symbol</span>
                                            <span class="px-1.5 py-0.5 rounded text-4xs font-extrabold uppercase @GetAssetBadgeClass(ord.AssetClass)">
                                                @GetAssetDisplayName(ord.AssetClass)
                                            </span>
                                        </div>
                                    </td>
                                    <td class="p-3">
                                        <span class="px-2 py-0.5 rounded text-3xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                            @ord.OrderType
                                        </span>
                                    </td>
                                    <td class="p-3">
                                        <span class="px-2 py-0.5 rounded text-3xs font-extrabold @(ord.Side == AzureTest.Domain.Entities.Trading.Enums.TradingOrderSide.Buy ? "text-emerald-500" : "text-rose-500")">
                                            @ord.Side
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono font-bold">@ord.Quantity.ToString("N4")</td>
                                    <td class="p-3 font-mono font-black text-slate-900 dark:text-white">
                                        $@((ord.Price ?? ord.TriggerPrice ?? 0m).ToString("N2"))
                                    </td>
                                    <td class="p-3 text-3xs text-slate-400">@ord.TimeInForce</td>
                                    <td class="p-3 text-3xs text-slate-400">@ord.PlacedAtUtc.ToString("HH:mm:ss")</td>
                                    <td class="p-3 pr-4 text-right">
                                        <button type="button" onclick="ajaxCancelOrder('@ord.Id', '@ord.Symbol')" class="px-2.5 py-1 rounded-lg bg-slate-200 dark:bg-slate-700 hover:bg-rose-500 hover:text-white font-bold text-3xs transition-colors">
                                            Cancel
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TAB 3: Closed Trades & Profit/Loss History -->
        <div id="holdingPanelClosed" class="hidden space-y-4">
            @if (Model.ClosedPositions.Count == 0)
            {
                <div class="p-8 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800 text-center space-y-1">
                    <p class="text-xs font-bold text-slate-500">No closed trades yet in your paper trading history.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-slate-50/80 dark:bg-slate-800/50 text-slate-400 uppercase text-3xs font-black">
                            <tr>
                                <th class="p-3 pl-4">Asset</th>
                                <th class="p-3">Side</th>
                                <th class="p-3">Quantity</th>
                                <th class="p-3">Entry Price</th>
                                <th class="p-3">Exit Price</th>
                                <th class="p-3 font-black text-slate-700 dark:text-slate-300">Realized Profit / Loss (PnL)</th>
                                <th class="p-3 pr-4 text-right">Closed At</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var c in Model.ClosedPositions)
                            {
                                var isWin = c.RealizedPnl >= 0;
                                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                                    <td class="p-3 pl-4 font-black text-slate-800 dark:text-slate-200">
                                        <div class="flex items-center gap-1.5 flex-wrap">
                                            <span>@c.Symbol</span>
                                            <span class="px-1.5 py-0.5 rounded text-4xs font-extrabold uppercase @GetAssetBadgeClass(c.AssetClass)">
                                                @GetAssetDisplayName(c.AssetClass)
                                            </span>
                                        </div>
                                        <p class="text-3xs text-slate-400 truncate font-normal">@c.AssetName</p>
                                    </td>
                                    <td class="p-3 text-3xs font-extrabold @(c.Side == AzureTest.Domain.Entities.Trading.Enums.TradingOrderSide.Buy ? "text-emerald-500" : "text-rose-500")">
                                        @c.Side
                                    </td>
                                    <td class="p-3 font-mono font-bold">@c.Quantity.ToString("N4")</td>
                                    <td class="p-3 font-mono text-slate-600 dark:text-slate-400">$@c.EntryPrice.ToString("N2")</td>
                                    <td class="p-3 font-mono text-slate-900 dark:text-white font-bold">$@((c.ClosePrice ?? c.CurrentPrice).ToString("N2"))</td>
                                    <td class="p-3 font-mono font-black">
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-black @(isWin ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/30" : "bg-rose-500/10 text-rose-600 border border-rose-500/30")">
                                            @(isWin ? "+" : "")$@c.RealizedPnl.ToString("N2")
                                        </span>
                                    </td>
                                    <td class="p-3 pr-4 text-right text-3xs text-slate-400">
                                        @((c.ClosedAtUtc ?? DateTime.UtcNow).ToString("yyyy-MM-dd HH:mm"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<!-- Official TradingView Real-Time Chart Widget Script -->
<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>

<script>
    const symbol = "@selected.Symbol";
    const selectedAssetClass = @((int)selected.AssetClass);
    let basePrice = @selected.Price;
    let cashBalance = @account.CashBalance;
    let freeMargin = @account.FreeMargin;
    let currentSide = 1; // 1 = Buy, 2 = Sell
    let currentOrderTab = 'market';
    let isBuzzwordsMode = false;
    let isSymbolWatchlisted = @(selected.IsWatchlisted ? "true" : "false");
    let currentSizeMode = 'units'; // 'units', 'margin', 'percent', 'total'
    let currentCalculatedUnits = 1.0;
    let currentCalculatedMargin = 0;
    let currentCalculatedPercent = 0;
    let currentCalculatedTotal = 0;
    let tpEnabled = true;
    let slEnabled = true;

    // Chart Engine State
    let currentChartEngine = 'tradingview'; // 'tradingview' or 'canvas'
    let tvWidget = null;

    // Toast Alert Helper
    function showToast(type, msg) {
        const c = document.getElementById('dynamicAlertContainer');
        if (!c) return;
        const isSuccess = type === 'success';
        const el = document.createElement('div');
        el.className = `p-4 rounded-2xl ${isSuccess ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-700 dark:text-emerald-300' : 'bg-rose-500/10 border-rose-500/30 text-rose-700 dark:text-rose-300'} border flex items-center justify-between shadow-xs transition-all`;
        el.innerHTML = `
            <div class="flex items-center gap-3">
                <i class="fa-solid ${isSuccess ? 'fa-circle-check text-emerald-500' : 'fa-circle-exclamation text-rose-500'} text-lg"></i>
                <div>
                    <strong class="font-bold text-xs uppercase tracking-wider">${isSuccess ? 'Success' : 'Execution Notice'}</strong>
                    <p class="text-xs ${isSuccess ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'} mt-0.5">${msg}</p>
                </div>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="${isSuccess ? 'text-emerald-500' : 'text-rose-500'} hover:opacity-75">
                <i class="fa-solid fa-xmark"></i>
            </button>
        `;
        c.prepend(el);
        setTimeout(() => el.remove(), 7000);
    }

    // ── 1. Live Price Auto-Update Polling (Every 3 seconds, in-place, NO refresh) ─────
    setInterval(async () => {
        try {
            const res = await fetch(`/Trading/Trading/Quote?symbol=${encodeURIComponent(symbol)}`);
            if (res.ok) {
                const quote = await res.json();
                // Support both camelCase and PascalCase properties
                const newPrice = Number(quote.price ?? quote.Price);
                const high24 = Number(quote.high24h ?? quote.High24h ?? 0);
                const low24 = Number(quote.low24h ?? quote.Low24h ?? 0);
                const chg24h = Number(quote.changePercent24h ?? quote.ChangePercent24h ?? 0);

                if (newPrice && !isNaN(newPrice)) {
                    const priceEl = document.getElementById('liveTickerPrice');
                    const changeEl = document.getElementById('liveTickerChange');
                    const syncDot = document.getElementById('syncStatusDot');

                    // Flash animation on live badge
                    if (newPrice > basePrice) {
                        priceEl.classList.add('text-emerald-500');
                        setTimeout(() => priceEl.classList.remove('text-emerald-500'), 800);
                    } else if (newPrice < basePrice) {
                        priceEl.classList.add('text-rose-500');
                        setTimeout(() => priceEl.classList.remove('text-rose-500'), 800);
                    }

                    if (syncDot) {
                        syncDot.classList.add('scale-125');
                        setTimeout(() => syncDot.classList.remove('scale-125'), 300);
                    }

                    basePrice = newPrice;
                    priceEl.textContent = `$${newPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 })}`;
                    changeEl.textContent = `${chg24h >= 0 ? '+' : ''}${chg24h.toFixed(2)}%`;

                    const highEl = document.getElementById('liveHighDisplay');
                    if (highEl && high24 > 0) highEl.textContent = `$${high24.toFixed(2)}`;
                    const lowEl = document.getElementById('liveLowDisplay');
                    if (lowEl && low24 > 0) lowEl.textContent = `$${low24.toFixed(2)}`;

                    // Update market order execution display in-place
                    const marketPriceEl = document.getElementById('marketOrderPriceDisplay');
                    if (marketPriceEl) {
                        marketPriceEl.textContent = `$${newPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 })}`;
                    }

                    const limitHint = document.getElementById('limitMarketHint');
                    if (limitHint) limitHint.textContent = `${newPrice.toFixed(2)}`;
                    const stopHint = document.getElementById('stopMarketHint');
                    if (stopHint) stopHint.textContent = `${newPrice.toFixed(2)}`;

                    // Recalculate indicators & size conversions dynamically with the new live price
                    recalculateAllSizeAndMargin();

                    // Update live positions mark price and unrealized PnL in open positions table
                    document.querySelectorAll('.pos-row').forEach(row => {
                        const sym = row.getAttribute('data-symbol');
                        if (sym && sym.toUpperCase() === symbol.toUpperCase()) {
                            const curCell = row.querySelector('[id^="posCurrentPrice_"]');
                            if (curCell) curCell.textContent = `$${newPrice.toFixed(2)}`;
                        }
                    });
                }
            }
        } catch (err) {
            console.debug('Price sync polling idle:', err);
        }
    }, 3000);

    function getActiveReferencePrice() {
        if (currentOrderTab === 'limit') {
            const p = parseFloat(document.getElementById('orderPriceInput').value);
            return (p && p > 0) ? p : basePrice;
        } else if (currentOrderTab === 'stop') {
            const p = parseFloat(document.getElementById('orderTriggerPriceInput').value);
            return (p && p > 0) ? p : basePrice;
        }
        return basePrice > 0 ? basePrice : 1;
    }

    function setLimitToMarket() {
        document.getElementById('orderPriceInput').value = basePrice;
        recalculateAllSizeAndMargin();
    }

    function setStopToMarket() {
        document.getElementById('orderTriggerPriceInput').value = basePrice;
        recalculateAllSizeAndMargin();
    }

    async function toggleTradeWatchlist(sym, name, cls) {
        try {
            const formData = new FormData();
            formData.append('symbol', sym);
            formData.append('assetName', name);
            formData.append('assetClass', cls);

            const res = await fetch('/Trading/Trading/ToggleWatchlist', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                isSymbolWatchlisted = data.isWatchlisted;
                const icon = document.getElementById('tradeWatchlistIcon');
                const btn = document.getElementById('tradeWatchlistBtn');
                if (isSymbolWatchlisted) {
                    icon.className = 'fa-solid fa-star text-amber-500 text-sm';
                    btn.title = 'Remove from watchlist';
                } else {
                    icon.className = 'fa-regular fa-star text-slate-400 hover:text-amber-500 text-sm';
                    btn.title = 'Add to watchlist';
                }
            }
        } catch (err) {
            console.error('Failed to toggle watchlist in trade terminal:', err);
        }
    }

    // ── 2. Order Tab Switcher (Market, Limit, Stop) ──────────────────────────
    function setOrderTab(tab) {
        currentOrderTab = tab;
        document.querySelectorAll('.order-type-tab').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-xs');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1));
        if (activeBtn) {
            activeBtn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-xs');
        }

        const marketGroup = document.getElementById('marketPriceGroup');
        const priceGroup = document.getElementById('priceInputGroup');
        const stopTriggerGroup = document.getElementById('stopTriggerInputGroup');
        const tifGroup = document.getElementById('tifGroup');
        const formOrderType = document.getElementById('formOrderType');

        if (tab === 'market') {
            formOrderType.value = 1;
            if (marketGroup) marketGroup.classList.remove('hidden');
            priceGroup.classList.add('hidden');
            stopTriggerGroup.classList.add('hidden');
            tifGroup.classList.add('hidden');
        } else if (tab === 'limit') {
            formOrderType.value = 2;
            if (marketGroup) marketGroup.classList.add('hidden');
            priceGroup.classList.remove('hidden');
            stopTriggerGroup.classList.add('hidden');
            tifGroup.classList.remove('hidden');
            if (!document.getElementById('orderPriceInput').value) {
                document.getElementById('orderPriceInput').value = basePrice;
            }
        } else if (tab === 'stop') {
            formOrderType.value = 3;
            if (marketGroup) marketGroup.classList.add('hidden');
            priceGroup.classList.add('hidden');
            stopTriggerGroup.classList.remove('hidden');
            tifGroup.classList.remove('hidden');
            if (!document.getElementById('orderTriggerPriceInput').value) {
                document.getElementById('orderTriggerPriceInput').value = basePrice;
            }
        }

        recalculateAllSizeAndMargin();
    }

    // ── 3. Trade Size Modes & Multi-Unit Calculations ────────────────────────
    function setTradeSizeMode(mode) {
        currentSizeMode = mode;
        document.querySelectorAll('.size-mode-btn').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-2xs');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('sizeModeBtn' + mode.charAt(0).toUpperCase() + mode.slice(1));
        if (activeBtn) {
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-2xs');
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
        }

        const prefix = document.getElementById('mainInputPrefix');
        const suffix = document.getElementById('mainInputSuffix');
        const input = document.getElementById('orderSizeMainInput');

        if (mode === 'units') {
            prefix.classList.add('hidden');
            suffix.classList.remove('hidden');
            suffix.textContent = symbol;
            input.value = currentCalculatedUnits > 0 ? (currentCalculatedUnits > 1 ? currentCalculatedUnits.toFixed(4) : currentCalculatedUnits.toFixed(6)) : "1.0";
        } else if (mode === 'margin') {
            prefix.classList.remove('hidden');
            suffix.classList.add('hidden');
            input.value = currentCalculatedMargin > 0 ? currentCalculatedMargin.toFixed(2) : "50.00";
        } else if (mode === 'percent') {
            prefix.classList.add('hidden');
            suffix.classList.remove('hidden');
            suffix.textContent = "% Balance";
            input.value = currentCalculatedPercent > 0 ? currentCalculatedPercent.toFixed(1) : "10.0";
        } else if (mode === 'total') {
            prefix.classList.remove('hidden');
            suffix.classList.add('hidden');
            input.value = currentCalculatedTotal > 0 ? currentCalculatedTotal.toFixed(2) : (basePrice > 0 ? basePrice.toFixed(2) : "100.00");
        }

        recalculateAllSizeAndMargin();
    }

    function onMainSizeInputChange(val) {
        recalculateAllSizeAndMargin();
    }

    function onTradeValueSliderChange(pct) {
        document.getElementById('tradeValueSliderLabel').textContent = pct + '%';
        const avail = freeMargin > 0 ? freeMargin : (cashBalance > 0 ? cashBalance : 100);
        const lev = parseInt(document.getElementById('orderLeverageInput').value) || 1;
        const refPrice = getActiveReferencePrice();

        const targetMargin = (avail * pct) / 100;
        const targetTotal = targetMargin * lev;
        const targetUnits = refPrice > 0 ? targetTotal / refPrice : 0;

        const input = document.getElementById('orderSizeMainInput');
        if (currentSizeMode === 'units') {
            input.value = targetUnits > 1 ? targetUnits.toFixed(4) : targetUnits.toFixed(6);
        } else if (currentSizeMode === 'margin') {
            input.value = targetMargin.toFixed(2);
        } else if (currentSizeMode === 'percent') {
            input.value = Number(pct).toFixed(1);
        } else if (currentSizeMode === 'total') {
            input.value = targetTotal.toFixed(2);
        }

        recalculateAllSizeAndMargin();
    }

    function setSliderPreset(pct) {
        const slider = document.getElementById('tradeValueSlider');
        if (slider) slider.value = pct;
        onTradeValueSliderChange(pct);
    }

    function setLeveragePreset(lev) {
        const levInput = document.getElementById('orderLeverageInput');
        if (levInput) levInput.value = lev;
        updateLeverage(lev);
    }

    function updateLeverage(val) {
        document.getElementById('leverageDisplay').textContent = val + 'x';
        recalculateAllSizeAndMargin();
    }

    function recalculateAllSizeAndMargin() {
        const refPrice = getActiveReferencePrice();
        const lev = parseInt(document.getElementById('orderLeverageInput').value) || 1;
        const avail = freeMargin > 0 ? freeMargin : (cashBalance > 0 ? cashBalance : 100);
        const val = parseFloat(document.getElementById('orderSizeMainInput').value) || 0;

        let units = 0;
        let margin = 0;
        let total = 0;
        let balancePct = 0;

        if (currentSizeMode === 'units') {
            units = val;
            total = units * refPrice;
            margin = total / lev;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        } else if (currentSizeMode === 'margin') {
            margin = val;
            total = margin * lev;
            units = refPrice > 0 ? total / refPrice : 0;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        } else if (currentSizeMode === 'percent') {
            balancePct = val;
            margin = (avail * balancePct) / 100;
            total = margin * lev;
            units = refPrice > 0 ? total / refPrice : 0;
        } else if (currentSizeMode === 'total') {
            total = val;
            units = refPrice > 0 ? total / refPrice : 0;
            margin = total / lev;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        }

        currentCalculatedUnits = units;
        currentCalculatedMargin = margin;
        currentCalculatedPercent = balancePct;
        currentCalculatedTotal = total;

        // Keep hidden quantity field in sync
        document.getElementById('orderQuantityInput').value = units > 0 ? (units > 1 ? units.toFixed(4) : units.toFixed(6)) : '0';

        // Update live bottom conversions strip
        const unitsStr = units > 1 ? units.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) : units.toFixed(6);
        document.getElementById('calcUnitsDisplay').innerHTML = `${unitsStr} <span class="text-3xs font-bold text-slate-400">${symbol}</span>`;
        document.getElementById('calcMarginDisplay').textContent = `$${margin.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        document.getElementById('calcBalancePctDisplay').textContent = `${balancePct.toFixed(2)}%`;
        document.getElementById('calcTotalValueDisplay').textContent = `$${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        // Sync slider position if user typed directly
        const slider = document.getElementById('tradeValueSlider');
        if (slider && document.activeElement !== slider) {
            const clampedPct = Math.min(100, Math.max(1, Math.round(balancePct)));
            slider.value = clampedPct;
            document.getElementById('tradeValueSliderLabel').textContent = clampedPct + '%';
        }

        calculateRiskRewardOutputs();
    }

