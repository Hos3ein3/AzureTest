    // ── 6. Client-Side Validation & AJAX Order Placement ───────────────────
    async function submitOrder(side) {
        currentSide = side;
        document.getElementById('formOrderSide').value = side;

        const qty = parseFloat(document.getElementById('orderQuantityInput').value) || 0;
        if (qty <= 0) {
            showToast('error', 'Order quantity must be greater than 0. Please enter a valid trade size or adjust the slider.');
            return;
        }

        const checkPrice = getActiveReferencePrice();

        // Handle Take Profit validation
        if (!tpEnabled) {
            document.getElementById('orderTakeProfitInput').value = '';
        } else {
            const tp = parseFloat(document.getElementById('orderTakeProfitInput').value) || 0;
            if (side === 1 && tp > 0 && tp <= checkPrice) {
                showToast('error', `For Buy (Long) orders, Take Profit ($${tp}) must be set strictly ABOVE the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
            if (side === 2 && tp > 0 && tp >= checkPrice) {
                showToast('error', `For Sell (Short) orders, Take Profit ($${tp}) must be set strictly BELOW the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
        }

        // Handle Stop Loss validation
        if (!slEnabled) {
            document.getElementById('orderStopLossInput').value = '';
        } else {
            const sl = parseFloat(document.getElementById('orderStopLossInput').value) || 0;
            if (side === 1 && sl > 0 && sl >= checkPrice) {
                showToast('error', `For Buy (Long) orders, Stop Loss ($${sl}) must be set strictly BELOW the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
            if (side === 2 && sl > 0 && sl <= checkPrice) {
                showToast('error', `For Sell (Short) orders, Stop Loss ($${sl}) must be set strictly ABOVE the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
        }

        // Disable buttons and show processing state
        const buyBtn = document.getElementById('buyOrderSubmitBtn');
        const sellBtn = document.getElementById('sellOrderSubmitBtn');
        if (buyBtn) buyBtn.disabled = true;
        if (sellBtn) sellBtn.disabled = true;

        const form = document.getElementById('tradingOrderForm');
        const formData = new FormData(form);

        try {
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    showToast('success', data.message || 'Trade executed successfully!');
                    setTimeout(() => window.location.reload(), 800);
                    return;
                } else {
                    showToast('error', data.error || 'Failed to place order.');
                }
            } else {
                form.submit();
                return;
            }
        } catch (err) {
            console.warn('AJAX submit fallback:', err);
            form.submit();
            return;
        } finally {
            if (buyBtn) buyBtn.disabled = false;
            if (sellBtn) sellBtn.disabled = false;
        }
    }

