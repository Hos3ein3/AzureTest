            <!-- Leverage Multiplier Slider Card -->
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 space-y-3">
                <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300">
                    <span class="term-leverage-label flex items-center gap-1.5 font-black uppercase tracking-wide">
                        <i class="fa-solid fa-bolt text-amber-500"></i>
                        <span>Leverage Multiplier</span>
                    </span>
                    <div class="flex items-center gap-2">
                        <span class="text-3xs uppercase font-bold text-slate-400">Multiplier:</span>
                        <span id="leverageDisplay" class="px-2.5 py-0.5 rounded-lg bg-brand-500 text-white font-mono font-black text-xs shadow-2xs">1x</span>
                    </div>
                </div>
                <input type="range" min="1" max="250" value="1" name="leverage" id="orderLeverageInput"
                       oninput="updateLeverage(this.value)"
                       class="w-full accent-brand-500 cursor-pointer h-2 bg-slate-200 dark:bg-slate-700 rounded-lg" />
                <div class="flex flex-wrap items-center justify-between gap-1 text-3xs font-extrabold text-slate-400">
                    <button type="button" onclick="setLeveragePreset(1)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">1x</button>
                    <button type="button" onclick="setLeveragePreset(2)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">2x</button>
                    <button type="button" onclick="setLeveragePreset(5)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">5x</button>
                    <button type="button" onclick="setLeveragePreset(10)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">10x</button>
                    <button type="button" onclick="setLeveragePreset(20)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">20x</button>
                    <button type="button" onclick="setLeveragePreset(50)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">50x</button>
                    <button type="button" onclick="setLeveragePreset(100)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">100x</button>
                    <button type="button" onclick="setLeveragePreset(150)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">150x</button>
                    <button type="button" onclick="setLeveragePreset(200)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors">200x</button>
                    <button type="button" onclick="setLeveragePreset(250)" class="px-2 py-1 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 transition-colors font-black text-brand-600 dark:text-brand-400">250x</button>
                </div>
            </div>

            <!-- Exit Management Section: Take Profit & Stop Loss with iOS ON/OFF Switches -->
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-2">
                    <h4 class="text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-emerald-500"></i>
                        <span class="term-exit-header">Target Profit &amp; Loss Protection</span>
                    </h4>
                    <!-- Quick R:R Pre-set Buttons -->
                    <div class="flex items-center gap-1.5 text-3xs">
                        <span class="text-slate-400">R:R Presets:</span>
                        <button type="button" onclick="setRiskReward(1)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-bold hover:bg-slate-200">1:1</button>
                        <button type="button" onclick="setRiskReward(2)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-bold hover:bg-slate-200">1:2</button>
                        <button type="button" onclick="setRiskReward(3)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-bold hover:bg-slate-200">1:3</button>
                    </div>
                </div>

                <!-- Inputs Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Take Profit (Reward) with iOS Switch -->
                    <div class="space-y-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                            <div class="flex items-center gap-2.5">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="tpEnableToggle" onchange="toggleTpEnabled(this.checked)" checked class="sr-only peer" />
                                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:bg-emerald-500"></div>
                                </label>
                                <span class="text-xs font-black text-slate-800 dark:text-slate-200 term-tp-label">Take Profit</span>
                            </div>
                            <span class="text-3xs text-emerald-500 font-bold" id="tpRewardSummary">+0.00 USD</span>
                        </div>

                        <div id="tpInputsContainer" class="space-y-3">
                            <input type="number" step="any" name="takeProfit" id="orderTakeProfitInput" oninput="calculateRiskRewardOutputs()"
                                   placeholder="e.g. Target Exit Price ($)"
                                   class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 font-bold focus:border-emerald-500 focus:outline-none" />

                            <!-- Multi-Level Take Profit Section (TP1, TP2, TP3) -->
                            <div class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-3xs font-extrabold uppercase text-slate-500">Multi-Level Partial Exits</span>
                                    <button type="button" onclick="toggleMultiTpInputs()" id="toggleMultiTpBtn" class="text-3xs text-brand-500 font-bold hover:underline">
                                        + Add TP1 / TP2 / TP3
                                    </button>
                                </div>
                                <div id="multiTpContainer" class="hidden space-y-1.5 pt-1">
                                    <div class="grid grid-cols-3 gap-1.5 text-3xs">
                                        <input type="number" step="any" id="tp1Price" placeholder="TP1 Price" class="p-1.5 rounded-lg border dark:bg-slate-900 font-bold" oninput="syncMultiTpJson()" />
                                        <input type="number" id="tp1Pct" placeholder="50%" value="50" class="p-1.5 rounded-lg border dark:bg-slate-900 font-bold" oninput="syncMultiTpJson()" />
                                        <span class="self-center text-slate-400 font-bold">50% size</span>
                                    </div>
                                    <div class="grid grid-cols-3 gap-1.5 text-3xs">
                                        <input type="number" step="any" id="tp2Price" placeholder="TP2 Price" class="p-1.5 rounded-lg border dark:bg-slate-900 font-bold" oninput="syncMultiTpJson()" />
                                        <input type="number" id="tp2Pct" placeholder="30%" value="30" class="p-1.5 rounded-lg border dark:bg-slate-900 font-bold" oninput="syncMultiTpJson()" />
                                        <span class="self-center text-slate-400 font-bold">30% size</span>
                                    </div>
                                    <div class="grid grid-cols-3 gap-1.5 text-3xs">
                                        <input type="number" step="any" id="tp3Price" placeholder="TP3 Price" class="p-1.5 rounded-lg border dark:bg-slate-900 font-bold" oninput="syncMultiTpJson()" />
                                        <input type="number" id="tp3Pct" placeholder="20%" value="20" class="p-1.5 rounded-lg border dark:bg-slate-900 font-bold" oninput="syncMultiTpJson()" />
                                        <span class="self-center text-slate-400 font-bold">20% size</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stop Loss (Risk) with iOS Switch -->
                    <div class="space-y-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                            <div class="flex items-center gap-2.5">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="slEnableToggle" onchange="toggleSlEnabled(this.checked)" checked class="sr-only peer" />
                                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-slate-600 peer-checked:bg-rose-500"></div>
                                </label>
                                <span class="text-xs font-black text-slate-800 dark:text-slate-200 term-sl-label">Stop Loss Protection</span>
                            </div>
                            <span class="text-3xs text-rose-500 font-bold" id="slRiskSummary">-0.00 USD</span>
                        </div>

                        <div id="slInputsContainer" class="space-y-3">
                            <input type="number" step="any" name="stopLoss" id="orderStopLossInput" oninput="calculateRiskRewardOutputs()"
                                   placeholder="e.g. Protective Exit Price ($)"
                                   class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 font-bold focus:border-rose-500 focus:outline-none" />

                            <!-- Trailing Stop Distance -->
                            <div class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1.5">
                                <label class="text-3xs font-extrabold uppercase text-slate-500 block">Trailing Stop Distance ($)</label>
                                <input type="number" step="any" min="0" name="trailingStopDistance" id="orderTrailingStopInput"
                                       placeholder="Trail distance (auto ratchets upward in profit)"
                                       class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-900 font-bold" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Action Buttons (Buy / Long vs Sell / Short) -->
            <div class="grid grid-cols-2 gap-4 pt-2">
                <button type="button" onclick="submitOrder(1)" class="py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 active:scale-[0.99] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                    <span id="buyBtnLabel">Buy (Long)</span>
                </button>
                <button type="button" onclick="submitOrder(2)" class="py-3.5 rounded-2xl bg-rose-500 hover:bg-rose-600 active:scale-[0.99] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-trend-down"></i>
                    <span id="sellBtnLabel">Sell (Short)</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Active Positions / Orders for THIS Asset -->
    @if (openForSymbol.Count > 0 || pendingForSymbol.Count > 0)
    {
        <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-5 shadow-xs space-y-4">
            <h4 class="text-xs font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-layer-group text-brand-500"></i>
                <span>Your Holdings in @selected.Symbol</span>
            </h4>

            @if (openForSymbol.Count > 0)
            {
                <div class="space-y-2">
                    <p class="text-3xs uppercase font-extrabold text-slate-400">Open Positions</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var pos in openForSymbol)
                        {
                            <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 flex items-center justify-between text-xs">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded text-3xs font-black @(pos.Side == AzureTest.Domain.Entities.Trading.Enums.TradingOrderSide.Buy ? "bg-emerald-500/10 text-emerald-600" : "bg-rose-500/10 text-rose-600")">@pos.Side @pos.Leverage&times;</span>
                                        <strong class="font-bold">@pos.Quantity.ToString("N4") units</strong>
                                    </div>
                                    <div class="text-3xs text-slate-400 mt-1">Entry: $@pos.EntryPrice.ToString("N2") | Margin: $@pos.InitialMargin.ToString("N2")</div>
                                </div>
                                <div class="text-right flex items-center gap-3">
                                    <div class="font-mono font-black @(pos.UnrealizedPnl >= 0 ? "text-emerald-500" : "text-rose-500")">
                                        @(pos.UnrealizedPnl >= 0 ? "+" : "")$@pos.UnrealizedPnl.ToString("N2")
                                    </div>
                                    <form asp-action="ClosePosition" method="post">
                                        <input type="hidden" name="positionId" value="@pos.Id" />
                                        <input type="hidden" name="symbol" value="@pos.Symbol" />
                                        <input type="hidden" name="sourcePage" value="trade" />
                                        <button type="submit" class="px-2.5 py-1 rounded-lg bg-rose-500 text-white font-bold text-3xs hover:bg-rose-600 shadow-2xs">
                                            Close
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (pendingForSymbol.Count > 0)
            {
                <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                    <p class="text-3xs uppercase font-extrabold text-slate-400">Pending Orders</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var ord in pendingForSymbol)
                        {
                            <div class="p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 flex items-center justify-between text-xs">
                                <div>
                                    <span class="px-2 py-0.5 rounded text-3xs font-black bg-slate-200 dark:bg-slate-700">@ord.OrderType @ord.Side</span>
                                    <div class="text-3xs text-slate-400 mt-1">Price: $@((ord.Price ?? ord.TriggerPrice ?? 0m).ToString("N2")) | Qty: @ord.Quantity.ToString("N4")</div>
                                </div>
                                <form asp-action="CancelOrder" method="post">
                                    <input type="hidden" name="orderId" value="@ord.Id" />
                                    <input type="hidden" name="symbol" value="@ord.Symbol" />
                                    <input type="hidden" name="sourcePage" value="trade" />
                                    <button type="submit" class="px-2.5 py-1 rounded-lg bg-slate-200 dark:bg-slate-700 hover:bg-rose-500 hover:text-white font-bold text-3xs">
                                        Cancel
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    const symbol = "@selected.Symbol";
    let basePrice = @selected.Price;
    let cashBalance = @account.CashBalance;
    let freeMargin = @account.FreeMargin;
    let currentSide = 1; // 1 = Buy, 2 = Sell
    let currentOrderTab = 'market';
    let isBuzzwordsMode = false;
    let isSymbolWatchlisted = @(selected.IsWatchlisted ? "true" : "false");
    let currentSizeMode = 'units'; // 'units', 'margin', 'percent', 'total'
    let currentCalculatedUnits = 1.0;
    let currentCalculatedMargin = 0;
    let currentCalculatedPercent = 0;
    let currentCalculatedTotal = 0;
    let tpEnabled = true;
    let slEnabled = true;

    // ── 1. Live Price Auto-Update Polling (Every 3 seconds, in-place, NO refresh) ─────
    setInterval(async () => {
        try {
            const res = await fetch(`/Trading/Trading/Quote?symbol=${encodeURIComponent(symbol)}`);
            if (res.ok) {
                const quote = await res.json();
                const newPrice = Number(quote.Price);

                if (newPrice && newPrice !== basePrice) {
                    const priceEl = document.getElementById('liveTickerPrice');
                    const changeEl = document.getElementById('liveTickerChange');

                    // Flash animation on live badge
                    if (newPrice > basePrice) {
                        priceEl.classList.add('text-emerald-500');
                        setTimeout(() => priceEl.classList.remove('text-emerald-500'), 800);
                    } else {
                        priceEl.classList.add('text-rose-500');
                        setTimeout(() => priceEl.classList.remove('text-rose-500'), 800);
                    }

                    basePrice = newPrice;
                    priceEl.textContent = `$${newPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 })}`;
                    const chg24h = Number(quote.ChangePercent24h ?? quote.changePercent24h ?? 0);
                    changeEl.textContent = `${chg24h >= 0 ? '+' : ''}${chg24h.toFixed(2)}%`;

                    const highEl = document.getElementById('liveHighDisplay');
                    if (highEl && quote.High24h) highEl.textContent = `$${Number(quote.High24h).toFixed(2)}`;
                    const lowEl = document.getElementById('liveLowDisplay');
                    if (lowEl && quote.Low24h) lowEl.textContent = `$${Number(quote.Low24h).toFixed(2)}`;

                    // Seamlessly update market order execution display and quick hints in-place
                    const marketPriceEl = document.getElementById('marketOrderPriceDisplay');
                    if (marketPriceEl) {
                        marketPriceEl.textContent = `$${newPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 })}`;
                    }

                    const limitHint = document.getElementById('limitMarketHint');
                    if (limitHint) limitHint.textContent = `$${newPrice.toFixed(2)}`;
                    const stopHint = document.getElementById('stopMarketHint');
                    if (stopHint) stopHint.textContent = `$${newPrice.toFixed(2)}`;

                    // Recalculate indicators & size conversions dynamically with the new live price
                    recalculateAllSizeAndMargin();
                }
            }
        } catch (err) {
            console.debug('Price sync polling idle:', err);
        }
    }, 3000);

    function getActiveReferencePrice() {
        if (currentOrderTab === 'limit') {
            const p = parseFloat(document.getElementById('orderPriceInput').value);
            return (p && p > 0) ? p : basePrice;
        } else if (currentOrderTab === 'stop') {
            const p = parseFloat(document.getElementById('orderTriggerPriceInput').value);
            return (p && p > 0) ? p : basePrice;
        }
        return basePrice > 0 ? basePrice : 1;
    }

    function setLimitToMarket() {
        document.getElementById('orderPriceInput').value = basePrice;
        recalculateAllSizeAndMargin();
    }

    function setStopToMarket() {
        document.getElementById('orderTriggerPriceInput').value = basePrice;
        recalculateAllSizeAndMargin();
    }

    async function toggleTradeWatchlist(sym, name, cls) {
        try {
            const formData = new FormData();
            formData.append('symbol', sym);
            formData.append('assetName', name);
            formData.append('assetClass', cls);

            const res = await fetch('/Trading/Trading/ToggleWatchlist', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                isSymbolWatchlisted = data.isWatchlisted;
                const icon = document.getElementById('tradeWatchlistIcon');
                const btn = document.getElementById('tradeWatchlistBtn');
                if (isSymbolWatchlisted) {
                    icon.className = 'fa-solid fa-star text-amber-500 text-sm';
                    btn.title = 'Remove from watchlist';
                } else {
                    icon.className = 'fa-regular fa-star text-slate-400 hover:text-amber-500 text-sm';
                    btn.title = 'Add to watchlist';
                }
            }
        } catch (err) {
            console.error('Failed to toggle watchlist in trade terminal:', err);
        }
    }

    // ── 2. Order Tab Switcher (Market, Limit, Stop) ──────────────────────────
    function setOrderTab(tab) {
        currentOrderTab = tab;
        document.querySelectorAll('.order-type-tab').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-xs');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1));
        if (activeBtn) {
            activeBtn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-xs');
        }

        const marketGroup = document.getElementById('marketPriceGroup');
        const priceGroup = document.getElementById('priceInputGroup');
        const stopTriggerGroup = document.getElementById('stopTriggerInputGroup');
        const tifGroup = document.getElementById('tifGroup');
        const formOrderType = document.getElementById('formOrderType');

        if (tab === 'market') {
            formOrderType.value = 1;
            if (marketGroup) marketGroup.classList.remove('hidden');
            priceGroup.classList.add('hidden');
            stopTriggerGroup.classList.add('hidden');
            tifGroup.classList.add('hidden');
        } else if (tab === 'limit') {
            formOrderType.value = 2;
            if (marketGroup) marketGroup.classList.add('hidden');
            priceGroup.classList.remove('hidden');
            stopTriggerGroup.classList.add('hidden');
            tifGroup.classList.remove('hidden');
            if (!document.getElementById('orderPriceInput').value) {
                document.getElementById('orderPriceInput').value = basePrice;
            }
        } else if (tab === 'stop') {
            formOrderType.value = 3;
            if (marketGroup) marketGroup.classList.add('hidden');
            priceGroup.classList.add('hidden');
            stopTriggerGroup.classList.remove('hidden');
            tifGroup.classList.remove('hidden');
            if (!document.getElementById('orderTriggerPriceInput').value) {
                document.getElementById('orderTriggerPriceInput').value = basePrice;
            }
        }

        recalculateAllSizeAndMargin();
    }

    // ── 3. Trade Size Modes & Multi-Unit Calculations ────────────────────────
    function setTradeSizeMode(mode) {
        currentSizeMode = mode;
        document.querySelectorAll('.size-mode-btn').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-2xs');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('sizeModeBtn' + mode.charAt(0).toUpperCase() + mode.slice(1));
        if (activeBtn) {
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-2xs');
        }

        const prefix = document.getElementById('sizeInputPrefix');
        const suffix = document.getElementById('sizeInputSuffix');
        const input = document.getElementById('orderSizeMainInput');

        if (mode === 'units') {
            prefix.classList.add('hidden');
            suffix.textContent = 'Units';
            input.value = currentCalculatedUnits > 0 ? (currentCalculatedUnits > 1 ? currentCalculatedUnits.toFixed(4) : currentCalculatedUnits.toFixed(6)) : '1';
        } else if (mode === 'margin') {
            prefix.classList.remove('hidden');
            suffix.textContent = 'USD Margin';
            input.value = currentCalculatedMargin > 0 ? currentCalculatedMargin.toFixed(2) : '10.00';
        } else if (mode === 'percent') {
            prefix.classList.add('hidden');
            suffix.textContent = '% Balance';
            input.value = currentCalculatedPercent > 0 ? currentCalculatedPercent.toFixed(1) : '10.0';
        } else if (mode === 'total') {
            prefix.classList.remove('hidden');
            suffix.textContent = 'Total USD';
            input.value = currentCalculatedTotal > 0 ? currentCalculatedTotal.toFixed(2) : '100.00';
        }

        recalculateAllSizeAndMargin();
    }

    function onSizeMainInputChange(val) {
        recalculateAllSizeAndMargin();
    }

    function onTradeValueSliderChange(pctVal) {
        const pct = parseFloat(pctVal) || 0;
        document.getElementById('tradeValueSliderLabel').textContent = pct + '%';

        const refPrice = getActiveReferencePrice();
        const lev = parseInt(document.getElementById('orderLeverageInput').value) || 1;
        const avail = freeMargin > 0 ? freeMargin : (cashBalance > 0 ? cashBalance : 100);

        const targetMargin = (avail * pct) / 100;
        const targetTotal = targetMargin * lev;
        const targetUnits = refPrice > 0 ? targetTotal / refPrice : 0;

        const input = document.getElementById('orderSizeMainInput');
        if (currentSizeMode === 'units') {
            input.value = targetUnits > 1 ? targetUnits.toFixed(4) : targetUnits.toFixed(6);
        } else if (currentSizeMode === 'margin') {
            input.value = targetMargin.toFixed(2);
        } else if (currentSizeMode === 'percent') {
            input.value = pct.toFixed(1);
        } else if (currentSizeMode === 'total') {
            input.value = targetTotal.toFixed(2);
        }

        recalculateAllSizeAndMargin();
    }

    function setSliderPreset(pct) {
        const slider = document.getElementById('tradeValueSlider');
        if (slider) slider.value = pct;
        onTradeValueSliderChange(pct);
    }

    function setLeveragePreset(lev) {
        const levInput = document.getElementById('orderLeverageInput');
        if (levInput) levInput.value = lev;
        updateLeverage(lev);
    }

    function updateLeverage(val) {
        document.getElementById('leverageDisplay').textContent = val + 'x';
        recalculateAllSizeAndMargin();
    }

    function recalculateAllSizeAndMargin() {
        const refPrice = getActiveReferencePrice();
        const lev = parseInt(document.getElementById('orderLeverageInput').value) || 1;
        const avail = freeMargin > 0 ? freeMargin : (cashBalance > 0 ? cashBalance : 100);
        const val = parseFloat(document.getElementById('orderSizeMainInput').value) || 0;

        let units = 0;
        let margin = 0;
        let total = 0;
        let balancePct = 0;

        if (currentSizeMode === 'units') {
            units = val;
            total = units * refPrice;
            margin = total / lev;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        } else if (currentSizeMode === 'margin') {
            margin = val;
            total = margin * lev;
            units = refPrice > 0 ? total / refPrice : 0;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        } else if (currentSizeMode === 'percent') {
            balancePct = val;
            margin = (avail * balancePct) / 100;
            total = margin * lev;
            units = refPrice > 0 ? total / refPrice : 0;
        } else if (currentSizeMode === 'total') {
            total = val;
            units = refPrice > 0 ? total / refPrice : 0;
            margin = total / lev;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        }

        currentCalculatedUnits = units;
        currentCalculatedMargin = margin;
        currentCalculatedPercent = balancePct;
        currentCalculatedTotal = total;

        // Keep hidden quantity field in sync so backend receives exact decimal units
        document.getElementById('orderQuantityInput').value = units > 0 ? (units > 1 ? units.toFixed(6) : units.toFixed(8)) : '0';

        // Update live bottom conversions strip
        const unitsStr = units > 1 ? units.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) : units.toFixed(6);
        document.getElementById('calcUnitsDisplay').innerHTML = `${unitsStr} <span class="text-3xs font-bold text-slate-400">@selected.Symbol</span>`;
        document.getElementById('calcMarginDisplay').textContent = `$${margin.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        document.getElementById('calcBalancePctDisplay').textContent = `${balancePct.toFixed(2)}%`;
        document.getElementById('calcTotalValueDisplay').textContent = `$${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        // Sync slider position if user typed directly
        const slider = document.getElementById('tradeValueSlider');
        if (slider && document.activeElement !== slider) {
            const clampedPct = Math.min(100, Math.max(1, Math.round(balancePct)));
            slider.value = clampedPct;
            document.getElementById('tradeValueSliderLabel').textContent = clampedPct + '%';
        }

        calculateRiskRewardOutputs();
    }

    // ── 4. Exit Protection (Take Profit & Stop Loss with iOS ON/OFF Switches) ──
    function toggleTpEnabled(enabled) {
        tpEnabled = enabled;
        const container = document.getElementById('tpInputsContainer');
        const summary = document.getElementById('tpRewardSummary');
        const input = document.getElementById('orderTakeProfitInput');
        if (enabled) {
            container.classList.remove('opacity-40', 'pointer-events-none');
            input.disabled = false;
        } else {
            container.classList.add('opacity-40', 'pointer-events-none');
            input.disabled = true;
            summary.textContent = 'Disabled';
        }
        calculateRiskRewardOutputs();
    }

    function toggleSlEnabled(enabled) {
        slEnabled = enabled;
        const container = document.getElementById('slInputsContainer');
        const summary = document.getElementById('slRiskSummary');
        const input = document.getElementById('orderStopLossInput');
        if (enabled) {
            container.classList.remove('opacity-40', 'pointer-events-none');
            input.disabled = false;
        } else {
            container.classList.add('opacity-40', 'pointer-events-none');
            input.disabled = true;
            summary.textContent = 'Disabled';
        }
        calculateRiskRewardOutputs();
    }

    function calculateRiskRewardOutputs() {
        const qty = currentCalculatedUnits;
        const refPrice = getActiveReferencePrice();

        if (slEnabled) {
            const slPrice = parseFloat(document.getElementById('orderStopLossInput').value) || 0;
            if (slPrice > 0) {
                const riskUsd = currentSide === 1 ? Math.max(0, (refPrice - slPrice) * qty) : Math.max(0, (slPrice - refPrice) * qty);
                const riskPct = cashBalance > 0 ? (riskUsd / cashBalance) * 100 : 0;
                document.getElementById('slRiskSummary').textContent = `-$${riskUsd.toFixed(2)} USD (${riskPct.toFixed(1)}%)`;
            } else {
                document.getElementById('slRiskSummary').textContent = 'No Stop Loss Set';
            }
        } else {
            document.getElementById('slRiskSummary').textContent = 'Protection OFF';
        }

        if (tpEnabled) {
            const tpPrice = parseFloat(document.getElementById('orderTakeProfitInput').value) || 0;
            if (tpPrice > 0) {
                const rewardUsd = currentSide === 1 ? Math.max(0, (tpPrice - refPrice) * qty) : Math.max(0, (refPrice - tpPrice) * qty);
                const rewardPct = cashBalance > 0 ? (rewardUsd / cashBalance) * 100 : 0;
                document.getElementById('tpRewardSummary').textContent = `+$${rewardUsd.toFixed(2)} USD (${rewardPct.toFixed(1)}%)`;
            } else {
                document.getElementById('tpRewardSummary').textContent = 'No Profit Target Set';
            }
        } else {
            document.getElementById('tpRewardSummary').textContent = 'Target OFF';
        }
    }

    function setRiskReward(ratio) {
        const refPrice = getActiveReferencePrice();
        const slInput = document.getElementById('orderStopLossInput');
        const tpInput = document.getElementById('orderTakeProfitInput');
        const slDistance = refPrice * 0.015; // default 1.5% SL distance

        if (!slEnabled) {
            document.getElementById('slEnableToggle').checked = true;
            toggleSlEnabled(true);
        }
        if (!tpEnabled) {
            document.getElementById('tpEnableToggle').checked = true;
            toggleTpEnabled(true);
        }

        if (currentSide === 1) { // Buy
            const sl = Math.max(0.01, refPrice - slDistance);
            const tp = refPrice + (slDistance * ratio);
            slInput.value = sl.toFixed(2);
            tpInput.value = tp.toFixed(2);
        } else { // Sell
            const sl = refPrice + slDistance;
            const tp = Math.max(0.01, refPrice - (slDistance * ratio));
            slInput.value = sl.toFixed(2);
            tpInput.value = tp.toFixed(2);
        }
        calculateRiskRewardOutputs();
    }

    function toggleMultiTpInputs() {
        const container = document.getElementById('multiTpContainer');
        container.classList.toggle('hidden');
    }

    function syncMultiTpJson() {
        const p1 = parseFloat(document.getElementById('tp1Price').value) || 0;
        const p2 = parseFloat(document.getElementById('tp2Price').value) || 0;
        const p3 = parseFloat(document.getElementById('tp3Price').value) || 0;

        const list = [];
        if (p1 > 0) list.push({ level: 1, price: p1, percentage: parseFloat(document.getElementById('tp1Pct').value) || 50 });
        if (p2 > 0) list.push({ level: 2, price: p2, percentage: parseFloat(document.getElementById('tp2Pct').value) || 30 });
        if (p3 > 0) list.push({ level: 3, price: p3, percentage: parseFloat(document.getElementById('tp3Pct').value) || 20 });

        document.getElementById('formMultiTpJson').value = list.length > 0 ? JSON.stringify(list) : '';
    }

    // ── 5. UIComponent iOS Terminology Switch ────────────────────────────────
    function toggleTerminology(isBuzzwords) {
        isBuzzwordsMode = isBuzzwords;
        const modeTitle = document.getElementById('modeTitleLabel');
        const modeSub = document.getElementById('modeSubtitleLabel');

        if (isBuzzwords) {
            modeTitle.textContent = "Pro Buzzwords Mode";
            modeSub.textContent = "% Balance, USD Margin, Risk USD, Ticks";
            document.querySelectorAll('.term-quantity-label').forEach(el => el.textContent = "Order Size / Units / Margin");
            document.querySelectorAll('.term-leverage-label').forEach(el => el.textContent = "Margin Leverage");
            document.querySelectorAll('.term-price-label').forEach(el => el.textContent = "Limit Execution Price ($)");
            document.querySelectorAll('.term-trigger-label').forEach(el => el.textContent = "Stop Trigger Activation ($)");
            document.querySelectorAll('.term-tif-label').forEach(el => el.textContent = "Time in Force (TIF)");
            document.querySelectorAll('.term-tp-label').forEach(el => el.textContent = "Take Profit Target");
            document.querySelectorAll('.term-sl-label').forEach(el => el.textContent = "Stop Loss Threshold");
            document.querySelectorAll('.term-exit-header').forEach(el => el.textContent = "Risk-to-Reward & Protective Stops");
            document.getElementById('buyBtnLabel').textContent = "Long (Buy Position)";
            document.getElementById('sellBtnLabel').textContent = "Short (Sell Position)";
        } else {
            modeTitle.textContent = "Plain English Mode";
            modeSub.textContent = "Simple, everyday trading language";
            document.querySelectorAll('.term-quantity-label').forEach(el => el.textContent = "How Much to Trade");
            document.querySelectorAll('.term-leverage-label').forEach(el => el.textContent = "Borrow Multiplier");
            document.querySelectorAll('.term-price-label').forEach(el => el.textContent = "Desired Purchase Price ($)");
            document.querySelectorAll('.term-trigger-label').forEach(el => el.textContent = "Trigger Price ($)");
            document.querySelectorAll('.term-tif-label').forEach(el => el.textContent = "How Long Order Stays Open");
            document.querySelectorAll('.term-tp-label').forEach(el => el.textContent = "Profit Goal (Sell when up)");
            document.querySelectorAll('.term-sl-label').forEach(el => el.textContent = "Safety Stop (Sell if down)");
            document.querySelectorAll('.term-exit-header').forEach(el => el.textContent = "Safety Stops & Profit Goals");
            document.getElementById('buyBtnLabel').textContent = "Buy (Long)";
            document.getElementById('sellBtnLabel').textContent = "Sell (Short)";
        }
    }

    // ── 6. Client-Side Validation on Submit ──────────────────────────────────
    function submitOrder(side) {
        currentSide = side;
        document.getElementById('formOrderSide').value = side;

        const qty = parseFloat(document.getElementById('orderQuantityInput').value) || 0;
        if (qty <= 0) {
            alert('Order quantity must be greater than 0. Please enter a valid trade size or adjust the slider.');
            return;
        }

        const checkPrice = getActiveReferencePrice();

        // Handle Take Profit
        if (!tpEnabled) {
            document.getElementById('orderTakeProfitInput').value = '';
            document.getElementById('formMultiTpJson').value = '';
        } else {
            const tp = parseFloat(document.getElementById('orderTakeProfitInput').value) || 0;
            if (side === 1 && tp > 0 && tp <= checkPrice) {
                alert(`For Buy (Long) orders, Take Profit ($${tp}) must be set strictly ABOVE the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
            if (side === 2 && tp > 0 && tp >= checkPrice) {
                alert(`For Sell (Short) orders, Take Profit ($${tp}) must be set strictly BELOW the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
            syncMultiTpJson();
        }

        // Handle Stop Loss
        if (!slEnabled) {
            document.getElementById('orderStopLossInput').value = '';
            document.getElementById('orderTrailingStopInput').value = '';
        } else {
            const sl = parseFloat(document.getElementById('orderStopLossInput').value) || 0;
            if (side === 1 && sl > 0 && sl >= checkPrice) {
                alert(`For Buy (Long) orders, Stop Loss ($${sl}) must be set strictly BELOW the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
            if (side === 2 && sl > 0 && sl <= checkPrice) {
                alert(`For Sell (Short) orders, Stop Loss ($${sl}) must be set strictly ABOVE the entry price ($${checkPrice.toFixed(2)}).`);
                return;
            }
        }

        document.getElementById('tradingOrderForm').submit();
    }

    // ── 7. Interactive HTML5 Canvas Pro Chart with Drawing Tools ────────────
    const canvas = document.getElementById('tradingCanvas');
    const ctx = canvas.getContext('2d');
    let candles = [];
    let currentStyle = 'candles';
    let activeIndicators = { ema20: false, ema50: false, bollinger: false, volume: true };
    let activeTool = null;
    let drawings = [];

    function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
        drawChart();
    }
    window.addEventListener('resize', resizeCanvas);

    function generateRealisticCandles(count = 70) {
        candles = [];
        let price = basePrice * 0.95;
        const now = Date.now();
        const intervalMs = 15 * 60 * 1000;

        for (let i = count; i >= 0; i--) {
            const time = new Date(now - i * intervalMs);
            const delta = (Math.random() - 0.48) * (price * 0.008);
            const open = price;
            const close = open + delta;
            const high = Math.max(open, close) + Math.random() * (price * 0.004);
            const low = Math.min(open, close) - Math.random() * (price * 0.004);
            const volume = Math.floor(Math.random() * 8000) + 1200;

            candles.push({ time, open, high, low, close, volume });
            price = close;
        }
    }

    function setTimeframe(tf) {
        document.querySelectorAll('.tf-btn').forEach(b => {
            b.classList.remove('active', 'bg-brand-500', 'text-white');
        });
        const btn = document.querySelector(`.tf-btn[data-tf="${tf}"]`);
        if (btn) btn.classList.add('active', 'bg-brand-500', 'text-white');
        generateRealisticCandles();
        drawChart();
    }

    function setChartStyle(style) {
        currentStyle = style;
        drawChart();
    }

    function toggleIndicator(ind) {
        activeIndicators[ind] = !activeIndicators[ind];
        const btn = document.getElementById('btn' + ind.charAt(0).toUpperCase() + ind.slice(1));
        if (activeIndicators[ind]) {
            btn.classList.add('border-brand-500', 'bg-brand-500', 'text-white');
            btn.classList.remove('bg-slate-50', 'dark:bg-slate-800');
        } else {
            btn.classList.remove('border-brand-500', 'bg-brand-500', 'text-white');
            btn.classList.add('bg-slate-50', 'dark:bg-slate-800');
        }
        drawChart();
    }

    function selectTool(name) {
        activeTool = name;
        const banner = document.getElementById('activeToolBanner');
        document.getElementById('activeToolName').textContent = name;
        banner.classList.remove('hidden');
    }

    function clearDrawings() {
        drawings = [];
        activeTool = null;
        document.getElementById('activeToolBanner').classList.add('hidden');
        drawChart();
    }

    canvas.addEventListener('click', function(e) {
        if (!activeTool) return;
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        drawings.push({ tool: activeTool, x, y });
        activeTool = null;
        document.getElementById('activeToolBanner').classList.add('hidden');
        drawChart();
    });

    function drawChart() {
        if (!canvas.width || !candles.length) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const paddingRight = 65;
        const paddingBottom = 25;
        const chartWidth = canvas.width - paddingRight;
        const chartHeight = canvas.height - paddingBottom;

        let minPrice = Math.min(...candles.map(c => c.low));
        let maxPrice = Math.max(...candles.map(c => c.high));
        const priceRange = maxPrice - minPrice || 1;

        // Grid lines
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 1;
        for (let i = 1; i <= 5; i++) {
            const y = (chartHeight / 5) * i;
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(chartWidth, y);
            ctx.stroke();

            // Price Labels
            const p = maxPrice - (priceRange / 5) * i;
            ctx.fillStyle = '#64748b';
            ctx.font = '10px monospace';
            ctx.fillText('$' + p.toFixed(2), chartWidth + 6, y + 3);
        }

        const candleWidth = chartWidth / candles.length;

        // Draw Volume Bars
        if (activeIndicators.volume) {
            const maxVol = Math.max(...candles.map(c => c.volume));
            candles.forEach((c, idx) => {
                const x = idx * candleWidth;
                const vHeight = (c.volume / maxVol) * (chartHeight * 0.2);
                ctx.fillStyle = c.close >= c.open ? 'rgba(16, 185, 129, 0.25)' : 'rgba(244, 63, 94, 0.25)';
                ctx.fillRect(x + 1, chartHeight - vHeight, candleWidth - 2, vHeight);
            });
        }

        // Draw Candles or Line
        candles.forEach((c, idx) => {
            const x = idx * candleWidth + candleWidth / 2;
            const openY = chartHeight - ((c.open - minPrice) / priceRange) * chartHeight;
            const closeY = chartHeight - ((c.close - minPrice) / priceRange) * chartHeight;
            const highY = chartHeight - ((c.high - minPrice) / priceRange) * chartHeight;
            const lowY = chartHeight - ((c.low - minPrice) / priceRange) * chartHeight;
            const isGreen = c.close >= c.open;

            ctx.strokeStyle = isGreen ? '#10b981' : '#f43f5e';
            ctx.fillStyle = isGreen ? '#10b981' : '#f43f5e';

            if (currentStyle === 'candles' || currentStyle === 'heikin') {
                // Wick
                ctx.beginPath();
                ctx.moveTo(x, highY);
                ctx.lineTo(x, lowY);
                ctx.stroke();

                // Body
                const bodyY = Math.min(openY, closeY);
                const bodyH = Math.max(Math.abs(closeY - openY), 2);
                ctx.fillRect(x - (candleWidth * 0.35), bodyY, candleWidth * 0.7, bodyH);
            } else if (currentStyle === 'line' || currentStyle === 'area') {
                if (idx > 0) {
                    const prevC = candles[idx - 1];
                    const prevX = (idx - 1) * candleWidth + candleWidth / 2;
                    const prevCloseY = chartHeight - ((prevC.close - minPrice) / priceRange) * chartHeight;

                    ctx.strokeStyle = '#3b82f6';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(prevX, prevCloseY);
                    ctx.lineTo(x, closeY);
                    ctx.stroke();
                }
            }
        });

        // Draw Indicator EMAs
        if (activeIndicators.ema20) drawMovingAverage(20, '#38bdf8');
        if (activeIndicators.ema50) drawMovingAverage(50, '#f59e0b');

        // Draw User On-Chart Tool Annotations
        drawings.forEach(d => {
            ctx.fillStyle = '#f59e0b';
            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 2;

            if (d.tool.includes('Line') || d.tool.includes('Ray')) {
                ctx.beginPath();
                ctx.moveTo(0, d.y);
                ctx.lineTo(chartWidth, d.y);
                ctx.stroke();
                ctx.font = '10px sans-serif';
                ctx.fillText(d.tool, 10, d.y - 4);
            } else if (d.tool.includes('Fib')) {
                for (let step = 0; step <= 4; step++) {
                    const fy = d.y + step * 25;
                    ctx.strokeStyle = 'rgba(245, 158, 11, ' + (1 - step * 0.2) + ')';
                    ctx.beginPath();
                    ctx.moveTo(0, fy);
                    ctx.lineTo(chartWidth, fy);
                    ctx.stroke();
                }
                ctx.fillText(d.tool, 10, d.y - 4);
            } else {
                ctx.font = '12px sans-serif';
                ctx.fillText(`📍 ${d.tool}`, d.x, d.y);
            }
        });
    }

    function drawMovingAverage(period, color) {
        const paddingBottom = 25;
        const chartWidth = canvas.width - 65;
        const chartHeight = canvas.height - paddingBottom;
        const minPrice = Math.min(...candles.map(c => c.low));
        const maxPrice = Math.max(...candles.map(c => c.high));
        const priceRange = maxPrice - minPrice || 1;
        const candleWidth = chartWidth / candles.length;

        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();

        for (let i = period - 1; i < candles.length; i++) {
            const subset = candles.slice(i - period + 1, i + 1);
            const avg = subset.reduce((acc, v) => acc + v.close, 0) / period;
            const x = i * candleWidth + candleWidth / 2;
            const y = chartHeight - ((avg - minPrice) / priceRange) * chartHeight;

            if (i === period - 1) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
        }
        ctx.stroke();
    }

    // Initialize chart & calculations on page load
    generateRealisticCandles();
    setTimeout(resizeCanvas, 50);
    recalculateAllSizeAndMargin();
</script>
}
