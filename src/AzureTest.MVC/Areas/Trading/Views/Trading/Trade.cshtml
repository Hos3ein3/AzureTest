    function setQuickRr(ratio) {
        const refPrice = getActiveReferencePrice();
        const slPct = 0.03;
        const tpPct = slPct * ratio;

        const tpInput = document.getElementById('orderTakeProfitInput');
        const slInput = document.getElementById('orderStopLossInput');

        if (currentSide === 1) { // Buy
            tpInput.value = (refPrice * (1 + tpPct)).toFixed(2);
            slInput.value = (refPrice * (1 - slPct)).toFixed(2);
        } else { // Sell
            tpInput.value = (refPrice * (1 - tpPct)).toFixed(2);
            slInput.value = (refPrice * (1 + slPct)).toFixed(2);
        }

        if (!tpEnabled) {
            document.getElementById('tpToggleSwitch').checked = true;
            toggleTpEnabled(true);
        }
        if (!slEnabled) {
            document.getElementById('slToggleSwitch').checked = true;
            toggleSlEnabled(true);
        }

        calculateRiskRewardOutputs();
    }

    function calculateRiskRewardOutputs() {
        const refPrice = getActiveReferencePrice();
        const units = currentCalculatedUnits;

        if (tpEnabled) {
            const tp = parseFloat(document.getElementById('orderTakeProfitInput').value) || 0;
            const tpSummary = document.getElementById('tpRewardSummary');
            if (tp > 0 && units > 0 && refPrice > 0) {
                const diff = currentSide === 1 ? (tp - refPrice) : (refPrice - diff);
                const rewardUsd = Math.abs(tp - refPrice) * units;
                const rewardPct = ((Math.abs(tp - refPrice) / refPrice) * 100);
                tpSummary.textContent = `+$${rewardUsd.toFixed(2)} (+${rewardPct.toFixed(2)}%)`;
            }
        }

        if (slEnabled) {
            const sl = parseFloat(document.getElementById('orderStopLossInput').value) || 0;
            const slSummary = document.getElementById('slRiskSummary');
            if (sl > 0 && units > 0 && refPrice > 0) {
                const riskUsd = Math.abs(refPrice - sl) * units;
                const riskPct = ((Math.abs(refPrice - sl) / refPrice) * 100);
                slSummary.textContent = `-$${riskUsd.toFixed(2)} (-${riskPct.toFixed(2)}%)`;
            }
        }
    }

