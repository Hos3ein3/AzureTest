                longLbl.className = "text-3xs font-extrabold uppercase text-slate-400";
                shortLbl.className = "text-3xs font-black uppercase text-rose-600 dark:text-rose-400";
            }
        }

        updateSideSpecificLabels();

        if (flipTpSl) {
            const refPrice = getActiveReferencePrice();
            const tpInput = document.getElementById('orderTakeProfitInput');
            const slInput = document.getElementById('orderStopLossInput');
            if (refPrice > 0) {
                if (side === 1) {
                    if (tpInput) tpInput.value = formatPriceInput(refPrice * 1.05);
                    if (slInput) slInput.value = formatPriceInput(refPrice * 0.97);
                } else {
                    if (tpInput) tpInput.value = formatPriceInput(refPrice * 0.95);
                    if (slInput) slInput.value = formatPriceInput(refPrice * 1.03);
                }
            }
            onTpLevelChange();
            calculateRiskRewardOutputs();
