                        <button type="button" onclick="setSliderPreset(50)" class="hover:text-brand-500">50%</button>
                        <button type="button" onclick="setSliderPreset(75)" class="hover:text-brand-500">75%</button>
                        <button type="button" onclick="setSliderPreset(100)" class="hover:text-brand-500 font-black">100% (Max)</button>
                    </div>
