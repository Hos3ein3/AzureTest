                    <button type="button" onclick="selectTool('Triangle')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Triangle</button>
                    <button type="button" onclick="selectTool('Arc')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Arc</button>
                    <button type="button" onclick="selectTool('Curve')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Curve</button>
