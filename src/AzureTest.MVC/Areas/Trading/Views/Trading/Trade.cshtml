            </button>
        </div>

        <!-- Order Form Submission -->
        <form asp-action="PlaceOrder" method="post" id="tradingOrderForm" class="space-y-6">
            <input type="hidden" name="symbol" value="@selected.Symbol" />
            <input type="hidden" name="assetName" value="@selected.AssetName" />
            <input type="hidden" name="assetClass" value="@((int)selected.AssetClass)" />
            <input type="hidden" name="side" id="formOrderSide" value="1" /> <!-- 1 = Buy, 2 = Sell -->
            <input type="hidden" name="orderType" id="formOrderType" value="1" /> <!-- 1 = Market, 2 = Limit, 3 = Stop -->
            <input type="hidden" name="multipleTakeProfitsJson" id="formMultiTpJson" value="" />
            <input type="hidden" name="quantity" id="orderQuantityInput" value="1" />

            <!-- Price & Order Duration Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Market Execution Price Display (Active by default on Market Tab) -->
                <div id="marketPriceGroup" class="space-y-1">
                    <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300">
                        <span class="term-market-label">Market Execution Price</span>
                        <span class="inline-flex items-center gap-1 text-3xs font-extrabold text-emerald-500">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Auto-Syncing
                        </span>
                    </div>
                    <div class="px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 font-mono font-black text-slate-900 dark:text-white flex items-center justify-between">
                        <span id="marketOrderPriceDisplay">$@selected.Price.ToString("N2")</span>
                        <span class="text-3xs uppercase font-extrabold px-1.5 py-0.5 rounded bg-brand-50 dark:bg-brand-950/40 text-brand-600 dark:text-brand-400">Instant Fill</span>
                    </div>
                </div>

                <!-- Limit / Stop Trigger Price (Shown conditionally based on active tab) -->
                <div id="priceInputGroup" class="hidden space-y-1">
