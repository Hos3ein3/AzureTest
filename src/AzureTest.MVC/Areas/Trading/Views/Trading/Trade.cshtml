                                    <button type="button" onclick="removeTpLevel(this)" class="tp-level-remove hidden p-1.5 text-slate-400 hover:text-rose-500 rounded transition-colors shrink-0" title="Remove level">
                                        <i class="fa-solid fa-xmark text-xs"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="flex justify-between items-center text-3xs font-bold text-slate-400 pt-1">
