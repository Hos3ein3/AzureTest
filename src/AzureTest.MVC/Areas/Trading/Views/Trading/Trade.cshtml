                        <button type="button" onclick="setStopToMarket()" class="text-3xs font-extrabold text-brand-500 hover:underline">
                            ⚡ Market: <span id="stopMarketHint">$@selected.Price.ToString("N2")</span>
                        </button>
                    </div>
                    <input type="number" step="any" min="0.000001" name="triggerPrice" id="orderTriggerPriceInput" value="@selected.Price" oninput="recalculateAllSizeAndMargin()"
