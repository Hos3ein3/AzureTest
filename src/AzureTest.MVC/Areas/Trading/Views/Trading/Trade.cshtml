    // ── 8. Chart Engine (Official TradingView Pro Widget & Interactive Canvas) ──
    function getTradingViewSymbol(sym, assetClass) {
        const s = (sym || '').toUpperCase();
        if (assetClass === 1) { // Crypto
            if (s.endsWith('USDT')) return 'BINANCE:' + s;
            return 'BINANCE:' + s + 'USDT';
        } else if (assetClass === 2) { // Forex
            return 'FX:' + s.replace('/', '');
        } else if (assetClass === 3) { // Stock
            return 'NASDAQ:' + s;
        } else if (assetClass === 4) { // Index
            if (s === 'SPX') return 'SP:SPX';
            if (s === 'NDX') return 'NASDAQ:NDX';
            if (s === 'DJI') return 'DJ:DJI';
            if (s === 'DAX') return 'XETR:DAX';
            if (s === 'FTSE') return 'INDEX:FTSE';
            return s;
        } else if (assetClass === 5) { // Future
            if (s === 'XAUUSD') return 'OANDA:XAUUSD';
            if (s === 'XAGUSD') return 'OANDA:XAGUSD';
            if (s === 'USOIL') return 'TVC:USOIL';
            if (s === 'NATGAS') return 'TVC:NATGAS';
            if (s === 'ES') return 'CME_MINI:ES1!';
            return s;
        }
        return 'BINANCE:BTCUSDT';
    }

