                    </button>
                    <button type="button" onclick="filterPositionsView('current')" id="btnPosFilterCurrent" class="pos-filter-btn px-2.5 sm:px-3 py-1 rounded-lg text-3xs sm:text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 shrink-0">
