                                    <td class="p-3 font-mono text-slate-600 dark:text-slate-300 whitespace-nowrap">
                                        @FormatTablePrice5(pos.EntryPrice)
                                    </td>
                                    <td class="p-3 font-mono font-black text-slate-900 dark:text-white whitespace-nowrap" id="posCurrentPrice_@pos.Id">
                                        @FormatTablePrice5(pos.CurrentPrice)
                                    </td>
                                    <td class="p-3 font-mono text-slate-600 dark:text-slate-300 whitespace-nowrap">
                                        @FormatTablePrice5(pos.InitialMargin)
                                    </td>
                                    <td class="p-3 font-mono text-3xs text-slate-500 whitespace-nowrap" id="posSl_@pos.Id">
                                        @(pos.StopLoss.HasValue && pos.StopLoss > 0 ? FormatTablePrice5(pos.StopLoss.Value) : "--")
