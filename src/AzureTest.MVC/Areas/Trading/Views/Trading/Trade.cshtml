                                </div>
                                <div class="flex items-center gap-1">
                                    <span>Est. Reward:</span>
                                    <span id="tpRewardSummary" class="text-emerald-600 font-mono font-black">+$0.00 (+5.00%)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stop Loss Box with iOS Switch -->
                    <div class="p-4 rounded-xl border border-slate-200/80 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40 space-y-3">
