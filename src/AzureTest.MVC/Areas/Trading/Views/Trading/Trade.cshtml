    // ── 6. Client-Side Validation & AJAX Order Placement ───────────────────
    async function submitOrder(side) {
        if (currentSide !== side) {
            setOrderSide(side, false);
        }
        currentSide = side;
        document.getElementById('formOrderSide').value = side;

        recalculateAllSizeAndMargin();
        let qty = parseFloat((document.getElementById('orderQuantityInput').value || '').trim().replace(',', '.')) || 0;
        if (qty <= 0 && currentCalculatedUnits > 0) {
            qty = currentCalculatedUnits;
            document.getElementById('orderQuantityInput').value = qty > 1 ? qty.toFixed(4) : qty.toFixed(6);
        }
        if (qty <= 0) {
            showToast('error', 'Order quantity must be greater than 0. Please select an order size (% Balance or Units).');
            return;
        }

        const checkPrice = getActiveReferencePrice();

        // Handle Take Profit validation
        if (!tpEnabled) {
            document.getElementById('orderTakeProfitInput').value = '';
        } else {
            const rawTp = (document.getElementById('orderTakeProfitInput').value || '').trim().replace(',', '.');
            const tp = parseFloat(rawTp) || 0;
            if (side === 1 && tp > 0 && tp <= checkPrice) {
                showToast('error', `For Buy (Long) orders, Take Profit (${formatPrice5(tp)}) must be set strictly ABOVE the entry price (${formatPrice5(checkPrice)}).`);
                return;
            }
            if (side === 2 && tp > 0 && tp >= checkPrice) {
                showToast('error', `For Sell (Short) orders, Take Profit (${formatPrice5(tp)}) must be set strictly BELOW the entry price (${formatPrice5(checkPrice)}).`);
                return;
            }
        }

        // Handle Stop Loss validation
        if (!slEnabled) {
            document.getElementById('orderStopLossInput').value = '';
        } else {
            const rawSl = (document.getElementById('orderStopLossInput').value || '').trim().replace(',', '.');
            const sl = parseFloat(rawSl) || 0;
            if (side === 1 && sl > 0 && sl >= checkPrice) {
                showToast('error', `For Buy (Long) orders, Stop Loss (${formatPrice5(sl)}) must be set strictly BELOW the entry price (${formatPrice5(checkPrice)}).`);
                return;
            }
            if (side === 2 && sl > 0 && sl <= checkPrice) {
                showToast('error', `For Sell (Short) orders, Stop Loss (${formatPrice5(sl)}) must be set strictly ABOVE the entry price (${formatPrice5(checkPrice)}).`);
                return;
            }
        }

        // Disable buttons and show processing state
        const buyBtn = document.getElementById('buyOrderSubmitBtn');
        const sellBtn = document.getElementById('sellOrderSubmitBtn');
        if (buyBtn) buyBtn.disabled = true;
        if (sellBtn) sellBtn.disabled = true;

        const form = document.getElementById('tradingOrderForm');
        const formData = new FormData(form);

        try {
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    showToast('success', data.message || 'Trade executed successfully!');
                    setTimeout(() => window.location.reload(), 800);
                    return;
                } else {
                    showToast('error', data.error || 'Failed to place order.');
                }
            } else {
                form.submit();
                return;
            }
        } catch (err) {
            console.warn('AJAX submit fallback:', err);
            form.submit();
            return;
        } finally {
            if (buyBtn) buyBtn.disabled = false;
            if (sellBtn) sellBtn.disabled = false;
        }
    }

    async function ajaxClosePosition(posId, sym) {
        try {
            const priceEl = document.getElementById(`posCurrentPrice_${posId}`);
            let cp = priceEl ? parseFloat(priceEl.textContent.replace('$', '').replace(/,/g, '').trim()) : 0;
            if (!cp || isNaN(cp) || cp <= 0) {
                if (typeof basePrice !== 'undefined' && basePrice > 0 && String(sym).toUpperCase() === String(symbol).toUpperCase()) {
                    cp = basePrice;
                }
            }

            const formData = new FormData();
            formData.append('positionId', posId);
            formData.append('symbol', sym);
            if (cp > 0) {
                formData.append('closePrice', cp);
            }
            formData.append('sourcePage', 'trade');

            const res = await fetch('/Trading/Trading/ClosePosition', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    showToast('success', data.message || 'Position closed successfully.');
                    const row = document.getElementById(`posRow_${posId}`);
                    if (row) {
                        row.classList.add('bg-rose-50', 'dark:bg-rose-950/20');
                        setTimeout(() => row.remove(), 250);
                    }
                    pollLiveTradeStatus(true);
                } else {
                    showToast('error', data.error || 'Failed to close position.');
                }
            }
        } catch (err) {
            console.error('Failed to close position:', err);
        }
    }

    async function ajaxCancelOrder(ordId, sym) {
        try {
            const formData = new FormData();
            formData.append('orderId', ordId);
            formData.append('symbol', sym);
            formData.append('sourcePage', 'trade');

            const res = await fetch('/Trading/Trading/CancelOrder', {
