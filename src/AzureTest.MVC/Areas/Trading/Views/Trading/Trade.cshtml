                    <button type="button" onclick="selectTool('Emojis')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Emojis 🚀 📈 🔥</button>
                    <button type="button" onclick="selectTool('Stickers')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Stickers</button>
                    <button type="button" onclick="selectTool('Icons')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Icons</button>
