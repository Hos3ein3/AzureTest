                        <span class="term-price-label">Limit Price ($)</span>
                        <button type="button" onclick="setLimitToMarket()" class="text-3xs font-extrabold text-brand-500 hover:underline">
                            ⚡ Market: <span id="limitMarketHint">$@selected.Price.ToString("N2")</span>
                        </button>
                    </div>
                    <input type="number" step="any" min="0.000001" name="price" id="orderPriceInput" value="@selected.Price" oninput="recalculateAllSizeAndMargin()"
