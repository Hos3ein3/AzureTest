    // ── Modify Position Modal Logic (Full Multi-Level Take Profit Support) ────────
    function openModifyModal(id, symbol, side, entry, current, sl, tp) {
        document.getElementById('modifyPosId').value = id;
        document.getElementById('modifyPosSymbol').value = symbol;
        document.getElementById('modifyModalSymbol').textContent = symbol;
        document.getElementById('modifyModalSideBadge').textContent = `${side} Position`;
        document.getElementById('modifyModalPrices').textContent = `${formatPrice5(entry)} / ${formatPrice5(current)}`;
        document.getElementById('modifyPosCurrentPrice').value = current;
        document.getElementById('modifyPosSide').value = side;

        const slInput = document.getElementById('modifyPosSlInput');
        slInput.value = (sl && Number(sl) > 0) ? Number(sl).toFixed(5) : '';

        const slHint = document.getElementById('modifySlHint');
        const tpHint = document.getElementById('modifyTpHint');
        if (String(side).toLowerCase().includes('buy')) {
            slHint.textContent = `Must be strictly BELOW current price (${formatPrice5(current)}).`;
            tpHint.textContent = `Must be strictly ABOVE current price (${formatPrice5(current)}).`;
        } else {
            slHint.textContent = `Must be strictly ABOVE current price (${formatPrice5(current)}).`;
            tpHint.textContent = `Must be strictly BELOW current price (${formatPrice5(current)}).`;
        }

        // Retrieve existing multi-level TP JSON from row data attribute
        const row = document.getElementById(`posRow_${id}`) || document.getElementById(`idxPosRow_${id}`);
        const multiTpJson = row ? row.getAttribute('data-multi-tp') : '';
        populateModifyTpLevels(multiTpJson, tp, side, current);

        document.getElementById('modifyPositionModal').classList.remove('hidden');
    }

    function populateModifyTpLevels(multiTpJson, singleTp, side, currentPrice) {
        const container = document.getElementById('modifyTpLevelsContainer');
        if (!container) return;
        container.innerHTML = '';

        let levels = [];
        if (multiTpJson) {
            try {
                const parsed = typeof multiTpJson === 'string' ? JSON.parse(multiTpJson) : multiTpJson;
                if (Array.isArray(parsed) && parsed.length > 0) {
                    levels = parsed;
                }
            } catch (e) {
                console.debug('Failed to parse position multi-tp json:', e);
            }
        }

        if (levels.length === 0 && singleTp && Number(singleTp) > 0) {
            levels = [{ price: Number(singleTp), percentage: 100 }];
        }

        if (levels.length === 0) {
            // Default 1 blank row
            levels = [{ price: '', percentage: 100 }];
        }

        levels.forEach((lvl, idx) => {
            const p = (lvl.price !== undefined && lvl.price !== null && lvl.price !== '') ? formatPriceInput(lvl.price) : '';
            const pct = lvl.percentage || (levels.length === 1 ? 100 : Math.floor(100 / levels.length));
            const rowEl = createModifyTpHtmlRow(idx + 1, p, pct, levels.length > 1);
            container.appendChild(rowEl);
        });

        onModifyTpLevelChange();
    }

    function createModifyTpHtmlRow(index, priceVal, pctVal, showRemove) {
        const div = document.createElement('div');
        div.className = 'modify-tp-row flex items-center gap-2';
        div.setAttribute('data-index', index);
        div.innerHTML = `
            <span class="text-3xs font-black text-emerald-600 dark:text-emerald-400 px-1.5 py-1 rounded bg-emerald-500/10 shrink-0 modify-tp-tag">TP ${index}</span>
            <div class="relative flex-1">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-xs">$</span>
                <input type="text" inputmode="decimal"
                       value="${priceVal}"
                       placeholder="Target Price"
                       oninput="this.value = this.value.replace(',', '.'); onModifyTpLevelChange();"
                       class="modify-tp-price w-full pl-6 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
            </div>
            <div class="flex items-center gap-1 w-20 shrink-0">
                <input type="number" min="1" max="100" value="${pctVal}"
                       oninput="onModifyTpLevelChange();"
                       class="modify-tp-pct w-14 px-1.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                <span class="text-3xs font-extrabold text-slate-400">%</span>
            </div>
            <button type="button" onclick="removeModifyTpLevel(this)" class="modify-tp-remove ${showRemove ? '' : 'hidden'} p-1.5 text-slate-400 hover:text-rose-500 rounded transition-colors shrink-0" title="Remove level">
                <i class="fa-solid fa-xmark text-xs"></i>
            </button>
        `;
        return div;
    }

    function addModifyTpLevel() {
        const container = document.getElementById('modifyTpLevelsContainer');
        const rows = container.querySelectorAll('.modify-tp-row');
        if (rows.length >= 5) {
            showToast('error', 'Maximum 5 Take Profit levels allowed.');
            return;
        }

        const newIndex = rows.length + 1;
        const currentPrice = parseFloat(document.getElementById('modifyPosCurrentPrice').value) || 0;
        const side = document.getElementById('modifyPosSide').value;
        const isBuy = String(side).toLowerCase().includes('buy');
        const offset = isBuy ? (1 + (0.02 * newIndex)) : (1 - (0.02 * newIndex));
        const suggPrice = currentPrice > 0 ? formatPriceInput(currentPrice * offset) : '';

        const newPct = Math.floor(100 / newIndex);
        const remPct = 100 - (newPct * (newIndex - 1));

        rows.forEach((r, idx) => {
            const pctInput = r.querySelector('.modify-tp-pct');
            if (pctInput) pctInput.value = (idx === 0 ? remPct : newPct);
        });

        const newRow = createModifyTpHtmlRow(newIndex, suggPrice, newPct, true);
        container.appendChild(newRow);

        container.querySelectorAll('.modify-tp-remove').forEach(btn => btn.classList.remove('hidden'));
        onModifyTpLevelChange();
    }

    function removeModifyTpLevel(btn) {
        const row = btn.closest('.modify-tp-row');
        const container = document.getElementById('modifyTpLevelsContainer');
        if (row && container) {
            row.remove();
            const remaining = container.querySelectorAll('.modify-tp-row');
            remaining.forEach((r, idx) => {
                const tag = r.querySelector('.modify-tp-tag');
                if (tag) tag.textContent = `TP ${idx + 1}`;
                r.setAttribute('data-index', idx + 1);
            });

            if (remaining.length <= 1) {
                remaining.forEach(r => {
                    const remBtn = r.querySelector('.modify-tp-remove');
                    if (remBtn) remBtn.classList.add('hidden');
                    const pct = r.querySelector('.modify-tp-pct');
                    if (pct) pct.value = 100;
                });
            }

            onModifyTpLevelChange();
        }
    }

    function clearModifyTpLevels() {
        const container = document.getElementById('modifyTpLevelsContainer');
        if (container) {
            container.innerHTML = '';
            container.appendChild(createModifyTpHtmlRow(1, '', 100, false));
            onModifyTpLevelChange();
        }
    }

    function onModifyTpLevelChange() {
        const container = document.getElementById('modifyTpLevelsContainer');
        if (!container) return;
        const rows = container.querySelectorAll('.modify-tp-row');

        let totalPct = 0;
        const validLevels = [];

        rows.forEach((r, idx) => {
            const priceInput = r.querySelector('.modify-tp-price');
            const pctInput = r.querySelector('.modify-tp-pct');
            const p = parseFloat((priceInput?.value || '').replace(',', '.')) || 0;
            const pct = parseFloat(pctInput?.value) || 0;

            totalPct += pct;
            if (p > 0 && pct > 0) {
                validLevels.push({ price: p, percentage: pct });
            }

            if (idx === 0) {
                document.getElementById('modifyPosTpInput').value = p > 0 ? p : '';
            }
        });

        const badge = document.getElementById('modifyTpAllocationBadge');
        if (badge) {
            badge.textContent = `${totalPct}%`;
            if (totalPct === 100) badge.className = 'text-emerald-600 font-mono font-black';
            else if (totalPct > 100) badge.className = 'text-rose-500 font-mono font-black animate-pulse';
            else badge.className = 'text-amber-500 font-mono font-black';
        }

        const jsonInput = document.getElementById('modifyMultipleTakeProfitsJson');
        if (jsonInput) {
            jsonInput.value = (validLevels.length > 0) ? JSON.stringify(validLevels) : '';
        }
    }

    function closeModifyModal() {
        document.getElementById('modifyPositionModal').classList.add('hidden');
    }

    async function submitModifyPosition(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSaveModifyPosition');
        const posId = document.getElementById('modifyPosId').value;
        const sym = document.getElementById('modifyPosSymbol').value;
        const side = document.getElementById('modifyPosSide').value;
        const currentPrice = parseFloat(document.getElementById('modifyPosCurrentPrice').value) || 0;
        const sl = (document.getElementById('modifyPosSlInput').value || '').trim();
        const tp = (document.getElementById('modifyPosTpInput').value || '').trim();
        const multiTpJson = (document.getElementById('modifyMultipleTakeProfitsJson').value || '').trim();

        // Multi-level TP client-side validation
        if (multiTpJson) {
            try {
                const levels = JSON.parse(multiTpJson);
                const isBuy = String(side).toLowerCase().includes('buy');
                let totalPct = 0;
                for (let lvl of levels) {
                    const p = Number(lvl.price);
                    const pct = Number(lvl.percentage);
                    if (isBuy && p <= currentPrice) {
                        showToast('error', `Multi-level TP price ($${p}) must be above current price ($${currentPrice}).`);
                        return;
                    }
                    if (!isBuy && p >= currentPrice) {
                        showToast('error', `Multi-level TP price ($${p}) must be below current price ($${currentPrice}).`);
                        return;
                    }
                    if (pct <= 0 || pct > 100) {
                        showToast('error', 'Each Take Profit percentage must be between 1% and 100%.');
                        return;
                    }
                    totalPct += pct;
                }
                if (totalPct !== 100) {
                    showToast('error', `Total Take Profit percentage allocation must equal 100% (currently ${totalPct}%).`);
                    return;
                }
            } catch (err) {
                showToast('error', 'Invalid multi-level Take Profit format.');
                return;
            }
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

        try {
            const fd = new FormData();
            fd.append('positionId', posId);
            fd.append('symbol', sym);
            fd.append('stopLoss', sl);
            fd.append('takeProfit', tp);
            fd.append('multipleTakeProfitsJson', multiTpJson);
            fd.append('sourcePage', 'trade');

            const res = await fetch('/Trading/Trading/ModifyPosition', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const data = await res.json();
            if (res.ok && data.success) {
                showToast('success', data.message || 'Position stops updated successfully!');
                closeModifyModal();

                const slCell = document.getElementById(`posSl_${posId}`);
                if (slCell) slCell.textContent = (sl && parseFloat(sl) > 0) ? formatPrice5(sl) : '--';

                const tpCell = document.getElementById(`posTp_${posId}`);
                if (tpCell) {
                    tpCell.innerHTML = renderTpCellHtml(tp, multiTpJson);
                }

                const row = document.getElementById(`posRow_${posId}`);
                if (row) {
                    row.setAttribute('data-multi-tp', multiTpJson || '');
                }

                pollLiveTradeStatus(true);
            } else {
                showToast('error', data.error || 'Failed to update position.');
            }
        } catch (err) {
            showToast('error', err.message || 'Network error updating position.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> <span>Save Protection</span>';
        }
    }

    // ── 7. Holdings Station Tabs & Filters ──────────────────────────────────
    function switchHoldingTab(tab) {
        document.querySelectorAll('.holding-tab-btn').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-2xs');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('tabHolding' + tab.charAt(0).toUpperCase() + tab.slice(1));
        if (activeBtn) {
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-2xs');
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
        }

        document.getElementById('holdingPanelOpen').classList.add('hidden');
        document.getElementById('holdingPanelPending').classList.add('hidden');
        document.getElementById('holdingPanelClosed').classList.add('hidden');

        if (tab === 'open') document.getElementById('holdingPanelOpen').classList.remove('hidden');
        else if (tab === 'pending') document.getElementById('holdingPanelPending').classList.remove('hidden');
        else if (tab === 'closed') document.getElementById('holdingPanelClosed').classList.remove('hidden');
    }

    function filterPositionsView(scope) {
        const btnAll = document.getElementById('btnPosFilterAll');
        const btnCurr = document.getElementById('btnPosFilterCurrent');

        if (scope === 'all') {
            btnAll.className = "pos-filter-btn px-3 py-1 rounded-lg text-xs font-black bg-slate-100 dark:bg-slate-800 text-brand-600 dark:text-brand-400 border border-brand-500/30";
            btnCurr.className = "pos-filter-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200";
            document.querySelectorAll('.pos-row').forEach(r => r.classList.remove('hidden'));
        } else {
            btnCurr.className = "pos-filter-btn px-3 py-1 rounded-lg text-xs font-black bg-slate-100 dark:bg-slate-800 text-brand-600 dark:text-brand-400 border border-brand-500/30";
            btnAll.className = "pos-filter-btn px-3 py-1 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-800 dark:hover:text-slate-200";
            document.querySelectorAll('.pos-row').forEach(r => {
                const s = r.getAttribute('data-symbol');
                if (s && s.toUpperCase() === symbol.toUpperCase()) {
                    r.classList.remove('hidden');
                } else {
                    r.classList.add('hidden');
                }
            });
        }
    }

    // ── 8. Chart Engine (Official TradingView Pro Widget & Interactive Canvas) ──
    function getTradingViewSymbol(sym, assetClass, feed = '') {
        const s = (sym || '').toUpperCase();
        if (assetClass === 1) { // Crypto
            if (feed === 'mexc' || s === 'AGTUSDT') return 'MEXC:' + s;
            if (feed === 'dexscreener') return s;
            if (s.endsWith('USDT')) return 'BINANCE:' + s;
            return 'BINANCE:' + s + 'USDT';
        } else if (assetClass === 2) { // Forex
            return 'FX:' + s.replace('/', '');
        } else if (assetClass === 3) { // Stock
            return 'NASDAQ:' + s;
        } else if (assetClass === 4) { // Index
            if (s === 'SPX') return 'SP:SPX';
            if (s === 'NDX') return 'NASDAQ:NDX';
            if (s === 'DJI') return 'DJ:DJI';
            if (s === 'DAX') return 'XETR:DAX';
            if (s === 'FTSE') return 'INDEX:FTSE';
            return s;
        } else if (assetClass === 5) { // Future
            if (s === 'XAUUSD') return 'OANDA:XAUUSD';
            if (s === 'XAGUSD') return 'OANDA:XAGUSD';
            if (s === 'USOIL') return 'TVC:USOIL';
            if (s === 'NATGAS') return 'TVC:NATGAS';
            if (s === 'ES') return 'CME_MINI:ES1!';
            return s;
        }
        return 'BINANCE:BTCUSDT';
    }

    function initTradingViewWidget() {
        const container = document.getElementById('tradingview_widget');
        if (!container) return;
        container.innerHTML = '';

        const tvSymbol = getTradingViewSymbol(symbol, selectedAssetClass, feedSource);

        if (typeof TradingView !== 'undefined') {
            try {
                tvWidget = new TradingView.widget({
                    "autosize": true,
                    "symbol": tvSymbol,
                    "interval": "15",
                    "timezone": "Etc/UTC",
                    "theme": document.documentElement.classList.contains('dark') ? "dark" : "light",
                    "style": "1",
                    "locale": "en",
                    "toolbar_bg": "#f1f3f6",
                    "enable_publishing": false,
                    "hide_side_toolbar": false,
                    "allow_symbol_change": true,
                    "container_id": "tradingview_widget"
                });
            } catch (e) {
                console.warn("TradingView widget failed, fallback to canvas:", e);
                switchChartEngine('canvas');
            }
        } else {
            switchChartEngine('canvas');
        }
    }

    function switchChartEngine(engine) {
        currentChartEngine = engine;
        const btnTv = document.getElementById('btnTvEngine');
        const btnCanvas = document.getElementById('btnCanvasEngine');
        const tvDiv = document.getElementById('tradingview_widget');
        const canvasEl = document.getElementById('tradingCanvas');
        const canvasTf = document.getElementById('canvasTfGroup');
        const canvasExtras = document.getElementById('canvasExtrasGroup');
        const canvasToolbar = document.getElementById('canvasToolbar');
        const canvasStats = document.getElementById('canvasStatsPill');
        const canvasGuide = document.getElementById('canvasGuidePill');
        const watermark = document.getElementById('chartWatermark');

        if (engine === 'tradingview') {
            btnTv.className = "px-3 py-1.5 rounded-lg active bg-brand-500 text-white shadow-2xs transition-all flex items-center gap-1.5";
            btnCanvas.className = "px-3 py-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 transition-all flex items-center gap-1.5";
            tvDiv.classList.remove('hidden');
            canvasEl.classList.add('hidden');
            canvasTf.classList.add('hidden');
            canvasExtras.classList.add('hidden');
            canvasToolbar.classList.add('hidden');
            canvasStats.classList.add('hidden');
            canvasGuide.classList.add('hidden');
            watermark.classList.add('hidden');
            initTradingViewWidget();
        } else {
            btnCanvas.className = "px-3 py-1.5 rounded-lg active bg-brand-500 text-white shadow-2xs transition-all flex items-center gap-1.5";
            btnTv.className = "px-3 py-1.5 rounded-lg hover:bg-white dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 transition-all flex items-center gap-1.5";
            tvDiv.classList.add('hidden');
            canvasEl.classList.remove('hidden');
            canvasTf.classList.remove('hidden');
            canvasExtras.classList.remove('hidden');
            canvasToolbar.classList.remove('hidden');
            canvasStats.classList.remove('hidden');
            canvasGuide.classList.remove('hidden');
            watermark.classList.remove('hidden');
            generateRealisticCandles();
            resizeCanvas();
        }
    }

    function setChartHeight(h) {
        document.querySelectorAll('.chart-h-btn').forEach(b => {
            b.classList.remove('bg-white', 'dark:bg-slate-700', 'text-brand-600', 'dark:text-brand-400', 'shadow-2xs', 'font-black');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
        });
        const activeBtn = document.querySelector(`.chart-h-btn[data-h="${h}"]`);
        if (activeBtn) {
            activeBtn.classList.add('bg-white', 'dark:bg-slate-700', 'text-brand-600', 'dark:text-brand-400', 'shadow-2xs', 'font-black');
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
        }

        const container = document.getElementById('chartMainContainer');
        if (container) {
            container.style.height = h + 'px';
            if (currentChartEngine === 'canvas') resizeCanvas();
        }
    }

    function toggleChartFullscreen() {
        const c = document.getElementById('chartMainContainer');
        if (!c) return;
        if (!document.fullscreenElement) {
            c.requestFullscreen?.().then(() => {
                if (currentChartEngine === 'canvas') setTimeout(resizeCanvas, 150);
            }).catch(() => {});
        } else {
            document.exitFullscreen?.().then(() => {
                if (currentChartEngine === 'canvas') setTimeout(resizeCanvas, 150);
            });
        }
    }

    // ── 9. Interactive HTML5 Canvas Chart with Mouse Drag & Wheel Zoom ────────
    const canvas = document.getElementById('tradingCanvas');
    const ctx = canvas.getContext('2d');
    let candles = [];
    let currentStyle = 'candles';
    let activeIndicators = { ema20: false, ema50: false, bollinger: false, volume: true };
    let activeTool = null;
    let drawings = [];

    // Interactive Viewport State (Pan & Zoom)
    let visibleCount = 55;
    let panOffset = 0;
    let isDragging = false;
    let dragStartX = 0;
    let mousePos = { x: -1, y: -1 };

    function resizeCanvas() {
        if (!canvas || currentChartEngine !== 'canvas') return;
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
        drawChart();
    }
    window.addEventListener('resize', resizeCanvas);

    function generateRealisticCandles(count = 90) {
        candles = [];
        let price = basePrice * 0.94;
        const now = Date.now();
        const intervalMs = 15 * 60 * 1000;

        for (let i = count; i >= 0; i--) {
            const time = new Date(now - i * intervalMs);
            const delta = (Math.random() - 0.48) * (price * 0.007);
            const open = price;
            const close = open + delta;
            const high = Math.max(open, close) + Math.random() * (price * 0.003);
            const low = Math.min(open, close) - Math.random() * (price * 0.003);
            const volume = Math.floor(Math.random() * 8000) + 1200;

            candles.push({ time, open, high, low, close, volume });
            price = close;
        }
    }

    function setTimeframe(tf) {
        document.querySelectorAll('.tf-btn').forEach(b => {
            b.classList.remove('active', 'bg-brand-500', 'text-white');
        });
        const btn = document.querySelector(`.tf-btn[data-tf="${tf}"]`);
        if (btn) btn.classList.add('active', 'bg-brand-500', 'text-white');
        generateRealisticCandles();
        drawChart();
    }

    function setChartStyle(style) {
        currentStyle = style;
        drawChart();
    }

    function toggleIndicator(ind) {
        activeIndicators[ind] = !activeIndicators[ind];
        const btn = document.getElementById('btn' + ind.charAt(0).toUpperCase() + ind.slice(1));
        if (btn) {
            if (activeIndicators[ind]) {
                btn.classList.add('border-brand-500', 'bg-brand-500', 'text-white');
                btn.classList.remove('bg-slate-50', 'dark:bg-slate-800');
            } else {
                btn.classList.remove('border-brand-500', 'bg-brand-500', 'text-white');
                btn.classList.add('bg-slate-50', 'dark:bg-slate-800');
            }
        }
        drawChart();
    }

    function selectTool(name) {
        activeTool = name;
        const banner = document.getElementById('activeToolBanner');
        document.getElementById('activeToolName').textContent = name;
        banner.classList.remove('hidden');
    }

    function clearDrawings() {
        drawings = [];
        activeTool = null;
        document.getElementById('activeToolBanner').classList.add('hidden');
        drawChart();
    }

    // Canvas Mouse Wheel Event (Zoom In/Out)
    canvas.addEventListener('wheel', (e) => {
        if (currentChartEngine !== 'canvas') return;
        e.preventDefault();
        if (e.deltaY < 0) {
            // Zoom in
            visibleCount = Math.max(15, visibleCount - 4);
        } else {
            // Zoom out
            visibleCount = Math.min(candles.length - 2, visibleCount + 4);
        }
        drawChart();
    }, { passive: false });

    // Canvas Mouse Dragging (Pan)
    canvas.addEventListener('mousedown', (e) => {
        if (currentChartEngine !== 'canvas') return;
        isDragging = true;
        dragStartX = e.clientX;
    });

    window.addEventListener('mouseup', () => {
        isDragging = false;
    });

    canvas.addEventListener('mousemove', (e) => {
        if (currentChartEngine !== 'canvas') return;
        const rect = canvas.getBoundingClientRect();
        mousePos.x = e.clientX - rect.left;
        mousePos.y = e.clientY - rect.top;

        if (isDragging) {
            const dx = e.clientX - dragStartX;
            if (Math.abs(dx) > 10) {
                const shift = Math.round(dx / 12);
                panOffset = Math.max(0, Math.min(candles.length - visibleCount, panOffset - shift));
                dragStartX = e.clientX;
            }
        }

        drawChart();
    });

    canvas.addEventListener('mouseleave', () => {
        mousePos.x = -1;
        mousePos.y = -1;
        isDragging = false;
        drawChart();
    });

    function drawChart() {
        if (!canvas || currentChartEngine !== 'canvas') return;
        const w = canvas.width;
        const h = canvas.height;
        if (!w || !h) return;

        ctx.clearRect(0, 0, w, h);

        const padTop = 30;
        const padBottom = 40;
        const padRight = 75;
        const plotW = w - padRight;
        const plotH = h - padTop - padBottom;

        // Draw Dark Background Grid
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let i = 1; i <= 5; i++) {
            const y = padTop + (plotH / 6) * i;
            ctx.moveTo(0, y);
            ctx.lineTo(plotW, y);
        }
        for (let i = 1; i <= 6; i++) {
            const x = (plotW / 7) * i;
            ctx.moveTo(x, padTop);
            ctx.lineTo(x, padTop + plotH);
        }
        ctx.stroke();

        // Slice visible candles according to zoom and pan
        const endIndex = Math.min(candles.length, candles.length - panOffset);
        const startIndex = Math.max(0, endIndex - visibleCount);
        const viewCandles = candles.slice(startIndex, endIndex);

        if (viewCandles.length === 0) return;

        let minPrice = Infinity;
        let maxPrice = -Infinity;
        viewCandles.forEach(c => {
            if (c.low < minPrice) minPrice = c.low;
            if (c.high > maxPrice) maxPrice = c.high;
        });

        const priceRange = (maxPrice - minPrice) || 1;
        const buffer = priceRange * 0.08;
        const lo = minPrice - buffer;
        const hi = maxPrice + buffer;
        const range = hi - lo;

        function getY(p) {
            return padTop + plotH - ((p - lo) / range) * plotH;
        }

        const barW = Math.max(3, (plotW / viewCandles.length) * 0.7);
        const stepX = plotW / viewCandles.length;

        // Render Candles
        viewCandles.forEach((c, i) => {
            const x = i * stepX + (stepX - barW) / 2;
            const isBull = c.close >= c.open;
            const candleColor = isBull ? '#10b981' : '#f43f5e';

            // Wick
            ctx.strokeStyle = candleColor;
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.moveTo(x + barW / 2, getY(c.high));
            ctx.lineTo(x + barW / 2, getY(c.low));
            ctx.stroke();

            // Body
            const topY = getY(Math.max(c.open, c.close));
            const botY = getY(Math.min(c.open, c.close));
            const bodyH = Math.max(2, botY - topY);

            ctx.fillStyle = candleColor;
            ctx.fillRect(x, topY, barW, bodyH);
        });

        // Price Axis on Right
        ctx.fillStyle = '#64748b';
        ctx.font = '10px monospace';
        ctx.textAlign = 'left';
        for (let i = 0; i <= 5; i++) {
            const priceLvl = lo + (range / 5) * i;
            const y = padTop + plotH - (plotH / 5) * i;
            ctx.fillText('$' + priceLvl.toFixed(2), plotW + 8, y + 3);
        }

        // Crosshairs when mouse hovering
        if (mousePos.x > 0 && mousePos.x < plotW && mousePos.y > padTop && mousePos.y < padTop + plotH) {
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 0.8;
            ctx.setLineDash([3, 3]);

            // Vertical line
            ctx.beginPath();
            ctx.moveTo(mousePos.x, padTop);
            ctx.lineTo(mousePos.x, padTop + plotH);
            ctx.stroke();

            // Horizontal line
            ctx.beginPath();
            ctx.moveTo(0, mousePos.y);
            ctx.lineTo(plotW, mousePos.y);
            ctx.stroke();
            ctx.setLineDash([]);

            // Hover Price Tag on Axis
            const hoverPrice = hi - ((mousePos.y - padTop) / plotH) * range;
            ctx.fillStyle = '#3b82f6';
            ctx.fillRect(plotW + 2, mousePos.y - 9, 65, 18);
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 9px monospace';
            ctx.fillText('$' + hoverPrice.toFixed(2), plotW + 6, mousePos.y + 4);

            // Update Hover Info Stats in Header
            const hoverIndex = Math.min(viewCandles.length - 1, Math.max(0, Math.floor(mousePos.x / stepX)));
            const hc = viewCandles[hoverIndex];
            if (hc) {
                const elO = document.getElementById('hoverO');
                const elH = document.getElementById('hoverH');
                const elL = document.getElementById('hoverL');
                const elC = document.getElementById('hoverC');
                if (elO) elO.textContent = hc.open.toFixed(2);
                if (elH) elH.textContent = hc.high.toFixed(2);
                if (elL) elL.textContent = hc.low.toFixed(2);
                if (elC) elC.textContent = hc.close.toFixed(2);
            }
        }
    }

    // Initial Startup
    document.addEventListener('DOMContentLoaded', () => {
        setTradeSizeMode('percent');
        initTradingViewWidget();
    });
</script>
}
