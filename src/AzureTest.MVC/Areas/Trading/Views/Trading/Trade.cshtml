                        <button type="button" onclick="setQuickRr(2.0)" class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 hover:bg-brand-500 hover:text-white transition-colors shrink-0">1:2</button>
                        <button type="button" onclick="setQuickRr(2.5)" class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 hover:bg-brand-500 hover:text-white transition-colors shrink-0">1:2.5</button>
                        <button type="button" onclick="setQuickRr(3.0)" class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 hover:bg-brand-500 hover:text-white transition-colors shrink-0">1:3</button>
