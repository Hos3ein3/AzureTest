@model AzureTest.Contracts.DTOs.Trading.TradingDashboardDto
@{
    var selected = Model.SelectedQuote;
    ViewData["Title"] = $"{selected.Symbol} - Trade & Pro Chart";
    var pageHeader = new PageHeaderModel
    {
        Title = $"{selected.Symbol} - Trade & Pro Chart",
        Subtitle = "Universal Paper Trading Hub",
        Icon = "fa-solid fa-arrow-trend-up",
        Breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Paper Trading Hub", Url.Action("Index", "Trading",new {area=""})),
            new BreadcrumbItem($"{selected.Symbol} - Trade & Pro Chart",active:true)
            
        }
    };
    var account = Model.Account;
    var openForSymbol = Model.OpenPositions.Where(p => p.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase)).ToList();
    var pendingForSymbol = Model.PendingOrders.Where(o => o.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase)).ToList();
    var totalUnrealizedPnl = Model.OpenPositions.Sum(p => p.UnrealizedPnl);
}

@functions {
    string GetAssetBadgeClass(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) => assetClass switch
    {
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Crypto => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Forex => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock => "bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index => "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700"
    };

    string GetAssetDisplayName(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) => assetClass switch
    {
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Crypto => "Crypto",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Forex => "Forex",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock => "Stock",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index => "Indices",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future => "Futures",
        _ => assetClass.ToString()
    };

    bool IsSimulatedFeed(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) =>
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock ||
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index ||
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future;

    string FormatTablePrice5(decimal? price, bool showDollar = true)
    {
        if (!price.HasValue || price.Value <= 0m) return "--";
        var p = price.Value;
        string formatted = p < 0.0001m
            ? p.ToString("0.00000000", System.Globalization.CultureInfo.InvariantCulture)
            : p.ToString("#,##0.00000", System.Globalization.CultureInfo.InvariantCulture);
        return showDollar ? $"${formatted}" : formatted;
    }

    string FormatTablePnl5(decimal pnl)
    {
        var sign = pnl >= 0 ? "+" : "-";
        var str = Math.Abs(pnl).ToString("#,##0.00000", System.Globalization.CultureInfo.InvariantCulture);
        return $"{sign}${str}";
    }

    string FormatTableQty5(decimal qty)
    {
        return qty.ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture);
    }

    string FormatPrice(decimal? price, bool showDollar = true)
    {
        if (!price.HasValue || price.Value <= 0m) return "--";
        var p = price.Value;
        string formatted;
        if (p < 0.0001m)
            formatted = p.ToString("0.00000000", System.Globalization.CultureInfo.InvariantCulture);
        else if (p < 0.01m)
            formatted = p.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture);
        else if (p < 1.0m)
            formatted = p.ToString("0.0000#", System.Globalization.CultureInfo.InvariantCulture);
        else if (p < 10.0m)
            formatted = p.ToString("0.00##", System.Globalization.CultureInfo.InvariantCulture);
        else
            formatted = p.ToString("#,##0.00##", System.Globalization.CultureInfo.InvariantCulture);

        return showDollar ? $"${formatted}" : formatted;
    }

    string FormatPriceInput(decimal price)
    {
        if (price < 0.0001m) return price.ToString("0.00000000", System.Globalization.CultureInfo.InvariantCulture);
        if (price < 0.01m) return price.ToString("0.000000", System.Globalization.CultureInfo.InvariantCulture);
        if (price < 1.0m) return price.ToString("0.00000", System.Globalization.CultureInfo.InvariantCulture);
        if (price < 10.0m) return price.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture);
        if (price < 1000m) return price.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
        return price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }

    sealed record MultiTpLevelItem(decimal Price, decimal Percentage);

    List<MultiTpLevelItem> ParseMultiTp(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return new();
            var list = new List<MultiTpLevelItem>();
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                decimal p = 0m;
                decimal pct = 0m;
                if (el.TryGetProperty("price", out var pProp) || el.TryGetProperty("Price", out pProp))
                {
                    if (pProp.ValueKind == System.Text.Json.JsonValueKind.Number) p = pProp.GetDecimal();
                    else if (pProp.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(pProp.GetString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedP)) p = parsedP;
                }
                if (el.TryGetProperty("percentage", out var pctProp) || el.TryGetProperty("Percentage", out pctProp))
                {
                    if (pctProp.ValueKind == System.Text.Json.JsonValueKind.Number) pct = pctProp.GetDecimal();
                    else if (pctProp.ValueKind == System.Text.Json.JsonValueKind.String && decimal.TryParse(pctProp.GetString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsedPct)) pct = parsedPct;
                }
                if (p > 0) list.Add(new(p, pct));
            }
            return list;
        }
        catch
        {
            return new();
        }
    }
}
@* *@
@* <partial name="UiComponents/_PageHeader" model="pageHeader" /> *@
<div class="space-y-6 pb-12 font-sans">
    <!-- Dynamic Alert Toasts / Notification Container -->
    <div id="dynamicAlertContainer" class="space-y-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-check text-lg text-emerald-500"></i>
                    <div>
                        <strong class="font-bold text-xs uppercase tracking-wider">Success</strong>
                        <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-0.5">@TempData["SuccessMessage"]</p>
                    </div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 flex items-center justify-between shadow-xs">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-exclamation text-lg text-rose-500"></i>
                    <div>
                        <strong class="font-bold text-xs uppercase tracking-wider">Execution Error</strong>
                        <p class="text-xs text-rose-600 dark:text-rose-400 mt-0.5">@TempData["ErrorMessage"]</p>
                    </div>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
    </div>

    <!-- Top Asset Bar & Navigation -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4 p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors shrink-0" title="Back to Watchlist & Portfolio">
                <i class="fa-solid fa-arrow-left text-xs sm:text-sm"></i>
            </a>

            <div class="min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
                    <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight truncate" id="terminalSymbolTitle">@selected.Symbol</h1>
                    <span class="px-2 py-0.5 rounded-full text-4xs sm:text-3xs font-extrabold uppercase tracking-wide shrink-0 @GetAssetBadgeClass(selected.AssetClass)">
                        @GetAssetDisplayName(selected.AssetClass)
                    </span>
                    @if (selected.IsSimulated || IsSimulatedFeed(selected.AssetClass))
                    {
                        <span class="px-1.5 sm:px-2 py-0.5 rounded-lg text-4xs font-black uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center gap-1 shadow-2xs shrink-0">
                            <i class="fa-solid fa-flask text-amber-500"></i>
                            <span>Simulate</span>
                        </span>
                    }
                    else
                    {
                        <span class="px-1.5 sm:px-2 py-0.5 rounded-lg text-4xs font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1 shadow-2xs shrink-0">
                            <i class="fa-solid fa-satellite-dish text-emerald-500 animate-pulse"></i>
                            <span>Live API</span>
                        </span>
                    }
                    <!-- Watchlist Toggle Button (AJAX Icon) -->
                    <button type="button" 
                            id="tradeWatchlistBtn"
                            onclick="toggleTradeWatchlist('@selected.Symbol', '@selected.AssetName.Replace("'", "\\'")', @((int)selected.AssetClass))"
                            class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl border border-slate-200 dark:border-slate-700 hover:border-amber-400 bg-white dark:bg-slate-800 flex items-center justify-center transition-all shadow-2xs hover:scale-105 shrink-0"
                            title="@(selected.IsWatchlisted ? "Remove from watchlist" : "Add to watchlist")">
                        <i id="tradeWatchlistIcon" class="@(selected.IsWatchlisted ? "fa-solid fa-star text-amber-500" : "fa-regular fa-star text-slate-400 hover:text-amber-500") text-xs sm:text-sm"></i>
                    </button>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate max-w-[220px] sm:max-w-none">@selected.AssetName</p>
            </div>
        </div>

        <!-- Live Price & Statistics Strip -->
        <div class="flex items-center gap-2 sm:gap-4 md:gap-6 flex-wrap justify-between sm:justify-start">
            <div class="p-2 sm:p-3 rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex-1 sm:flex-initial min-w-[130px]">
                <span class="text-4xs sm:text-3xs uppercase font-extrabold text-slate-400 tracking-wider block">Live Price</span>
                <div class="flex items-center gap-1.5 sm:gap-2 mt-0.5">
                    <span class="text-base sm:text-2xl font-black text-slate-900 dark:text-white transition-colors tracking-tight" id="liveTickerPrice">
                        @FormatPrice(selected.Price)
                    </span>
                    <span class="px-1.5 py-0.5 rounded-md text-3xs sm:text-2xs font-extrabold @(selected.ChangePercent24h >= 0 ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" : "bg-rose-500/10 text-rose-600 border border-rose-500/20")" id="liveTickerChange">
                        @(selected.ChangePercent24h >= 0 ? "+" : "")@selected.ChangePercent24h.ToString("N2")%
                    </span>
                </div>
            </div>

            <!-- Available Margin Badge -->
            <div class="p-2 sm:p-3 rounded-xl sm:rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex-1 sm:flex-initial min-w-[120px]">
                <span class="text-4xs sm:text-3xs uppercase font-extrabold text-emerald-600 dark:text-emerald-400 tracking-wider block">Avail Margin</span>
                <div class="text-base sm:text-xl font-black text-emerald-600 dark:text-emerald-400 mt-0.5" id="topAvailableMarginDisplay">
                    $@account.FreeMargin.ToString("N2")
                </div>
            </div>

            <div class="hidden sm:block text-xs space-y-0.5 text-slate-500 dark:text-slate-400">
                <div>24h High: <strong class="text-slate-800 dark:text-slate-200" id="liveHighDisplay">@FormatPrice(selected.High24h)</strong></div>
                <div>24h Low: <strong class="text-slate-800 dark:text-slate-200" id="liveLowDisplay">@FormatPrice(selected.Low24h)</strong></div>
            </div>

            <div class="flex items-center gap-1.5 sm:gap-2 text-slate-500 dark:text-slate-400">
                <span class="w-2 sm:w-2.5 h-2 sm:h-2.5 rounded-full @(selected.IsSimulated || IsSimulatedFeed(selected.AssetClass) ? "bg-amber-500" : "bg-emerald-500") animate-pulse" id="syncStatusDot"></span>
                <span class="text-4xs sm:text-3xs font-extrabold uppercase tracking-wider" id="syncStatusLabel">
                    @(selected.IsSimulated || IsSimulatedFeed(selected.AssetClass) ? "Simulate" : "Live API")
                </span>
            </div>
        </div>
    </div>

    <!-- TOP SECTION: Interactive Professional Chart with Official TradingView Widget & Canvas Engine -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 p-3 sm:p-5 shadow-xs space-y-3 sm:space-y-4">
        <!-- Chart Controls Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-3 border-b border-slate-100 dark:border-slate-800 pb-2.5 sm:pb-3">
            <!-- Left: Chart Engine Mode Switcher -->
            <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap overflow-x-auto pb-1 sm:pb-0">
                <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-0.5 sm:p-1 rounded-lg sm:rounded-xl text-4xs sm:text-3xs font-extrabold shrink-0">
                    <button type="button" onclick="switchChartEngine('tradingview')" id="btnTvEngine" class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg active bg-brand-500 text-white shadow-2xs transition-all flex items-center gap-1 sm:gap-1.5">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>TradingView</span>
                    </button>
                    <button type="button" onclick="switchChartEngine('canvas')" id="btnCanvasEngine" class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 text-slate-600 dark:text-slate-400 transition-all flex items-center gap-1 sm:gap-1.5">
                        <i class="fa-solid fa-palette"></i>
                        <span>Canvas</span>
                    </button>
                </div>

                <!-- Canvas Timeframe Pills (shown in canvas mode) -->
                <div id="canvasTfGroup" class="hidden flex items-center gap-0.5 sm:gap-1 text-4xs sm:text-3xs font-bold bg-slate-100 dark:bg-slate-800 p-0.5 sm:p-1 rounded-lg sm:rounded-xl shrink-0 overflow-x-auto">
                    <button type="button" onclick="setTimeframe('1m')" class="tf-btn px-2 sm:px-2.5 py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1m">1m</button>
                    <button type="button" onclick="setTimeframe('5m')" class="tf-btn px-2 sm:px-2.5 py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="5m">5m</button>
                    <button type="button" onclick="setTimeframe('15m')" class="tf-btn px-2 sm:px-2.5 py-1 rounded-md sm:rounded-lg active bg-brand-500 text-white" data-tf="15m">15m</button>
                    <button type="button" onclick="setTimeframe('1h')" class="tf-btn px-2 sm:px-2.5 py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1h">1h</button>
                    <button type="button" onclick="setTimeframe('4h')" class="tf-btn px-2 sm:px-2.5 py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="4h">4h</button>
                    <button type="button" onclick="setTimeframe('1D')" class="tf-btn px-2 sm:px-2.5 py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1D">1D</button>
                </div>
            </div>

            <!-- Right: Chart Height & Fullscreen Resizers -->
            <div class="flex items-center justify-between sm:justify-end gap-2 flex-wrap text-4xs sm:text-3xs font-bold">
                <div class="flex items-center gap-1">
                    <span class="text-slate-400 uppercase font-extrabold hidden sm:inline mr-1">Height:</span>
                    <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-0.5 sm:p-1 rounded-lg sm:rounded-xl">
                        <button type="button" onclick="setChartHeight(320)" class="chart-h-btn px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-all text-slate-600 dark:text-slate-400" data-h="320">320px</button>
                        <button type="button" onclick="setChartHeight(440)" class="chart-h-btn px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-all text-slate-600 dark:text-slate-400" data-h="440">440px</button>
                        <button type="button" onclick="setChartHeight(560)" class="chart-h-btn px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md sm:rounded-lg active bg-white dark:bg-slate-700 text-brand-600 dark:text-brand-400 shadow-2xs transition-all font-black" data-h="560">560px</button>
                        <button type="button" onclick="toggleChartFullscreen()" class="px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md sm:rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-all text-slate-700 dark:text-slate-300" title="Fullscreen Mode">
                            <i class="fa-solid fa-expand"></i>
                        </button>
                    </div>
                </div>

                <!-- Canvas Style & Indicators Controls (only in Canvas mode) -->
                <div id="canvasExtrasGroup" class="hidden flex items-center gap-1.5">
                    <select id="chartStyleSelect" onchange="setChartStyle(this.value)" class="text-3xs font-bold px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-lg border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-700 dark:text-slate-300 focus:outline-none">
                        <option value="candles">Candles</option>
                        <option value="hollow">Hollow</option>
                        <option value="heikin">Heikin-Ashi</option>
                        <option value="line">Line</option>
                        <option value="area">Area</option>
                    </select>

                    <button type="button" onclick="toggleIndicator('ema20')" id="btnEma20" class="px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">EMA</button>
                    <button type="button" onclick="toggleIndicator('bollinger')" id="btnBollinger" class="px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">BB</button>
                    <button type="button" onclick="toggleIndicator('volume')" id="btnVolume" class="px-1.5 sm:px-2 py-0.5 sm:py-1 rounded-md border border-brand-500 bg-brand-500 text-white">Vol</button>
                </div>
            </div>
        </div>

        <!-- Drawing Tools Toolbar (Visible when Canvas Studio is active, completely above the chart with z-50) -->
