@model AzureTest.Contracts.DTOs.Trading.TradingDashboardDto
@{
    var selected = Model.SelectedQuote;
    ViewData["Title"] = $"{selected.Symbol} - Trade & Pro Chart";
    var account = Model.Account;
    var openForSymbol = Model.OpenPositions.Where(p => p.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase)).ToList();
    var pendingForSymbol = Model.PendingOrders.Where(o => o.Symbol.Equals(selected.Symbol, StringComparison.OrdinalIgnoreCase)).ToList();
}

@functions {
    string GetAssetBadgeClass(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) => assetClass switch
    {
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Crypto => "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Forex => "bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock => "bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index => "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700"
    };

    string GetAssetDisplayName(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) => assetClass switch
    {
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Crypto => "Crypto",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Forex => "Forex",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock => "Stock",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index => "Indices",
        AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future => "Futures",
        _ => assetClass.ToString()
    };

    bool IsSimulatedFeed(AzureTest.Domain.Entities.Trading.Enums.AssetClass assetClass) =>
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Stock ||
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Index ||
        assetClass == AzureTest.Domain.Entities.Trading.Enums.AssetClass.Future;
}

<div class="space-y-6 pb-12 font-sans">
    <!-- Top Asset Bar & Navigation -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-5 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="w-10 h-10 rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center transition-colors" title="Back to Watchlist & Portfolio">
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </a>

            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight" id="terminalSymbolTitle">@selected.Symbol</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-3xs font-extrabold uppercase tracking-wide @GetAssetBadgeClass(selected.AssetClass)">
                        @GetAssetDisplayName(selected.AssetClass)
                    </span>
                    @if (selected.IsSimulated || IsSimulatedFeed(selected.AssetClass))
                    {
                        <span class="px-2 py-0.5 rounded-lg text-4xs font-black uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center gap-1 shadow-2xs">
                            <i class="fa-solid fa-flask text-amber-500"></i>
                            <span>Simulate</span>
                        </span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded-lg text-4xs font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1 shadow-2xs">
                            <i class="fa-solid fa-satellite-dish text-emerald-500 animate-pulse"></i>
                            <span>Live API</span>
                        </span>
                    }
                    <!-- Watchlist Toggle Button (AJAX Icon) -->
                    <button type="button" 
                            id="tradeWatchlistBtn"
                            onclick="toggleTradeWatchlist('@selected.Symbol', '@selected.AssetName.Replace("'", "\\'")', @((int)selected.AssetClass))"
                            class="w-8 h-8 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-amber-400 bg-white dark:bg-slate-800 flex items-center justify-center transition-all shadow-2xs hover:scale-105"
                            title="@(selected.IsWatchlisted ? "Remove from watchlist" : "Add to watchlist")">
                        <i id="tradeWatchlistIcon" class="@(selected.IsWatchlisted ? "fa-solid fa-star text-amber-500" : "fa-regular fa-star text-slate-400 hover:text-amber-500") text-sm"></i>
                    </button>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@selected.AssetName</p>
            </div>
        </div>

        <!-- Live Price & Statistics Strip -->
        <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60">
                <span class="text-3xs uppercase font-extrabold text-slate-400 tracking-wider block">Live Market Price</span>
                <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white transition-colors" id="liveTickerPrice">
                        $@selected.Price.ToString("N2")
                    </span>
                    <span class="px-2 py-0.5 rounded-md text-2xs font-extrabold @(selected.ChangePercent24h >= 0 ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" : "bg-rose-500/10 text-rose-600 border border-rose-500/20")" id="liveTickerChange">
                        @(selected.ChangePercent24h >= 0 ? "+" : "")@selected.ChangePercent24h.ToString("N2")%
                    </span>
                </div>
            </div>

            <!-- Available Margin Badge -->
            <div class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/20">
                <span class="text-3xs uppercase font-extrabold text-emerald-600 dark:text-emerald-400 tracking-wider block">Available Margin</span>
                <div class="text-lg sm:text-xl font-black text-emerald-600 dark:text-emerald-400 mt-0.5" id="topAvailableMarginDisplay">
                    $@account.FreeMargin.ToString("N2")
                </div>
            </div>

            <div class="hidden sm:block text-xs space-y-0.5 text-slate-500 dark:text-slate-400">
                <div>24h High: <strong class="text-slate-800 dark:text-slate-200" id="liveHighDisplay">$@selected.High24h.ToString("N2")</strong></div>
                <div>24h Low: <strong class="text-slate-800 dark:text-slate-200" id="liveLowDisplay">$@selected.Low24h.ToString("N2")</strong></div>
            </div>

            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full @(selected.IsSimulated || IsSimulatedFeed(selected.AssetClass) ? "bg-amber-500" : "bg-emerald-500") animate-pulse"></span>
                <span class="text-3xs font-extrabold text-slate-500 dark:text-slate-400 uppercase tracking-wider" id="syncStatusLabel">
                    @(selected.IsSimulated || IsSimulatedFeed(selected.AssetClass) ? "Simulate Sync" : "Live API Sync")
                </span>
            </div>
        </div>
    </div>

    <!-- TOP SECTION: Interactive TradingView Chart with All 8 Drawing Tool Suites -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-5 shadow-xs space-y-4">
        <!-- Chart Controls Header -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
            <!-- Timeframe Pills -->
            <div class="flex items-center gap-1 text-3xs font-bold bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                <button type="button" onclick="setTimeframe('1m')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1m">1m</button>
                <button type="button" onclick="setTimeframe('5m')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="5m">5m</button>
                <button type="button" onclick="setTimeframe('15m')" class="tf-btn px-2.5 py-1 rounded-lg active bg-brand-500 text-white" data-tf="15m">15m</button>
                <button type="button" onclick="setTimeframe('1h')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1h">1h</button>
                <button type="button" onclick="setTimeframe('4h')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="4h">4h</button>
                <button type="button" onclick="setTimeframe('1D')" class="tf-btn px-2.5 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700 transition-colors" data-tf="1D">1D</button>
            </div>

            <!-- Candle Style Selector -->
            <div class="flex items-center gap-2">
                <span class="text-3xs uppercase font-extrabold text-slate-400">Style:</span>
                <select id="chartStyleSelect" onchange="setChartStyle(this.value)" class="text-xs font-bold px-2.5 py-1 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-700 dark:text-slate-300 focus:outline-none">
                    <option value="candles">Candles</option>
                    <option value="hollow">Hollow Candles</option>
                    <option value="heikin">Heikin-Ashi</option>
                    <option value="line">Line</option>
                    <option value="area">Area</option>
                    <option value="bars">Bars</option>
                </select>
            </div>

            <!-- Indicator Toggles -->
            <div class="flex items-center gap-1.5 text-3xs font-bold">
                <button type="button" onclick="toggleIndicator('ema20')" id="btnEma20" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">EMA 20</button>
                <button type="button" onclick="toggleIndicator('ema50')" id="btnEma50" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">EMA 50</button>
                <button type="button" onclick="toggleIndicator('bollinger')" id="btnBollinger" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Bollinger</button>
                <button type="button" onclick="toggleIndicator('volume')" id="btnVolume" class="px-2 py-1 rounded-lg border border-brand-500 bg-brand-500 text-white">Volume</button>
            </div>
        </div>

        <!-- TradingView 8-Suite Drawing Tools Toolbar -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin text-3xs">
            <span class="text-slate-400 font-extrabold uppercase shrink-0"><i class="fa-solid fa-paintbrush mr-1"></i> Tools:</span>

            <!-- 1. Lines & Channels -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-arrows-left-right text-brand-500"></i>
                    <span>Lines &amp; Channels</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-20 w-52 p-1.5 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Trend Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Trend Line</button>
                    <button type="button" onclick="selectTool('Ray')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Ray</button>
                    <button type="button" onclick="selectTool('Info Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Info Line</button>
                    <button type="button" onclick="selectTool('Extended Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Extended Line</button>
                    <button type="button" onclick="selectTool('Trend Angle')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Trend Angle</button>
                    <button type="button" onclick="selectTool('Horizontal Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Horizontal Line</button>
                    <button type="button" onclick="selectTool('Horizontal Ray')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Horizontal Ray</button>
                    <button type="button" onclick="selectTool('Vertical Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Vertical Line</button>
                    <button type="button" onclick="selectTool('Cross Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Cross Line</button>
                    <button type="button" onclick="selectTool('Parallel Channel')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-brand-600">Parallel Channel</button>
                    <button type="button" onclick="selectTool('Regression Trend')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Regression Trend</button>
                    <button type="button" onclick="selectTool('Flat Top/Bottom')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Flat Top/Bottom</button>
                    <button type="button" onclick="selectTool('Disjoint Channel')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Disjoint Channel</button>
                    <button type="button" onclick="selectTool('Pitchfork')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Pitchfork</button>
                    <button type="button" onclick="selectTool('Schiff Pitchfork')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Schiff Pitchfork</button>
                    <button type="button" onclick="selectTool('Modified Schiff')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Modified Schiff</button>
                    <button type="button" onclick="selectTool('Inside Pitchfork')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Inside Pitchfork</button>
                </div>
            </div>

            <!-- 2. Gann & Fibonacci -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-calculator text-amber-500"></i>
                    <span>Gann &amp; Fibonacci</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-20 w-52 p-1.5 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Fib Retracement')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-amber-600">Fib Retracement</button>
                    <button type="button" onclick="selectTool('Trend-Based Fib')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Trend-Based Fib</button>
                    <button type="button" onclick="selectTool('Fib Channel')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Channel</button>
                    <button type="button" onclick="selectTool('Fib Time Zone')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Time Zone</button>
                    <button type="button" onclick="selectTool('Fib Speed Resistance')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Speed Resistance</button>
                    <button type="button" onclick="selectTool('Fib Circle')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Circle</button>
                    <button type="button" onclick="selectTool('Fib Spiral')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Spiral</button>
                    <button type="button" onclick="selectTool('Fib Wedge')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fib Wedge</button>
                    <button type="button" onclick="selectTool('Pitchfan')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Pitchfan</button>
                    <button type="button" onclick="selectTool('Gann Box')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Gann Box</button>
                    <button type="button" onclick="selectTool('Gann Square Fixed')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Gann Square Fixed</button>
                    <button type="button" onclick="selectTool('Gann Fan')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Gann Fan</button>
                </div>
            </div>

            <!-- 3. Patterns -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-shapes text-purple-500"></i>
                    <span>Patterns</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-20 w-52 p-1.5 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('XABCD Pattern')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">XABCD Pattern</button>
                    <button type="button" onclick="selectTool('Cypher Pattern')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Cypher Pattern</button>
                    <button type="button" onclick="selectTool('Head & Shoulders')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-purple-600">Head &amp; Shoulders</button>
                    <button type="button" onclick="selectTool('ABCD Pattern')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">ABCD Pattern</button>
                    <button type="button" onclick="selectTool('Triangle Pattern')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Triangle Pattern</button>
                    <button type="button" onclick="selectTool('Three Drives')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Three Drives</button>
                    <button type="button" onclick="selectTool('Elliott Impulse (12345)')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Elliott Impulse</button>
                    <button type="button" onclick="selectTool('Elliott Correction (ABC)')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Elliott Correction</button>
                    <button type="button" onclick="selectTool('Elliott Triangle')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Elliott Triangle</button>
                    <button type="button" onclick="selectTool('Elliott Double')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Elliott Double</button>
                    <button type="button" onclick="selectTool('Elliott Triple')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Elliott Triple</button>
                    <button type="button" onclick="selectTool('Cyclic Lines')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Cyclic Lines</button>
                    <button type="button" onclick="selectTool('Time Cycles')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Time Cycles</button>
                    <button type="button" onclick="selectTool('Sine Line')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Sine Line</button>
                </div>
            </div>

            <!-- 4. Forecasting & Measurement -->
            <div class="relative group shrink-0">
                <button type="button" class="px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold hover:border-brand-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-ruler-combined text-emerald-500"></i>
                    <span>Forecasting</span>
                    <i class="fa-solid fa-chevron-down text-3xs text-slate-400"></i>
                </button>
                <div class="hidden group-hover:block absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-20 w-52 p-1.5 space-y-0.5 text-left">
                    <button type="button" onclick="selectTool('Long Position')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-emerald-600">Long Position</button>
                    <button type="button" onclick="selectTool('Short Position')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700 font-bold text-rose-600">Short Position</button>
                    <button type="button" onclick="selectTool('Forecast')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Forecast</button>
                    <button type="button" onclick="selectTool('Bars Pattern')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Bars Pattern</button>
                    <button type="button" onclick="selectTool('Ghost Feed')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Ghost Feed</button>
                    <button type="button" onclick="selectTool('Projection')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Projection</button>
                    <button type="button" onclick="selectTool('Anchored VWAP')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Anchored VWAP</button>
                    <button type="button" onclick="selectTool('Fixed Range Volume')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Fixed Range Volume</button>
                    <button type="button" onclick="selectTool('Anchored Volume')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Anchored Volume</button>
                    <button type="button" onclick="selectTool('Price Range')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Price Range</button>
                    <button type="button" onclick="selectTool('Date Range')" class="w-full text-left px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Date Range</button>
