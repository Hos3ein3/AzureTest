                        <option value="Day">Day Order (Expires at market close)</option>
                        <option value="Week">Week (Expires Friday)</option>
                        <option value="Month">Month (Expires End of Month)</option>
                        <option value="GTD">Good Till Date (GTD)</option>
                    </select>
                </div>
