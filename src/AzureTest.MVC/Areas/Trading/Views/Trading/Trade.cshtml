                <!-- Dynamic Container for Edit Modal TP Levels -->
                <div id="modifyTpLevelsContainer" class="space-y-2 max-h-48 overflow-y-auto pr-1">
                    <!-- Populated dynamically by openModifyModal -->
                </div>

                <input type="hidden" id="modifyPosTpInput" name="takeProfit" />
                <input type="hidden" id="modifyMultipleTakeProfitsJson" name="multipleTakeProfitsJson" />

                <!-- Allocation Summary Bar -->
                <div class="flex justify-between items-center text-3xs font-bold text-slate-400 pt-0.5">
                    <div class="flex items-center gap-1">
                        <span>Allocation:</span>
                        <span id="modifyTpAllocationBadge" class="text-emerald-600 font-mono font-black">100%</span>
                    </div>
                    <p class="text-4xs text-slate-400 text-right truncate max-w-[200px]" id="modifyTpHint">Price to automatically lock in profit.</p>
                </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="button" onclick="closeModifyModal()" class="w-1/2 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold hover:bg-slate-200 transition-colors">Cancel</button>
                <button type="submit" id="btnSaveModifyPosition" class="w-1/2 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-xs transition-all flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-check"></i>
                    <span>Save Protection</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<!-- Official TradingView Real-Time Chart Widget Script -->
<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>

<script>
    const symbol = "@selected.Symbol";
    const selectedAssetClass = @((int)selected.AssetClass);
    const feedSource = "@selected.FeedSource";
    let basePrice = @selected.Price;
    let cashBalance = @account.CashBalance;
    let freeMargin = @account.FreeMargin;
    let currentSide = 1; // 1 = Buy, 2 = Sell
    let currentOrderTab = 'market';
    let isBuzzwordsMode = false;
    let isSymbolWatchlisted = @(selected.IsWatchlisted ? "true" : "false");
    let currentSizeMode = 'percent'; // Default to '% Balance'
    let currentCalculatedUnits = 1.0;
    let currentCalculatedMargin = 0;
    let currentCalculatedPercent = 10.0;
    let currentCalculatedTotal = 0;
    let tpEnabled = true;
    let slEnabled = true;

    // Chart Engine State
    let currentChartEngine = 'tradingview'; // 'tradingview' or 'canvas'
    let tvWidget = null;

    // Execution Notice & Feedback Alert Helper (Renders directly under Buy/Sell buttons)
    function showToast(type, msg) {
        const c = document.getElementById('executionNoticeContainer') || document.getElementById('dynamicAlertContainer');
        if (!c) return;
        const isSuccess = type === 'success';
        const isInfo = type === 'info';
        const bgClass = isSuccess
            ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-800 dark:text-emerald-200'
            : (isInfo ? 'bg-brand-500/10 border-brand-500/30 text-brand-800 dark:text-brand-200' : 'bg-rose-500/10 border-rose-500/30 text-rose-800 dark:text-rose-200');
        const iconClass = isSuccess ? 'fa-circle-check text-emerald-500' : (isInfo ? 'fa-circle-info text-brand-500' : 'fa-circle-exclamation text-rose-500');
        const titleText = isSuccess ? 'Order Executed' : (isInfo ? 'Market Notice' : 'Execution Notice');

        const el = document.createElement('div');
        el.className = `p-4 rounded-2xl ${bgClass} border flex items-center justify-between shadow-xs transition-all animate-fade-in`;
        el.innerHTML = `
            <div class="flex items-center gap-3">
                <i class="fa-solid ${iconClass} text-lg shrink-0"></i>
                <div>
                    <strong class="font-bold text-xs uppercase tracking-wider">${titleText}</strong>
                    <p class="text-xs mt-0.5 font-medium">${msg}</p>
                </div>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="hover:opacity-75 ml-2">
                <i class="fa-solid fa-xmark"></i>
            </button>
        `;
        c.innerHTML = '';
        c.appendChild(el);
        try { el.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (_) {}
        setTimeout(() => { if (el.parentElement) el.remove(); }, 8500);
    }

    // Dynamic Price Formatting Helpers
    function formatPrice(val, showDollar = true, minDecimals = 2) {
        if (val === null || val === undefined || isNaN(val)) return '--';
        const num = Number(val);
        if (num <= 0) return showDollar ? '$0.00' : '0.00';
        let maxDigits = 2;
        if (num < 0.0001) maxDigits = 8;
        else if (num < 0.01) maxDigits = 6;
        else if (num < 1) maxDigits = 5;
        else if (num < 10) maxDigits = 5;
        else if (num < 1000) maxDigits = 4;
        else maxDigits = 2;

        const minDigits = Math.min(minDecimals, maxDigits);
        const formatted = num.toLocaleString('en-US', { minimumFractionDigits: minDigits, maximumFractionDigits: maxDigits });
        return showDollar ? `$${formatted}` : formatted;
    }

    function formatPriceInput(val) {
        if (val === null || val === undefined || isNaN(val)) return '0.00';
        const num = Number(val);
        let maxDigits = 2;
        if (num < 0.0001) maxDigits = 8;
        else if (num < 0.01) maxDigits = 6;
        else if (num < 1) maxDigits = 5;
        else if (num < 10) maxDigits = 5;
        else if (num < 1000) maxDigits = 4;
        else maxDigits = 2;

        let s = num.toFixed(maxDigits);
        if (s.includes('.')) {
            const parts = s.split('.');
            if (parts[1].length > 2) {
                parts[1] = parts[1].replace(/0+$/, '');
                if (parts[1].length < 2) parts[1] = parts[1].padEnd(2, '0');
                s = parts[0] + '.' + parts[1];
            }
        }
        return s;
    }

    function formatPrice5(val, showDollar = true) {
        const num = Number(val);
        if (isNaN(num) || num <= 0) return '--';
        const str = num < 0.0001
            ? num.toFixed(8)
            : num.toLocaleString('en-US', { minimumFractionDigits: 5, maximumFractionDigits: 5 });
        return showDollar ? '$' + str : str;
    }

    function formatPnl5(val) {
        const num = Number(val);
        if (isNaN(num)) return '$0.00000';
        const sign = num >= 0 ? '+' : '-';
        const abs = Math.abs(num).toLocaleString('en-US', { minimumFractionDigits: 5, maximumFractionDigits: 5 });
        return `${sign}$${abs}`;
    }

    function renderTpCellHtml(tp, multiTpJson) {
        if (!multiTpJson) {
            return (tp && Number(tp) > 0) ? formatPrice5(tp) : '--';
        }
        try {
            let levels = typeof multiTpJson === 'string' ? JSON.parse(multiTpJson) : multiTpJson;
            if (Array.isArray(levels) && levels.length > 1) {
                let html = `
                    <div class="space-y-1">
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-black text-4xs uppercase tracking-wider border border-emerald-500/20">
                            <i class="fa-solid fa-layer-group text-5xs"></i>
                            <span>${levels.length} TP Targets</span>
                        </span>
                        <div class="flex flex-col gap-0.5 font-mono text-3xs">
                `;
                levels.forEach((lvl, idx) => {
                    const p = Number(lvl.price ?? lvl.Price ?? 0);
                    const pct = Number(lvl.percentage ?? lvl.Percentage ?? 0);
                    html += `
                        <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                            <span class="font-bold text-emerald-600 dark:text-emerald-400">TP${idx + 1}:</span>
                            <span class="font-extrabold">${formatPrice5(p)}</span>
                            <span class="text-slate-400 text-4xs font-semibold">(${pct}%)</span>
                        </div>
                    `;
                });
                html += `</div></div>`;
                return html;
            } else if (Array.isArray(levels) && levels.length === 1) {
                const singleP = Number(levels[0].price ?? levels[0].Price ?? 0);
                return singleP > 0 ? formatPrice5(singleP) : '--';
            }
        } catch (e) {
            // fallback
        }
        return (tp && Number(tp) > 0) ? formatPrice5(tp) : '--';
    }

    let knownOpenTradePosIds = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpenPositions.Select(p => p.Id.ToString()))));

    // ── 1. Live Price & Holding Terminal Auto-Update Polling (Every 3 seconds, in-place, NO refresh) ─────
    async function pollLiveTradeStatus(immediate = false) {
        try {
            const res = await fetch(`/Trading/Trading/LiveStatus?symbol=${encodeURIComponent(symbol)}`, {
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            if (!res.ok) return;
            const data = await res.json();
            if (!data || !data.success) return;

            // 1. Update Selected Asset Quote
            const quote = data.selectedQuote;
            if (quote) {
                const newPrice = Number(quote.price ?? quote.Price);
                const high24 = Number(quote.high24h ?? quote.High24h ?? 0);
                const low24 = Number(quote.low24h ?? quote.Low24h ?? 0);
                const chg24h = Number(quote.changePercent24h ?? quote.ChangePercent24h ?? 0);

                if (newPrice && !isNaN(newPrice)) {
                    const priceEl = document.getElementById('liveTickerPrice');
                    const changeEl = document.getElementById('liveTickerChange');
                    const syncDot = document.getElementById('syncStatusDot');

                    if (priceEl) {
                        if (newPrice > basePrice) {
                            priceEl.classList.add('text-emerald-500');
                            setTimeout(() => priceEl.classList.remove('text-emerald-500'), 800);
                        } else if (newPrice < basePrice) {
                            priceEl.classList.add('text-rose-500');
                            setTimeout(() => priceEl.classList.remove('text-rose-500'), 800);
                        }
                        priceEl.textContent = formatPrice(newPrice);
                    }

                    if (syncDot) {
                        syncDot.classList.add('scale-125');
                        setTimeout(() => syncDot.classList.remove('scale-125'), 300);
                    }

                    basePrice = newPrice;
                    if (changeEl) changeEl.textContent = `${chg24h >= 0 ? '+' : ''}${chg24h.toFixed(2)}%`;

                    const highEl = document.getElementById('liveHighDisplay');
                    if (highEl && high24 > 0) highEl.textContent = formatPrice(high24);
                    const lowEl = document.getElementById('liveLowDisplay');
                    if (lowEl && low24 > 0) lowEl.textContent = formatPrice(low24);

                    const marketPriceEl = document.getElementById('marketOrderPriceDisplay');
                    if (marketPriceEl) marketPriceEl.textContent = formatPrice(newPrice);

                    const limitHint = document.getElementById('limitMarketHint');
                    if (limitHint) limitHint.textContent = formatPrice(newPrice, false);
                    const stopHint = document.getElementById('stopMarketHint');
                    if (stopHint) stopHint.textContent = formatPrice(newPrice, false);

                    const exitPriceEl = document.getElementById('exitHeaderCurrentPrice');
                    if (exitPriceEl) exitPriceEl.textContent = formatPrice5(newPrice);
                    const protLivePrice = document.getElementById('protectionLiveMarketPrice');
                    if (protLivePrice) protLivePrice.value = formatPrice5(newPrice, false);

                    recalculateAllSizeAndMargin();
                }
            }

            // 2. Update Account balances
            if (data.account) {
                cashBalance = Number(data.account.cashBalance ?? data.account.CashBalance);
                freeMargin = Number(data.account.freeMargin ?? data.account.FreeMargin);
            }

            // 3. Update Portfolio Terminal Open Positions (Mark Price, PnL, ROI, SL/TP)
            const currentOpen = data.openPositions || [];
            const currentOpenIds = new Set(currentOpen.map(p => String(p.id ?? p.Id)));

            // Detect any positions closed by SL/TP in background
            knownOpenTradePosIds.forEach(id => {
                if (!currentOpenIds.has(String(id))) {
                    const row = document.getElementById(`posRow_${id}`);
                    if (row) {
                        const sym = row.getAttribute('data-symbol') || 'Trade';
                        row.remove();

                        const closed = (data.closedPositions || []).find(c => String(c.id ?? c.Id) === String(id));
                        const pnl = closed ? Number(closed.realizedPnl ?? closed.RealizedPnl ?? 0) : 0;
                        showToast('info', `Trade ${sym} closed! Realized PnL: ${formatPnl5(pnl)}`);

                        const closedTableBody = document.getElementById('closedPositionsTableBody');
                        const closedWrapper = document.getElementById('closedPositionsTableWrapper');
                        const emptyClosed = document.getElementById('emptyClosedState');
                        if (closedTableBody && closed) {
                            if (emptyClosed) emptyClosed.classList.add('hidden');
                            if (closedWrapper) closedWrapper.classList.remove('hidden');
                            const tr = document.createElement('tr');
                            tr.className = 'hover:bg-slate-50/50 dark:hover:bg-slate-800/30 animate-fade-in';
                            const isWin = pnl >= 0;
                            tr.innerHTML = `
                                <td class="p-3 pl-4 font-black text-slate-800 dark:text-slate-200 whitespace-nowrap">
                                    <span>${closed.symbol ?? sym}</span>
                                </td>
                                <td class="p-3 text-3xs font-extrabold whitespace-nowrap ${closed.side == 1 ? 'text-emerald-500' : 'text-rose-500'}">
                                    ${closed.side == 1 ? 'Buy' : 'Sell'}
                                </td>
                                <td class="p-3 font-mono font-bold whitespace-nowrap">${Number(closed.quantity ?? 0).toFixed(5)}</td>
                                <td class="p-3 font-mono text-slate-600 dark:text-slate-400 whitespace-nowrap">${formatPrice5(closed.entryPrice)}</td>
                                <td class="p-3 font-mono text-slate-900 dark:text-white font-bold whitespace-nowrap">${formatPrice5(closed.closePrice ?? closed.currentPrice)}</td>
                                <td class="p-3 font-mono font-black whitespace-nowrap">
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-black ${isWin ? 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/30' : 'bg-rose-500/10 text-rose-600 border border-rose-500/30'}">
                                        ${formatPnl5(pnl)}
                                    </span>
                                </td>
                                <td class="p-3 pr-4 text-right text-3xs text-slate-400 whitespace-nowrap">Just now</td>
                            `;
                            closedTableBody.prepend(tr);
                        }
                    }
                }
            });

            knownOpenTradePosIds = currentOpenIds;

            // Update Mark Price & PnL on active open rows
            currentOpen.forEach(pos => {
                const id = pos.id ?? pos.Id;
                const curPrice = Number(pos.currentPrice ?? pos.CurrentPrice ?? 0);
                const unPnl = Number(pos.unrealizedPnl ?? pos.UnrealizedPnl ?? 0);
                const margin = Number(pos.initialMargin ?? pos.InitialMargin ?? 0);

                const curCell = document.getElementById(`posCurrentPrice_${id}`);
                if (curCell && curPrice > 0) curCell.textContent = formatPrice5(curPrice);

                const pnlVal = document.getElementById(`posPnlVal_${id}`);
                if (pnlVal) {
                    pnlVal.textContent = formatPnl5(unPnl);
                    pnlVal.className = `text-sm font-black ${unPnl >= 0 ? 'text-emerald-500' : 'text-rose-500'}`;
                }

                const roiVal = document.getElementById(`posRoiVal_${id}`);
                if (roiVal && margin > 0) {
                    const roi = (unPnl / margin) * 100;
                    roiVal.textContent = `${roi >= 0 ? '+' : ''}${roi.toFixed(2)}%`;
                    roiVal.className = `text-3xs px-1.5 py-0.2 rounded font-extrabold ${roi >= 0 ? 'bg-emerald-500/10 text-emerald-600' : 'bg-rose-500/10 text-rose-600'}`;
                }

                const row = document.getElementById(`posRow_${id}`);
                const multiTp = pos.multipleTakeProfitsJson ?? pos.MultipleTakeProfitsJson;
                if (row) {
                    row.setAttribute('data-multi-tp', multiTp || '');
                }

                const slCell = document.getElementById(`posSl_${id}`);
                if (slCell) {
                    const sl = Number(pos.stopLoss ?? pos.StopLoss ?? 0);
                    slCell.textContent = sl > 0 ? formatPrice5(sl) : '--';
                }

                const tpCell = document.getElementById(`posTp_${id}`);
                if (tpCell) {
                    const tp = Number(pos.takeProfit ?? pos.TakeProfit ?? 0);
                    tpCell.innerHTML = renderTpCellHtml(tp, multiTp);
                }
            });

            const openBadge = document.getElementById('openCountBadge');
            if (openBadge) openBadge.textContent = currentOpen.length;
            const closedBadge = document.getElementById('closedCountBadge');
            if (closedBadge && data.closedPositions) closedBadge.textContent = data.closedPositions.length;

        } catch (err) {
            console.debug('Trade live status polling idle:', err);
        }
    }

    setInterval(pollLiveTradeStatus, 3000);

    function getActiveReferencePrice() {
        if (currentOrderTab === 'limit') {
            const p = parseFloat((document.getElementById('orderPriceInput').value || '').trim().replace(',', '.'));
            return (p && p > 0) ? p : basePrice;
        } else if (currentOrderTab === 'stop') {
            const p = parseFloat((document.getElementById('orderTriggerPriceInput').value || '').trim().replace(',', '.'));
            return (p && p > 0) ? p : basePrice;
        }
        return basePrice > 0 ? basePrice : 1;
    }

    function setLimitToMarket() {
        document.getElementById('orderPriceInput').value = formatPriceInput(basePrice);
        recalculateAllSizeAndMargin();
    }

    function setStopToMarket() {
        document.getElementById('orderTriggerPriceInput').value = formatPriceInput(basePrice);
        recalculateAllSizeAndMargin();
    }

    async function refreshProtectionPrices(e) {
        if (e) e.preventDefault();
        const icon = document.getElementById('btnRefreshProtectionIcon');
        if (icon) icon.classList.add('fa-spin');
        try {
            await pollLiveTradeStatus(true);
            const refP = getActiveReferencePrice();
            const el = document.getElementById('exitHeaderCurrentPrice');
            if (el) el.textContent = formatPrice5(refP);
            const protLive = document.getElementById('protectionLiveMarketPrice');
            if (protLive) protLive.value = formatPrice5(refP, false);
            showToast('info', `Protection price reference synced to ${formatPrice5(refP)}`);
        } catch (err) {
            console.error('Failed to sync protection price:', err);
        } finally {
            if (icon) setTimeout(() => icon.classList.remove('fa-spin'), 400);
        }
    }

    async function toggleTradeWatchlist(sym, name, cls) {
        try {
            const formData = new FormData();
            formData.append('symbol', sym);
            formData.append('assetName', name);
            formData.append('assetClass', cls);

            const res = await fetch('/Trading/Trading/ToggleWatchlist', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                const data = await res.json();
                isSymbolWatchlisted = data.isWatchlisted;
                const icon = document.getElementById('tradeWatchlistIcon');
                const btn = document.getElementById('tradeWatchlistBtn');
                if (isSymbolWatchlisted) {
                    icon.className = 'fa-solid fa-star text-amber-500 text-sm';
                    btn.title = 'Remove from watchlist';
                } else {
                    icon.className = 'fa-regular fa-star text-slate-400 hover:text-amber-500 text-sm';
                    btn.title = 'Add to watchlist';
                }
            }
        } catch (err) {
            console.error('Failed to toggle watchlist in trade terminal:', err);
        }
    }

    // ── 2. Order Tab Switcher (Market, Limit, Stop) ──────────────────────────
    function setOrderTab(tab) {
        currentOrderTab = tab;
        document.querySelectorAll('.order-type-tab').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-xs');
            b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1));
        if (activeBtn) {
            activeBtn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-xs');
        }

        const marketGroup = document.getElementById('marketPriceGroup');
        const priceGroup = document.getElementById('priceInputGroup');
        const stopTriggerGroup = document.getElementById('stopTriggerInputGroup');
        const tifGroup = document.getElementById('tifGroup');
        const formOrderType = document.getElementById('formOrderType');

        if (tab === 'market') {
            formOrderType.value = 1;
            if (marketGroup) marketGroup.classList.remove('hidden');
            priceGroup.classList.add('hidden');
            stopTriggerGroup.classList.add('hidden');
            tifGroup.classList.add('hidden');
        } else if (tab === 'limit') {
            formOrderType.value = 2;
            if (marketGroup) marketGroup.classList.add('hidden');
            priceGroup.classList.remove('hidden');
            stopTriggerGroup.classList.add('hidden');
            tifGroup.classList.remove('hidden');
            if (!document.getElementById('orderPriceInput').value) {
                document.getElementById('orderPriceInput').value = basePrice;
            }
        } else if (tab === 'stop') {
            formOrderType.value = 3;
            if (marketGroup) marketGroup.classList.add('hidden');
            priceGroup.classList.add('hidden');
            stopTriggerGroup.classList.remove('hidden');
            tifGroup.classList.remove('hidden');
            if (!document.getElementById('orderTriggerPriceInput').value) {
                document.getElementById('orderTriggerPriceInput').value = basePrice;
            }
        }

        recalculateAllSizeAndMargin();
    }

    // ── 3. Trade Size Modes & Multi-Unit Calculations ────────────────────────
    function setTradeSizeMode(mode) {
        currentSizeMode = mode;
        document.querySelectorAll('.size-mode-btn').forEach(b => {
            b.classList.remove('bg-brand-500', 'text-white', 'shadow-2xs');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
        });

        const activeBtn = document.getElementById('sizeModeBtn' + mode.charAt(0).toUpperCase() + mode.slice(1));
        if (activeBtn) {
            activeBtn.classList.add('bg-brand-500', 'text-white', 'shadow-2xs');
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
        }

        const prefix = document.getElementById('mainInputPrefix');
        const suffix = document.getElementById('mainInputSuffix');
        const input = document.getElementById('orderSizeMainInput');

        if (mode === 'units') {
            prefix.classList.add('hidden');
            suffix.classList.remove('hidden');
            suffix.textContent = symbol;
            input.value = currentCalculatedUnits > 0 ? (currentCalculatedUnits > 1 ? currentCalculatedUnits.toFixed(4) : currentCalculatedUnits.toFixed(6)) : "1.0";
        } else if (mode === 'margin') {
            prefix.classList.remove('hidden');
            suffix.classList.add('hidden');
            input.value = currentCalculatedMargin > 0 ? currentCalculatedMargin.toFixed(2) : "50.00";
        } else if (mode === 'percent') {
            prefix.classList.add('hidden');
            suffix.classList.remove('hidden');
            suffix.textContent = "% Balance";
            input.value = currentCalculatedPercent > 0 ? currentCalculatedPercent.toFixed(1) : "10.0";
        } else if (mode === 'total') {
            prefix.classList.remove('hidden');
            suffix.classList.add('hidden');
            input.value = currentCalculatedTotal > 0 ? currentCalculatedTotal.toFixed(2) : (basePrice > 0 ? basePrice.toFixed(2) : "100.00");
        }

        recalculateAllSizeAndMargin();
    }

    function onMainSizeInputChange(val) {
        recalculateAllSizeAndMargin();
    }

    function onTradeValueSliderChange(pct) {
        document.getElementById('tradeValueSliderLabel').textContent = pct + '%';
        const avail = freeMargin > 0 ? freeMargin : (cashBalance > 0 ? cashBalance : 100);
        const lev = parseInt(document.getElementById('orderLeverageInput').value) || 1;
        const refPrice = getActiveReferencePrice();

        const targetMargin = (avail * pct) / 100;
        const targetTotal = targetMargin * lev;
        const targetUnits = refPrice > 0 ? targetTotal / refPrice : 0;

        const input = document.getElementById('orderSizeMainInput');
        if (currentSizeMode === 'units') {
            input.value = targetUnits > 1 ? targetUnits.toFixed(4) : targetUnits.toFixed(6);
        } else if (currentSizeMode === 'margin') {
            input.value = targetMargin.toFixed(2);
        } else if (currentSizeMode === 'percent') {
            input.value = Number(pct).toFixed(1);
        } else if (currentSizeMode === 'total') {
            input.value = targetTotal.toFixed(2);
        }

        recalculateAllSizeAndMargin();
    }

    function setSliderPreset(pct) {
        const slider = document.getElementById('tradeValueSlider');
        if (slider) slider.value = pct;
        onTradeValueSliderChange(pct);
    }

    function setLeveragePreset(lev) {
        const levInput = document.getElementById('orderLeverageInput');
        if (levInput) levInput.value = lev;
        updateLeverage(lev);
    }

    function adjustLeverage(delta) {
        const input = document.getElementById('orderLeverageInput');
        if (!input) return;
        let currentVal = parseInt(input.value, 10) || 1;
        let newVal = Math.max(1, Math.min(250, currentVal + delta));
        input.value = newVal;
        updateLeverage(newVal);
    }

    function updateLeverage(val) {
        document.getElementById('leverageDisplay').textContent = val + 'x';
        recalculateAllSizeAndMargin();
    }

    function recalculateAllSizeAndMargin() {
        const refPrice = getActiveReferencePrice();
        const lev = parseInt(document.getElementById('orderLeverageInput').value) || 1;
        const avail = freeMargin > 0 ? freeMargin : (cashBalance > 0 ? cashBalance : 100);
        const val = parseFloat((document.getElementById('orderSizeMainInput').value || '').trim().replace(',', '.')) || 0;

        let units = 0;
        let margin = 0;
        let total = 0;
        let balancePct = 0;

        if (currentSizeMode === 'units') {
            units = val;
            total = units * refPrice;
            margin = total / lev;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        } else if (currentSizeMode === 'margin') {
            margin = val;
            total = margin * lev;
            units = refPrice > 0 ? total / refPrice : 0;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        } else if (currentSizeMode === 'percent') {
            balancePct = val;
            margin = (avail * balancePct) / 100;
            total = margin * lev;
            units = refPrice > 0 ? total / refPrice : 0;
        } else if (currentSizeMode === 'total') {
            total = val;
            units = refPrice > 0 ? total / refPrice : 0;
            margin = total / lev;
            balancePct = avail > 0 ? (margin / avail) * 100 : 0;
        }

        currentCalculatedUnits = units;
        currentCalculatedMargin = margin;
        currentCalculatedPercent = balancePct;
        currentCalculatedTotal = total;

        // Keep hidden quantity field in sync
        document.getElementById('orderQuantityInput').value = units > 0 ? (units > 1 ? units.toFixed(4) : units.toFixed(6)) : '0';

        // Update live bottom conversions strip
        const unitsStr = units > 1 ? units.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 }) : units.toFixed(6);
        document.getElementById('calcUnitsDisplay').innerHTML = `${unitsStr} <span class="text-3xs font-bold text-slate-400">${symbol}</span>`;
        document.getElementById('calcMarginDisplay').textContent = `$${margin.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        document.getElementById('calcBalancePctDisplay').textContent = `${balancePct.toFixed(2)}%`;
        document.getElementById('calcTotalValueDisplay').textContent = `$${total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        // Sync slider position if user typed directly
        const slider = document.getElementById('tradeValueSlider');
        if (slider && document.activeElement !== slider) {
            const clampedPct = Math.min(100, Math.max(1, Math.round(balancePct)));
            slider.value = clampedPct;
            document.getElementById('tradeValueSliderLabel').textContent = clampedPct + '%';
        }

        calculateRiskRewardOutputs();
    }

    // ── 4. Exit Protection (Take Profit & Stop Loss with iOS ON/OFF Switches) ──
    function toggleTpEnabled(enabled) {
        tpEnabled = enabled;
        const container = document.getElementById('tpInputsContainer');
        const summary = document.getElementById('tpRewardSummary');
        const input = document.getElementById('orderTakeProfitInput');
        if (enabled) {
            container.classList.remove('opacity-40', 'pointer-events-none');
            input.disabled = false;
        } else {
            container.classList.add('opacity-40', 'pointer-events-none');
            input.disabled = true;
            summary.textContent = 'Disabled';
        }
        calculateRiskRewardOutputs();
    }

    function toggleSlEnabled(enabled) {
        slEnabled = enabled;
        const container = document.getElementById('slInputsContainer');
        const summary = document.getElementById('slRiskSummary');
        const input = document.getElementById('orderStopLossInput');
        if (enabled) {
            container.classList.remove('opacity-40', 'pointer-events-none');
            input.disabled = false;
        } else {
            container.classList.add('opacity-40', 'pointer-events-none');
            input.disabled = true;
            summary.textContent = 'Disabled';
        }
        calculateRiskRewardOutputs();
    }

    function setQuickRr(ratio) {
        const refPrice = getActiveReferencePrice();
        const slPct = 0.03;
        const tpPct = slPct * ratio;

        const tpInput = document.getElementById('orderTakeProfitInput');
        const slInput = document.getElementById('orderStopLossInput');

        if (currentSide === 1) { // Buy
            tpInput.value = formatPriceInput(refPrice * (1 + tpPct));
            slInput.value = formatPriceInput(refPrice * (1 - slPct));
        } else { // Sell
            tpInput.value = formatPriceInput(refPrice * (1 - tpPct));
            slInput.value = formatPriceInput(refPrice * (1 + slPct));
        }

        if (!tpEnabled) {
            document.getElementById('tpToggleSwitch').checked = true;
            toggleTpEnabled(true);
        }
        if (!slEnabled) {
            document.getElementById('slToggleSwitch').checked = true;
            toggleSlEnabled(true);
        }

        onTpLevelChange();
    }

    function addTpLevel() {
        const container = document.getElementById('tpLevelsContainer');
        const rows = container.querySelectorAll('.tp-level-row');
        if (rows.length >= 5) {
            showToast('error', 'Maximum 5 Take Profit target levels allowed.');
            return;
        }

        const newIndex = rows.length + 1;
        const refPrice = getActiveReferencePrice();
        const baseOffset = currentSide === 1 ? (1 + (0.02 * newIndex)) : (1 - (0.02 * newIndex));
        const suggPrice = formatPriceInput(refPrice * baseOffset);

        const newPct = Math.floor(100 / newIndex);
        const remPct = 100 - (newPct * (newIndex - 1));

        rows.forEach((r, idx) => {
            const pctInput = r.querySelector('.tp-level-pct');
            if (pctInput) pctInput.value = (idx === 0 ? remPct : newPct);
        });

        const newRow = document.createElement('div');
        newRow.className = 'tp-level-row flex items-center gap-2';
        newRow.setAttribute('data-index', newIndex);
        newRow.innerHTML = `
            <span class="text-3xs font-black text-emerald-600 dark:text-emerald-400 px-1.5 py-1 rounded bg-emerald-500/10 shrink-0 tp-level-tag">TP ${newIndex}</span>
            <div class="relative flex-1">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-xs">$</span>
                <input type="text" inputmode="decimal"
                       value="${suggPrice}"
                       placeholder="Target Price"
                       oninput="this.value = this.value.replace(',', '.'); onTpLevelChange();"
                       class="tp-level-price w-full pl-6 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
            </div>
            <div class="flex items-center gap-1 w-20 shrink-0">
                <input type="number" min="1" max="100" value="${newPct}"
                       oninput="onTpLevelChange();"
                       class="tp-level-pct w-14 px-1.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-xs text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none" />
                <span class="text-3xs font-extrabold text-slate-400">%</span>
            </div>
            <button type="button" onclick="removeTpLevel(this)" class="tp-level-remove p-1.5 text-slate-400 hover:text-rose-500 rounded transition-colors shrink-0" title="Remove level">
                <i class="fa-solid fa-xmark text-xs"></i>
            </button>
        `;
        container.appendChild(newRow);

        container.querySelectorAll('.tp-level-remove').forEach(btn => btn.classList.remove('hidden'));

        if (!tpEnabled) {
            document.getElementById('tpToggleSwitch').checked = true;
            toggleTpEnabled(true);
        }

        onTpLevelChange();
    }

    function removeTpLevel(btn) {
        const row = btn.closest('.tp-level-row');
        const container = document.getElementById('tpLevelsContainer');
        if (row && container) {
            row.remove();
            const remaining = container.querySelectorAll('.tp-level-row');
            remaining.forEach((r, idx) => {
                const tag = r.querySelector('.tp-level-tag');
                if (tag) tag.textContent = `TP ${idx + 1}`;
                r.setAttribute('data-index', idx + 1);
            });

            if (remaining.length <= 1) {
                remaining.forEach(r => {
                    const remBtn = r.querySelector('.tp-level-remove');
                    if (remBtn) remBtn.classList.add('hidden');
                    const pct = r.querySelector('.tp-level-pct');
                    if (pct) pct.value = 100;
                });
            }

            onTpLevelChange();
        }
    }

    function onTpLevelChange() {
        const container = document.getElementById('tpLevelsContainer');
        const rows = container.querySelectorAll('.tp-level-row');
        const refPrice = getActiveReferencePrice();
        const units = currentCalculatedUnits;

        let totalPct = 0;
        const tpLevels = [];

        rows.forEach((r, idx) => {
            const priceInput = r.querySelector('.tp-level-price');
            const pctInput = r.querySelector('.tp-level-pct');
            const p = parseFloat((priceInput?.value || '').replace(',', '.')) || 0;
            const pct = parseFloat(pctInput?.value) || 0;

            totalPct += pct;
            if (p > 0 && pct > 0) {
                tpLevels.push({ price: p, percentage: pct });
            }

            if (idx === 0 && priceInput) {
                document.getElementById('orderTakeProfitInput').value = priceInput.value;
            }
        });

        const jsonInput = document.getElementById('formMultiTpJson');
        if (jsonInput) {
            jsonInput.value = rows.length > 1 && tpLevels.length > 0 ? JSON.stringify(tpLevels) : '';
        }

        const allocBadge = document.getElementById('tpAllocationBadge');
        if (allocBadge) {
            allocBadge.textContent = `${totalPct}%`;
            if (totalPct === 100) {
                allocBadge.className = 'text-emerald-600 font-mono font-black';
            } else if (totalPct > 100) {
                allocBadge.className = 'text-rose-500 font-mono font-black animate-pulse';
            } else {
                allocBadge.className = 'text-amber-500 font-mono font-black';
            }
        }

        calculateRiskRewardOutputs();
    }

    function calculateRiskRewardOutputs() {
        const refPrice = getActiveReferencePrice();
        const units = currentCalculatedUnits;

        if (tpEnabled) {
            const container = document.getElementById('tpLevelsContainer');
            const rows = container ? container.querySelectorAll('.tp-level-row') : [];
            const tpSummary = document.getElementById('tpRewardSummary');

            if (tpSummary && units > 0 && refPrice > 0) {
                let totalRewardUsd = 0;
                let weightedPctSum = 0;

                if (rows.length > 1) {
                    rows.forEach(r => {
                        const priceInput = r.querySelector('.tp-level-price');
                        const pctInput = r.querySelector('.tp-level-pct');
                        const p = parseFloat((priceInput?.value || '').replace(',', '.')) || 0;
                        const pct = parseFloat(pctInput?.value) || 0;
                        if (p > 0 && pct > 0) {
                            const levelUnits = units * (pct / 100);
                            const diff = Math.abs(p - refPrice);
                            totalRewardUsd += diff * levelUnits;
                            weightedPctSum += ((diff / refPrice) * 100) * (pct / 100);
                        }
                    });
                } else {
                    const rawTp = (document.getElementById('orderTakeProfitInput').value || '').trim().replace(',', '.');
                    const tp = parseFloat(rawTp) || 0;
                    if (tp > 0) {
                        const diff = Math.abs(tp - refPrice);
                        totalRewardUsd = diff * units;
                        weightedPctSum = (diff / refPrice) * 100;
                    }
                }

                tpSummary.textContent = `+$${totalRewardUsd.toFixed(2)} (+${weightedPctSum.toFixed(2)}%)`;
            }
        }

        if (slEnabled) {
            const rawSl = (document.getElementById('orderStopLossInput').value || '').trim().replace(',', '.');
            const sl = parseFloat(rawSl) || 0;
            const slSummary = document.getElementById('slRiskSummary');
            if (sl > 0 && units > 0 && refPrice > 0) {
                const riskUsd = Math.abs(refPrice - sl) * units;
                const riskPct = ((Math.abs(refPrice - sl) / refPrice) * 100);
                slSummary.textContent = `-$${riskUsd.toFixed(2)} (-${riskPct.toFixed(2)}%)`;
            }
        }
    }

    // ── 5. UIComponent iOS Terminology Switch & Side Control ────────────────
    function updateSideSpecificLabels() {
        const tpLabels = document.querySelectorAll('.term-tp-label');
        const slLabels = document.querySelectorAll('.term-sl-label');
        if (currentSide === 1) {
            tpLabels.forEach(el => el.textContent = isBuzzwordsMode ? "Take Profit Target (Higher)" : "Profit Goal (Sell when up)");
            slLabels.forEach(el => el.textContent = isBuzzwordsMode ? "Stop Loss Threshold (Lower)" : "Safety Stop (Sell if down)");
        } else {
            tpLabels.forEach(el => el.textContent = isBuzzwordsMode ? "Take Profit Target (Lower)" : "Profit Goal (Buy back when down)");
            slLabels.forEach(el => el.textContent = isBuzzwordsMode ? "Stop Loss Threshold (Higher)" : "Safety Stop (Buy back if up)");
        }
    }

    function toggleSideFromSwitch(isShort) {
        setOrderSide(isShort ? 2 : 1, true);
    }

    function setOrderSide(side, flipTpSl = true) {
        currentSide = side;
        const sideInput = document.getElementById('formOrderSide');
        if (sideInput) sideInput.value = side;

        const sideSwitch = document.getElementById('sideToggleSwitch');
        if (sideSwitch) {
            sideSwitch.checked = (side === 2);
        }

        const longLbl = document.getElementById('sideSwitchLongLabel');
        const shortLbl = document.getElementById('sideSwitchShortLabel');
        if (longLbl && shortLbl) {
            if (side === 1) {
                longLbl.className = "text-3xs font-black uppercase text-emerald-600 dark:text-emerald-400";
                shortLbl.className = "text-3xs font-extrabold uppercase text-slate-400";
