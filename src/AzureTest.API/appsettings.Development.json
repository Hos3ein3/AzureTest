{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "HealthCheckConnections": {
    "SqlServer": "",
    "CosmosDb": "",
    "BlobStorage": ""
  },
  "FeatureManagement": {
    "EnableSerilog": true,
    "EnableHealthCheck": true,
    "EnableHealthCheckUI": false,
    "EnableHealthChecksSql": false,
    "EnableHealthChecksCosmos": false,
    "EnableHealthChecksBlob": false,
    "EnableOpenTelemetry": true,
    "EnableAspNetCoreInstrumentation": true,
